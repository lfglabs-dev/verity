+    simpa [show (256 : Nat) ^ 32 = EvmYul.UInt256.size by norm_num [EvmYul.UInt256.size]]
+      using v.val.isLt
+  have hlen : (EvmYul.toBytesBigEndian v.toNat).length ≤ 32 :=
