+      32 - (EvmYul.toBytesBigEndian v.toNat).length := by
+    rw [USize.toNat_sub, USize.toNat_ofNat, USize.toNat_ofNat]
+    rcases System.Platform.numBits_eq with hb | hb <;> rw [hb] <;> omega
