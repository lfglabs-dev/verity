+        st.remove_singleflight_done(&lease.action_key);
+        return;
+    };
+    let mut items = Vec::new();
+    for (kind, abs) in crate::module_builder::olean_artifact_paths(output) {
+        if is_regular_nonempty_standalone_artifact(&abs) {
