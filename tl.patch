+fn compile_dirty_waves_direct(
+    cfg: &ProjectConfig,
+    dag: &ModuleDag,
+    dirty_set: &HashSet<&str>,
+    lean_lp: &str,
+    ld_lp: &str,
+) -> Result<()> {
+    let host_cores = std::thread::available_parallelism()
+        .map(|n| n.get())
+        .unwrap_or(4);
+    for wave in &dag.waves {
+        let wmods: Vec<&String> = wave
+            .iter()
+            .filter(|m| dirty_set.contains(m.as_str()))
+            .collect();
+        if wmods.is_empty() {
+            continue;
+        }
+        let workers = host_cores.clamp(1, 8).min(wmods.len());
+        let idx = std::sync::atomic::AtomicUsize::new(0);
+        let first_err: Mutex<Option<anyhow::Error>> = Mutex::new(None);
+        std::thread::scope(|s| {
+            for _ in 0..workers {
+                s.spawn(|| loop {
+                    if first_err.lock().is_ok_and(|g| g.is_some()) {
+                        break;
+                    }
+                    let i = idx.fetch_add(1, Ordering::Relaxed);
+                    let Some(m) = wmods.get(i) else {
+                        break;
+                    };
+                    let res = dag
+                        .nodes
+                        .get(*m)
+                        .ok_or_else(|| anyhow::anyhow!("Module `{}` missing from DAG", m))
+                        .and_then(|node| {
+                            let staged = compile_single_module_staged(
+                                cfg, dag, node, lean_lp, ld_lp, false, None, true, workers,
+                            )?;
+                            publish_staged_module_compile_output(node, staged).map(|_| ())
+                        });
+                    if let Err(e) = res {
+                        if let Ok(mut g) = first_err.lock() {
+                            g.get_or_insert(e);
+                        }
+                        break;
+                    }
+                });
