+                    if !mapped.values().any(|p| p == &cand) && fs::symlink_metadata(&cand).is_ok() {
+                        let _ = fs::remove_file(&cand);
+                    }
+                }
+                if outputs.iter().all(|e| {
+                    mapped
+                        .get(&e.rel_path)
