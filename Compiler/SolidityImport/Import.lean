  pure (boundPre ++ initPre ++ bodyStmts, { result with param := "" })

private partial def inlineArrayFn (fnId : Nat) (args : Array CallArg) (expectedElemTy : String) (at_ : Json) :
    M (Array Stmt × ScalarArrayParam) := do
  if (← get).stack.contains fnId then failAt at_ s!"recursive call {fnId}"
  let some fn := (← get).funs.find? fnId | failAt at_ s!"unresolved function {fnId}"
  let visibility := optStr fn "visibility" |>.getD ""
  unless visibility == "internal" || visibility == "private" || visibility == "public" do
    failAt at_ "array helper calls require an internal, private, or public declaration"
  let saved ← get
  let savedYul := saved.yulNames
  let savedFile := saved.currentFile
  let frameFile := saved.nodeFile.find? fnId |>.getD saved.currentFile
  let frame := fnId :: saved.stack
  let implemented := (field? fn "implemented").bind (fun v => v.getBool?.toOption) |>.getD true
  let some body := (field? fn "body").filter (!·.isNull)
    | failNoBody fn at_
  unless implemented do failNoBody fn at_
  modify fun e => { e with stack := frame, currentFile := frameFile, unchecked := e.legacyWrapping, bodyAssigned := bodyAssignedIds body }
  let mods ← mArr (← mField fn "modifiers")
  unless mods.isEmpty do failAt fn "modifiers on array-returning helpers are outside this slice"
  let params ← mArr (← mField (← mField fn "parameters") "parameters")
  unless params.size == args.size do
    failAt at_ s!"call arity {args.size} does not match declaration {params.size}"
  let rets ← mArr (← mField (← mField fn "returnParameters") "parameters")
  unless rets.size == 1 do failAt fn "array helper must have one return parameter"
  let r := rets[0]!
  let rname ← mStr (← mField r "name")
  let rloc := optStr r "storageLocation" |>.getD "default"
  let some (retElemTy, _, _, _) ← memArrayElementOf? r
    | failAt r "array helper return must be a supported scalar array"
  unless rloc == "memory" && retElemTy == expectedElemTy do
    failAt r "array helper return type or location mismatch"
  let bodyStmtsJson ← mArr (← mField body "statements")
  if rname != "" || !(← bodyStmtsJson.allM straightLineArrayHelperStmt) then
    return ← inlineArrayFnGeneral saved fn body params args r retElemTy at_
  let (boundPre, yul) ← bindHelperParams params args body at_ savedYul
  modify fun e => { e with yulNames := yul }
  noteProfiledFn fn
  let stmts ← mArr (← mField body "statements")
  if stmts.isEmpty then
    failAt fn "empty array helper is outside this slice"
  let (resPre, resDesc) ← lowerArrayHelperStmts retElemTy stmts.toList
  modify fun e =>
    { e with stack := saved.stack, yulNames := savedYul, yulMemoryArrays := saved.yulMemoryArrays, yulMemoryStructs := saved.yulMemoryStructs, yulBufCursors := saved.yulBufCursors, yulDeclaredNames := saved.yulDeclaredNames, yulCursorOnlyNames := saved.yulCursorOnlyNames, currentFile := savedFile, unchecked := saved.unchecked,
             values := saved.values, writableLocals := saved.writableLocals, paths := saved.paths, snapshots := saved.snapshots, mems := saved.mems, abiElements := saved.abiElements, flatStructs := saved.flatStructs, calldataBytes := saved.calldataBytes, scalarArrays := saved.scalarArrays, byteBuffers := saved.byteBuffers, stringBuffers := saved.stringBuffers, storageBytesVars := saved.storageBytesVars, storageDynamicArrayVars := saved.storageDynamicArrayVars, fnPtrs := saved.fnPtrs, bodyAssigned := saved.bodyAssigned, helperResult := saved.helperResult, helperReturnId := saved.helperReturnId, multiHelperResults := saved.multiHelperResults, flatStructHelperResult := saved.flatStructHelperResult, helperPost := saved.helperPost, scalarTy := saved.scalarTy }
  return (boundPre ++ resPre, resDesc)

/-- Whether `j` is a `T[N] memory` value accepted by `lowerFixedMemArrayValue`. -/
private partial def isFixedMemArrayValue (j : Json) : M Bool := do
  let j ← stripParens j
  unless (fixedMemArrayType? (← mType j)).isSome do return false
  match ← mKind j with
  | "Identifier" =>
      let rid ← refInt j
      pure (rid ≥ 0 && (← get).fixedMemArrays.contains rid.toNat)
  | "FunctionCall" =>
      pure (optStr j "kind" == some "functionCall" && !(← isAbiDecodeCall j) &&
        (← mKind (← mField j "expression")) != "NewExpression")
  | "TupleExpression" => mBool (← mField j "isInlineArray")
  | _ => pure false

/-- An inline array literal `[e_0, ..., e_{N-1}]` of type `T[N] memory`: solc
allocates the N words first (`allocate_memory_array`, no zeroing), then
evaluates each component in order, converts it to the common element type and
stores it. The literal is an ordinary memory array: indexable at runtime,
writable and passed by reference. -/
private partial def lowerInlineArrayLiteral (j : Json) (arr : FixedMemArray) :
    M (Array Stmt) := do
  let components ← mArr (← mField j "components")
  unless components.size == arr.length do
    failAt j "inline array literal length differs from its type"
  let next ← fresh
  modify fun e => { e with encodingMemory := true }
  let mut pre := fixedMemAllocate arr.pointer next arr.length
  for index in [:components.size] do
    let component := components[index]!
    if component.isNull then failAt j "empty inline array component"
    if components.size > 1 && (statefulCallIn component (← get) || assignmentIn component) then
      failAt component "stateful or assignment inline array component requires explicit evaluation-order support"
    let value ← atom (← lowerConverted arr.elementType component)
    let stored := cleanHelperResultExpr arr.elementType value
    let slot := fixedMemElementAddr arr (.literal index)
    pre := pre ++ value.pre |>.push (.mstore slot stored)
  pure pre

/-- A `T[N] memory` value: a memory array binding (an alias, no copy) or the
result of an internal helper returning `T[N] memory` (the callee's pointer, no
copy). -/
private partial def lowerFixedMemArrayValue (j : Json) : M (Array Stmt × FixedMemArray) := do
  let j ← stripParens j
  let some (elem, _, _, length) := fixedMemArrayType? (← mType j)
    | failAt j s!"expected a fixed-size memory array value, found {← mType j}"
  let (pre, arr) ← match ← mKind j with
    | "Identifier" => do
        let id ← refInt j
        let env ← get
        let bound := if id ≥ 0 then env.fixedMemArrays.find? id.toNat else none
        let some arr := bound
          | failAt j "fixed-size memory array value must be a memory array binding"
        pure (#[], arr)
    | "FunctionCall" => do
        unless optStr j "kind" == some "functionCall" && !(← isAbiDecodeCall j) &&
            (← mKind (← mField j "expression")) != "NewExpression" do
          failAt j "unsupported fixed-size memory array call"
        let (fnId, vals) ← resolveCallTargetAndArgs j
        inlineFixedArrayFn fnId vals j
    | "TupleExpression" => do
        unless (← mBool (← mField j "isInlineArray")) do
          failAt j "unsupported fixed-size memory array tuple"
        let some ty := fixedMemArrayType? (← mType j)
          | failAt j "unsupported inline array literal type"
        let arr ← freshFixedMemArray "" ty
        pure (← lowerInlineArrayLiteral j arr, arr)
    | _ => failAt j "unsupported fixed-size memory array expression"
  unless arr.elementType == elem && arr.length == length do
    failAt j "fixed-size memory array type differs"
  pure (pre, arr)

/-- Inline an internal helper returning `T[N] memory`. Its result variable is
allocated and zeroed on entry, as solc does for named and unnamed memory
results; a named result binds that variable and `return e` stores `e`'s
pointer into it. The caller binds the returned pointer, so the callee's
array is shared, never copied. -/
private partial def inlineFixedArrayFn (fnId : Nat) (args : Array CallArg) (at_ : Json) :
    M (Array Stmt × FixedMemArray) := do
  if (← get).stack.contains fnId then failAt at_ s!"recursive call {fnId}"
  let some fn := (← get).funs.find? fnId | failAt at_ s!"unresolved function {fnId}"
  let visibility := optStr fn "visibility" |>.getD ""
  unless visibility == "internal" || visibility == "private" || visibility == "public" do
    failAt at_ "fixed-size memory array helper calls require an internal, private, or public declaration"
  let saved ← get
  let savedYul := saved.yulNames
  let frameFile := saved.nodeFile.find? fnId |>.getD saved.currentFile
  let implemented := (field? fn "implemented").bind (fun v => v.getBool?.toOption) |>.getD true
  let some body := (field? fn "body").filter (!·.isNull)
    | failNoBody fn at_
  unless implemented do failNoBody fn at_
  modify fun e => { e with stack := fnId :: saved.stack, currentFile := frameFile, unchecked := e.legacyWrapping,
                           bodyAssigned := bodyAssignedIds body, zeroInitLocals := #[] }
  let mods ← mArr (← mField fn "modifiers")
  unless mods.isEmpty do failAt fn "modifiers on fixed-size memory array helpers are outside this slice"
  let params ← mArr (← mField (← mField fn "parameters") "parameters")
  unless params.size == args.size do
    failAt at_ s!"call arity {args.size} does not match declaration {params.size}"
  let rets ← mArr (← mField (← mField fn "returnParameters") "parameters")
  unless rets.size == 1 do failAt fn "fixed-size memory array helper must have one return parameter"
  let r := rets[0]!
  let some rty := fixedMemArrayType? (← mType r)
    | failAt r "fixed-size memory array helper return must be a scalar T[N] memory"
  unless (optStr r "storageLocation" |>.getD "default") == "memory" do
    failAt r "fixed-size memory array helper return must be in memory"
  let (boundPre, yul) ← bindHelperParams params args body at_ savedYul
  let rname ← mStr (← mField r "name")
  let rid ← mNat (← mField r "id")
  let (allocPre, result) ← allocateZeroedFixedMemArray rname rty
  modify fun e =>
    { e with yulNames := (if rname == "" then yul else yul.erase rname),
             yulMemoryArrays := (if rname == "" then e.yulMemoryArrays else e.yulMemoryArrays.erase rname),
             yulMemoryStructs := (if rname == "" then e.yulMemoryStructs else e.yulMemoryStructs.erase rname),
             helperResult := none, helperReturnId := none, multiHelperResults := none,
             flatStructHelperResult := none, fixedArrayHelperResult := some result, helperPost := #[],
             fixedMemArrays := if rname == "" then e.fixedMemArrays else e.fixedMemArrays.insert rid result }
  noteProfiledFn fn
  let stmts ← mArr (← mField body "statements")
  let bodyStmts ← lowerVoidHelperFrom stmts.toList (pure #[])
  modify fun e =>
    { e with stack := saved.stack, yulNames := savedYul, yulMemoryArrays := saved.yulMemoryArrays, yulMemoryStructs := saved.yulMemoryStructs, currentFile := saved.currentFile, unchecked := saved.unchecked,
             values := saved.values, writableLocals := saved.writableLocals, zeroInitLocals := saved.zeroInitLocals, paths := saved.paths, snapshots := saved.snapshots, mems := saved.mems, abiElements := saved.abiElements, flatStructs := saved.flatStructs, calldataBytes := saved.calldataBytes, scalarArrays := saved.scalarArrays, byteBuffers := saved.byteBuffers, stringBuffers := saved.stringBuffers, storageBytesVars := saved.storageBytesVars, storageDynamicArrayVars := saved.storageDynamicArrayVars, fnPtrs := saved.fnPtrs, bodyAssigned := saved.bodyAssigned, helperResult := saved.helperResult, helperReturnId := saved.helperReturnId, multiHelperResults := saved.multiHelperResults, flatStructHelperResult := saved.flatStructHelperResult, fixedArrayHelperResult := saved.fixedArrayHelperResult, helperPost := saved.helperPost, scalarTy := saved.scalarTy }
  pure (boundPre ++ allocPre ++ bodyStmts, result)

private partial def inlineStorageRefFn (fnId : Nat) (args : Array CallArg) (at_ : Json) : M (Array Stmt × SPath) := do
  if (← get).stack.contains fnId then failAt at_ s!"recursive call {fnId}"
  let some fn := (← get).funs.find? fnId | failAt at_ s!"unresolved function {fnId}"
  let visibility := optStr fn "visibility" |>.getD ""
  unless visibility == "internal" || visibility == "private" do
    failAt at_ "storage pointer helper calls require an internal or private declaration"
  let saved ← get
  let savedYul := saved.yulNames
  let savedFile := saved.currentFile
  let frameFile := saved.nodeFile.find? fnId |>.getD saved.currentFile
  let frame := fnId :: saved.stack
  let implemented := (field? fn "implemented").bind (fun v => v.getBool?.toOption) |>.getD true
  let some body := (field? fn "body").filter (!·.isNull)
    | failNoBody fn at_
  unless implemented do failNoBody fn at_
  modify fun e => { e with stack := frame, currentFile := frameFile, unchecked := e.legacyWrapping, bodyAssigned := bodyAssignedIds body }
  let mods ← mArr (← mField fn "modifiers")
  unless mods.isEmpty do failAt fn "modifiers on storage pointer helpers are outside this slice"
  let params ← mArr (← mField (← mField fn "parameters") "parameters")
  unless params.size == args.size do
    failAt at_ s!"call arity {args.size} does not match declaration {params.size}"
  let rets ← mArr (← mField (← mField fn "returnParameters") "parameters")
  unless rets.size == 1 do failAt fn "storage pointer helper must have one return parameter"
  let r := rets[0]!
  let retName ← mStr (← mField r "name")
  let retId ← mNat (← mField r "id")
  let rloc := optStr r "storageLocation" |>.getD "default"
  let rty ← mType r
  unless rloc == "storage" && rty.startsWith "struct " && !rty.contains "[" do
    failAt r "storage pointer helper return must be a struct storage reference"
  let (retStructId, retStructDecl) ← resolveStructDeclFromType r
  let (boundPre, yul) ← bindHelperParams params args body at_ savedYul
  modify fun e => { e with yulNames := yul }
  noteProfiledFn fn
  let stmts ← mArr (← mField body "statements")
  if stmts.isEmpty then
    failAt fn "empty storage pointer helper is outside this slice"
  let mut pre := boundPre
  let mut retPath? : Option SPath := none
  let mut returned : Bool := false
  -- Once the named return variable has a storage path, later statements may validate or
  -- read through it (`require(item.active, ...)`, an `if` that reverts, local reads) or
  -- return it explicitly. The path stays in `env.paths` so those statements resolve the
  -- name exactly as an ordinary storage pointer local. Statements after an explicit
  -- `return` remain rejected.
  for idx in [:stmts.size] do
    let s := stmts[idx]!
    if returned then
      failAt s "unreachable statement after storage pointer helper return"
    match ← mKind s with
    | "VariableDeclarationStatement" =>
        pre := pre ++ (← lowerLocal s)
    | "ExpressionStatement" =>
        let expr ← mField s "expression"
        if (← mKind expr) == "Assignment" && optStr expr "operator" == some "=" then
          let lhs ← mField expr "leftHandSide"
          let rhs ← mField expr "rightHandSide"
          let isRetLhs ←
            if (← mKind lhs) == "Identifier" then pure ((← refInt lhs) == retId) else pure false
          if isRetLhs then
            match ← lowerRef rhs with
            | .path rpre rpath =>
                pre := pre ++ rpre
                retPath? := some rpath
                modify fun e => { e with paths := e.paths.insert retId rpath }
            | _ => failAt rhs "storage pointer return assignment requires a storage path"
          else
            pre := pre ++ (← lowerEffect s)
        else
          pre := pre ++ (← lowerEffect s)
    | "Return" =>
        let retExpr := field? s "expression" |>.getD Json.null
        if retExpr.isNull then
          if let some p := (← get).paths.find? retId then
            retPath? := some p
            returned := true
          else
            failAt s "storage pointer helper return is unassigned"
        else
          let isRetIdent ←
            if (← mKind retExpr) == "Identifier" then
              pure ((← refInt retExpr) == retId)
            else
              pure false
          if isRetIdent then
            if let some p := (← get).paths.find? retId then
              retPath? := some p
              returned := true
            else
              failAt s "storage pointer helper return is unassigned"
          else
            match ← lowerRef retExpr with
            | .path rpre rpath =>
                pre := pre ++ rpre
                retPath? := some rpath
                returned := true
                modify fun e => { e with paths := e.paths.insert retId rpath }
            | _ => failAt retExpr "storage pointer helper return requires a storage path"
    | "InlineAssembly" =>
        let ast ← mField s "AST"
        unless (← mKind ast) == "YulBlock" do failAt s "assembly is not a Yul block"
        let ystmts ← mArr (← mField ast "statements")
        let assignsRetSlot ← ystmts.anyM fun ys => do
          if (← mKind ys) == "YulAssignment" then
            let vars ← mArr (← mField ys "variableNames")
            if vars.size == 1 then
              pure (retName != "" && (← mStr (← mField vars[0]! "name")) == s!"{retName}.slot")
            else pure false
          else pure false
        if !assignsRetSlot && idx + 1 < stmts.size then
          let savedAsmYul := (← get).yulNames
          let extPre ← bindYulExternalConstants s
          let asmStmts ← lowerAssemblyStmts s ""
          modify fun e => { e with yulNames := savedAsmYul }
          pre := pre ++ extPre ++ asmStmts
          continue
        unless retName != "" do
          failAt s "assembly storage pointer helper requires a named return parameter"
        unless !ystmts.isEmpty do
          failAt s "storage pointer helper assembly must be a single slot assignment"
        let prefixYstmts := ystmts.extract 0 (ystmts.size - 1)
        let prefixAssignsRetSlot ← prefixYstmts.anyM fun pys => do
          if (← mKind pys) == "YulAssignment" then
            let vars ← mArr (← mField pys "variableNames")
            if vars.size == 1 then
              pure ((← mStr (← mField vars[0]! "name")) == s!"{retName}.slot")
            else pure false
          else pure false
        if prefixAssignsRetSlot then
          failAt s "storage pointer helper assembly must be a single slot assignment"
        let ys := ystmts.back!
        if ystmts.size > 1 && (← mKind ys) != "YulAssignment" then
          failAt s "storage pointer helper assembly must be a single slot assignment"
        unless (← mKind ys) == "YulAssignment" do
          failAt ys "storage pointer helper assembly must be a slot assignment"
        let vars ← mArr (← mField ys "variableNames")
        unless vars.size == 1 do failAt ys "Yul slot assignment must have one target"
        let lhsName ← mStr (← mField vars[0]! "name")
        unless lhsName == s!"{retName}.slot" do
          if ystmts.size > 1 then
            failAt s "storage pointer helper assembly must be a single slot assignment"
          failAt ys s!"expected assignment to {retName}.slot, found {lhsName}"
        let rhs ← mField ys "value"
        let mut matchedBytesSlot : Option SPath := none
        if prefixYstmts.isEmpty && (← mKind rhs) == "YulIdentifier" then
          let rhsName ← mStr (← mField rhs "name")
          if rhsName.endsWith ".slot" then
            let varPrefix := (rhsName.dropEnd 5).toString
            for p in params do
              if (← mStr (← mField p "name")) == varPrefix then
                let pid ← mNat (← mField p "id")
                if let some (storageName, slotExpr, _) := (← get).storageBytesVars.find? pid then
                  let sMembers ← mArr (← mField retStructDecl "members")
                  unless sMembers.size == 1 do
                    failAt r "StorageSlot bytes/string wrapper struct must have a single value member"
                  let m0Ty ← mType sMembers[0]!
                  unless m0Ty == "string" || m0Ty == "bytes" do
                    failAt r "StorageSlot bytes/string wrapper struct must have a single string or bytes member"
                  matchedBytesSlot := some (.bytesSlot (storageName, slotExpr) (m0Ty == "string"))
        if let some bpath := matchedBytesSlot then
          retPath? := some bpath
          modify fun e => { e with paths := e.paths.insert retId bpath }
        else
          let savedAsmYul := (← get).yulNames
          let savedScratch0 := (← get).yulScratch0
          let savedScratch32 := (← get).yulScratch32
          let savedWritten := (← get).yulWrittenBytes
          let savedCursors := (← get).yulBufCursors
          let savedDeclared := (← get).yulDeclaredNames
          let savedCursorOnly := (← get).yulCursorOnlyNames
          modify fun e =>
            { e with yulScratch0 := false, yulScratch32 := false, yulWrittenBytes := 0,
                     yulBufCursors := RBMap.empty, yulDeclaredNames := #[],
                     yulCursorOnlyNames := #[] }
          let extPre ← bindYulExternalConstants s false
          let refs ← mArr (← mField s "externalReferences")
          let prefixPre ← lowerYulStmtSlice s prefixYstmts refs ""
          let slotVal ← lowerYul rhs
          modify fun e =>
            { e with yulNames := savedAsmYul, yulScratch0 := savedScratch0,
                     yulScratch32 := savedScratch32, yulWrittenBytes := savedWritten,
                     yulBufCursors := savedCursors, yulDeclaredNames := savedDeclared,
                     yulCursorOnlyNames := savedCursorOnly }
          let sMembers ← mArr (← mField retStructDecl "members")
          let rawBytesString? ← if prefixYstmts.isEmpty && sMembers.size == 1 then do
            let m0Ty ← mType sMembers[0]!
            if m0Ty == "string" || m0Ty == "bytes" then
              pure (some (m0Ty == "string"))
            else
              pure none
          else
            pure none
          if let some isString := rawBytesString? then
            let slotBinding ← freshFor "raw_slot"
            pre := pre ++ extPre ++ prefixPre ++ slotVal.pre |>.push (.letVar slotBinding slotVal.expr)
            let bpath := SPath.bytesSlot ("", .localVar slotBinding) isString
            retPath? := some bpath
            modify fun e => { e with paths := e.paths.insert retId bpath }
          else
            let rawInfo ← resolveRawStructInfo retStructId fn
            if !prefixYstmts.isEmpty then
              unless prefixYstmts.size == 1 do
                failAt s "storage pointer helper assembly must be a single slot assignment"
              unless rawInfo.wordCount == 1 do
                failAt s "Checkpoints._unsafeAccess requires a 1-slot struct element array"
            let slotBinding ← freshFor "raw_slot"
            pre := pre ++ extPre ++ prefixPre ++ slotVal.pre |>.push (.letVar slotBinding slotVal.expr)
            let rpath := SPath.rawSlot retStructId (.localVar slotBinding)
            retPath? := some rpath
            modify fun e => { e with paths := e.paths.insert retId rpath }
    | _ =>
        -- Guards, loops, emits and other validation statements lower exactly as they do in
        -- a void helper. A `return` inside a branch would end the helper on one path only,
        -- which this slice does not model; top-level returns are handled above.
        if ← stmtContainsReturn s then
          failAt s "storage pointer helper return from a nested control-flow branch is outside this slice"
        pre := pre ++ (← lowerVoidHelperFrom [s] (pure #[]))
  let some finalPath := retPath?
    | failAt fn "storage pointer helper did not assign or return a storage slot"
  modify fun e =>
    { e with stack := saved.stack, yulNames := savedYul, yulMemoryArrays := saved.yulMemoryArrays, yulMemoryStructs := saved.yulMemoryStructs, yulBufCursors := saved.yulBufCursors, yulDeclaredNames := saved.yulDeclaredNames, yulCursorOnlyNames := saved.yulCursorOnlyNames, currentFile := savedFile, unchecked := saved.unchecked,
             values := saved.values, writableLocals := saved.writableLocals, paths := saved.paths, snapshots := saved.snapshots, mems := saved.mems, abiElements := saved.abiElements, flatStructs := saved.flatStructs, calldataBytes := saved.calldataBytes, scalarArrays := saved.scalarArrays, byteBuffers := saved.byteBuffers, stringBuffers := saved.stringBuffers, storageBytesVars := saved.storageBytesVars, storageDynamicArrayVars := saved.storageDynamicArrayVars, fnPtrs := saved.fnPtrs, bodyAssigned := saved.bodyAssigned, helperResult := saved.helperResult, helperReturnId := saved.helperReturnId, multiHelperResults := saved.multiHelperResults, flatStructHelperResult := saved.flatStructHelperResult, helperPost := saved.helperPost, scalarTy := saved.scalarTy }
  return (pre, finalPath)

private partial def inlineFlatStructFn (fnId : Nat) (args : Array CallArg) (at_ : Json) :
    M (Nat × String × Array Stmt × Array (String × String × Expr)) := do
  if (← get).stack.contains fnId then failAt at_ s!"recursive call {fnId}"
  let some fn := (← get).funs.find? fnId | failAt at_ s!"unresolved function {fnId}"
  let visibility := optStr fn "visibility" |>.getD ""
  unless visibility == "internal" || visibility == "private" || visibility == "public" do
    failAt at_ "struct helper calls require an internal, private, or public declaration"
  let saved ← get
  let savedYul := saved.yulNames
  let savedFile := saved.currentFile
  let frameFile := saved.nodeFile.find? fnId |>.getD saved.currentFile
  let frame := fnId :: saved.stack
  let implemented := (field? fn "implemented").bind (fun v => v.getBool?.toOption) |>.getD true
  let some body := (field? fn "body").filter (!·.isNull)
    | failNoBody fn at_
  unless implemented do failNoBody fn at_
  modify fun e => { e with stack := frame, currentFile := frameFile, unchecked := e.legacyWrapping, bodyAssigned := bodyAssignedIds body }
  let mods ← mArr (← mField fn "modifiers")
  let params ← mArr (← mField (← mField fn "parameters") "parameters")
  unless params.size == args.size do
    failAt at_ s!"call arity {args.size} does not match declaration {params.size}"
  let rets ← mArr (← mField (← mField fn "returnParameters") "parameters")
  unless rets.size == 1 do failAt fn "struct helper must have one return parameter"
  let r := rets[0]!
  let rname ← mStr (← mField r "name")
  let rid ← mNat (← mField r "id")
  let rloc := optStr r "storageLocation" |>.getD "default"
  let rty ← mType r
  unless rloc == "memory" && rty.startsWith "struct " && !rty.contains "[" do
    failAt r "struct helper return must be a memory struct"
  let (retSid, retDecl) ← resolveStructDeclFromType r
  let retStructName ← mStr (← mField retDecl "name")
  let retMembers ← mArr (← mField retDecl "members")
  unless !retMembers.isEmpty do
    failAt r s!"empty struct {retStructName} is unsupported"
  let (boundPre, yul) ← bindHelperParams params args body at_ savedYul
  let mut pre := boundPre
  modify fun e => { e with yulNames := yul }
  let mut memberBindings : Array (String × String × String) := #[]
  let mut memberExprs : Array (String × String × Expr) := #[]
  for mNode in retMembers do
    let mName ← mStr (← mField mNode "name")
    let mTy ← mType mNode
    unless (paramType mTy).isSome do
      failAt mNode s!"unsupported flat struct return member {mName} of type {mTy}"
    discard (validateEnumTypeIfNeeded mNode mTy)
    let binding ← freshFor s!"{if rname == "" then "ret_struct" else rname}_{mName}"
    pre := pre.push (.letVar binding (.literal 0))
    memberBindings := memberBindings.push (mName, mTy, binding)
    memberExprs := memberExprs.push (mName, mTy, .localVar binding)
  if rname != "" then
    modify fun e =>
      { e with flatStructs := e.flatStructs.insert rid { structId := retSid, structName := retStructName, members := memberBindings },
               yulNames := e.yulNames.erase rname,
               yulMemoryArrays := e.yulMemoryArrays.erase rname,
               yulMemoryStructs := e.yulMemoryStructs.insert rname rid }
  modify fun e =>
    { e with helperResult := none, helperReturnId := none, multiHelperResults := none,
             flatStructHelperResult := some (retSid, retStructName, memberBindings, rname != ""),
             fixedArrayHelperResult := none }
  noteProfiledFn fn
  let (modStmts, modPost) ← lowerModifiers mods
  modify fun e => { e with helperPost := modPost }
  let stmts ← mArr (← mField body "statements")
  unless rname != "" || !stmts.isEmpty do
    failAt fn "inlined struct helper with unnamed return has an empty body"
  unless rname != "" do
    let definitelyReturns ← match stmts.back? with
      | some b => voidHelperReturns b
      | none => pure false
    unless definitelyReturns do
      failAt fn "inlined struct helper does not return on every path"
  let bodyStmts ← lowerVoidHelperFrom stmts.toList (pure modPost)
  modify fun e =>
    { e with stack := saved.stack, yulNames := savedYul, yulMemoryArrays := saved.yulMemoryArrays, yulMemoryStructs := saved.yulMemoryStructs, currentFile := savedFile, unchecked := saved.unchecked,
             values := saved.values, writableLocals := saved.writableLocals, paths := saved.paths, snapshots := saved.snapshots, mems := saved.mems, abiElements := saved.abiElements, flatStructs := saved.flatStructs, calldataBytes := saved.calldataBytes, scalarArrays := saved.scalarArrays, byteBuffers := saved.byteBuffers, stringBuffers := saved.stringBuffers, storageBytesVars := saved.storageBytesVars, storageDynamicArrayVars := saved.storageDynamicArrayVars, fnPtrs := saved.fnPtrs, bodyAssigned := saved.bodyAssigned, helperResult := saved.helperResult, helperReturnId := saved.helperReturnId, multiHelperResults := saved.multiHelperResults, flatStructHelperResult := saved.flatStructHelperResult, fixedArrayHelperResult := saved.fixedArrayHelperResult, helperPost := saved.helperPost, scalarTy := saved.scalarTy }
  return (retSid, retStructName, pre ++ modStmts ++ bodyStmts, memberExprs)

private partial def unwrapSignFlipStmts (j : Json) (unchecked : Bool) : M (Array Json × Bool) := do
  let kind ← mKind j
  if kind == "Block" || kind == "UncheckedBlock" then
    let u' := unchecked || kind == "UncheckedBlock"
    let ss ← mArr (← mField j "statements")
    if ss.size == 1 then
      let k0 ← mKind ss[0]!
      if k0 == "Block" || k0 == "UncheckedBlock" then
        unwrapSignFlipStmts ss[0]! u'
      else
        pure (ss, u')
    else
      pure (ss, u')
  else
    pure (#[j], unchecked)

private partial def jsonReferencesDecl (j : Json) (declId : Nat) : Bool :=
  match j with
  | .obj kvs =>
      let selfMatch := match kvs.toList.find? (fun (k, _) => k == "referencedDeclaration") with
        | some (_, v) => v.getInt?.toOption == some (Int.ofNat declId)
        | none => false
      selfMatch || kvs.toList.any (fun (_, v) => jsonReferencesDecl v declId)
  | .arr xs => xs.any (fun x => jsonReferencesDecl x declId)
  | _ => false

/-- Recognizes bounded sign-flip self-calls such as `TickLib.wExp(int256 x)`:
    when a helper `f(int256 x)` whose top-level body is `if (x < 0) ... else { falseBody }`
    (or `if (x < 0) { return ...; } <rest>`) calls `f(-x)` from its `x < 0` branch, `-x` is
    guaranteed non-negative for all `x != type(int256).min` (and for `x == type(int256).min`,
    `wExp(-x)` re-enters the `x < 0` branch and reverts by infinite recursion). Thus `f(-x)`
    can be lowered by guarding against `(-x) < 0` and inlining the non-negative path with
    `x` bound to `-x`. -/
private partial def trySignFlipSelfCall? (fnId : Nat) (args : Array CallArg) (at_ : Json) : M (Option Val) := do
  let stack := (← get).stack
