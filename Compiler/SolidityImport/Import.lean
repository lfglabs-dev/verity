        return out
    | .mem rootId effects =>
        if (← get).bodyAssigned.contains id then
          failAt d "reassigned struct locals are outside this slice"
        let some descriptor := (← get).mems.find? rootId
          | failAt d "unknown struct initializer"
        unless descriptor.structId == sid.toNat do
          failAt d "struct local declaration differs from initializer"
        if loc == "calldata" then
          unless descriptor.calldataLocation do
            failAt d "cannot initialize calldata struct local from memory struct"
          modify fun e =>
            { e with mems := e.mems.insert id descriptor,
                     yulNames := e.yulNames.erase name }
          return effects
        else if descriptor.calldataLocation then
          let (convStmts, memDesc) ← convertStructCalldataToMemory descriptor d
          modify fun e =>
            { e with mems := e.mems.insert id memDesc,
                     yulNames := e.yulNames.erase name,
                     yulMemoryStructs := e.yulMemoryStructs.insert name id }
          return effects ++ convStmts
        else
          modify fun e =>
            { e with mems := e.mems.insert id descriptor,
                     yulNames := e.yulNames.erase name,
                     yulMemoryStructs := e.yulMemoryStructs.insert name id }
          return effects
    | .abiElement rootId memberIndex pointer inMemory effects =>
        if (← get).bodyAssigned.contains id then
          failAt d "reassigned struct locals are outside this slice"
        let some mem := (← get).mems.find? rootId | failAt d "unknown ABI root"
        let some schema := mem.schema | failAt d "missing ABI schema"
        let some (.structArray _ fields) := schema[memberIndex]?
          | failAt d "expected a struct-array element"
        let elemSid ← abiElementStructId mem memberIndex d
        unless elemSid ≥ 0 && elemSid.toNat == sid.toNat do
          failAt d "struct local declaration differs from initializer"
        if loc == "calldata" then
          unless !inMemory do
            failAt d "cannot initialize calldata struct local from memory struct array"
          let ptrAtom ← atom { pre := #[], expr := pointer }
          let bound : AbiElementLocal :=
            { rootId, memberIndex, pointer := ptrAtom.expr, inMemory := false }
          modify fun e =>
            { e with abiElements := e.abiElements.insert id bound,
                     yulNames := e.yulNames.erase name }
          return effects ++ ptrAtom.pre
        else if !inMemory then
          let ptrAtom ← atom { pre := #[], expr := pointer }
          let elemStem ← freshAbiElementStem fields
          let (matPtr, _, matStmts) := AbiRootLowering.materializeElementFromCalldata ptrAtom.expr elemStem fields
          let bound : AbiElementLocal :=
            { rootId, memberIndex, pointer := .localVar matPtr, inMemory := true }
          modify fun e =>
            { e with abiElements := e.abiElements.insert id bound,
                     encodingMemory := true,
                     yulNames := e.yulNames.erase name,
                     yulMemoryStructs := e.yulMemoryStructs.insert name id }
          return effects ++ ptrAtom.pre ++ matStmts.toArray
        else
          let ptrAtom ← atom { pre := #[], expr := pointer }
          let bound : AbiElementLocal :=
            { rootId, memberIndex, pointer := ptrAtom.expr, inMemory := true }
          modify fun e =>
            { e with abiElements := e.abiElements.insert id bound,
                     yulNames := e.yulNames.erase name,
                     yulMemoryStructs := e.yulMemoryStructs.insert name id }
          return effects ++ ptrAtom.pre
    | _ =>
        if (← get).bodyAssigned.contains id then
          failAt d "reassigned struct locals are outside this slice"
        failAt d "struct local initializer must be a supported struct or struct-array element reference"
  else
    let ty ← mType d
    let env ← get
    let action := lowerExprAs ty init
    let v ← if ty.startsWith "enum " then do
      -- Only the actual declaring function can establish that the local is
      -- dead. Include assembly externalReferences (spelled `declaration`).
      let fn? := env.stack.head?.bind env.funs.find?
      if fn?.any (fun fn => (declaredVariables fn).any (·.1 == id) && !localReferencedIn fn id) then
        withStorageEnumUse init false action
      else action
    else action
    unless loc == "default" do
      failAt d s!"unsupported local storage location {loc}"
    let ty ← mType d
    discard (validateEnumTypeIfNeeded d ty)
    let some scalarType := localParamType ty
      | failAt d s!"unsupported scalar local type {ty}"
    let converted ← convert ty (← mType init) v init
    let binding ← freshFor name
    let expr := Expr.localVar binding
    let isZero := converted.pre.isEmpty && (match converted.expr with | .literal 0 => true | _ => false)
    modify fun e =>
      { e with values := e.values.insert id expr, scalarTy := e.scalarTy.insert id scalarType,
               yulNames := e.yulNames.insert name expr, writableLocals := e.writableLocals.insert id binding,
               zeroInitLocals := if isZero then (if e.zeroInitLocals.contains id then e.zeroInitLocals else e.zeroInitLocals.push id) else e.zeroInitLocals.filter (· != id) }
    pure (converted.pre.push (.letVar binding converted.expr))

end

private def structMemberList (st : Json) : M (Array (String × String)) := do
  let ms ← mArr (← mField st "members")
  let mut out : Array (String × String) := #[]
  for m in ms do
    out := out.push (← mStr (← mField m "name"), ← mType m)
  pure out

private def functionEmptyBodyArrayReturnType? (fn : Json) : M (Option ParamType) := do
  let rets ← mArr (← mField (← mField fn "returnParameters") "parameters")
  unless rets.size == 1 do return none
  let fnBody ← mField fn "body"
  let fnStmts ← mArr (← mField fnBody "statements")
  let fnMods ← mArr (← mField fn "modifiers")
  unless fnStmts.isEmpty && fnMods.isEmpty do return none
  let r := rets[0]!
  let loc := optStr r "storageLocation" |>.getD "default"
  unless loc == "memory" do return none
  let rty ← mType r
  unless rty.endsWith "[]" do return none
  let elemStr := (rty.dropEnd 2).toString
  unless !elemStr.startsWith "enum " && elemStr != "bytes4" && elemStr != "bytes1" do return none
  let some elemTy := paramType elemStr | return none
  unless isCanonicalReturnArrayParam (.array elemTy) do return none
  return some (.array elemTy)

private def functionFixedArrayReturnType? (fn : Json) : M (Option (String × ParamType × Nat)) := do
  let rets ← mArr (← mField (← mField fn "returnParameters") "parameters")
  unless rets.size == 1 do return none
  let r := rets[0]!
  let rname ← mStr (← mField r "name")
  unless rname == "" do return none
  let loc := optStr r "storageLocation" |>.getD "default"
  unless loc == "memory" do return none
  let rty ← mType r
  let [elemStr, suffix] := rty.splitOn "["
    | return none
  unless suffix.endsWith "]" && suffix != "]" do return none
  let some length := (suffix.dropEnd 1).toNat? | return none
  unless length > 0 && !elemStr.startsWith "enum " && elemStr != "bytes4" && elemStr != "bytes1" do return none
  let some elemPty := paramType elemStr | return none
  return some (elemStr, elemPty, length)

private def functionMsgDataReturn? (fn : Json) : M Bool := do
  let params ← mArr (← mField (← mField fn "parameters") "parameters")
  unless params.isEmpty do return false
  let rets ← mArr (← mField (← mField fn "returnParameters") "parameters")
  unless rets.size == 1 do return false
  let r := rets[0]!
  let rname ← mStr (← mField r "name")
  unless rname == "" do return false
  let loc := optStr r "storageLocation" |>.getD "default"
  unless loc == "calldata" || loc == "memory" do return false
  return (← mType r) == "bytes"

private def functionStorageStructReturn? (fn : Json) : M Bool := do
  let vis := optStr fn "visibility" |>.getD ""
  unless vis == "internal" || vis == "private" do return false
  let rets ← mArr (← mField (← mField fn "returnParameters") "parameters")
  unless rets.size == 1 do return false
  let r := rets[0]!
  unless optStr r "storageLocation" == some "storage" do return false
  let rty ← mType r
  return rty.startsWith "struct " && !rty.contains "["

private def functionDynamicBytesReturn? (fn : Json) : M (Option ParamType) := do
  let rets ← mArr (← mField (← mField fn "returnParameters") "parameters")
  unless rets.size == 1 do return none
  let r := rets[0]!
  let rname ← mStr (← mField r "name")
  let loc := optStr r "storageLocation" |>.getD "default"
  unless loc == "memory" || loc == "calldata" do return none
  match ← mType r with
  | "bytes" =>
      return some .bytes
  | "string" =>
      -- A named `string memory` result is bound like a named `bytes` result
      -- (same length-prefixed memory layout and ABI encoding); a named
      -- `string calldata` result has no buffer to bind.
      unless rname == "" || loc == "memory" do return none
      return some .string
  | _ => return none

/-- The flat leaves of memory struct `sid`: its members in declaration order,
with each member of a static struct type replaced by that struct's leaves,
named `member.leaf` (solc ABI-encodes a static nested struct inline, so the
leaves are the encoded words in order). `none` when a member is neither an
ABI scalar nor such a struct. -/
private partial def flatStructLeaves? (sid : Nat) (fuel : Nat := 8) :
    M (Option (Array (String × String))) := do
  if fuel == 0 then return none
  let some decl := (← get).structs.find? sid | return none
  let members ← mArr (← mField decl "members")
  if members.isEmpty then return none
  let mut out : Array (String × String) := #[]
  for m in members do
    let name ← mStr (← mField m "name")
    let ty ← mType m
    if (paramType ty).isSome then
      discard (validateEnumTypeIfNeeded m ty)
      out := out.push (name, ty)
    else if ty.startsWith "struct " && !ty.contains "[" then
      let subId ← refInt (← mField m "typeName")
      if subId < 0 then return none
      let some subLeaves ← flatStructLeaves? subId.toNat (fuel - 1) | return none
      for (leaf, leafTy) in subLeaves do
        out := out.push (s!"{name}.{leaf}", leafTy)
    else
      return none
  return some out

private def functionFlatStructReturnType? (fn : Json) :
    M (Option (Nat × String × String × Nat × Array (String × String × ParamType))) := do
  let rets ← mArr (← mField (← mField fn "returnParameters") "parameters")
  unless rets.size == 1 do return none
  let r := rets[0]!
  let loc := optStr r "storageLocation" |>.getD "default"
  unless loc == "memory" do return none
  let rty ← mType r
  unless rty.startsWith "struct " && !rty.contains "[" do return none
  let (retSid, retDecl) ← resolveStructDeclFromType r
  let retStructName ← mStr (← mField retDecl "name")
  let retMembers ← mArr (← mField retDecl "members")
  unless !retMembers.isEmpty do return none
  let mut memberSpecs : Array (String × String × ParamType) := #[]
  let some leaves ← flatStructLeaves? retSid | return none
  for (mName, mTy) in leaves do
    let some mPty := paramType mTy | return none
    memberSpecs := memberSpecs.push (mName, mTy, mPty)
  let rname ← mStr (← mField r "name")
  let rid ← mNat (← mField r "id")
  return some (retSid, retStructName, rname, rid, memberSpecs)

/-- `returns (S memory)` of a struct that is not flat and whose complete schema
`AbiMemoryDecode` supports: its declaration id and schema. The return value is
ABI-encoded into memory and returned by the closed memory `return` transport.
Named returns of such structs are rejected. -/
private def functionDynamicStructReturn? (fn : Json) :
    M (Option (Nat × List AbiSchema.Member)) := do
  let rets ← mArr (← mField (← mField fn "returnParameters") "parameters")
  unless rets.size == 1 do return none
  let r := rets[0]!
  unless optStr r "storageLocation" == some "memory" do return none
  let rty ← mType r
  unless rty.startsWith "struct " && !rty.contains "[" do return none
  if (← functionFlatStructReturnType? fn).isSome then return none
  let sid ← refInt (← mField r "typeName")
  unless sid ≥ 0 do return none
  let structs := (← get).structs
  let enums := (← get).enums
  let some decl := structs.find? sid.toNat | return none
  let .ok schema := AbiSchema.root (fun id => structs.find? id) decl
      (resolveEnum := fun id => (enums.find? id).map (·.size)) | return none
  unless schema.all AbiMemoryDecode.supportedMember && schema.any AbiSchema.isDynamicMember do
    return none
  unless (← mStr (← mField r "name")) == "" do
    failAt r "named dynamic struct return parameters are unsupported"
  return some (sid.toNat, schema)

/-- The model return types of a root whose ABI return tuple has a dynamic
component: a scalar `T[] memory` array, or `bytes`/`string memory` beside other
components (a lone `bytes`/`string` result is `functionDynamicBytesReturn?`).
Every other component must be an ABI scalar. `return` ABI-encodes the tuple into
memory (`lowerAbiEncodeArgs`, as `abi.encode`) and returns it through the closed
memory `return` transport. Empty-body roots keep `functionEmptyBodyArrayReturnType?`. -/
private def functionDynamicTupleReturn? (fn : Json) : M (Option (Array ParamType)) := do
  let rets ← mArr (← mField (← mField fn "returnParameters") "parameters")
  if rets.isEmpty || (← functionEmptyBodyArrayReturnType? fn).isSome then return none
  let mut types : Array ParamType := #[]
  let mut dynamic := false
  for r in rets do
    let rty ← mType r
    let loc := optStr r "storageLocation" |>.getD "default"
    if let some (_, elemPty, _) := scalarArrayElement? rty then
      unless loc == "memory" do return none
      types := types.push (.array elemPty)
      dynamic := true
    else if rty == "bytes" || rty == "string" then
      unless loc == "memory" && rets.size > 1 do return none
      types := types.push (if rty == "bytes" then .bytes else .string)
      dynamic := true
    else
      let some pty := paramType rty | return none
      types := types.push pty
  return if dynamic then some types else none

/-- An `Identifier` naming the root return parameter `r`: falling off the end of
a root with named results returns those variables. -/
private def returnParamIdentifier (r : Json) : M Json := do
  let name ← mField r "name"
  let id ← mField r "id"
  return Json.mkObj [("nodeType", Json.str "Identifier"), ("name", name), ("referencedDeclaration", id),
    ("typeDescriptions", ← mField r "typeDescriptions"), ("src", (field? r "src").getD Json.null)]

/-- Bind the named component `r` of a dynamic root return tuple to its zero
value: a `T[] memory` result is solc's zero-length array at `0x60` (reassignable,
as a `T[] memory x;` local), a `bytes`/`string` result an empty buffer rebound by
assignment (as a named `bytes` result), and a scalar result `0`. -/
private def bindRootDynamicTupleResult (r : Json) : M (Array Stmt) := do
  let rname ← mStr (← mField r "name")
  let rid ← mNat (← mField r "id")
  let rty ← mType r
  if let some (elemStr, elemPty, abiKind) := scalarArrayElement? rty then
    let template : ScalarArrayParam :=
      { param := rname, elementType := elemStr, modelElementType := elemPty, abiKind,
        inMemory := true, lengthBinding := "" }
    let (ownPre, owned) ← ownDynArray rname template (.literal 96)
    modify fun e =>
      { e with scalarArrays := e.scalarArrays.insert rid owned, yulNames := e.yulNames.erase rname,
               yulMemoryArrays := e.yulMemoryArrays.erase rname,
               yulMemoryStructs := e.yulMemoryStructs.erase rname }
    return ownPre
  if rty == "bytes" || rty == "string" then
    let ptrBinding ← fresh
    let sizeBinding ← fresh
    let buf : EncodedBytes := { pre := #[], pointer := .localVar ptrBinding, size := .localVar sizeBinding }
    modify fun e =>
      { e with byteBuffers := e.byteBuffers.insert rid buf,
               nonLiteralByteLocals := e.nonLiteralByteLocals.push rid,
               yulNames := e.yulNames.erase rname,
               yulMemoryStructs := e.yulMemoryStructs.insert rname rid }
    return #[.letVar ptrBinding (.literal 0), .letVar sizeBinding (.literal 0)]
  discard (validateEnumTypeIfNeeded r rty)
  let some scalar := paramType rty | failAt r s!"unsupported named root return type {rty}"
  let rbinding ← freshFor rname
  let rexpr := Expr.localVar rbinding
  modify fun e =>
    { e with values := e.values.insert rid rexpr,
             writableLocals := e.writableLocals.insert rid rbinding,
             scalarTy := e.scalarTy.insert rid scalar,
             yulNames := e.yulNames.insert rname rexpr }
  return #[.letVar rbinding (.literal 0)]

/-- The memory struct returned by `return expr` from a root returning the dynamic
struct `retSid`: `abi.decode(bytes, (S))`, materialized under a fresh root id, or a
memory struct variable with a complete schema. Returns the root id and effects. -/
private def lowerDynamicStructReturnValue (expr : Json) (retSid : Nat) :
    M (Nat × Array Stmt) := do
  let unsupported := "dynamic struct returns require abi.decode or a memory struct variable"
  let expr ← stripParens expr
  if ← abiDecodesDynamicStruct expr then
    let (decodePre, decoded) ← lowerAbiDecodeItems expr
    let #[.dynamicStruct descriptor] := decoded | failAt expr unsupported
    unless descriptor.structId == retSid do failAt expr "struct abi.decode return type mismatch"
    let rootId := 1000000000 + (← get).next
    modify fun e => { e with next := e.next + 1, mems := e.mems.insert rootId descriptor }
    return (rootId, decodePre)
  unless (← mKind expr) == "Identifier" do failAt expr unsupported
  let .mem rootId effects ← lowerRef expr | failAt expr unsupported
  let some mem := (← get).mems.find? rootId | failAt expr unsupported
  unless mem.structId == retSid && mem.schema.isSome && !mem.calldataLocation do
    failAt expr "dynamic struct returns require a memory struct with a complete ABI schema"
  return (rootId, effects)

private partial def canLowerDynamicBytesReturnExpr (j : Json) : M Bool := do
  match ← mKind j with
  | "Conditional" =>
      let tExpr ← stripParens (← mField j "trueExpression")
      let fExpr ← stripParens (← mField j "falseExpression")
      if (← mKind tExpr) == "Literal" && (← mKind fExpr) == "Literal" then
        return false
      return (← canLowerDynamicBytesReturnExpr tExpr) &&
             (← canLowerDynamicBytesReturnExpr fExpr)
  | "Literal" =>
      pure (optStr j "kind" == some "hexString" || optStr j "kind" == some "string" ||
            optStr j "kind" == some "unicodeString")
  | "Identifier" =>
      let id ← refInt j
      if id < 0 then return false
      let env ← get
      if env.calldataBytes.contains id.toNat || env.storageBytesVars.contains id.toNat then
        return true
      if env.byteBuffers.contains id.toNat || env.stringBuffers.contains id.toNat then
        return env.nonLiteralByteLocals.contains id.toNat
      if let some decl := env.stateVars.find? id.toNat then
        if (field? decl "constant").bind (fun value => value.getBool?.toOption) == some true then
          return true
        return optStr decl "mutability" != some "immutable"
      return false
  | "IndexAccess" =>
      let ty ← mType j
      return ty == "string storage ref" || ty == "bytes storage ref"
  | "MemberAccess" =>
      if ← isStorageStructBytesMember j then
        let ty ← mType j
        return ty == "string storage ref" || ty == "string storage pointer" ||
               ty == "bytes storage ref" || ty == "bytes storage pointer"
      let ty ← mType j
      if (ty == "bytes" || ty == "bytes memory" || ty == "bytes calldata") &&
          (← mType (← mField j "expression")).startsWith "struct " then
        return true
      return false
  | "FunctionCall" =>
      if optStr j "kind" == some "typeConversion" then
        let ty ← mType j
        return ty == "bytes" || ty == "bytes memory" || ty == "bytes calldata" || ty == "bytes storage pointer" ||
               ty == "string" || ty == "string memory" || ty == "string calldata" || ty == "string storage pointer"
      if optStr j "kind" != some "functionCall" then
        return false
      let callee ← mField j "expression"
      if (← mKind callee) == "MemberAccess" then
        let base ← mField callee "expression"
        if (← mKind base) == "ElementaryTypeNameExpression" &&
            optStr callee "memberName" == some "concat" &&
            (field? callee "referencedDeclaration").isNone then
          let tname := optStr (field? base "typeName" |>.getD Json.null) "name" |>.getD ""
          return tname == "string"
        let isAbiBuiltin ← if (← mKind base) == "Identifier" && optStr base "name" == some "abi" then
          pure ((← refInt base) == -1)
        else
          pure false
        if isAbiBuiltin then
          let mname := optStr callee "memberName"
          return mname == some "encode" || mname == some "encodePacked" || mname == some "encodeCall" ||
            mname == some "decode"
      let isHelperCall :=
        ((← mKind callee) == "Identifier" || (← mKind callee) == "MemberAccess") &&
        ((field? callee "referencedDeclaration").bind (fun v => v.getInt?.toOption)).any (· ≥ 0)
      if isHelperCall then
        let ty ← mType j
        if ty == "string memory" || ty == "string" || ty == "bytes memory" || ty == "bytes" then
          if let some (fnId, _) ← callTargetAndArity? j then
            if let some fn := (← get).funs.find? fnId then
              let rets ← mArr (← mField (← mField fn "returnParameters") "parameters")
              if rets.size == 1 then
                let r := rets[0]!
                let rloc := optStr r "storageLocation" |>.getD "default"
                if rloc == "memory" then
                  if let some body := (field? fn "body").filter (!·.isNull) then
                    let stmts ← mArr (← mField body "statements")
                    if stmts.size == 1 then
                      if (← mKind stmts[0]!) == "Return" then
                        let retExpr := field? stmts[0]! "expression" |>.getD Json.null
                        if !retExpr.isNull then
                          if ← isMsgDataNode retExpr then
                            return false
                  return true
      return false
  | _ => return false

/-! ### Immutables

An immutable is fixed when the contract is deployed: its inline initializer runs, then the
deployment code may write it (solc 0.8.21+ accepts conditional and repeated writes, `++`,
`--` and `delete`, in constructors, in any state variable's initializer and in
inheritance-specifier arguments; `chainDeploymentCode`).
Each immutable of a value type gets one `ImmutableBinding`:

- `read`: the source determines the value and reads lower to it. An address immutable the
  constructors assign exactly once, as a top-level statement, to `address(this)` is the
  executing contract's address for code that runs at its own address
  (`Expr.contractAddress`). One never written and without an initializer is `0`. One never
  written whose initializer is a total expression of literals is that expression.
- `installed`: never written, with an initializer that also reads the deployment
  environment (`msg.sender`, `block.chainid`, …). Reads lower to `Expr.immutable name`, and
  the synthesized constructor evaluates the initializer at deployment.
- `argument`: any write in the deployment code, whatever its shape and place. The value is one the source does
  not determine: reads lower to `Expr.immutable name`, and the synthesized constructor takes
  it as an argument of the immutable's type, so deployment and proofs supply it explicitly.

No binding picks a value the deployment might not have. Any other immutable (an enum or
function type, or an initializer `immutableInitializer?` rejects, including every initializer
that reads an immutable, since initializers run before the constructors) stays unbound, and
its reads keep their located rejection. -/

/-- Whether `j` refers to the declaration `svId` anywhere. -/
private partial def mentionsDeclaration (svId : Nat) : Json → Bool
  | j@(.obj kvs) =>
      ((field? j "referencedDeclaration").bind (·.getNat?.toOption)) == some svId ||
        kvs.foldl (fun acc _ v => acc || mentionsDeclaration svId v) false
  | .arr items => items.any (mentionsDeclaration svId)
  | _ => false

/-- Every write that may change the state variable `svId` in `j`: an assignment whose
left-hand side refers to it (tuple components included), and a `delete`, `++` or `--` of
it. -/
private partial def stateVarWrites (svId : Nat) : Json → Array Json
  | j@(.obj kvs) =>
      let target? := match optStr j "nodeType" with
        | some "Assignment" => field? j "leftHandSide"
        | some "UnaryOperation" =>
            if ["delete", "++", "--"].contains ((optStr j "operator").getD "") then
              field? j "subExpression"
            else none
        | _ => none
      let here := if (target?.map (mentionsDeclaration svId)).getD false then #[j] else #[]
      kvs.foldl (fun acc _ v => acc ++ stateVarWrites svId v) here
  | .arr items => items.foldl (fun acc v => acc ++ stateVarWrites svId v) #[]
  | _ => #[]

/-- Whether `j` contains a node of kind `kind`. -/
private partial def containsNodeKind (kind : String) : Json → Bool
  | j@(.obj kvs) =>
      optStr j "nodeType" == some kind ||
        kvs.foldl (fun acc _ v => acc || containsNodeKind kind v) false
  | .arr items => items.any (containsNodeKind kind)
  | _ => false

/-- Whether every statement of constructor `c`'s body runs on each successful deployment:
no `return` ends the body early and no modifier (a base constructor specifier is not one)
may skip it. -/
private def constructorBodyAlwaysRuns (c : Json) : Bool :=
  let modifiers := match field? c "modifiers" with
    | some (.arr ms) => ms
    | _ => #[]
  !containsNodeKind "Return" ((field? c "body").getD .null) &&
    modifiers.all (optStr · "kind" == some "baseConstructorSpecifier")

/-- `address(this)`, as solc types it. -/
private def isAddressOfThis (j : Json) : Bool :=
  let typeString (n : Json) := (field? n "typeDescriptions").bind (optStr · "typeString")
  let thisArg := match field? j "arguments" with
    | some (.arr #[arg]) =>
        optStr arg "nodeType" == some "Identifier" && optStr arg "name" == some "this" &&
          ((typeString arg).map (·.startsWith "contract ")).getD false
    | _ => false
  optStr j "nodeType" == some "FunctionCall" && optStr j "kind" == some "typeConversion" &&
    typeString j == some "address" && thisArg

/-- Whether the only write to `svId` in `constructors` is `svId = address(this)`, a
top-level statement of a constructor body that always runs to its end
(`constructorBodyAlwaysRuns`). Tuple assignments and `delete` count as writes. -/
private def assignedSelfAddressOnce (constructors : Array Json) (svId : Nat) : Bool :=
  let writes := constructors.filterMap fun c =>
    let ws := stateVarWrites svId c
    if ws.isEmpty then none else some (c, ws)
  match writes with
  | #[(c, #[a])] =>
      let topLevel := match (field? c "body").bind (field? · "statements") with
        | some (.arr stmts) => stmts.filterMap fun s =>
            if optStr s "nodeType" == some "ExpressionStatement" then field? s "expression" else none
        | _ => #[]
      optStr a "nodeType" == some "Assignment" && optStr a "operator" == some "=" &&
        ((field? a "leftHandSide").map (optStr · "nodeType" == some "Identifier")).getD false &&
        topLevel.any (fun e => field? e "id" == field? a "id") &&
        ((field? a "rightHandSide").map isAddressOfThis).getD false &&
        constructorBodyAlwaysRuns c
  | _ => false

/-- The constructors of the target contract's C3 chain. -/
private def chainConstructors : M (Array Json) := do
  let env ← get
  let mut out := #[]
  for cid in env.linearizedBases do
    for n in env.contractNodes.find? cid |>.getD #[] do
      if optStr n "nodeType" == some "FunctionDefinition" && optStr n "kind" == some "constructor" then
        out := out.push n
  return out

/-- Every node of the chain's contracts and their inheritance specifiers: all the code that
can write an immutable. solc accepts writes in constructor bodies and their base-constructor
and modifier arguments, in any state variable's initializer and in inheritance-specifier
arguments (`is Base(A.X = v)`), and rejects them anywhere else. -/
private def chainDeploymentCode : M Json := do
  let env ← get
  let mut out := #[]
  for cid in env.linearizedBases do
    out := out ++ (env.contractNodes.find? cid |>.getD #[])
    out := out.push (env.contractBaseSpecifiers.find? cid |>.getD .null)
  return .arr out

/-- How a deployment fixes an immutable of the chain (see the section comment). -/
private inductive ImmutableBinding where
  /-- Reads lower to this expression: the source determines the value. -/
  | read (value : Expr)
  /-- Reads lower to `Expr.immutable NAME`; the synthesized constructor evaluates this
  inline initializer at deployment, as solc does. -/
  | installed (init : Expr)
  /-- Reads lower to `Expr.immutable NAME`; the synthesized constructor takes the value
  as an argument, because a constructor writes it. -/
  | argument

/-- Whether `e` can run in the synthesized constructor with the value solc's inline
initializer has there: literals, the deployment's environment (`msg.sender`, `tx.origin`,
`address(this)`, `block.chainid`, `block.number`, `block.timestamp`) and pure word
operations. `some true` when it reads the environment, `none` when it reads anything else
(storage, memory, immutables, calls, parameters, locals). -/
private def deploymentInitializerEnv? : Expr → Option Bool
  | .literal _ => some false
  | .caller | .contractAddress | .txOrigin | .chainid | .blockTimestamp | .blockNumber =>
      some true
  | .add a b | .sub a b | .mul a b | .div a b | .sdiv a b | .mod a b | .smod a b
  | .bitAnd a b | .bitOr a b | .bitXor a b | .shl a b | .shr a b | .sar a b | .byte a b
  | .signextend a b | .eq a b | .lt a b | .gt a b | .le a b | .ge a b | .slt a b
  | .sgt a b => do
      let x ← deploymentInitializerEnv? a
      let y ← deploymentInitializerEnv? b
      pure (x || y)
  | .bitNot a | .logicalNot a => deploymentInitializerEnv? a
  | _ => none

/-- The inline initializer of immutable `decl`, lowered and converted to its declared type
like a constant's, if it is a total expression `deploymentInitializerEnv?` admits and reads
none of the chain's `immutables`, with whether it reads the environment. Lowering leaves no
trace in the state. -/
private def immutableInitializer? (immutables : Array Nat) (decl : Json) (init : Json) :
    M (Option (Expr × Bool)) := do
  let saved ← get
  let pending ← match saved.unsupportedSink with
    | some sink => sink.pending.get
    | none => pure none
  -- Initializers run before the constructors, so another immutable's value there is not the
  -- one its binding models (it may still be `0`). Unbinding every immutable of the chain
  -- makes any read of one, direct or through a helper, fail like an unbound immutable's.
  -- Constructor-time linked library DELEGATECALLs stay outside this slice.
  modify fun e =>
    { e with values := immutables.foldl (fun m id => m.erase id) e.values,
             scalarTy := immutables.foldl (fun m id => m.erase id) e.scalarTy,
             linkedLibrariesMatchSource := false }
  let result ← try
      let raw ← lowerExpr init
      let v ← convert (← mType decl) (← mType init) raw init
      pure (if v.pre.isEmpty then (deploymentInitializerEnv? v.expr).map (v.expr, ·) else none)
    catch e =>
      if e.isInterrupt || e.isRuntime then throw e
      pure none
  set saved
  if let some sink := saved.unsupportedSink then sink.pending.set pending
  return result

/-- The immutables of the chain whose type is a supported value type, in declaration order,
with their model type and binding; each is also bound for reads (`values`, `scalarTy`).
An immutable with an inline initializer `immutableInitializer?` rejects and no constructor
write stays unbound, so its reads keep their located rejection; enum and function-typed
immutables too. -/
private def bindChainImmutables : M (Array (Nat × String × ParamType × ImmutableBinding)) := do
  let env ← get
  let ctors ← chainConstructors
  let code ← chainDeploymentCode
  let mut candidates := #[]
  for (svId, svDecl) in env.stateVars.toList do
    let scope := (field? svDecl "scope").bind (·.getNat?.toOption)
    if optStr svDecl "mutability" == some "immutable" &&
        (scope.map env.linearizedBases.contains).getD false then
      candidates := candidates.push (svId, svDecl)
  let mut out := #[]
  for (svId, svDecl) in candidates.qsort (fun a b => a.1 < b.1) do
    let ty ← mType svDecl
    let some pty := localParamType ty | continue
    if ty.startsWith "enum " then continue
    let name ← mStr (← mField svDecl "name")
    let init? := (field? svDecl "value").filter (!·.isNull)
    let writes := stateVarWrites svId code
    let binding? ← if !writes.isEmpty then
        pure (some (if ty == "address" && writes.size == 1 && assignedSelfAddressOnce ctors svId
          then ImmutableBinding.read .contractAddress else .argument))
      else match init? with
        -- Never written: the zero value.
        | none => pure (some (.read (.literal 0)))
        | some init => do
            match ← immutableInitializer? (candidates.map (·.1)) svDecl init with
            | some (value, true) => pure (some (.installed value))
            | some (value, false) => pure (some (.read value))
            | none => pure none
    let some binding := binding? | continue
    let value := match binding with
      | .read value => value
      | _ => Expr.immutable name
    modify fun e =>
      { e with values := e.values.insert svId value, scalarTy := e.scalarTy.insert svId pty }
    out := out.push (svId, name, pty, binding)
  return out

private def bindRoot (fn : Json) : M (Array SrcParam) := do
  noteProfiledFn fn
  discard bindChainImmutables
  let rootAssigned := match (field? fn "body").filter (!·.isNull) with
    | some b => bodyAssignedIds b
    | none => []
  let params ← mArr (← mField (← mField fn "parameters") "parameters")
  let mut out : Array SrcParam := #[]
  -- ABI head word of the current parameter (static tuples and `T[N]` span
  -- several words); checked against the model parameters after lowering.
  let mut headWord := 0
  for p in params do
    let rawName ← mStr (← mField p "name")
    if rawName.startsWith "_verity_memret_" then
      failAt p s!"parameter name {rawName} uses reserved _verity_memret_ prefix"
    let id ← mNat (← mField p "id")
    -- A Solidity name that is a Yul keyword or builtin (`caller`, `origin`, …) cannot
    -- name a compiled Yul variable; it takes `freshFor`'s first free suffixed name.
    let name ← if rawName == "" then fresh
      else if yulKeywords.contains rawName ||
          (Verity.Core.Intrinsics.yulBuiltinArity? rawName).isSome then freshFor rawName
      else do
        modify fun e => { e with bound := rawName :: e.bound }
        pure rawName
    let ty ← mType p
    let loc := optStr p "storageLocation" |>.getD "default"
    out := out.push { name, id }
    if ty == "bytes" then
      unless loc == "calldata" || loc == "memory" do
        failAt p s!"unsupported location {loc} for bytes"
      modify fun e =>
        { e with bound := s!"{name}_offset" :: s!"{name}_length" :: s!"{name}_data_offset" :: e.bound }
      let offsetBinding ← fresh
      let headerBinding ← fresh
      let lengthBinding ← fresh
      let dataBinding ← fresh
      let memoryPointer ← if loc == "memory" then fresh else pure ""
      let nextFreeBinding ← if loc == "memory" then fresh else pure ""
      let copyIndexBinding ← if loc == "memory" then fresh else pure ""
      modify fun e =>
        let bound : CalldataBytesParam :=
          { param := name
            offsetBinding
            headerBinding
            lengthBinding
            dataBinding
            isString := false
            inMemory := loc == "memory"
            memoryPointer
            nextFreeBinding
            copyIndexBinding }
        let byteBuffers :=
          if loc == "memory" then
            e.byteBuffers.insert id
              { pre := #[], pointer := .add (.localVar memoryPointer) (.literal 32),
                size := .localVar lengthBinding, ownedMutable := !rootAssigned.contains id }
          else
            e.byteBuffers
        let yulMemoryStructs :=
          if loc == "memory" && rawName != "" then
            e.yulMemoryStructs.insert rawName id
          else
            e.yulMemoryStructs
        { e with calldataBytes := e.calldataBytes.insert id bound, byteBuffers, yulMemoryStructs }
    else if ty == "string" then
      unless loc == "calldata" || loc == "memory" do
        failAt p s!"unsupported location {loc} for string"
      modify fun e =>
        { e with bound := s!"{name}_offset" :: s!"{name}_length" :: s!"{name}_data_offset" :: e.bound }
      let offsetBinding ← fresh
      let headerBinding ← fresh
      let lengthBinding ← fresh
      let dataBinding ← fresh
      let memoryPointer ← if loc == "memory" then fresh else pure ""
      let nextFreeBinding ← if loc == "memory" then fresh else pure ""
      let copyIndexBinding ← if loc == "memory" then fresh else pure ""
      modify fun e =>
        let bound : CalldataBytesParam :=
          { param := name
            offsetBinding
            headerBinding
            lengthBinding
            dataBinding
            isString := true
            inMemory := loc == "memory"
            memoryPointer
            nextFreeBinding
            copyIndexBinding }
        let stringBuffers :=
          if loc == "memory" then
            e.stringBuffers.insert id
              { pre := #[], pointer := .add (.localVar memoryPointer) (.literal 32), size := .localVar lengthBinding }
          else
            e.stringBuffers
        let yulMemoryStructs :=
          if loc == "memory" && rawName != "" then
            e.yulMemoryStructs.insert rawName id
          else
            e.yulMemoryStructs
        { e with calldataBytes := e.calldataBytes.insert id bound, stringBuffers, yulMemoryStructs }
    else if let some fixedTy := fixedMemArrayType? ty then
      -- `T[N] memory` root parameter: a static ABI tuple of N words, validated
      -- and decoded eagerly to memory before the body (see `importSlice`).
      -- `T[N] calldata` keeps the generic parameter rejection.
      unless loc == "memory" do
        failAt p s!"unsupported parameter type {ty}"
      let (_, _, _, length) := fixedTy
      for i in [:length] do
        let binding := s!"{name}_{i}"
        if (← get).sourceNames.contains binding then
          failAt p s!"static array binding collides with source name {binding}"
        modify fun e => { e with bound := binding :: e.bound }
      let arr ← freshFixedMemArray "" fixedTy
      modify fun e =>
        { e with fixedMemArrays := e.fixedMemArrays.insert id arr, encodingMemory := true,
                 yulNames := if rawName == "" then e.yulNames else e.yulNames.erase rawName }
    else if let some (elemStr, elemPty, abiKind) := scalarArrayElement? ty then
      unless loc == "calldata" || loc == "memory" do
        failAt p s!"unsupported location {loc} for {ty}"
      let offsetBinding ← fresh
      let headerBinding ← fresh
      let lengthBinding ← fresh
      let dataBinding ← fresh
      let memoryPointer ← if loc == "memory" then fresh else pure ""
      let nextFreeBinding ← if loc == "memory" then fresh else pure ""
      let namePrefix ← if loc == "memory" then fresh else pure ""
      if loc == "memory" then
        for reserved in [s!"{namePrefix}_index"] do
          if (← get).sourceNames.contains reserved then
            failAt p s!"generated ABI helper name {reserved} collides with a source identifier"
          modify fun e => { e with bound := reserved :: e.bound }
      modify fun e =>
        let bound : ScalarArrayParam :=
          { param := name
            elementType := elemStr
            modelElementType := elemPty
            abiKind := abiKind
            inMemory := loc == "memory"
            offsetBinding
            headerBinding
            lengthBinding
            dataBinding
            memoryPointer
            nextFreeBinding
            namePrefix }
        { e with scalarArrays := e.scalarArrays.insert id bound,
                 yulMemoryArrays := if loc == "memory" && rawName != "" then e.yulMemoryArrays.insert rawName memoryPointer else e.yulMemoryArrays }
    else if ty.startsWith "struct " && !ty.contains "[" && (loc == "memory" || loc == "calldata") then
      let typeName ← mField p "typeName"
      let sid ← refInt typeName
      if sid < 0 then failAt p "builtin struct"
      let some decl := (← get).structs.find? sid.toNat | failAt p s!"unresolved struct {ty}"
      let members ← structMemberList decl
      let sname ← mStr (← mField decl "name")
      let staticTypes := members.toList.mapM (fun (_, ty) => if ty.startsWith "enum " || ty == "bytes4" || ty == "bytes1" then none else paramType ty)
      let schema ← if staticTypes.isSome then pure none else do
        let structs := (← get).structs
        let enums := (← get).enums
        match AbiSchema.root (fun id => structs.find? id) decl
            (resolveEnum := fun id => (enums.find? id).map (·.size)) with
        | .ok schema => pure (some schema)
        | .error failure => failAt failure.node failure.message
      let abiStem ← match schema with
        | none => pure ""
        | some schema => freshAbiStem schema (loc == "memory")
      let headBinding ← if staticTypes.isSome then fresh else pure ""
      if staticTypes.isSome then
        for i in [:members.size] do
          let binding := s!"{name}_{i}"
          if (← get).sourceNames.contains binding then
            failAt p s!"static tuple binding collides with source name {binding}"
          modify fun e => { e with bound := binding :: e.bound }
      modify fun e =>
        let bound : MemParam :=
          { structId := sid.toNat
            param := name
            structName := sname
            members := members
            staticTypes := staticTypes
            calldataLocation := loc == "calldata"
            headBinding := headBinding
            schema := schema
            abiStem := abiStem }
        { e with mems := e.mems.insert id bound,
                 yulMemoryStructs := if loc == "memory" && rawName != "" then e.yulMemoryStructs.insert rawName id else e.yulMemoryStructs }
    else if (ty == "bytes[]" || ty.startsWith "struct " && ty.endsWith "[]") &&
        (loc == "memory" || loc == "calldata") then
      -- Root `bytes[]` or `S[]` of a flat scalar struct: member `headWord` of
      -- the root argument tuple, lowered by the struct-member array readers.
      let structs := (← get).structs
      let enums := (← get).enums
      let member ← if ty == "bytes[]" then pure (.bytesArray name) else
        match AbiSchema.structArrayMember (fun id => structs.find? id) name
            (← mField p "typeName") (fun id => (enums.find? id).map (·.size)) with
        | .ok member => pure member
        | .error failure => failAt failure.node failure.message
      let schema := AbiRootLowering.rootArraySchema headWord member
      let abiStem ← freshAbiStem schema (loc == "memory") (rootArray := true)
      let elementStruct ← if ty == "bytes[]" then pure none else do
        let sid ← refInt (← mField (← mField p "typeName") "baseType")
        pure (if sid ≥ 0 then some sid.toNat else none)
      modify fun e =>
        let bound : MemParam :=
          { structId := 0, param := name, structName := "", members := #[]
            calldataLocation := loc == "calldata", schema := some schema, abiStem
            rootArrayWord := some headWord, rootArrayStructId := elementStruct }
        { e with mems := e.mems.insert id bound }
    else if ty.startsWith "struct " && !ty.contains "[" && loc == "storage" &&
        (optStr fn "visibility" == some "internal" || optStr fn "visibility" == some "private") then
      let typeName ← mField p "typeName"
      let sid ← refInt typeName
      if sid < 0 then failAt p "builtin struct"
      modify fun e =>
        { e with scalarTy := e.scalarTy.insert id .uint256,
                 paths := e.paths.insert id (.rawSlot sid.toNat (.param name)),
                 yulNames := if rawName == "" then e.yulNames else e.yulNames.insert rawName (.param name) }
    else if ty.startsWith "struct " && !ty.contains "[" then
      failAt p s!"unsupported location {loc} for {ty}"
    else
      -- `localParamType` also admits every `bytes1`..`bytes31` width (left-aligned words).
      let some pty := localParamType ty | failAt p s!"unsupported parameter type {ty}"
      let enumBound? ← validateEnumTypeIfNeeded p ty
      if enumBound?.isSome && !(← get).viaIR && (← get).abiCoderV1 then
        failAt p "enum parameter under ABI coder v1 is outside this slice"
      modify fun e =>
        let values := e.values.insert id (.param name)
        let scalarTy := e.scalarTy.insert id pty
        let enumBounds := match enumBound? with
          | some b => e.enumBounds.insert id b
          | none => e.enumBounds
        let bytes4Params := if ty == "bytes4" then e.bytes4Params.push id else e.bytes4Params
        let yulNames := if rawName == "" then e.yulNames else e.yulNames.insert rawName (.param name)
        { e with values, scalarTy, enumBounds, bytes4Params, yulNames }
    headWord := headWord + match (← get).fixedMemArrays.find? id, (← get).mems.find? id with
      | some arr, _ => arr.length
      | none, some { staticTypes := some types, .. } => paramHeadSize (.tuple types) / 32
      | _, _ => 1
  -- A `T[N] memory` root parameter has no Denote/compiler parameter loader,
  -- so its function decodes its whole ABI head explicitly.
  let explicitAbi := (← get).explicitAbi || (← get).mems.toList.any (fun (_, mem) => mem.schema.isSome) || !(← get).calldataBytes.isEmpty || !(← get).scalarArrays.isEmpty || !(← get).fixedMemArrays.isEmpty
  modify fun e => { e with explicitAbi }
  if explicitAbi then
    for p in params do
      let id ← mNat (← mField p "id")
      if let some mem := (← get).mems.find? id then
        if mem.staticTypes.isSome && (← get).mems.toList.any (fun (_, m) => m.schema.isSome) then
          failAt p "mixed static and dynamic struct parameters require explicit static-root lowering"
      else if !(← get).calldataBytes.contains id && !(← get).scalarArrays.contains id &&
          !(← get).fixedMemArrays.contains id then
        let rawName ← mStr (← mField p "name")
        let binding ← fresh
        modify fun e =>
          match e.paths.find? id with
          | some (.rawSlot sid _) =>
              { e with
                rawBindings := e.rawBindings.insert id binding
                paths := e.paths.insert id (.rawSlot sid (.localVar binding))
                yulNames := if rawName == "" then e.yulNames else e.yulNames.insert rawName (.localVar binding) }
          | _ =>
              { e with
                rawBindings := e.rawBindings.insert id binding
                values := e.values.insert id (.localVar binding)
                yulNames := if rawName == "" then e.yulNames else e.yulNames.insert rawName (.localVar binding) }
  pure out

/-- Return `components` from a root with a dynamic ABI return tuple: ABI-encode
them against the declared return parameters `retDecls` into a fresh memory
buffer (`lowerAbiEncodeArgs`, converting scalars and copying a storage array into
memory as solc does), run the modifier epilogue, and return the buffer through
the closed memory `return` transport. -/
private def lowerDynamicTupleReturn (components retDecls : Array Json) (at_ : Json) : M (Array Stmt) := do
  unless components.size == retDecls.size do
    failAt at_ s!"root multi-return arity {components.size} does not match {retDecls.size}"
  -- Components are lowered left to right; reject a memory write beside a
  -- memory read whose result would depend on that order.
  for i in [:components.size] do
    for k in [i + 1:components.size] do
      if memoryWriteOrderHazard components[i]! components[k]! (← get) then
        failAt components[k]! "memory-writing helper beside a memory read in a root return tuple"
  let payload ← lowerAbiEncodeArgs components (some retDecls) (memoryCopy := true)
  let pointer ← atom { pre := payload.pre, expr := payload.pointer }
  let size ← atom { pre := #[], expr := payload.size }
  -- The transport halts the frame; the unreachable empty revert closes the path
  -- for the compiler's exhaustive return analysis, as for dynamic struct returns.
  return pointer.pre ++ size.pre ++ (← get).rootPost ++
    #[.ecm Compiler.ECM.SolidityReturnMemory.module [pointer.expr, size.expr], .revertEmpty]

private def isForwardedInterfaceTupleWrite (bytesId : Nat) (write dst rhs : Json) : M Bool := do
  unless optStr write "operator" == some "=" &&
      optStr dst "nodeType" == some "TupleExpression" &&
      (field? dst "isInlineArray").bind (·.getBool?.toOption) == some false do
    return false
  let some (.arr #[dst0, dst1]) := field? dst "components" | return false
  if mentionsDeclaration bytesId dst0 then return false
  unless optStr dst1 "nodeType" == some "Identifier" &&
      (field? dst1 "referencedDeclaration").bind (·.getInt?.toOption) == some (Int.ofNat bytesId) do
    return false
  isInterfaceExternalCall rhs

/-- Validate a direct internal `(scalar, bytes memory)` helper call for tuple
forwarding and inline it once, returning its statements, result declarations,
scalar binding and bytes buffer. -/
private def inlineForwardedBytesTupleCall (call : Json) (rets : Array Json) :
    M (Array Stmt × Array Json × Nat × Expr × Nat × EncodedBytes) := do
  let callee ← mField call "expression"
  unless optStr call "kind" == some "functionCall" && (← mKind callee) == "Identifier" do
    failAt call "expected a direct internal helper for a forwarded bytes tuple"
  let (id, args) ← resolveCallTargetAndArgs call
  let env ← get
  let some fn := env.funs.find? id | failAt callee "expected an internal helper declaration"
  let results ← mArr (← mField (← mField fn "returnParameters") "parameters")
  let types ← results.mapM mType
  unless [some "internal", some "private"].contains (optStr fn "visibility") &&
      types.size == 2 && types == (← rets.mapM mType) && (paramType types[0]!).isSome &&
      types[1]! == "bytes" && optStr results[1]! "storageLocation" == some "memory" &&
      results.all (fun r => (optStr r "name").getD "" != "") do
    failAt call "expected a matching named (scalar, bytes memory) internal helper"
  let bytesId ← mNat (← mField results[1]! "id")
  -- Do not admit the external-call-to-bytes assignment transport here: its
  -- result is a word, not the callee's ABI-decoded dynamic buffer. A 2-tuple
  -- `(scalar, bytesId) = I(target).f(...)` interface call is admitted and
  -- lowered with full Solidity ABI return decoding in `lowerInterfaceBytesTupleCall`.
  for write in stateVarWrites bytesId (← mField fn "body") do
    let dst := (field? write "leftHandSide").getD .null
    let rhs := (field? write "rightHandSide").getD .null
    let member := (field? rhs "expression").getD .null
    let base := (field? member "expression").getD .null
    let isAbiEncodeWrite :=
      optStr dst "nodeType" == some "Identifier" && optStr write "operator" == some "=" &&
        optStr rhs "kind" == some "functionCall" && optStr member "nodeType" == some "MemberAccess" &&
        [some "encode", some "encodePacked"].contains (optStr member "memberName") &&
        optStr base "nodeType" == some "Identifier" && optStr base "name" == some "abi" &&
        ((field? base "referencedDeclaration").bind (·.getInt?.toOption)) == some (-1)
    let isInterfaceTupleWrite ← isForwardedInterfaceTupleWrite bytesId write dst rhs
    unless isAbiEncodeWrite || isInterfaceTupleWrite do
      failAt write "forwarded bytes result requires assignment from abi.encode or abi.encodePacked"
  let (pre, words) ← inlineMultiFn id args call true
  let scalarId ← mNat (← mField results[0]! "id")
  let [(scalar, _), (ptr, _), (size, _)] := words.toList
    | failAt call "invalid forwarded bytes result bindings"
  return (pre, results, scalarId, scalar, bytesId, { pre := #[], pointer := ptr, size })

/-- Inline a direct internal call once, run the root modifier epilogue, then
feed the captured scalar and bytes buffer to the ordinary root ABI encoder.
Helper result declaration IDs are unique and serve only as temporary handles
for that encoder. -/
private def lowerForwardedBytesTuple (call : Json) (rets : Array Json) : M (Array Stmt) := do
  let env ← get
  let (pre, results, scalarId, scalar, bytesId, buffer) ← inlineForwardedBytesTupleCall call rets
  let post := env.rootPost
  modify fun e => { e with values := e.values.insert scalarId scalar,
                           byteBuffers := e.byteBuffers.insert bytesId buffer,
                           rootPost := #[] }
  let ret ← lowerDynamicTupleReturn (← results.mapM returnParamIdentifier) rets call
  modify fun e => { e with values := env.values, byteBuffers := env.byteBuffers,
                           nonLiteralByteLocals := env.nonLiteralByteLocals,
                           rootPost := post }
  return pre ++ post ++ ret

/-- Whether two expressions read the same variable binding. -/
private def sameVariableRead : Expr → Expr → Bool
  | .localVar a, .localVar b => a == b
  | .param a, .param b => a == b
  | _, _ => false

/-- The trusted range-read shortcut and the start slot and slot count it reads, when `asm` is
the contiguous-range read block it replaces (`.rangeStorageRead` in `trustedImporterShortcuts`).
The block's Yul identifiers `startSlot` and `nSlots` must each resolve, through
`externalReferences`, to one distinct unshadowed `bytes32` / `uint256` Solidity variable, and the
block must reference no other declaration. `none` otherwise: the block then takes the ordinary
assembly lowering. -/
private def rangeReadBindings? (env : Env) (asm : Json) :
    Option (TrustedShortcutMatch × Expr × Expr) := do
  let m ← matchTrustedShortcut? asm
  guard (m.shortcut.lowering == .rangeStorageRead)
  -- `startSlot` and `nSlots` are the Yul names of the registered block, read only once its
  -- fingerprint matched: they locate its inputs, they do not select the shortcut.
  let startId ← inlineAssemblyIdentDecl? asm "startSlot"
  let countId ← inlineAssemblyIdentDecl? asm "nSlots"
  guard (startId != countId && inlineAssemblyRefsWithin asm [startId, countId])
  guard (env.scalarTy.find? startId == some .bytes32 && env.scalarTy.find? countId == some .uint256)
  let startExpr ← env.values.find? startId
  let countExpr ← env.values.find? countId
  let startYul ← env.yulNames.find? "startSlot"
  let countYul ← env.yulNames.find? "nSlots"
  guard (sameVariableRead startExpr startYul && sameVariableRead countExpr countYul)
  pure (m, startExpr, countExpr)

private partial def lowerRootStatements (stmts : Array Json) (isTail : Bool := false) : M (Array Stmt × Bool) := do
  let mut out : Array Stmt := #[]
  let mut returned := false
  -- Statements already lowered as part of a low-level call sequence.
  let mut consumed := 0
  for idx in [:stmts.size] do
    let s := stmts[idx]!
    if consumed > 0 then
      consumed := consumed - 1
      continue
    let stmtIsTail := isTail && idx + 1 == stmts.size
    -- A per-statement recovery point under `collectUnsupported` (see `recoverAt`;
    -- the failed statement's `Env` and its `out` contribution are discarded).
    try
      if returned then failAt s "statement after root return"
      match ← mKind s with
      | "Block" =>
          let saved ← get
          let (nested, nestedReturned) ← lowerRootStatements (← mArr (← mField s "statements")) stmtIsTail
          -- Restore lexical lookup maps, but retain fresh names and discovered dependencies.
          modify fun e =>
            { e with values := saved.values, writableLocals := saved.writableLocals, fnPtrs := saved.fnPtrs, paths := saved.paths,
                     snapshots := saved.snapshots, mems := saved.mems, abiElements := saved.abiElements, calldataBytes := saved.calldataBytes, scalarArrays := saved.scalarArrays, byteBuffers := saved.byteBuffers, stringBuffers := saved.stringBuffers, storageBytesVars := saved.storageBytesVars, storageDynamicArrayVars := saved.storageDynamicArrayVars, flatStructs := saved.flatStructs, scalarTy := saved.scalarTy, yulNames := saved.yulNames, yulMemoryArrays := saved.yulMemoryArrays, yulMemoryStructs := saved.yulMemoryStructs }
          out := out ++ nested
          returned := nestedReturned
      | "UncheckedBlock" =>
          let saved ← get
          modify fun e => { e with unchecked := true }
          let (uncheckedNested, uncheckedReturned) ← lowerRootStatements (← mArr (← mField s "statements")) stmtIsTail
          modify fun e =>
            { e with values := saved.values, writableLocals := saved.writableLocals, fnPtrs := saved.fnPtrs, paths := saved.paths,
                     snapshots := saved.snapshots, mems := saved.mems, abiElements := saved.abiElements, calldataBytes := saved.calldataBytes, scalarArrays := saved.scalarArrays, byteBuffers := saved.byteBuffers, stringBuffers := saved.stringBuffers, storageBytesVars := saved.storageBytesVars, storageDynamicArrayVars := saved.storageDynamicArrayVars, flatStructs := saved.flatStructs, scalarTy := saved.scalarTy, yulNames := saved.yulNames, yulMemoryArrays := saved.yulMemoryArrays, yulMemoryStructs := saved.yulMemoryStructs, unchecked := saved.unchecked }
          out := out ++ uncheckedNested
          returned := uncheckedReturned
      | "VariableDeclarationStatement" =>
          if let some (callStmts, following) ←
              lowerLowLevelCallSequence? s (stmts.toList.drop (idx + 1)) then
            out := out ++ callStmts
            consumed := following
          else
            out := out ++ (← lowerLocal s)
      | "ExpressionStatement" =>
          out := out ++ (← lowerEffect s)
          if ← stmtAlwaysReverts [] s then
            returned := true
      | "EmitStatement" =>
          out := out ++ (← lowerEmit s)
      | "RevertStatement" =>
          returned := true
          out := out ++ (← lowerRevert s)
      | "InlineAssembly" =>
          let env ← get
          let savedAsmYul := env.yulNames
          let extPre ← bindYulExternalConstants s
          let mut handledScratchReturn := false
          if stmtIsTail && env.rootPost.isEmpty && env.rootReturnTypes.size == 1 &&
              ["bytes32", "uint256", "uint", "int256", "int"].contains env.rootReturnTypes[0]! then
            if let some scratchStmts ← lowerTailScratchReturnAssembly? s then
              modify fun e => { e with yulNames := savedAsmYul }
              out := out ++ extPre ++ scratchStmts
              returned := true
              handledScratchReturn := true
          if !handledScratchReturn && stmtIsTail && env.rootPost.isEmpty &&
              env.rootReturnTypes == #["bytes32[]"] then
            -- Only a block over the one bound array can be the batch read; a block that does not
            -- reference it takes the ordinary lowering.
            let batchArr? := match env.scalarArrays.toList with
              | [(arrId, arr)] =>
                  if !arr.inMemory && inlineAssemblyRefsDecl s arrId then some (arrId, arr)
                  else none
              | _ => none
            if let some (arrId, arr) := batchArr? then
              -- The shortcut replaces the block: apply it only to a registered batch read
              -- (`trustedImporterShortcuts`) whose every Solidity reference resolves to the bound
              -- calldata array.
              let batchRead? := (matchTrustedShortcut? s).filter fun m =>
                (m.shortcut.lowering == .batchStorageRead ||
                  m.shortcut.lowering == .batchTransientRead) &&
                inlineAssemblyRefsOnlyDecl s arrId
              let some m := batchRead?
                | failAt s s!"shortcut fingerprint mismatch: tail assembly of a bytes32[]-returning function is not a registered calldata-keyed batch slot read (fingerprint {(yulBlockFingerprint s).take 12})"
              let shimStmts ← lowerBatchArrayLoadShim m arr
              modify fun e => { e with yulNames := savedAsmYul }
              out := out ++ extPre ++ shimStmts
              returned := true
              handledScratchReturn := true
            else if let some (m, startExpr, nSlotsExpr) := rangeReadBindings? env s then
              let shimStmts ← lowerBatchRangeSloadShim m startExpr nSlotsExpr
              modify fun e => { e with yulNames := savedAsmYul }
              out := out ++ extPre ++ shimStmts
              returned := true
              handledScratchReturn := true
          unless handledScratchReturn do
            let mut asmRetName := ""
            let savedHelperResult := env.helperResult
            let savedHelperReturnId := env.helperReturnId
            if stmtIsTail && env.rootPost.isEmpty then
              if let some (rid, rname, rty, rbinding) := env.rootNamedReturn then
                if yulOnlyAssignsDecl s rid then
                  asmRetName := rname
                  modify fun e => { e with helperResult := some (rbinding, rty), helperReturnId := some rid }
            let asmStmts ← lowerAssemblyStmts s asmRetName (stmtIsTail && env.rootPost.isEmpty)
            modify fun e => { e with helperResult := savedHelperResult, helperReturnId := savedHelperReturnId, yulNames := savedAsmYul }
            out := out ++ extPre ++ asmStmts
      | "ForStatement" =>
          out := out ++ (← lowerFor s fun body => do
            let statements ← if (← mKind body) == "Block" then mArr (← mField body "statements") else pure #[body]
            let (lowered, _) ← lowerRootStatements statements false
            pure lowered)
      | "WhileStatement" =>
          out := out ++ (← lowerWhile s fun body => do
            let statements ← if (← mKind body) == "Block" then mArr (← mField body "statements") else pure #[body]
            let (lowered, _) ← lowerRootStatements statements false
            pure lowered)
      | "IfStatement" | "TryStatement" =>
          let parts ←
            if (← mKind s) == "IfStatement" then do
              let (condition, yes, no) ← ifParts s
              pure ({ condition, yes, no } : TryParts)
            else do
              let some parts ← (do
                  rejectThisTryCall s
                  lowerInterfaceTryCall? s)
                | failAt s "unsupported statement TryStatement"
              pure parts
          let condition := parts.condition
          let saved ← get
          let restore : M Unit := modify fun e =>
            { e with values := saved.values, writableLocals := saved.writableLocals, fnPtrs := saved.fnPtrs, paths := saved.paths, snapshots := saved.snapshots, mems := saved.mems, abiElements := saved.abiElements, calldataBytes := saved.calldataBytes, scalarArrays := saved.scalarArrays, byteBuffers := saved.byteBuffers, stringBuffers := saved.stringBuffers, storageBytesVars := saved.storageBytesVars, storageDynamicArrayVars := saved.storageDynamicArrayVars, flatStructs := saved.flatStructs,
                     scalarTy := saved.scalarTy, yulNames := saved.yulNames, yulMemoryArrays := saved.yulMemoryArrays, yulMemoryStructs := saved.yulMemoryStructs }
          -- A root return inside a branch stops execution, so the continuation
          -- stays after the conditional and runs only on fallthrough.
          let yesSetup ← parts.yesSetup
          let (yesOut, yesReturned) ← lowerRootStatements parts.yes stmtIsTail
          restore
          let noSetup ← parts.noSetup
          let (noOut, noReturned) ← lowerRootStatements parts.no stmtIsTail
          restore
          out := out ++ condition.pre |>.push (.ite condition.expr (yesSetup ++ yesOut).toList
            (noSetup ++ noOut).toList)
          returned := yesReturned && noReturned
      | "Return" =>
          returned := true
          let expr := field? s "expression" |>.getD Json.null
          let env ← get
          if expr.isNull then
            if env.rootIsVoid then
              out := out ++ env.rootPost ++ #[.stop]
            else if !env.rootReturns.isEmpty then
              out := out ++ env.rootPost ++ #[.returnValues env.rootReturns.toList]
            else
              failAt s "bare return requires a void or named-return root function"
          else if let some retDecls := env.rootDynamicTupleReturn then
            let isTuple ← if (← mKind expr) == "TupleExpression" then
                pure !(← mBool (← mField expr "isInlineArray"))
              else pure false
            let components ← if isTuple then mArr (← mField expr "components") else pure #[expr]
            if components.any (·.isNull) then failAt expr "empty return component"
            let forward ← if let #[_, last] := retDecls then
                pure ((← mType last) == "bytes" && (← mKind expr) == "FunctionCall")
              else pure false
            if forward then
              out := out ++ (← lowerForwardedBytesTuple expr retDecls)
            else
              out := out ++ (← lowerDynamicTupleReturn components retDecls expr)
          else if let some (elemTy, _, length) := env.rootFixedArrayReturn then
            let isInlineArr ← if (← mKind expr) == "TupleExpression" then
              mBool (← mField expr "isInlineArray")
            else
              pure false
            if isInlineArr then
              let cs ← mArr (← mField expr "components")
              unless cs.size == length do
                failAt expr s!"inline return array length {cs.size} does not match return type length {length}"
              let mut pres : Array Stmt := #[]
              let mut exprs : Array Expr := #[]
              for c in cs do
                if c.isNull then failAt expr "empty return component"
                if cs.size > 1 && (statefulCallIn c (← get) || assignmentIn c) then
                  failAt c "stateful or assignment expression in inline return array requires explicit evaluation-order support"
                let raw ← lowerConverted elemTy c
                let v ← atom { raw with expr := cleanHelperResultExpr elemTy raw }
                pres := pres ++ v.pre
                if env.rootPost.isEmpty then
                  exprs := exprs.push v.expr
                else
                  let captured ← fresh
                  pres := pres.push (.letVar captured v.expr)
                  exprs := exprs.push (.localVar captured)
              out := (out ++ pres ++ env.rootPost).push (.returnValues exprs.toList)
            else if (← isFixedMemArrayValue expr) then
              -- A `T[N] memory` value returns its N words as the static ABI tuple.
              let (valPre, arr) ← lowerFixedMemArrayValue expr
              unless arr.length == length && arr.elementType == elemTy do
                failAt expr "fixed-size array return value differs from return type"
              let mut pres := valPre
              let mut exprs : Array Expr := #[]
              for i in [:length] do
                let captured ← fresh
                pres := pres.push (.letVar captured (.mload (fixedMemElementAddr arr (.literal i))))
                exprs := exprs.push (.localVar captured)
              out := (out ++ pres ++ env.rootPost).push (.returnValues exprs.toList)
            else if (← mKind expr) == "Identifier" then
              let id ← refInt expr
              if id ≥ 0 then
                if let some elements := env.snapshots.find? id.toNat then
                  unless elements.size == length && ((← mType expr).splitOn " ").head! == s!"{elemTy}[{length}]" do
                    failAt expr "fixed-size array return snapshot type differs from return type"
                  if env.rootPost.isEmpty then
                    out := out.push (.returnValues elements.toList)
                  else
                    let mut pres : Array Stmt := #[]
                    let mut exprs : Array Expr := #[]
                    for elem in elements do
                      let captured ← fresh
                      pres := pres.push (.letVar captured elem)
                      exprs := exprs.push (.localVar captured)
                    out := (out ++ pres ++ env.rootPost).push (.returnValues exprs.toList)
                else
                  failAt expr "fixed-size array return requires an inline array or fixed array snapshot"
              else
                failAt expr "fixed-size array return requires an inline array or fixed array snapshot"
            else
              failAt expr "fixed-size array return requires an inline array or fixed array snapshot"
          else if env.rootDynamicBytesReturn.isSome && (← canLowerDynamicBytesReturnExpr expr) then
            let buf ← lowerEncodedBytes expr
            let stem ← fresh
            let memStem := s!"_verity_memret_{stem}"
            let dataBinding := s!"{memStem}_data_offset"
            let lenBinding := s!"{memStem}_length"
            if (← get).sourceNames.contains dataBinding || (← get).sourceNames.contains lenBinding then
              failAt s s!"generated return buffer name {memStem} collides with a source identifier"
            modify fun e =>
              { e with encodingMemory := true,
                       bound := dataBinding :: lenBinding :: e.bound }
            let bindStmts := #[Stmt.letVar dataBinding buf.pointer, Stmt.letVar lenBinding buf.size]
            out := (out ++ buf.pre ++ bindStmts ++ env.rootPost).push (.returnBytes memStem)
          else if let some (retSid, _) := env.rootDynamicStructReturn then
            let (rootId, effects) ← lowerDynamicStructReturnValue expr retSid
            let buffer ← lowerEncodedMem rootId effects expr
            let pointer ← atom { pre := buffer.pre, expr := buffer.pointer }
            let returnSize ← atom { pre := #[], expr := buffer.size }
            -- The transport halts the frame. `Stmt.ecm` metadata cannot state
            -- termination, so an unreachable empty revert closes the path for
            -- the compiler's exhaustive return analysis (#738).
            out := (out ++ pointer.pre ++ returnSize.pre ++ env.rootPost) ++
              #[.ecm Compiler.ECM.SolidityReturnMemory.module [pointer.expr, returnSize.expr],
                .revertEmpty]
          else if env.rootMsgDataReturn then
            let msgDataPre ← lowerMsgDataExpr expr
            out := (out ++ msgDataPre ++ env.rootPost).push
              (.returnValues [.literal 32, .calldatasize, .calldataload (.literal 0)])
          else if let some (retSid, _, memberBindings, isNamed) := env.rootFlatStructReturn then
            let isSameNamedReturn ← if isNamed && (← mKind expr) == "Identifier" then do
              let id ← refInt expr
              if id ≥ 0 then
                if let some flat := env.flatStructs.find? id.toNat then
                  pure (flat.members == memberBindings)
                else pure false
              else pure false
            else pure false
            if isSameNamedReturn then
              if env.rootPost.isEmpty then
                out := out.push (.returnValues env.rootReturns.toList)
              else
                let mut pres : Array Stmt := #[]
                let mut exprs : Array Expr := #[]
                for retExpr in env.rootReturns do
                  let captured ← fresh
                  pres := pres.push (.letVar captured retExpr)
                  exprs := exprs.push (.localVar captured)
                out := (out ++ pres ++ env.rootPost).push (.returnValues exprs.toList)
            else
              let (exprSid, _, valPre, memberVals) ← lowerFlatStructValue expr (some retSid) true
              unless exprSid == retSid && memberVals.size == memberBindings.size do
                failAt expr "root struct return member count mismatch"
              let mut pres := valPre
              let mut exprs : Array Expr := #[]
              for (_, _, valExpr) in memberVals do
                if env.rootPost.isEmpty then
                  exprs := exprs.push valExpr
                else
                  let captured ← fresh
                  pres := pres.push (.letVar captured valExpr)
                  exprs := exprs.push (.localVar captured)
              out := (out ++ pres ++ env.rootPost).push (.returnValues exprs.toList)
          else if (← mKind expr) == "TupleExpression" then
            if ← mBool (← mField expr "isInlineArray") then
              failAt expr "inline arrays are outside this slice"
            let cs ← mArr (← mField expr "components")
            let mut pres : Array Stmt := #[]
            let mut exprs : Array Expr := #[]
            unless cs.size == env.rootReturnTypes.size do failAt expr "root return arity mismatch"
            for (c, ty) in cs.zip env.rootReturnTypes do
              if c.isNull then failAt expr "empty return component"
              let raw ← lowerConverted ty c
              let v ← atom { raw with expr := cleanHelperResultExpr ty raw }
              pres := pres ++ v.pre
              if env.rootPost.isEmpty then
                exprs := exprs.push v.expr
              else
                let captured ← fresh
                pres := pres.push (.letVar captured v.expr)
                exprs := exprs.push (.localVar captured)
            out := (out ++ pres ++ env.rootPost).push (.returnValues exprs.toList)
          else if env.rootReturnTypes.size > 1 && env.rootFixedArrayReturn.isNone then
            let expectedTypes := env.rootReturnTypes.map some
            let (branchPre, retExprs) ← lowerMultiBranch expr (some expectedTypes)
            unless retExprs.size == env.rootReturnTypes.size do
              failAt expr s!"root multi-return arity {retExprs.size} does not match {env.rootReturnTypes.size}"
            let mut pres := branchPre
            let mut exprs : Array Expr := #[]
            for (valExpr, valTy) in retExprs do
              let valExpr := cleanHelperResultExpr valTy { pre := #[], expr := valExpr }
              if env.rootPost.isEmpty then
                exprs := exprs.push valExpr
              else
                let captured ← fresh
                pres := pres.push (.letVar captured valExpr)
                exprs := exprs.push (.localVar captured)
            out := (out ++ pres ++ env.rootPost).push (.returnValues exprs.toList)
          else if env.rootReturnTypes.size == 1 && (env.rootReturnTypes[0]!).startsWith "struct " &&
              !(env.rootReturnTypes[0]!).contains "[" && env.rootFlatStructReturn.isNone && env.rootDynamicStructReturn.isNone then
            match ← lowerRef expr with
            | .path rpre rpath =>
                let (slotPre, slotExpr) ← match rpath with
                  | .rawSlot _ sl => pure (#[], sl)
                  | .zero rawField | .one rawField _ | .two rawField _ _ => do
                      let (f, subPrefix) := splitSPathField rawField
                      unless subPrefix.isEmpty do
                        failAt expr "nested storage struct return requires a flat memory result"
                      let info ← resolveField f s
                      markField f
                      computeSPathBaseSlot rpath info 0 s
                  | _ => failAt expr "unsupported storage struct return path"
                let v ← atom { pre := rpre ++ slotPre, expr := slotExpr }
                out := out ++ v.pre ++ env.rootPost |>.push (.returnValues [v.expr])
            | .mem .. =>
                if (← mType expr).endsWith " calldata" then
                  failAt expr "ABI returns of calldata structs are unsupported"
                failAt expr "ABI returns of memory structs with bytes members are unsupported"
            | _ => failAt expr "storage struct return requires a storage path"
          else
            let ty := env.rootReturnTypes[0]?.getD ""
            let action := match ← selectorComparisonCall? expr with
              | some call => withAdmittedInterfaceCall (some call) (lowerExprAs ty expr)
              | none => lowerExprAs ty expr
            let raw ← if ty.startsWith "enum " && env.rootPost.isEmpty then
              withStorageEnumUse expr true action else action
            let exprTy ← mType expr
            let converted ← if ty == "" || ty.startsWith "enum " then pure raw
              else convert ty exprTy raw expr
            let cleanTy := if ty == "" then exprTy else ty
            let v ← atom { converted with expr := cleanHelperResultExpr cleanTy converted }
            if env.rootPost.isEmpty then
              out := out ++ v.pre |>.push (.returnValues [v.expr])
            else
              let captured ← fresh
              out := ((out ++ v.pre).push (.letVar captured v.expr) ++ env.rootPost).push (.returnValues [.localVar captured])
      | kind => failAt s s!"unsupported statement {kind}"
    catch e =>
      let some sink := (← get).unsupportedSink | throw e
      if e.isInterrupt || e.isRuntime then throw e
      recordUnsupported sink s e
      sink.skippedDecls.modify (· ++ declaredVariables s)
  pure (out, returned)

private def lowerPublicVarGetter (varDecl : Json) : M (Array Stmt × Array SrcParam) := do
  let rootId ← mNat (← mField varDecl "id")
  modify fun e => { e with stack := [rootId] }
  noteProfiledFn varDecl
  let name ← mStr (← mField varDecl "name")
  let isConstant := (field? varDecl "constant").bind (fun v => v.getBool?.toOption) == some true
  let mutability := optStr varDecl "mutability" |>.getD "mutable"
  if mutability == "immutable" then
    let bound ← bindChainImmutables
    let some (_, _, pty, _) := bound.find? (·.1 == rootId)
      | failAt varDecl s!"immutable state variable {name} is outside this slice"
    let some value := (← get).values.find? rootId
      | failAt varDecl s!"immutable state variable {name} is outside this slice"
    modify fun e => { e with publicVarGetterReturns := #[pty] }
    return (#[.returnValues [value]], #[])
  if isConstant || mutability == "constant" then
    let declared ← mType varDecl
    let initializer ← mField varDecl "value"
    if declared == "string" || declared == "bytes" then
      let some literal ← constantByteLiteral? initializer
        | failAt initializer "byte constant must have a literal initializer"
      let buf ← lowerEncodedBytes literal
      let stem ← fresh
      let memStem := s!"_verity_memret_{stem}"
      let dataBinding := s!"{memStem}_data_offset"
      let lenBinding := s!"{memStem}_length"
      if (← get).sourceNames.contains dataBinding || (← get).sourceNames.contains lenBinding then
        failAt varDecl s!"generated return buffer name {memStem} collides with a source identifier"
      modify fun e =>
        { e with encodingMemory := true,
                 bound := dataBinding :: lenBinding :: e.bound,
                 publicVarGetterReturns := #[if declared == "string" then .string else .bytes] }
      let getterBindStmts := #[Stmt.letVar dataBinding buf.pointer, Stmt.letVar lenBinding buf.size]
      return ((buf.pre ++ getterBindStmts).push (.returnBytes memStem), #[])
    let some pty := localParamType declared
      | failAt varDecl s!"unsupported public constant type {declared}"
    discard (validateEnumTypeIfNeeded varDecl declared)
    unless (declared.startsWith "uint" && (bitsOf declared).isSome) ||
        declared == "bool" || (fixedBytesWidth? declared).isSome ||
        (signedBitsOf declared).isSome ||
        declared == "address" || declared == "address payable" ||
        declared.startsWith "contract " || declared.startsWith "enum " do
      failAt varDecl s!"unsupported public constant type {declared}"
    modify fun e => { e with constantStack := [rootId] }
    let rawValue ← lowerExprAs declared initializer
    let initTy ← mType initializer
    let value ← convert declared initTy rawValue initializer
    let a ← atom { value with expr := cleanHelperResultExpr declared value }
    modify fun e => { e with constantStack := [], publicVarGetterReturns := #[pty] }
    return (a.pre.push (.returnValues [a.expr]), #[])
  let env ← get
  if env.duplicateLayoutLabels.contains name then
    failAt varDecl s!"shadowed storage declaration {name} is outside this slice"
  if let some item := env.layoutItems.find? name then
    unless (← mNat (← mField item "astId")) == rootId do
      failAt varDecl s!"shadowed storage declaration {name} is outside this slice"
  let info ← resolveField name varDecl
  let (paramSpecs, leafTypeNode) ← publicVarGetterParamTypes (← mField varDecl "typeName")
  let mut srcParams : Array SrcParam := #[]
  let mut paramExprs : Array Expr := #[]
  for idx in [:paramSpecs.size] do
    let (rawParamTy, paramNode) := paramSpecs[idx]!
    let resolvedParamTy ←
      if (← mKind paramNode) == "ArrayTypeName" then pure "uint256" else mType paramNode
    let some pty := paramType resolvedParamTy
      | failAt paramNode s!"unsupported public getter parameter type {rawParamTy}"
    let enumBound? ← validateEnumTypeIfNeeded paramNode resolvedParamTy
    let pid := 100000000 + idx
    let pname ← freshFor s!"arg{idx}"
    let explicitAbi := (← get).explicitAbi
    let binding ← if explicitAbi then fresh else pure pname
    let pexpr := if explicitAbi then Expr.localVar binding else Expr.param pname
    modify fun e =>
      let values := e.values.insert pid pexpr
      let scalarTy := e.scalarTy.insert pid pty
      let enumBounds := match enumBound? with
        | some b => e.enumBounds.insert pid b
        | none => e.enumBounds
      let bytes4Params := if resolvedParamTy == "bytes4" then e.bytes4Params.push pid else e.bytes4Params
      { e with values, scalarTy, enumBounds, bytes4Params,
               rawBindings := if explicitAbi then e.rawBindings.insert pid binding else e.rawBindings }
    srcParams := srcParams.push { name := pname, id := pid }
    paramExprs := paramExprs.push pexpr
  let readPublicStructGetterMembers (path : SPath) (pre0 : Array Stmt) (allowFixedArrays : Bool := false) :
      M (Array Stmt × Array Expr × Array ParamType) := do
    let sid ← refInt leafTypeNode
    unless sid ≥ 0 do
      failAt varDecl "unresolved struct in public state variable getter"
    let some sDecl := (← get).structs.find? sid.toNat
      | failAt varDecl "unresolved struct in public state variable getter"
    let sMembers ← mArr (← mField sDecl "members")
    unless !sMembers.isEmpty do
      failAt varDecl "empty struct in public state variable getter is unsupported"
    let mut pre := pre0
    let mut retExprs : Array Expr := #[]
    let mut retTypes : Array ParamType := #[]
    for mNode in sMembers do
      let mName ← mStr (← mField mNode "name")
      let mTyNode ← mField mNode "typeName"
      if allowFixedArrays && (← mKind mTyNode) == "ArrayTypeName" &&
          info.structFixedArrays.any (·.member == mName) then
        continue
      let mTy ← mType mNode
      let some mPty := paramType mTy
        | failAt mNode s!"unsupported public struct getter member {mName} of type {mTy}"
      if mTy.startsWith "enum " then
        failAt mNode "public struct getter with an enum member is outside this slice"
      let v ← memberRead #[] path mName varDecl
      let a ← atom v
      pre := pre ++ a.pre
      retExprs := retExprs.push a.expr
      retTypes := retTypes.push mPty
    unless !retExprs.isEmpty do
      failAt varDecl s!"public struct getter for {name} must return at least one scalar member"
    return (pre, retExprs, retTypes)
  if paramSpecs.isEmpty then
    if info.bytesStorage then
      let buf ← lowerStorageBytesRead #[] name (.literal info.slot) varDecl
      let stem ← fresh
      let memStem := s!"_verity_memret_{stem}"
      let dataBinding := s!"{memStem}_data_offset"
      let lenBinding := s!"{memStem}_length"
      if (← get).sourceNames.contains dataBinding || (← get).sourceNames.contains lenBinding then
        failAt varDecl s!"generated return buffer name {memStem} collides with a source identifier"
      modify fun e =>
        { e with encodingMemory := true,
                 bound := dataBinding :: lenBinding :: e.bound,
                 publicVarGetterReturns := #[if info.stringStorage then .string else .bytes] }
      let getterBindStmts := #[Stmt.letVar dataBinding buf.pointer, Stmt.letVar lenBinding buf.size]
      return ((buf.pre ++ getterBindStmts).push (.returnBytes memStem), srcParams)
    if (!info.structMembers.isEmpty || !info.structFixedArrays.isEmpty) && info.fixedArrayLength.isNone then
      unless info.opaqueNames.isEmpty && info.structMappings.isEmpty &&
          info.structDynamicArrays.isEmpty && info.subStructs.isEmpty do
        failAt varDecl s!"public struct getter for {name} with nested or non-scalar members is outside this slice"
      let (pre, retExprs, retTypes) ← readPublicStructGetterMembers (.zero name) #[] true
      modify fun e => { e with publicVarGetterReturns := retTypes }
      return (pre.push (.returnValues retExprs.toList), srcParams)
    unless info.keyCount == 0 && info.structMembers.isEmpty && !info.bytesStorage &&
        info.dynamicArrayElemType.isNone && info.fixedArrayLength.isNone do
      failAt varDecl s!"unsupported public state variable getter layout for {name}"
    let ty ← mType leafTypeNode
    let some pty := paramType ty
      | failAt varDecl s!"unsupported public state variable type {ty}"
    discard (validateEnumTypeIfNeeded varDecl ty)
    markField name
    let readExpr :=
      if info.booleanScalar then Expr.logicalNot (.logicalNot (.storage name))
      else Expr.storage name
    modify fun e => { e with publicVarGetterReturns := #[pty] }
    return (#[.returnValues [readExpr]], srcParams)
  else if paramSpecs.size == 1 then
    let k0 := paramExprs.getD 0 (.literal 0)
    if let some elemSid := info.dynamicArrayStructId then
      let rawInfo ← resolveRawStructInfo elemSid varDecl
      unless rawInfo.mappings.isEmpty && rawInfo.dynamicArrays.isEmpty && rawInfo.subStructs.isEmpty &&
          rawInfo.opaqueMemberNames.isEmpty do
        failAt varDecl s!"public struct array getter for {name} with nested or non-scalar members is outside this slice"
      let (elemPre, elemPath) ← storageDynamicStructElementPath #[] name (.literal info.slot) elemSid k0 varDecl .revertEmpty
      let (pre, retExprs, retTypes) ← readPublicStructGetterMembers elemPath elemPre
      modify fun e => { e with publicVarGetterReturns := retTypes }
      return (pre.push (.returnValues retExprs.toList), srcParams)
    if let some (elemTy, _, _) := info.dynamicArrayElemType then
      let resolvedElemTy ← mType leafTypeNode
      let some pty := paramType resolvedElemTy
        | failAt varDecl s!"unsupported public dynamic array element type {resolvedElemTy}"
      discard (validateEnumTypeIfNeeded leafTypeNode resolvedElemTy)
      let v ← readStorageDynamicArrayElement #[] name (.literal info.slot) elemTy k0 .revertEmpty
      let a ← atom v
      modify fun e => { e with publicVarGetterReturns := #[pty] }
      return (a.pre.push (.returnValues [a.expr]), srcParams)
    if info.keyCount == 0 && info.fixedArrayLength.isSome then
      let some length := info.fixedArrayLength | failAt varDecl "missing fixed array layout"
      let resolvedElemTy ← mType leafTypeNode
      let some pty := paramType resolvedElemTy
        | failAt varDecl s!"unsupported public fixed array element type {resolvedElemTy}"
      discard (validateEnumTypeIfNeeded leafTypeNode resolvedElemTy)
      let dest ← fresh
      let mut pre : Array Stmt := #[
        .ite (.lt k0 (.literal length)) [] [.revertEmpty],
        .letVar dest (.literal 0)
      ]
      for i in [:length] do
        let readExpr := Expr.storage (topStructMemberFieldName name s!"__solidity_element_{i}")
        pre := pre.push (.ite (.eq k0 (.literal i)) [.assignVar dest readExpr] [])
      markField name
      modify fun e => { e with publicVarGetterReturns := #[pty] }
      return (pre.push (.returnValues [.localVar dest]), srcParams)
    if info.keyCount == 1 && info.fixedArrayLength.isNone then
      if info.bytesStorage then
        let (slotStmts, slotExpr) ← computeSPathBaseSlot (.one name k0) info 0 varDecl
        let buf ← lowerStorageBytesRead slotStmts "" slotExpr varDecl
        let stem ← fresh
        let memStem := s!"_verity_memret_{stem}"
        let dataBinding := s!"{memStem}_data_offset"
        let lenBinding := s!"{memStem}_length"
        if (← get).sourceNames.contains dataBinding || (← get).sourceNames.contains lenBinding then
          failAt varDecl s!"generated return buffer name {memStem} collides with a source identifier"
        modify fun e =>
          { e with encodingMemory := true,
                   bound := dataBinding :: lenBinding :: e.bound,
                   publicVarGetterReturns := #[if info.stringStorage then .string else .bytes] }
        let getterBindStmts := #[Stmt.letVar dataBinding buf.pointer, Stmt.letVar lenBinding buf.size]
        return ((buf.pre ++ getterBindStmts).push (.returnBytes memStem), srcParams)
      else if info.scalarMapping then
        let resolvedValTy ← mType leafTypeNode
        let some pty := paramType resolvedValTy
          | failAt varDecl s!"unsupported public mapping value type {resolvedValTy}"
        discard (validateEnumTypeIfNeeded leafTypeNode resolvedValTy)
        let v ← scalarMappingRead #[] (.one name k0) varDecl
        let a ← atom v
        modify fun e => { e with publicVarGetterReturns := #[pty] }
        return (a.pre.push (.returnValues [a.expr]), srcParams)
      else
        unless info.opaqueNames.isEmpty && info.structMappings.isEmpty &&
            info.structDynamicArrays.isEmpty && info.subStructs.isEmpty do
          failAt varDecl s!"public mapping struct getter for {name} with nested or non-scalar members is outside this slice"
        let (pre, retExprs, retTypes) ← readPublicStructGetterMembers (.one name k0) #[] true
        modify fun e => { e with publicVarGetterReturns := retTypes }
        return (pre.push (.returnValues retExprs.toList), srcParams)
    failAt varDecl s!"unsupported public state variable getter layout for {name}"
  else if paramSpecs.size == 2 then
    let k0 := paramExprs.getD 0 (.literal 0)
    let k1 := paramExprs.getD 1 (.literal 0)
    if info.keyCount == 2 && info.fixedArrayLength.isNone && info.thirdKeyMapping.isNone then
      if info.bytesStorage then
        let (slotStmts, slotExpr) ← computeSPathBaseSlot (.two name k0 k1) info 0 varDecl
        let buf ← lowerStorageBytesRead slotStmts "" slotExpr varDecl
        let stem ← fresh
        let memStem := s!"_verity_memret_{stem}"
        let dataBinding := s!"{memStem}_data_offset"
        let lenBinding := s!"{memStem}_length"
        if (← get).sourceNames.contains dataBinding || (← get).sourceNames.contains lenBinding then
          failAt varDecl s!"generated return buffer name {memStem} collides with a source identifier"
        modify fun e =>
          { e with encodingMemory := true,
                   bound := dataBinding :: lenBinding :: e.bound,
                   publicVarGetterReturns := #[if info.stringStorage then .string else .bytes] }
        let getterBindStmts := #[Stmt.letVar dataBinding buf.pointer, Stmt.letVar lenBinding buf.size]
        return ((buf.pre ++ getterBindStmts).push (.returnBytes memStem), srcParams)
      else if info.scalarMapping then
        let resolvedValTy ← mType leafTypeNode
        let some pty := paramType resolvedValTy
          | failAt varDecl s!"unsupported public mapping value type {resolvedValTy}"
        discard (validateEnumTypeIfNeeded leafTypeNode resolvedValTy)
        let v ← scalarMappingRead #[] (.two name k0 k1) varDecl
        let a ← atom v
        modify fun e => { e with publicVarGetterReturns := #[pty] }
        return (a.pre.push (.returnValues [a.expr]), srcParams)
      else
        unless info.opaqueNames.isEmpty && info.structMappings.isEmpty &&
            info.structDynamicArrays.isEmpty && info.subStructs.isEmpty do
          failAt varDecl s!"public mapping struct getter for {name} with nested or non-scalar members is outside this slice"
        let (pre, retExprs, retTypes) ← readPublicStructGetterMembers (.two name k0 k1) #[] true
        modify fun e => { e with publicVarGetterReturns := retTypes }
        return (pre.push (.returnValues retExprs.toList), srcParams)
    if info.keyCount == 1 && info.fixedArrayLength.isSome then
      let some length := info.fixedArrayLength | failAt varDecl "missing fixed array layout"
      let resolvedElemTy ← mType leafTypeNode
      let some pty := paramType resolvedElemTy
        | failAt varDecl s!"unsupported public mapping array element type {resolvedElemTy}"
      discard (validateEnumTypeIfNeeded leafTypeNode resolvedElemTy)
      let dest ← fresh
      let mut pre : Array Stmt := #[
        .ite (.lt k1 (.literal length)) [] [.revertEmpty],
        .letVar dest (.literal 0)
      ]
      for i in [:length] do
        let readExpr := Expr.structMember name k0 s!"__solidity_element_{i}"
        pre := pre.push (.ite (.eq k1 (.literal i)) [.assignVar dest readExpr] [])
      markField name
      modify fun e => { e with publicVarGetterReturns := #[pty] }
      return (pre.push (.returnValues [.localVar dest]), srcParams)
    failAt varDecl s!"unsupported public state variable getter layout for {name}"
  else if paramSpecs.size == 3 then
    let k0 := paramExprs.getD 0 (.literal 0)
    let k1 := paramExprs.getD 1 (.literal 0)
    let k2 := paramExprs.getD 2 (.literal 0)
    if info.keyCount == 2 && info.thirdKeyMapping.isSome then
      let some mapInfo := info.thirdKeyMapping | failAt varDecl "missing 3-key mapping info"
      if let some valSid := mapInfo.valueStructId then
        let rawInfo ← resolveRawStructInfo valSid varDecl
        unless rawInfo.mappings.isEmpty && rawInfo.dynamicArrays.isEmpty && rawInfo.subStructs.isEmpty &&
            rawInfo.opaqueMemberNames.isEmpty do
          failAt varDecl s!"public 3-key mapping struct getter for {name} with nested or non-scalar members is outside this slice"
        markField name
        markStructMapping name mapInfo.member
        let (slotStmts, slotExpr) ← computeStructMappingLeafSlot (.two name k0 k1) info mapInfo k2 varDecl
        let (pre, retExprs, retTypes) ← readPublicStructGetterMembers (.rawSlot valSid slotExpr) slotStmts
        modify fun e => { e with publicVarGetterReturns := retTypes }
        return (pre.push (.returnValues retExprs.toList), srcParams)
      else
        let resolvedValTy ← mType leafTypeNode
        let some pty := paramType resolvedValTy
          | failAt varDecl s!"unsupported public 3-key mapping value type {resolvedValTy}"
        discard (validateEnumTypeIfNeeded leafTypeNode resolvedValTy)
        let v ← readStructMappingElement #[] (.two name k0 k1) mapInfo k2 varDecl
        let a ← atom v
        modify fun e => { e with publicVarGetterReturns := #[pty] }
        return (a.pre.push (.returnValues [a.expr]), srcParams)
    if info.keyCount == 2 && info.fixedArrayLength.isSome then
      let some length := info.fixedArrayLength | failAt varDecl "missing fixed array layout"
      let resolvedElemTy ← mType leafTypeNode
      let some pty := paramType resolvedElemTy
        | failAt varDecl s!"unsupported public mapping array element type {resolvedElemTy}"
      discard (validateEnumTypeIfNeeded leafTypeNode resolvedElemTy)
      let dest ← fresh
      let mut pre : Array Stmt := #[
        .ite (.lt k2 (.literal length)) [] [.revertEmpty],
        .letVar dest (.literal 0)
      ]
      for i in [:length] do
        let readExpr := Expr.structMember2 name k0 k1 s!"__solidity_element_{i}"
        pre := pre.push (.ite (.eq k2 (.literal i)) [.assignVar dest readExpr] [])
      markField name
      modify fun e => { e with publicVarGetterReturns := #[pty] }
      return (pre.push (.returnValues [.localVar dest]), srcParams)
    failAt varDecl s!"unsupported public state variable getter layout for {name}"
  else
    failAt varDecl s!"unsupported public state variable getter arity {paramSpecs.size} for {name}"

/-- Detect the root-return shape before lowering any modifier or statement: an
unsafe buffer created earlier in the root could feed a later forwarded call. -/
private partial def containsForwardedReturn : Json → Bool
  | j@(.obj fields) =>
      (optStr j "nodeType" == some "Return" &&
        optStr ((field? j "expression").getD .null) "nodeType" == some "FunctionCall") ||
      fields.foldl (fun found _ v => found || containsForwardedReturn v) false
  | .arr xs => xs.any containsForwardedReturn
  | _ => false

/-! ### Modifiers lowered by substitution (#2846)

solc runs the rest of the modifier chain and the function body at each `_;` it reaches, so
a modifier whose `_;` sits in a branch or appears more than once is lowered with a marker at
each `_;`, and each marker is replaced by its own lowering of the remaining modifiers and the
body. Measured on solc 0.8.34 / Anvil, legacy and via-IR: body locals are fresh in each copy;
the arguments of an inner modifier are evaluated at each entry; a `return` in the body ends
only that copy, and the modifier continues. The return variables differ by pipeline: legacy
shares them across copies (a copy that assigns nothing keeps the previous value), via-IR
calls the inner code as a function whose return variables start at zero at each `_;`. The
function's parameters also differ (legacy shares them, via-IR passes each `_;` a copy), so a
body that assigns a parameter is rejected. -/

/-- Whether the modifier `modInv` invokes has exactly one `_;`, at the top level of its body
(the pre/post lowering of `lowerModifiers`). Unresolved invocations count as single so that
`lowerModifier` reports them. -/
private def modifierPlaceholderSimple (modInv : Json) : M Bool := do
  let some modNode := field? modInv "modifierName" | return true
  let refId ← refInt modNode
  if refId < 0 then return true
  let some modDecl := (← get).modifiers.find? refId.toNat | return true
  let some body := (field? modDecl "body").filter (!·.isNull) | return true
  let stmts ← mArr (← mField body "statements")
  let mut top := 0
  for st in stmts do
    if (← mKind st) == "PlaceholderStatement" then
      top := top + 1
    else if jsonHasPlaceholder st then
      return false
  pure (top == 1)

/-- Statements that end the call (or cannot be inspected for one). -/
private partial def stmtEndsCall : Stmt → Bool
  | .return _ | .returnValues _ | .returnArray _ | .returnBytes _ | .returnStorageWords _
  | .returnCodeData _ | .stop | .unsafeBlock _ _ | .unsafeYul _ => true
  | .ite _ yes no => yes.any stmtEndsCall || no.any stmtEndsCall
  | .forEach _ _ body | .forEachSetBit _ _ body => body.any stmtEndsCall
  | .forEachWhile _ _ _ body => body.any stmtEndsCall
  | _ => false

/-- Replaces each `let <marker> := 0` (at the top level or in `if` branches) by `inner`,
lowered once per marker, and counts the replacements. -/
private partial def substitutePlaceholderMarkers (marker : String) (inner : M (Array Stmt)) :
    List Stmt → M (List Stmt × Nat)
  | [] => pure ([], 0)
  | st :: rest => do
      let (here, n) ← match st with
        | .letVar name _ =>
            if name == marker then do pure ((← inner).toList, 1) else pure ([st], 0)
        | .ite c yes no => do
            let (yes', ny) ← substitutePlaceholderMarkers marker inner yes
            let (no', nn) ← substitutePlaceholderMarkers marker inner no
            pure ([Stmt.ite c yes' no'], ny + nn)
        | _ => pure ([st], 0)
      let (rest', nr) ← substitutePlaceholderMarkers marker inner rest
      pure (here ++ rest', n + nr)

/-- Lowers the modifiers `mods` around `bodyCopy`: a single-placeholder modifier as its
statements before and after `_;`, any other one by substitution. `resets` runs at each
substituted `_;` before the inner code (via-IR's zeroed return variables). -/
private partial def lowerSubstitutedModifiers (mods : List Json) (resets : Array Stmt)
    (bodyCopy : M (Array Stmt)) : M (Array Stmt) := do
  match mods with
  | [] => bodyCopy
  | m :: rest =>
      if ← modifierPlaceholderSimple m then
        let (pre, post, _) ← lowerModifier m
        let inner ← lowerSubstitutedModifiers rest resets bodyCopy
        pure (pre ++ inner ++ post)
      else
        let marker ← fresh
        let (code, _, count) ← lowerModifier m (some marker)
        let (out, replaced) ← substitutePlaceholderMarkers marker
          (do pure (resets ++ (← lowerSubstitutedModifiers rest resets bodyCopy))) code.toList
        unless count > 0 && replaced == count do
          failAt m s!"modifier placeholder substitution found {replaced} of {count} placeholders"
        pure out.toArray

/-- One copy of a forwarding-tuple root body for `lowerSubstitutedModifiers`:
lowers statements before the trailing `return helper(...)`, inlines the helper
call, and stores its scalar and `(pointer, size)` buffer into the root's return
bindings before falling through to the modifier code after `_;`. -/
private def lowerSubstitutedForwardedBodyCopy (fn : Json) (stmts rets : Array Json)
    (scalarBinding ptrBinding sizeBinding : String) : M (Array Stmt) := do
  let some lastStmt := stmts.back?
    | failAt fn "expected a trailing forwarded tuple return"
  unless (← mKind lastStmt) == "Return" do
    failAt lastStmt "expected a trailing forwarded tuple return"
  let call := (field? lastStmt "expression").getD .null
  let saved ← get
  let (initOut, initReturned) ← lowerRootStatements stmts.pop false
  if initReturned || initOut.any stmtEndsCall then
    failAt fn ("a function body that ends the call before its last statement is outside " ++
      "this slice under a modifier whose _; is in a branch or repeated")
  let (callPre, _, _, scalar, _, buffer) ← inlineForwardedBytesTupleCall call rets
  modify fun e =>
    { e with values := saved.values, writableLocals := saved.writableLocals,
             zeroInitLocals := saved.zeroInitLocals, fnPtrs := saved.fnPtrs,
             paths := saved.paths, snapshots := saved.snapshots, mems := saved.mems,
             abiElements := saved.abiElements, calldataBytes := saved.calldataBytes,
             scalarArrays := saved.scalarArrays, byteBuffers := saved.byteBuffers,
             stringBuffers := saved.stringBuffers, storageBytesVars := saved.storageBytesVars,
             storageDynamicArrayVars := saved.storageDynamicArrayVars,
             flatStructs := saved.flatStructs, scalarTy := saved.scalarTy,
             yulNames := saved.yulNames, yulMemoryArrays := saved.yulMemoryArrays,
             yulMemoryStructs := saved.yulMemoryStructs }
  let tScalar ← fresh
  let tPtr ← fresh
  let tSize ← fresh
  pure (initOut ++ callPre ++ #[
    .letVar tScalar scalar,
    .letVar tPtr buffer.pointer,
    .letVar tSize buffer.size,
    .assignVar scalarBinding (.localVar tScalar),
    .assignVar ptrBinding (.localVar tPtr),
    .assignVar sizeBinding (.localVar tSize)
  ])

/-- One copy of the function body for `lowerSubstitutedModifiers`. The body may return
only at its last top-level statement; that return assigns the return variables
`retBindings` and falls through to the modifier code after `_;`. -/
private def lowerSubstitutedBodyCopy (fn : Json) (stmts : Array Json)
    (retBindings : Array (String × String)) : M (Array Stmt) := do
  let saved ← get
  let (lowered, _) ← lowerRootStatements stmts false
  -- Each copy starts from the function's lexical scope; fresh names and dependencies stay.
  modify fun e =>
    { e with values := saved.values, writableLocals := saved.writableLocals, zeroInitLocals := saved.zeroInitLocals, fnPtrs := saved.fnPtrs, paths := saved.paths,
             snapshots := saved.snapshots, mems := saved.mems, abiElements := saved.abiElements, calldataBytes := saved.calldataBytes, scalarArrays := saved.scalarArrays, byteBuffers := saved.byteBuffers, stringBuffers := saved.stringBuffers, storageBytesVars := saved.storageBytesVars, storageDynamicArrayVars := saved.storageDynamicArrayVars, flatStructs := saved.flatStructs, scalarTy := saved.scalarTy, yulNames := saved.yulNames, yulMemoryArrays := saved.yulMemoryArrays, yulMemoryStructs := saved.yulMemoryStructs }
  let some last := lowered.back? | return lowered
  let init := lowered.pop
  if init.any stmtEndsCall then
    failAt fn "a function body that ends the call before its last statement is outside this slice under a modifier whose _; is in a branch or repeated"
  let assign (values : List Expr) : M (Array Stmt) := do
    unless values.length == retBindings.size do
      failAt fn "return arity does not match the function's return parameters"
    let mut temps : Array Stmt := #[]
    let mut assigns : Array Stmt := #[]
    for (v, (b, _)) in values.zip retBindings.toList do
      let t ← fresh
      temps := temps.push (.letVar t v)
      assigns := assigns.push (.assignVar b (.localVar t))
    pure (init ++ temps ++ assigns)
  match last with
  | .returnValues values => assign values
  | .return value => assign [value]
  | .stop =>
      unless retBindings.isEmpty do
        failAt fn "stop in a function with return values"
      pure init
  | other =>
      if stmtEndsCall other then
        failAt fn "a function body that ends the call this way is outside this slice under a modifier whose _; is in a branch or repeated"
      pure lowered

private def lowerRoot (fn : Json) : M (Array Stmt × Array SrcParam) := do
  if (← mKind fn) == "VariableDeclaration" then
    return ← lowerPublicVarGetter fn
  let rootId ← mNat (← mField fn "id")
  modify fun e => { e with stack := [rootId] }
  if optStr fn "stateMutability" == some "payable" && (← get).stateVars.isEmpty then
    failAt fn "payable entry points require value-transfer semantics and are unsupported"
  let srcParams ← bindRoot fn
  let implemented := (field? fn "implemented").bind (fun v => v.getBool?.toOption) |>.getD true
  let some body := (field? fn "body").filter (!·.isNull)
    | failAt fn "function has no body"
  unless implemented do failAt fn "function has no body"
  let mods ← mArr (← mField fn "modifiers")
  let returns ← mArr (← mField (← mField fn "returnParameters") "parameters")
  let mut rootInit : Array Stmt := #[]
  for p in srcParams do
    if (bodyCompoundAssignedIds body).contains p.id || (bodyDirectAssignedIds body).contains p.id then
      if let some initExpr := (← get).values.find? p.id then
        let pbinding ← freshFor (if p.name == "" then "param" else p.name)
        let pexpr := Expr.localVar pbinding
        rootInit := rootInit.push (.letVar pbinding initExpr)
        modify fun e =>
          { e with values := e.values.insert p.id pexpr,
                   writableLocals := e.writableLocals.insert p.id pbinding,
                   yulNames := if p.name == "" then e.yulNames else e.yulNames.insert p.name pexpr }
  let stmts ← mArr (← mField body "statements")
  let emptyBodyArrayRet? ← functionEmptyBodyArrayReturnType? fn
  let fixedArrayRet? ← functionFixedArrayReturnType? fn
  let flatStructRet? ← functionFlatStructReturnType? fn
  let msgDataRet ← functionMsgDataReturn? fn
  let dynamicBytesRet? ← functionDynamicBytesReturn? fn
  let dynamicStructRet? ← functionDynamicStructReturn? fn
  let dynamicTupleRet? ← functionDynamicTupleReturn? fn
  let rootReturnTypes ← returns.mapM mType
  let mut rootRetExprs : Array Expr := #[]
  let mut rootNamedReturn? : Option (Nat × String × String × String) := none
  let mut rootFlatStructState? : Option (Nat × String × Array (String × String × String) × Bool) := none
  -- A scalar `T[] memory` result is a dynamic tuple component (`functionDynamicTupleReturn?`)
  -- or an empty-body array result; no other lowering models a scalar array result (a
  -- `T[] calldata` result would return the caller's calldata region), so reject it here.
  for r in returns do
    if (scalarArrayElement? (← mType r)).isSome &&
        (optStr r "storageLocation" |>.getD "default") != "memory" then
      failAt r "calldata array root return values are outside this slice"
  let mut allNamedScalar := !returns.isEmpty && emptyBodyArrayRet?.isNone && fixedArrayRet?.isNone && flatStructRet?.isNone && !msgDataRet && dynamicBytesRet?.isNone
  if let some (retSid, retStructName, rname, rid, memberSpecs) := flatStructRet? then
    let mut memberBindings : Array (String × String × String) := #[]
    for (mName, mTy, _) in memberSpecs do
      let binding ← freshFor s!"{if rname == "" then "ret_struct" else rname}_{mName}"
      if rname != "" then
        rootInit := rootInit.push (.letVar binding (.literal 0))
        rootRetExprs := rootRetExprs.push (.localVar binding)
      memberBindings := memberBindings.push (mName, mTy, binding)
    if rname != "" then
      modify fun e =>
        { e with flatStructs := e.flatStructs.insert rid { structId := retSid, structName := retStructName, members := memberBindings },
                 yulNames := e.yulNames.erase rname,
                 yulMemoryStructs := e.yulMemoryStructs.insert rname rid }
    rootFlatStructState? := some (retSid, retStructName, memberBindings, rname != "")
  else if dynamicBytesRet?.isSome && returns.size == 1 then
    let r := returns[0]!
    let rname ← mStr (← mField r "name")
    if rname != "" then
      let rid ← mNat (← mField r "id")
      let ptrBinding ← fresh
      let sizeBinding ← fresh
      rootInit := rootInit ++ #[.letVar ptrBinding (.literal 0), .letVar sizeBinding (.literal 0)]
      let buf : EncodedBytes := { pre := #[], pointer := .localVar ptrBinding, size := .localVar sizeBinding }
      modify fun e =>
        { e with byteBuffers := e.byteBuffers.insert rid buf,
                 nonLiteralByteLocals := e.nonLiteralByteLocals.push rid,
                 yulNames := e.yulNames.erase rname,
                 yulMemoryStructs := e.yulMemoryStructs.insert rname rid }
  else if dynamicTupleRet?.isSome then
    allNamedScalar := false
    for r in returns do
      if (← mStr (← mField r "name")) != "" then
        rootInit := rootInit ++ (← bindRootDynamicTupleResult r)
  else if emptyBodyArrayRet?.isNone && fixedArrayRet?.isNone && !msgDataRet && dynamicBytesRet?.isNone then
    for r in returns do
      let rty ← mType r
      discard (validateEnumTypeIfNeeded r rty)
      let rname ← mStr (← mField r "name")
      if rname == "" then
        allNamedScalar := false
      else
        let rid ← mNat (← mField r "id")
        let some scalar := paramType rty
          | failAt r s!"unsupported named root return type {rty}"
        let rbinding ← freshFor rname
        let rexpr := Expr.localVar rbinding
        rootInit := rootInit ++ #[.letVar rbinding (.literal 0)]
        rootRetExprs := rootRetExprs.push (cleanHelperResultExpr rty { pre := #[], expr := rexpr })
        if returns.size == 1 && !rty.startsWith "enum " then
          rootNamedReturn? := some (rid, rname, rty, rbinding)
        modify fun e =>
          { e with values := e.values.insert rid rexpr,
                   writableLocals := e.writableLocals.insert rid rbinding,
                   scalarTy := e.scalarTy.insert rid scalar,
                   yulNames := e.yulNames.insert rname rexpr }
  modify fun e =>
    { e with bodyAssigned := bodyAssignedIds body,
             rootIsVoid := returns.isEmpty,
             rootReturns := if allNamedScalar || (flatStructRet?.isSome && !rootRetExprs.isEmpty) then rootRetExprs else #[],
             rootReturnTypes := rootReturnTypes,
             rootNamedReturn := if allNamedScalar then rootNamedReturn? else none,
             rootFixedArrayReturn := fixedArrayRet?,
             rootFlatStructReturn := rootFlatStructState?,
             rootMsgDataReturn := msgDataRet,
             rootDynamicBytesReturn := dynamicBytesRet?,
             rootDynamicStructReturn := dynamicStructRet?,
             forwardingBytesTuple := dynamicTupleRet?.isSome && rootReturnTypes.size == 2 &&
               rootReturnTypes[1]? == some "bytes" && containsForwardedReturn body,
             rootDynamicTupleReturn := dynamicTupleRet?.map fun _ => returns }
  rejectForwardedAssembly fn
  if ← mods.anyM (fun m => do pure !(← modifierPlaceholderSimple m)) then
    -- #2846: substitute the remaining modifiers and the body at each `_;`.
    let forwardingTuple := (← get).forwardingBytesTuple
    unless (emptyBodyArrayRet?.isNone && fixedArrayRet?.isNone && flatStructRet?.isNone &&
        !msgDataRet && dynamicBytesRet?.isNone && dynamicStructRet?.isNone &&
        dynamicTupleRet?.isNone) || forwardingTuple do
      failAt fn "a function whose modifier has _; in a branch or repeated must return scalar values"
    if containsNodeKind "InlineAssembly" body then
      failAt fn "inline assembly in a function whose modifier has _; in a branch or repeated is outside this slice"
    let assigned := bodyAssignedIds body
    for p in srcParams do
      if assigned.contains p.id then
        failAt fn s!"assigning parameter {p.name} of a function whose modifier has _; in a branch or repeated is outside this slice (legacy shares it across the copies of the body, via-IR does not)"
    for i in [:stmts.size] do
      let st := stmts[i]!
      unless i + 1 == stmts.size && (← mKind st) == "Return" do
        if ← stmtContainsReturn st then
          failAt st "return before the last statement of a function whose modifier has _; in a branch or repeated is outside this slice"
    if forwardingTuple then
      let #[r0, r1] := returns | failAt fn "expected a two-component forwarded bytes tuple"
      discard (validateEnumTypeIfNeeded r0 (← mType r0))
      let r0Id ← mNat (← mField r0 "id")
      let r1Id ← mNat (← mField r1 "id")
      let scalarBinding ← if (← mStr (← mField r0 "name")) != "" then do
          let some b := (← get).writableLocals.find? r0Id
            | failAt r0 "missing named return binding"
          pure b
        else do
          let b ← fresh
          rootInit := rootInit.push (.letVar b (.literal 0))
          modify fun e => { e with values := e.values.insert r0Id (.localVar b) }
          pure b
      let (ptrBinding, sizeBinding) ← if (← mStr (← mField r1 "name")) != "" then do
          let some { pointer := .localVar p, size := .localVar s, .. } :=
              (← get).byteBuffers.find? r1Id
            | failAt r1 "missing named bytes return buffer"
          pure (p, s)
        else do
          let p ← fresh
          let s ← fresh
          rootInit := rootInit ++ #[.letVar p (.literal 0), .letVar s (.literal 0)]
          let buf : EncodedBytes := { pre := #[], pointer := .localVar p, size := .localVar s }
          modify fun e => { e with byteBuffers := e.byteBuffers.insert r1Id buf }
          pure (p, s)
      let tupleResets := if (← get).viaIR then
          #[Stmt.assignVar scalarBinding (.literal 0), Stmt.assignVar ptrBinding (.literal 0),
            Stmt.assignVar sizeBinding (.literal 0)]
        else #[]
      let lowered ← lowerSubstitutedModifiers mods.toList tupleResets
        (lowerSubstitutedForwardedBodyCopy fn stmts returns scalarBinding ptrBinding sizeBinding)
      let tail ← lowerDynamicTupleReturn (← returns.mapM returnParamIdentifier) returns fn
      return (rootInit ++ lowered ++ tail, srcParams)
    let mut retBindings : Array (String × String) := #[]
    for r in returns do
      let rty ← mType r
      if (← mStr (← mField r "name")) != "" then
        let some b := (← get).writableLocals.find? (← mNat (← mField r "id"))
          | failAt r "missing named return binding"
        retBindings := retBindings.push (b, rty)
      else
        unless (paramType rty).isSome do
          failAt r s!"unsupported root return type {rty}"
        let b ← fresh
        rootInit := rootInit.push (.letVar b (.literal 0))
        retBindings := retBindings.push (b, rty)
    let resets := if (← get).viaIR then retBindings.map fun (b, _) => Stmt.assignVar b (.literal 0) else #[]
    let lowered ← lowerSubstitutedModifiers mods.toList resets (lowerSubstitutedBodyCopy fn stmts retBindings)
    let final := if returns.isEmpty then Stmt.stop else
      .returnValues (retBindings.toList.map fun (b, ty) => cleanHelperResultExpr ty { pre := #[], expr := .localVar b })
    return ((rootInit ++ lowered).push final, srcParams)
  let (modStmts, modPost) ← lowerModifiers mods
  modify fun e => { e with rootPost := modPost }
  let (bodyOut, returned) ← lowerRootStatements stmts true
  let mut out := rootInit ++ modStmts ++ bodyOut
  unless returned do
    out := out ++ modPost
    modify fun e => { e with rootPost := #[] }
    if returns.isEmpty then
      out := out.push .stop
    else if emptyBodyArrayRet?.isSome then
      out := out ++ #[.returnValues [.literal 32, .literal 0]]
    else if !(← get).rootReturns.isEmpty then
      out := out ++ #[.returnValues (← get).rootReturns.toList]
    else if let some (_, _, length) := fixedArrayRet? then
      if stmts.isEmpty then
        out := out ++ #[.returnValues (Array.replicate length (.literal 0)).toList]
      else
        failAt fn "an explicit root return is required"
    else if let some (_, _, _, _, memberSpecs) := flatStructRet? then
      if stmts.isEmpty then
        out := out ++ #[.returnValues (Array.replicate memberSpecs.size (.literal 0)).toList]
      else
        failAt fn "an explicit root return is required"
    else if dynamicBytesRet?.isSome && returns.size == 1 && (← mStr (← mField returns[0]! "name")) != "" then
      let rid ← mNat (← mField returns[0]! "id")
      let some buf := (← get).byteBuffers.find? rid | failAt fn "missing named bytes or string return buffer"
      let stem ← fresh
      let memStem := s!"_verity_memret_{stem}"
      let dataBinding := s!"_verity_memret_{stem}_data_offset"
      let lenBinding := s!"_verity_memret_{stem}_length"
      modify fun e =>
        { e with encodingMemory := true,
                 bound := dataBinding :: lenBinding :: e.bound }
      out := out ++ buf.pre ++ #[.letVar dataBinding buf.pointer, .letVar lenBinding buf.size, .returnBytes memStem]
    else if msgDataRet || dynamicBytesRet?.isSome then
      failAt fn "an explicit root return is required"
    else if dynamicTupleRet?.isSome && !(← returns.anyM fun r => do pure ((← mStr (← mField r "name")) == "")) then
      out := out ++ (← lowerDynamicTupleReturn (← returns.mapM returnParamIdentifier) returns fn)
    else if stmts.isEmpty then
      let mut zeroReturns : List Expr := []
      for r in returns do
        let rty ← mType r
        unless (paramType rty).isSome do
          failAt r s!"unsupported empty-body root return type {rty}"
        zeroReturns := zeroReturns ++ [.literal 0]
      out := out ++ #[.returnValues zeroReturns]
    else
      failAt fn "an explicit root return is required"
  pure (out, srcParams)

/-- `lowerRoot`, then the whole-body recheck of its code-read operands
(`checkCodeReadTargets`), of raw Yul reads of cleaned narrow locals
(`checkYulCleanedNarrowReads`), and of Yul byte-buffer word loads
(`checkYulByteWordLoads`). -/
private def lowerRootChecked (fn : Json) : M (Array Stmt × Array SrcParam) := do
  let lowered ← lowerRoot fn
  checkCodeReadTargets lowered.1
  checkYulCleanedNarrowReads lowered.1
  checkYulByteWordLoads lowered.1
  checkLinkedBytesShortStringCopies lowered.1
  checkLinkedReturnByteWordLoads lowered.1
  return lowered

/-! ### Named call arguments

Bind against the statically referenced declaration, not the virtual dispatch target. Legacy
codegen evaluates internal arguments in parameter order (attached receiver last), and event
arguments indexed last-to-first then data; via-IR visits written operands left-to-right.
Only turn a permutation into a positional call when evaluating in either order is equivalent. -/

private structure NamedDeclarations where
  params : Std.HashMap Nat (Array String) := {}
  scalarTargets : Std.HashSet Nat := {}
  externalTargets : Std.HashSet Nat := {}
  scalarReads : Std.HashSet Nat := {}
  refReads : Std.HashSet Nat := {}
  deriving Inhabited

private def namedWord (j : Json) : Bool :=
  let ty := ((field? j "typeDescriptions").bind (optStr · "typeString")).getD ""
  (!ty.startsWith "enum " && (paramType ty).isSome) || (fixedBytesWidth? ty).isSome

/-- Parameter names of every function, event and error declaration, and member names of
every struct, keyed by AST id, across all source units. -/
private partial def declaredArgumentNames (acc : NamedDeclarations) : Json → NamedDeclarations
  | j@(.obj kvs) =>
      let names (list? : Option Json) : Option (Array String) := do
        let .arr items ← list? | none
        items.mapM (optStr · "name")
      let id? := (field? j "id").bind (·.getNat?.toOption)
      let declared? := match optStr j "nodeType" with
        | some "StructDefinition" => names (field? j "members")
        | some "FunctionDefinition" | some "EventDefinition" | some "ErrorDefinition" =>
            names ((field? j "parameters").bind (field? · "parameters"))
        | _ => none
      let acc := match id?, declared? with
        | some id, some ns =>
            let ps := (field? j "parameters").bind (field? · "parameters")
            let scalar := [some "EventDefinition", some "FunctionDefinition"].contains
                (optStr j "nodeType") && (ps.bind (·.getArr?.toOption)).any (·.all namedWord)
            let isExt := optStr j "nodeType" == some "FunctionDefinition" &&
                [some "external", some "public"].contains (optStr j "visibility")
            { acc with
              params := acc.params.insert id ns
              scalarTargets := if scalar then acc.scalarTargets.insert id else acc.scalarTargets
              externalTargets := if isExt then acc.externalTargets.insert id else acc.externalTargets }
        | some id, none =>
            let computedConst := optStr j "mutability" == some "constant" &&
              ((field? j "value").bind (optStr · "nodeType")) != some "Literal"
            let isState := (field? j "stateVariable") == some (.bool true)
            let loc := optStr j "storageLocation" |>.getD "default"
            let ty := ((field? j "typeDescriptions").bind (optStr · "typeString")).getD ""
            if optStr j "nodeType" == some "VariableDeclaration" && namedWord j && !computedConst then
              { acc with scalarReads := acc.scalarReads.insert id }
            else if optStr j "nodeType" == some "VariableDeclaration" && !isState && !computedConst &&
                (loc == "memory" || loc == "calldata" || ty.startsWith "enum ") then
              { acc with refReads := acc.refReads.insert id }
            else acc
        | _, _ => acc
      kvs.foldl (fun acc _ v => declaredArgumentNames acc v) acc
  | .arr items => items.foldl declaredArgumentNames acc
  | _ => acc

/-- Whether `written` names the trailing parameters of `declared`, in declared order: all
of them for an ordinary call, all but the receiver for an attached call. -/
def namedArgumentsInDeclaredOrder (declared written : Array String) : Bool :=
  !written.isEmpty && written.size ≤ declared.size &&
    written == declared.extract (declared.size - written.size) declared.size

/-- `(read-only, total)` for builtin scalar expressions. Unknown or deeply nested operands
are conservatively effectful; a single such operand can still commute with literal siblings. -/
private def namedOperand (declared : NamedDeclarations) : Nat → Json → Bool × Bool
  | 0, _ => (false, false)
  | fuel + 1, j =>
  match optStr j "nodeType" with
  | some "Literal" => (true, true)
  | some "Identifier" =>
      if optStr j "name" == some "this" then (true, true)
      else
        let read := ((field? j "referencedDeclaration").bind (·.getNat?.toOption)).any fun id =>
          declared.scalarReads.contains id || declared.refReads.contains id
        (read, read)
  | some "MemberAccess" =>
      let base := (field? j "expression").getD .null
      let magic := (field? base "typeDescriptions").bind (optStr · "typeIdentifier")
      let baseTy := ((field? base "typeDescriptions").bind (optStr · "typeString")).getD ""
      let memName := optStr j "memberName" |>.getD ""
      let isMagic := namedWord j && ["t_magic_message", "t_magic_block", "t_magic_transaction"].any
        (fun ty => magic == some ty)
      let isTypeBound := (memName == "max" || memName == "min") &&
        optStr base "nodeType" == some "FunctionCall"
      let isEnumLit := baseTy.startsWith "type(enum "
      let isSelector := memName == "selector"
      let isRefMember := optStr base "nodeType" == some "Identifier" &&
        ((field? base "referencedDeclaration").bind (·.getNat?.toOption)).any declared.refReads.contains &&
        (memName == "length" || namedWord j)
      let total := isMagic || isTypeBound || isEnumLit || isSelector || isRefMember
      (total, total)
  | some "FunctionCall" =>
      let callee := (field? j "expression").getD .null
      let ty := ((field? j "typeDescriptions").bind (optStr · "typeString")).getD ""
      if optStr j "kind" == some "functionCall" && optStr callee "nodeType" == some "NewExpression" &&
          (ty == "bytes memory" || ty == "bytes" || ty == "string memory" || ty == "string") then
        match (field? j "arguments").bind (·.getArr?.toOption) with
        | some #[arg] =>
            let argTy := ((field? arg "typeDescriptions").bind (optStr · "typeString")).getD ""
            let isZero := argTy == "int_const 0"
            (isZero, isZero)
        | _ => (false, false)
      else if optStr j "kind" == some "typeConversion" &&
          (namedWord j || ty == "address" || ty == "address payable" || ty.startsWith "contract ") then
        match (field? j "arguments").bind (·.getArr?.toOption) with
        | some #[arg] => namedOperand declared fuel arg
        | _ => (false, false)
      else (false, false)
  | some "Conditional" =>
      let (cr, ct) := namedOperand declared fuel ((field? j "condition").getD .null)
      let (tr, tt) := namedOperand declared fuel ((field? j "trueExpression").getD .null)
      let (fr, ft) := namedOperand declared fuel ((field? j "falseExpression").getD .null)
      (cr && tr && fr && ct && tt && ft, ct && tt && ft)
  | some "UnaryOperation" =>
      let op := optStr j "operator"
      let builtin := (field? j "function").isNone && namedWord j
      let (sr, st) := namedOperand declared fuel ((field? j "subExpression").getD .null)
      (builtin && sr && ["!", "~", "-"].any (some · == op),
        builtin && st && ["!", "~"].any (some · == op))
  | some "TupleExpression" =>
      if (field? j "isInlineArray") == some (.bool true) then (false, false)
      else match (field? j "components").bind (·.getArr?.toOption) with
        | some #[inner] => namedOperand declared fuel inner
        | _ => (false, false)
  | some "BinaryOperation" =>
      let op := optStr j "operator"
      let builtin := (field? j "function").isNone && namedWord j
      let (lr, lt) := namedOperand declared fuel ((field? j "leftExpression").getD .null)
      let (rr, rt) := namedOperand declared fuel ((field? j "rightExpression").getD .null)
      let total := ["&", "|", "^", "<<", ">>", "==", "!=", "<", ">", "<=", ">="].any (some · == op)
      (builtin && lr && rr && (lt || rt), builtin && lt && rt && total)
  | _ => (false, false)

private def reorderedArgs? (declared : NamedDeclarations) (call : Json) (params names : Array String) :
    Option Json := do
  let args ← (field? call "arguments").bind (·.getArr?.toOption)
  guard (args.size == names.size && names.size > 0 && names.size ≤ params.size)
  let mut operands := args
  let callee ← field? call "expression"
  if params.size != names.size then
    guard (params.size == names.size + 1)
    operands := operands.push (← field? callee "expression")
  let summaries := operands.map (namedOperand declared 256)
  -- A single possibly effectful operand commutes with literals. For reads, at most one
  -- may panic. A receiver on an external call is evaluated first by both pipelines.
  let nonLiterals := operands.filter (fun j => optStr j "nodeType" != some "Literal")
  let singleCall := nonLiterals.size == 1 && nonLiterals.all fun n =>
    optStr n "kind" == some "functionCall" &&
    ((field? n "arguments").bind (·.getArr?.toOption)).any (·.isEmpty) &&
    ((field? n "expression").bind (optStr · "nodeType")) == some "Identifier"
  let readOnly := summaries.all Prod.fst && (summaries.filter (!·.2)).size ≤ 1
  guard (singleCall || readOnly)
  let byName : Std.HashMap String Json := Std.HashMap.ofList (names.zip args).toList
  let sorted ← (params.extract (params.size - names.size) params.size).mapM byName.get?
  return (((call.setObjVal! "arguments" (.arr sorted)).setObjVal! "names" (.arr #[])).setObjVal!
    "reorderedScalarArguments" (.bool true)).setObjVal!
    "reorderedReadOnlyArguments" (.bool readOnly)

/-- Normalize before indexing so every lowering path sees the same argument bindings. -/
private partial def positionalNamedArguments (declared : NamedDeclarations) :
    Json → Json
  | .obj kvs =>
      let j := Json.mkObj (kvs.toList.map fun (k, v) => (k, positionalNamedArguments declared v))
      -- Keep the original names on a `try this.f(...)` self-call so `rejectThisTryCall`
      -- keeps its dedicated diagnostic. Non-`this` external `try` calls are normalized here.
      let isThisTry := field? j "tryCall" == some (.bool true) &&
        ((field? j "expression").bind (field? · "expression") |>.bind (optStr · "name")) == some "this"
      if optStr j "nodeType" != some "FunctionCall" || isThisTry then j
      else
        let written? : Option (Array String) := do
          let .arr ns ← field? j "names" | none
          ns.mapM (·.getStr?.toOption)
        let id? := (field? j "expression").bind (field? · "referencedDeclaration")
          |>.bind (·.getNat?.toOption)
        match written?, id?.bind declared.params.get?, id? with
        | some written, some params, some id =>
            if namedArgumentsInDeclaredOrder params written then j.setObjVal! "names" (.arr #[])
            else if declared.scalarTargets.contains id || declared.externalTargets.contains id then
              reorderedArgs? declared j params written |>.getD j
            else j
        | _, _, _ => j
  | .arr items => .arr (items.map (positionalNamedArguments declared))
  | other => other

private partial def index (file : String) (contract? : Option (Nat × String)) (j : Json) : M Unit := do
  match j with
  | .obj o =>
      if let some name := optStr j "name" then
        modify fun e => { e with sourceNames := name :: e.sourceNames }
      let mut next := contract?
      if (field? j "nodeType").isSome then
        if let some idj := field? j "id" then
          let id ← mNat idj
          modify fun e => { e with nodeFile := e.nodeFile.insert id file }
          match ← mKind j with
          | "ContractDefinition" =>
              let n ← mStr (← mField j "name")
              let kind := optStr j "contractKind" |>.getD "contract"
              let bases ← match field? j "linearizedBaseContracts" with
                | some b => (← mArr b).mapM mNat
                | none => pure #[id]
              let cnodes ← match field? j "nodes" with
                | some ns => mArr ns
                | none => pure #[]
              let isAbstract := (field? j "abstract").bind (fun v => v.getBool?.toOption) |>.getD false
              modify fun e =>
                { e with contractNames := e.contractNames.insert id n,
                         contractKinds := e.contractKinds.insert id kind,
                         abstractContracts := if isAbstract then e.abstractContracts.push id else e.abstractContracts,
                         contractBases := e.contractBases.insert id bases,
                         contractNodes := e.contractNodes.insert id cnodes,
                         contractBaseSpecifiers :=
                           e.contractBaseSpecifiers.insert id ((field? j "baseContracts").getD .null) }
              next := some (id, n)
          | "FunctionDefinition" =>
              let baseIds ← match field? j "baseFunctions" with
                | some b => (← mArr b).mapM mNat
                | none => pure #[]
              modify fun e =>
                let funs := e.funs.insert id j
                let funContract := e.funContract.insert id (contract?.map Prod.snd |>.getD "<free>")
                let funContractId := match contract? with
                  | some (cid, _) => e.funContractId.insert id cid
                  | none => e.funContractId
                let contractFuns := match contract? with
                  | some (cid, _) =>
                      let prev := e.contractFuns.find? cid |>.getD #[]
                      e.contractFuns.insert cid (prev.push id)
                  | none => e.contractFuns
                let funBases := e.funBases.insert id baseIds
                { e with funs, funContract, funContractId, contractFuns, funBases }
          | "ModifierDefinition" =>
              modify fun e =>
                let modifiers := e.modifiers.insert id j
                let funContract := e.funContract.insert id (contract?.map Prod.snd |>.getD "<free>")
                let funContractId := match contract? with
                  | some (cid, _) => e.funContractId.insert id cid
                  | none => e.funContractId
                { e with modifiers, funContract, funContractId }
          | "StructDefinition" =>
              modify fun e => { e with structs := e.structs.insert id j }
          | "EnumDefinition" =>
              let ename ← mStr (← mField j "name")
              let ms ← mArr (← mField j "members")
              let mut memberNames : Array String := #[]
              for m in ms do
                memberNames := memberNames.push (← mStr (← mField m "name"))
              let enumKey := match contract? with
                | some (_, cname) => s!"enum {cname}.{ename}"
                | none => s!"enum {ename}"
              modify fun e =>
                { e with enums := e.enums.insert id memberNames,
                         enumByType := e.enumByType.insert enumKey (id, memberNames) }
          | "UserDefinedValueTypeDefinition" =>
              let vname ← mStr (← mField j "name")
              let uTypeNode ← mField j "underlyingType"
              let uTy ← liftM (typeString uTypeNode)
              let qualName := match contract? with
                | some (_, cname) => s!"{cname}.{vname}"
                | none => vname
              modify fun e =>
                let userValueTypeById := e.userValueTypeById.insert id uTy
                let userValueTypes := e.userValueTypes.insert qualName uTy
                let userValueTypes :=
                  if contract?.isNone || !userValueTypes.contains vname then
                    userValueTypes.insert vname uTy
                  else userValueTypes
                { e with userValueTypeById, userValueTypes }
          | "EventDefinition" =>
              modify fun e => { e with eventDecls := e.eventDecls.insert id j }
          | "ErrorDefinition" =>
              modify fun e => { e with errorDecls := e.errorDecls.insert id j }
          | "VariableDeclaration" =>
              let isState := match field? j "stateVariable" with
                | some b => match b.getBool? with | .ok v => v | _ => false
                | none => false
              let baseIds ← match field? j "baseFunctions" with
                | some b => (← mArr b).mapM mNat
                | none => pure #[]
              if isState then
                let isPublic := optStr j "visibility" == some "public"
                modify fun e =>
                  let stateVars := e.stateVars.insert id j
                  let funContract := e.funContract.insert id (contract?.map Prod.snd |>.getD "<free>")
                  let funContractId := match contract? with
                    | some (cid, _) => e.funContractId.insert id cid
                    | none => e.funContractId
                  let contractPublicVars := match contract? with
                    | some (cid, _) =>
                        if isPublic then
                          let prev := e.contractPublicVars.find? cid |>.getD #[]
                          e.contractPublicVars.insert cid (prev.push id)
                        else e.contractPublicVars
                    | none => e.contractPublicVars
                  let funBases := if baseIds.isEmpty then e.funBases else e.funBases.insert id baseIds
                  { e with stateVars, funContract, funContractId, contractPublicVars, funBases }
              let isConstant := ((field? j "constant").bind (fun v => v.getBool?.toOption) == some true) ||
                optStr j "mutability" == some "constant"
              if isConstant then
                modify fun e => { e with numericConstants := e.numericConstants.insert id j }
          | _ => pure ()
      let children := o.foldl (fun acc _ v => v :: acc) []
      for child in children do
        index file next child
  | .arr xs =>
      for child in xs do
        index file contract? child
  | _ => pure ()

private def importSpecs (text : String) : Array String := Id.run do
  let mut out : Array String := #[]
  for line in text.splitOn "\n" do
    let t := line.trimAscii.toString
    if t.startsWith "import" || t.startsWith "} from " then
      let parts := t.splitOn "\""
      if parts.length ≥ 2 then
        out := out.push parts[1]!
      else
        let singleParts := t.splitOn "'"
        if singleParts.length ≥ 2 then
          out := out.push singleParts[1]!
  pure out

private def readRemappings (root : System.FilePath) : IO (Array (String × String)) := do
  let mut out : Array (String × String) := #[]
  let path := root / "remappings.txt"
  if ← path.pathExists then
    let text ← IO.FS.readFile path
    for line in text.splitOn "\n" do
      let t := line.trimAscii.toString
      if t == "" || t.startsWith "#" || t.startsWith "//" then continue
      let parts := t.splitOn "="
      if parts.length == 2 then
        out := out.push (parts[0]!, parts[1]!)
  let foundryPath := root / "foundry.toml"
  if ← foundryPath.pathExists then
    let foundryText ← IO.FS.readFile foundryPath
    -- Only `[profile.default]` counts (other profiles are not selected), and Foundry keeps
    -- the first remapping of each name (`Remappings::into_inner`).
    let keys := FoundryRemap.parseFoundryToml foundryText (strict := false)
    for item in keys.remappings.getD [] do
      let parts := item.splitOn "="
      if parts.length == 2 && parts[0]! != "" && parts[1]! != "" then
        let pair := (parts[0]!, parts[1]!)
        unless out.any (·.1 == pair.1) do
          out := out.push pair
  pure out

/-- Remapping inputs for one import closure. The library configurations and the full library
scan are each read at most once, and only when an import's resolution needs them (see
`remapDecideA`, `remapDecideB`). -/
private structure RemapReads where
  root : System.FilePath
  written : Array (String × String)
  stage0 : RemapStage0
  pool : Option FoundryRemap.ConfigPool := none
  full : Option InferredRemappings := none

/-- The source unit `spec` in `origin` names (see `resolveImportStaged`), reading the library
configurations or the full library scan only on first need. -/
private def resolveLazily (reads : IO.Ref RemapReads) (origin spec : String) :
    MetaM (String × Option InferredRemapping) := do
  let lift {α : Type} (r : Except String α) : MetaM α := match r with
    | .ok a => pure a
    | .error e => throwError "{origin}: {e}"
  let st ← reads.get
  let path ← lift (importPath origin spec)
  let finish (t : String) (u : Option InferredRemapping) := do
    return (← lift (normalizeSourcePath t), u)
  match ← lift (remapDecide0 st.stage0 origin path) with
  | .done t u => finish t u
  | _ =>
    let pool ← match st.pool with
      | some p => pure p
      | none => do
        let p := remapConfigPool (← readRemapConfigs st.root)
        reads.modify fun r => { r with pool := some p }
        pure p
    match ← lift (remapDecideA st.stage0 pool origin path) with
    | .done t u => finish t u
    | _ =>
      let full ← match (← reads.get).full with
        | some f => pure f
        | none => do
          let f := inferFoundryRemappings (← readRemapRoot st.root) st.written
          reads.modify fun r => { r with full := some f }
          pure f
      let (t, u) ← lift (remapDecideB st.stage0 full path)
      finish t u

/-- The sources reachable from `logical`, and the Foundry-inferred remappings their imports
use (in first-use order). -/
private partial def collectSources
    (root : System.FilePath) (logical : String) (reads : IO.Ref RemapReads)
    (acc : RBMap String String compare × Array InferredRemapping) :
    MetaM (RBMap String String compare × Array InferredRemapping) := do
  if acc.1.contains logical then return acc
  let path := root / logical
  unless ← path.pathExists do throwError "missing Solidity source {logical}"
  let text ← IO.FS.readFile path
  let mut acc := (acc.1.insert logical text, acc.2)
  for spec in importSpecs text do
    let (next, used) ← resolveLazily reads logical spec
    if let some r := used then
      unless acc.2.contains r do acc := (acc.1, acc.2.push r)
    acc ← collectSources root next reads acc
  pure acc

/-- Why the pinned solc binary at `path` cannot be used, if it cannot: it is not
installed (Lake never downloads it), it cannot be hashed, or its SHA-256 is not
one of the release's pinned digests. Each message names the path and the setup
command, so a worktree whose `.lake` lacks `solidity-import/` is not reported
as a corrupted compiler. -/
def solcBinaryProblem? (binaryName path : String) (installed : Bool) (hashExitCode : UInt32)
    (sha256 : String) (pinned : Array String) : Option String :=
  let setup := s!"run `python3 scripts/setup_solc_import.py --all` from the Verity root"
  if !installed then
    some s!"solc binary {binaryName} is not installed at {path}; {setup} (Lake never downloads the compiler)"
  else if hashExitCode != 0 then
    some s!"cannot compute the SHA-256 of {path} (exit code {hashExitCode}); {setup}"
  else if !pinned.contains sha256 then
    some s!"compiler checksum mismatch: {path} has SHA-256 {sha256}, not a pinned digest of {binaryName}; {setup} to reinstall it"
  else
    none

private def verifyCompiler (release : SolcRelease) (compiler : System.FilePath) : MetaM String := do
  let installed ← compiler.pathExists
  let output : IO.Process.Output ←
    if !installed then
      pure { exitCode := 1, stdout := "", stderr := "" }
    else if System.Platform.isOSX then
      IO.Process.output { cmd := "/usr/bin/shasum", args := #["-a", "256", compiler.toString] }
    else
      IO.Process.output { cmd := "/usr/bin/sha256sum", args := #[compiler.toString] }
  let sha256 := (output.stdout.take 64).toString
  if let some problem := solcBinaryProblem? release.binaryName compiler.toString installed
      output.exitCode sha256 release.sha256s then
    throwError problem
  return sha256

/-- Verity itself stores the importer next to its lakefile. A downstream package
stores that checkout at `.lake/packages/verity`. The digest must hash those
sources in either layout. -/
private def importerSourceRoot (pkgRoot : System.FilePath) : MetaM System.FilePath := do
  if ← (pkgRoot / "Compiler/SolidityImport/Import.lean").pathExists then
    return pkgRoot
  let dep := pkgRoot / ".lake/packages/verity"
  if ← (dep / "Compiler/SolidityImport/Import.lean").pathExists then
    return dep
  throwError "importer source missing: {pkgRoot / "Compiler/SolidityImport/Import.lean"}"

private def FnRec.toImported (f : FnRec) : ImportedFunction :=
  { contract := f.contract, name := f.name, declId := f.declId, paramTypes := f.paramTypes.toList }

/-- Solidity spelling of a solc `typeString`: `struct Market memory` → `Market`. -/
private def sourceTypeName (typeString : String) : String := Id.run do
  let mut t := typeString.trimAscii.toString
  for pre in ["struct ", "contract ", "enum "] do
    if t.startsWith pre then t := (t.drop pre.length).toString
  for suf in [" storage pointer", " storage ref", " memory", " calldata", " storage"] do
    if t.endsWith suf then t := (t.dropEnd suf.length).toString
  for (inner, repl) in [(" memory[", "["), (" calldata[", "["), (" storage[", "[")] do
    t := t.replace inner repl
  if t == "uint" then t := "uint256"
  else if t == "int" then t := "int256"
  else if t == "address payable" then t := "address"
  return t

/-- A written type matches its Solidity spelling, optionally qualified (`I.Market`). -/
private def typeMatches (written typeString : String) : Bool :=
  let t := sourceTypeName typeString
  let w := sourceTypeName written
  t == w || t.endsWith ("." ++ w) || w.endsWith ("." ++ t)

private structure CandidateFn where
  id : Nat
  fn : Json
  tys : Array String
  canonicalTys : Array String
  implemented : Bool
  deriving Inhabited

/-- Select the function from `contract`'s C3 inheritance hierarchy; also return
its solc parameter type strings. -/
private def selectFunction (contract functionName : String) (written : Array String) :
    M (Json × Array String) := do
  let env ← get
  let mut effective : Array CandidateFn := #[]
  for cid in env.linearizedBases do
    for id in env.contractFuns.find? cid |>.getD #[] do
      let some fn := env.funs.find? id | continue
      if optStr fn "kind" == some "constructor" then continue
      let name ← mStr (← mField fn "name")
      unless name == functionName do continue
      let params ← mArr (← mField (← mField fn "parameters") "parameters")
      let mut tys : Array String := #[]
      for p in params do
        tys := tys.push (← liftM (typeString p))
      let canonicalTys := tys.map sourceTypeName
      let implementedFlag ← match field? fn "implemented" with
        | some b => mBool b
        | none => pure true
      let hasBody := match field? fn "body" with
        | some b => !b.isNull
        | none => false
      let implemented := implementedFlag && hasBody
      let matchIdx? := effective.findIdx? fun prev =>
        sameVirtualFamily env prev.id id || prev.canonicalTys == canonicalTys
      match matchIdx? with
      | none =>
          effective := effective.push { id, fn, tys, canonicalTys, implemented }
      | some idx =>
          if !effective[idx]!.implemented && implemented then
            effective := effective.set! idx { id, fn, tys, canonicalTys, implemented }
    for id in env.contractPublicVars.find? cid |>.getD #[] do
      let some varDecl := env.stateVars.find? id | continue
      let name ← mStr (← mField varDecl "name")
      unless name == functionName do continue
      let (paramSpecs, _) ← publicVarGetterParamTypes (← mField varDecl "typeName")
      let tys := paramSpecs.map Prod.fst
      let canonicalTys := tys.map sourceTypeName
      let implemented := true
      let matchIdx? := effective.findIdx? fun prev =>
        sameVirtualFamily env prev.id id || prev.canonicalTys == canonicalTys
      match matchIdx? with
      | none =>
          effective := effective.push { id, fn := varDecl, tys, canonicalTys, implemented }
      | some idx =>
          if !effective[idx]!.implemented && implemented then
            effective := effective.set! idx { id, fn := varDecl, tys, canonicalTys, implemented }
  let mut hits : Array (Json × Array String × Bool) := #[]
  let mut described : Array String := #[]
  for cand in effective do
    described := described.push
      s!"{functionName}({String.intercalate ", " cand.canonicalTys.toList})"
    if cand.tys.size == written.size && (cand.tys.zip written).all (fun (t, w) =>
        typeMatches w t || (match env.userValueTypes.find? t with | some u => typeMatches w u | none => false)) then
      hits := hits.push (cand.fn, cand.tys, cand.implemented)
  let sig := s!"{contract}.{functionName}({String.intercalate ", " written.toList})"
  if hits.size == 0 then
    throwError "no function {sig}; candidates: {described}"
  if hits.size > 1 then
    throwError "ambiguous function {sig}; qualify the parameter types"
  let (fn, tys, implemented) := hits[0]!
  unless implemented do throwError "function is not implemented"
  pure (fn, tys)

private def importSlice
    (pkgRoot projectRoot : System.FilePath) (entry contract : String)
    (roots : Array (String × Array String)) (profile : Profile) :
    MetaM (CompilationModel × ImportReport) := do
  let release ← resolveSolcRelease profile
  let compiler := pkgRoot / ".lake/solidity-import" / release.binaryName
  let solcSha ← verifyCompiler release compiler
  let versionOut ← IO.Process.output { cmd := compiler.toString, args := #["--version"] }
  unless versionOut.exitCode == 0 &&
      release.banners.contains versionOut.stdout.trimAscii.toString do
    throwError "compiler version mismatch"
  unless (← verifyCompiler release compiler) == solcSha do throwError "compiler changed during import"
  let written ← readRemappings projectRoot
  let stage0 := remapStage0 (← readRemapRootShallow projectRoot) written
  let reads ← IO.mkRef ({ root := projectRoot, written, stage0 } : RemapReads)
  let (sources, usedInferred) ← collectSources projectRoot entry reads (RBMap.empty, #[])
  let reads ← reads.get
  -- solc sees the written remappings `forge build` keeps and, in Foundry's order, the inferred
  -- ones in use.
  let usedInferred := match reads.full with
    | some full => full.remappings.filter usedInferred.contains
    | none => #[]
  let remaps := stage0.explicit ++ usedInferred.map fun r => (r.name, r.path)
  let remappingScan :=
    if reads.full.isSome then "full" else if reads.pool.isSome then "configs" else "none"
  let mut fileBytes : RBMap String ByteArray compare := RBMap.empty
  let mut sourceObj : Array (String × Json) := #[]
  for (logical, text) in sources do
    fileBytes := fileBytes.insert logical (text.toUTF8)
    sourceObj := sourceObj.push (logical, Json.mkObj [("content", Json.str text)])
  let solcEvm := solcEvmVersion release profile.evmVersion
  -- Experimental fork names such as `@future` are gated behind this flag.
  let experimentalSettings : List (String × Json) :=
    if solcEvm.startsWith "@" then [("experimental", Json.bool true)] else []
  let baseSettings : List (String × Json) := [
    ("evmVersion", Json.str solcEvm),
    ("metadata", Json.mkObj [("bytecodeHash", Json.str profile.bytecodeHash)]),
    ("optimizer", Json.mkObj [("enabled", Json.bool profile.optimizerRuns.isSome),
      ("runs", profile.optimizerRuns.getD 200)]),
    ("outputSelection", Json.mkObj [("*", Json.mkObj [
      ("", Json.arr #[Json.str "ast"]),
      ("*", Json.arr #[Json.str "storageLayout", Json.str "transientStorageLayout"])])]),
    ("remappings", Json.arr (remaps.map fun p => Json.str s!"{p.1}={p.2}"))]
  let settings := Json.mkObj ((if release.supportsViaIR then
    baseSettings ++ [("viaIR", Json.bool profile.viaIR)]
  else baseSettings) ++ experimentalSettings)
  let input := Json.mkObj [
    ("language", Json.str "Solidity"),
    ("settings", settings),
    ("sources", Json.mkObj sourceObj.toList)]
  let solcArgs := if release.hasNoImportCallbackFlag then
    #["--standard-json", "--no-import-callback"]
  else
    #["--standard-json"]
  let output ← IO.Process.output
    { cmd := compiler.toString, args := solcArgs }
    (some input.compress)
  unless output.exitCode == 0 do throwError "solc failed: {output.stderr}"
  unless (← verifyCompiler release compiler) == solcSha do throwError "compiler changed during import"
  let parsed ← match Json.parse output.stdout with
    | .ok v => pure v
    | .error e => throwError "solc output is not JSON: {e}"
  if let some errors := field? parsed "errors" then
    for err in ← arr errors do
      let severity := optStr err "severity" |>.getD ""
      if severity == "error" then
        throwError "solc: {optStr err "formattedMessage" |>.getD "error"}"
  let mut env := Env.init
  let legacy := release.longVersion == "0.7.6+commit.7338295f"
  env := { env with files := fileBytes, viaIR := profile.viaIR,
                    linkedLibrariesMatchSource := profile.linkedLibrariesMatchSource }
  env := { env with legacyWrapping := legacy, unchecked := legacy }
  let sourcesOut ← field parsed "sources"
  let .obj sourceUnits := sourcesOut | throwError "solc sources output is not an object"
  for (logical, _) in sourceUnits do
    unless sources.contains logical do
      throwError "solc loaded uncollected source {logical}"
  let mut asts : Array (String × Json) := #[]
  for (logical, _) in sources do
    let unit ← field sourcesOut logical
    asts := asts.push (logical, ← field unit "ast")
  env := { env with abiCoderV1 := asts.any fun (_, ast) =>
    abiCoderV1Pragma ast || (legacy && !legacyAbiV2 ast) }
  -- Named arguments in declaration order become positional before any lowering sees them.
  let declared := asts.foldl (fun acc (_, ast) => declaredArgumentNames acc ast) {}
  for (logical, ast) in asts do
    ((), env) ← (index logical none (positionalNamedArguments declared ast)).run env
  let targetContractIds := env.contractNames.toList.filterMap fun (cid, cname) =>
    if env.nodeFile.find? cid == some entry && cname == contract then some cid else none
  let [targetContractId] := targetContractIds
    | throwError "missing or ambiguous ContractDefinition {contract} in {entry}"
  let some targetBases := env.contractBases.find? targetContractId
    | throwError "missing linearizedBaseContracts for {contract}"
  env := { env with linearizedBases := targetBases }
  -- External decoding is generated in the target contract's source unit,
  -- including for functions inherited from a differently configured base.
  let entryAst ← field (← field sourcesOut entry) "ast"
  let strictAbi := !legacy || legacyAbiV2 entryAst
  let contracts ← field parsed "contracts"
  let entryContracts ← field contracts entry
  let chosen ← field entryContracts contract
  let layout ← field chosen "storageLayout"
  let types ← field layout "types"
  let items ← arr (← field layout "storage")
  -- solc reports `transient` state variables only here; older releases omit it.
  let (transientTypes, transientItems) ← match field? chosen "transientStorageLayout" with
    | some tl => pure (← field tl "types", ← arr (← field tl "storage"))
    | none => pure (Json.null, #[])
  env := { env with layoutTypes := types, transientLayoutTypes := transientTypes }
  for item in items do
    let label ← str (← field item "label")
    if env.layoutItems.contains label && !env.duplicateLayoutLabels.contains label then
      env := { env with duplicateLayoutLabels := env.duplicateLayoutLabels.push label }
    env := { env with layoutItems := env.layoutItems.insert label item }
  let persistentItems := env.layoutItems
  for item in transientItems do
    let label ← str (← field item "label")
    -- A persistent variable keeps its label: the transient namesake stays unresolved and
    -- its uses hit the shadowed-declaration rejection, as without transient layouts.
    if persistentItems.contains label then continue
    if env.layoutItems.contains label && !env.duplicateLayoutLabels.contains label then
      env := { env with duplicateLayoutLabels := env.duplicateLayoutLabels.push label }
    let tagged := item.setObjVal! transientLayoutKey (.bool true)
    env := { env with layoutItems := env.layoutItems.insert label tagged }
  let mut specs : Array FunctionSpec := #[]
  let mut projections : Array ParamProjection := #[]
  let mut signatures : Array Json := #[]
  let mut rootIds : Array Nat := #[]
  -- Names of the roots selected so far. Unlike `specs`, this is never rolled
  -- back by the per-root recovery point, so the name collision check below does
  -- not depend on whether an earlier root was unsupported (or on root order).
  -- With `collectUnsupported` off it equals `specs.map (·.name)` here.
  let mut rootNames : Array String := #[]
  let mut unsupportedRoots : Array (String × List UnsupportedConstruct) := #[]
  -- Shortcuts each importable root's model uses (`Env.rootShortcuts` after its lowering).
  let mut rootShortcuts : Array (String × List ShortcutUse) := #[]
  -- Linked library calls each importable root's model inlines (`Env.rootLinkedLibraryCalls`).
  let mut rootLinkedLibraryCalls : Array (String × List LinkedLibraryCall) := #[]
  if profile.collectUnsupported then
    let pending ← IO.mkRef (none : Option (String × UnsupportedConstruct × Array Nat))
    let recorded ← IO.mkRef (#[] : Array UnsupportedConstruct)
    let skippedDecls ← IO.mkRef (#[] : Array (Nat × String))
    let sink : UnsupportedSink := { pending, recorded, skippedDecls }
    env := { env with unsupportedSink := some sink }
  for (functionName, written) in roots do
    let (fn, paramTys) ← (selectFunction contract functionName written).run' env
    -- ABI coder v1 cleans scalar words instead of the generic loader's v2 validation.
    let legacyScalarPrelude := !strictAbi && paramTys.any fun ty =>
      (paramType ty).any (fun p => !isFullWordYulScalar p)
    let rootId ← flexNat (← field fn "id")
    if rootIds.contains rootId then throwError "function {contract}.{functionName} is imported twice"
    -- A collision is an error in the root list, not an unsupported construct:
    -- like `imported twice`, it is rejected in survey mode too.
    if rootNames.contains functionName then
      let rootFile := env.nodeFile.find? rootId |>.getD entry
      (failAt fn s!"root function name collision: {contract}.{functionName}; import overloaded roots in separate slices").run' { env with currentFile := rootFile }
    rootIds := rootIds.push rootId
    rootNames := rootNames.push functionName
    signatures := signatures.push (Json.mkObj
      [("function", Json.str functionName), ("parameterTypes", Json.arr (paramTys.map Json.str))])
    let rootFile := env.nodeFile.find? rootId |>.getD entry
    -- Per-root recovery point under `collectUnsupported`: a root whose lowering
    -- records a construct or throws is rolled back (environment, specs and
    -- projections), so it contributes nothing to the model or the closure.
    let envBefore := env
    let specsBefore := specs
    let projectionsBefore := projections
    let rootShortcutsBefore := rootShortcuts
    let rootLinkedLibraryCallsBefore := rootLinkedLibraryCalls
    if let some sink := env.unsupportedSink then
      sink.pending.set none
      sink.recorded.set #[]
      sink.skippedDecls.set #[]
    try
      -- Each root is lowered on its own: bindings, generated names and projections
      -- do not leak between functions. Field layouts and the closure are shared.
      env := { env with currentFile := rootFile, next := 0, bound := [], values := RBMap.empty, paths := RBMap.empty,
                        snapshots := RBMap.empty, mems := RBMap.empty, flatStructs := RBMap.empty, abiElements := RBMap.empty, calldataBytes := RBMap.empty, scalarArrays := RBMap.empty, fixedMemArrays := RBMap.empty, nestedMemArrays := RBMap.empty, fixedArrayHelperResult := none, dynArrayHelperResult := none, byteBuffers := RBMap.empty, stringBuffers := RBMap.empty, nonLiteralByteLocals := #[], storageBytesVars := RBMap.empty, storageDynamicArrayVars := RBMap.empty, scalarTy := RBMap.empty, enumBounds := RBMap.empty, bytes4Params := #[], writableLocals := RBMap.empty, fnPtrs := RBMap.empty, bodyAssigned := [], zeroInitLocals := #[], yulNames := RBMap.empty, yulMemoryArrays := RBMap.empty, yulMemoryStructs := RBMap.empty,
                        projections := #[], rawBindings := RBMap.empty, explicitAbi := legacyScalarPrelude, encodingMemory := false, forwardingBytesTuple := false, helperResult := none, helperReturnId := none, multiHelperResults := none, flatStructHelperResult := none, helperPost := #[], rootIsVoid := false, rootReturns := #[], rootReturnTypes := #[], rootNamedReturn := none, rootFixedArrayReturn := none, rootFlatStructReturn := none, rootMsgDataReturn := false, rootDynamicBytesReturn := none, rootDynamicStructReturn := none, rootDynamicTupleReturn := none, rootPost := #[], publicVarGetterReturns := #[], selfAddressBindings := #[], codeReadSites := #[], codeHashSites := #[], yulCleanedNarrowBindings := #[], yulBindingReadSites := #[], yulFreePointerBindings := #[],
                        unpaddedByteDataBindings := #[], yulByteWordLoadSites := #[],
