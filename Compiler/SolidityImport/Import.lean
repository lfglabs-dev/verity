/-- `for (i = 0; i < n; i++)` over a counter `i` declared before the loop. The loop
    lowers exactly as `for (uintN i = 0; …)` with the counter scoped to the loop; the
    local then receives the counter's exit value `n` (the bound is invariant, and a
    narrow counter whose bound reaches `2^N` panics before the store). A `break`
    would exit with another value and is rejected. -/
private partial def lowerPredeclaredFor (s init : Json) (lowerBody : Json → M (Array Stmt))
    (earlyExitGuard : Option Expr := none) :
    M (Array Stmt) := do
  let assign ← mField init "expression"
  unless (← mKind assign) == "Assignment" && optStr assign "operator" == some "=" do
    failAt init "a for loop initializer must declare or assign its counter"
  let lhs ← mField assign "leftHandSide"
  let rhs ← mField assign "rightHandSide"
  unless (← mKind lhs) == "Identifier" do
    failAt lhs "a pre-declared for loop counter must be a local variable"
  let counterId ← refInt lhs
  let locals := (← get).writableLocals
  let some binding := if counterId < 0 then none else locals.find? counterId.toNat
    | failAt lhs "a pre-declared for loop counter must be a writable local variable"
  let env ← get
  if statefulCallIn rhs env || assignmentIn rhs then
    failAt rhs "a pre-declared for loop counter initializer must be side-effect free"
  let cond := (field? s "condition").getD Json.null
  unless optStr cond "nodeType" == some "BinaryOperation" && optStr cond "operator" == some "<" do
    failAt s "a for loop over a pre-declared counter must test counter < bound"
  if ← stmtContainsLoopJump "Break" (← mField s "body") then
    failAt s "a for loop over a pre-declared counter must not break"
  let decl := Json.mkObj [("nodeType", Json.str "VariableDeclaration"), ("id", toJson counterId),
    ("name", ← mField lhs "name"), ("typeDescriptions", ← mField lhs "typeDescriptions"),
    ("src", ← mField lhs "src")]
  let declStmt := Json.mkObj [("nodeType", Json.str "VariableDeclarationStatement"),
    ("declarations", Json.arr #[decl]), ("initialValue", rhs), ("src", ← mField init "src")]
  let loopStmts ← lowerFor (s.setObjVal! "initializationExpression" declStmt) lowerBody
    (some binding) earlyExitGuard
  modify fun e => { e with zeroInitLocals := e.zeroInitLocals.filter (· != counterId.toNat) }
  pure loopStmts

private partial def unwrapLoopBodyStmts (j : Json) : M (Array Json) := do
  let kind ← mKind j
  if kind == "Block" || kind == "UncheckedBlock" then
    let stmts ← mArr (← mField j "statements")
    if stmts.size == 1 then
      if (← mKind stmts[0]!) == "Block" || (← mKind stmts[0]!) == "UncheckedBlock" then
        return ← unwrapLoopBodyStmts stmts[0]!
    pure stmts
  else
    pure #[j]

private partial def loopBodyUsesUnchecked (j : Json) : M Bool := do
  let kind ← mKind j
  if kind == "UncheckedBlock" then
    return true
  if kind == "Block" then
    let stmts ← mArr (← mField j "statements")
    if stmts.size == 1 then
      if (← mKind stmts[0]!) == "Block" || (← mKind stmts[0]!) == "UncheckedBlock" then
        return ← loopBodyUsesUnchecked stmts[0]!
  return false

/-- Member name when `j` is the member access `param.member` on storage parameter `paramId`. -/
private partial def paramMemberName? (j : Json) (paramId : Nat) : M (Option String) := do
  let j ← stripParens j
  unless (← mKind j) == "MemberAccess" do return none
  unless ← isIdentId (← mField j "expression") paramId do return none
  return optStr j "memberName"

/-- Whether `j` is the mapping entry `param.dataMember[idx]` for the local `idxId`. -/
private partial def isParamMappingEntry (j : Json) (paramId : Nat) (dataMember : String)
    (idxId : Nat) : M Bool := do
  let j ← stripParens j
  unless (← mKind j) == "IndexAccess" do return false
  let some idx := field? j "indexExpression" | return false
  if idx.isNull then return false
  unless ← isIdentId idx idxId do return false
  return (← paramMemberName? (← mField j "baseExpression") paramId) == some dataMember

/-- Whether `s` always reverts: a `revert E(...)` statement, optionally wrapped in a block. -/
private partial def isRevertOnlyStmt (s : Json) : M Bool := do
  match ← mKind s with
  | "RevertStatement" => pure true
  | "Block" | "UncheckedBlock" =>
      let stmts ← mArr (← mField s "statements")
      if stmts.size == 1 then isRevertOnlyStmt stmts[0]! else pure false
  | _ => pure false

/-- The expression of an `ExpressionStatement`, or `none` for any other statement. -/
private partial def exprStmt? (s : Json) : M (Option Json) := do
  if (← mKind s) == "ExpressionStatement" then
    return some (← mField s "expression")
  return none

/-- Whether `s` decrements the local `idxId` by one (`--i`, `i--`, `i -= 1`, `i = i - 1`). -/
private partial def isDecrementStmt (s : Json) (idxId : Nat) : M Bool := do
  let some e ← exprStmt? s | return false
  match ← mKind e with
  | "UnaryOperation" =>
      if optStr e "operator" != some "--" then return false
      isIdentId (← mField e "subExpression") idxId
  | "Assignment" =>
      let op ← mStr (← mField e "operator")
      unless ← isIdentId (← mField e "leftHandSide") idxId do return false
      let rhs ← stripParens (← mField e "rightHandSide")
      if op == "-=" then return ← isOneLiteral rhs
      unless op == "=" && (← mKind rhs) == "BinaryOperation" &&
          optStr rhs "operator" == some "-" do
        return false
      unless ← isIdentId (← mField rhs "leftExpression") idxId do return false
      isOneLiteral (← mField rhs "rightExpression")
  | _ => pure false

/-- Whether `s` is `if (i == param.bound) revert ...;` (either operand order, no `else`). -/
private partial def isEmptyRangeRevert (s : Json) (paramId idxId : Nat) (bound : String) :
    M Bool := do
  unless (← mKind s) == "IfStatement" do return false
  if let some f := field? s "falseBody" then
    unless f.isNull do return false
  unless ← isRevertOnlyStmt (← mField s "trueBody") do return false
  let cond ← stripParens (← mField s "condition")
  unless (← mKind cond) == "BinaryOperation" && optStr cond "operator" == some "==" do
    return false
  let lhs ← mField cond "leftExpression"
  let rhs ← mField cond "rightExpression"
  if ← isIdentId lhs idxId then
    return (← paramMemberName? rhs paramId) == some bound
  if ← isIdentId rhs idxId then
    return (← paramMemberName? lhs paramId) == some bound
  return false

/-- Whether `s` is `value = param.dataMember[i];` for the single return variable `retId`. -/
private partial def isPoppedEntryRead (s : Json) (retId paramId : Nat) (dataMember : String)
    (idxId : Nat) : M Bool := do
  let some e ← exprStmt? s | return false
  unless (← mKind e) == "Assignment" && optStr e "operator" == some "=" do return false
  unless ← isIdentId (← mField e "leftHandSide") retId do return false
  isParamMappingEntry (← mField e "rightHandSide") paramId dataMember idxId

/-- Whether `s` is `delete param.dataMember[i];`. -/
private partial def isPoppedEntryDelete (s : Json) (paramId : Nat) (dataMember : String)
    (idxId : Nat) : M Bool := do
  let some e ← exprStmt? s | return false
  unless (← mKind e) == "UnaryOperation" && optStr e "operator" == some "delete" do
    return false
  isParamMappingEntry (← mField e "subExpression") paramId dataMember idxId

/-- Whether `s` writes the popped bound back: `param.bound = i` after a decrement
    (`fromHigh`), or `param.bound = i + 1` otherwise. -/
private partial def isBoundAdvance (s : Json) (paramId : Nat) (bound : String) (idxId : Nat)
    (fromHigh : Bool) : M Bool := do
  let some e ← exprStmt? s | return false
  unless (← mKind e) == "Assignment" && optStr e "operator" == some "=" do return false
  unless (← paramMemberName? (← mField e "leftHandSide") paramId) == some bound do
    return false
  let rhs ← stripUintCast (← mField e "rightHandSide") 128
  if fromHigh then return ← isIdentId rhs idxId
  unless (← mKind rhs) == "BinaryOperation" && optStr rhs "operator" == some "+" do
    return false
  unless ← isIdentId (← mField rhs "leftExpression") idxId do return false
  isOneLiteral (← mField rhs "rightExpression")

/-- Recognizes a bounded-range pop helper over a storage struct whose members are two
    `uint128` bounds and one `mapping(uint128 => bytes32)`, returning the `(low, high)`
    bound member names. The helper takes the struct as its only parameter, returns one
    `bytes32`, and its (optionally `unchecked`) body is exactly either
    `uint128 i = s.low; if (i == s.high) revert ...; value = s.data[i];
     [delete s.data[i];] s.low = i + 1;`
    or
    `uint128 i = s.high; if (i == s.low) revert ...; --i; value = s.data[i];
     [delete s.data[i];] s.high = i;`.
    Every non-reverting call thus shrinks `(high - low) mod 2^128` by exactly one, and a
    call on an empty range reverts. Member and helper names are irrelevant; modifiers are
    rejected because they could change the range around the body. -/
private partial def boundedRangePopBounds? (fn sdecl : Json) : M (Option (String × String)) := do
  if let some mods := field? fn "modifiers" then
    unless (← mArr mods).isEmpty do return none
  let params ← mArr (← mField (← mField fn "parameters") "parameters")
  let rets ← mArr (← mField (← mField fn "returnParameters") "parameters")
  unless params.size == 1 && rets.size == 1 do return none
  let paramId ← mNat (← mField params[0]! "id")
  let retId ← mNat (← mField rets[0]! "id")
  let members ← (← mArr (← mField sdecl "members")).mapM fun m => do
    pure ((← mStr (← mField m "name")), (← mType m))
  let boundNames := members.filterMap fun (n, ty) => if ty == "uint128" then some n else none
  let dataNames := members.filterMap fun (n, ty) =>
    if ty == "mapping(uint128 => bytes32)" then some n else none
  unless members.size == 3 && boundNames.size == 2 && dataNames.size == 1 do return none
  let dataMember := dataNames[0]!
  let some body := field? fn "body" | return none
  if body.isNull then return none
  let stmts ← unwrapLoopBodyStmts body
  unless stmts.size ≥ 4 && (← mKind stmts[0]!) == "VariableDeclarationStatement" do
    return none
  let decls ← mArr (← mField stmts[0]! "declarations")
  let some init := field? stmts[0]! "initialValue" | return none
  unless decls.size == 1 && !decls[0]!.isNull && !init.isNull do return none
  unless (← mType decls[0]!) == "uint128" do return none
  let idxId ← mNat (← mField decls[0]! "id")
  let some popped ← paramMemberName? init paramId | return none
  unless boundNames.contains popped do return none
  let other := if boundNames[0]! == popped then boundNames[1]! else boundNames[0]!
  unless ← isEmptyRangeRevert stmts[1]! paramId idxId other do return none
  let fromHigh ← isDecrementStmt stmts[2]! idxId
  let rest := stmts.extract (if fromHigh then 3 else 2) stmts.size
  unless rest.size == 2 || rest.size == 3 do return none
  unless ← isPoppedEntryRead rest[0]! retId paramId dataMember idxId do return none
  if rest.size == 3 then
    unless ← isPoppedEntryDelete rest[1]! paramId dataMember idxId do return none
  unless ← isBoundAdvance rest.back! paramId popped idxId fromHigh do return none
  return some (if fromHigh then (other, popped) else (popped, other))

/-- Parse a non-negative compile-time constant expression (literal or pure numeric constant,
optionally wrapped in parentheses or a `uintN(...)` conversion) to its natural value. -/
private partial def parseNatConstExpr? (j : Json) : M (Option Nat) := do
  let j ← stripParens j
  match ← mKind j with
  | "Literal" =>
      unless optStr j "kind" == some "number" do return none
      let raw ← mStr (← mField j "value")
      let clean := (raw.splitOn "_").foldl (· ++ ·) ""
      match Compiler.Hex.parseHexNat? clean <|> clean.toNat? with
      | some n => if n < 2 ^ 256 then return some n else return none
      | none => return none
  | "FunctionCall" =>
      if optStr j "kind" == some "typeConversion" && (← mType j).startsWith "uint" then
        let args ← mArr (← mField j "arguments")
        if args.size == 1 then return ← parseNatConstExpr? args[0]!
      return none
  | "Identifier" =>
      let id ← refInt j
      if id ≥ 0 then
        if let some decl := (← get).numericConstants.find? id.toNat then
          let ty ← mType decl
          if ty.startsWith "uint" && (bitsOf ty).isSome then
            if let some init := field? decl "value" then
              return ← parseNatConstExpr? init
      return none
  | _ => return none

/-- Conservative syntactic loop-invariance check for scalar bound expressions: depends only on
literals, numeric constants, parameters/unassigned locals, `.length` of unassigned
calldata/memory arrays/buffers, `type(T).max`/`.min`, and pure scalar operations on them.
Trusting unassigned identifiers in `env.values` and memory-array `.length` relies on Solidity's
semantics: scalar locals are passed by value and allocated memory arrays/buffers have fixed
length, so called helpers never mutate caller locals or memory-array lengths. -/
private partial def exprIsLoopInvariant (j : Json) (writes : List Nat) : M Bool := do
  let j ← stripParens j
  match ← mKind j with
  | "Literal" => pure true
  | "Identifier" =>
      let id ← refInt j
      if id < 0 then return false
      if writes.contains id.toNat then return false
      let env ← get
      return env.values.contains id.toNat || env.numericConstants.contains id.toNat
  | "MemberAccess" =>
      let member := optStr j "memberName" |>.getD ""
      let base ← stripParens (← mField j "expression")
      if member == "length" then
        if (← mKind base) == "Identifier" then
          let id ← refInt base
          if id ≥ 0 && !writes.contains id.toNat then
            let env ← get
            if env.calldataBytes.contains id.toNat || env.scalarArrays.contains id.toNat ||
               env.fixedMemArrays.contains id.toNat || env.byteBuffers.contains id.toNat ||
               env.stringBuffers.contains id.toNat ||
               (env.mems.find? id.toNat).any (·.rootArrayWord.isSome) then
              return true
        return false
      if member == "max" || member == "min" then
        return isTypeCallExpr base
      let id := (field? j "referencedDeclaration").bind (·.getInt?.toOption) |>.getD (-1)
      return id ≥ 0 && (← get).numericConstants.contains id.toNat
  | "BinaryOperation" =>
      let op := optStr j "operator" |>.getD ""
      unless ["+", "-", "*", "/", "%", "&", "|", "^", "<<", ">>"].contains op do return false
      return (← exprIsLoopInvariant (← mField j "leftExpression") writes) &&
        (← exprIsLoopInvariant (← mField j "rightExpression") writes)
  | "UnaryOperation" =>
      let op := optStr j "operator" |>.getD ""
      unless ["~", "-"].contains op do return false
      exprIsLoopInvariant (← mField j "subExpression") writes
  | "FunctionCall" =>
      unless optStr j "kind" == some "typeConversion" do return false
      let args ← mArr (← mField j "arguments")
      unless args.size == 1 do return false
      exprIsLoopInvariant args[0]! writes
  | _ => pure false

/-- Recognize a single-variable monotonic step statement (`v++`, `++v`, `v += k`, `v = v + k`
when `increasing`, or `v--`, `--v`, `v -= k`, `v = v - k` otherwise, optionally wrapped in
a single-statement `Block` / `UncheckedBlock`). Returns `(k, inUnchecked)` for `k ≥ 1`. -/
private partial def matchLinearStep (st : Json) (varId bits : Nat) (increasing : Bool)
    (inUnchecked : Bool := false) : M (Option (Nat × Bool)) := do
  match ← mKind st with
  | "UncheckedBlock" =>
      let stmts ← mArr (← mField st "statements")
      if stmts.size == 1 then matchLinearStep stmts[0]! varId bits increasing true else return none
  | "Block" =>
      let stmts ← mArr (← mField st "statements")
      if stmts.size == 1 then matchLinearStep stmts[0]! varId bits increasing inUnchecked else return none
  | "ExpressionStatement" =>
      let e ← stripParens (← mField st "expression")
      match ← mKind e with
      | "UnaryOperation" =>
          let wantOp := if increasing then "++" else "--"
          if optStr e "operator" == some wantOp && (← isIdentId (← mField e "subExpression") varId) then
            return some (1, inUnchecked)
          return none
      | "Assignment" =>
          unless ← isIdentId (← mField e "leftHandSide") varId do return none
          let op ← mStr (← mField e "operator")
          let rhs ← mField e "rightHandSide"
          let compoundOp := if increasing then "+=" else "-="
          if op == compoundOp then
            if let some k ← parseNatConstExpr? rhs then
              if k ≥ 1 then return some (k, inUnchecked)
            return none
          if op == "=" then
            let r ← stripUintCast rhs bits
            let binOp := if increasing then "+" else "-"
            if (← mKind r) == "BinaryOperation" && optStr r "operator" == some binOp then
              let l ← mField r "leftExpression"
              let rr ← mField r "rightExpression"
              if ← isIdentId l varId then
                if let some k ← parseNatConstExpr? rr then
                  if k ≥ 1 then return some (k, inUnchecked)
              if increasing && (← isIdentId rr varId) then
                if let some k ← parseNatConstExpr? l then
                  if k ≥ 1 then return some (k, inUnchecked)
          return none
      | _ => return none
  | _ => return none

/-- `while (v > X)`, `while (X < v)`, `while (v != 0)`, or `while (v >= C)` / `while (C <= v)`
(for constant `C ≥ 1`) over an unsigned writable local `v` whose body contains exactly one
top-level `v /= k` or `v = v / k` with a literal `k ≥ 2`, no other write to `v`, and no
`break`, `continue` or `return`. -/
private partial def lowerDivisionWhile? (s cond : Json) (lowerBody : Json → M (Array Stmt))
    (allowReturn : Bool := false) : M (Option (Array Stmt)) := do
  unless (← mKind cond) == "BinaryOperation" do return none
  let condOp ← mStr (← mField cond "operator")
  let condLhs ← stripParens (← mField cond "leftExpression")
  let condRhs ← stripParens (← mField cond "rightExpression")
  let varNode? ←
    if condOp == ">" then pure (some condLhs)
    else if condOp == "<" then pure (some condRhs)
    else if condOp == ">=" && ((← parseNatConstExpr? condRhs).any (· ≥ 1)) then pure (some condLhs)
    else if condOp == "<=" && ((← parseNatConstExpr? condLhs).any (· ≥ 1)) then pure (some condRhs)
    else if condOp == "!=" && (← isZeroLiteral condRhs) then pure (some condLhs)
    else if condOp == "!=" && (← isZeroLiteral condLhs) then pure (some condRhs)
    else pure none
  let some varNode := varNode? | return none
  unless (← mKind varNode) == "Identifier" do return none
  let varRef ← refInt varNode
  unless varRef ≥ 0 do return none
  let varId := varRef.toNat
  unless ((← get).writableLocals.find? varId).isSome do return none
  let varTy ← mType varNode
  let some bits := bitsOf varTy | return none
  unless varTy.startsWith "uint" && bits > 0 && bits ≤ 256 do return none
  let body ← mField s "body"
  let bodyStmts ← unwrapLoopBodyStmts body
  let isStep (st : Json) : M Bool := do
    unless (← mKind st) == "ExpressionStatement" do return false
    let e ← mField st "expression"
    unless (← mKind e) == "Assignment" do return false
    unless ← isIdentId (← mField e "leftHandSide") varId do return false
    let op ← mStr (← mField e "operator")
    let rhs ← mField e "rightHandSide"
    if op == "/=" then return ← isDivisorConstGe2 rhs
    unless op == "=" do return false
    let r ← stripUintCast rhs bits
    unless (← mKind r) == "BinaryOperation" && optStr r "operator" == some "/" do return false
    return (← isIdentId (← mField r "leftExpression") varId) &&
      (← isDivisorConstGe2 (← mField r "rightExpression"))
  let steps ← bodyStmts.filterM isStep
  unless steps.size == 1 do return none
  if ← listContainsReturn bodyStmts then
    unless allowReturn do
      failAt s "return inside a while loop is unsupported"
  for st in bodyStmts do
    if ← stmtContainsBreakOrContinue st then
      failAt st "break or continue inside a dividing while loop is unsupported"
    if !(← isStep st) && (bodyAssignedIds st).contains varId then
      failAt st "a dividing while loop variable may only be updated by its division step"
  let condVal ← lowerExpr cond
  unless condVal.pre.isEmpty do
    failAt cond "while loop condition must be a pure scalar comparison"
  let loopVar ← fresh
  let saved ← get
  let bodyOut ← lowerBody body
  let loopWrites := bodyAssignedIds body
  modify fun e =>
    { e with values := saved.values, paths := saved.paths,
             snapshots := saved.snapshots, mems := saved.mems, abiElements := saved.abiElements,
             calldataBytes := saved.calldataBytes, scalarArrays := saved.scalarArrays, byteBuffers := saved.byteBuffers, stringBuffers := saved.stringBuffers, storageBytesVars := saved.storageBytesVars, storageDynamicArrayVars := saved.storageDynamicArrayVars, flatStructs := saved.flatStructs, scalarTy := saved.scalarTy,
             writableLocals := saved.writableLocals, zeroInitLocals := saved.zeroInitLocals.filter (!loopWrites.contains ·), fnPtrs := saved.fnPtrs, yulNames := saved.yulNames, yulMemoryArrays := saved.yulMemoryArrays, yulMemoryStructs := saved.yulMemoryStructs }
  return some #[.forEach loopVar (.literal bits) [.ite condVal.expr bodyOut.toList []]]

/-- `while (v > X)`, `while (X < v)`, `while (v >= C)` / `while (C <= v)` (constant `C ≥ 1`)
over an unsigned writable local `v` whose final statement is a bounded right-shift (`v >>= k`)
or bit-clearing (`v &= v - 1`, `msb` + `clearBit`) step. Every non-zero iteration strictly
reduces `v`'s active bits, so after `bits` iterations `v == 0` and the guard is false. -/
private partial def lowerGeneralBitShiftWhile? (s cond : Json) (lowerBody : Json → M (Array Stmt))
    (allowReturn : Bool := false) :
    M (Option (Array Stmt)) := do
  unless (← mKind cond) == "BinaryOperation" do return none
  let condOp ← mStr (← mField cond "operator")
  let condLhs ← stripParens (← mField cond "leftExpression")
  let condRhs ← stripParens (← mField cond "rightExpression")
  -- Zero comparisons (`v != 0`, `v > 0`, `0 < v`) keep the dedicated fallback path and diagnostics.
  if (condOp == "!=" || condOp == ">") && (← isZeroLiteral condRhs) then return none
  if (condOp == "!=" || condOp == "<") && (← isZeroLiteral condLhs) then return none
  let varNode? ←
    if condOp == ">" then pure (some condLhs)
    else if condOp == "<" then pure (some condRhs)
    else if condOp == ">=" && ((← parseNatConstExpr? condRhs).any (· ≥ 1)) then pure (some condLhs)
    else if condOp == "<=" && ((← parseNatConstExpr? condLhs).any (· ≥ 1)) then pure (some condRhs)
    else pure none
  let some varNode := varNode? | return none
  unless (← mKind varNode) == "Identifier" do return none
  let varRef ← refInt varNode
  unless varRef ≥ 0 do return none
  let varId := varRef.toNat
  unless ((← get).writableLocals.find? varId).isSome do return none
  let varTy ← mType varNode
  let some bits := bitsOf varTy | return none
  unless varTy.startsWith "uint" && bits > 0 && bits ≤ 256 do return none
  let body ← mField s "body"
  let bodyStmts ← unwrapLoopBodyStmts body
  let flatStmts ← flattenWhileBodyStmts bodyStmts
  unless flatStmts.size ≥ 1 do return none
  let prefixStmts := flatStmts.extract 0 (flatStmts.size - 1)
  if prefixStmts.any (fun (st, _) => (bodyAssignedIds st).contains varId) then return none
  let lastStmt := flatStmts.back!.1
  unless (← mKind lastStmt) == "ExpressionStatement" do return none
  let stepExpr ← mField lastStmt "expression"
  unless (← mKind stepExpr) == "Assignment" do return none
  let stepOp ← mStr (← mField stepExpr "operator")
  let stepLhs ← mField stepExpr "leftHandSide"
  let stepRhs ← mField stepExpr "rightHandSide"
  unless ← isIdentId stepLhs varId do return none
  let rightShiftOk ←
    if stepOp == ">>=" then isPositiveShiftConst stepRhs
    else if stepOp == "=" then do
      let rhs ← stripUintCast stepRhs bits
      if (← mKind rhs) == "BinaryOperation" && optStr rhs "operator" == some ">>" then
        pure ((← isIdentId (← mField rhs "leftExpression") varId) &&
              (← isPositiveShiftConst (← mField rhs "rightExpression")))
      else pure false
    else pure false
  let clearLowestOk ←
    if stepOp == "&=" then do
      let rhs ← stripUintCast stepRhs bits
      if (← mKind rhs) == "BinaryOperation" && optStr rhs "operator" == some "-" then
        pure ((← isIdentId (← mField rhs "leftExpression") varId) &&
              (← isOneLiteral (← mField rhs "rightExpression")))
      else pure false
    else if stepOp == "=" then isClearLowestBitExpr stepRhs varId bits
    else pure false
  let clearMsbOk ←
    if bits == 256 && flatStmts.size ≥ 2 then do
      let firstStmt := flatStmts[0]!.1
      if (← mKind firstStmt) == "VariableDeclarationStatement" then
        let decls ← mArr (← mField firstStmt "declarations")
        let initVal := field? firstStmt "initialValue" |>.getD Json.null
        if decls.size == 1 && !decls[0]!.isNull && !initVal.isNull then
          let bitDecl := decls[0]!
          let bitId ← mNat (← mField bitDecl "id")
          let bitTy ← mType bitDecl
          if bitTy.startsWith "uint" && !(bodyAssignedIds body).contains bitId &&
              (← isMsbCallOn initVal varId) then
            if stepOp == "&=" then isNotShiftBitExpr stepRhs bitId
            else if stepOp == "=" then isClearBitExpr stepRhs varId bitId bits
            else pure false
          else pure false
        else pure false
      else pure false
    else pure false
  unless rightShiftOk || clearLowestOk || clearMsbOk do return none
  if ← listContainsReturn bodyStmts then
    unless allowReturn do
      failAt s "return inside a while loop is unsupported"
  let condVal ← lowerExpr cond
  unless condVal.pre.isEmpty do
    failAt cond "while loop condition must be a pure scalar comparison"
  let loopVar ← fresh
  let saved ← get
  let bodyOut ← lowerBody body
  let loopWrites := bodyAssignedIds body
  modify fun e =>
    { e with values := saved.values, paths := saved.paths,
             snapshots := saved.snapshots, mems := saved.mems, abiElements := saved.abiElements,
             calldataBytes := saved.calldataBytes, scalarArrays := saved.scalarArrays, byteBuffers := saved.byteBuffers, stringBuffers := saved.stringBuffers, storageBytesVars := saved.storageBytesVars, storageDynamicArrayVars := saved.storageDynamicArrayVars, flatStructs := saved.flatStructs, scalarTy := saved.scalarTy,
