  let body ← mField s "body"
  let bodyStmts ← unwrapLoopBodyStmts body
  let bodyWrites := bodyAssignedIds body
  let bodyUnchecked ← loopBodyUsesUnchecked body
  let flatStmts ← flattenWhileBodyStmts bodyStmts bodyUnchecked
