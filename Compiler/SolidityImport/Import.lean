                    vals := vals.push finalExpr
                  for i in [:results.size] do
                    let (binding, _, _) := results[i]!
                    pre := pre.push (.assignVar binding (vals.getD i (.literal 0)))
                  pure (pre.push (.assignVar retFlag (.literal 1)))
                else
                  failAt expression "multi-return helper return inside a loop requires a tuple expression"
              else if expression.isNull then
                -- A void helper's bare `return;` only sets the loop's return flag.
                pure #[.assignVar retFlag (.literal 1)]
              else
                failAt statement "void helper cannot return a value"
            else if expression.isNull then
              if let some (retBinding, _) := (← get).helperResult then
                pure #[.assignVar retVal (.localVar retBinding), .assignVar retFlag (.literal 1)]
              else
                failAt statement "bare helper returns are unsupported"
            else
              unless retVal != "" do
                failAt statement "void helper cannot return a value"
              let v ← lowerConverted ((← returnTargetType? statement).getD (← mType expression)) expression
              pure (v.pre ++ #[.assignVar retVal v.expr, .assignVar retFlag (.literal 1)])
        | "Break" | "Continue" => lowerLoopExit statement
        | "ForStatement" =>
            if ← stmtContainsReturn statement then
              let cond := (field? statement "condition").getD .null
              let op := optStr cond "operator"
              unless op == some "<" || op == some ">" do
                failAt statement "return in a helper for loop requires a bounded `<` or `>` loop"
              lowerHelperLoop statement (lowerHelperLoopBodyWithReturn retFlag retVal) (some retFlag)
            else
              lowerHelperLoop statement lowerHelperLoopBody
        | "WhileStatement" =>
            if ← stmtContainsReturn statement then
              lowerHelperLoop statement (lowerHelperLoopBodyWithReturn retFlag retVal) (some retFlag)
            else
              lowerHelperLoop statement lowerHelperLoopBody
        | kind => failAt statement s!"unsupported helper loop statement {kind}"
      if rest.isEmpty then
        pure stmtOut
      else
        let restOut ← guardAfterLoopExit statement
          (← lowerHelperLoopStmtsWithReturn retFlag retVal rest)
        if ← stmtContainsReturn statement then
          pure (stmtOut.push (.ite (.eq (.localVar retFlag) (.literal 0)) restOut.toList []))
        else
          pure (stmtOut ++ restOut)

private partial def lowerHelperLoopBodyWithReturn (retFlag retVal : String) (body : Json) : M (Array Stmt) := do
  let statements ← if (← mKind body) == "Block" then mArr (← mField body "statements") else pure #[body]
  lowerHelperLoopStmtsWithReturn retFlag retVal statements.toList

/-- Lowers helper statements to a prelude and, when the list returns, its
    result. A returning `if` branch ends the list; the continuation after the
    `if` is lowered once, inside the branch that falls through. -/
private partial def lowerHelperFrom (stmts : List Json) (retName : String) :
    M (Array Stmt × Option Expr) := do
  match stmts with
  | [] =>
      pure (#[], (← get).helperResult.map fun (binding, _) => Expr.localVar binding)
  | s :: rest =>
    match ← mKind s with
    | "Block" | "UncheckedBlock" =>
        let isUnchecked := (← mKind s) == "UncheckedBlock"
        let saved ← get
        let restore : M Unit := modify fun e =>
          { e with values := saved.values, writableLocals := saved.writableLocals, fnPtrs := saved.fnPtrs, paths := saved.paths,
                   snapshots := saved.snapshots, mems := saved.mems, abiElements := saved.abiElements, calldataBytes := saved.calldataBytes, scalarArrays := saved.scalarArrays, byteBuffers := saved.byteBuffers, stringBuffers := saved.stringBuffers, storageBytesVars := saved.storageBytesVars, storageDynamicArrayVars := saved.storageDynamicArrayVars, flatStructs := saved.flatStructs,
                   scalarTy := saved.scalarTy, yulNames := saved.yulNames, yulMemoryArrays := saved.yulMemoryArrays, yulMemoryStructs := saved.yulMemoryStructs, unchecked := saved.unchecked }
        if isUnchecked then
          modify fun e => { e with unchecked := true }
        let blockStmts ← mArr (← mField s "statements")
        let blockReturns ← helperListReturns blockStmts
        if blockReturns then
          if let some next := rest.head? then failAt next "statement after helper result"
          let (inner, res) ← lowerHelperFrom blockStmts.toList retName
          restore
          pure (inner, res)
        else if ← listContainsReturn blockStmts then
          unless isUnchecked do
            failAt s "partial return inside a helper block is outside this slice"
          -- Flattening keeps the block's declarations visible to the continuation
          -- lowering. Their ids are out of Solidity scope after the block, but Yul
          -- resolves identifiers by name: the end marker restores the name-keyed
          -- scope from the block's start, as the `restore` of a nested block does.
          let scope := (← get).helperBlockScopes.size
          let blockScope := (saved.yulNames, saved.yulMemoryArrays, saved.yulMemoryStructs)
          modify fun e => { e with helperBlockScopes := e.helperBlockScopes.push blockScope }
          lowerHelperFrom (blockStmts.toList ++ uncheckedEnd scope :: rest) retName
        else
          let (inner, _) ← lowerHelperFrom blockStmts.toList retName
          restore
          let (tail, res) ← lowerHelperFrom rest retName
          pure (inner ++ tail, res)
    | "VerityUncheckedEnd" =>
        -- `unchecked` blocks cannot nest; restore the compiler default and the
        -- block's name-keyed scope.
        let some (yulNames, yulMemoryArrays, yulMemoryStructs) :=
            (← get).helperBlockScopes[(← mNat (← mField s "scope"))]?
          | failAt s "unchecked helper block end without a recorded scope"
        modify fun e => { e with unchecked := e.legacyWrapping, yulNames, yulMemoryArrays, yulMemoryStructs }
        lowerHelperFrom rest retName
    | "VerityScopeEnd" =>
        -- The branch's declarations go out of scope; Yul resolves identifiers by name.
        restoreScopeEnd s
        lowerHelperFrom rest retName
    | "VariableDeclarationStatement" =>
        let pre ← lowerLocal s
        let (tail, result) ← lowerHelperFrom rest retName
        pure (pre ++ tail, result)
    | "ExpressionStatement" =>
        -- Use the same exact assignment/delete and require rules as root bodies.
        -- The helper continuation still resumes only after these effects.
        let pre ← lowerEffect s
        if ← stmtAlwaysReverts [] s then
          if let some next := rest.head? then failAt next "statement after helper revert"
          pure (pre, some ((← get).helperResult.map (fun (b, _) => Expr.localVar b) |>.getD (.literal 0)))
        else
          let (tail, result) ← lowerHelperFrom rest retName
          pure (pre ++ tail, result)
    | "EmitStatement" =>
        -- Preserve helper events before its scalar-result continuation.
        let emitted ← lowerEmit s
        let (tail, result) ← lowerHelperFrom rest retName
        pure (emitted ++ tail, result)
    | "RevertStatement" =>
        if let some next := rest.head? then failAt next "statement after helper revert"
        let revStmts ← lowerRevert s
        pure (revStmts, some ((← get).helperResult.map (fun (b, _) => Expr.localVar b) |>.getD (.literal 0)))
    | "ForStatement" =>
        if ← stmtContainsReturn s then
          -- Early `return` from a helper `for`: the return sets `retFlag`, which guards
          -- the rest of its iteration, stops `Stmt.forEachWhile` before the next
          -- iteration, and skips the post-loop continuation.
          let cond := (field? s "condition").getD .null
          let op := optStr cond "operator"
          unless op == some "<" || op == some ">" do
            failAt s "return in a helper for loop requires a bounded `<` or `>` loop"
          let retFlag ← fresh
          let retVal ← fresh
          let loopPre ← lowerHelperLoop s (lowerHelperLoopBodyWithReturn retFlag retVal) (some retFlag)
          let (tail, result) ← lowerHelperFrom rest retName
          let some tailExpr := result
            | failAt s "inlined helper does not return on every path"
          let tailBranch := tail.push (.assignVar retVal tailExpr)
          let stmts := #[.letVar retFlag (.literal 0), .letVar retVal (.literal 0)] ++
            loopPre ++ #[.ite (.eq (.localVar retFlag) (.literal 0)) tailBranch.toList []]
          pure (stmts, some (.localVar retVal))
        else
          let pre ← lowerHelperLoop s lowerHelperLoopBody
          let (tail, result) ← lowerHelperFrom rest retName
          pure (pre ++ tail, result)
    | "WhileStatement" =>
        if ← stmtContainsReturn s then
          -- Early `return` from a helper `while`: same flag machinery as `for`;
          -- `lowerHelperLoop` / `lowerWhile` require a proven uint256 iteration bound.
          let retFlag ← fresh
          let retVal ← fresh
          let loopPre ← lowerHelperLoop s (lowerHelperLoopBodyWithReturn retFlag retVal) (some retFlag)
          let (tail, result) ← lowerHelperFrom rest retName
          let some tailExpr := result
            | failAt s "inlined helper does not return on every path"
          let tailBranch := tail.push (.assignVar retVal tailExpr)
          let stmts := #[.letVar retFlag (.literal 0), .letVar retVal (.literal 0)] ++
            loopPre ++ #[.ite (.eq (.localVar retFlag) (.literal 0)) tailBranch.toList []]
          pure (stmts, some (.localVar retVal))
        else
          let wPre ← lowerHelperLoop s lowerHelperLoopBody
          let (tail, result) ← lowerHelperFrom rest retName
          pure (wPre ++ tail, result)
    | "Return" =>
        if let some next := rest.head? then failAt next "statement after helper result"
        let expression := field? s "expression" |>.getD Json.null
        if expression.isNull then
          if let some (retBinding, _) := (← get).helperResult then
            pure (#[], some (.localVar retBinding))
          else
            failAt s "bare helper returns are unsupported"
        else if let some (ptrBinding, ty) := (← get).helperResult then
          if ty == namedBytesResultMarker then
            let buf ← lowerEncodedBytes expression
            let sizeBinding := (← get).helperBytesSize
            pure (buf.pre ++ #[.assignVar ptrBinding buf.pointer, .assignVar sizeBinding buf.size],
              some (.localVar ptrBinding))
          else if ty == bytesStructResultMarker then
            let (valPre, structPtr) ← lowerBytesStructPointer expression (← get).helperStructSid
            pure (valPre.push (.assignVar ptrBinding structPtr), some (.localVar ptrBinding))
          else
            let v ← lowerConverted ((← returnTargetType? s).getD (← mType expression)) expression
            pure (v.pre, some v.expr)
        else
          let v ← lowerConverted ((← returnTargetType? s).getD (← mType expression)) expression
          pure (v.pre, some v.expr)
    | "InlineAssembly" =>
        if let some (_, ty) := (← get).helperResult then
          if isPointerResultMarker ty then
            failAt s "inline assembly in a helper with a bytes memory or bytes-member struct result is unsupported"
        let isSingleRetAssign ← do
          let ast ← mField s "AST"
          if (← mKind ast) == "YulBlock" then
            let ystmts ← mArr (← mField ast "statements")
            if ystmts.size == 1 then
              if (← mKind ystmts[0]!) == "YulAssignment" then
                let vars ← mArr (← mField ystmts[0]! "variableNames")
                if vars.size == 1 then
                  let vname ← mStr (← mField vars[0]! "name")
                  pure (retName != "" && vname == retName)
                else pure false
              else pure false
            else pure false
          else pure false
        if isSingleRetAssign then
          if let some (binding, ty) := (← get).helperResult then
            if ty.startsWith "enum " then
              failAt s "Yul assignment to an enum result is unsupported"
            let savedAsmYul := (← get).yulNames
            let extPre ← bindYulExternalConstants s
            let v ← lowerAssembly s retName
            modify fun e => { e with yulNames := savedAsmYul }
            let (tail, result) ← lowerHelperFrom rest retName
            pure ((extPre ++ v.pre).push (.assignVar binding v.expr) ++ tail, result)
          else
            if let some next := rest.head? then failAt next "statement after helper result"
            let savedAsmYul := (← get).yulNames
            let extPre ← bindYulExternalConstants s
            let v ← lowerAssembly s retName
            modify fun e => { e with yulNames := savedAsmYul }
            pure (extPre ++ v.pre, some v.expr)
        else if (← get).helperResult.isSome || !rest.isEmpty then
          if let some (_, ty) := (← get).helperResult then
            if ty.startsWith "enum " then
              failAt s "Yul assignment to an enum result is unsupported"
          let savedAsmYul := (← get).yulNames
          let extPre ← bindYulExternalConstants s
          let asmStmts ← lowerAssemblyStmts s retName
          modify fun e => { e with yulNames := savedAsmYul }
          let (tail, result) ← lowerHelperFrom rest retName
          pure (extPre ++ asmStmts ++ tail, result)
        else
          if let some next := rest.head? then failAt next "statement after helper result"
          let savedAsmYul := (← get).yulNames
          let extPre ← bindYulExternalConstants s
          let v ← lowerAssembly s retName
          modify fun e => { e with yulNames := savedAsmYul }
          pure (extPre ++ v.pre, some v.expr)
    | "IfStatement" =>
        let (condition, yes, no) ← ifParts s
        let yesReturns ← helperListReturns yes
        let noReturns ← helperListReturns no
        if yesReturns && noReturns then
          if let some next := rest.head? then failAt next "statement after helper result"
        let saved ← get
        let restore : M Unit := modify fun e =>
          { e with values := saved.values, writableLocals := saved.writableLocals, fnPtrs := saved.fnPtrs, paths := saved.paths, snapshots := saved.snapshots, mems := saved.mems, abiElements := saved.abiElements, calldataBytes := saved.calldataBytes, scalarArrays := saved.scalarArrays, byteBuffers := saved.byteBuffers, stringBuffers := saved.stringBuffers, storageBytesVars := saved.storageBytesVars, storageDynamicArrayVars := saved.storageDynamicArrayVars, flatStructs := saved.flatStructs,
                   scalarTy := saved.scalarTy, yulNames := saved.yulNames, yulMemoryArrays := saved.yulMemoryArrays, yulMemoryStructs := saved.yulMemoryStructs,
                   unchecked := saved.unchecked }
        let restReturns ← helperListReturns rest.toArray
        let yesHasReturn ← listContainsReturn yes
        let noHasReturn ← listContainsReturn no
        if ((!yesReturns && !noReturns) || (!rest.isEmpty && !restReturns)) && !yesHasReturn && !noHasReturn then
          -- Neither branch returns: branch-local declarations stay scoped and
          -- the continuation is lowered once after the conditional.
          let (yesPre, _) ← lowerHelperFrom yes.toList retName
          restore
          let (noPre, _) ← lowerHelperFrom no.toList retName
          restore
          let (tail, result) ← lowerHelperFrom rest retName
          pure (condition.pre.push (.ite condition.expr yesPre.toList noPre.toList) ++ tail, result)
        else
          -- The continuation is lowered inside each branch that falls through. That
          -- branch's declarations keep their ids out of Solidity scope, but Yul resolves
          -- identifiers by name: the branch end restores the name-keyed scope of the `if`.
          let branchEnd ← pushScopeEnd s
          let yesList := if yesReturns then yes.toList else yes.toList ++ branchEnd :: rest
          let noList := if noReturns then no.toList else no.toList ++ branchEnd :: rest
          let (yesPre, yesResult) ← lowerHelperFrom yesList retName
          restore
          let (noPre, noResult) ← lowerHelperFrom noList retName
          restore
          let dest ← fresh
          let assign (pre : Array Stmt) (result : Option Expr) : Array Stmt :=
            match result with
            | some expr => pre.push (.assignVar dest expr)
            | none => pre
          let branch := Stmt.ite condition.expr (assign yesPre yesResult).toList
            (assign noPre noResult).toList
          match yesResult, noResult with
          | some _, some _ =>
              pure (condition.pre.push (.letVar dest (.literal 0)) |>.push branch,
                some (.localVar dest))
          | _, _ => failAt s "inlined helper does not return on every path"
    | kind => failAt s s!"unsupported helper statement {kind}"

/-- `try this.f(args...)` is an external CALL to this contract: `f` runs in a new frame
whose storage writes and logs persist on success and roll back on failure, its return
data is decoded for a `returns (...)` clause, and each `catch` clause selects on the
revert data. No lowering models that, so the self-call form rejects in every contract,
located at the `try` statement (named arguments at the call). Other `try` forms are
left to `lowerInterfaceTryCall?`. -/
private partial def rejectThisTryCall (s : Json) : M Unit := do
  unless (← mKind s) == "TryStatement" do return
  let extCall ← mField s "externalCall"
  unless (← mKind extCall) == "FunctionCall" && optStr extCall "kind" == some "functionCall" do
    return
  let callee ← mField extCall "expression"
  unless (← mKind callee) == "MemberAccess" do return
  let base ← mField callee "expression"
  unless (← mKind base) == "Identifier" && optStr base "name" == some "this" do return
  if (← get).forwardingBytesTuple then
    failAt s "try/catch in a forwarded tuple requires call-success semantics"
  unless (← mArr (← mField extCall "names")).isEmpty do
    failAt extCall "named arguments in a try self-call are unsupported"
  failAt s "try/catch of an external self-call `this.f(...)` requires call semantics and is outside this slice"

/-- `try I(a).f(args...) [returns (T v)] { A } catch [(bytes memory reason)] { B }` of an
interface member, with one catch clause that is either catch-all or binds the complete
revert data. solc 0.8.34 (via-IR) evaluates the receiver and arguments and issues the same
call as the statement form (`lowerInterfaceCallStatus`, `staticcall` for a `view` or `pure`
function). A function without return values first reverts with no data when
`extcodesize(a)` is zero; with a return value the check is omitted. A failed call, whose
own effects the EVM rolls back, runs `B`, with `reason` bound to the complete revert data
as solc's `extract_returndata` does. A successful call of a function without return values
runs `A` whatever its return data. A successful call of a function with one return value
`T` decodes the first return word before `A`, whether or not the clause names it: fewer
than 32 bytes of return data, or a word outside `T`, revert with no data in the caller
(not caught), as solc's ABI decoder does; extra bytes are ignored; `v`, when named, is
bound to the word. `catch Error(...)`, `catch Panic(...)`, several catch clauses, several
return values or other return types, call options and named arguments reject. Returns
`none` when the statement is not an external try of an interface member
(`isInterfaceExternalCall`). -/
private partial def lowerInterfaceTryCall? (s : Json) : M (Option TryParts) := do
  unless (← mKind s) == "TryStatement" do return none
  let extCall ← mField s "externalCall"
  unless (← mKind extCall) == "FunctionCall" && optStr extCall "kind" == some "functionCall" do
    return none
  let callee ← mField extCall "expression"
  unless (← mKind callee) == "MemberAccess" do return none
  let base ← mField callee "expression"
  if (← mKind base) == "Identifier" &&
      (optStr base "name" == some "this" || optStr base "name" == some "super") then
    return none
  -- The receivers and members the statement form admits (`isInterfaceExternalCall`).
  unless ← isInterfaceExternalCall extCall do return none
  if (← get).forwardingBytesTuple then
    failAt s "try/catch in a forwarded tuple requires call-success semantics"
  unless (← mArr (← mField extCall "names")).isEmpty do
    failAt extCall "named arguments in an external try call are unsupported"
  let clauses ← mArr (← mField s "clauses")
  let clauseParams (clause : Json) : M (Array Json) := do
    match field? clause "parameters" with
    | some j => if j.isNull then pure #[] else mArr (← mField j "parameters")
    | none => pure #[]
  let #[yes, no] := clauses | failAt s tryCatchClauseMessage
  unless optStr no "errorName" == some "" do failAt s tryCatchClauseMessage
  let reasons ← clauseParams no
  unless reasons.size ≤ 1 && reasons.all (!·.isNull) do
    failAt no "a catch clause binds at most the bytes memory revert data"
  let noSetup : M (Array Stmt) := match reasons[0]? with
    | some reason => bindReturndataLocal reason
    | none => pure #[]
  let results ← clauseParams yes
  let yesStmts ← mArr (← mField (← mField yes "block") "statements")
  let noStmts ← mArr (← mField (← mField no "block") "statements")
  if let some decl ← interfaceVoidCallDecl? extCall then
    unless results.isEmpty do
      failAt yes "the success clause of a function without return values declares no results"
    let (pre, success) ← lowerInterfaceVoidCallStatus extCall decl
    return some { condition := { pre, expr := .localVar success }, yes := yesStmts, no := noStmts,
                  noSetup }
  let id ← refInt callee
  let some decl := (← get).funs.find? id.toNat
    | failAt s "external try/catch of a public state variable getter is unsupported"
  let returns ← mArr (← mField (← mField decl "returnParameters") "parameters")
  let #[returned] := returns
    | failAt s "external try/catch of a function with several return values is unsupported"
  let returnType ← mType returned
  unless tryReturnTypeSupported returnType do
    failAt s s!"external try/catch of a function returning {returnType} is unsupported"
  unless results.size ≤ 1 && results.all (!·.isNull) do
    failAt yes "the success clause binds at most the single return value"
  if let some result := results[0]? then
    unless (← mType result) == returnType do
      failAt result "the success clause result must have the declared return type"
  let mutability := optStr decl "stateMutability"
  let isStatic := mutability == some "view" || mutability == some "pure"
  let (pre, success, buffer) ← lowerInterfaceCallStatus extCall decl false isStatic
  let yesSetup : M (Array Stmt) := do
    let word ← fresh
    let decode : Array Stmt := #[
      .ite (.lt .returndataSize (.literal 32)) [.revertEmpty] [],
      .returndataCopy (.localVar buffer) (.literal 0) (.literal 32),
      .letVar word (.mload (.localVar buffer))] ++
      (abiDecodeScalarGuard? returnType none (.localVar word)).toList.toArray
    match results[0]? with
    | some result => return decode ++ (← bindScalarLocal result (.localVar word))
    | none => return decode
  return some { condition := { pre, expr := .localVar success }, yes := yesStmts, no := noStmts,
                yesSetup, noSetup }

private partial def voidHelperReturns (s : Json) : M Bool := do
  match ← mKind s with
  | "Return" | "RevertStatement" => pure true
  | "Block" | "UncheckedBlock" => ((← mArr (← mField s "statements")).back?.map voidHelperReturns).getD (pure false)
  | "IfStatement" =>
      let yes ← voidHelperReturns (← mField s "trueBody")
      let no ← match field? s "falseBody" with
        | some j => if j.isNull then pure false else voidHelperReturns j
        | none => pure false
      pure (yes && no)
  | _ => stmtAlwaysReverts [] s

private partial def stmtContainsReturn (s : Json) : M Bool := do
  match ← mKind s with
  | "Return" => pure true
  | "Block" | "UncheckedBlock" =>
      let stmts ← mArr (← mField s "statements")
      stmts.anyM stmtContainsReturn
  | "ForStatement" | "WhileStatement" =>
      stmtContainsReturn (← mField s "body")
  | "IfStatement" =>
      let yes ← stmtContainsReturn (← mField s "trueBody")
      let no ← match field? s "falseBody" with
        | some j => if j.isNull then pure false else stmtContainsReturn j
        | none => pure false
      pure (yes || no)
  | "TryStatement" =>
      let clauses ← mArr (← mField s "clauses")
      clauses.anyM fun cl => do
        match field? cl "block" with
        | some j => if j.isNull then pure false else stmtContainsReturn j
        | none => pure false
  | _ => pure false

private partial def listContainsReturn (stmts : Array Json) : M Bool :=
  stmts.anyM stmtContainsReturn

/-- A helper inlining with no result to assign: a bare `return;` just ends the helper. -/
private partial def plainVoidHelperContext : M Bool := do
  let e ← get
  pure (e.helperResult.isNone && e.multiHelperResults.isNone && e.flatStructHelperResult.isNone &&
    e.fixedArrayHelperResult.isNone && e.dynArrayHelperResult.isNone)

private partial def lowerVoidHelperFrom (stmts : List Json) (k : M (Array Stmt)) : M (Array Stmt) := do
  match stmts with
  | [] => k
  | s :: rest =>
    let kRest : M (Array Stmt) := lowerVoidHelperFrom rest k
    match ← mKind s with
    | "Block" | "UncheckedBlock" =>
        let isUnchecked := (← mKind s) == "UncheckedBlock"
        let saved ← get
        let restore : M Unit := modify fun e =>
          { e with values := saved.values, writableLocals := saved.writableLocals, fnPtrs := saved.fnPtrs, paths := saved.paths,
                   snapshots := saved.snapshots, mems := saved.mems, abiElements := saved.abiElements, calldataBytes := saved.calldataBytes, scalarArrays := saved.scalarArrays, byteBuffers := saved.byteBuffers, stringBuffers := saved.stringBuffers, storageBytesVars := saved.storageBytesVars, storageDynamicArrayVars := saved.storageDynamicArrayVars, flatStructs := saved.flatStructs,
                   scalarTy := saved.scalarTy, yulNames := saved.yulNames, yulMemoryArrays := saved.yulMemoryArrays, yulMemoryStructs := saved.yulMemoryStructs, unchecked := saved.unchecked }
        if isUnchecked then
          modify fun e => { e with unchecked := true }
        let blockStmts ← mArr (← mField s "statements")
        if ← voidHelperReturns s then
          if let some next := rest.head? then failAt next "statement after void helper return"
        if ← listContainsReturn blockStmts then
          lowerVoidHelperFrom blockStmts.toList (do restore; kRest)
        else
          let inner ← lowerVoidHelperFrom blockStmts.toList (pure #[])
          restore
          let tailStmts ← kRest
          pure (inner ++ tailStmts)
    | "VariableDeclarationStatement" =>
        if let some (callStmts, consumed) ← lowerLowLevelCallSequence? s rest then
          let tailStmts ← lowerVoidHelperFrom (rest.drop consumed) k
          return callStmts ++ tailStmts
        let localStmts ← lowerLocal s
        let tailStmts ← kRest
        pure (localStmts ++ tailStmts)
    | "ExpressionStatement" =>
        if ← stmtAlwaysReverts [] s then
          if let some next := rest.head? then failAt next "statement after void helper revert"
          return ← lowerEffect s
        let effStmts ← lowerEffect s
        let tailStmts ← kRest
        pure (effStmts ++ tailStmts)
    | "EmitStatement" =>
        let emitStmts ← lowerEmit s
        let tailStmts ← kRest
        pure (emitStmts ++ tailStmts)
    | "RevertStatement" =>
        if let some next := rest.head? then failAt next "statement after void helper revert"
        lowerRevert s
    | "InlineAssembly" =>
        let savedAsmYul := (← get).yulNames
        let extPre ← bindYulExternalConstants s
        let asmStmts ← lowerAssemblyStmts s ""
        modify fun e => { e with yulNames := savedAsmYul }
        let tailStmts ← kRest
        pure (extPre ++ asmStmts ++ tailStmts)
    | "ForStatement" =>
        if (← stmtContainsReturn s) && ((← plainVoidHelperContext) || (← get).multiHelperResults.isSome) then
          let cond := (field? s "condition").getD .null
          let op := optStr cond "operator"
          unless op == some "<" || op == some ">" do
            failAt s "return in a helper for loop requires a bounded `<` or `>` loop"
          if !(← get).helperPost.isEmpty && (← listContainsReturn rest.toArray) then
            failAt s "a return after a returning helper loop is outside this slice"
          let retFlag ← fresh
          let loopPre ← lowerHelperLoop s (lowerHelperLoopBodyWithReturn retFlag "") (some retFlag)
          let restStmts ← lowerVoidHelperFrom rest (pure #[])
          let tailStmts ← k
          pure (#[.letVar retFlag (.literal 0)] ++ loopPre ++
            #[.ite (.eq (.localVar retFlag) (.literal 0)) restStmts.toList []] ++ tailStmts)
        else
          let loopStmts ← lowerHelperLoop s lowerHelperLoopBody
          let tailStmts ← kRest
          pure (loopStmts ++ tailStmts)
    | "WhileStatement" =>
        if (← stmtContainsReturn s) && ((← plainVoidHelperContext) || (← get).multiHelperResults.isSome) then
          if !(← get).helperPost.isEmpty && (← listContainsReturn rest.toArray) then
            failAt s "a return after a returning helper loop is outside this slice"
          let retFlag ← fresh
          let loopPre ← lowerHelperLoop s (lowerHelperLoopBodyWithReturn retFlag "") (some retFlag)
          let restStmts ← lowerVoidHelperFrom rest (pure #[])
          let tailStmts ← k
          pure (#[.letVar retFlag (.literal 0)] ++ loopPre ++
            #[.ite (.eq (.localVar retFlag) (.literal 0)) restStmts.toList []] ++ tailStmts)
        else
          let loopStmts ← lowerHelperLoop s lowerHelperLoopBody
          let tailStmts ← kRest
          pure (loopStmts ++ tailStmts)
    | "Return" =>
        if let some next := rest.head? then failAt next "statement after void helper return"
        let expression := field? s "expression" |>.getD Json.null
        if let some results := (← get).multiHelperResults then
          if expression.isNull then
            unless results.all (fun (_, _, isNamed) => isNamed) do
              failAt s "bare multi-return helper return requires named return parameters"
            pure (← get).helperPost
          else if (← mKind expression) == "TupleExpression" then
            unless !(← mBool (← mField expression "isInlineArray")) do
              failAt expression "multi-return helper return requires a tuple expression"
            let cs ← mArr (← mField expression "components")
            let mut pre : Array Stmt := #[]
            let mut vals : Array Expr := #[]
            let mut resIdx : Nat := 0
            let mut structRefs : Array Nat := #[]
            for i in [:cs.size] do
              let c := cs[i]!
              if c.isNull then failAt expression "empty return component"
              if cs.size > 1 && (statefulCallIn c (← get) || assignmentIn c) then
                failAt c "stateful or assignment expression in multi-return tuple requires explicit evaluation-order support"
              let cTy ← mType c
              if cTy.startsWith "struct " && !cTy.contains "[" then
                let refs ← structValueRefIds c
                if refs.any structRefs.contains then
                  failAt c "returning one memory struct in two tuple components (an alias) is outside this slice"
                structRefs := structRefs ++ refs
                if ← refersToByRefStruct c then
                  failAt c "returning a memory struct parameter (an alias) is outside this slice"
                if ← refersToMemoryStructElement c then
                  failAt c "returning a memory struct array element (an alias) is outside this slice"
                let (_, _, valPre, memberVals) ← lowerFlatStructValue c none true
                pre := pre ++ valPre
                for (_, _, mExpr) in memberVals do
                  let finalExpr ← match mExpr with
                    | .localVar name => do
                        if (← get).writableLocals.toList.any (fun (_, b) => b == name) then
                          let snap ← fresh
                          pre := pre.push (.letVar snap (.localVar name))
                          pure (.localVar snap)
                        else
                          pure mExpr
                    | _ => pure mExpr
                  vals := vals.push finalExpr
                  resIdx := resIdx + 1
              else
                unless resIdx < results.size do
                  failAt expression s!"multi-return helper return arity {cs.size} does not match {results.size}"
                let (_, rty, _) := results[resIdx]!
                if rty == "bytes" || rty == "string" then
                  -- One buffer per tuple position: the pointer and length are
                  -- captured here, in component order, into fresh bindings.
                  unless resIdx + 1 < results.size do
                    failAt expression s!"multi-return helper return arity {cs.size} does not match {results.size}"
                  let buf ← lowerEncodedBytes c
                  let ptrSnap ← fresh
                  let sizeSnap ← fresh
                  pre := pre ++ buf.pre ++ #[.letVar ptrSnap buf.pointer, .letVar sizeSnap buf.size]
                  vals := vals.push (.localVar ptrSnap) |>.push (.localVar sizeSnap)
                  resIdx := resIdx + 2
                  continue
                let v ← if (fixedMemArrayType? rty).isSome then do
                    let (arrPre, arr) ← lowerFixedMemArrayValue c
                    let snap ← fresh
                    pure ({ pre := arrPre.push (.letVar snap (.localVar arr.pointer)), expr := .localVar snap } : Val)
                  else if (scalarArrayElement? rty).isSome then do
                    let some (elemStr, _, _) := scalarArrayElement? rty | failAt c "unsupported array result"
                    let (arrPre, arr) ← lowerDynArrayValue c elemStr
                    let snap ← fresh
                    pure ({ pre := arrPre.push (.letVar snap (.localVar arr.memoryPointer)), expr := .localVar snap } : Val)
                  else atom (← convert rty cTy (← lowerExpr c) c)
                pre := pre ++ v.pre
                let finalExpr ← match v.expr with
                  | .localVar name => do
                      if (← get).writableLocals.toList.any (fun (_, b) => b == name) then
                        let snap ← fresh
                        pre := pre.push (.letVar snap (.localVar name))
                        pure (.localVar snap)
                      else
                        pure v.expr
                  | _ => pure v.expr
                vals := vals.push finalExpr
                resIdx := resIdx + 1
            unless resIdx == results.size do
              failAt expression s!"multi-return helper return arity {cs.size} does not match {results.size}"
            for i in [:results.size] do
              let (binding, _, _) := results[i]!
              pre := pre.push (.assignVar binding (vals.getD i (.literal 0)))
            pure (pre ++ (← get).helperPost)
          else
            -- A buffer's two slots carry raw words (no conversion); their types
            -- are checked against the result positions below.
            -- Every (pointer, rty) slot is immediately followed by its
            -- (size, uint256) slot, so the slot after a pointer is a size.
            let isBufferSlot : Nat → Bool := fun i =>
              let rty := (results.getD i ("", "", false)).2.1
              let prevTy := if i == 0 then "" else (results.getD (i - 1) ("", "", false)).2.1
              rty == "bytes" || rty == "string" || prevTy == "bytes" || prevTy == "string"
            let expectedTypes := (List.range results.size).toArray.map fun i =>
              if isBufferSlot i then none else some (results.getD i ("", "", false)).2.1
            let (branchPre, retExprs) ← lowerMultiBranch expression (some expectedTypes)
            unless retExprs.size == results.size do
              failAt expression s!"multi-return helper return arity {retExprs.size} does not match {results.size}"
            for i in [:results.size] do
              if isBufferSlot i then
                unless (retExprs.getD i (.literal 0, "")).2 == (results.getD i ("", "", false)).2.1 do
                  failAt expression "returned tuple string/bytes positions do not match the helper results"
            let mut pre := branchPre
            for i in [:results.size] do
              let (binding, _, _) := results[i]!
              let (valExpr, _) := retExprs.getD i (.literal 0, "")
              pre := pre.push (.assignVar binding valExpr)
            pure (pre ++ (← get).helperPost)
        else if let some (retSid, _, memberBindings, isNamed) := (← get).flatStructHelperResult then
          if expression.isNull then
            unless isNamed do
              failAt s "bare struct helper return requires a named return parameter"
            pure (← get).helperPost
          else
            let isSameNamedRet ← if isNamed && (← mKind expression) == "Identifier" then do
              let refId ← refInt expression
              if refId ≥ 0 then
                if let some flat := (← get).flatStructs.find? refId.toNat then
                  pure (flat.members == memberBindings)
                else pure false
              else pure false
            else pure false
            if isSameNamedRet then
              pure (← get).helperPost
            else
              if ← refersToByRefStruct expression then
                failAt expression "returning a memory struct parameter (an alias) is outside this slice"
              if ← refersToMemoryStructElement expression then
                failAt expression "returning a memory struct array element (an alias) is outside this slice"
              let (exprSid, _, valPre, memberVals) ← lowerFlatStructValue expression (some retSid) true
              unless exprSid == retSid && memberVals.size == memberBindings.size do
                failAt expression "returned struct value does not match helper return type"
              let mut pre := valPre
              for ((bName, _, binding), (vName, _, vExpr)) in memberBindings.zip memberVals do
                unless bName == vName do
                  failAt expression "returned struct member layout mismatch"
                pre := pre.push (.assignVar binding vExpr)
              pure (pre ++ (← get).helperPost)
        else if let some result := (← get).fixedArrayHelperResult then
          if expression.isNull then
            pure (← get).helperPost
          else
            let (valPre, value) ← lowerFixedMemArrayValue expression
            pure ((valPre.push (.assignVar result.pointer (.localVar value.pointer))) ++ (← get).helperPost)
        else if let some result := (← get).dynArrayHelperResult then
          if expression.isNull then
            pure (← get).helperPost
          else
            let (valPre, value) ← lowerDynArrayValue expression result.elementType
            pure (valPre ++ #[.assignVar result.memoryPointer (.localVar value.memoryPointer),
              .assignVar result.lengthBinding (.localVar value.lengthBinding)] ++ (← get).helperPost)
        else
          unless expression.isNull do failAt s "void helper cannot return a value"
          pure (← get).helperPost
    | "IfStatement" | "TryStatement" =>
        let parts ←
          if (← mKind s) == "IfStatement" then do
            let (condition, yes, no) ← ifParts s
            pure ({ condition, yes, no } : TryParts)
          else do
            let some parts ← (do
                rejectThisTryCall s
                lowerInterfaceTryCall? s)
              | failAt s "unsupported void helper statement TryStatement"
            pure parts
        let condition := parts.condition
        let yes := parts.yes
        let no := parts.no
        let yesAll ← match yes.back? with | some b => voidHelperReturns b | none => pure false
        let noAll ← match no.back? with | some b => voidHelperReturns b | none => pure false
        if yesAll && noAll then
          if let some next := rest.head? then failAt next "statement after void helper return"
        let yesAny ← listContainsReturn yes
        let noAny ← listContainsReturn no
        let saved ← get
        let restore : M Unit := modify fun e =>
          { e with values := saved.values, writableLocals := saved.writableLocals, fnPtrs := saved.fnPtrs, paths := saved.paths,
                   snapshots := saved.snapshots, mems := saved.mems, abiElements := saved.abiElements, calldataBytes := saved.calldataBytes, scalarArrays := saved.scalarArrays, byteBuffers := saved.byteBuffers, stringBuffers := saved.stringBuffers, storageBytesVars := saved.storageBytesVars, storageDynamicArrayVars := saved.storageDynamicArrayVars, flatStructs := saved.flatStructs,
                   scalarTy := saved.scalarTy, yulNames := saved.yulNames, yulMemoryArrays := saved.yulMemoryArrays, yulMemoryStructs := saved.yulMemoryStructs }
        if !yesAny && !noAny then
          let yesSetup ← parts.yesSetup
          let yesStmts ← lowerVoidHelperFrom yes.toList (pure #[])
          restore
          let noSetup ← parts.noSetup
          let noStmts ← lowerVoidHelperFrom no.toList (pure #[])
          restore
          let tailStmts ← kRest
          pure (condition.pre.push (.ite condition.expr (yesSetup ++ yesStmts).toList
            (noSetup ++ noStmts).toList) ++ tailStmts)
        else
          let kBranch : M (Array Stmt) := do restore; kRest
          let yesSetup ← parts.yesSetup
          let yesStmts ← lowerVoidHelperFrom yes.toList (if yesAll then pure #[] else kBranch)
          restore
          let noSetup ← parts.noSetup
          let noStmts ← lowerVoidHelperFrom no.toList (if noAll then pure #[] else kBranch)
          restore
          pure (condition.pre.push (.ite condition.expr (yesSetup ++ yesStmts).toList
            (noSetup ++ noStmts).toList))
    | "PlaceholderStatement" =>
        -- Only the body of the modifier being lowered by substitution (#2846) emits a marker;
        -- `lowerSubstitutedModifiers` replaces each one and checks the count.
        let env ← get
        let some (modId, marker) := env.placeholderMarker
          | failAt s "only a single top-level _; placeholder is supported in modifiers"
        unless env.stack.head? == some modId do
          failAt s "only a single top-level _; placeholder is supported in modifiers"
        modify fun e => { e with placeholderMarkers := e.placeholderMarkers + 1 }
        let tailStmts ← kRest
        pure (#[Stmt.letVar marker (.literal 0)] ++ tailStmts)
    | kind => failAt s s!"unsupported void helper statement {kind}"

private partial def resolveStructDeclFromType (j : Json) : M (Nat × Json) := do
  if let some tn := field? j "typeName" then
    let sid ← refInt tn
    if sid ≥ 0 then
      if let some decl := (← get).structs.find? sid.toNat then
        return (sid.toNat, decl)
  let td := field? j "typeDescriptions" |>.getD Json.null
  let tid := optStr td "typeIdentifier" |>.getD ""
  if tid.startsWith "t_struct$_" then
    let segs := tid.splitOn "_$"
    if let some lastSeg := segs.getLast? then
      let digits := String.ofList (lastSeg.toList.takeWhile Char.isDigit)
      if let some sid := digits.toNat? then
        if let some decl := (← get).structs.find? sid then
          return (sid, decl)
  let rawTy ← mType j
  let base :=
    if rawTy.endsWith " storage ref" then (rawTy.dropEnd 12).toString
    else if rawTy.endsWith " storage pointer" then (rawTy.dropEnd 16).toString
    else if rawTy.endsWith " memory" then (rawTy.dropEnd 7).toString
    else if rawTy.endsWith " calldata" then (rawTy.dropEnd 9).toString
    else rawTy
  let targetName := ((base.drop 7).toString.splitOn ".").getLastD ""
  let mut matchedDecls : Array (Nat × Json) := #[]
  for (sid, decl) in (← get).structs.toList do
    if optStr decl "name" == some targetName then
      matchedDecls := matchedDecls.push (sid, decl)
  if matchedDecls.size == 1 then
    return matchedDecls[0]!
  failAt j s!"unable to resolve struct declaration for {rawTy}"

/-- Whether `j` is a storage `string`/`bytes` member access `w.m` on a storage struct `w`,
    whatever the member is called. Storage-slot wrappers such as `StorageSlot.StringSlot`
    are then identified by their `SPath.bytesSlot` path, which is only built for structs
    whose single member is `string` or `bytes`. -/
private partial def isStorageStructBytesMember (j : Json) : M Bool := do
  unless (← mKind j) == "MemberAccess" do return false
  let ty ← mType j
  unless ty == "string storage ref" || ty == "string storage pointer" ||
      ty == "bytes storage ref" || ty == "bytes storage pointer" do
    return false
  let baseTy ← mType (← mField j "expression")
  return baseTy.startsWith "struct " && !baseTy.contains "[" &&
    (baseTy.endsWith " storage pointer" || baseTy.endsWith " storage ref")

/-- The solc memory layout of a struct whose members are ABI scalars and at
least one `bytes` member: one word per member, a `bytes` word pointing to a
length-prefixed buffer. Returns its name, members, and schema. -/
private partial def bytesStructSchema? (sid : Nat) :
    M (Option (String × Array (String × String) × List AbiSchema.Member)) := do
  let structs := (← get).structs
  let some decl := structs.find? sid | return none
  let .ok schema := AbiSchema.root (fun id => structs.find? id) decl | return none
  unless schema.any (fun | .bytesField _ _ => true | _ => false) do return none
  unless schema.all (fun | .bytesField _ _ | .scalar _ => true | _ => false) do return none
  let sName ← mStr (← mField decl "name")
  let sMembers ← mArr (← mField decl "members")
  let members ← sMembers.mapM fun mNode => do
    return (← mStr (← mField mNode "name"), ← mType mNode)
  return some (sName, members, schema)

/-- Whether `j` has a memory struct type with a `bytes`-member layout. The
type string is checked before the declaration is resolved. -/
private partial def hasBytesStructType (j : Json) : M Bool := do
  let ty ← mType j
  unless ty.startsWith "struct " && !ty.contains "[" && ty.endsWith " memory" do return false
  let (sid, _) ← resolveStructDeclFromType j
  return (← bytesStructSchema? sid).isSome

/-- A fresh length-prefixed memory copy of `len` bytes at `src` (calldata or
memory), with the bytes after the end of the last word zeroed as solc's copy
routines leave them. Returns the header pointer. -/
private partial def copyToLengthPrefixed (fromCalldata : Bool) (src len : Expr) :
    M (Array Stmt × Expr) := do
  let srcB ← fresh
  let lenB ← fresh
  let header ← fresh
  let finish ← fresh
  let idx ← fresh
  modify fun e => { e with encodingMemory := true }
  let wordCount := Expr.div (.add (.localVar lenB) (.literal 31)) (.literal 32)
  let load (a : Expr) : Expr := if fromCalldata then .calldataload a else .mload a
  let dataStart := Expr.add (.localVar header) (.literal 32)
  let pre : Array Stmt := #[.letVar srcB src, .letVar lenB len] ++
    (AbiEncoding.reserve header finish (.add (.literal 32) (.mul (.literal 32) wordCount))).toArray ++
    #[.mstore (.localVar header) (.localVar lenB),
      .forEach idx wordCount
        [.mstore (.add dataStart (.mul (.localVar idx) (.literal 32)))
          (load (.add (.localVar srcB) (.mul (.localVar idx) (.literal 32))))],
      .mstore (.add dataStart (.localVar lenB)) (.literal 0)]
  return (pre, .localVar header)

/-- The word stored for a `bytes` member of a memory struct. solc copies a
calldata value or slice into a fresh buffer; a freshly encoded buffer is
copied too, which is unobservable. An existing memory buffer is shared by
solc, so it is rejected rather than copied. -/
private partial def lowerBytesMemberWord (arg : Json) : M (Array Stmt × Expr) := do
  let arg ← stripParens arg
  let argTy ← mType arg
  if argTy == "bytes calldata slice" then
    let some (slicePre, off, len, fromCalldata, isMsgData) ← lowerCalldataSlice? arg
      | failAt arg "unsupported calldata slice struct member"
    if isMsgData then
      failAt arg "msg.data slice struct member must start at or after offset 4"
    let (copyPre, header) ← copyToLengthPrefixed fromCalldata off len
    return (slicePre ++ copyPre, header)
  if argTy == "bytes calldata" && (← mKind arg) == "Identifier" then
    let id ← refInt arg
    if id ≥ 0 then
      if let some cb := (← get).calldataBytes.find? id.toNat then
        if !cb.inMemory then
          return ← copyToLengthPrefixed true (.localVar cb.dataBinding) (.localVar cb.lengthBinding)
  if argTy == "bytes memory" && (← mKind arg) == "FunctionCall" &&
      optStr arg "kind" == some "functionCall" then
    let callee ← mField arg "expression"
    if (← mKind callee) == "MemberAccess" && (field? callee "referencedDeclaration").isNone then
      let buf ← lowerEncodedBytes arg
      let (copyPre, header) ← copyToLengthPrefixed false buf.pointer buf.size
      return (buf.pre ++ copyPre, header)
  failAt arg "a bytes struct member must be a calldata value, a calldata slice, or a builtin encoding; an existing memory buffer would be shared"

/-- Binds a struct pointer as a schema-checked memory struct descriptor. -/
private partial def bindBytesStructPointer (sid : Nat) (pre : Array Stmt) (ptr : Expr) (at_ : Json) :
    M (Array Stmt × MemParam) := do
  let some (sName, members, schema) ← bytesStructSchema? sid
    | failAt at_ "struct has no supported bytes-member memory layout"
  let stem ← fresh
  let binding := stem ++ "_memory"
  if (← get).sourceNames.contains binding then
    failAt at_ s!"generated struct pointer name {binding} collides with a source identifier"
  modify fun e => { e with bound := binding :: e.bound, encodingMemory := true }
  return (pre.push (.letVar binding ptr),
    { structId := sid, param := stem, structName := sName, members,
      schema := some schema, abiStem := stem })

/-- The pointer of a memory struct with `bytes` members: a constructor
allocates one word per member after evaluating the arguments, a helper call is
inlined, and a struct local is its pointer. -/
private partial def lowerBytesStructPointer (j : Json) (sid : Nat) : M (Array Stmt × Expr) := do
  let j ← stripParens j
  let some (_, members, schema) ← bytesStructSchema? sid
    | failAt j "struct has no supported bytes-member memory layout"
  if (← mKind j) == "FunctionCall" && optStr j "kind" == some "structConstructorCall" then
    let (ctorSid, _) ← resolveStructDeclFromType j
    unless ctorSid == sid do failAt j "struct constructor type mismatch"
    let names ← match field? j "names" with
      | some n => mArr n
      | none => pure #[]
    let args ← mArr (← mField j "arguments")
    unless args.size == members.size do failAt j "struct constructor argument count mismatch"
    unless names.isEmpty || names.size == args.size do
      failAt j "named struct constructor name/argument count mismatch"
    -- solc's legacy pipeline evaluates named arguments in declaration order and
    -- via-IR in written order; they agree only when the two orders coincide.
    for i in [:names.size] do
      unless (← mStr names[i]!) == members[i]!.1 do
        failAt j "named arguments of a struct with bytes members must follow the declaration order"
    let mut pre : Array Stmt := #[]
    let mut words : Array (String × Expr) := #[]
    for i in [:args.size] do
      let arg := args[i]!
      let mName ← if names.isEmpty then pure (members[i]!.1) else mStr names[i]!
      if !names.isEmpty && (statefulCallIn arg (← get) || assignmentIn arg) then
        failAt j "named struct constructor with stateful or assignment argument is outside this slice"
      if words.any (·.1 == mName) then
        failAt j s!"duplicate named struct constructor argument {mName}"
      let some mIdx := members.findIdx? (·.1 == mName)
        | failAt j s!"unknown struct constructor member {mName}"
      let mTy := members[mIdx]!.2
      match schema[mIdx]? with
      | some (.bytesField _ _) =>
          let (wPre, word) ← lowerBytesMemberWord arg
          let w ← atom { pre := wPre, expr := word }
          pre := pre ++ w.pre
          words := words.push (mName, w.expr)
      | _ =>
          let v ← atom (← lowerConverted mTy arg)
          let normExpr := cleanHelperResultExpr mTy v
          let w ← atom { pre := v.pre, expr := normExpr }
          pre := pre ++ w.pre
          words := words.push (mName, w.expr)
    let ptr ← fresh
    let finish ← fresh
    modify fun e => { e with encodingMemory := true }
    pre := pre ++ (AbiEncoding.reserve ptr finish (.literal (32 * members.size))).toArray
    for mIdx in [:members.size] do
      let some (_, word) := words.find? (·.1 == members[mIdx]!.1)
        | failAt j s!"missing struct constructor member {members[mIdx]!.1}"
      pre := pre.push (.mstore (.add (.localVar ptr) (.literal (32 * mIdx))) word)
    return (pre, .localVar ptr)
  if (← mKind j) == "FunctionCall" && optStr j "kind" == some "functionCall" then
    let (fnId, vals) ← resolveCallTargetAndArgs j
    return ← inlineBytesStructFn fnId vals j sid
  if (← mKind j) == "Identifier" then
    if let .mem rootId refPre ← lowerRef j then
      if let some mem := (← get).mems.find? rootId then
        if mem.structId == sid && mem.schema.isSome && !mem.calldataLocation then
          return (refPre, .localVar (mem.abiStem ++ "_memory"))
  failAt j "a bytes-member struct value must be a constructor, a helper call, or a memory struct local"

/-- Inlines a helper returning a memory struct with `bytes` members. Every
`return` stores the struct pointer in one binding; the helper must return on
every path, as an unnamed result has no source-visible default here. -/
private partial def inlineBytesStructFn (fnId : Nat) (args : Array CallArg) (at_ : Json) (sid : Nat) :
    M (Array Stmt × Expr) := do
  if (← get).stack.contains fnId then failAt at_ s!"recursive call {fnId}"
  let some fn := (← get).funs.find? fnId | failAt at_ s!"unresolved function {fnId}"
  let visibility := optStr fn "visibility" |>.getD ""
  unless visibility == "internal" || visibility == "private" || visibility == "public" do
    failAt at_ "struct helper calls require an internal, private, or public declaration"
  let saved ← get
  let frameFile := saved.nodeFile.find? fnId |>.getD saved.currentFile
  let implemented := (field? fn "implemented").bind (fun v => v.getBool?.toOption) |>.getD true
  let some body := (field? fn "body").filter (!·.isNull)
    | failNoBody fn at_
  unless implemented do failNoBody fn at_
  modify fun e => { e with stack := fnId :: saved.stack, currentFile := frameFile, unchecked := e.legacyWrapping,
                           bodyAssigned := bodyAssignedIds body, zeroInitLocals := #[] }
  unless (← mArr (← mField fn "modifiers")).isEmpty do
    failAt fn "modifiers on helpers returning a bytes-member struct are outside this slice"
  let params ← mArr (← mField (← mField fn "parameters") "parameters")
  unless params.size == args.size do
    failAt at_ s!"call arity {args.size} does not match declaration {params.size}"
  let rets ← mArr (← mField (← mField fn "returnParameters") "parameters")
  unless rets.size == 1 do failAt fn "struct helper must have one return parameter"
  let r := rets[0]!
  unless (← mStr (← mField r "name")) == "" do
    failAt r "named bytes-member struct helper returns are unsupported"
  let (retSid, _) ← resolveStructDeclFromType r
  unless retSid == sid && optStr r "storageLocation" == some "memory" do
    failAt r "struct helper return type mismatch"
  let stmts ← mArr (← mField body "statements")
  let definitelyReturns ← match stmts.back? with
    | some b => voidHelperReturns b
    | none => pure false
  unless definitelyReturns do
    failAt fn "inlined struct helper does not return on every path"
  let (boundPre, yul) ← bindHelperParams params args body at_ saved.yulNames
  noteProfiledFn fn
  let ptrBinding ← fresh
  modify fun e =>
    { e with yulNames := yul, helperResult := some (ptrBinding, bytesStructResultMarker),
             helperStructSid := sid, helperReturnId := none, multiHelperResults := none,
             flatStructHelperResult := none }
  let (bodyPre, result) ← lowerHelperFrom stmts.toList ""
  let some resultPtr := result | failAt fn "struct helper did not produce a result"
  modify fun e =>
    { e with stack := saved.stack, yulNames := saved.yulNames, yulMemoryArrays := saved.yulMemoryArrays, yulMemoryStructs := saved.yulMemoryStructs, currentFile := saved.currentFile, unchecked := saved.unchecked,
             values := saved.values, writableLocals := saved.writableLocals, zeroInitLocals := saved.zeroInitLocals, paths := saved.paths, snapshots := saved.snapshots, mems := saved.mems, abiElements := saved.abiElements, flatStructs := saved.flatStructs, calldataBytes := saved.calldataBytes, scalarArrays := saved.scalarArrays, byteBuffers := saved.byteBuffers, stringBuffers := saved.stringBuffers, storageBytesVars := saved.storageBytesVars, storageDynamicArrayVars := saved.storageDynamicArrayVars, fnPtrs := saved.fnPtrs, bodyAssigned := saved.bodyAssigned, helperResult := saved.helperResult, helperBytesSize := saved.helperBytesSize, helperStructSid := saved.helperStructSid, helperReturnId := saved.helperReturnId, multiHelperResults := saved.multiHelperResults, flatStructHelperResult := saved.flatStructHelperResult, helperPost := saved.helperPost, scalarTy := saved.scalarTy }
  return (boundPre.push (.letVar ptrBinding (.literal 0)) ++ bodyPre, resultPtr)

private partial def lowerFlatStructValue (j : Json) (expectedSid? : Option Nat) (allowFlatLocalSource : Bool)
    (ref? : Option Ref := none) :
    M (Nat × String × Array Stmt × Array (String × String × Expr)) := do
  let j ← stripParens j
  if (← mKind j) == "FunctionCall" && optStr j "kind" == some "structConstructorCall" then
    let names ← match field? j "names" with
      | some n => mArr n
      | none => pure #[]
    let callee ← mField j "expression"
    let sid ← refInt callee
    unless sid ≥ 0 do
      failAt j "unresolved struct constructor declaration"
    if let some expectedSid := expectedSid? then
      unless sid.toNat == expectedSid do
        failAt j "struct constructor type mismatch"
    let some sDecl := (← get).structs.find? sid.toNat
      | failAt j "unknown struct declaration"
    let sName ← mStr (← mField sDecl "name")
    let sMembers ← mArr (← mField sDecl "members")
    let args ← mArr (← mField j "arguments")
    unless args.size == sMembers.size && !sMembers.isEmpty do
      failAt j "struct constructor argument count mismatch"
    for mNode in sMembers do
      discard (validateEnumTypeIfNeeded mNode (← mType mNode))
    if names.isEmpty then
      let mut pre : Array Stmt := #[]
      let mut memberVals : Array (String × String × Expr) := #[]
      for (mNode, arg) in sMembers.zip args do
        let mName ← mStr (← mField mNode "name")
        let mTy ← mType mNode
        if mTy.startsWith "struct " && !mTy.contains "[" then
          -- A static nested struct member: its value's leaves (a fresh
          -- constructor or helper result; a memory struct local would be shared).
          let subSid ← refInt (← mField mNode "typeName")
          let (_, _, subPre, subVals) ← lowerFlatStructValue arg (some subSid.toNat) false
          pre := pre ++ subPre
          memberVals := memberVals ++ subVals.map fun (n, t, e) => (s!"{mName}.{n}", t, e)
          continue
        unless (paramType mTy).isSome do
          failAt mNode s!"unsupported flat struct member type {mTy}"
        let rawVal ← lowerExpr arg
        let convVal ← atom (← convert mTy (← mType arg) rawVal arg)
        let normExpr := cleanHelperResultExpr mTy convVal
        -- Snapshot: a later argument may write a local this one read (`S(k, k++)`).
        let snap ← fresh
        pre := (pre ++ convVal.pre).push (.letVar snap normExpr)
        memberVals := memberVals.push (mName, mTy, .localVar snap)
      return (sid.toNat, sName, pre, memberVals)
    else
      unless names.size == args.size do
        failAt j "named struct constructor name/argument count mismatch"
      let mut pre : Array Stmt := #[]
      let mut evaluatedByName : Array (String × String × Expr) := #[]
      let written ← names.mapM mStr
      let mut order := Array.range args.size
      if !(← get).viaIR then
        -- Legacy evaluates in declaration order, even when two pure arguments panic.
        order ← sMembers.mapM fun m => do
          let name ← mStr (← mField m "name")
          let some i := written.findIdx? (· == name) | failAt j s!"missing struct constructor member {name}"
          return i
      for i in order do
        let argName ← mStr names[i]!
        let arg := args[i]!
        if statefulCallIn arg (← get) || assignmentIn arg then
          failAt j "named struct constructor with stateful or assignment argument is outside this slice"
        if evaluatedByName.any (fun (n, _, _) => n == argName) then
          failAt j s!"duplicate named struct constructor argument {argName}"
        let mut matchedMember? : Option Json := none
        for mNode in sMembers do
          if (← mStr (← mField mNode "name")) == argName then
            matchedMember? := some mNode
        let some mNode := matchedMember?
          | failAt j s!"unknown struct constructor member {argName}"
        let mTy ← mType mNode
        if mTy.startsWith "struct " && !mTy.contains "[" then
          let subSid ← refInt (← mField mNode "typeName")
          let (_, _, subPre, subVals) ← lowerFlatStructValue arg (some subSid.toNat) false
          pre := pre ++ subPre
          evaluatedByName := evaluatedByName ++ subVals.map fun (n, t, e) => (s!"{argName}.{n}", t, e)
          continue
        unless (paramType mTy).isSome do
          failAt mNode s!"unsupported flat struct member type {mTy}"
        let rawVal ← lowerExpr arg
        let convVal ← atom (← convert mTy (← mType arg) rawVal arg)
        let normExpr := cleanHelperResultExpr mTy convVal
        let snap ← fresh
        pre := (pre ++ convVal.pre).push (.letVar snap normExpr)
        evaluatedByName := evaluatedByName.push (argName, mTy, .localVar snap)
      let mut memberVals : Array (String × String × Expr) := #[]
      for mNode in sMembers do
        let mName ← mStr (← mField mNode "name")
        let leaves := evaluatedByName.filter (fun (n, _, _) => n == mName || n.startsWith s!"{mName}.")
        if leaves.isEmpty then
          failAt j s!"missing struct constructor member {mName}"
        memberVals := memberVals ++ leaves
      return (sid.toNat, sName, pre, memberVals)
  if (← mKind j) == "FunctionCall" && optStr j "kind" == some "functionCall" &&
      (← mType j).startsWith "struct " && !(← mType j).contains "[" &&
      (← mType j).endsWith " memory" then
    if ← isAbiDecodeCall j then
      let (decodePre, decoded) ← lowerAbiDecodeItems j
      unless decoded.size == 1 do
        failAt j "struct abi.decode requires a single struct target type"
      let .flatStruct callSid callSName callMembers := decoded[0]!
        | failAt j "struct abi.decode requires a flat struct target type"
      if let some expectedSid := expectedSid? then
        unless callSid == expectedSid do
          failAt j "struct abi.decode return type mismatch"
      return (callSid, callSName, decodePre, callMembers)
    let (fnId, vals) ← resolveCallTargetAndArgs j
    let (callSid, callSName, callPre, callMembers) ← inlineFlatStructFn fnId vals j
    if let some expectedSid := expectedSid? then
      unless callSid == expectedSid do
        failAt j "struct helper return type mismatch"
    let mut pre := callPre
    let mut memberVals : Array (String × String × Expr) := #[]
    for (mName, mTy, mExpr) in callMembers do
      let snap ← atom { pre := #[], expr := mExpr }
      pre := pre ++ snap.pre
      memberVals := memberVals.push (mName, mTy, snap.expr)
    return (callSid, callSName, pre, memberVals)
  if (← mKind j) == "Conditional" then
    let condVal ← atom (← lowerExpr (← mField j "condition"))
    let trueNode ← mField j "trueExpression"
    let falseNode ← mField j "falseExpression"
    let (tSid, sName, tPre, tMembers) ← lowerFlatStructValue trueNode expectedSid? allowFlatLocalSource
    let (fSid, _, fPre, fMembers) ← lowerFlatStructValue falseNode (some tSid) allowFlatLocalSource
    unless tSid == fSid && tMembers.size == fMembers.size do
      failAt j "conditional struct branch type mismatch"
    let mut pre := condVal.pre
    let mut tBranch := tPre
    let mut fBranch := fPre
    let mut memberVals : Array (String × String × Expr) := #[]
    for ((tName, tTy, tExpr), (fName, fTy, fExpr)) in tMembers.zip fMembers do
      unless tName == fName && tTy == fTy do
        failAt j "conditional struct member mismatch"
      let tmp ← fresh
      pre := pre.push (.letVar tmp (.literal 0))
      tBranch := tBranch.push (.assignVar tmp tExpr)
      fBranch := fBranch.push (.assignVar tmp fExpr)
      memberVals := memberVals.push (tName, tTy, .localVar tmp)
    pre := pre.push (.ite condVal.expr tBranch.toList fBranch.toList)
    return (tSid, sName, pre, memberVals)
  match ← (match ref? with | some ref => pure ref | none => lowerRef j) with
  | .path pathPre path =>
      let (sid, sDecl) ← resolveStructDeclFromType j
      if let some expectedSid := expectedSid? then
        unless sid == expectedSid do
          failAt j "struct storage source type mismatch"
      let sName ← mStr (← mField sDecl "name")
      let sMembers ← mArr (← mField sDecl "members")
      if let .rawSlot rawSid baseSlot := path then
        unless rawSid == sid do
          failAt j "raw-slot struct declaration mismatch"
        let rawInfo ← resolveRawStructInfo rawSid j
        unless rawInfo.subStructs.isEmpty && rawInfo.mappings.isEmpty &&
            rawInfo.dynamicArrays.isEmpty && rawInfo.scalars.size == sMembers.size && !sMembers.isEmpty do
          failAt j "struct storage read requires a scalar-member struct layout"
        let mut pre : Array Stmt := pathPre
        let mut memberVals : Array (String × String × Expr) := #[]
        for mNode in sMembers do
          let mName ← mStr (← mField mNode "name")
          let mTy ← mType mNode
          let some mInfo := rawInfo.scalars.find? (·.member == mName)
            | failAt mNode s!"unsupported flat struct storage member {mName}"
          let rawRead ← readRawStructScalar #[] baseSlot mInfo
          let readVal ← atom (← storageEnumRead mNode rawRead)
          pre := pre ++ readVal.pre
          memberVals := memberVals.push (mName, mTy, readVal.expr)
        return (sid, sName, pre, memberVals)
      let (fieldName, count) ← match path with
        | .zero field => pure (field, 0)
        | .one field _ => pure (field, 1)
        | .two field _ _ => pure (field, 2)
        | .outer _ _ => failAt j "struct storage read requires all mapping keys"
        | .rawSlot _ _ | .bytesSlot _ _ => failAt j "whole raw-slot struct storage read is outside this slice"
      let (fieldName, subPrefix) := splitSPathField fieldName
      let info ← resolveField fieldName j
      let underSub (m : String) : Bool :=
        if subPrefix.isEmpty then true else m == subPrefix || m.startsWith (subPrefix ++ ".")
      unless !info.scalarMapping && info.fixedArrayLength.isNone && info.keyCount == count &&
          !sMembers.isEmpty &&
          !info.structMappings.any (underSub ·.member) && !info.opaqueNames.any underSub &&
          !info.structFixedArrays.any (underSub ·.member) &&
          !info.structDynamicArrays.any (underSub ·.member) &&
          (if subPrefix.isEmpty then info.subStructs.isEmpty
           else info.subStructs.contains (subPrefix, sid) &&
             !info.subStructs.any (·.1.startsWith (subPrefix ++ "."))) do
        failAt j "struct storage read requires a scalar-member struct layout"
      unless sMembers.size == (info.memberNames.filter underSub).size do
        failAt j "struct declaration member count does not match storage layout"
      let mut pre : Array Stmt := pathPre
      let mut memberVals : Array (String × String × Expr) := #[]
      for mNode in sMembers do
        let mName ← mStr (← mField mNode "name")
        let mTy ← mType mNode
        unless (paramType mTy).isSome &&
            info.memberNames.contains (qualifySPathMember subPrefix mName) do
          failAt mNode s!"unsupported flat struct storage member {mName}"
        let rawRead ← memberRead #[] path mName j
        let readVal ← atom (← storageEnumRead mNode rawRead)
        pre := pre ++ readVal.pre
        memberVals := memberVals.push (mName, mTy, readVal.expr)
      return (sid, sName, pre, memberVals)
  | .flatStruct srcId =>
      unless allowFlatLocalSource do
        failAt j "memory struct local aliasing is outside this slice"
      let some flat := (← get).flatStructs.find? srcId
        | failAt j "unknown flat struct local"
      if let some expectedSid := expectedSid? then
        unless flat.structId == expectedSid do
          failAt j "flat struct local type mismatch"
      let mut pre : Array Stmt := #[]
      let mut memberVals : Array (String × String × Expr) := #[]
      for (mName, mTy, binding) in flat.members do
        let snap ← atom { pre := #[], expr := .localVar binding }
        pre := pre ++ snap.pre
        memberVals := memberVals.push (mName, mTy, snap.expr)
      return (flat.structId, flat.structName, pre, memberVals)
  | .mem srcId memPre =>
      unless allowFlatLocalSource do
        failAt j "memory struct local aliasing is outside this slice"
      let some mem := (← get).mems.find? srcId
        | failAt j "unknown memory struct local"
      let (sid, sDecl) ← resolveStructDeclFromType j
      if let some expectedSid := expectedSid? then
        unless sid == expectedSid do
          failAt j "struct source type mismatch"
      let sName ← mStr (← mField sDecl "name")
      let sMembers ← mArr (← mField sDecl "members")
      let isStaticStruct := mem.staticTypes.isSome ||
        match mem.schema with
        | some s => s.all (fun item => match item with | .scalar _ => true | _ => false)
        | none => false
      unless isStaticStruct && mem.members.size == sMembers.size && !sMembers.isEmpty do
        failAt j "struct value copy requires a static scalar-member struct"
      let mut pre : Array Stmt := memPre
      let mut memberVals : Array (String × String × Expr) := #[]
      for mNode in sMembers do
        let mName ← mStr (← mField mNode "name")
        let mTy ← mType mNode
        unless (paramType mTy).isSome do
          failAt mNode s!"unsupported flat struct member type {mTy}"
        discard (validateEnumTypeIfNeeded mNode mTy)
        let readVal ← atom (← readAbiMember srcId #[] mName j)
        pre := pre ++ readVal.pre
        memberVals := memberVals.push (mName, mTy, readVal.expr)
      return (sid, sName, pre, memberVals)
  | .abiElement id memberIndex pointer inMemory elemPre =>
      unless allowFlatLocalSource do
        failAt j "memory struct local aliasing is outside this slice"
      let some mem := (← get).mems.find? id | failAt j "unknown ABI root"
      let some schema := mem.schema | failAt j "missing ABI schema"
      let some (.structArray _ fields) := schema[memberIndex]?
        | failAt j "expected a struct-array element"
      let (sid, sDecl) ← resolveStructDeclFromType j
      if let some expectedSid := expectedSid? then
        unless sid == expectedSid do
          failAt j "struct source type mismatch"
      let sName ← mStr (← mField sDecl "name")
      let sMembers ← mArr (← mField sDecl "members")
      unless fields.length == sMembers.size && !sMembers.isEmpty do
        failAt j "struct value copy requires a static scalar-member struct"
      let ptrAtom ← atom { pre := elemPre, expr := pointer }
      let mut pre : Array Stmt := ptrAtom.pre
      let mut memberVals : Array (String × String × Expr) := #[]
      for idx in [:sMembers.size] do
        let mNode := sMembers[idx]!
        let mName ← mStr (← mField mNode "name")
        let mTy ← mType mNode
        unless (paramType mTy).isSome do
          failAt mNode s!"unsupported flat struct member type {mTy}"
        let some field := fields[idx]?
          | failAt mNode "missing struct-array field"
        unless field.name == mName do
          failAt mNode s!"struct-array field mismatch {mName}"
        let offset := Expr.add ptrAtom.expr (.literal (32 * idx))
        let rawExpr := if !inMemory then Expr.calldataload offset else Expr.mload offset
        let bound := SolidityAbi.scalarBound field.kind
        let readPre := if !inMemory && bound < 2 ^ 256 then
          #[AbiLowering.guard (.lt rawExpr (.literal bound))] else #[]
        let readVal ← atom { pre := readPre, expr := rawExpr }
        pre := pre ++ readVal.pre
        memberVals := memberVals.push (mName, mTy, readVal.expr)
      return (sid, sName, pre, memberVals)
  | _ => failAt j "unsupported struct value expression"

/-- A fresh zeroed struct of `words` members (`delete a[i]`, solc's zero value
of a memory struct): its pointer. -/
private partial def structMemZeroPointer (words : Nat) : M (Array Stmt × Expr) := do
  let ptr ← fresh
  let finish ← fresh
  modify fun e => { e with encodingMemory := true }
  return ((zeroedStructAlloc ptr finish words).toArray, .localVar ptr)

/-- The pointer stored by `a[i] = rhs` into an `S[] memory` element. Another
memory element of the same struct is shared (solc copies the pointer). A
constructor, a struct helper result or a storage struct is a fresh struct in
solc: its members are evaluated, then one word per member is allocated and
written. A memory struct local or parameter would be shared by solc but has no
memory of its own here, so it is rejected (`lowerFlatStructValue`). -/
private partial def structMemElementPointer (rhs : Json) (sid : Nat)
    (fields : List AbiSchema.ScalarField) : M (Array Stmt × Expr) := do
  let rhs ← stripParens rhs
  if (← mKind rhs) == "Identifier" || (← mKind rhs) == "IndexAccess" then
    if let .abiElement id memberIndex pointer true pre ← lowerRef rhs then
      let some mem := (← get).mems.find? id | failAt rhs "unknown ABI root"
      let elemSid ← abiElementStructId mem memberIndex rhs
      unless elemSid ≥ 0 && elemSid.toNat == sid do
        failAt rhs "memory struct array element type mismatch"
      let p ← atom { pre, expr := pointer }
      return (p.pre, p.expr)
  let (valSid, _, valPre, memberVals) ← lowerFlatStructValue rhs (some sid) false
  unless valSid == sid && memberVals.size == fields.length do
    failAt rhs "memory struct array element type mismatch"
  let ptr ← fresh
  let finish ← fresh
  modify fun e => { e with encodingMemory := true }
  let mut out := valPre ++ (AbiEncoding.reserve ptr finish (.literal (32 * fields.length))).toArray
  for (field, i) in fields.zipIdx do
    let some (_, _, mExpr) := memberVals.find? (fun (n, _, _) => n == field.name)
      | failAt rhs s!"missing struct member {field.name}"
    out := out.push (.mstore (.add (.localVar ptr) (.literal (32 * i))) mExpr)
  return (out, .localVar ptr)

/-- Whether a struct-typed right-hand side is a value that solc evaluates in full before the
target's keys: a call returning a memory struct (constructor or helper), or a memory-typed
conditional whose branches are values or storage references (solc copies a storage branch to
memory when it evaluates the conditional). Variables, elements and storage pointers are
references whose members solc reads at the copy. -/
private partial def isStructValueSource (j : Json) : M Bool := do
  let j ← stripParens j
  let isStorageTyped (e : Json) : M Bool := do
    return ((← mType e).splitOn " storage").length > 1
  match ← mKind j with
  | "FunctionCall" => return !(← isStorageTyped j)
  | "Conditional" =>
      if ← isStorageTyped j then return false
      let branchIsValue (b : Json) : M Bool := do
        if ← isStorageTyped b then return true
        isStructValueSource b
      let onTrue ← branchIsValue (← mField j "trueExpression")
      let onFalse ← branchIsValue (← mField j "falseExpression")
      return onTrue && onFalse
  | _ => return false

/-- An expression whose evaluation cannot revert, call or write: identifiers, literals, member
reads, mapping lookups, comparisons, logical and bitwise operators, conditionals and struct
constructors of such. Evaluated
before or after a target key prelude without effects, it gives the same result. -/
private partial def orderInert (j : Json) : M Bool := do
  let j ← stripParens j
  match ← mKind j with
  | "Identifier" | "Literal" => return true
  | "MemberAccess" =>
      if (← mType j).startsWith "function " then return false
      orderInert (← mField j "expression")
  | "IndexAccess" =>
      let base ← mField j "baseExpression"
      unless (← mType base).startsWith "mapping(" do return false
      let some index := field? j "indexExpression" | return false
      return (← orderInert base) && (← orderInert index)
  | "Conditional" =>
      return (← orderInert (← mField j "condition")) &&
        (← orderInert (← mField j "trueExpression")) && (← orderInert (← mField j "falseExpression"))
  | "BinaryOperation" =>
      -- Comparisons, logical and bitwise operators cannot revert (unless user-defined).
      if (field? j "function").isSome then return false
      let op := optStr j "operator" |>.getD ""
      unless ["==", "!=", "<", "<=", ">", ">=", "&&", "||", "&", "|", "^"].contains op do
        return false
      return (← orderInert (← mField j "leftExpression")) &&
        (← orderInert (← mField j "rightExpression"))
  | "UnaryOperation" =>
      unless optStr j "operator" == some "!" && (field? j "function").isNone do return false
      orderInert (← mField j "subExpression")
  | "FunctionCall" =>
      unless optStr j "kind" == some "structConstructorCall" do return false
      (← mArr (← mField j "arguments")).allM orderInert
  | _ => return false

/-- Whether the lowering's order of `right` and the target's key prelude `pre` can differ
observably from solc's: the target's keys call or write (state the right-hand side may read),
or, unless the lowering already evaluates `right` first (`rightFirst`), the right-hand side
itself can revert, call or write (a panic in both, or a write the keys read). -/
private partial def keyOrderObservable (pre : Array Stmt) (target right : Json)
    (rightFirst : Bool := false) : M Bool := do
  if pre.isEmpty then return false
  if statefulCallIn target (← get) || assignmentIn target then return true
  if rightFirst then return false
  return !(← orderInert right)

/-- solc evaluates a storage `bytes`/`string` source's own keys before the target's and copies
it after them. The lowering reads such a source in one step, so when the order is observable a
source that is not a storage variable or storage pointer local is rejected. -/
private partial def checkStorageBytesSourceOrder (pre : Array Stmt) (target right : Json) :
    M Unit := do
  let right ← stripParens right
  if ((← mType right).splitOn " storage").length > 1 && (← mKind right) != "Identifier" &&
      (← keyOrderObservable pre target right) then
    failAt right "keyed storage bytes/string source beside a target key prelude is unsupported"

/-- A storage struct source of a whole-struct copy beside a target key prelude. solc evaluates
the source's slot (its own keys and index checks, a storage-pointer helper call) before the
target's keys and reads its members at the copy, after them. Returns the slot prelude, with the
slot's keys bound to fresh locals, and the member reads. Sources that are not storage-typed
references: `none`. -/
private partial def lowerStructStorageSource? (right : Json) (sid : Nat) :
    M (Option (Array Stmt × Array Stmt × Array (String × String × Expr))) := do
  let right ← stripParens right
  unless ((← mType right).splitOn " storage").length > 1 do return none
  unless ["Identifier", "IndexAccess", "MemberAccess", "FunctionCall"].contains (← mKind right) do
    return none
  let ref ← lowerRef right
  let .path pathPre path := ref | do
    -- Lowered once: other references take `lowerFlatStructValue`'s own path.
    let (_, _, readPre, members) ← lowerFlatStructValue right (some sid) true (some ref)
    return some (#[], readPre, members)
  let bind (e : Expr) : M (Array Stmt × Expr) := do
    match e with
    | .literal _ => pure (#[], e)
    | _ => do
        let name ← fresh
        pure (#[.letVar name e], .localVar name)
  let (keyPre, path) ← match path with
    | .one field key => do
        let (p, key) ← bind key
        pure (p, SPath.one field key)
    | .two field key1 key2 => do
        let (p1, key1) ← bind key1
        let (p2, key2) ← bind key2
        pure (p1 ++ p2, SPath.two field key1 key2)
    | .rawSlot rawSid slot => do
        let (p, slot) ← bind slot
        pure (p, SPath.rawSlot rawSid slot)
    | other => pure (#[], other)
  let (_, _, readPre, members) ← lowerFlatStructValue right (some sid) true (some (.path #[] path))
  return some (pathPre ++ keyPre, readPre, members)

/-- A conditional struct right-hand side that is not a value (`isStructValueSource`) beside a
target key prelude: solc evaluates its condition and selects a branch reference before the
target's keys and copies the branch after them; the lowering cannot split the two, so it is
rejected when that order is observable (`keyOrderObservable`). -/
private partial def checkStructConditionalSource (pre : Array Stmt) (target right : Json)
    (rightFirst : Bool := false) : M Unit := do
  let stripped ← stripParens right
  if (← mKind stripped) == "Conditional" && !(← isStructValueSource stripped) &&
      (← keyOrderObservable pre target stripped rightFirst) then
    failAt right "struct conditional with a reference branch beside a target key prelude is unsupported"

private partial def writeWholeStorageStruct (pre : Array Stmt) (path : SPath) (deleting : Bool)
    (target expression : Json) : M (Array Stmt) := do
  if let .rawSlot rawSid baseSlot := path then
    let rawInfo ← resolveRawStructInfo rawSid target
    if deleting then
      unless rawInfo.mappings.isEmpty do
        failAt target "cannot delete struct with mapping members"
      unless rawInfo.dynamicArrays.isEmpty do
        failAt target "cannot delete struct with dynamic-array members"
      unless rawInfo.subStructs.isEmpty do
        failAt target "cannot delete struct with nested struct members"
      -- A `string`/`bytes` member's contents live outside the struct's words.
      unless rawInfo.opaqueMemberNames.isEmpty do
        failAt target "cannot delete struct with members outside this slice"
      unless rawInfo.wordCount > 0 && !rawInfo.scalars.isEmpty do
        failAt target "cannot delete empty struct layout"
      modify fun e => { e with usedRawStorage := true }
      let mut out := pre
      for w in [:rawInfo.wordCount] do
        out := out.push (.setStorageArrayElement rawStorageFieldName (rawStructMemberSlot baseSlot w) (.literal 0))
      return out
    unless rawInfo.mappings.isEmpty && rawInfo.dynamicArrays.isEmpty &&
        rawInfo.subStructs.isEmpty && rawInfo.opaqueMemberNames.isEmpty && !rawInfo.scalars.isEmpty do
      failAt target "whole struct storage assignment requires a scalar-member struct layout"
    let (targetSid, sDecl) ← resolveStructDeclFromType target
    unless targetSid == rawSid do
      failAt target "raw-slot struct target declaration mismatch"
    let sMembers ← mArr (← mField sDecl "members")
    unless sMembers.size == rawInfo.scalars.size do
      failAt target "struct assignment member count mismatch"
    let right ← mField expression "rightHandSide"
    if !pre.isEmpty && (statefulCallIn right (← get) || assignmentIn right) then
      failAt target "struct storage write key prelude with stateful RHS is unsupported"
    -- The raw-slot lowering evaluates a conditional in full before the keys.
    checkStructConditionalSource pre target right (rightFirst := true)
    -- A storage source: its slot before the target's keys, its members after them.
    let source? ← if pre.isEmpty then pure none else lowerStructStorageSource? right rawSid
    let (slotPre, rhsPre, memberVals) ← match source? with
      | some source => pure source
      | none => do
          let (_, _, rhsPre, memberVals) ← lowerFlatStructValue right (some rawSid) true
          pure (#[], rhsPre, memberVals)
    unless memberVals.size == rawInfo.scalars.size do
      failAt target "struct assignment member count mismatch"
    let mut out := if source?.isSome then slotPre ++ pre ++ rhsPre else rhsPre ++ pre
    for (mName, mTy, mExpr) in memberVals do
      let some mInfo := rawInfo.scalars.find? (·.member == mName)
        | failAt target s!"unknown struct layout member {mName}"
      let (enumPre, checkedExpr) ← validateEnumExpr target mTy mExpr
      let writeStmts ← writeRawStructScalar enumPre baseSlot mInfo checkedExpr false
      out := out ++ writeStmts
    return out
  let (name, count, writeMember) ← match path with
    | .zero field => pure (field, 0, fun member value => Stmt.setStorage (topStructMemberFieldName field member) value)
    | .one field key => pure (field, 1, fun member value => Stmt.setStructMember field key member value)
    | .two field key1 key2 => pure (field, 2, fun member value => Stmt.setStructMember2 field key1 key2 member value)
    | .outer _ _ => failAt target "mapping assignment requires both keys"
    | .rawSlot _ _ | .bytesSlot _ _ => failAt target "whole raw-slot struct storage assignment is outside this slice"
  let info ← resolveField name target
  if deleting then
    if let some length := info.fixedArrayLength then
      unless info.keyCount == count do
        failAt target "fixed array mapping key count differs"
      markField name
      let mut out := pre
      for i in [:length] do
        out := out.push (writeMember s!"__solidity_element_{i}" (.literal 0))
      return out
  unless !info.scalarMapping && info.fixedArrayLength.isNone && info.keyCount == count do
    failAt target "whole struct storage assignment requires a struct storage path"
  if deleting then
    if (← get).enumStructFields.contains name then
      failAt target "whole-struct delete with packed enum members is outside this slice"
    unless info.structMappings.isEmpty do
      failAt target "cannot delete mapping struct with mapping members"
    unless info.opaqueNames.isEmpty do
      failAt target "cannot delete mapping struct with opaque members"
    unless info.structDynamicArrays.isEmpty do
      failAt target "cannot delete mapping struct with dynamic-array members"
    unless info.structFixedArrays.isEmpty do
      failAt target "cannot delete mapping struct with fixed-array members"
    unless !info.memberNames.isEmpty do
      failAt target "cannot delete empty mapping struct layout"
    markField name
    let mut out := pre
    for member in info.memberNames do
      out := out.push (writeMember member (.literal 0))
    return out
  unless info.structMappings.isEmpty && info.opaqueNames.isEmpty &&
      info.structFixedArrays.isEmpty && info.structDynamicArrays.isEmpty && !info.memberNames.isEmpty do
    failAt target "whole struct storage assignment requires a scalar-member struct layout"
  let (targetSid, _) ← resolveStructDeclFromType target
  let right ← mField expression "rightHandSide"
  if !pre.isEmpty && (statefulCallIn right (← get) || assignmentIn right) then
    failAt target "struct storage write key prelude with stateful RHS is unsupported"
  checkStructConditionalSource pre target right
  -- solc evaluates a struct value before the target's keys, so with a key prelude its member
  -- values are captured first. A reference (storage or memory variable, element or storage
  -- pointer) is read at the copy, after the keys; a storage source's own slot comes first.
  let isValue ← isStructValueSource right
  let valueFirst := !pre.isEmpty && isValue
  let source? ← if pre.isEmpty || valueFirst then pure none
    else lowerStructStorageSource? right targetSid
  let (slotPre, rhsPre, memberVals) ← match source? with
    | some source => pure source
    | none => do
        let (_, _, rhsPre, memberVals) ← lowerFlatStructValue right (some targetSid) true
        pure (#[], rhsPre, memberVals)
  unless memberVals.size == info.memberNames.size do
    failAt target "struct assignment member count mismatch"
  markField name
  let mut valuePre := rhsPre
  let mut values : Array (String × Expr) := #[]
  let mut enumChecks : Array Stmt := #[]
  for (mName, mTy, mExpr) in memberVals do
    unless info.memberNames.contains mName do
      failAt target s!"unknown struct layout member {mName}"
    let (enumPre, checkedExpr) ← validateEnumExpr target mTy mExpr
    if valueFirst then
      let captured ← fresh
      valuePre := valuePre ++ enumPre |>.push (.letVar captured checkedExpr)
      values := values.push (mName, .localVar captured)
    else
      enumChecks := enumChecks ++ enumPre
      values := values.push (mName, checkedExpr)
  let mut out := if valueFirst then valuePre ++ pre else pre ++ valuePre
  out := slotPre ++ out
  out := out ++ enumChecks
  for (mName, mExpr) in values do
    let stored := if info.booleanMembers.contains mName then Expr.logicalNot (.logicalNot mExpr) else mExpr
    out := out.push (writeMember mName stored)
  return out

/-- An expression statement admits its own typed-interface call, or the right-hand
side of a plain `=` to an unindexed identifier; `lowerBinary` relaxes its sibling
order check for a `==`/`!=` operand that is an admitted call. An assignment to a
target that can revert rejects any typed-interface call
(`checkInterfaceCallAssignmentOrder`). -/
private partial def lowerEffect (statement : Json) : M (Array Stmt) := do
  let admitted := (field? statement "expression").bind fun expression =>
    if optStr expression "nodeType" == some "Assignment" then
      if optStr expression "operator" == some "=" &&
          ((field? expression "leftHandSide").bind (optStr · "nodeType")) == some "Identifier" then
        field? expression "rightHandSide"
      else none
    else some expression
  recoverAt statement #[] <| withAdmittedInterfaceCall admitted do
    checkInterfaceCallAssignmentOrder statement
    lowerEffectCore statement

private partial def lowerEffectCore (statement : Json) : M (Array Stmt) := do
  let assignedHere := bodyAssignedIds statement
  if !assignedHere.isEmpty then
    modify fun e => { e with zeroInitLocals := e.zeroInitLocals.filter (!assignedHere.contains ·) }
  let expression ← mField statement "expression"
  let kind ← mKind expression
  if kind == "FunctionCall" && optStr expression "kind" == some "functionCall" then
    let callee ← mField expression "expression"
    -- Builtin require keeps its overload set in solc's AST; its existing
    -- dedicated validator must run before strict user-declaration resolution.
    if (← mKind callee) == "Identifier" && optStr callee "name" == some "require" then
      return ← lowerRequire statement
    if (← mKind callee) == "Identifier" && optStr callee "name" == some "revert" then
      return ← lowerBuiltinRevert statement
    if (← mKind callee) == "Identifier" &&
        (field? callee "referencedDeclaration").bind (·.getInt?.toOption) == some (-3) then
      return ← lowerAssert statement
    if (← mKind callee) == "FunctionCallOptions" then
      failAt callee "external contract calls are outside this slice"
    let linkedLibraryCall ← admitLinkedLibraryCall callee
    unless (← mArr (← mField expression "names")).isEmpty do
      failAt expression "named call arguments are outside this slice"
    if ← isInterfaceExternalCall expression then
      if let some decl ← interfaceVoidCallDecl? expression then
        return ← lowerInterfaceVoidCall expression decl
      if ← isInterfaceMultiReturnCall expression then
        return (← lowerInterfaceMultiStaticCall expression).1
      return (← lowerInterfaceStaticCall expression).pre
    if (← mKind callee) == "MemberAccess" && (field? callee "referencedDeclaration").isNone then
      let base ← mField callee "expression"
      let baseTy ← mType base
      let member := optStr callee "memberName" |>.getD ""
      if (baseTy == "address" || baseTy == "address payable") && member == "call" then
        failAt callee lowLevelCallPlacement
      if (baseTy == "address" || baseTy == "address payable" || baseTy.startsWith "contract ") &&
          ["call", "staticcall", "delegatecall", "transfer", "send"].contains member then
        failAt callee "external contract calls are outside this slice"
      if ["push", "pop"].contains member then
        if let some (pre, fieldName, slotExpr, elemTy, _, _, elemSid?) ← resolveStorageDynamicArrayTarget (← lowerRef base) base then
          let args ← mArr (← mField expression "arguments")
          if let some elemSid := elemSid? then
            if member == "push" then
              if args.isEmpty then
                return (← pushStorageDynamicStructArray pre fieldName slotExpr elemSid none expression).1
              else if args.size == 1 then
                let arg := args[0]!
                if !pre.isEmpty && (statefulCallIn arg (← get) || assignmentIn arg) then
                  failAt arg "storage array push prelude with stateful argument is unsupported"
                let (argSid, _, argPre, memberVals) ← lowerFlatStructValue arg (some elemSid) true
                unless argSid == elemSid do
                  failAt arg "storage struct array push argument type mismatch"
                return (← pushStorageDynamicStructArray (pre ++ argPre) fieldName slotExpr elemSid (some memberVals) expression).1
              else
                failAt expression "storage array push takes at most one argument"
            else
              unless args.isEmpty do
                failAt expression "storage array pop takes no arguments"
              return ← popStorageDynamicArray pre fieldName slotExpr elemTy (some elemSid)
          if member == "push" then
            if args.isEmpty then
              return (← pushStorageDynamicArray pre fieldName slotExpr elemTy none).pre
            else if args.size == 1 then
              let val ← atom (← lowerConverted elemTy args[0]!)
              return (← pushStorageDynamicArray (pre ++ val.pre) fieldName slotExpr elemTy (some val.expr)).pre
            else
              failAt expression "storage array push takes at most one argument"
          else
            unless args.isEmpty do
              failAt expression "storage array pop takes no arguments"
            return ← popStorageDynamicArray pre fieldName slotExpr elemTy
        failAt callee s!"storage array {member} is outside this slice"
    let reference ← refInt callee
    if (← mKind callee) == "Identifier" && (reference == -2 || reference == -16) then
      let modCall ← atom (← lowerCall expression)
      return modCall.pre
    if reference ≥ 0 then
      if let some ptr := (← get).fnPtrs.find? reference.toNat then
        unless (← mKind callee) == "Identifier" do
          failAt callee "function pointer call requires a local identifier"
        let checkFnArity (fnId : Nat) : M Nat := do
          let some declaration := (← get).funs.find? fnId
            | failAt callee "unresolved function pointer target"
          let visibility := optStr declaration "visibility" |>.getD ""
          unless visibility == "internal" || visibility == "private" || visibility == "public" do
            failAt callee "function pointer target requires an internal, private, or public declaration"
          let rets ← mArr (← mField (← mField declaration "returnParameters") "parameters")
          pure rets.size
        let arity ← match ptr with
          | .direct fnId => checkFnArity fnId
          | .branch _ tId fId => do
              let v1 ← checkFnArity tId
              let v2 ← checkFnArity fId
              unless v1 == v2 do failAt callee "function pointer branches have mismatched return arities"
              pure v1
        if arity == 0 then
          let rawVals ← lowerCallArgs expression none
          match ptr with
          | .direct fnId =>
              return ← inlineVoidFn fnId rawVals expression
          | .branch condExpr trueFnId falseFnId =>
              let (argPre, atomicVals) ← atomizeCallArgs rawVals
              let trueStmts ← inlineVoidFn trueFnId atomicVals expression
              let falseStmts ← inlineVoidFn falseFnId atomicVals expression
              return argPre.push (.ite condExpr trueStmts.toList falseStmts.toList)
        else if arity > 1 then
          let (multiPre, _) ← lowerMultiCall expression
          return multiPre
        else
          let result ← atom (← lowerCall expression)
          return result.pre
      if let some declaration := (← get).funs.find? reference.toNat then
        let visibility := optStr declaration "visibility" |>.getD ""
        let internalCallee ← match ← mKind callee with
          | "Identifier" => pure true
          | "MemberAccess" =>
              let base ← mField callee "expression"
              let baseTy ← mType base
              let isSuper : Bool ← if (← mKind base) == "Identifier" && optStr base "name" == some "super" then
                pure (decide ((← refInt base) < 0))
              else
                pure false
              pure (isSuper || baseTy.startsWith "type(contract ")
          | _ => pure false
        if (← mKind callee) == "MemberAccess" && !internalCallee then
          let base ← mField callee "expression"
          let isThis := (← mKind base) == "Identifier" && optStr base "name" == some "this"
          let env ← get
          let isLibrary := match env.funContractId.find? reference.toNat with
            | some cid => env.contractKinds.find? cid == some "library"
            | none => false
          unless isThis || isLibrary do
            failAt callee "external contract calls are outside this slice"
        unless visibility == "internal" || visibility == "private" ||
            (visibility == "public" && internalCallee) || linkedLibraryCall do
          failAt callee "discarded helper calls require an internal or private declaration"
        let rets ← mArr (← mField (← mField declaration "returnParameters") "parameters")
        if rets.isEmpty then
          let (fnId, vals) ← resolveCallTargetAndArgs expression
          return ← inlineVoidFn fnId vals expression
        if rets.size == 1 then
          let r := rets[0]!
          let rloc := optStr r "storageLocation" |>.getD "default"
          let rty ← mType r
          -- A discarded `string` / `bytes memory` helper inlines through `inlineStringFn`
          -- whether its result is named or not, for every state-variable count (#2830).
          if rloc == "memory" && (rty == "string" || rty == "bytes") then
            let (fnId, vals) ← resolveCallTargetAndArgs expression
            let buf ← inlineStringFn fnId vals expression
            let ptrAtom ← atom { pre := #[], expr := buf.pointer }
            let sizeAtom ← atom { pre := #[], expr := buf.size }
            return buf.pre ++ ptrAtom.pre ++ sizeAtom.pre
          if rloc == "memory" && (fixedMemArrayType? rty).isSome then
            let (fnId, vals) ← resolveCallTargetAndArgs expression
            let (arrPre, _) ← inlineFixedArrayFn fnId vals expression
            return arrPre
          if rloc == "memory" then
            if let some (elemStr, _, _, _) ← memArrayElementOf? r then
              let (fnId, vals) ← resolveCallTargetAndArgs expression
              let (arrPre, _) ← inlineArrayFn fnId vals elemStr expression
              return arrPre
          if rloc == "memory" && rty.startsWith "struct " && !rty.contains "[" then
            let (fnId, vals) ← resolveCallTargetAndArgs expression
            let (_, _, structPre, _) ← inlineFlatStructFn fnId vals expression
            return structPre
        if rets.size > 1 then
          let (fnId, vals) ← resolveCallTargetAndArgs expression
          let (multiPre, _) ← inlineMultiFn fnId vals expression
          return multiPre
        -- Materialize even a discarded result: the final expression can itself
        -- read storage or fail. The helper's effect prelude remains ordered.
        let result ← atom (← lowerCall expression)
        return result.pre
  if kind == "FunctionCall" && optStr expression "kind" != some "functionCall" then
    return ← lowerDiscardedValue expression
  if kind != "Assignment" && kind != "UnaryOperation" then
    if kind == "FunctionCall" then
      return ← lowerRequire statement
    return ← lowerDiscardedValue expression
  if kind == "UnaryOperation" &&
      !["delete", "++", "--"].contains (optStr expression "operator" |>.getD "") then
    return ← lowerDiscardedValue expression
  let deleting := kind == "UnaryOperation"
  let operator ← mStr (← mField expression "operator")
  if deleting && (operator == "++" || operator == "--") then
    return (← lowerIncDecExpr expression).pre
  if !deleting && isCompoundAssignOp operator then
    return ← lowerCompoundAssignment expression operator
  unless (deleting && operator == "delete") || (!deleting && operator == "=") do
    failAt expression "only scalar storage assignment and delete are supported"
  let target ← mField expression (if deleting then "subExpression" else "leftHandSide")
  if !deleting && operator == "=" && (← mKind target) == "TupleExpression" then
    if ← mBool (← mField target "isInlineArray") then
      failAt target "inline arrays are outside this slice"
    let cs ← mArr (← mField target "components")
    unless cs.size > 1 && cs.any (!·.isNull) do
      failAt target "tuple assignment requires multiple components"
    let right ← mField expression "rightHandSide"
    let mut expectedTypes : Array (Option String) := #[]
    -- The first result slot of each component: a `string` / `bytes memory`
    -- helper result takes two slots (pointer, size).
    let mut slotOf : Array Nat := #[]
    for c in cs do
      slotOf := slotOf.push expectedTypes.size
      if c.isNull then
        expectedTypes := expectedTypes.push none
      else
        let cty ← mType c
        if cty == "bytes memory" || cty == "string memory" then
          unless (← mKind right) == "FunctionCall" do
            failAt right "a string/bytes tuple assignment component requires a multi-return helper call"
          -- `abi.decode` keeps its own diagnostic: only scalar components decode here.
          if ← isAbiDecodeCall right then
            failAt right "tuple assignment or return from abi.decode only supports scalar components"
          expectedTypes := expectedTypes.push none |>.push none
        else
          expectedTypes := expectedTypes.push (some cty)
    let (callPre, retExprs) ← if (← mKind right) == "TupleExpression" then
        lowerMultiBranch right (some expectedTypes)
      else lowerMultiCall right (some expectedTypes)
    unless expectedTypes.size == retExprs.size do
      -- A helper's string/bytes result takes two slots: an elided component or
      -- a target that is not a `string memory` / `bytes memory` local takes one.
      if retExprs.any (fun (_, ty) => ty == "bytes" || ty == "string") then
        if cs.any (·.isNull) then
          failAt expression "an elided string/bytes tuple component is outside this slice"
        failAt expression "a string/bytes helper result requires a string memory or bytes memory local target"
      failAt expression s!"tuple assignment arity {cs.size} does not match helper return arity {retExprs.size}"
    let mut seenIds : Array Nat := #[]
    let mut assigns : Array Stmt := #[]
    for k in [:cs.size] do
      let c := cs[k]!
      let i := slotOf.getD k k
      if c.isNull then continue
      let cty ← mType c
      if cty == "bytes memory" || cty == "string memory" then
        -- Rebind a writable buffer local (a named result or a non-literal
        -- `bytes` local) to the helper's buffer, as `x = <buffer>` does.
        unless (← mKind c) == "Identifier" do
          failAt c "a string/bytes tuple assignment target must be a buffer local"
        let cid ← refInt c
        unless 0 ≤ cid && !seenIds.contains cid.toNat do
          failAt c "duplicate or invalid target in tuple assignment"
        seenIds := seenIds.push cid.toNat
        let baseTy := if cty == "bytes memory" then "bytes" else "string"
        let (ptrExpr, ptrTy) := retExprs.getD i (.literal 0, "")
        let (sizeExpr, sizeTy) := retExprs.getD (i + 1) (.literal 0, "")
        unless ptrTy == baseTy && sizeTy == "uint256" do
          failAt c s!"{cty} tuple assignment target does not match the helper result type {ptrTy}"
        let cname ← mStr (← mField c "name")
        let some buf := (← get).byteBuffers.find? cid.toNat
          | failAt c "only a rebindable string/bytes local can be a tuple assignment target"
        unless (← get).nonLiteralByteLocals.contains cid.toNat && !(← get).yulNames.contains cname do
          failAt c "only a rebindable string/bytes local can be a tuple assignment target"
        let (.localVar ptrBinding, .localVar sizeBinding) := (buf.pointer, buf.size)
          | failAt c "only a rebindable string/bytes local can be a tuple assignment target"
        assigns := assigns ++ #[.assignVar ptrBinding ptrExpr, .assignVar sizeBinding sizeExpr]
        continue
      if (← mKind c) == "MemberAccess" then
        let (retExpr, retTy) := retExprs.getD i (.literal 0, "")
        let converted ← atom (← convert cty retTy { pre := #[], expr := retExpr } c)
        let member ← mStr (← mField c "memberName")
        match ← lowerRef (← mField c "expression") with
        | .flatStruct structLocalId =>
            rejectByRefStructWrite structLocalId c
            let some flat := (← get).flatStructs.find? structLocalId
              | failAt c "unknown flat struct local"
            let some (_, mTy, binding) := flat.members.find? (fun (mName, _, _) => mName == member)
              | failAt c s!"unknown flat struct member {member}"
            let stored := cleanHelperResultExpr mTy converted
            assigns := assigns ++ converted.pre |>.push (.assignVar binding stored)
        | .path pre path =>
            if let .rawSlot structId baseSlot := path then
              let rawInfo ← resolveRawStructInfo structId c
              let some mInfo := rawInfo.scalars.find? (·.member == member)
                | failAt c s!"member {member} is unsupported in raw-slot struct"
              let writeStmts ← writeRawStructScalar #[] baseSlot mInfo converted.expr false
              assigns := assigns ++ converted.pre ++ pre ++ writeStmts
            else
              let (rawField, count, write) ← match path with
                | .zero rawField =>
                    let (field, subPrefix) := splitSPathField rawField
                    let qualMember := qualifySPathMember subPrefix member
                    pure (rawField, 0, fun (value : Expr) => Stmt.setStorage (topStructMemberFieldName field qualMember) value)
                | .one rawField key =>
                    let (field, subPrefix) := splitSPathField rawField
                    let qualMember := qualifySPathMember subPrefix member
                    pure (rawField, 1, fun (value : Expr) => Stmt.setStructMember field key qualMember value)
                | .two rawField key1 key2 =>
                    let (field, subPrefix) := splitSPathField rawField
                    let qualMember := qualifySPathMember subPrefix member
                    pure (rawField, 2, fun (value : Expr) => Stmt.setStructMember2 field key1 key2 qualMember value)
                | .outer _ _ => failAt c "member assignment requires both mapping keys"
                | .rawSlot _ _ | .bytesSlot _ _ => failAt c "member assignment requires a mapping struct storage path"
              let (name, subPrefix) := splitSPathField rawField
              let qualMember := qualifySPathMember subPrefix member
              let info ← resolveField name c
              if info.structMappings.any (·.member == qualMember) then
                failAt c s!"struct mapping member {member} requires a mapping key"
              if info.opaqueNames.contains qualMember then failAt c s!"member {member} is opaque in this slice"
              if info.structFixedArrays.any (·.member == qualMember) then
                failAt c s!"struct fixed array member {member} requires an element index"
              if info.structDynamicArrays.any (·.member == qualMember) then
                failAt c s!"struct dynamic array member {member} requires an element index"
              if !pre.isEmpty && !pre.all isStorageKeyCaptureStmt then
                failAt c "member write key prelude is unsupported"
              unless !info.scalarMapping && info.keyCount == count && info.memberNames.contains qualMember do
                failAt c "member assignment requires a supported layout member"
              unless (paramType cty).isSome do
                failAt c "member assignment requires a supported scalar member"
              let (enumPre, checkedExpr) ← validateEnumExpr c cty converted.expr
              let converted : Val := { pre := converted.pre ++ enumPre, expr := checkedExpr }
              let write := fun (value : Expr) =>
                write (cleanHelperResultExpr cty { pre := #[], expr := value })
              markField name
              assigns := assigns ++ pre ++ converted.pre |>.push (write converted.expr)
        | _ => failAt c "member assignment requires a mapping struct storage path"
      else do
        unless (← mKind c) == "Identifier" do
          failAt c "tuple assignment target must be a scalar local or storage identifier"
