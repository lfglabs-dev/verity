            let indexExpression ← mField target "indexExpression"
            if statefulCallIn indexExpression (← get) || assignmentIn indexExpression then
              failAt target "stateful or assignment array index is unsupported"
            let indexTy ← mType indexExpression
            unless indexTy.startsWith "uint" || indexTy.startsWith "int_const" do
              failAt target "byte buffer index must be unsigned"
            let value ← if deleting then pure ({ pre := #[], expr := (.literal 0 : Expr) } : Val) else do
              let right ← mField expression "rightHandSide"
              let innerRight ← stripParens right
              if (← mKind innerRight) == "Literal" then
                let rkind ← mStr (← mField innerRight "kind")
                if rkind == "string" || rkind == "unicodeString" || rkind == "hexString" then
                  let hex ← mStr (← mField innerRight "hexValue")
                  unless hex.length == 2 || hex.length == 0 do
                    failAt right s!"bytes1 string literal requires at most 1 byte, found {hex.length / 2}"
                  let byteVal ← if hex.isEmpty then pure 0 else
                    match Compiler.Hex.parseHexNat? ("0x" ++ hex) with
                    | some n => pure n
                    | none => failAt right "invalid bytes1 literal hexValue"
                  pure ({ pre := #[], expr := .literal (byteVal * 2 ^ 248) } : Val)
                else
                  failAt right "byte buffer element assignment requires a bytes1 value"
              else
                let rTy ← mType right
                unless rTy == "bytes1" do
                  failAt right s!"byte buffer element assignment requires a bytes1 value, found {rTy}"
                atom (← lowerExpr right)
            let key ← atom (← lowerConverted "uint256" indexExpression)
            let addr := Expr.add buf.pointer key.expr
            let wordAddr := AbiEncoding.byteWordOffset addr
            let shiftBits := Expr.mul (.sub (.literal 31) (AbiEncoding.byteLane addr)) (.literal 8)
            let topByte := Expr.bitAnd (.shr (.literal 248) value.expr) (.literal 0xff)
            let byteMask := Expr.shl shiftBits (.literal 0xff)
            let clearedWord := Expr.bitAnd (.mload wordAddr) (.bitNot byteMask)
            let updatedWord := if deleting then clearedWord else Expr.bitOr clearedWord (.shl shiftBits topByte)
            return (value.pre ++ key.pre).push (.ite (.lt key.expr buf.size)
              [] [.panicCode (.literal 0x32)]) |>.push
              (.mstore wordAddr updatedWord)
    let reference ← lowerRef target
    if let .fixedElement pre path index := reference then
      -- Under the pinned via-IR profile, assignment evaluates and captures
      -- the RHS before the LHS mapping keys and index, then checks bounds.
      -- lowerRef captures the keys/index in their recursive source order.
      let (name, count, write) ← match path with
        | .zero name => pure (name, 0, fun member value => Stmt.setStorage (topStructMemberFieldName (splitSPathField name).1 member) value)
        | .one name key => pure (name, 1, fun member value => Stmt.setStructMember name key member value)
        | .two name key1 key2 => pure (name, 2, fun member value => Stmt.setStructMember2 name key1 key2 member value)
        | .outer _ _ => failAt target "fixed array write requires both mapping keys"
        | .rawSlot _ _ | .bytesSlot _ _ => failAt target "fixed array write on raw-slot struct is outside this slice"
      let info ← resolveField name target
      let some length := info.fixedArrayLength | failAt target "missing fixed array layout"
      unless info.keyCount == count do failAt target "fixed array mapping key count differs"
      let value ← if deleting then pure ({ pre := #[], expr := (.literal 0 : Expr) } : Val) else do
        let right ← mField expression "rightHandSide"
        atom (← lowerConverted (← mType target) right)
      let capturedValue ← fresh
      let valuePre := value.pre.push (.letVar capturedValue value.expr)
      let mut result := (valuePre ++ pre).push (.ite (.lt index (.literal length))
        [] [.panicCode (.literal 0x32)])
      for i in [:length] do
        result := result.push (.ite (.eq index (.literal i))
          [write s!"__solidity_element_{i}" (.localVar capturedValue)] [])
      markField name
      return result
    if let .structFixedElement pre (.rawSlot _ baseSlot) arrInfo index := reference then
      -- As the dynamic array element below: the right-hand side first, then the index and
      -- the bounds check, then the lane write.
      if !deleting then
        if memoryWriteOrderHazard target (← mField expression "rightHandSide") (← get) then
          failAt target "memory-writing helper right-hand side with a memory-reading index or key is unsupported"
      let value ← if deleting then pure ({ pre := #[], expr := (.literal 0 : Expr) } : Val) else do
        let right ← mField expression "rightHandSide"
        atom (← lowerConverted arrInfo.elemType right)
      if !pre.isEmpty && !deleting then
        let right ← mField expression "rightHandSide"
        if assignmentIn right || statefulCallIn right (← get) then
          failAt target "struct fixed array write index prelude with stateful RHS is unsupported"
      let value ← if deleting then pure value else captureAssignedValue value
      return ← writeRawFixedArrayElement (value.pre ++ pre)
        (rawStructMemberSlot baseSlot arrInfo.wordOffset) arrInfo index value.expr deleting
    if let .structFixedElement pre path arrInfo index := reference then
      let (rawName, count, write) ← match path with
        | .zero rawName => pure (rawName, 0, fun member value => Stmt.setStorage (topStructMemberFieldName (splitSPathField rawName).1 member) value)
        | .one rawName key => pure (rawName, 1, fun member value => Stmt.setStructMember (splitSPathField rawName).1 key member value)
        | .two rawName key1 key2 => pure (rawName, 2, fun member value => Stmt.setStructMember2 (splitSPathField rawName).1 key1 key2 member value)
        | .outer _ _ => failAt target "fixed array write requires both mapping keys"
        | .rawSlot _ _ | .bytesSlot _ _ => failAt target "fixed array write on raw-slot struct is outside this slice"
      let (name, _) := splitSPathField rawName
      let info ← resolveField name target
      unless info.keyCount == count do failAt target "fixed array mapping key count differs"
      let value ← if deleting then pure ({ pre := #[], expr := (.literal 0 : Expr) } : Val) else do
        let right ← mField expression "rightHandSide"
        atom (← lowerConverted (← mType target) right)
      let capturedValue ← fresh
      let valuePre := value.pre.push (.letVar capturedValue value.expr)
      let mut result := (valuePre ++ pre).push (.ite (.lt index (.literal arrInfo.length))
        [] [.panicCode (.literal 0x32)])
      for i in [:arrInfo.length] do
        result := result.push (.ite (.eq index (.literal i))
          [write s!"__solidity_struct_array_{arrInfo.member}_{i}" (.localVar capturedValue)] [])
      markField name
      markStructFixedArray name arrInfo.member
      return result
    -- solc evaluates the right-hand side before the target's keys. The scalar
    -- mapping and dynamic array paths below emit the captured right-hand side
    -- first; this guard is kept as a conservative check for the other paths.
    if !deleting then
      if memoryWriteOrderHazard target (← mField expression "rightHandSide") (← get) then
        failAt target "memory-writing helper right-hand side with a memory-reading index or key is unsupported"
    if let .structDynamicElement pre path dynInfo index := reference then
      let value ← if deleting then pure ({ pre := #[], expr := (.literal 0 : Expr) } : Val) else do
        let right ← mField expression "rightHandSide"
        atom (← lowerConverted dynInfo.elemType right)
      if !pre.isEmpty && !deleting then
        let right ← mField expression "rightHandSide"
        if assignmentIn right || statefulCallIn right (← get) then
          failAt target "struct dynamic array write index prelude with stateful RHS is unsupported"
      let value ← if deleting then pure value else captureAssignedValue value
      let (slotPre, arrSlot) ← resolveStructDynamicSlot path dynInfo target
      return ← writeStorageDynamicArrayElement (value.pre ++ pre ++ slotPre) "" arrSlot dynInfo.elemType index value.expr deleting
    if let .storageDynamicElement pre fieldName slotExpr elemTy index := reference then
      let value ← if deleting then pure ({ pre := #[], expr := (.literal 0 : Expr) } : Val) else do
        let right ← mField expression "rightHandSide"
        atom (← lowerConverted elemTy right)
      if !pre.isEmpty && !deleting then
        let right ← mField expression "rightHandSide"
        if assignmentIn right || statefulCallIn right (← get) then
          failAt target "storage dynamic array write index prelude with stateful RHS is unsupported"
      let value ← if deleting then pure value else captureAssignedValue value
      return ← writeStorageDynamicArrayElement (value.pre ++ pre) fieldName slotExpr elemTy index value.expr deleting
    if let .structMappingElement pre path mapInfo key := reference then
      let value ← if deleting then pure ({ pre := #[], expr := (.literal 0 : Expr) } : Val) else do
        let right ← mField expression "rightHandSide"
        validateStoredEnumValue target right (← atom (← lowerConverted (← mType target) right))
      if !pre.isEmpty && !deleting then
        let right ← mField expression "rightHandSide"
        if assignmentIn right || (assignmentIn target && statefulCallIn right (← get)) then
          failAt target "struct mapping write key prelude with stateful RHS is unsupported"
      let value ← if deleting then pure value else captureAssignedValue value
      return ← writeStructMappingElement (value.pre ++ pre) path mapInfo key value.expr deleting target
    let .path pre path := reference
      | failAt target "mapping assignment target is not a storage path"
    if let .rawSlot _ _ := path then
      return ← writeWholeStorageStruct pre path deleting target expression
    let (name, count, write) ← match path with
      | .zero field => pure ((splitSPathField field).1, 0, fun (value : Expr) => Stmt.setStorage (topStructMemberFieldName (splitSPathField field).1 "__solidity_value") value)
      | .one field key => pure ((splitSPathField field).1, 1, fun (value : Expr) => Stmt.setStructMember (splitSPathField field).1 key "__solidity_value" value)
      | .two field key1 key2 => pure ((splitSPathField field).1, 2, fun (value : Expr) => Stmt.setStructMember2 (splitSPathField field).1 key1 key2 "__solidity_value" value)
      | .outer _ _ => failAt target "mapping assignment requires both keys"
      | .rawSlot _ _ | .bytesSlot _ _ => failAt target "mapping assignment target is not a storage path"
    let info ← resolveField name target
    if info.bytesStorage && info.keyCount == count then
      markField name
      let (slotStmts, slotExpr) ← computeSPathBaseSlot path info 0 target
      if deleting then
        return ← lowerStorageBytesDelete (pre ++ slotStmts) "" slotExpr
      checkStorageBytesSourceOrder pre target (← mField expression "rightHandSide")
      let right ← mField expression "rightHandSide"
      if !pre.isEmpty && (assignmentIn right || statefulCallIn right (← get)) then
        failAt target "mapping bytes/string write key prelude with stateful RHS is unsupported"
      return ← lowerStorageBytesWrite "" (pre ++ slotStmts) target right slotExpr (some info.stringStorage)
    if !info.scalarMapping && (info.fixedArrayLength.isNone || deleting) && info.keyCount == count then
      return ← writeWholeStorageStruct pre path deleting target expression
    unless info.scalarMapping && info.keyCount == count do
      failAt target "only scalar mapping values are writable"
    markField name
    let value ← if deleting then pure ({ pre := #[], expr := (.literal 0 : Expr) } : Val) else do
      let right ← mField expression "rightHandSide"
      atom (← lowerConverted (← mType target) right)
    let value ← if deleting then pure value else captureAssignedValue value
    let targetTy ← mType target
    let expr := if deleting then value.expr else cleanHelperResultExpr targetTy value
    return (value.pre ++ pre).push (write expr)
  unless (← mKind target) == "Identifier" || (← mKind target) == "FunctionCall" do
    failAt target "only a resolved scalar storage identifier is writable"
  match ← lowerRef target with
  | .path pre (.bytesSlot (fieldName, slotExpr) isString) =>
      if deleting then
        return ← lowerStorageBytesDelete pre fieldName slotExpr
      let right ← mField expression "rightHandSide"
      if !pre.isEmpty && (assignmentIn right || statefulCallIn right (← get)) then
        failAt target "storage bytes/string write prelude with stateful RHS is unsupported"
      checkStorageBytesSourceOrder pre target right
      return ← lowerStorageBytesWrite fieldName pre target right slotExpr (some isString)
  | .path pre path =>
      return ← writeWholeStorageStruct pre path deleting target expression
  | .structDynamicArray pre (.rawSlot 0 slotExpr) dynInfo =>
      if deleting then
        return ← deleteStorageDynamicArray pre "" slotExpr dynInfo.elemType dynInfo.elemStructId
      else
        failAt target "whole dynamic storage array assignment is unsupported"
  | .state name pre =>
      let info ← resolveField name target
      unless info.keyCount == 0 do failAt target "whole mapping assignment is unsupported"
      if let some (elemTy, _, _) := info.dynamicArrayElemType then
        if deleting then
          return ← deleteStorageDynamicArray pre name (.literal info.slot) elemTy info.dynamicArrayStructId
        else
          failAt target "whole dynamic storage array assignment is unsupported"
      if info.bytesStorage then
        if deleting then
          return ← lowerStorageBytesDelete pre name (.literal info.slot)
        else
          let right ← mField expression "rightHandSide"
          return ← lowerStorageBytesWrite name pre target right
      markField name
      let value ← if deleting then pure ({ pre := #[], expr := .literal 0 } : Val) else do
        let right ← mField expression "rightHandSide"
        atom (← lowerConverted (← mType target) right)
      let targetTy ← mType target
      let stored := if deleting then value.expr else cleanHelperResultExpr targetTy value
      return (pre ++ value.pre).push (.setStorage name stored)
  | _ => failAt target "assignment target is not scalar storage"

private partial def combineCompound (operator : String) (ty : String) (lhs rhs : Expr) (at_ : Json) : M Val := do
  let isUnchecked := (← get).unchecked
  if ty == "int256" || ty == "int" then
    if operator == "+=" then
      if isUnchecked then
        pure { pre := #[], expr := .add lhs rhs }
      else
        checkedSignedAdd { pre := #[], expr := lhs } { pre := #[], expr := rhs }
    else if operator == "-=" then
      if isUnchecked then
        pure { pre := #[], expr := .sub lhs rhs }
      else
        checkedSignedSub { pre := #[], expr := lhs } { pre := #[], expr := rhs }
    else if operator == "*=" then
      if isUnchecked then
        pure { pre := #[], expr := .mul lhs rhs }
      else
        checkedSignedMul { pre := #[], expr := lhs } { pre := #[], expr := rhs }
    else if operator == "/=" then
      signedDiv isUnchecked { pre := #[], expr := lhs } { pre := #[], expr := rhs }
    else if operator == "%=" then
      signedModulo { pre := #[], expr := lhs } { pre := #[], expr := rhs }
    else if operator == "<<=" then
      pure { pre := #[], expr := .shl rhs lhs }
    else if operator == ">>=" then
      pure { pre := #[], expr := .sar rhs lhs }
    else if operator == "&=" then
      pure { pre := #[], expr := .bitAnd lhs rhs }
    else if operator == "|=" then
      pure { pre := #[], expr := .bitOr lhs rhs }
    else if operator == "^=" then
      pure { pre := #[], expr := .bitXor lhs rhs }
    else
      failAt at_ s!"unsupported compound assignment operator {operator}"
  else if ty == "bytes32" then
    if operator == "&=" then
      pure { pre := #[], expr := .bitAnd lhs rhs }
    else if operator == "|=" then
      pure { pre := #[], expr := .bitOr lhs rhs }
    else if operator == "^=" then
      pure { pre := #[], expr := .bitXor lhs rhs }
    else if operator == "<<=" then
      pure { pre := #[], expr := .shl rhs lhs }
    else if operator == ">>=" then
      pure { pre := #[], expr := .shr rhs lhs }
    else
      failAt at_ s!"unsupported compound assignment operator {operator} for {ty}"
  else if (fixedBytesWidth? ty).any (· < 32) then
    let clean (e : Expr) := cleanHelperResultExpr ty { pre := #[], expr := e }
    if operator == "&=" then
      pure { pre := #[], expr := clean (.bitAnd lhs rhs) }
    else if operator == "|=" then
      pure { pre := #[], expr := clean (.bitOr lhs rhs) }
    else if operator == "^=" then
      pure { pre := #[], expr := clean (.bitXor lhs rhs) }
    else if operator == "<<=" then
      pure { pre := #[], expr := clean (.shl rhs (clean lhs)) }
    else if operator == ">>=" then
      pure { pre := #[], expr := clean (.shr rhs (clean lhs)) }
    else
      failAt at_ s!"unsupported compound assignment operator {operator} for {ty}"
  else if let some sbits := (if ty.startsWith "int" then signedBitsOf ty else none) then
    -- `int256`/`int` are handled above, so `sbits < 256`. solc cleans both operands
    -- (`cleanup_t_intN`, a sign extension) before the arithmetic; an operand can be dirty, e.g. a
    -- narrow signed local assigned in Yul. The raw word sum/difference of the cleaned operands is
    -- exact; it fits `intN` iff it equals its own sign extension. Checked code panics with 0x11
    -- otherwise, as solc does.
    unless sbits < 256 && (operator == "+=" || operator == "-=") do
      failAt at_ s!"unsupported compound assignment operator {operator} for {ty}"
    let extend (e : Expr) : Expr := .signextend (.literal (sbits / 8 - 1)) e
    let raw := if operator == "+=" then Expr.add (extend lhs) (extend rhs)
      else Expr.sub (extend lhs) (extend rhs)
    if isUnchecked then
      pure { pre := #[], expr := extend raw }
    else
      let rawVar ← fresh
      let dest ← fresh
      let check := iteStmt (.eq (.localVar rawVar) (extend (.localVar rawVar)))
        (.assignVar dest (.localVar rawVar)) overflowPanic
      pure { pre := #[.letVar rawVar raw, .letVar dest (.literal 0), check], expr := .localVar dest }
  else
    let some bits := bitsOf ty
      | failAt at_ s!"compound assignment requires an integer type, found {ty}"
    unless ty.startsWith "uint" do
      failAt at_ s!"compound assignment requires an integer type, found {ty}"
    let canonical (word : Expr) := if bits < 256 then Expr.bitAnd word (.literal (2 ^ bits - 1)) else word
    let lhs := canonical lhs
    let rhs := if ["<<=", ">>="].contains operator then rhs else canonical rhs
    if operator == "+=" then
      if isUnchecked then
        let wrapped := if bits < 256 then Expr.bitAnd (.add lhs rhs) (.literal (2 ^ bits - 1)) else .add lhs rhs
        pure { pre := #[], expr := wrapped }
      else
        checkedAdd bits { pre := #[], expr := lhs } { pre := #[], expr := rhs }
    else if operator == "-=" then
      if isUnchecked then
        let wrapped := if bits < 256 then Expr.bitAnd (.sub lhs rhs) (.literal (2 ^ bits - 1)) else .sub lhs rhs
        pure { pre := #[], expr := wrapped }
      else
        checkedSub { pre := #[], expr := lhs } { pre := #[], expr := rhs }
    else if operator == "*=" then
      if isUnchecked then
        let wrapped := if bits < 256 then Expr.bitAnd (.mul lhs rhs) (.literal (2 ^ bits - 1)) else .mul lhs rhs
        pure { pre := #[], expr := wrapped }
      else
        checkedMul bits { pre := #[], expr := lhs } { pre := #[], expr := rhs }
    else if operator == "/=" then
      checkedDiv { pre := #[], expr := lhs } { pre := #[], expr := rhs }
    else if operator == "%=" then
      checkedModulo { pre := #[], expr := lhs } { pre := #[], expr := rhs }
    else if operator == "<<=" then
      let shifted := if bits < 256 then Expr.bitAnd (.shl rhs lhs) (.literal (2 ^ bits - 1)) else .shl rhs lhs
      pure { pre := #[], expr := shifted }
    else if operator == ">>=" then
      pure { pre := #[], expr := .shr rhs lhs }
    else if operator == "&=" then
      pure { pre := #[], expr := .bitAnd lhs rhs }
    else if operator == "|=" then
      pure { pre := #[], expr := .bitOr lhs rhs }
    else if operator == "^=" then
      pure { pre := #[], expr := .bitXor lhs rhs }
    else
      failAt at_ s!"unsupported compound assignment operator {operator}"

/-- A stack update, unlike a memory or storage update, need not store a
canonical word. Keep the actual result rather than tracking its provenance. -/
private partial def combineStackCompound (operator ty : String) (lhs rhs : Expr)
    (node : Json) : M Val := do
  let env ← get
  let narrow := (bitsOf ty).getD 256 < 256 || (signedBitsOf ty).getD 256 < 256
  let narrowFixedBytes := (fixedBytesWidth? ty).any (· < 32)
  if (narrow && (ty.startsWith "uint" || (signedBitsOf ty).isSome)) || narrowFixedBytes then
    if !narrowFixedBytes && !env.viaIR && env.unchecked then
      match operator with
      | "+=" => return { pre := #[], expr := .add lhs rhs }
      | "-=" => return { pre := #[], expr := .sub lhs rhs }
      | "*=" => return { pre := #[], expr := .mul lhs rhs }
      | _ => pure ()
    match operator with
    | "|=" => return { pre := #[], expr := .bitOr lhs rhs }
    | "^=" => return { pre := #[], expr := .bitXor lhs rhs }
    | "&=" => return { pre := #[], expr := .bitAnd lhs rhs }
    | "<<=" => if !env.viaIR && !narrowFixedBytes then
        return { pre := #[], expr := .shl rhs (cleanHelperResultExpr ty { pre := #[], expr := lhs }) }
    | _ => pure ()
  combineCompound operator ty lhs rhs node

private partial def lowerCompoundAssignment (expression : Json) (operator : String) : M (Array Stmt) := do
  let target ← mField expression "leftHandSide"
  let right ← mField expression "rightHandSide"
  let isSupportedCompoundTy (ty : String) : Bool :=
    (ty.startsWith "uint" && (bitsOf ty).isSome) || ty == "int256" || ty == "int" ||
      (ty.startsWith "int" && (signedBitsOf ty).isSome) ||
      ((fixedBytesWidth? ty).isSome && ["&=", "|=", "^=", "<<=", ">>="].contains operator)
  let lowerRhs (ty : String) : M Val := do
    let rightTy ← mType right
    let raw ← lowerExpr right
    if operator == "<<=" || operator == ">>=" then
      unless rightTy.startsWith "uint" || (rightTy.startsWith "int_const" && !rightTy.startsWith "int_const -") do
        failAt right s!"shift amount must be unsigned, found {rightTy}"
      atom { raw with expr := cleanHelperResultExpr rightTy raw }
    else
      atom (← convert ty rightTy raw right)
  if (← mKind target) == "Identifier" then
    let id ← refInt target
    if id ≥ 0 then
      if let some bound := (← get).values.find? id.toNat then
        let .localVar binding := bound
          | failAt target "only materialized scalar locals are writable"
        unless (← get).writableLocals.find? id.toNat == some binding do
          failAt target "only declaration-bound scalar locals are writable"
        let ty ← mType target
        unless isSupportedCompoundTy ty do
          failAt target s!"unsupported scalar local compound assignment type {ty}"
        let rhsVal ← lowerRhs ty
        let combined ← combineStackCompound operator ty (.localVar binding) rhsVal.expr expression
        return rhsVal.pre ++ combined.pre |>.push (.assignVar binding combined.expr)
  if (← mKind target) == "IndexAccess" then
    let baseNode ← mField target "baseExpression"
    if (← mKind baseNode) == "Identifier" then
      let baseId ← refInt baseNode
      if baseId ≥ 0 then
        if let some arr := (← get).fixedMemArrays.find? baseId.toNat then
          let indexExpression ← mField target "indexExpression"
          if statefulCallIn indexExpression (← get) || assignmentIn indexExpression then
            failAt target "stateful or assignment array index is unsupported"
          let indexTy ← mType indexExpression
          unless indexTy.startsWith "uint" || indexTy.startsWith "int_const" do
            failAt target "fixed-size memory array index must be unsigned"
          unless isSupportedCompoundTy arr.elementType do
            failAt target s!"unsupported fixed-size memory array compound assignment type {arr.elementType}"
          -- Right-hand side, then the indexed target, then the current value.
          let rhsVal ← lowerRhs arr.elementType
          let key ← atom (← lowerConverted "uint256" indexExpression)
          let addr := fixedMemElementAddr arr key.expr
          let combined ← combineCompound operator arr.elementType (.mload addr) rhsVal.expr expression
          return rhsVal.pre ++ key.pre ++ fixedMemBoundsGuard arr key.expr ++ combined.pre |>.push
            (.mstore addr combined.expr)
        if let some arr := (← get).scalarArrays.find? baseId.toNat then
          if arr.inMemory then
            let indexExpression ← mField target "indexExpression"
            if statefulCallIn indexExpression (← get) || assignmentIn indexExpression then
              failAt target "stateful or assignment array index is unsupported"
            let indexTy ← mType indexExpression
            unless indexTy.startsWith "uint" || indexTy.startsWith "int_const" do
              failAt target "dynamic memory array index must be unsigned"
            unless isSupportedCompoundTy arr.elementType do
              failAt target s!"unsupported dynamic memory array compound assignment type {arr.elementType}"
            -- Right-hand side, then the index and its bounds check, then the
            -- current element.
            let rhsVal ← lowerRhs arr.elementType
            let key ← atom (← lowerConverted "uint256" indexExpression)
            let addr := Expr.add (.add (.localVar arr.memoryPointer) (.literal 32)) (.mul key.expr (.literal 32))
            let combined ← combineCompound operator arr.elementType (.mload addr) rhsVal.expr expression
            return (rhsVal.pre ++ key.pre).push (.ite (.lt key.expr (.localVar arr.lengthBinding))
              [] [.panicCode (.literal 0x32)]) ++ combined.pre |>.push (.mstore addr combined.expr)
  if (← mKind target) == "MemberAccess" then
    let cMember ← mStr (← mField target "memberName")
    match ← lowerRef (← mField target "expression") with
    | .flatStruct structLocalId =>
        rejectByRefStructWrite structLocalId target
        let some flat := (← get).flatStructs.find? structLocalId
          | failAt target "unknown flat struct local"
        let some (_, mTy, binding) := flat.members.find? (fun (mName, _, _) => mName == cMember)
          | failAt target s!"unknown flat struct member {cMember}"
        unless isSupportedCompoundTy mTy do
          failAt target s!"unsupported struct member compound assignment type {mTy}"
        let rhsVal ← lowerRhs mTy
        let combined ← combineCompound operator mTy (.localVar binding) rhsVal.expr expression
        return rhsVal.pre ++ combined.pre |>.push (.assignVar binding combined.expr)
    | .path pre path =>
        if let .rawSlot structId baseSlot := path then
          let rawInfo ← resolveRawStructInfo structId target
          if rawInfo.mappings.any (·.member == cMember) then
            failAt target s!"struct mapping member {cMember} requires a mapping key"
          if rawInfo.dynamicArrays.any (·.member == cMember) then
            failAt target s!"struct dynamic array member {cMember} requires an element index"
          let some mInfo := rawInfo.scalars.find? (·.member == cMember)
            | failAt target s!"member {cMember} is unsupported in raw-slot struct"
          let ty ← mType target
          unless isSupportedCompoundTy ty do
            failAt target s!"unsupported raw-slot struct member compound assignment type {ty}"
          if !pre.isEmpty && (assignmentIn right || statefulCallIn right (← get)) then
            failAt target "raw-slot struct member compound write prelude with stateful RHS is unsupported"
          let rhsVal ← captureAssignedValue (← lowerRhs ty)
          let lhsVal ← readRawStructScalar pre baseSlot mInfo
          let combined ← combineCompound operator ty lhsVal.expr rhsVal.expr expression
          let writeStmts ← writeRawStructScalar #[] baseSlot mInfo combined.expr false
          return rhsVal.pre ++ lhsVal.pre ++ combined.pre ++ writeStmts
        -- solc evaluates the right-hand side before the target's keys; this path
        -- captures the keys first, which a memory-writing helper can observe.
        if memoryWriteOrderHazard target right (← get) then
          failAt target "memory-writing helper right-hand side with a memory-reading member key is unsupported"
        if !pre.all isStorageKeyCaptureStmt ||
            (!pre.isEmpty && (assignmentIn right || statefulCallIn right (← get))) then
          failAt target "member write key prelude is unsupported"
        let (rawField, count, read, write) ← match path with
          | .zero rawField =>
              let (cField, subPrefix) := splitSPathField rawField
              let qualMember := qualifySPathMember subPrefix cMember
              pure (rawField, 0, Expr.storage (topStructMemberFieldName cField qualMember), fun (cVal : Expr) => Stmt.setStorage (topStructMemberFieldName cField qualMember) cVal)
          | .one rawField cKey =>
              let (cField, subPrefix) := splitSPathField rawField
              let qualMember := qualifySPathMember subPrefix cMember
              pure (rawField, 1, Expr.structMember cField cKey qualMember, fun (cVal : Expr) => Stmt.setStructMember cField cKey qualMember cVal)
          | .two rawField cKey1 cKey2 =>
              let (cField, subPrefix) := splitSPathField rawField
              let qualMember := qualifySPathMember subPrefix cMember
              pure (rawField, 2, Expr.structMember2 cField cKey1 cKey2 qualMember, fun (cVal : Expr) => Stmt.setStructMember2 cField cKey1 cKey2 qualMember cVal)
          | .outer _ _ => failAt target "member assignment requires both mapping keys"
          | .rawSlot _ _ | .bytesSlot _ _ => failAt target "member assignment requires a mapping struct storage path"
        let (name, subPrefix) := splitSPathField rawField
        let qualMember := qualifySPathMember subPrefix cMember
        let info ← resolveField name target
        if info.structMappings.any (·.member == qualMember) then
          failAt target s!"struct mapping member {cMember} requires a mapping key"
        if info.opaqueNames.contains qualMember then failAt target s!"member {cMember} is opaque in this slice"
        if info.structFixedArrays.any (·.member == qualMember) then
          failAt target s!"struct fixed array member {cMember} requires an element index"
        if info.structDynamicArrays.any (·.member == qualMember) then
          failAt target s!"struct dynamic array member {cMember} requires an element index"
        unless !info.scalarMapping && info.keyCount == count && info.memberNames.contains qualMember do
          failAt target "member assignment requires a supported layout member"
        let ty ← mType target
        unless ty.startsWith "uint" && (bitsOf ty).isSome do
          failAt target "member assignment requires an unsigned scalar member"
        markField name
        let rhsVal ← lowerRhs ty
        let lhsVar ← fresh
        let combined ← combineCompound operator ty (.localVar lhsVar) rhsVal.expr expression
        return (pre ++ rhsVal.pre).push (.letVar lhsVar read) ++ combined.pre |>.push (write combined.expr)
    | _ => failAt target "member assignment requires a mapping struct storage path"
  if (← mKind target) == "IndexAccess" then
    let reference ← lowerRef target
    if let .fixedElement _ _ _ := reference then
      failAt expression "only scalar storage assignment and delete are supported"
    if let .structFixedElement pre (.rawSlot _ baseSlot) arrInfo index := reference then
      let ty ← mType target
      unless isSupportedCompoundTy ty do
        failAt target s!"unsupported fixed array compound assignment type {ty}"
      if !pre.isEmpty && (assignmentIn right || statefulCallIn right (← get)) then
        failAt target "compound fixed array write index prelude with stateful RHS is unsupported"
      let rhsVal ← captureAssignedValue (← lowerRhs ty)
      let arrSlot := rawStructMemberSlot baseSlot arrInfo.wordOffset
      let lhsVal ← readRawFixedArrayElement pre arrSlot arrInfo index
      let combined ← combineCompound operator ty lhsVal.expr rhsVal.expr expression
      let writeStmts ← writeRawFixedArrayElement #[] arrSlot arrInfo index combined.expr false
      return rhsVal.pre ++ lhsVal.pre ++ combined.pre ++ writeStmts
    if let .structFixedElement _ _ _ _ := reference then
      failAt expression "only scalar storage assignment and delete are supported"
    if let .structDynamicElement pre path dynInfo index := reference then
      let ty ← mType target
      unless isSupportedCompoundTy ty do
        failAt target s!"unsupported dynamic array compound assignment type {ty}"
      if !pre.isEmpty && (assignmentIn right || statefulCallIn right (← get)) then
        failAt target "compound dynamic array write index prelude with stateful RHS is unsupported"
      let rhsVal ← captureAssignedValue (← lowerRhs ty)
      let (slotPre, arrSlot) ← resolveStructDynamicSlot path dynInfo target
      let lhsVal ← readStorageDynamicArrayElement (pre ++ slotPre) "" arrSlot dynInfo.elemType index
      let combined ← combineCompound operator ty lhsVal.expr rhsVal.expr expression
      let writeStmts ← writeStorageDynamicArrayElement #[] "" arrSlot dynInfo.elemType index combined.expr false
      return rhsVal.pre ++ lhsVal.pre ++ combined.pre ++ writeStmts
    if let .storageDynamicElement pre fieldName slotExpr elemTy index := reference then
      let ty ← mType target
      unless isSupportedCompoundTy ty do
        failAt target s!"unsupported dynamic array compound assignment type {ty}"
      if !pre.isEmpty && (assignmentIn right || statefulCallIn right (← get)) then
        failAt target "compound dynamic array write index prelude with stateful RHS is unsupported"
      let rhsVal ← captureAssignedValue (← lowerRhs ty)
      let lhsVal ← readStorageDynamicArrayElement pre fieldName slotExpr elemTy index
      let combined ← combineCompound operator ty lhsVal.expr rhsVal.expr expression
      let writeStmts ← writeStorageDynamicArrayElement #[] fieldName slotExpr elemTy index combined.expr false
      return rhsVal.pre ++ lhsVal.pre ++ combined.pre ++ writeStmts
    if let .structMappingElement pre path mapInfo key := reference then
      let ty ← mType target
      unless isSupportedCompoundTy ty do
        failAt target s!"unsupported mapping compound assignment type {ty}"
      if !pre.isEmpty && (assignmentIn right || statefulCallIn right (← get)) then
        failAt target "compound mapping write key prelude with stateful RHS is unsupported"
      let rhsVal ← captureAssignedValue (← lowerRhs ty)
      let lhsVal ← readStructMappingElement pre path mapInfo key target
      let combined ← combineCompound operator ty lhsVal.expr rhsVal.expr expression
      let writeStmts ← writeStructMappingElement #[] path mapInfo key combined.expr false target
      return rhsVal.pre ++ lhsVal.pre ++ combined.pre ++ writeStmts
    -- solc evaluates the right-hand side before the target's keys. This path
    -- emits the captured right-hand side first; the guard is kept as a
    -- conservative check.
    if memoryWriteOrderHazard target right (← get) then
      failAt target "memory-writing helper right-hand side with a memory-reading index or key is unsupported"
    let .path pre path := reference
      | failAt target "mapping assignment target is not a storage path"
    let (name, count, read, write) ← match path with
      | .zero _ => failAt target "only scalar mapping values are writable"
      | .one cField cKey => pure ((splitSPathField cField).1, 1, Expr.structMember (splitSPathField cField).1 cKey "__solidity_value", fun (cVal : Expr) => Stmt.setStructMember (splitSPathField cField).1 cKey "__solidity_value" cVal)
      | .two cField cKey1 cKey2 => pure ((splitSPathField cField).1, 2, Expr.structMember2 (splitSPathField cField).1 cKey1 cKey2 "__solidity_value", fun (cVal : Expr) => Stmt.setStructMember2 (splitSPathField cField).1 cKey1 cKey2 "__solidity_value" cVal)
      | .outer _ _ => failAt target "mapping assignment requires both keys"
      | .rawSlot _ _ | .bytesSlot _ _ => failAt target "only scalar mapping values are writable"
    let info ← resolveField name target
    unless info.scalarMapping && info.keyCount == count do
      failAt target "only scalar mapping values are writable"
    let ty ← mType target
    unless isSupportedCompoundTy ty do
      failAt target s!"unsupported mapping compound assignment type {ty}"
    if !pre.isEmpty && (assignmentIn right || statefulCallIn right (← get)) then
      failAt target "compound mapping write key prelude with stateful RHS is unsupported"
    markField name
    let rhsVal ← captureAssignedValue (← lowerRhs ty)
    let lhsVar ← fresh
    let combined ← combineCompound operator ty (.localVar lhsVar) rhsVal.expr expression
    return (rhsVal.pre ++ pre).push (.letVar lhsVar read) ++ combined.pre |>.push (write combined.expr)
  unless (← mKind target) == "Identifier" do
    failAt target "only a resolved scalar storage identifier is writable"
  let .state name pre ← lowerRef target
    | failAt target "assignment target is not scalar storage"
  let info ← resolveField name target
  unless info.keyCount == 0 do failAt target "whole mapping assignment is unsupported"
  let ty ← mType target
  unless isSupportedCompoundTy ty do
    failAt target s!"unsupported scalar storage compound assignment type {ty}"
  markField name
  let rhsVal ← lowerRhs ty
  let lhsVar ← fresh
  let combined ← combineCompound operator ty (.localVar lhsVar) rhsVal.expr expression
  return (pre ++ rhsVal.pre).push (.letVar lhsVar (.storage name)) ++ combined.pre |>.push (.setStorage name combined.expr)

private partial def lowerAssignmentExpr (j : Json) : M Val := do
  let operator ← mStr (← mField j "operator")
  unless operator == "=" do
    failAt j "compound assignment expressions are outside this slice"
  let target ← mField j "leftHandSide"
  let right ← mField j "rightHandSide"
  unless (← mKind target) == "Identifier" do
    failAt target "assignment expressions currently require a scalar local or storage identifier"
  let id ← refInt target
  if id ≥ 0 then
    if (← get).fnPtrs.contains id.toNat then
      failAt target "reassignment of function pointer locals is outside this slice"
    if let some bound := (← get).values.find? id.toNat then
      let .localVar binding := bound
        | failAt target "only materialized scalar locals are writable"
      unless (← get).writableLocals.find? id.toNat == some binding do
        failAt target "only declaration-bound scalar locals are writable"
      let ty ← mType target
      unless (paramType ty).isSome do
        failAt target s!"unsupported scalar local assignment type {ty}"
      let value ← atom (← lowerConverted ty right)
      return { pre := value.pre.push (.assignVar binding value.expr), expr := .localVar binding }
  let .state name pre ← lowerRef target
    | failAt target "assignment target is not scalar storage"
  let info ← resolveField name target
  unless info.keyCount == 0 do failAt target "whole mapping assignment is unsupported"
  if info.bytesStorage then failAt target "bytes or string storage assignment expression is outside this slice"
  markField name
  let ty ← mType target
  let value ← lowerConverted ty right
  let resultVar ← fresh
  let result := Expr.localVar resultVar
  let stored := cleanHelperResultExpr ty { pre := #[], expr := result }
  return { pre := (pre ++ value.pre).push (.letVar resultVar value.expr) |>.push (.setStorage name stored),
           expr := result }

private partial def lowerIncDecExpr (j : Json) : M Val := do
  let operator ← mStr (← mField j "operator")
  let isPrefix := (field? j "prefix").bind (fun v => v.getBool?.toOption) == some true
  let compoundOp := if operator == "++" then "+=" else "-="
  let env ← get
  -- The write stores the width-limited result on either pipeline. Only the
  -- legacy unchecked prefix expression exposes the unmasked sum/difference.
  let storageResult (ty oldVar newVar : String) : Expr := Id.run do
    let old := Expr.localVar oldVar
    if !isPrefix then return old
    if env.unchecked && !env.viaIR &&
        ((bitsOf ty).getD 256 < 256 || (signedBitsOf ty).getD 256 < 256) then
      let lhs := cleanHelperResultExpr ty { pre := #[], expr := old }
      return if operator == "++" then .add lhs (.literal 1) else .sub lhs (.literal 1)
    return .localVar newVar
  let target ← mField j "subExpression"
  let isSupportedIncDecTy (ty : String) : Bool :=
    (ty.startsWith "uint" && (bitsOf ty).isSome) || ty == "int256" || ty == "int" ||
      (ty.startsWith "int" && (signedBitsOf ty).isSome)
  if (← mKind target) == "Identifier" then
    let id ← refInt target
    if id ≥ 0 then
      if let some bound := (← get).values.find? id.toNat then
        let .localVar binding := bound
          | failAt target "only materialized scalar locals are writable"
        unless (← get).writableLocals.find? id.toNat == some binding do
          failAt target "only declaration-bound scalar locals are writable"
        let ty ← mType target
        unless isSupportedIncDecTy ty do
          failAt target s!"unsupported scalar local increment/decrement type {ty}"
        let oldVar ← fresh
        let combined ← combineStackCompound compoundOp ty (.localVar oldVar) (.literal 1) j
        let stmts := #[Stmt.letVar oldVar (.localVar binding)] ++ combined.pre |>.push (.assignVar binding combined.expr)
        return { pre := stmts, expr := if isPrefix then .localVar binding else .localVar oldVar }
  if (← mKind target) == "MemberAccess" then
    let cMember ← mStr (← mField target "memberName")
    match ← lowerRef (← mField target "expression") with
    | .flatStruct structLocalId =>
        rejectByRefStructWrite structLocalId target
        let some flat := (← get).flatStructs.find? structLocalId
          | failAt target "unknown flat struct local"
        let some (_, mTy, binding) := flat.members.find? (fun (mName, _, _) => mName == cMember)
          | failAt target s!"unknown flat struct member {cMember}"
        unless isSupportedIncDecTy mTy do
          failAt target s!"unsupported struct member increment/decrement type {mTy}"
        let oldVar ← fresh
        let combined ← combineCompound compoundOp mTy (.localVar oldVar) (.literal 1) j
        let stmts := #[Stmt.letVar oldVar (.localVar binding)] ++ combined.pre |>.push (.assignVar binding combined.expr)
        return { pre := stmts, expr := if isPrefix then .localVar binding else .localVar oldVar }
    | .path pre path =>
        if let .rawSlot structId baseSlot := path then
          let rawInfo ← resolveRawStructInfo structId target
          if rawInfo.mappings.any (·.member == cMember) then
            failAt target s!"struct mapping member {cMember} requires a mapping key"
          if rawInfo.dynamicArrays.any (·.member == cMember) then
            failAt target s!"struct dynamic array member {cMember} requires an element index"
          let some mInfo := rawInfo.scalars.find? (·.member == cMember)
            | failAt target s!"member {cMember} is unsupported in raw-slot struct"
          let ty ← mType target
          unless isSupportedIncDecTy ty do
            failAt target s!"unsupported raw-slot struct member increment/decrement type {ty}"
          let lhsVal ← readRawStructScalar pre baseSlot mInfo
          let oldVar ← fresh
          let newVar ← fresh
          let combined ← combineCompound compoundOp ty (.localVar oldVar) (.literal 1) j
          let writeStmts ← writeRawStructScalar #[] baseSlot mInfo (.localVar newVar) false
          let stmts := (lhsVal.pre.push (.letVar oldVar lhsVal.expr) ++
            combined.pre).push (.letVar newVar combined.expr) ++ writeStmts
          return { pre := stmts, expr := storageResult ty oldVar newVar }
        unless pre.all isStorageKeyCaptureStmt do failAt target "member write key prelude is unsupported"
        let (rawField, count, read, write) ← match path with
          | .zero rawField =>
              let (cField, subPrefix) := splitSPathField rawField
              let qualMember := qualifySPathMember subPrefix cMember
              pure (rawField, 0, Expr.storage (topStructMemberFieldName cField qualMember), fun (cVal : Expr) => Stmt.setStorage (topStructMemberFieldName cField qualMember) cVal)
          | .one rawField cKey =>
              let (cField, subPrefix) := splitSPathField rawField
              let qualMember := qualifySPathMember subPrefix cMember
              pure (rawField, 1, Expr.structMember cField cKey qualMember, fun (cVal : Expr) => Stmt.setStructMember cField cKey qualMember cVal)
          | .two rawField cKey1 cKey2 =>
              let (cField, subPrefix) := splitSPathField rawField
              let qualMember := qualifySPathMember subPrefix cMember
              pure (rawField, 2, Expr.structMember2 cField cKey1 cKey2 qualMember, fun (cVal : Expr) => Stmt.setStructMember2 cField cKey1 cKey2 qualMember cVal)
          | .outer _ _ => failAt target "member assignment requires both mapping keys"
          | .rawSlot _ _ | .bytesSlot _ _ => failAt target "member assignment requires a mapping struct storage path"
        let (name, subPrefix) := splitSPathField rawField
        let qualMember := qualifySPathMember subPrefix cMember
        let info ← resolveField name target
        if info.structMappings.any (·.member == qualMember) then
          failAt target s!"struct mapping member {cMember} requires a mapping key"
        if info.opaqueNames.contains qualMember then failAt target s!"member {cMember} is opaque in this slice"
        if info.structFixedArrays.any (·.member == qualMember) then
          failAt target s!"struct fixed array member {cMember} requires an element index"
        if info.structDynamicArrays.any (·.member == qualMember) then
          failAt target s!"struct dynamic array member {cMember} requires an element index"
        unless !info.scalarMapping && info.keyCount == count && info.memberNames.contains qualMember do
          failAt target "member assignment requires a supported layout member"
        let ty ← mType target
        unless ty.startsWith "uint" && (bitsOf ty).isSome do
          failAt target "member assignment requires an unsigned scalar member"
        markField name
        let oldVar ← fresh
        let newVar ← fresh
        let combined ← combineCompound compoundOp ty (.localVar oldVar) (.literal 1) j
        let stmts := (pre.push (.letVar oldVar read)) ++ combined.pre |>.push (.letVar newVar combined.expr) |>.push (write (.localVar newVar))
        return { pre := stmts, expr := storageResult ty oldVar newVar }
    | _ => failAt target "member assignment requires a mapping struct storage path"
  if (← mKind target) == "IndexAccess" then
    let reference ← lowerRef target
    if let .fixedElement _ _ _ := reference then
      failAt j "only scalar storage assignment and delete are supported"
    if let .structFixedElement pre (.rawSlot _ baseSlot) arrInfo index := reference then
      let ty ← mType target
      unless isSupportedIncDecTy ty do
        failAt target s!"unsupported fixed array increment/decrement type {ty}"
      let arrSlot := rawStructMemberSlot baseSlot arrInfo.wordOffset
      let lhsVal ← readRawFixedArrayElement pre arrSlot arrInfo index
      let oldVar ← fresh
      let newVar ← fresh
      let combined ← combineCompound compoundOp ty (.localVar oldVar) (.literal 1) j
      let writeStmts ← writeRawFixedArrayElement #[] arrSlot arrInfo index (.localVar newVar) false
      let stmts := (lhsVal.pre.push (.letVar oldVar lhsVal.expr) ++
        combined.pre).push (.letVar newVar combined.expr) ++ writeStmts
      return { pre := stmts, expr := storageResult ty oldVar newVar }
    if let .structFixedElement _ _ _ _ := reference then
      failAt j "only scalar storage assignment and delete are supported"
    if let .structDynamicElement pre path dynInfo index := reference then
      let ty ← mType target
      unless isSupportedIncDecTy ty do
        failAt target s!"unsupported dynamic array increment/decrement type {ty}"
      let (slotPre, arrSlot) ← resolveStructDynamicSlot path dynInfo target
      let lhsVal ← readStorageDynamicArrayElement (pre ++ slotPre) "" arrSlot dynInfo.elemType index
      let oldVar ← fresh
      let newVar ← fresh
      let combined ← combineCompound compoundOp ty (.localVar oldVar) (.literal 1) j
      let writeStmts ← writeStorageDynamicArrayElement #[] "" arrSlot dynInfo.elemType index (.localVar newVar) false
      let stmts := (lhsVal.pre.push (.letVar oldVar lhsVal.expr) ++
        combined.pre).push (.letVar newVar combined.expr) ++ writeStmts
      return { pre := stmts, expr := storageResult ty oldVar newVar }
    if let .storageDynamicElement pre fieldName slotExpr elemTy index := reference then
      let ty ← mType target
      unless isSupportedIncDecTy ty do
        failAt target s!"unsupported dynamic array increment/decrement type {ty}"
      let lhsVal ← readStorageDynamicArrayElement pre fieldName slotExpr elemTy index
      let oldVar ← fresh
      let newVar ← fresh
      let combined ← combineCompound compoundOp ty (.localVar oldVar) (.literal 1) j
      let writeStmts ← writeStorageDynamicArrayElement #[] fieldName slotExpr elemTy index (.localVar newVar) false
      let stmts := (lhsVal.pre.push (.letVar oldVar lhsVal.expr) ++
        combined.pre).push (.letVar newVar combined.expr) ++ writeStmts
      return { pre := stmts, expr := storageResult ty oldVar newVar }
    if let .structMappingElement pre path mapInfo key := reference then
      let ty ← mType target
      unless isSupportedIncDecTy ty do
        failAt target s!"unsupported mapping increment/decrement type {ty}"
      let lhsVal ← readStructMappingElement pre path mapInfo key target
      let oldVar ← fresh
      let newVar ← fresh
      let combined ← combineCompound compoundOp ty (.localVar oldVar) (.literal 1) j
      let writeStmts ← writeStructMappingElement #[] path mapInfo key (.localVar newVar) false target
      let stmts := (lhsVal.pre.push (.letVar oldVar lhsVal.expr) ++
        combined.pre).push (.letVar newVar combined.expr) ++ writeStmts
      return { pre := stmts, expr := storageResult ty oldVar newVar }
    let .path pre path := reference
      | failAt target "mapping assignment target is not a storage path"
    let (name, count, read, write) ← match path with
      | .zero _ => failAt target "only scalar mapping values are writable"
      | .one cField cKey => pure ((splitSPathField cField).1, 1, Expr.structMember (splitSPathField cField).1 cKey "__solidity_value", fun (cVal : Expr) => Stmt.setStructMember (splitSPathField cField).1 cKey "__solidity_value" cVal)
      | .two cField cKey1 cKey2 => do
          unless pre.isEmpty do failAt target "nested mapping increment/decrement key prelude is unsupported"
          pure ((splitSPathField cField).1, 2, Expr.structMember2 (splitSPathField cField).1 cKey1 cKey2 "__solidity_value", fun (cVal : Expr) => Stmt.setStructMember2 (splitSPathField cField).1 cKey1 cKey2 "__solidity_value" cVal)
      | .outer _ _ => failAt target "mapping assignment requires both keys"
      | .rawSlot _ _ | .bytesSlot _ _ => failAt target "only scalar mapping values are writable"
    let info ← resolveField name target
    unless info.scalarMapping && info.keyCount == count do
      failAt target "only scalar mapping values are writable"
    let ty ← mType target
    unless isSupportedIncDecTy ty do
      failAt target s!"unsupported mapping increment/decrement type {ty}"
    markField name
    let oldVar ← fresh
    let newVar ← fresh
    let combined ← combineCompound compoundOp ty (.localVar oldVar) (.literal 1) j
    let stmts := pre.push (.letVar oldVar read) ++ combined.pre |>.push (.letVar newVar combined.expr) |>.push (write (.localVar newVar))
    return { pre := stmts, expr := storageResult ty oldVar newVar }
  unless (← mKind target) == "Identifier" do
    failAt target "only a resolved scalar storage identifier is writable"
  let .state name pre ← lowerRef target
    | failAt target "assignment target is not scalar storage"
  let info ← resolveField name target
  unless info.keyCount == 0 do failAt target "whole mapping assignment is unsupported"
  let ty ← mType target
  unless isSupportedIncDecTy ty do
    failAt target s!"unsupported scalar storage increment/decrement type {ty}"
  markField name
  let oldVar ← fresh
  let newVar ← fresh
  let combined ← combineCompound compoundOp ty (.localVar oldVar) (.literal 1) j
  let stmts := pre.push (.letVar oldVar (.storage name)) ++ combined.pre |>.push (.letVar newVar combined.expr) |>.push (.setStorage name (.localVar newVar))
  return { pre := stmts, expr := storageResult ty oldVar newVar }

/-- Whether a `revert`/`require` message is a string literal or a literal string
constant, the static `Error(string)` form. -/
private partial def isStaticStringMessage (message : Json) : M Bool := do
  match ← mKind message with
  | "Literal" => return true
  | "Identifier" | "MemberAccess" =>
      let some id := (field? message "referencedDeclaration").bind (·.getInt?.toOption)
        | return false
      return id ≥ 0 && (← get).numericConstants.contains id.toNat
  | _ => return false

/-- `revert(message)` for a computed `string memory` message already evaluated
into `buffer`: `Error(string)` ABI bytes (selector `0x08c379a0`, offset word,
length word, zero-padded bytes) in a fresh buffer, reverted by the closed
memory revert transport. -/
private partial def revertErrorStringBuffer (buffer : EncodedBytes) : M (Array Stmt) := do
  let length ← fresh
  let selectorPointer ← fresh
  let selectorFinish ← fresh
  let headPointer ← fresh
  let headFinish ← fresh
  let mut pre : Array Stmt := #[.letVar length buffer.size]
  pre := pre ++ (AbiEncoding.staticWords selectorPointer selectorFinish
    [.literal (0x08c379a0 * 2 ^ 224)]).toArray
  pre := pre ++ (AbiEncoding.staticWords headPointer headFinish
    [.literal 32, .localVar length]).toArray
  let parts : List (Expr × Expr) := [(.localVar selectorPointer, .literal 4),
    (.localVar headPointer, .literal 64), (buffer.pointer, .localVar length)]
  let size ← fresh
  pre := pre.push (.letVar size (.add (.literal 68)
    (.mul (.div (.add (.localVar length) (.literal 31)) (.literal 32)) (.literal 32))))
  let pointer ← fresh
  let finish ← fresh
  let clearIndex ← fresh
  pre := pre ++ (AbiEncoding.packedBuffer pointer finish clearIndex (.localVar size)).toArray
  let start ← fresh
  pre := pre.push (.letVar start (.literal 0))
  for (source, count) in parts do
    let index ← fresh
    let byteName ← fresh
    let address ← fresh
    pre := pre.push (AbiEncoding.copyBytes source (.localVar pointer) (.localVar start) count
      index byteName address)
    pre := pre.push (.assignVar start (.add (.localVar start) count))
  modify fun e => { e with encodingMemory := true }
  -- The unreachable `revertEmpty` states termination, which `Stmt.ecm`
  -- metadata cannot, for the compiler's exhaustive return analysis.
  return pre ++ #[.ecm Compiler.ECM.SolidityRevertMemory.module
    [.localVar pointer, .localVar size], .revertEmpty]

/-- Evaluate a computed `string memory` revert message into a byte buffer whose
pointer and length are bound before any later evaluation. -/
private partial def lowerRevertMessageBuffer (message : Json) : M EncodedBytes := do
  let ty ← mType message
  -- Storage string messages have no differential fixture in this slice.
  unless ty == "string memory" || ty == "string calldata" do
    failAt message s!"unsupported revert message type {ty}"
  let buffer ← lowerEncodedBytes message
  let pointer ← atom { pre := #[], expr := buffer.pointer }
  let size ← atom { pre := #[], expr := buffer.size }
  return { pre := buffer.pre ++ pointer.pre ++ size.pre, pointer := pointer.expr, size := size.expr }

private partial def extractStringLiteralOrConstant (message : Json) (forRevert : Bool) : M String := do
  let label := if forRevert then "revert" else "require"
  let litNode ← match ← mKind message with
    | "Literal" => pure message
    | "Identifier" | "MemberAccess" =>
        if (← mKind message) == "MemberAccess" then
          let base ← mField message "expression"
          let baseTy ← mType base
          unless baseTy.startsWith "type(library " || baseTy.startsWith "type(contract " do
            failAt message s!"{label} currently needs a literal string message"
        let id ← refInt message
        unless id ≥ 0 do
          failAt message s!"{label} currently needs a literal string message"
        let some decl := (← get).numericConstants.find? id.toNat
          | failAt message s!"{label} currently needs a literal string message"
        unless (← mType decl) == "string" do
          failAt message s!"{label} currently needs a literal string message"
        let initVal ← mField decl "value"
        unless (← mKind initVal) == "Literal" do
          failAt message s!"{label} currently needs a literal string message"
        pure initVal
    | _ => failAt message s!"{label} currently needs a literal string message"
  let kind ← mStr (← mField litNode "kind")
  unless kind == "string" || kind == "unicodeString" do
    failAt message s!"{label} message must be a UTF-8 string literal"
  let some value := optStr litNode "value"
    | failAt message s!"{label} message bytes are not represented exactly by UTF-8"
  let actual ← mStr (← mField litNode "hexValue")
  let expected := value.toUTF8.data.foldl (init := "") fun acc byte =>
    acc.push (hexDigit (byte.toNat / 16)) |>.push (hexDigit (byte.toNat % 16))
  unless actual == expected do
    failAt message s!"{label} message bytes are not represented exactly by UTF-8"
  return value

private partial def hasInterfaceExternalCall (j : Json) : M Bool := do
  if ← isInterfaceExternalCall j then return true
  match j with
  | .obj kvs => kvs.toList.anyM fun (_, v) => hasInterfaceExternalCall v
  | .arr xs => xs.anyM hasInterfaceExternalCall
  | _ => return false

private partial def isPureEqualityPeer (j : Json) : M Bool := do
  let j := unparenJson j
  if statefulCallIn j (← get) || assignmentIn j || (← hasInterfaceExternalCall j) then
    return false
  match ← mKind j with
  | "Literal" => return true
  | "Identifier" =>
      let id ← refInt j
      if id < 0 then return false
      let env ← get
      if env.values.contains id.toNat || env.numericConstants.contains id.toNat then
        return true
      if let some decl := env.stateVars.find? id.toNat then
        return (field? decl "constant").bind (·.getBool?.toOption) == some true
      return false
  | "FunctionCall" =>
      if optStr j "kind" == some "typeConversion" then
        let args ← mArr (← mField j "arguments")
        if args.size == 1 then
          return ← isPureEqualityPeer args[0]!
      return false
  | _ => return false

private partial def admittedRequireInterfaceCall? (cond : Json) : M (Option Json) := do
  unless !(← get).stateVars.isEmpty do return none
  let cond := unparenJson cond
  match ← mKind cond with
  | "BinaryOperation" =>
      let op ← mStr (← mField cond "operator")
      let left ← mField cond "leftExpression"
      let right ← mField cond "rightExpression"
      if op == "||" || op == "&&" then
        if statefulCallIn left (← get) || assignmentIn left || (← hasInterfaceExternalCall left) then
          return none
        admittedRequireInterfaceCall? right
      else if op == "==" || op == "!=" then
        let left := unparenJson left
        let right := unparenJson right
        if (← isInterfaceExternalCall left) && (← isPureEqualityPeer right) then
          return some left
        else if (← isInterfaceExternalCall right) && (← isPureEqualityPeer left) then
          return some right
        else
          return none
      else
        return none
  | _ => return none

private partial def lowerRequire (statement : Json) : M (Array Stmt) :=
  lowerRequireWith statement fun cond => do
    let extra ← admittedRequireInterfaceCall? cond
    let extraIds := (extra.bind fun n => (field? n "id").bind (·.getNat?.toOption)).toList
    modify fun e => { e with admittedInterfaceCalls := (e.admittedInterfaceCalls ++ extraIds).eraseDups }
    lowerExpr cond

/-- A builtin `require` whose condition is lowered by `lowerCondition`. -/
private partial def lowerRequireWith (statement : Json) (lowerCondition : Json → M Val) :
    M (Array Stmt) := do
  let call ← mField statement "expression"
  unless (← mKind call) == "FunctionCall" do
    failAt call "only builtin require calls are supported as expression statements"
  let callee ← mField call "expression"
  unless (← mKind callee) == "Identifier" && optStr callee "name" == some "require" do
    failAt callee "only builtin require calls are supported as expression statements"
  -- solc 0.8.34 retains all three builtin overloads (-18) even after
  -- selecting the (bool,string) signature. Do not relax user-call refInt.
  let signature ← mType callee
  unless (← mField callee "referencedDeclaration").getInt?.toOption == some (-18) &&
      (signature == "function (bool,string memory) pure" || signature == "function (bool,error) pure" ||
       signature == "function (bool) pure") do
    failAt callee "require must resolve to a supported Solidity builtin signature"
  unless (← mArr (← mField callee "overloadedDeclarations")).all
      (fun declaration => declaration.getInt?.toOption == some (-18)) do
    failAt callee "require overload set contains a non-builtin declaration"
  unless optStr call "kind" == some "functionCall" do
    failAt call "require must be a function call"
  unless (← mArr (← mField call "names")).isEmpty do
    failAt call "named require arguments are unsupported"
  let args ← mArr (← mField call "arguments")
  -- solc evaluates the condition and, when it is false, reverts with empty
  -- returndata. That does not depend on the contract's state variables (#2830).
  if signature == "function (bool) pure" then
    unless args.size == 1 do failAt call "require(bool) requires one argument"
    let condition ← atom (← lowerCondition args[0]!)
    return condition.pre.push (.ite condition.expr [] [.revertEmpty])
  unless args.size == 2 do failAt call "require currently needs a literal string message"
  let message := args[1]!
  if signature == "function (bool,error) pure" then
    let condition ← atom (← lowerCondition args[0]!)
    let (pre, name, values) ← lowerErrorArguments message
    return condition.pre ++ pre |>.push (.requireError condition.expr name values)
  unless ← isStaticStringMessage message do
    -- solc evaluates the condition, then the message, both unconditionally;
    -- only the `Error(string)` encoding is on the failing path.
    let condition ← atom (← lowerCondition args[0]!)
    let buffer ← lowerRevertMessageBuffer message
    let revertStmts ← revertErrorStringBuffer buffer
    return condition.pre ++ buffer.pre |>.push (.ite condition.expr [] revertStmts.toList)
  let value ← extractStringLiteralOrConstant message false
  let condition ← atom (← lowerCondition args[0]!)
  return condition.pre.push (.require condition.expr value)

/-- Builtin `assert(c)` (solc declaration id `-3`): both solc 0.8.34 pipelines evaluate
`c` once and, when it is false, revert with `Panic(0x01)`. -/
private partial def lowerAssert (statement : Json) : M (Array Stmt) := do
  let call ← mField statement "expression"
  let callee ← mField call "expression"
  unless (← mType callee) == "function (bool) pure" do
    failAt callee "assert must resolve to the Solidity builtin assert(bool)"
  unless (← mArr (← mField callee "overloadedDeclarations")).isEmpty do
    failAt callee "assert overload set contains a non-builtin declaration"
  unless optStr call "kind" == some "functionCall" do
    failAt call "assert must be a function call"
  unless (← mArr (← mField call "names")).isEmpty do
    failAt call "named assert arguments are unsupported"
  let args ← mArr (← mField call "arguments")
  unless args.size == 1 do failAt call "assert(bool) requires one argument"
  let condition ← atom (← lowerExpr args[0]!)
  return condition.pre.push (.ite condition.expr [] [.panicCode (.literal 0x01)])

/-- An expression statement whose value is discarded (`x;`, `this;`, `a / b;`, `-x;`,
`arr[i];`). Both solc 0.8.34 pipelines still evaluate it: identifiers and literals do
nothing, while a computed value's checks run (`a / b;` panics with `0x12` when `b` is
zero), so it is lowered as a value and bound to a fresh local. Other statement kinds
reject with their node kind. -/
private partial def lowerDiscardedValue (expression : Json) : M (Array Stmt) := do
  let kind ← mKind expression
  match kind with
  | "Identifier" | "Literal" => return #[]
  | "BinaryOperation" | "UnaryOperation" | "IndexAccess" | "MemberAccess" | "Conditional"
  | "TupleExpression" =>
      if kind == "Conditional" then
        if (← mType expression) == "tuple()" then
          failAt expression
            "a conditional expression statement between calls without return values is unsupported"
      if kind == "TupleExpression" then
        if (← mBool (← mField expression "isInlineArray")) ||
            (← mArr (← mField expression "components")).size != 1 then
          failAt expression "a tuple or inline array expression statement is unsupported"
      return (← atom (← lowerExpr expression)).pre
  | "FunctionCall" =>
      let callKind := optStr expression "kind" |>.getD "function call"
      unless callKind == "typeConversion" do
        failAt expression s!"a {callKind} expression statement is unsupported"
      return (← atom (← lowerExpr expression)).pre
  | _ => failAt expression s!"{kind} expression statements are unsupported"

private partial def lowerBuiltinRevert (statement : Json) : M (Array Stmt) := do
  let call ← mField statement "expression"
  unless (← mKind call) == "FunctionCall" && optStr call "kind" == some "functionCall" do
    failAt call "revert must be a function call"
  let callee ← mField call "expression"
  unless (← mKind callee) == "Identifier" && optStr callee "name" == some "revert" do
    failAt callee "only builtin revert calls are supported here"
  let signature ← mType callee
  unless (← mField callee "referencedDeclaration").getInt?.toOption == some (-19) &&
      (signature == "function () pure" || signature == "function (string memory) pure") do
    failAt callee "revert must resolve to a supported Solidity builtin signature"
  unless (← mArr (← mField callee "overloadedDeclarations")).all
      (fun declaration => declaration.getInt?.toOption == some (-19)) do
    failAt callee "revert overload set contains a non-builtin declaration"
  unless (← mArr (← mField call "names")).isEmpty do
    failAt call "named revert arguments are unsupported"
  let args ← mArr (← mField call "arguments")
  if signature == "function () pure" then
    unless args.isEmpty do failAt call "bare revert() takes no arguments"
    return #[.revertEmpty]
  unless args.size == 1 do failAt call "revert(string) requires one message argument"
  unless ← isStaticStringMessage args[0]! do
    let buffer ← lowerRevertMessageBuffer args[0]!
    return buffer.pre ++ (← revertErrorStringBuffer buffer)
  let value ← extractStringLiteralOrConstant args[0]! true
  return #[.require (.literal 0) value]

private partial def lowerRevert (statement : Json) : M (Array Stmt) := do
  let call ← mField statement "errorCall"
  let (pre, name, values) ← lowerErrorArguments call
  return pre.push (.requireError (.literal 0) name values)

private partial def lowerEmit (statement : Json) : M (Array Stmt) :=
  recoverAt statement #[] (lowerEmitCore statement)

/-- Revert payloads reachable inside an event-argument guard: `0` for empty returndata,
otherwise a distinct tag per typed panic kind or raw `Panic(code)` literal. Both codegen
pipelines agree on a single payload family, so only a mixture across arguments needs an
order decision. Inspects both branches of `.ite` so guards whose non-panic branch assigns
a checked result (such as signed narrow checked add/sub) never lose their panic payload. -/
private partial def eventGuardPayloads : Stmt → Array Nat
  | .revertEmpty => #[0]
  | .panic k => #[0x100 + k.toNat]
  | .panicCode (.literal n) => #[n + 1]
  | .ite _ yes no =>
      yes.foldl (fun acc s => acc ++ eventGuardPayloads s) #[] ++
      no.foldl (fun acc s => acc ++ eventGuardPayloads s) #[]
  | _ => #[]

/-- solc evaluates event arguments left to right under via-IR but indexed arguments last
to first under legacy codegen. When guards in different arguments revert with different
payloads (or an unrecognized payload), the first failing guard depends on that order, so
such events are rejected. -/
private partial def rejectMixedEventGuards (guarded : Array (Json × Array Nat)) : M Unit := do
  let payloads := guarded.foldl (fun acc (_, ps) => acc ++ ps) #[]
  if guarded.size > 1 && (guarded.any (fun (_, ps) => ps.isEmpty) || payloads.any (· != payloads[0]!)) then
    failAt guarded[1]!.1 "event arguments whose guards revert with different payloads require explicit evaluation-order support"

private partial def lowerEmitCore (statement : Json) : M (Array Stmt) := do
  let call ← mField statement "eventCall"
  unless (← mKind call) == "FunctionCall" && optStr call "kind" == some "functionCall" do
    failAt call "event must be a resolved declaration call"
  unless (← mArr (← mField call "names")).isEmpty do
    failAt call "named event arguments are unsupported"
  let callee ← mField call "expression"
  let id ← refInt callee
  let some declaration := (← get).eventDecls.find? id.toNat
    | failAt callee "event does not resolve to an event declaration"
  if ← mBool (← mField declaration "anonymous") then
    failAt declaration "anonymous events are unsupported"
  let name ← mStr (← mField declaration "name")
  let parameters ← mArr (← mField (← mField declaration "parameters") "parameters")
  let arguments ← mArr (← mField call "arguments")
  unless parameters.size == arguments.size do failAt call "event argument count differs"
  let mut useStructEmit := false
  for index in [:parameters.size] do
    let pty ← mType parameters[index]!
    let arg := arguments[index]!
    if pty.startsWith "struct " || (scalarArrayElement? pty).isSome || pty == "string" ||
        (pty == "bytes" && optStr arg "nodeType" != some "Literal") then
      useStructEmit := true
  if useStructEmit then
    return ← lowerStructEmit callee declaration name parameters arguments id.toNat
  let mut params : List EventParam := []
  let mut values : List Expr := []
  let mut pre : Array Stmt := #[]
  -- Arguments whose prelude can revert, and whether any argument hashes through scratch.
  let mut guardedArguments : Array Json := #[]
  let mut guardPayloads : Array (Json × Array Nat) := #[]
  let mut scratchArgument := false
  for index in [:parameters.size] do
    let parameter := parameters[index]!
    let ty ← mType parameter
    discard (validateEnumTypeIfNeeded parameter ty)
    let some modelType := paramType ty | failAt parameter s!"unsupported event parameter type {ty}"
    -- Signed parameters keep their type: it names them in the event signature (topic 0),
    -- and the ABI word is the sign-extended value.
    let signedScalar := match modelType with
      | .int256 => true
      | .intN bits => 0 < bits && bits < 256 && bits % 8 == 0
      | _ => false
    unless (Denote.errorScalarType modelType).isSome || modelType == .bytesN 4 ||
        modelType == .bytesN 1 || signedScalar do
      failAt parameter s!"unsupported event parameter type {ty}"
    let indexed ← mBool (← mField parameter "indexed")
    let parameterName ← mStr (← mField parameter "name")
    let argument := arguments[index]!
    -- A source assignment inside an argument writes a local that an earlier argument may
    -- still read at log time, so its value would not be the one solc logs.
    if assignmentIn argument then
      failAt argument "event arguments with assignments require explicit evaluation-order support"
    let mut value ← convert ty (← mType argument) (← lowerExpr argument) argument
    -- Total scalar reads/casts commute. Scratch-space hashing writes (`mstore` at
    -- 0x00/0x20, as in nested mapping slot derivation) are consumed by the following
    -- `keccak256` and never observed by other arguments. Reject other guards and effects
    -- rather than choosing an argument evaluation order for competing revert paths.
    let isScratch : Stmt → Bool := fun
      | .mstore (.literal 0) _ | .mstore (.literal 32) _ => true
      | _ => false
    let isGuard : Stmt → Bool := fun
      | .ite _ [.revertEmpty] _ | .ite _ _ [.revertEmpty] => true
      | .ite _ [.panic _] _ | .ite _ _ [.panic _] => true
      | .ite _ [.panicCode (.literal _)] _ | .ite _ _ [.panicCode (.literal _)] => true
      | .revertEmpty | .panic _ | .panicCode (.literal _) => true
      | _ => false
    -- Normalization certified these scalar expressions read-only, with at most one
    -- potential panic. Its prelude cannot compete with another argument's revert.
    let reorderedReadOnly := field? call "reorderedReadOnlyArguments" == some (.bool true)
    -- An inlined helper reassigns its own result, parameter and local bindings. Such a write
    -- is admitted only to a binding this argument's prelude declared earlier: those are
    -- fresh, so no other argument's value reads them, and the write commutes with every
    -- other argument whichever order the pipeline evaluates them in.
    let ownWritesOnly : Array Stmt → Bool := fun pre => Id.run do
      let mut declared : Array String := #[]
      for s in pre do
        match s with
        | .letVar name _ => declared := declared.push name
        | .assignVar name _ => if !declared.contains name then return false
        | _ => pure ()
      return true
    unless reorderedReadOnly || (value.pre.all (fun
        | .letVar _ _ | .assignVar _ _ => true
        | s => isScratch s || isGuard s) && ownWritesOnly value.pre) do
      failAt argument "event arguments currently require total scalar expressions"
    if value.pre.any isGuard then
      guardedArguments := guardedArguments.push argument
      guardPayloads := guardPayloads.push (argument, value.pre.foldl (fun acc s => acc ++ eventGuardPayloads s) #[])
    if value.pre.any isScratch then
      scratchArgument := true
    let rec directParam? : Expr → Option String
      | .param p => some p
      | .bitAnd e (.literal _) | .signextend (.literal _) e | .logicalNot (.logicalNot e) =>
          directParam? e
      | _ => none
    match directParam? value.expr with
    | some parameterName =>
        let some actualType := rootParamType? (← get) parameterName
          | failAt argument "unresolved event model parameter type"
        if actualType != modelType then
          match modelType with
          | .uintN _ | .bytesN _ => failAt argument "event direct parameter type differs from its declaration"
          | _ =>
              -- Materialize a converted value so a type-preserving word cast
              -- or unsigned widening does not masquerade as a typed parameter.
              let binding ← fresh
              value := { pre := value.pre.push (.letVar binding value.expr), expr := .localVar binding }
    | none => pure ()
    match modelType with
    | .uintN bits =>
        unless (match value.expr with
                | .param _ => true
                | .literal n => n < 2 ^ bits
                | _ => false) && value.pre.isEmpty do
          value := { value with expr := cleanHelperResultExpr ty value }
    | .bytesN _ =>
        unless (match value.expr with
                | .param _ => true
                | _ => false) && value.pre.isEmpty do
          value := { value with expr := cleanHelperResultExpr ty value }
    | .intN _ | .address | .bool =>
        value := { value with expr := cleanHelperResultExpr ty value }
    | _ => pure ()
    let boundValue ← atom value
    params := params ++ [{ name := parameterName, ty := modelType, kind := if indexed then .indexed else .unindexed }]
    values := values ++ [boundValue.expr]
    pre := pre ++ boundValue.pre
  -- solc orders event arguments differently under via-IR (left to right) and legacy
  -- codegen (indexed last to first, then data), so an event with a nested-mapping read
  -- is admitted only when at most one argument can revert.
  if scratchArgument && guardedArguments.size > 1 then
    failAt guardedArguments[1]! "event arguments with competing revert paths require explicit evaluation-order support"
  rejectMixedEventGuards guardPayloads
  unless (params.filter (·.kind == .indexed)).length ≤ 3 do
    failAt declaration "event has more than three indexed parameters"
  if let some previous := (← get).usedEvents.find? (fun pair => pair.2.name == name) then
    unless previous.1 == id.toNat do failAt callee "event name resolves to multiple declarations"
  else
    modify fun e => { e with usedEvents := e.usedEvents ++ [(id.toNat, { name, params })] }
  pure (pre.push (.emit name values))

/-- Register `definition` for the event declaration `id`, once per name. -/
private partial def recordUsedEvent (callee : Json) (id : Nat) (definition : EventDef) :
    M Unit := do
  if let some previous := (← get).usedEvents.find? (fun pair => pair.2.name == definition.name) then
    unless previous.1 == id do failAt callee "event name resolves to multiple declarations"
  else
    modify fun e => { e with usedEvents := e.usedEvents ++ [(id, definition)] }

/-- `emit E(...)` with a non-indexed struct, array, `bytes` or `string` parameter. The
non-indexed arguments are ABI-encoded exactly as `abi.encode(...)` into memory and
logged by the closed log transport with solc's event selector as topic 0. Indexed
parameters must be total value-type expressions; they become cleaned topic words.
Struct arguments must be memory struct variables. In an event with a `string` parameter,
every non-indexed argument that precedes an indexed argument must be a variable or literal:
topics are lowered before the data, while solc evaluates event arguments left to right, so
no evaluation order is chosen. -/
private partial def lowerStructEmit (callee declaration : Json) (name : String)
    (parameters arguments : Array Json) (id : Nat) : M (Array Stmt) := do
  let some selector := optStr declaration "eventSelector"
    | failAt declaration "struct event declaration has no eventSelector"
  let digits := selector.toList.filterMap Compiler.Hex.hexCharToNat?
  unless selector.length == 64 && digits.length == 64 do
    failAt declaration "struct event declaration has an invalid eventSelector"
  let mut params : List EventParam := []
  let mut topics : Array Expr := #[.literal (digits.foldl (fun word d => word * 16 + d) 0)]
  let mut pre : Array Stmt := #[]
  let mut data : Array Json := #[]
  let mut lastIndexed : Option Nat := none
  let mut guardPayloads : Array (Json × Array Nat) := #[]
  let mut hasString := false
  for index in [:parameters.size] do
    if ← mBool (← mField parameters[index]! "indexed") then
      lastIndexed := some index
    if (← mType parameters[index]!) == "string" then
      hasString := true
  for index in [:parameters.size] do
    let parameter := parameters[index]!
    let argument := arguments[index]!
    let ty ← mType parameter
    let parameterName ← mStr (← mField parameter "name")
    if hasString && !(← mBool (← mField parameter "indexed")) && lastIndexed.any (index < ·) then
      let kind ← mKind argument
      unless kind == "Identifier" || kind == "Literal" do
        failAt argument "event data arguments before an indexed argument must be variables or literals"
    if ← mBool (← mField parameter "indexed") then
      if ty.startsWith "struct " then
        failAt parameter "indexed struct event parameters are unsupported"
      let some modelType := paramType ty
        | failAt parameter s!"unsupported event parameter type {ty}"
      unless (Denote.errorScalarType modelType).isSome && !ty.startsWith "enum " do
        failAt parameter s!"unsupported indexed struct-event parameter type {ty}"
      let value ← convert ty (← mType argument) (← lowerExpr argument) argument
      unless value.pre.all (fun
          | .letVar _ _ => true
          | .ite _ [.revertEmpty] _ | .ite _ _ [.revertEmpty] => true
          | .ite _ [.panic _] _ | .ite _ _ [.panic _] => true
          | .ite _ [.panicCode (.literal _)] _ | .ite _ _ [.panicCode (.literal _)] => true
          | .revertEmpty | .panic _ | .panicCode (.literal _) => true
          | _ => false) do
        failAt argument "event arguments currently require total scalar expressions"
      let payloads := value.pre.foldl (fun acc s => acc ++ eventGuardPayloads s) #[]
      unless payloads.isEmpty do
        guardPayloads := guardPayloads.push (argument, payloads)
      let topic ← atom { value with expr := cleanHelperResultExpr ty value }
      pre := pre ++ topic.pre
      topics := topics.push topic.expr
      params := params ++ [{ name := parameterName, ty := modelType, kind := .indexed }]
    else
      let modelType ← if ty.startsWith "struct " then
          unless (← mKind argument) == "Identifier" do
            failAt argument "struct event arguments must be memory struct variables"
          match ← lowerRef argument with
          | .mem rootId _ =>
              let some mem := (← get).mems.find? rootId | failAt argument "unknown memory struct"
              match mem.schema, mem.staticTypes with
              | some schema, _ => pure (AbiSchema.paramType schema)
              | none, some types => pure (.tuple types)
              | none, none => failAt argument "struct event argument has no complete ABI schema"
          | _ => failAt argument "struct event arguments must be memory struct variables"
        else if ty == "bytes" then
          pure .bytes
        else if ty == "string" then
          pure .string
        else if let some (_, elemPty, _) := scalarArrayElement? ty then
          pure (.array elemPty)
        else match paramType ty with
          | some modelType => pure modelType
          | none => failAt parameter s!"unsupported event parameter type {ty}"
      -- The data is encoded by the arguments' own types (`lowerAbiEncodeArgs` without the
      -- declarations), where a string literal is a dynamic `string`; solc encodes it as the
      -- static `bytesN` the parameter declares.
      if (← mType argument).startsWith "literal_string " && (fixedBytesWidth? ty).isSome then
        failAt argument s!"string literal event data argument for a {ty} parameter is unsupported"
      data := data.push argument
      params := params ++ [{ name := parameterName, ty := modelType, kind := .unindexed }]
  unless topics.size ≤ 4 do failAt declaration "event has more than three indexed parameters"
  rejectMixedEventGuards guardPayloads
  -- Topics are lowered before the data. via-IR evaluates a data argument that precedes an
  -- indexed one first, so once a topic can revert, such data arguments must not.
  unless guardPayloads.isEmpty do
    for index in [:parameters.size] do
      unless ← mBool (← mField parameters[index]! "indexed") do
        if lastIndexed.any (index < ·) then
          let kind ← mKind arguments[index]!
          unless kind == "Identifier" || kind == "Literal" do
            failAt arguments[index]! "event data arguments before a guarded indexed argument must be variables or literals"
  let payload ← lowerAbiEncodeArgs data
  let pointer ← atom { pre := payload.pre, expr := payload.pointer }
  let size ← atom { pre := #[], expr := payload.size }
  recordUsedEvent callee id { name, params }
  let log := Stmt.ecm (Compiler.ECM.SolidityLog.module name topics.size)
    (topics.toList ++ [pointer.expr, size.expr])
  return (pre ++ pointer.pre ++ size.pre).push log

private partial def lowerErrorArgumentsForDecl (callee declaration : Json) (arguments : Array Json) :
    M (Array Stmt × String × List Expr) := do
  let name ← mStr (← mField declaration "name")
  let parameters ← mArr (← mField (← mField declaration "parameters") "parameters")
  unless parameters.size == arguments.size do failAt callee "custom-error argument count differs"
  let mut types : List ParamType := []
  let mut values : List Expr := []
  let mut pre : Array Stmt := #[]
  let errEnv ← get
  let errMutates := arguments.any fun arg => assignmentIn arg || statefulCallIn arg errEnv
  for index in [:parameters.size] do
    let parameter := parameters[index]!
    let ty ← mType parameter
    discard (validateEnumTypeIfNeeded parameter ty)
    let some modelType := localParamType ty
      | failAt parameter s!"unsupported custom-error parameter type {ty}"
    unless (Denote.customErrorScalarType modelType).isSome do
      failAt parameter s!"unsupported custom-error parameter type {ty}"
    let argument := arguments[index]!
    -- Custom-error arguments are evaluated left to right, before the revert data is
    -- encoded, so a checked expression or a storage member read is bound to a temporary
    -- at its own position. Compile-time constants still fold to one canonical word.
    let source ← lowerExpr argument
    let rawConverted ← convert ty (← mType argument) source argument
    let converted : Val :=
      match evalConstVal? { rawConverted with expr := cleanHelperResultExpr ty rawConverted } with
      | some n => { pre := #[], expr := .literal n }
      | none => rawConverted
    let cleaned : Val := { converted with expr := cleanHelperResultExpr ty converted }
    if let .literal n := cleaned.expr then
      unless Denote.errorScalarValueValid modelType n do
        failAt argument "custom-error arguments currently require literals or scalar bindings"
    let bound ← atom cleaned
    let value ← if errMutates && !(bound.expr matches .literal _) then
        let snapshot ← fresh
        pure { pre := bound.pre.push (.letVar snapshot bound.expr), expr := .localVar snapshot }
      else
        pure bound
    types := types ++ [modelType]
    values := values ++ [value.expr]
    pre := pre ++ value.pre
  let definition : ErrorDef := { name, params := types }
  if let some previous := (← get).usedErrors.find? (·.name == name) then
    unless previous.params == types do failAt callee "custom-error name has multiple signatures"
  else
    modify fun e => { e with usedErrors := e.usedErrors ++ [definition] }
  return (pre, name, values)

private partial def lowerErrorArguments (call : Json) : M (Array Stmt × String × List Expr) := do
  unless (← mKind call) == "FunctionCall" && optStr call "kind" == some "functionCall" do
    failAt call "custom error must be a resolved constructor call"
  unless (← mArr (← mField call "names")).isEmpty do
    failAt call "named custom-error arguments are unsupported"
  let callee ← mField call "expression"
  let id ← refInt callee
  let some declaration := (← get).errorDecls.find? id.toNat
    | failAt callee "custom error does not resolve to an error declaration"
  let arguments ← mArr (← mField call "arguments")
  lowerErrorArgumentsForDecl callee declaration arguments

/-- In a whole scalar return, a bytes4 call compared with a type-qualified function
selector has no competing evaluation: the other operand lowers to a literal. -/
private partial def selectorComparisonCall? (expr : Json) : M (Option Json) := do
  unless optStr expr "nodeType" == some "BinaryOperation" &&
      [some "==", some "!="].contains (optStr expr "operator") do return none
  let lhs ← mField expr "leftExpression"
  let rhs ← mField expr "rightExpression"
  for (call, peer) in [(lhs, rhs), (rhs, lhs)] do
    unless optStr peer "memberName" == some "selector" &&
        (field? peer "referencedDeclaration").isNone do continue
    let some member := field? peer "expression" | continue
    let some receiver := field? member "expression" | continue
    if (← mType receiver).startsWith "type(contract " && (← mType call) == "bytes4" &&
        (← isInterfaceExternalCall call) then return some call
  return none

/-- A single-variable declaration may admit its whole initializer as a
typed-interface call; tuple declarations admit none. -/
private partial def lowerLocal (s : Json) : M (Array Stmt) := do
  let single := match field? s "declarations" with
    | some (.arr declarations) => declarations.size == 1
    | _ => false
  recoverAt s #[] <|
    withAdmittedInterfaceCall (if single then field? s "initialValue" else none) (lowerLocalCore s)

private partial def lowerLocalCore (s : Json) : M (Array Stmt) := do
  let assignedHere := bodyAssignedIds s
  if !assignedHere.isEmpty then
    modify fun e => { e with zeroInitLocals := e.zeroInitLocals.filter (!assignedHere.contains ·) }
  let decls ← mArr (← mField s "declarations")
  -- A local `<name>` shadows any visible `<name>.slot` of a parameter or outer local;
  -- a storage local that has a slot binds its own below.
  for d in decls do
    if let some name := optStr d "name" then
      modify fun e => { e with yulNames := e.yulNames.erase s!"{name}.slot" }
  if decls.size > 1 then
    unless decls.any (!·.isNull) do failAt s "empty tuple declaration"
    let init := field? s "initialValue" |>.getD Json.null
    if init.isNull then failAt s "tuple variable declaration requires an initializer"
    let initCall := unparenJson init
    if let some member ← lowLevelStaticcallMember? initCall then
      unless decls.size == 2 do
        failAt s "low-level staticcall declares (bool success, bytes memory returndata)"
      let (callPre, success, data, size) ← lowerLowLevelStaticcall initCall member
      let mut out := callPre
      if let some d := decls[0]? then
        unless d.isNull do
          let name ← mStr (← mField d "name")
          let id ← mNat (← mField d "id")
          let dLoc := optStr d "storageLocation" |>.getD "default"
          unless (← mType d) == "bool" && dLoc == "default" do
            failAt d "low-level staticcall success must be a bool local"
          let binding ← freshFor name
          let expr := Expr.localVar binding
          out := out.push (.letVar binding (.localVar success))
          modify fun e =>
            { e with values := e.values.insert id expr,
                     scalarTy := e.scalarTy.insert id .bool,
                     yulNames := e.yulNames.insert name expr,
                     yulMemoryArrays := e.yulMemoryArrays.erase name,
                     yulMemoryStructs := e.yulMemoryStructs.erase name,
                     writableLocals := e.writableLocals.insert id binding,
                     zeroInitLocals := e.zeroInitLocals.filter (· != id) }
      if let some d := decls[1]? then
        unless d.isNull do
          let name ← mStr (← mField d "name")
          let id ← mNat (← mField d "id")
          let dTy ← mType d
          unless (optStr d "storageLocation" |>.getD "default") == "memory" &&
              (dTy == "bytes" || dTy == "bytes memory") do
            failAt d "low-level staticcall return data must be a bytes memory local"
          if (← get).bodyAssigned.contains id then
            failAt d "reassigned low-level staticcall return data is outside this slice"
          let retained : EncodedBytes :=
            { pre := #[], pointer := .localVar data, size := .localVar size }
          modify fun e =>
            { e with byteBuffers := e.byteBuffers.insert id retained,
                     nonLiteralByteLocals := if e.nonLiteralByteLocals.contains id then
                       e.nonLiteralByteLocals else e.nonLiteralByteLocals.push id,
                     yulNames := e.yulNames.erase name,
                     yulMemoryArrays := e.yulMemoryArrays.erase name,
                     yulMemoryStructs := e.yulMemoryStructs.insert name id }
      return out
    if ← isAbiDecodeCall init then
      let (decodePre, decoded) ← lowerAbiDecodeItems init
      unless decls.size == decoded.size do
        failAt s s!"tuple declaration arity {decls.size} does not match abi.decode arity {decoded.size}"
      let mut out := decodePre
      for i in [:decls.size] do
        let d := decls[i]!
        if d.isNull then continue
        let name ← mStr (← mField d "name")
        unless name.all (fun c => c.isAlphanum || c == '_' || c == '$') && name != "" do
          failAt d s!"unsupported local name {name}"
        let id ← mNat (← mField d "id")
        let loc := optStr d "storageLocation" |>.getD "default"
        let dTy ← mType d
        match decoded[i]! with
        | .scalar retTy _ retExpr =>
            unless loc == "default" do
              failAt d "scalar abi.decode component requires a default-location local"
            discard (validateEnumTypeIfNeeded d dTy)
            let some scalarType := localParamType dTy
              | failAt d s!"unsupported tuple local type {dTy}"
            let converted ← convert dTy retTy { pre := #[], expr := retExpr } d
            let binding ← freshFor name
            let expr := Expr.localVar binding
            out := out ++ converted.pre |>.push (.letVar binding converted.expr)
            modify fun e =>
              { e with values := e.values.insert id expr,
                       scalarTy := e.scalarTy.insert id scalarType,
                       yulNames := e.yulNames.insert name expr,
                       yulMemoryArrays := e.yulMemoryArrays.erase name,
                       yulMemoryStructs := e.yulMemoryStructs.erase name,
                       writableLocals := e.writableLocals.insert id binding,
                       zeroInitLocals := e.zeroInitLocals.filter (· != id) }
        | .flatStruct sid sName memberVals =>
            unless loc == "memory" && dTy.startsWith "struct " && !dTy.contains "[" do
              failAt d "struct abi.decode component requires a memory struct local"
            let (declSid, _) ← resolveStructDeclFromType d
            unless declSid == sid do
              failAt d "struct abi.decode component type mismatch"
            let mut boundMembers : Array (String × String × String) := #[]
            for (mName, mTy, mExpr) in memberVals do
              let mBinding ← freshFor s!"{name}_{mName}"
              out := out.push (.letVar mBinding mExpr)
              boundMembers := boundMembers.push (mName, mTy, mBinding)
            let fDesc : FlatStructLocal := { structId := sid, structName := sName, members := boundMembers }
            modify fun e =>
              { e with flatStructs := e.flatStructs.insert id fDesc,
                       yulNames := e.yulNames.erase name,
                       yulMemoryArrays := e.yulMemoryArrays.erase name,
                       yulMemoryStructs := e.yulMemoryStructs.insert name id }
        | .scalarArray elemStr _ _ rawDesc =>
            unless loc == "memory" && (dTy == elemStr ++ "[]" || dTy == elemStr ++ "[] memory") do
              failAt d "array abi.decode component requires a matching memory array local"
            if (← get).bodyAssigned.contains id then
              failAt d "reassigned memory array locals are outside this slice"
            let desc := { rawDesc with param := name }
            modify fun e =>
              { e with scalarArrays := e.scalarArrays.insert id desc,
                       encodingMemory := true,
                       yulNames := e.yulNames.erase name,
                       yulMemoryArrays := e.yulMemoryArrays.insert name desc.memoryPointer,
                       yulMemoryStructs := e.yulMemoryStructs.erase name }
        | .dynamicStruct _ =>
            failAt d "dynamic struct abi.decode requires a single memory struct local"
        | .dynamicBytes isString buf =>
            let expectedBase := if isString then "string" else "bytes"
            unless loc == "memory" && (dTy == expectedBase || dTy == expectedBase ++ " memory") do
              failAt d s!"{expectedBase} abi.decode component requires a memory {expectedBase} local"
            if isString && (← get).bodyAssigned.contains id then
              failAt d "reassigned string locals are outside this slice"
            let pointer ← freshFor name
            let size ← fresh
            out := out ++ buf.pre ++ #[.letVar pointer buf.pointer, .letVar size buf.size]
            let retained : EncodedBytes := { pre := #[], pointer := .localVar pointer, size := .localVar size }
            if isString then
              modify fun e =>
                { e with stringBuffers := e.stringBuffers.insert id retained,
                         nonLiteralByteLocals := if e.nonLiteralByteLocals.contains id then e.nonLiteralByteLocals else e.nonLiteralByteLocals.push id,
                         yulNames := e.yulNames.erase name,
                         yulMemoryArrays := e.yulMemoryArrays.erase name,
                         yulMemoryStructs := e.yulMemoryStructs.insert name id }
            else
              modify fun e =>
                { e with byteBuffers := e.byteBuffers.insert id retained,
                         nonLiteralByteLocals := if e.nonLiteralByteLocals.contains id then e.nonLiteralByteLocals else e.nonLiteralByteLocals.push id,
                         yulNames := e.yulNames.erase name,
                         yulMemoryArrays := e.yulMemoryArrays.erase name,
                         yulMemoryStructs := e.yulMemoryStructs.insert name id }
      return out
    if let some payload ← selfDelegateCallArg? init then
      unless decls.size == 2 do
        failAt s "self-delegatecall must bind (bool success, bytes memory returndata)"
      let successDecl := decls[0]!
      let dataDecl := decls[1]!
      if !successDecl.isNull then
        unless (← mType successDecl) == "bool" &&
            (optStr successDecl "storageLocation" |>.getD "default") == "default" do
          failAt successDecl "self-delegatecall status binding must be a bool local"
      if !dataDecl.isNull then
        unless (← mType dataDecl) == "bytes" &&
            optStr dataDecl "storageLocation" == some "memory" do
          failAt dataDecl "self-delegatecall returndata binding must be a bytes memory local"
      let payloadBuf ← lowerEncodedBytes payload
      let successVar ← if successDecl.isNull then fresh else freshFor (← mStr (← mField successDecl "name"))
      let mut out := payloadBuf.pre.push
        (.ecm (Compiler.ECM.YulMemoryDelegateCall.module successVar)
          [.contractAddress, payloadBuf.pointer, payloadBuf.size, .literal 0, .literal 0])
      if !successDecl.isNull then
        let sName ← mStr (← mField successDecl "name")
        let sId ← mNat (← mField successDecl "id")
        let expr := Expr.localVar successVar
        modify fun e =>
          { e with values := e.values.insert sId expr,
                   scalarTy := e.scalarTy.insert sId .bool,
                   yulNames := e.yulNames.insert sName expr,
                   yulMemoryArrays := e.yulMemoryArrays.erase sName,
                   yulMemoryStructs := e.yulMemoryStructs.erase sName,
                   writableLocals := e.writableLocals.insert sId successVar,
                   zeroInitLocals := e.zeroInitLocals.filter (· != sId) }
      if !dataDecl.isNull then
        let dName ← mStr (← mField dataDecl "name")
        let dId ← mNat (← mField dataDecl "id")
        let retLen ← fresh
        let retPtr ← freshFor dName
        let retFinish ← fresh
        let clearIdx ← fresh
        modify fun e => { e with encodingMemory := true }
        out := out.push (.letVar retLen .returndataSize)
        out := out ++ (AbiEncoding.packedBuffer retPtr retFinish clearIdx (.localVar retLen)).toArray
        out := out.push (.returndataCopy (.localVar retPtr) (.literal 0) (.localVar retLen))
        let retained : EncodedBytes :=
          { pre := #[], pointer := .localVar retPtr, size := .localVar retLen }
        modify fun e =>
          { e with byteBuffers := e.byteBuffers.insert dId retained,
                   nonLiteralByteLocals := if e.nonLiteralByteLocals.contains dId then e.nonLiteralByteLocals else e.nonLiteralByteLocals.push dId,
                   yulNames := e.yulNames.erase dName,
                   yulMemoryArrays := e.yulMemoryArrays.erase dName,
                   yulMemoryStructs := e.yulMemoryStructs.insert dName dId }
      return out
    let mut expectedTypes : Array (Option String) := #[]
    for d in decls do
      if d.isNull then
        expectedTypes := expectedTypes.push none
      else
        let loc := optStr d "storageLocation" |>.getD "default"
        let dTy ← mType d
        if loc == "memory" && dTy.startsWith "struct " && !dTy.contains "[" then
          let (_, sDecl) ← resolveStructDeclFromType d
          let sMembers ← mArr (← mField sDecl "members")
          for mNode in sMembers do
            expectedTypes := expectedTypes.push (some (← mType mNode))
        else if loc == "memory" && (dTy == "bytes" || dTy == "string") then
          -- A helper's `string` / `bytes memory` result is two raw words
          -- (pointer, size); the binding below checks their types.
          unless (← mKind init) == "FunctionCall" do
            failAt init "a string/bytes tuple component requires a multi-return helper call initializer"
          expectedTypes := expectedTypes.push none |>.push none
        else
          expectedTypes := expectedTypes.push (some dTy)
    -- A literal tuple initializer evaluates every component left to right, as
    -- solc does, before the fresh declared locals are bound.
    let (callPre, retExprs) ← if (← mKind init) == "TupleExpression" then
        lowerMultiBranch init (some expectedTypes)
      else lowerMultiCall init (some expectedTypes)
    unless expectedTypes.size == retExprs.size do
      -- A helper's string/bytes result takes two slots; an elided component
      -- takes one, so an elided string/bytes result cannot line up.
      if decls.any (·.isNull) && retExprs.any (fun (_, ty) => ty == "bytes" || ty == "string") then
        failAt s "an elided string/bytes tuple component is outside this slice"
      failAt s s!"tuple declaration arity {decls.size} does not match helper return arity {retExprs.size}"
    let mut out := callPre
    -- A memory struct component takes one result per member, so the results of
    -- later components start at a running offset, not at the component index.
    let mut off : Nat := 0
    for i in [:decls.size] do
      let d := decls[i]!
      if d.isNull then
        -- An elided component takes one result: an elided struct with more than
        -- one member already failed the arity check (`expectedTypes` has one slot
        -- for it, the helper returns one per member).
        off := off + 1
        continue
      let name ← mStr (← mField d "name")
      unless name.all (fun c => c.isAlphanum || c == '_' || c == '$') && name != "" do
        failAt d s!"unsupported local name {name}"
      let id ← mNat (← mField d "id")
      let loc := optStr d "storageLocation" |>.getD "default"
      let ty ← mType d
      if loc == "memory" && ty.startsWith "struct " && !ty.contains "[" then
        let (sid, sDecl) ← resolveStructDeclFromType d
        let sName ← mStr (← mField sDecl "name")
        let sMembers ← mArr (← mField sDecl "members")
        let mut boundMembers : Array (String × String × String) := #[]
        for mIdx in [:sMembers.size] do
          let mNode := sMembers[mIdx]!
          let mName ← mStr (← mField mNode "name")
          let mTy ← mType mNode
          let (retExpr, retTy) := retExprs.getD (off + mIdx) (.literal 0, "")
          let converted ← convert mTy retTy { pre := #[], expr := retExpr } d
          let mBinding ← freshFor s!"{name}_{mName}"
          out := out ++ converted.pre |>.push (.letVar mBinding converted.expr)
          boundMembers := boundMembers.push (mName, mTy, mBinding)
        modify fun e =>
          { e with flatStructs := e.flatStructs.insert id { structId := sid, structName := sName, members := boundMembers },
                   yulNames := e.yulNames.erase name,
                   yulMemoryArrays := e.yulMemoryArrays.erase name,
                   yulMemoryStructs := e.yulMemoryStructs.insert name id }
        off := off + sMembers.size
        continue
      if loc == "memory" then
        let (retExpr, retTy) := retExprs.getD off (.literal 0, "")
        if ty == "bytes" || ty == "string" then
          -- The local binds the helper's own buffer (pointer and size), as a
          -- single `string` / `bytes memory` helper result is bound.
          let (sizeExpr, sizeTy) := retExprs.getD (off + 1) (.literal 0, "")
          unless retTy == ty && sizeTy == "uint256" do
            failAt d s!"{ty} tuple component does not match the helper result type {retTy}"
          let isString := ty == "string"
          if isString && (← get).bodyAssigned.contains id then
            failAt d "reassigned string locals are outside this slice"
          let pointer ← freshFor name
          let size ← fresh
          out := out ++ #[.letVar pointer retExpr, .letVar size sizeExpr]
          let tupleOwned := !isString && (← get).linkedLibrariesMatchSource &&
            isLinkedLibraryCallSite init && !(← get).bodyAssigned.contains id
          let retained : EncodedBytes :=
            { pre := #[], pointer := .localVar pointer, size := .localVar size,
              ownedMutable := tupleOwned }
          modify fun e =>
            { e with byteBuffers := if isString then e.byteBuffers else e.byteBuffers.insert id retained,
                     stringBuffers := if isString then e.stringBuffers.insert id retained else e.stringBuffers,
                     nonLiteralByteLocals := if e.nonLiteralByteLocals.contains id then e.nonLiteralByteLocals else e.nonLiteralByteLocals.push id,
                     yulNames := e.yulNames.erase name,
                     yulMemoryArrays := e.yulMemoryArrays.erase name,
                     yulMemoryStructs := e.yulMemoryStructs.insert name id }
          off := off + 2
          continue
        if let some fixedTy := fixedMemArrayType? ty then
          unless fixedMemArrayType? retTy == some fixedTy do
            failAt d "fixed-size memory array tuple component type differs"
          let arr ← freshFixedMemArray name fixedTy
          out := out.push (.letVar arr.pointer retExpr)
          modify fun e =>
            { e with fixedMemArrays := e.fixedMemArrays.insert id arr, yulNames := e.yulNames.erase name,
                     yulMemoryArrays := e.yulMemoryArrays.erase name, yulMemoryStructs := e.yulMemoryStructs.erase name }
          off := off + 1
          continue
        if let some (elemStr, elemPty, abiKind) := scalarArrayElement? ty then
          unless (scalarArrayElement? retTy).map (·.1) == some elemStr do
            failAt d "dynamic memory array tuple component type differs"
          let template : ScalarArrayParam :=
            { param := name, elementType := elemStr, modelElementType := elemPty, abiKind,
              inMemory := true, lengthBinding := "" }
          let (ownPre, owned) ← ownDynArray name template retExpr
          out := out ++ ownPre
          modify fun e =>
            { e with scalarArrays := e.scalarArrays.insert id owned, yulNames := e.yulNames.erase name,
                     yulMemoryArrays := e.yulMemoryArrays.erase name, yulMemoryStructs := e.yulMemoryStructs.erase name }
          off := off + 1
          continue
      unless loc == "default" do
        failAt d "tuple variable declaration only supports scalar locals"
      discard (validateEnumTypeIfNeeded d ty)
      let some scalarType := localParamType ty
        | failAt d s!"unsupported tuple local type {ty}"
      let (retExpr, retTy) := retExprs.getD off (.literal 0, "")
      off := off + 1
      let converted ← convert ty retTy { pre := #[], expr := retExpr } d
      let binding ← freshFor name
      let expr := Expr.localVar binding
      out := out ++ converted.pre |>.push (.letVar binding converted.expr)
      let isZero := converted.pre.isEmpty && (match converted.expr with | .literal 0 => true | _ => false)
      modify fun e =>
        { e with values := e.values.insert id expr,
                 scalarTy := e.scalarTy.insert id scalarType,
                 yulNames := e.yulNames.insert name expr,
                 yulMemoryArrays := e.yulMemoryArrays.erase name,
                 yulMemoryStructs := e.yulMemoryStructs.erase name,
                 writableLocals := e.writableLocals.insert id binding,
                 zeroInitLocals := if isZero then (if e.zeroInitLocals.contains id then e.zeroInitLocals else e.zeroInitLocals.push id) else e.zeroInitLocals.filter (· != id) }
    return out
  unless decls.size == 1 do failAt s "only a single declaration is supported"
  if decls[0]!.isNull then failAt s "empty declaration"
  let d := decls[0]!
  let name ← mStr (← mField d "name")
  unless name.all (fun c => c.isAlphanum || c == '_' || c == '$') && name != "" do
    failAt d s!"unsupported local name {name}"
  let id ← mNat (← mField d "id")
  let loc := optStr d "storageLocation" |>.getD "default"
  let init := field? s "initialValue" |>.getD Json.null
  modify fun e => { e with yulMemoryArrays := e.yulMemoryArrays.erase name, yulMemoryStructs := e.yulMemoryStructs.erase name }
  if let some typeNameNode := field? d "typeName" then
    if optStr typeNameNode "nodeType" == some "FunctionTypeName" then
      let fvis := optStr typeNameNode "visibility" |>.getD ""
      unless fvis == "internal" do
        failAt d s!"only internal function pointer locals are supported, found {fvis}"
      if init.isNull then
        failAt d "uninitialized function pointer locals are outside this slice"
      if (← get).bodyAssigned.contains id then
        failAt d "reassigned function pointer locals are outside this slice"
      let (pre, ptr) ← lowerFnPtrInit init
      modify fun e =>
        { e with fnPtrs := e.fnPtrs.insert id ptr,
                 yulNames := e.yulNames.erase name }
      return pre
  if loc == "memory" then
    if let some fixedTy := fixedMemArrayType? (← mType d) then
      let initIsArrayValue ← if init.isNull then pure false else isFixedMemArrayValue init
      if init.isNull || initIsArrayValue then
        -- `T[N] memory x;` allocates a zeroed array; `T[N] memory x = e;`
        -- binds `e`'s pointer (memory-to-memory assignment never copies).
        let (pre, arr) ← if init.isNull then allocateZeroedFixedMemArray name fixedTy else do
          let (valPre, value) ← lowerFixedMemArrayValue init
          let binding ← freshFor name
          pure (valPre.push (.letVar binding (.localVar value.pointer)), { value with pointer := binding })
        modify fun e => { e with fixedMemArrays := e.fixedMemArrays.insert id arr, yulNames := e.yulNames.erase name }
        return pre
  if loc == "memory" && (nestedMemArrayType? (← mType d)).isSome then
    -- `T[][] memory v;` is the zero-length array at `0x60`.
    let (pre, arr) ← if init.isNull then do
        let some (elem, elemPty, abiKind) := nestedMemArrayType? (← mType d)
          | failAt d "unsupported nested memory array local"
