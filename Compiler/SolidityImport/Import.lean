      | some dest, some guard => #[.ite guard [.ite (.lt cleanStart.expr limit) [.assignVar dest limit] []] []]
      | some dest, none => #[.ite (.lt cleanStart.expr limit) [.assignVar dest limit] []]
      | none, _ => #[]
