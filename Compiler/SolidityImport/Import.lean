private def resolveSolcRelease (profile : Profile) : MetaM SolcRelease := do
  let some release := solcReleases.find? (·.longVersion == profile.solc)
    | throwError "this importer is pinned to solc {String.intercalate " or " (solcReleases.map (·.longVersion)).toList}, not {profile.solc}"
  unless release.supportedEvmVersions.contains profile.evmVersion do
    throwError "evmVersion {profile.evmVersion} is not supported for solc {release.longVersion}"
  if profile.viaIR && !release.supportsViaIR then
    throwError "viaIR is not supported for solc {release.longVersion}"
  pure release

/-- The `evmVersion` spelling this release's `--standard-json` accepts. Pinned
aliases keep the importer's vocabulary independent of a compiler build that
has not named a future fork yet. -/
private def solcEvmVersion (release : SolcRelease) (evmVersion : String) : String :=
  match release.evmNameAliases.find? (fun entry => entry.1 == evmVersion) with
  | some entry => entry.2
  | none => evmVersion

private def buildField (types item : Json) (isTransient : Bool := false) : M FieldInfo := do
  let name ← mStr (← mField item "label")
  if name == rawStorageFieldName || name.startsWith "_verity_struct_" then
    throwError "state variable name {name} is reserved"
  let slot ← mNat (← mField item "slot")
  let rawTypeId ← mStr (← mField item "type")
  let top ← liftM (layoutType types rawTypeId)
  let typeId := normalizeSolcLayoutType (← get) rawTypeId
  let encoding ← mStr (← mField top "encoding")
  -- Transient variables admit exactly the persistent scalar layouts below; reference
  -- types never reach here (solc rejects them).
  if isTransient && (encoding != "inplace" || (field? top "members").isSome ||
      (field? top "base").isSome) then
    throwError "unsupported transient storage type {rawTypeId}"
  if encoding == "inplace" then
    if (field? top "members").isSome then
      unless (← mNat (← mField item "offset")) == 0 do
        throwError "top-level storage struct {name} must start at byte offset 0"
      let (members', names, skipped, booleanMembers, structFixedArrays, structMappings, structDynamicArrays, subStructs,
          signedMembers) ← decodeStructLayoutMembers name "" 0 types top
      let field : Field := { name, ty := .uint256, slot := some slot }
      return { slot, field, keyCount := 0, memberNames := names, opaqueNames := skipped,
               booleanMembers, signedMembers, structFixedArrays, structMappings, structDynamicArrays,
               subStructs, structMembers := members' }
    if let some baseId := optStr top "base" then
      unless (← mNat (← mField item "offset")) == 0 do
        throwError "top-level fixed storage array {name} must start at byte offset 0"
      let label ← mStr (← mField top "label")
      let [elementLabel, suffix] := label.splitOn "["
        | throwError "fixed storage arrays require exactly one fixed dimension: {label}"
      unless suffix.endsWith "]" do throwError "invalid fixed array layout {label}"
      let some length := (suffix.dropEnd 1).toNat?
        | throwError "fixed storage arrays require a resolved fixed length: {label}"
      unless length > 0 do throwError "fixed storage array length must be positive"
      let base ← liftM (layoutType types baseId)
      let baseLabel ← mStr (← mField base "label")
      unless elementLabel == baseLabel && baseLabel.startsWith "uint" do
        throwError "fixed storage arrays require unsigned scalar elements: {label}"
      let some width := bitsOf baseLabel
        | throwError "invalid fixed storage array element width: {baseLabel}"
      unless width > 0 && width ≤ 256 && width % 8 == 0 do
        throwError "invalid fixed storage array element width: {width}"
      unless (← mStr (← mField base "encoding")) == "inplace" &&
          (← mNat (← mField base "numberOfBytes")) * 8 == width do
        throwError "fixed storage array base layout disagrees with {baseLabel}"
      let perWord := 256 / width
      let words := (length + perWord - 1) / perWord
      unless (← mNat (← mField top "numberOfBytes")) == words * 32 do
        throwError "fixed storage array footprint disagrees with {label}"
      let mut members : Array StructMember := #[]
      for index in [:length] do
        let offset := (index % perWord) * width
        let packed : Option PackedBits :=
          if width == 256 then none else some { offset := offset, width := width }
        let member : StructMember :=
          { name := s!"__solidity_element_{index}", ty := .uint256, wordOffset := index / perWord, packed }
        members := members.push member
      let field : Field := { name, ty := .uint256, slot := some slot }
      return { slot, field, keyCount := 0, memberNames := #[], opaqueNames := #[],
               structMembers := members, fixedArrayLength := some length, fixedArrayType := label }
    let width ←
      if typeId == "t_bool" then pure 8
      else if typeId == "t_address" || typeId == "t_address_payable" || typeId.startsWith "t_contract(" then pure 160
      else if typeId == "t_bytes32" || typeId == "t_int256" then pure 256
      else if typeId.startsWith "t_uint" then
        let some bits := (typeId.drop 6).toNat? | throwError "invalid scalar uint layout {rawTypeId}"
        unless bits > 0 && bits ≤ 256 && bits % 8 == 0 do
          throwError "invalid scalar uint width {bits}"
        pure bits
      else throwError "unsupported {if isTransient then "transient " else ""}scalar storage type {rawTypeId}"
    let bytes ← mNat (← mField top "numberOfBytes")
    unless bytes * 8 == width do
      throwError "scalar storage size disagrees with type {rawTypeId}"
    let offset := (← mNat (← mField item "offset")) * 8
    unless offset + width ≤ 256 do throwError "scalar storage field {name} crosses a word boundary"
    let packedBits : Option PackedBits :=
      if offset == 0 && width == 256 then none else some { offset, width }
    -- Exact physical words; source types still govern conversions and ABI.
    let field : Field := { name, ty := .uint256, slot := some slot, packedBits, isTransient }
    return { slot, field, keyCount := 0, memberNames := #[], opaqueNames := #[],
             booleanScalar := typeId == "t_bool" }
  if encoding == "bytes" then
    unless typeId == "t_string_storage" || typeId == "t_bytes_storage" do
      throwError "unsupported bytes-encoded storage type {rawTypeId} for {name}"
    let bytes ← mNat (← mField top "numberOfBytes")
    let offset ← mNat (← mField item "offset")
    unless bytes == 32 && offset == 0 do
      throwError "bytes storage field {name} must occupy a full slot at offset 0"
    let field : Field := { name, ty := .uint256, slot := some slot }
    return { slot, field, keyCount := 0, memberNames := #[], opaqueNames := #[],
              bytesStorage := true, stringStorage := typeId == "t_string_storage" }
  if encoding == "dynamic_array" then
    let bytes ← mNat (← mField top "numberOfBytes")
    let offset ← mNat (← mField item "offset")
    unless bytes == 32 && offset == 0 do
      throwError "dynamic array storage field {name} must occupy a full slot at offset 0"
    let some baseKey := optStr top "base"
      | throwError "dynamic array storage field {name} is missing base type"
    let base ← liftM (layoutType types baseKey)
    unless (← mStr (← mField base "encoding")) == "inplace" do
      throwError "unsupported storage encoding {encoding} for {name}"
    let rawBaseLabel ← mStr (← mField base "label")
    let baseLabel := (← get).userValueTypes.find? rawBaseLabel |>.getD rawBaseLabel
    if let some elemSpec := dynamicStorageArrayElement? baseLabel then
      let (elemBits, _, _) := dynamicStorageArrayElemLayout elemSpec.1
      unless (← mNat (← mField base "numberOfBytes")) * 8 == elemBits do
        throwError "unsupported storage encoding {encoding} for {name}"
      let field : Field := { name, ty := .uint256, slot := some slot }
      return { slot, field, keyCount := 0, memberNames := #[], opaqueNames := #[],
               dynamicArrayElemType := some elemSpec }
    if (normalizeSolcLayoutType (← get) baseKey).startsWith "t_struct(" then
      let some sid := resolveStructIdFromSolcType? (← get) baseKey
        | throwError "unsupported storage encoding {encoding} for {name}"
      let rawInfo ← try resolveRawStructInfo sid Json.null catch _ =>
        throwError "unsupported storage encoding {encoding} for {name}"
      unless rawInfo.mappings.isEmpty && rawInfo.dynamicArrays.isEmpty &&
          rawInfo.subStructs.isEmpty && rawInfo.opaqueMemberNames.isEmpty &&
          !rawInfo.scalars.isEmpty && rawInfo.wordCount > 0 do
        throwError "unsupported storage encoding {encoding} for {name}"
      unless (← mNat (← mField base "numberOfBytes")) == rawInfo.wordCount * 32 do
        throwError "unsupported storage encoding {encoding} for {name}"
      let field : Field := { name, ty := .uint256, slot := some slot }
      return { slot, field, keyCount := 0, memberNames := #[], opaqueNames := #[],
               dynamicArrayElemType := some (rawBaseLabel, .uint256, .bytes32),
               dynamicArrayStructId := some sid }
    throwError "unsupported storage encoding {encoding} for {name}"
  unless encoding == "mapping" do
    throwError "unsupported storage encoding {encoding} for {name}"
  let key1 ← liftM (mappingKey (normalizeSolcLayoutType (← get) (← mStr (← mField top "key"))))
  let valueId ← mStr (← mField top "value")
  let value ← liftM (layoutType types valueId)
  let encoding ← mStr (← mField value "encoding")
  let (key2, structTy) ←
    if encoding == "mapping" then
      let key2 ← liftM (mappingKey (normalizeSolcLayoutType (← get) (← mStr (← mField value "key"))))
      let innerId ← mStr (← mField value "value")
      pure (some key2, ← liftM (layoutType types innerId))
    else if encoding == "inplace" || encoding == "bytes" then
      pure (none, value)
    else
      throwError "unsupported mapping value encoding {encoding} for {name}"
  if let some k2 := key2 then
    if (← mStr (← mField structTy "encoding")) == "mapping" then
      let key3 ← liftM (mappingKey (normalizeSolcLayoutType (← get) (← mStr (← mField structTy "key"))))
      let valKey ← mStr (← mField structTy "value")
      let leafTy ← liftM (layoutType types valKey)
      if (normalizeSolcLayoutType (← get) valKey).startsWith "t_struct(" then
        let some valSid := resolveStructIdFromSolcType? (← get) valKey
          | throwError "unsupported 3-key mapping value type {valKey} for {name}"
        let _ ← resolveRawStructInfo valSid Json.null
        let mapInfo : StructMappingInfo :=
          { member := "__solidity_value"
            solcType := valKey
            wordOffset := 0
            keyType := key3
            valueWidth := 256
            booleanValue := false
            valueStructId := some valSid }
        let field : Field := { name, ty := .mappingStruct2 key1 k2 [], slot := some slot }
        return { slot, field, keyCount := 2, memberNames := #[], opaqueNames := #[],
                 thirdKeyMapping := some mapInfo }
      if (field? leafTy "members").isNone && (optStr leafTy "base").isNone then
        let leafEncoding ← mStr (← mField leafTy "encoding")
        unless leafEncoding == "inplace" do
          throwError "unsupported 3-key mapping value encoding {leafEncoding} for {name}"
        let rawLeafType ← mStr (← mField leafTy "label")
        let leafType := (← get).userValueTypes.find? rawLeafType |>.getD rawLeafType
        let width ←
          if leafType == "bool" then pure 8
          else if leafType == "address" || leafType == "address payable" || leafType.startsWith "contract " then pure 160
          else if leafType == "bytes32" || leafType == "int256" || leafType == "int" then pure 256
          else if leafType.startsWith "uint" then
            let some bits := (leafType.drop 4).toNat? | throwError "invalid 3-key mapping uint layout {rawLeafType}"
            unless bits > 0 && bits ≤ 256 && bits % 8 == 0 do
              throwError "invalid 3-key mapping uint width {bits}"
            pure bits
          else throwError "unsupported 3-key mapping value type {rawLeafType} for {name}"
        let bytes ← mNat (← mField leafTy "numberOfBytes")
        unless bytes * 8 == width do
          throwError "3-key mapping value size disagrees with type {rawLeafType}"
        let mapInfo : StructMappingInfo :=
          { member := "__solidity_value"
            solcType := valKey
            wordOffset := 0
            keyType := key3
            valueWidth := width
            booleanValue := leafType == "bool" }
        let field : Field := { name, ty := .mappingStruct2 key1 k2 [], slot := some slot }
        return { slot, field, keyCount := 2, memberNames := #[], opaqueNames := #[],
                 thirdKeyMapping := some mapInfo }
      throwError "unsupported 3-key mapping value type for {name}"
  -- Fixed arrays have finite elements, not an extra mapping key. Solidity
  -- packs floor(256/width) elements per word, leaving any remainder unused.
  if let some baseId := optStr structTy "base" then
    unless (← mStr (← mField structTy "encoding")) == "inplace" do
      throwError "only fixed inplace mapping arrays are supported for {name}"
    let label ← mStr (← mField structTy "label")
    let [elementLabel, suffix] := label.splitOn "["
      | throwError "mapping arrays require exactly one fixed dimension: {label}"
    unless suffix.endsWith "]" do throwError "invalid fixed array layout {label}"
    let some length := (suffix.dropEnd 1).toNat?
      | throwError "mapping arrays require a resolved fixed length: {label}"
    unless length > 0 do throwError "fixed mapping array length must be positive"
    let base ← liftM (layoutType types baseId)
    let baseLabel ← mStr (← mField base "label")
    unless elementLabel == baseLabel && baseLabel.startsWith "uint" do
      throwError "fixed mapping arrays require unsigned scalar elements: {label}"
    let some width := bitsOf baseLabel
      | throwError "invalid fixed mapping array element width: {baseLabel}"
    unless width > 0 && width ≤ 256 && width % 8 == 0 do
      throwError "invalid fixed mapping array element width: {width}"
    unless (← mStr (← mField base "encoding")) == "inplace" &&
        (← mNat (← mField base "numberOfBytes")) * 8 == width do
      throwError "fixed mapping array base layout disagrees with {baseLabel}"
    let perWord := 256 / width
    let words := (length + perWord - 1) / perWord
    unless (← mNat (← mField structTy "numberOfBytes")) == words * 32 do
      throwError "fixed mapping array footprint disagrees with {label}"
    let mut members : Array StructMember := #[]
    for index in [:length] do
      let offset := (index % perWord) * width
      let packed : Option PackedBits :=
        if width == 256 then none else some { offset := offset, width := width }
      let member : StructMember := { name := s!"__solidity_element_{index}", ty := .uint256, wordOffset := index / perWord, packed }
      members := members.push member
    let ty : FieldType := match key2 with
      | some k2 => .mappingStruct2 key1 k2 members.toList
      | none => .mappingStruct key1 members.toList
    return { slot, field := { name, ty, slot := some slot },
             keyCount := if key2.isSome then 2 else 1, memberNames := #[],
             opaqueNames := #[], fixedArrayLength := some length, fixedArrayType := label }
  -- A scalar mapping value occupies a word just like a one-member mapping
  -- struct. Keep narrow writes as read/modify/write operations, including the
  -- one-byte Solidity bool representation, rather than clearing upper bits.
  if (field? structTy "members").isNone then
    let leafEncoding ← mStr (← mField structTy "encoding")
    if leafEncoding == "bytes" then
      let rawLeafType ← mStr (← mField structTy "label")
      unless rawLeafType == "string" || (rawLeafType == "bytes" && key2.isSome) do
        throwError "unsupported mapping value encoding {leafEncoding} for {name}"
      let bytes ← mNat (← mField structTy "numberOfBytes")
      unless bytes == 32 do
        throwError "bytes-encoded mapping value size disagrees with type {rawLeafType}"
      let ty : FieldType := match key2 with
        | some k2 => .mappingStruct2 key1 k2 []
        | none => .mappingStruct key1 []
      let field : Field := { name, ty, slot := some slot }
      return { slot, field, keyCount := if key2.isSome then 2 else 1,
               memberNames := #[], opaqueNames := #[], bytesStorage := true,
               stringStorage := rawLeafType == "string" }
    unless leafEncoding == "inplace" do
      throwError "unsupported scalar mapping value encoding {leafEncoding} for {name}"
    let rawLeafType ← mStr (← mField structTy "label")
    let leafType := (← get).userValueTypes.find? rawLeafType |>.getD rawLeafType
    let width ←
      if leafType == "bool" then pure 8
      else if leafType == "address" || leafType == "address payable" || leafType.startsWith "contract " then pure 160
      else if leafType == "bytes32" || leafType == "int256" || leafType == "int" then pure 256
      else if leafType.startsWith "uint" then
        let some bits := (leafType.drop 4).toNat? | throwError "invalid mapping uint layout {rawLeafType}"
        unless bits > 0 && bits ≤ 256 && bits % 8 == 0 do
          throwError "invalid mapping uint width {bits}"
        pure bits
      else throwError "unsupported scalar mapping value type {rawLeafType}"
    let bytes ← mNat (← mField structTy "numberOfBytes")
    unless bytes * 8 == width do
      throwError "scalar mapping value size disagrees with type {rawLeafType}"
    let packed : Option PackedBits :=
      if width == 256 then none else some { offset := 0, width }
    let member : StructMember :=
      { name := "__solidity_value", ty := .uint256, wordOffset := 0, packed }
    let ty : FieldType := match key2 with
      | some k2 => .mappingStruct2 key1 k2 [member]
      | none => .mappingStruct key1 [member]
    let field : Field := { name, ty, slot := some slot }
    return { slot, field, keyCount := if key2.isSome then 2 else 1,
             memberNames := #[], opaqueNames := #[], scalarMapping := true,
             booleanMapping := leafType == "bool" }
  let (members', names, skipped, booleanMembers, structFixedArrays, structMappings, structDynamicArrays, subStructs,
      signedMembers) ← decodeStructLayoutMembers name "" 0 types structTy
  let ty : FieldType :=
    match key2 with
    | some k2 => .mappingStruct2 key1 k2 members'.toList
    | none => .mappingStruct key1 members'.toList
  let field : Field := { name, ty, slot := some slot }
  pure { slot, field, keyCount := if key2.isSome then 2 else 1,
         memberNames := names, opaqueNames := skipped, booleanMembers, structFixedArrays, structMappings,
         structDynamicArrays, subStructs, signedMembers, structMembers := members' }

/-- Marks a layout item that came from solc's `transientStorageLayout`. -/
private def transientLayoutKey : String := "verityTransientLayout"

/-- Record a transient state variable in the current root's closure. -/
private def noteTransientField (info : FieldInfo) : M Unit := do
  let name := info.field.name
  if info.field.isTransient && !(← get).rootTransientFields.contains name then
    modify fun e => { e with rootTransientFields := e.rootTransientFields.push name }

/-- Resolve only reached fields: an unrelated unsupported layout must not
prevent importing a supported function closure. -/
private def resolveField (name : String) (at_ : Json) : M FieldInfo := do
  if name == rawStorageFieldName || name.startsWith "_verity_struct_" then
    failAt at_ s!"reserved storage field name {name}"
  if let some info := (← get).fieldsByName.find? name then
    noteTransientField info
    return info
  let env ← get
  let some item := env.layoutItems.find? name | failAt at_ s!"no storage layout for {name}"
  let isTransient := (field? item transientLayoutKey).bind (·.getBool?.toOption) == some true
  let types := if isTransient then env.transientLayoutTypes else env.layoutTypes
  let info ← try buildField types item isTransient catch ex =>
    failAt at_ (← ex.toMessageData.toString)
  modify fun e => { e with fieldsByName := e.fieldsByName.insert name info }
  noteTransientField info
  return info

/-- A member write through a memory struct parameter bound from the caller's own struct would
reach the caller in solc; the parameter is a copy here, so the write is rejected. -/
private def rejectByRefStructWrite (structLocalId : Nat) (at_ : Json) : M Unit := do
  if (← get).byRefFlatStructs.contains structLocalId then
    failAt at_ ("member write through a memory struct parameter is outside this slice " ++
      "(it would change the caller's struct)")

/-- Whether `j` can evaluate to a memory struct parameter bound from the caller's own struct,
through parentheses, conditionals and tuple components (member accesses read a scalar). -/
private partial def refersToByRefStruct (j : Json) : M Bool := do
  match ← mKind j with
  | "Identifier" =>
      let id ← refInt j
      pure (id ≥ 0 && (← get).byRefFlatStructs.contains id.toNat)
  | "TupleExpression" =>
      (← mArr (← mField j "components")).anyM fun c =>
        if c.isNull then pure false else refersToByRefStruct c
  | "Conditional" =>
      pure ((← refersToByRefStruct (← mField j "trueExpression")) ||
        (← refersToByRefStruct (← mField j "falseExpression")))
  | "MemberAccess" =>
      -- A nested struct member of a by-reference struct is part of the alias.
      if (← mType j).startsWith "struct " then refersToByRefStruct (← mField j "expression")
      else pure false
  | _ => pure false

/-- Whether `j` denotes a struct element in memory (`a[i]`, or a local or
parameter bound to one): solc returns its pointer, so a struct helper returning
it hands the caller an alias, which a flat copy cannot model once the element
is written. -/
private partial def refersToMemoryStructElement (j : Json) : M Bool := do
  match ← mKind j with
  | "Identifier" =>
      let id ← refInt j
      pure (id ≥ 0 && ((← get).abiElements.find? id.toNat).any (·.inMemory))
  | "IndexAccess" => pure ((← mType j).startsWith "struct " && (← mType j).endsWith " memory")
  | "TupleExpression" =>
      (← mArr (← mField j "components")).anyM fun c =>
        if c.isNull then pure false else refersToMemoryStructElement c
  | "Conditional" =>
      pure ((← refersToMemoryStructElement (← mField j "trueExpression")) ||
        (← refersToMemoryStructElement (← mField j "falseExpression")))
  | _ => pure false

/-- The declarations whose struct value `j` may denote (through tuples,
conditionals and struct-typed member accesses). Two components of one `return`
tuple that share one hand the caller the same pointer twice, which separate flat
copies cannot model once either is written. -/
private partial def structValueRefIds (j : Json) : M (Array Nat) := do
  match ← mKind j with
  | "Identifier" =>
      let id ← refInt j
      pure (if id ≥ 0 && (← mType j).startsWith "struct " then #[id.toNat] else #[])
  | "TupleExpression" =>
      (← mArr (← mField j "components")).foldlM (init := #[]) fun acc c => do
        if c.isNull then pure acc else pure (acc ++ (← structValueRefIds c))
  | "Conditional" =>
      return (← structValueRefIds (← mField j "trueExpression")) ++
        (← structValueRefIds (← mField j "falseExpression"))
  | "MemberAccess" =>
      if (← mType j).startsWith "struct " then structValueRefIds (← mField j "expression")
      else pure #[]
  | _ => pure #[]

private def readRawStructScalar (pre : Array Stmt) (baseSlot : Expr) (mInfo : RawStructMemberInfo) : M Val := do
  modify fun e => { e with usedRawStorage := true }
  let wordSlot := rawStructMemberSlot baseSlot mInfo.wordOffset
  let rawWord := Expr.storageArrayElement rawStorageFieldName wordSlot
  let shifted := if mInfo.byteOffset == 0 then rawWord else Expr.shr (.literal (mInfo.byteOffset * 8)) rawWord
  let masked := if mInfo.bitWidth < 256 then Expr.bitAnd shifted (.literal (2 ^ mInfo.bitWidth - 1)) else shifted
  -- solc loads a narrow signed member sign-extended; every `intN` consumer expects that word.
  let cleaned := if mInfo.isBool then Expr.logicalNot (.logicalNot masked)
    else match signedBitsOf mInfo.ty with
      | some bits => if bits < 256 then Expr.signextend (.literal (bits / 8 - 1)) masked else masked
      | none => masked
  let dest ← fresh
  pure { pre := pre.push (.letVar dest cleaned), expr := .localVar dest }

private def writeRawStructScalar (pre : Array Stmt) (baseSlot : Expr) (mInfo : RawStructMemberInfo)
    (valExpr : Expr) (deleting : Bool) : M (Array Stmt) := do
  modify fun e => { e with usedRawStorage := true }
  let wordSlot := rawStructMemberSlot baseSlot mInfo.wordOffset
  let cleanVal :=
    if mInfo.isBool && !deleting then Expr.logicalNot (.logicalNot valExpr)
    else if mInfo.bitWidth < 256 then Expr.bitAnd valExpr (.literal (2 ^ mInfo.bitWidth - 1))
    else valExpr
  if mInfo.bitWidth == 256 && mInfo.byteOffset == 0 then
    return pre.push (.setStorageArrayElement rawStorageFieldName wordSlot cleanVal)
  else
    let shiftBits := mInfo.byteOffset * 8
    let mask := (2 ^ mInfo.bitWidth - 1) * (2 ^ shiftBits)
    let invMask := (2 ^ 256 - 1) - mask
    let shiftedVal := if deleting then Expr.literal 0 else if shiftBits == 0 then cleanVal else Expr.shl (.literal shiftBits) cleanVal
    let oldWord ← fresh
    let newWord := if deleting then Expr.bitAnd (.localVar oldWord) (.literal invMask)
                   else Expr.bitOr (.bitAnd (.localVar oldWord) (.literal invMask)) shiftedVal
    return pre ++ #[
      .letVar oldWord (.storageArrayElement rawStorageFieldName wordSlot),
      .setStorageArrayElement rawStorageFieldName wordSlot newWord
    ]

private def resolveStructDynamicSlot (path : SPath) (dynInfo : StructDynamicArrayInfo) (at_ : Json) :
    M (Array Stmt × Expr) := do
  if let .rawSlot _ baseSlot := path then
    return (#[], rawStructMemberSlot baseSlot dynInfo.wordOffset)
  else
    let rawName ← match path with
      | .zero name | .one name _ | .two name _ _ => pure name
      | .outer _ _ | .rawSlot _ _ | .bytesSlot _ _ =>
          failAt at_ "struct dynamic array element requires all outer mapping keys"
    let (name, _) := splitSPathField rawName
    let info ← resolveField name at_
    markField name
    markStructDynamicArray name dynInfo.member
    computeSPathBaseSlot path info dynInfo.wordOffset at_

private def readStorageDynamicArrayElement (pre : Array Stmt) (fieldName : String) (slotExpr : Expr)
    (elemTy : String) (indexExpr : Expr) (oobStmt : Stmt := .panicCode (.literal 0x32)) : M Val := do
  modify fun e => { e with encodingMemory := true, usedRawStorage := true }
  if fieldName != "" then
    markField fieldName
  let (bits, perWord, isBool) := dynamicStorageArrayElemLayout elemTy
  let lenVal ← readStorageDynamicArrayLength pre fieldName slotExpr
  let baseDataSlot ← fresh
  let elemSlot ← fresh
  let dest ← fresh
  let wordOff := if perWord == 1 then indexExpr else Expr.div indexExpr (.literal perWord)
  let rawWord := Expr.storageArrayElement rawStorageFieldName (.localVar elemSlot)
  let shifted :=
    if perWord == 1 then rawWord
    else Expr.shr (.mul (.mod indexExpr (.literal perWord)) (.literal bits)) rawWord
  let masked :=
    if bits < 256 then Expr.bitAnd shifted (.literal (2 ^ bits - 1))
    else shifted
  let cleaned := if isBool then Expr.logicalNot (.logicalNot masked) else masked
  let stmts : Array Stmt := #[
    .ite (.lt indexExpr lenVal.expr) [] [oobStmt],
    .mstore (.literal 0) slotExpr,
    .letVar baseDataSlot (.keccak256 (.literal 0) (.literal 32)),
    .letVar elemSlot (.add (.localVar baseDataSlot) wordOff),
    .letVar dest cleaned
  ]
  pure { pre := lenVal.pre ++ stmts, expr := .localVar dest }

/-- solc's bounds check on a fixed-size storage array `T[N]`: an index `≥ N` raises
`Panic(0x32)` before any storage access. -/
private def rawFixedArrayBound (arrInfo : StructFixedArrayInfo) (indexExpr : Expr) : Stmt :=
  .ite (.lt indexExpr (.literal arrInfo.length)) [] [.panicCode (.literal 0x32)]

/-- Element `index` of a fixed-size array member `T[N]` of a raw-slot storage struct. The
array sits in place at `arrSlot` (no hash): word `index / perWord`, lane `index % perWord`
from the lowest-order bits, as solc lays out a static storage array. -/
private def readRawFixedArrayElement (pre : Array Stmt) (arrSlot : Expr)
    (arrInfo : StructFixedArrayInfo) (indexExpr : Expr) : M Val := do
  modify fun e => { e with usedRawStorage := true }
  let (bits, perWord, isBool) := dynamicStorageArrayElemLayout arrInfo.elemType
  let elemSlot ← fresh
  let dest ← fresh
  let wordOff := if perWord == 1 then indexExpr else Expr.div indexExpr (.literal perWord)
  let rawWord := Expr.storageArrayElement rawStorageFieldName (.localVar elemSlot)
  let shifted :=
    if perWord == 1 then rawWord
    else Expr.shr (.mul (.mod indexExpr (.literal perWord)) (.literal bits)) rawWord
  let masked := if bits < 256 then Expr.bitAnd shifted (.literal (2 ^ bits - 1)) else shifted
  let cleaned := if isBool then Expr.logicalNot (.logicalNot masked) else masked
  pure { pre := pre ++ #[rawFixedArrayBound arrInfo indexExpr,
                         .letVar elemSlot (.add arrSlot wordOff), .letVar dest cleaned],
         expr := .localVar dest }

/-- Write (or, when `deleting`, zero) element `index` of a raw-slot struct's fixed-size array
member at `arrSlot`, keeping the other lanes of its word. -/
private def writeRawFixedArrayElement (pre : Array Stmt) (arrSlot : Expr)
    (arrInfo : StructFixedArrayInfo) (indexExpr valExpr : Expr) (deleting : Bool) :
    M (Array Stmt) := do
  modify fun e => { e with usedRawStorage := true }
  let baseSlot ← fresh
  let writeStmts ←
    writeStorageDynamicArrayElementAtUnchecked baseSlot arrInfo.elemType indexExpr valExpr deleting
  return pre ++ #[rawFixedArrayBound arrInfo indexExpr, .letVar baseSlot arrSlot] ++ writeStmts

/-- solc's guard before a storage array grows, for value and struct elements alike:
`if iszero(lt(oldLen, 2^64)) { panic_error_0x41() }`, before the new length is written. It
keeps every element index below `2^64`. -/
private def pushLengthGuard (oldLen : Expr) : Stmt :=
  .ite (.lt oldLen (.literal (2 ^ 64))) [] [.panicCode (.literal 0x41)]

/-- `arr.push(v)` writes `v` into the new element's lane. An empty `arr.push()` writes nothing,
as solc's `array_push_zero_*` helpers: storage past the length keeps whatever it held, which
inline assembly can leave non-zero by lowering a length over written elements. With
`readPushed`, the result is the element's current value (`x = arr.push()` reads it); otherwise
it is never read and stays `0`. -/
private def pushStorageDynamicArray (pre : Array Stmt) (fieldName : String) (slotExpr : Expr)
    (elemTy : String) (valExpr? : Option Expr) (readPushed : Bool := false) : M Val := do
  modify fun e => { e with encodingMemory := true, usedRawStorage := true }
  if fieldName != "" then
    markField fieldName
  let lenVal ← readStorageDynamicArrayLength pre fieldName slotExpr
  let newLen ← fresh
  let baseDataSlot ← fresh
  let writeLenStmt : Stmt :=
    if fieldName != "" then .setStorage fieldName (.localVar newLen)
    else .setStorageArrayElement rawStorageFieldName slotExpr (.localVar newLen)
  let mut writeStmts : Array Stmt := #[]
  let mut elemVal : Expr := .literal 0
  if let some valExpr := valExpr? then
    writeStmts ← writeStorageDynamicArrayElementAtUnchecked baseDataSlot elemTy lenVal.expr valExpr false
    elemVal := valExpr
  else if readPushed then
    let (bits, perWord, isBool) := dynamicStorageArrayElemLayout elemTy
    let elemSlot ← fresh
    let dest ← fresh
    let wordOff := if perWord == 1 then lenVal.expr else Expr.div lenVal.expr (.literal perWord)
    let rawWord := Expr.storageArrayElement rawStorageFieldName (.localVar elemSlot)
    let shifted :=
      if perWord == 1 then rawWord
      else Expr.shr (.mul (.mod lenVal.expr (.literal perWord)) (.literal bits)) rawWord
    let masked := if bits < 256 then Expr.bitAnd shifted (.literal (2 ^ bits - 1)) else shifted
    let cleaned := if isBool then Expr.logicalNot (.logicalNot masked) else masked
    writeStmts := #[.letVar elemSlot (.add (.localVar baseDataSlot) wordOff), .letVar dest cleaned]
    elemVal := .localVar dest
  let stmts : Array Stmt := #[
    pushLengthGuard lenVal.expr,
    .letVar newLen (.add lenVal.expr (.literal 1)),
    writeLenStmt,
    .mstore (.literal 0) slotExpr,
    .letVar baseDataSlot (.keccak256 (.literal 0) (.literal 32))
  ] ++ writeStmts
  pure { pre := lenVal.pre ++ stmts, expr := elemVal }

private def pushStorageDynamicStructArray (pre : Array Stmt) (fieldName : String) (slotExpr : Expr)
    (elemSid : Nat) (memberVals? : Option (Array (String × String × Expr))) (at_ : Json) :
    M (Array Stmt × SPath) := do
  modify fun e => { e with encodingMemory := true, usedRawStorage := true }
  if fieldName != "" then
    markField fieldName
  let rawInfo ← resolveRawStructInfo elemSid at_
  let lenVal ← readStorageDynamicArrayLength pre fieldName slotExpr
  let newLen ← fresh
  let baseDataSlot ← fresh
  let elemSlot ← fresh
  let writeLenStmt : Stmt :=
    if fieldName != "" then .setStorage fieldName (.localVar newLen)
    else .setStorageArrayElement rawStorageFieldName slotExpr (.localVar newLen)
  let wordOff := if rawInfo.wordCount == 1 then lenVal.expr else Expr.mul lenVal.expr (.literal rawInfo.wordCount)
  let mut stmts : Array Stmt := #[
    pushLengthGuard lenVal.expr,
    .letVar newLen (.add lenVal.expr (.literal 1)),
    writeLenStmt,
    .mstore (.literal 0) slotExpr,
    .letVar baseDataSlot (.keccak256 (.literal 0) (.literal 32)),
    .letVar elemSlot (.add (.localVar baseDataSlot) wordOff)
  ]
  -- No zero fill: solc's empty `push()` writes nothing, and `push(v)` writes each member into
  -- its lane, keeping the bits between members (`pushStorageDynamicArray`).
  if let some memberVals := memberVals? then
    unless memberVals.size == rawInfo.scalars.size do
      failAt at_ "struct array push member count mismatch"
    for (mName, _, mExpr) in memberVals do
      let some mInfo := rawInfo.scalars.find? (·.member == mName)
        | failAt at_ s!"unknown struct member {mName}"
      let writeStmts ← writeRawStructScalar #[] (.localVar elemSlot) mInfo mExpr false
      stmts := stmts ++ writeStmts
  return (lenVal.pre ++ stmts, .rawSlot elemSid (.localVar elemSlot))

private def popStorageDynamicArray (pre : Array Stmt) (fieldName : String) (slotExpr : Expr)
    (elemTy : String) (elemStructId? : Option Nat := none) (at_ : Json := Json.null) : M (Array Stmt) := do
  modify fun e => { e with encodingMemory := true, usedRawStorage := true }
  if fieldName != "" then
    markField fieldName
  let lenVal ← readStorageDynamicArrayLength pre fieldName slotExpr
  let newLen ← fresh
  let baseDataSlot ← fresh
  let clearStmts ← match elemStructId? with
    | some elemSid => do
        let rawInfo ← resolveRawStructInfo elemSid at_
        let elemSlot ← fresh
        let wordOff := if rawInfo.wordCount == 1 then Expr.localVar newLen else Expr.mul (.localVar newLen) (.literal rawInfo.wordCount)
        let mut clears : Array Stmt := #[
          .letVar elemSlot (.add (.localVar baseDataSlot) wordOff)
        ]
        for w in [:rawInfo.wordCount] do
          clears := clears.push (.setStorageArrayElement rawStorageFieldName (rawStructMemberSlot (.localVar elemSlot) w) (.literal 0))
        pure clears
    | none =>
        writeStorageDynamicArrayElementAtUnchecked baseDataSlot elemTy (.localVar newLen) (.literal 0) true
  let writeLenStmt : Stmt :=
    if fieldName != "" then .setStorage fieldName (.localVar newLen)
    else .setStorageArrayElement rawStorageFieldName slotExpr (.localVar newLen)
  let stmts : Array Stmt := #[
    .ite (.gt lenVal.expr (.literal 0)) [] [.panicCode (.literal 0x31)],
    .letVar newLen (.sub lenVal.expr (.literal 1)),
    .mstore (.literal 0) slotExpr,
    .letVar baseDataSlot (.keccak256 (.literal 0) (.literal 32))
  ] ++ clearStmts ++ #[
    writeLenStmt
  ]
  return lenVal.pre ++ stmts

private def copyStorageDynamicArrayToMemory (pre : Array Stmt) (fieldName : String) (slotExpr : Expr)
    (elemTy : String) (modelElemTy : ParamType) (abiKind : SolidityAbi.ScalarKind) (hintName : String) :
    M (Array Stmt × ScalarArrayParam) := do
  modify fun e => { e with encodingMemory := true, usedRawStorage := true }
  if fieldName != "" then
    markField fieldName
  let (bits, perWord, isBool) := dynamicStorageArrayElemLayout elemTy
  let lenVal ← readStorageDynamicArrayLength pre fieldName slotExpr
  let lengthBinding ← freshFor (if hintName == "" then "arr_len" else s!"{hintName}_len")
  let arrayPtr ← freshFor (if hintName == "" then "arr_ptr" else hintName)
  let nextFree ← fresh
  let baseDataSlot ← fresh
  let copyIdx ← fresh
  let byteCount := Expr.add (.literal 32) (.mul (.localVar lengthBinding) (.literal 32))
  let allocStmts := AbiEncoding.reserve arrayPtr nextFree byteCount
  let wordOff :=
    if perWord == 1 then Expr.localVar copyIdx
    else Expr.div (.localVar copyIdx) (.literal perWord)
  let rawWord := Expr.storageArrayElement rawStorageFieldName (.add (.localVar baseDataSlot) wordOff)
  let shifted :=
    if perWord == 1 then rawWord
    else Expr.shr (.mul (.mod (.localVar copyIdx) (.literal perWord)) (.literal bits)) rawWord
  let masked :=
    if bits < 256 then Expr.bitAnd shifted (.literal (2 ^ bits - 1))
    else shifted
  let elemVal := if isBool then Expr.logicalNot (.logicalNot masked) else masked
  let copyStmts : Array Stmt := #[
    .letVar lengthBinding lenVal.expr
  ] ++ allocStmts.toArray ++ #[
    .mstore (.localVar arrayPtr) (.localVar lengthBinding),
    .mstore (.literal 0) slotExpr,
    .letVar baseDataSlot (.keccak256 (.literal 0) (.literal 32)),
    .forEach copyIdx (.localVar lengthBinding) [
      .mstore
        (.add (.add (.localVar arrayPtr) (.literal 32)) (.mul (.localVar copyIdx) (.literal 32)))
        elemVal
    ]
  ]
  let desc : ScalarArrayParam := {
    param := hintName
    elementType := elemTy
    modelElementType := modelElemTy
    abiKind
    inMemory := true
    lengthBinding
    memoryPointer := arrayPtr
    nextFreeBinding := nextFree
  }
  return (lenVal.pre ++ copyStmts, desc)

private def computeStructMappingLeafSlot (path : SPath) (info : FieldInfo) (mapInfo : StructMappingInfo)
    (innerKey : Expr) (at_ : Json) : M (Array Stmt × Expr) := do
  modify fun e => { e with encodingMemory := true, usedRawStorage := true }
  let (baseStmts, mapBaseExpr) ← computeSPathBaseSlot path info mapInfo.wordOffset at_
  let leafSlot ← fresh
  let leafStmts : Array Stmt := #[
    .mstore (.literal 0) innerKey,
    .mstore (.literal 32) mapBaseExpr,
    .letVar leafSlot (.keccak256 (.literal 0) (.literal 64))
  ]
  return (baseStmts ++ leafStmts, .localVar leafSlot)

/-- Admission belongs to the consumer, not to the load: solc extracts an 8-bit
    ordinal but only validates it when encoding the external result. -/
private partial def localReferencedIn (node : Json) (id : Nat) : Bool :=
  match node with
  | .arr xs => xs.any (localReferencedIn · id)
  | .obj o => o.foldl (fun found k v => found ||
      ((k == "referencedDeclaration" || k == "declaration") && v.getNat?.toOption == some id) ||
      localReferencedIn v id) false
  | _ => false

private def withStorageEnumUse (node : Json) (validate : Bool) (k : M α) : M α := do
  let saved := (← get).storageEnumUse
  let id := (field? node "id").bind (·.getNat?.toOption)
  modify fun e => { e with storageEnumUse := id.map (·, validate) }
  try k finally modify fun e => { e with storageEnumUse := saved }

private def enumMemberCountForNode (node : Json) (ty : String) : M Nat := do
  -- The declaration id in solc's type identifier disambiguates homonymous enums.
  if let some td := field? node "typeDescriptions" then
    if let some tid := optStr td "typeIdentifier" then
      if let some members := ((tid.splitOn "_$").getLast?.bind String.toNat?).bind (← get).enums.find? then
        return members.size
  if let some (_, members) := (← get).enumByType.find? ty then
    return members.size
  failAt node s!"unresolved storage enum {ty}"

private def storageEnumRead (node : Json) (v : Val) : M Val := do
  let ty := ((field? node "typeDescriptions").bind (optStr · "typeString")).getD ""
  unless ty.startsWith "enum " do return v
  let id ← mNat (← mField node "id")
  -- Initializing an unreferenced local (`Mode a = entries[id].mode;`) only extracts
  -- the low byte in solc (`cleanup_from_storage_t_enum`) without checking the bound.
  if let some (allowed, false) := (← get).storageEnumUse then
    if allowed == id then return v
  let count ← enumMemberCountForNode node ty
  let a ← atom v
  return { a with pre := a.pre.push (.ite (.lt a.expr (.literal count)) [] [.panicCode (.literal 0x21)]) }

/-- Validate an enum ordinal before packing into storage (`cleanup_t_enum`: Panic 0x21
    when out of range), matching solc's `update_storage_value` conversion. Enum literals
    are compile-time valid and need no runtime check. -/
private def validateStoredEnumValue (target rhs : Json) (v : Val) : M Val := do
  let ty ← mType target
  unless ty.startsWith "enum " do return v
  let baseTy := (field? rhs "expression").bind (field? · "typeDescriptions")
    |>.bind (optStr · "typeString")
  if optStr rhs "nodeType" == some "MemberAccess" &&
      baseTy.any (·.startsWith "type(enum ") then
    return v
  let count ← enumMemberCountForNode target ty
  let a ← atom v
  return { a with pre := a.pre.push (.ite (.lt a.expr (.literal count)) [] [.panicCode (.literal 0x21)]) }

private def validateEnumExpr (at_ : Json) (ty : String) (v : Expr) : M (Array Stmt × Expr) := do
  unless ty.startsWith "enum " do return (#[], v)
  let count ← enumMemberCountForNode at_ ty
  let a ← atom { pre := #[], expr := v }
  return (a.pre.push (.ite (.lt a.expr (.literal count)) [] [.panicCode (.literal 0x21)]), a.expr)

private def readStructMappingElement (pre : Array Stmt) (path : SPath) (mapInfo : StructMappingInfo)
    (innerKey : Expr) (at_ : Json) : M Val := do
  if let .rawSlot _ baseSlot := path then
    modify fun e => { e with encodingMemory := true, usedRawStorage := true }
    let mapBaseExpr := rawStructMemberSlot baseSlot mapInfo.wordOffset
    let leafSlot ← fresh
    let slotStmts : Array Stmt := #[
      .mstore (.literal 0) innerKey,
      .mstore (.literal 32) mapBaseExpr,
      .letVar leafSlot (.keccak256 (.literal 0) (.literal 64))
    ]
    let raw := Expr.storageArrayElement rawStorageFieldName (.localVar leafSlot)
    let masked :=
      if mapInfo.valueWidth < 256 then Expr.bitAnd raw (.literal (2 ^ mapInfo.valueWidth - 1))
      else raw
    let cleaned :=
      if mapInfo.booleanValue then Expr.logicalNot (.logicalNot masked)
      else masked
    let dest ← fresh
    return { pre := pre ++ slotStmts ++ #[.letVar dest cleaned], expr := .localVar dest }
  let rawName ← match path with
    | .zero name | .one name _ | .two name _ _ => pure name
    | .outer _ _ | .rawSlot _ _ | .bytesSlot _ _ =>
        failAt at_ "struct mapping element requires both outer mapping keys"
  let (name, _) := splitSPathField rawName
  let info ← resolveField name at_
  markField name
  markStructMapping name mapInfo.member
  let (slotStmts, slotExpr) ← computeStructMappingLeafSlot path info mapInfo innerKey at_
  let raw := Expr.storageArrayElement rawStorageFieldName slotExpr
  let masked :=
    if mapInfo.valueWidth < 256 then Expr.bitAnd raw (.literal (2 ^ mapInfo.valueWidth - 1))
    else raw
  let cleaned :=
    if mapInfo.booleanValue then Expr.logicalNot (.logicalNot masked)
    else masked
  let dest ← fresh
  pure { pre := pre ++ slotStmts ++ #[.letVar dest cleaned], expr := .localVar dest }

private def writeStructMappingElement (pre : Array Stmt) (path : SPath) (mapInfo : StructMappingInfo)
    (innerKey valExpr : Expr) (deleting : Bool) (at_ : Json) : M (Array Stmt) := do
  if let .rawSlot _ baseSlot := path then
    modify fun e => { e with encodingMemory := true, usedRawStorage := true }
    let mapBaseExpr := rawStructMemberSlot baseSlot mapInfo.wordOffset
    let leafSlot ← fresh
    let slotStmts : Array Stmt := #[
      .mstore (.literal 0) innerKey,
      .mstore (.literal 32) mapBaseExpr,
      .letVar leafSlot (.keccak256 (.literal 0) (.literal 64))
    ]
    let slotExpr := Expr.localVar leafSlot
    let cleanVal :=
      if mapInfo.booleanValue && !deleting then Expr.logicalNot (.logicalNot valExpr)
      else if mapInfo.valueWidth < 256 then Expr.bitAnd valExpr (.literal (2 ^ mapInfo.valueWidth - 1))
      else valExpr
    if mapInfo.valueWidth == 256 then
      return pre ++ slotStmts ++ #[.setStorageArrayElement rawStorageFieldName slotExpr cleanVal]
    else
      let mask := 2 ^ mapInfo.valueWidth - 1
      let invMask := (2 ^ 256 - 1) - mask
      let oldWord ← fresh
      let newWord := Expr.bitOr (.bitAnd (.localVar oldWord) (.literal invMask)) cleanVal
      return pre ++ slotStmts ++ #[
        .letVar oldWord (.storageArrayElement rawStorageFieldName slotExpr),
        .setStorageArrayElement rawStorageFieldName slotExpr newWord
      ]
  let rawName ← match path with
    | .zero name | .one name _ | .two name _ _ => pure name
    | .outer _ _ | .rawSlot _ _ | .bytesSlot _ _ =>
        failAt at_ "struct mapping element requires both outer mapping keys"
  let (name, _) := splitSPathField rawName
  let info ← resolveField name at_
  markField name
  markStructMapping name mapInfo.member
  let (slotStmts, slotExpr) ← computeStructMappingLeafSlot path info mapInfo innerKey at_
  let cleanVal :=
    if mapInfo.booleanValue && !deleting then Expr.logicalNot (.logicalNot valExpr)
    else if mapInfo.valueWidth < 256 then Expr.bitAnd valExpr (.literal (2 ^ mapInfo.valueWidth - 1))
    else valExpr
  if mapInfo.valueWidth == 256 then
    return pre ++ slotStmts ++ #[.setStorageArrayElement rawStorageFieldName slotExpr cleanVal]
  else
    let mask := 2 ^ mapInfo.valueWidth - 1
    let invMask := (2 ^ 256 - 1) - mask
    let oldWord ← fresh
    let newWord := Expr.bitOr (.bitAnd (.localVar oldWord) (.literal invMask)) cleanVal
    return pre ++ slotStmts ++ #[
      .letVar oldWord (.storageArrayElement rawStorageFieldName slotExpr),
      .setStorageArrayElement rawStorageFieldName slotExpr newWord
    ]

private def memberRead (pre : Array Stmt) (path : SPath) (member : String) (at_ : Json) : M Val := do
  if let .rawSlot structId baseSlot := path then
    let rawInfo ← resolveRawStructInfo structId at_
    let some mInfo := rawInfo.scalars.find? (·.member == member)
      | failAt at_ s!"member {member} is not a scalar member of {rawInfo.structName}"
    return ← readRawStructScalar pre baseSlot mInfo
  let (fieldName, qualMember, read) ← match path with
    | .zero rawField =>
        let (field, subPrefix) := splitSPathField rawField
        let qm := qualifySPathMember subPrefix member
        pure (field, qm, Expr.storage (topStructMemberFieldName field qm))
    | .one rawField key =>
        let (field, subPrefix) := splitSPathField rawField
        let qm := qualifySPathMember subPrefix member
        pure (field, qm, Expr.structMember field key qm)
    | .two rawField k1 k2 =>
        let (field, subPrefix) := splitSPathField rawField
        let qm := qualifySPathMember subPrefix member
        pure (field, qm, Expr.structMember2 field k1 k2 qm)
    | .outer _ _ | .rawSlot _ _ | .bytesSlot _ _ => failAt at_ "member access on an incomplete mapping"
  let info ← resolveField fieldName at_
  if info.opaqueNames.contains qualMember then
    failAt at_ s!"member {qualMember} is opaque in this slice"
  unless info.memberNames.contains qualMember do
    failAt at_ s!"member {qualMember} is not a layout member of {fieldName}"
  markField fieldName
  -- The packed member decodes zero-extended; solc loads narrow signed members sign-extended.
  let expr := if info.booleanMembers.contains qualMember then Expr.logicalNot (.logicalNot read)
    else match info.signedMembers.find? (·.1 == qualMember) with
      | some (_, bits) => Expr.signextend (.literal (bits / 8 - 1)) read
      | none => read
  pure { pre, expr }

/-- The slot solc assigns to a storage struct reached by a top-level or mapping-indexed path,
from the resolved storage layout: the value of `<pointer>.slot` in inline assembly. -/
private def storageStructPathSlot (path : SPath) (at_ : Json) : M (Array Stmt × Expr) := do
  let rawField ← match path with
    | .zero field | .one field _ | .two field _ _ => pure field
    | .outer _ _ | .rawSlot _ _ | .bytesSlot _ _ =>
        failAt at_ "inline assembly .slot of this storage struct pointer is outside this slice"
  let (field, subPrefix) := splitSPathField rawField
  unless subPrefix == "" do
    failAt at_ "inline assembly .slot of a nested storage struct member is outside this slice"
  let info ← resolveField field at_
  unless !info.scalarMapping && !info.bytesStorage && info.fixedArrayLength.isNone do
    failAt at_ "inline assembly .slot requires a storage struct path"
  markField field
  if let .zero _ := path then
    unless info.keyCount == 0 do
      failAt at_ "storage struct mapping key count differs"
    return (#[], .literal info.slot)
  computeSPathBaseSlot path info 0 at_

private def scalarMappingRead (pre : Array Stmt) (path : SPath) (at_ : Json) : M Val := do
  let (name, count, read) ← match path with
    | .one field key => pure (field, 1, Expr.structMember field key "__solidity_value")
    | .two field key1 key2 => pure (field, 2, Expr.structMember2 field key1 key2 "__solidity_value")
    | .bytesSlot _ _ => failAt at_ "bytes or string storage variable used as a scalar value"
    | .zero _ | .rawSlot _ _ => failAt at_ "storage or memory path used as a value"
    | .outer _ _ => failAt at_ "scalar mapping read requires both keys"
  let info ← resolveField name at_
  if info.bytesStorage then
    failAt at_ "bytes or string storage variable used as a scalar value"
  unless info.scalarMapping && info.keyCount == count do
    failAt at_ "storage or memory path used as a value"
  markField name
  -- Solidity cleans a storage bool by testing the loaded byte for nonzero.
  let expr := if info.booleanMapping then Expr.logicalNot (.logicalNot read) else read
  pure { pre, expr }

/-- Decimal/scientific literal value as an exact natural rational. -/
private def numericLiteralRatio (raw : String) : Option (Nat × Nat) := do
  let raw := raw.replace "_" ""
  if let some n := Compiler.Hex.parseHexNat? raw then return (n, 1)
  let (mantissa, exponent, negative) ← match (raw.replace "E" "e").splitOn "e" with
    | [m] => some (m, 0, false)
    | [m, e] => do
        let negative := e.startsWith "-"
        let digits := if negative || e.startsWith "+" then (e.drop 1).toString else e
        let exponent ← digits.toNat?
        some (m, exponent, negative)
    | _ => none
  let (numerator, denominator) ← match mantissa.splitOn "." with
    | [digits] => do
        let n ← digits.toNat?
        some (n, 1)
    | [whole, fraction] => do
        let w ← if whole.isEmpty then some 0 else whole.toNat?
        let f ← fraction.toNat?
        let scale := 10 ^ fraction.length
        some (w * scale + f, scale)
    | _ => none
  if negative then return (numerator, denominator * 10 ^ exponent)
  else return (numerator * 10 ^ exponent, denominator)

private def literalUnitScale : String → Option Nat
  | "seconds" | "wei" => some 1
  | "minutes" => some 60
  | "hours" => some 3600
  | "days" => some 86400
  | "weeks" => some 604800
  | "gwei" => some (10 ^ 9)
  | "ether" => some (10 ^ 18)
  | _ => none

private def lowerYulAddmod (a b m : Expr) : M Val := do
  let mBinding ← fresh
  let aModBinding ← fresh
  let bModBinding ← fresh
  let diffBinding ← fresh
  let resBinding ← fresh
  let stmts : Array Stmt := #[
    .letVar mBinding m,
    .letVar aModBinding (.mod a (.localVar mBinding)),
    .letVar bModBinding (.mod b (.localVar mBinding)),
    .letVar diffBinding (.sub (.localVar mBinding) (.localVar bModBinding)),
    .letVar resBinding (.literal 0),
    .ite (.lt (.localVar aModBinding) (.localVar diffBinding))
      [.assignVar resBinding (.add (.localVar aModBinding) (.localVar bModBinding))]
      [.assignVar resBinding (.sub (.localVar aModBinding) (.localVar diffBinding))]
  ]
  pure { pre := stmts, expr := .localVar resBinding }

private def lowerYulMulmod (a b m : Expr) : M Val := do
  let mBinding ← fresh
  let termBinding ← fresh
  let remBinding ← fresh
  let accBinding ← fresh
  let diffBinding ← fresh
  let idxBinding ← fresh
  let loopBody : List Stmt := [
    .assignVar diffBinding (.sub (.localVar mBinding) (.localVar termBinding)),
    .ite (.eq (.bitAnd (.localVar remBinding) (.literal 1)) (.literal 1))
      [.ite (.lt (.localVar accBinding) (.localVar diffBinding))
        [.assignVar accBinding (.add (.localVar accBinding) (.localVar termBinding))]
        [.assignVar accBinding (.sub (.localVar accBinding) (.localVar diffBinding))]]
      [],
    .ite (.lt (.localVar termBinding) (.localVar diffBinding))
      [.assignVar termBinding (.add (.localVar termBinding) (.localVar termBinding))]
      [.assignVar termBinding (.sub (.localVar termBinding) (.localVar diffBinding))],
    .assignVar remBinding (.shr (.literal 1) (.localVar remBinding))
  ]
  let stmts : Array Stmt := #[
    .letVar mBinding m,
    .letVar termBinding (.mod a (.localVar mBinding)),
    .letVar remBinding (.mod b (.localVar mBinding)),
    .letVar accBinding (.literal 0),
    .letVar diffBinding (.literal 0),
    .forEach idxBinding (.literal 256) loopBody
  ]
  pure { pre := stmts, expr := .localVar accBinding }

private def yulZeroTwoZeroLiteral? (j : Json) : M Bool := do
  if (← mKind j) != "YulLiteral" then return false
  if optStr j "kind" != some "number" || optStr j "type" != some "" then return false
  let raw ← mStr (← mField j "value")
  pure ((Compiler.Hex.parseHexNat? raw <|> raw.toNat?) == some 32)

private def yulMemoryArrayPtr? (j : Json) : M (Option (String × String)) := do
  if (← mKind j) != "YulIdentifier" then return none
  let name ← mStr (← mField j "name")
  let env ← get
  if env.yulNames.contains name then return none
  let some ptr := env.yulMemoryArrays.find? name | return none
  if env.scalarArrays.toList.any (fun (_, a) => a.memoryPointer == ptr && a.elemStructId.isSome) then
    failAt j "raw memory access to struct array pointers is outside this slice"
  return some (name, ptr)

private def yulMemoryArrayPayloadSlice? (ptrNode sizeNode : Json) : M (Option (Expr × Expr)) := do
  if (← mKind ptrNode) != "YulFunctionCall" || (← mKind sizeNode) != "YulFunctionCall" then
    return none
  let ptrFn ← mStr (← mField (← mField ptrNode "functionName") "name")
  let sizeFn ← mStr (← mField (← mField sizeNode "functionName") "name")
  unless ptrFn == "add" && sizeFn == "mul" do return none
  let ptrArgs ← mArr (← mField ptrNode "arguments")
  let sizeArgs ← mArr (← mField sizeNode "arguments")
  unless ptrArgs.size == 2 && sizeArgs.size == 2 do return none
  let arrFromPtr? ←
    if ← yulZeroTwoZeroLiteral? ptrArgs[1]! then
      yulMemoryArrayPtr? ptrArgs[0]!
    else if ← yulZeroTwoZeroLiteral? ptrArgs[0]! then
      yulMemoryArrayPtr? ptrArgs[1]!
    else
      pure none
  let some (arrName, arrayPtr) := arrFromPtr? | return none
  let mloadArg? (node : Json) : M (Option String) := do
    if (← mKind node) != "YulFunctionCall" then return none
    let fn ← mStr (← mField (← mField node "functionName") "name")
    unless fn == "mload" do return none
    let margs ← mArr (← mField node "arguments")
    unless margs.size == 1 do return none
    let some (mname, _) ← yulMemoryArrayPtr? margs[0]! | return none
    return some mname
  let arrFromSize? ←
    if ← yulZeroTwoZeroLiteral? sizeArgs[1]! then
      mloadArg? sizeArgs[0]!
    else if ← yulZeroTwoZeroLiteral? sizeArgs[0]! then
      mloadArg? sizeArgs[1]!
    else
      pure none
  unless arrFromSize? == some arrName do return none
  return some (.add (.localVar arrayPtr) (.literal 32), .mul (.mload (.localVar arrayPtr)) (.literal 32))

private def yulMemoryArrayElementLoad? (addrNode : Json) (lowerYulFn : Json → M Val) : M (Option Val) := do
  if (← mKind addrNode) != "YulFunctionCall" then return none
  let outerFn ← mStr (← mField (← mField addrNode "functionName") "name")
  unless outerFn == "add" do return none
  let outerArgs ← mArr (← mField addrNode "arguments")
  unless outerArgs.size == 2 do return none
  let matchBaseAdd? (node : Json) : M (Option String) := do
    if (← mKind node) != "YulFunctionCall" then return none
    let fn ← mStr (← mField (← mField node "functionName") "name")
    unless fn == "add" do return none
    let nargs ← mArr (← mField node "arguments")
    unless nargs.size == 2 do return none
    if ← yulZeroTwoZeroLiteral? nargs[1]! then
      return (← yulMemoryArrayPtr? nargs[0]!).map Prod.snd
    else if ← yulZeroTwoZeroLiteral? nargs[0]! then
      return (← yulMemoryArrayPtr? nargs[1]!).map Prod.snd
    else
      return none
  let matchIndexMul? (node : Json) : M (Option Json) := do
    if (← mKind node) != "YulFunctionCall" then return none
    let fn ← mStr (← mField (← mField node "functionName") "name")
    unless fn == "mul" do return none
    let nargs ← mArr (← mField node "arguments")
    unless nargs.size == 2 do return none
    if ← yulZeroTwoZeroLiteral? nargs[1]! then
      return some nargs[0]!
    else if ← yulZeroTwoZeroLiteral? nargs[0]! then
      return some nargs[1]!
    else
      return none
  let matched? ← do
    if let some arrayPtr ← matchBaseAdd? outerArgs[0]! then
      if let some posNode ← matchIndexMul? outerArgs[1]! then
        pure (some (arrayPtr, posNode))
      else
        pure none
    else if let some arrayPtr ← matchBaseAdd? outerArgs[1]! then
      if let some posNode ← matchIndexMul? outerArgs[0]! then
        pure (some (arrayPtr, posNode))
      else
        pure none
    else
      pure none
  let some (arrayPtr, posNode) := matched? | return none
  let posVal ← lowerYulFn posNode
  return some {
    pre := posVal.pre,
    expr := .mload (.add (.add (.localVar arrayPtr) (.literal 32)) (.mul posVal.expr (.literal 32)))
  }

private def readAbiMember (id : Nat) (pre : Array Stmt) (member : String) (at_ : Json) : M Val := do
  let some mem := (← get).mems.find? id | failAt at_ "unknown memory parameter"
  let some idx := mem.members.findIdx? (fun p => p.1 == member)
    | failAt at_ s!"{member} is not a member of {mem.structName}"
  if let some schema := mem.schema then
    let some (.scalar field) := schema[idx]? | failAt at_ "struct array used as a scalar"
    let plan := AbiRootLowering.root mem.abiStem 0 0 schema (!mem.calldataLocation)
    let (checks, expr) := AbiRootLowering.scalarRead plan (!mem.calldataLocation) idx field.kind
    return { pre := pre ++ checks.toArray, expr }
  if let some types := mem.staticTypes then
    let modelParam := s!"{mem.param}_{idx}"
    let some ty := types[idx]? | failAt at_ "missing static tuple member type"
    let limit := match ty with
      | .uintN bits => if bits < 256 then some (2^bits) else none
      | .address => some (2^160)
      | .bool => some 2
      | _ => none
    let mut pre := pre
    let rawWord := Expr.calldataload (.add (.localVar mem.headBinding) (.literal (32*idx)))
    if mem.calldataLocation then
      if let some bound := limit then
        pre := pre.push (.ite (.lt rawWord (.literal bound)) [] [.revertEmpty])
      if let .intN bits := ty then
        if 0 < bits && bits < 256 && bits % 8 == 0 then
          pre := pre.push (.ite
            (.eq rawWord (.signextend (.literal (bits / 8 - 1)) rawWord)) [] [.revertEmpty])
    let expr := if (← get).explicitAbi then Expr.localVar modelParam else Expr.param modelParam
    return { pre, expr }
  failAt at_ "struct member has no supported complete ABI schema"

private def yulMemoryStructHash? (ptrNode sizeNode : Json) (lowerYulFn : Json → M Val) : M (Option Val) := do
  if (← mKind ptrNode) != "YulIdentifier" then return none
  let name ← mStr (← mField ptrNode "name")
  let env ← get
  if env.yulNames.contains name then return none
  let some declId := env.yulMemoryStructs.find? name | return none
  let mut pre : Array Stmt := #[]
  let mut words : List Expr := []
  if let some flat := env.flatStructs.find? declId then
    if flat.members.any (fun (leaf, _, _) => leaf.contains '.') then
      failAt ptrNode "raw memory hash of a flattened nested struct is outside this slice"
    for (_, mTy, binding) in flat.members do
      unless !mTy.startsWith "enum " && mTy != "bytes4" && mTy != "bytes1" && (paramType mTy).isSome do
        failAt ptrNode s!"unsupported Yul struct keccak256 member type {mTy}"
      words := words ++ [.localVar binding]
  else if let some mem := env.mems.find? declId then
    unless !mem.calldataLocation do
      failAt ptrNode "Yul struct keccak256 requires a memory struct"
    let allScalarSchema := match mem.schema with
      | some schema => schema.all (fun | .scalar _ => true | _ => false)
      | none => false
    unless (mem.staticTypes.isSome || allScalarSchema) && !mem.members.isEmpty do
      failAt ptrNode "Yul struct keccak256 requires a static scalar-member memory struct"
    for (mName, mTy) in mem.members do
      unless !mTy.startsWith "enum " && mTy != "bytes4" && mTy != "bytes1" && (paramType mTy).isSome do
        failAt ptrNode s!"unsupported Yul struct keccak256 member type {mTy}"
      let v ← atom (← readAbiMember declId #[] mName ptrNode)
      pre := pre ++ v.pre
      words := words ++ [v.expr]
  else if let some bound := env.abiElements.find? declId then
    unless bound.inMemory do
      failAt ptrNode "Yul struct keccak256 requires a memory struct"
    let some mem := env.mems.find? bound.rootId | failAt ptrNode "unknown ABI root"
    let some schema := mem.schema | failAt ptrNode "missing ABI schema"
    let some (.structArray _ fields) := schema[bound.memberIndex]?
      | failAt ptrNode "expected a struct-array element"
    unless !fields.isEmpty do
      failAt ptrNode "Yul struct keccak256 requires a non-empty struct"
    let ptrAtom ← atom { pre := #[], expr := bound.pointer }
    pre := pre ++ ptrAtom.pre
    for idx in [:fields.length] do
      words := words ++ [.mload (.add ptrAtom.expr (.literal (32 * idx)))]
  else
    return none
  let sizeVal ← lowerYulFn sizeNode
  let .literal byteLen := sizeVal.expr
    | failAt sizeNode "Yul struct keccak256 byte length must be a compile-time constant"
  unless sizeVal.pre.isEmpty && byteLen == 32 * words.length do
    failAt sizeNode s!"Yul struct keccak256 byte length {byteLen} does not match struct size {32 * words.length}"
  let pointer ← fresh
  let finish ← fresh
  modify fun e => { e with encodingMemory := true }
  let alloc := (AbiEncoding.staticWords pointer finish words).toArray
  return some { pre := pre ++ alloc, expr := .keccak256 (.localVar pointer) (.literal byteLen) }

private def yulByteBufferByName? (node : Json) : M (Option EncodedBytes) := do
  if (← mKind node) != "YulIdentifier" then return none
  let name ← mStr (← mField node "name")
  let env ← get
  if env.yulNames.contains name then return none
  let some declId := env.yulMemoryStructs.find? name | return none
  return env.byteBuffers.find? declId <|> env.stringBuffers.find? declId

/-- A Yul identifier naming an unshadowed `bytes memory` local, with its declaration. -/
private def yulBytesLocal? (node : Json) : M (Option (Nat × EncodedBytes)) := do
  if (← mKind node) != "YulIdentifier" then return none
  let name ← mStr (← mField node "name")
  let env ← get
  if env.yulNames.contains name then return none
  let some declId := env.yulMemoryStructs.find? name | return none
  return (env.byteBuffers.find? declId).map (declId, ·)

private def yulPositiveWordOffsetLiteral? (node : Json) : M (Option Nat) := do
  if (← mKind node) != "YulLiteral" then return none
  unless optStr node "kind" == some "number" && optStr node "type" == some "" do
    return none
  let raw ← mStr (← mField node "value")
  let some value := Compiler.Hex.parseHexNat? raw <|> raw.toNat? | return none
  unless value ≥ 32 && value < 2^256 && value % 32 == 0 do return none
  return some value

private def yulByteBufferLoad? (mloadNode addrNode : Json)
    (lowerYulFn : Json → M Val) : M (Option Val) := do
  if let some buf ← yulByteBufferByName? addrNode then
    return some { pre := buf.pre, expr := buf.size }
  if (← mKind addrNode) != "YulFunctionCall" then return none
  let outerFn ← mStr (← mField (← mField addrNode "functionName") "name")
  unless outerFn == "add" do return none
  let outerArgs ← mArr (← mField addrNode "arguments")
  unless outerArgs.size == 2 do return none
  let yulSubOffset? (node : Json) : M (Option (Json × Nat)) := do
    if (← mKind node) != "YulFunctionCall" then return none
    let fn ← mStr (← mField (← mField node "functionName") "name")
    unless fn == "sub" do return none
    let sargs ← mArr (← mField node "arguments")
    unless sargs.size == 2 do return none
    if (← mKind sargs[1]!) != "YulLiteral" then return none
    unless optStr sargs[1]! "kind" == some "number" && optStr sargs[1]! "type" == some "" do
      return none
    let raw ← mStr (← mField sargs[1]! "value")
    let some k := Compiler.Hex.parseHexNat? raw <|> raw.toNat? | return none
    unless 1 ≤ k && k ≤ 32 do return none
    return some (sargs[0]!, k)
  let tailMatched? ← do
    if let some (lhsNode, k) ← yulSubOffset? outerArgs[1]! then
      if let some buf ← yulByteBufferByName? outerArgs[0]! then
        pure (some (buf, lhsNode, k))
      else
        pure none
    else if let some (lhsNode, k) ← yulSubOffset? outerArgs[0]! then
      if let some buf ← yulByteBufferByName? outerArgs[1]! then
        pure (some (buf, lhsNode, k))
      else
        pure none
    else
      pure none
  if let some (buf, lhsNode, k) := tailMatched? then
    modify fun e => { e with yulByteWordLoadSites :=
      e.yulByteWordLoadSites.push (buf.pointer, mloadNode, e.currentFile, e.stack) }
    let lhsVal ← lowerYulFn lhsNode
    let addrVar ← fresh
    let remVar ← fresh
    let alignedVar ← fresh
    let shiftVar ← fresh
    let pre := buf.pre ++ lhsVal.pre ++ #[
      .letVar addrVar (.add buf.pointer (.sub lhsVal.expr (.literal (32 + k)))),
      .letVar remVar (.bitAnd (.localVar addrVar) (.literal 31)),
      .letVar alignedVar (.bitAnd (.localVar addrVar) (.bitNot (.literal 31))),
      .letVar shiftVar (.mul (.localVar remVar) (.literal 8))
    ]
    let wordExpr := Expr.bitOr
      (.shl (.localVar shiftVar) (.mload (.localVar alignedVar)))
      (.shr (.sub (.literal 256) (.localVar shiftVar)) (.mload (.add (.localVar alignedVar) (.literal 32))))
    return some { pre, expr := wordExpr }
  let matched? ← do
    if let some off ← yulPositiveWordOffsetLiteral? outerArgs[1]! then
      if let some buf ← yulByteBufferByName? outerArgs[0]! then
        modify fun e => { e with yulByteWordLoadSites :=
          e.yulByteWordLoadSites.push (buf.pointer, mloadNode, e.currentFile, e.stack) }
        pure (some (buf, off))
      else
        pure none
    else if let some off ← yulPositiveWordOffsetLiteral? outerArgs[0]! then
      if let some buf ← yulByteBufferByName? outerArgs[1]! then
        modify fun e => { e with yulByteWordLoadSites :=
          e.yulByteWordLoadSites.push (buf.pointer, mloadNode, e.currentFile, e.stack) }
        pure (some (buf, off))
      else
        pure none
    else
      pure none
  let some (buf, off) := matched? | return none
  return some {
    pre := buf.pre,
    expr := .mload (.add buf.pointer (.literal (off - 32)))
  }

/-- End of the memory solc reserves: scratch space `0x00`–`0x3f`, the free-memory pointer at
`0x40` and the zero slot at `0x60`. Inline assembly may use fixed addresses below it. -/
private def yulReservedMemoryEnd : Nat := 0x80

/-- The zero slot at `0x60`, which Solidity relies on being zero. -/
private def yulZeroSlot : Nat := 0x60

/-- An operand whose value no hoisted external call can change: a literal, a plain local, or a
constant of the transaction. Memory, storage, returndata and balance reads are not, and neither
is any compound expression (fail closed). -/
private def yulCallIndependent : Expr → Bool
  | .localVar _ => true
  | .selfBalance => false
  | e => isOrderIndependentSibling e

/-- A hoisted statement that touches the outside world: anything but local bindings, looking
through the branches and bounded loops a builtin's own lowering hoists (`mulmod`, `addmod`). -/
private partial def yulStmtHasEffect : Stmt → Bool
  | .letVar _ _ | .assignVar _ _ => false
  | .ite _ yes no => yes.any yulStmtHasEffect || no.any yulStmtHasEffect
  | .forEach _ _ body => body.any yulStmtHasEffect
  | .forEachWhile _ _ _ body => body.any yulStmtHasEffect
  | _ => true

/-- Hoisted statements that touch the outside world (`yulStmtHasEffect`). -/
private def yulPreHasEffect (pre : Array Stmt) : Bool :=
  pre.any yulStmtHasEffect

/-- Yul evaluates the operands of one builtin right to left, but the model runs every operand's
hoisted statements left to right before the enclosing expression. That is only the same order
when no hoisted effect (an external call) can interact with a sibling: operands to the right of
an effect must be call-independent without hoisting of their own, and operands to the left of an
effect must not hoist anything, because their statements would run before it instead of after. -/
private def checkYulOperandOrder (at_ : Json) (vals : Array Val) : M Unit := do
  let mut earlier : Array Val := #[]
  for right in vals do
    for left in earlier do
      if yulPreHasEffect right.pre && !left.pre.isEmpty then
        failAt at_ "Yul operands left of an external call must not need hoisting; assign the call to a variable first"
      if yulPreHasEffect left.pre && (!right.pre.isEmpty || !yulCallIndependent right.expr) then
        failAt at_ "Yul external call is evaluated after an operand that could observe it; assign the call to a variable first"
    earlier := earlier.push right

/-- `add(buf, 0x20)` (either operand order) of a `bytes memory` local: the address of its
payload, as the importer's own binding. -/
private def yulBytePayloadAddress? (node : Json) : M (Option Val) := do
  unless (← mKind node) == "YulFunctionCall" do return none
  unless (← mStr (← mField (← mField node "functionName") "name")) == "add" do return none
  let args ← mArr (← mField node "arguments")
  unless args.size == 2 do return none
  for (bufNode, offNode) in [(args[0]!, args[1]!), (args[1]!, args[0]!)] do
    if let some buf ← yulByteBufferByName? bufNode then
      if (← yulPositiveWordOffsetLiteral? offNode) == some 32 then
        return some { pre := buf.pre, expr := buf.pointer }
  return none

/-- `add(buf, 0x20)` with size `mload(buf)` over the same `bytes memory` local: exactly its
payload. -/
private def yulBytePayloadRange? (offNode sizeNode : Json) : M Bool := do
  if (← yulBytePayloadAddress? offNode).isNone then return false
  unless (← mKind sizeNode) == "YulFunctionCall" do return false
  unless (← mStr (← mField (← mField sizeNode "functionName") "name")) == "mload" do return false
  let .arr #[len] := (field? sizeNode "arguments").getD .null | return false
  let ident (n : Json) : Option String :=
    if optStr n "nodeType" == some "YulIdentifier" then optStr n "name" else none
  let some lenName := ident len | return false
  let .arr #[a, b] := (field? offNode "arguments").getD .null | return false
  return ident a == some lenName || ident b == some lenName

/-- A nonempty memory range of an inline-assembly call must be the payload of a
`bytes memory` local or literal bytes below `limit` that the block wrote unconditionally
(`yulWrittenBytes`). Other memory holds what solc's code generator left there (mapping
hashes, the free-memory pointer, the heap), which the model does not reproduce; an output
range reaching `0x40` would also overwrite the free-memory pointer or the zero slot behind
the block's restore checks. -/
private def checkYulCallRange (offNode sizeNode : Json) (off size : Expr) (limit : Nat)
    (message : String) : M Unit := do
  if let .literal 0 := size then return
  if ← yulBytePayloadRange? offNode sizeNode then return
  if let (.literal lo, .literal n) := (off, size) then
    let written := (← get).yulWrittenBytes
    if lo + n ≤ limit && (List.range n).all fun k => written.testBit (lo + k) then return
  failAt offNode message

/-- The aligned scratch words, `0x00` and `0x20`. -/
private def yulScratchWords : List Nat := [0, 32]

/-- Bytes `[lo, hi)` of a word as a mask; byte 0 is the most significant. -/
private def yulByteMask (lo hi : Nat) : Nat :=
  (2 ^ (8 * (hi - lo)) - 1) * 2 ^ (8 * (32 - hi))

/-- Scratch word `w` after `mcopy(dst, src, size)` inside the scratch words, given each word's
value before the copy (`word`), or `none` when the copy leaves it alone. Byte `i` of `w` in the
destination range takes byte `w + i + src - dst` of the old scratch words: each old word
shifted by its distance to that source byte, the rest of `w` kept. Reading only the old values
gives memmove semantics when the ranges overlap, in either direction. -/
private def yulScratchWordAfterMcopy (word : Nat → Expr) (dst src size w : Nat) : Option Expr :=
  let lo := max dst w
  let hi := min (dst + size) (w + 32)
  if hi ≤ lo then none else
  let mask := yulByteMask (lo - w) (hi - w)
  let moved := yulScratchWords.filterMap fun s =>
    if dst + s ≤ w + src then
      let d := w + src - (dst + s)
      if d < 32 then some (Expr.shl (.literal (8 * d)) (word s)) else none
    else
      let d := dst + s - (w + src)
      if d < 32 then some (Expr.shr (.literal (8 * d)) (word s)) else none
  let copied := match moved with
    | [] => Expr.literal 0
    | e :: es => es.foldl Expr.bitOr e
  some (.bitOr (.bitAnd (word w) (.literal (2 ^ 256 - 1 - mask))) (.bitAnd copied (.literal mask)))

/-- The `yulNames` key of a `<p>.offset` reference at Yul source position `src`
(`bindYulExternalConstants`). No Yul identifier contains `@`, so an ordinary identifier
lookup never sees it. -/
private def yulCalldataOffsetKey (src : String) : String :=
  s!"calldata-offset@{src}"

/-- `p.offset`, `add(p.offset, k)` or `add(k, p.offset)` for a root `bytes calldata` parameter
`p` and a literal `k < 2^64`: the absolute calldata offset that `calldataload` reads. The payload
starts at `4 + head offset + 32` with a head offset below `2^64`, so the sum neither wraps nor
reaches the selector bytes `0..3` (where the model's calldata words are not byte exact), and
`calldataload` zero-pads past the end of calldata on both sides. -/
private def yulCalldataBytesOffsetRead? (node : Json) : M (Option Expr) := do
  let offsetOf (n : Json) : M (Option Expr) := do
    unless optStr n "nodeType" == some "YulIdentifier" do return none
    let src ← mStr (← mField n "src")
    return (← get).yulNames.find? (yulCalldataOffsetKey src)
  if let some base ← offsetOf node then return some base
  unless (← mKind node) == "YulFunctionCall" do return none
  unless (← mStr (← mField (← mField node "functionName") "name")) == "add" do return none
  let args ← mArr (← mField node "arguments")
  unless args.size == 2 do return none
  for (baseNode, kNode) in [(args[0]!, args[1]!), (args[1]!, args[0]!)] do
    if let some base ← offsetOf baseNode then
      unless optStr kNode "nodeType" == some "YulLiteral" && optStr kNode "kind" == some "number" &&
          optStr kNode "type" == some "" do return none
      let raw ← mStr (← mField kNode "value")
      let some k := Compiler.Hex.parseHexNat? raw <|> raw.toNat? | return none
      unless k < 2^64 do return none
      return some (.add base (.literal k))
  return none

/-- Reject the Yul `returndatasize()` read `j` (an expression, or a bubbled-revert
`returndatacopy` statement) when the current root makes an inlined linked
library call (its DELEGATECALL would set the return-data buffer, the model's call does not),
and record it otherwise, so a later linked call rejects. Loops make source order unreliable,
so either order fails closed. -/
private def noteReturndataRead (j : Json) : M Unit := do
  let env ← get
  unless env.rootLinkedLibraryCalls.isEmpty do
    failAt j ("Yul returndatasize in a function that makes a linked library call: the " ++
      "DELEGATECALL sets the return data, the inlined model does not")
  if env.rootReturndataRead.isNone then
    set { env with rootReturndataRead := some j }

private partial def lowerYul (j : Json) : M Val := do
  match ← mKind j with
  | "YulLiteral" =>
      -- solc's inline assembly gives `true` the word 1 and `false` the word 0, whatever
      -- the contract declares (#2830).
      if optStr j "kind" == some "bool" then
        unless optStr j "type" == some "" do
          failAt j "typed Yul literals are unsupported"
        let raw ← mStr (← mField j "value")
        unless raw == "true" || raw == "false" do
          failAt j "invalid boolean Yul literal"
        return { pre := #[], expr := .literal (if raw == "true" then 1 else 0) }
      unless optStr j "kind" == some "number" do
        failAt j "only numeric Yul literals are supported"
      unless optStr j "type" == some "" do
        failAt j "typed Yul literals are unsupported"
      let raw ← mStr (← mField j "value")
      let value ← match Compiler.Hex.parseHexNat? raw <|> raw.toNat? with
        | some value => pure value
        | none => failAt j "invalid numeric Yul literal"
      unless value < 2^256 do failAt j "numeric Yul literal exceeds one EVM word"
      pure { pre := #[], expr := .literal value }
  | "YulIdentifier" =>
      let name ← mStr (← mField j "name")
      let env ← get
      if env.yulCursorOnlyNames.contains name then
        failAt j s!"Yul byte-buffer cursor {name} may only be used in mcopy"
      -- A narrow named result holds the raw stack word, as solc's does: Yul reads see it and
      -- Solidity consumers clean it (#2912).
      match env.yulNames.find? name with
      | some expr =>
          if let .localVar binding := expr then
            modify fun e => { e with yulBindingReadSites := e.yulBindingReadSites.push (binding, j) }
          pure { pre := #[], expr }
      | none => failAt j s!"unbound Yul identifier {name}"
  | "YulFunctionCall" =>
      let fname ← mStr (← mField (← mField j "functionName") "name")
      let args ← mArr (← mField j "arguments")
      if fname == "mload" then
        if args.size == 1 then
          if let some v ← yulMemoryArrayElementLoad? args[0]! lowerYul then
            return v
          if let some v ← yulByteBufferLoad? j args[0]! lowerYul then
            return v
          -- A scratch word this block wrote, or the zero slot. Anything else below 0x80 holds
          -- what solc's code generator left there (mapping hashes, the free-memory pointer),
          -- which the model does not reproduce. `let p := mload(0x40)` is lowered by
          -- `lowerYulStmtSlice` (`yulFreePointerSave?`).
          let addr ← if (← mKind args[0]!) == "YulLiteral" then lowerYul args[0]!
            else failAt j "unsupported Yul builtin mload"
          if let .literal off := addr.expr then
            if addr.pre.isEmpty && off + 32 ≤ yulReservedMemoryEnd then
              let env ← get
              unless (off == 0 && env.yulScratch0) || (off == 32 && env.yulScratch32) ||
                  off == yulZeroSlot do
                failAt j "Yul mload below 0x80 must read a scratch word this block wrote or the zero slot"
              return { pre := #[], expr := .mload (.literal off) }
        failAt j "unsupported Yul builtin mload"
      if fname == "call" || fname == "staticcall" then
        let isStatic := fname == "staticcall"
        let arity := if isStatic then 6 else 7
        unless args.size == arity do failAt j s!"Yul {fname} expects {arity} arguments"
        let gasArg := args[0]!
        let forwardsGas ← do
          if (← mKind gasArg) != "YulFunctionCall" then pure false
          else pure ((← mStr (← mField (← mField gasArg "functionName") "name")) == "gas" &&
            (← mArr (← mField gasArg "arguments")).isEmpty)
        unless forwardsGas do
          failAt gasArg s!"Yul {fname} must forward gas(); the call boundary supplies the allowance"
        if !isStatic then
          let value ← lowerYul args[2]!
          unless value.pre.isEmpty && (match value.expr with | .literal 0 => true | _ => false) do
            failAt args[2]! "Yul call with a nonzero value is outside this slice"
        -- Yul evaluates arguments right to left; effect-free operands make the order moot.
        let operands := if isStatic then args.extract 1 6 else #[args[1]!] ++ args.extract 3 7
        let mut xs : Array Expr := #[]
        for operand in operands do
          -- `add(buf, 0x20)` of a `bytes memory` local is the address of its payload; it is
          -- admitted only here, where the call consumes the address (the model's
          -- allocations differ from solc's, so the address itself is not a value).
          let v ← match ← yulBytePayloadAddress? operand with
            | some v => pure v
            | none => lowerYul operand
          unless v.pre.isEmpty do failAt operand s!"Yul {fname} operands must be effect-free"
          xs := xs.push v.expr
        -- operands: target, input offset and size, output offset and size.
        let x (i : Nat) : Expr := xs.getD i (.literal 0)
        checkYulCallRange operands[1]! operands[2]! (x 1) (x 2) yulReservedMemoryEnd
          s!"Yul {fname} input must be a bytes memory payload or bytes this block wrote below 0x80"
        checkYulCallRange operands[3]! operands[4]! (x 3) (x 4) 0x40
          s!"Yul {fname} output must be a bytes memory payload or scratch bytes this block wrote below 0x40"
        let result ← fresh
        -- CALL and STATICCALL produce a success bit, not the first returndata word.
        -- Expose that bound to the ordinary narrow-assignment checker.
        return { pre := #[.ecm (Compiler.ECM.YulMemoryCall.module isStatic result) xs.toList],
                 expr := .bitAnd (.localVar result) (.literal 1) }
      if fname == "calldataload" then
        unless args.size == 1 do failAt j "Yul calldataload expects one argument"
        let some offset ← yulCalldataBytesOffsetRead? args[0]!
          | failAt args[0]! "Yul calldataload must read at p.offset or add(p.offset, k) of a root bytes calldata parameter p, with a literal k below 2^64"
        return { pre := #[], expr := .calldataload offset }
      if fname == "extcodesize" then
        unless args.size == 1 do failAt j "Yul extcodesize expects one argument"
        let target ← lowerYul args[0]!
        unless target.pre.isEmpty do failAt args[0]! "Yul extcodesize operand must be effect-free"
        -- The executing contract's code differs between the source and compiled routes.
        let target ← lowerCodeReadTarget target j
          "code length of an account that may be the executing contract is unsupported"
        let result ← fresh
        return { pre := target.pre.push (.ecm (Compiler.ECM.SolidityExtCodeSize.module result) [target.expr]),
                 expr := .localVar result }
      if fname == "returndatasize" then
        unless args.isEmpty do failAt j "Yul returndatasize takes no argument"
        noteReturndataRead j
        return { pre := #[], expr := .returndataSize }
      if fname == "create2" then
        failAt j "Yul create2 must be the whole value of a Yul assignment or variable declaration"
      let expectedArity? : Option Nat := match fname with
        | "caller" | "address" | "timestamp" | "number" | "chainid"
        | "selfbalance" | "origin" => some 0
        | "iszero" | "not" | "tload" | "sload" | "clz" => some 1
        | "add" | "sub" | "mul" | "div" | "sdiv" | "mod" | "smod" | "exp"
        | "and" | "or" | "xor" | "byte" | "shl" | "shr" | "sar" | "signextend"
        | "lt" | "gt" | "slt" | "sgt" | "eq" | "keccak256" => some 2
        | "addmod" | "mulmod" => some 3
        | _ => none
      let some expectedArity := expectedArity?
        | failAt j s!"unsupported Yul builtin {fname}"
      unless args.size == expectedArity do
        failAt j s!"unsupported Yul builtin {fname}"
      if fname == "keccak256" && args.size == 2 then
        if let some (sliceOff, sliceSize) ← yulMemoryArrayPayloadSlice? args[0]! args[1]! then
          return { pre := #[], expr := .keccak256 sliceOff sliceSize }
        if let some structHash ← yulMemoryStructHash? args[0]! args[1]! lowerYul then
          return structHash
      let mut pre : Array Stmt := #[]
      let mut xs : Array Expr := #[]
      let mut vals : Array Val := #[]
      for arg in args do
        let v ← lowerYul arg
        pre := pre ++ v.pre
        xs := xs.push v.expr
        vals := vals.push v
      checkYulOperandOrder j vals
      match fname, xs with
      | "add", #[a, b] => pure { pre, expr := .add a b }
      | "sub", #[a, b] => pure { pre, expr := .sub a b }
      | "mul", #[a, b] => pure { pre, expr := .mul a b }
      | "div", #[a, b] => pure { pre, expr := .div a b }
      | "sdiv", #[a, b] => pure { pre, expr := .sdiv a b }
      | "mod", #[a, b] => pure { pre, expr := .mod a b }
      | "smod", #[a, b] => pure { pre, expr := .smod a b }
      | "exp", #[a, b] => pure { pre, expr := .externalCall builtinExpName [a, b] }
      | "and", #[a, b] => pure { pre, expr := .bitAnd a b }
      | "or", #[a, b] => pure { pre, expr := .bitOr a b }
      | "xor", #[a, b] => pure { pre, expr := .bitXor a b }
      | "byte", #[a, b] => pure { pre, expr := .byte a b }
      | "shl", #[a, b] => pure { pre, expr := .shl a b }
      | "shr", #[a, b] => pure { pre, expr := .shr a b }
      | "sar", #[a, b] => pure { pre, expr := .sar a b }
      | "signextend", #[a, b] => pure { pre, expr := .signextend a b }
      | "lt", #[a, b] => pure { pre, expr := .lt a b }
      | "gt", #[a, b] => pure { pre, expr := .gt a b }
      | "slt", #[a, b] => pure { pre, expr := .slt a b }
      | "sgt", #[a, b] => pure { pre, expr := .sgt a b }
      | "eq", #[a, b] => pure { pre, expr := .eq a b }
      | "iszero", #[a] => pure { pre, expr := .logicalNot a }
      | "not", #[a] => pure { pre, expr := .bitNot a }
      | "tload", #[a] => pure { pre, expr := .tload a }
      | "sload", #[a] => do
          modify fun e => { e with usedRawStorage := true }
          pure { pre, expr := .storageArrayElement rawStorageFieldName a }
      | "caller", #[] => pure { pre, expr := .caller }
      | "address", #[] => pure { pre, expr := .contractAddress }
      | "timestamp", #[] => pure { pre, expr := .blockTimestamp }
      | "number", #[] => pure { pre, expr := .blockNumber }
      | "chainid", #[] => pure { pre, expr := .chainid }
      | "selfbalance", #[] => pure { pre, expr := .selfBalance }
      | "origin", #[] => pure { pre, expr := .txOrigin }
      -- Unreachable while the arity table above omits them: Yul basefee() / gasprice() stay
      -- rejected until a differential route pins a base fee and a gas price (#2831).
      | "basefee", #[] => pure { pre, expr := .baseFee }
      | "gasprice", #[] => pure { pre, expr := .gasPrice }
      | "keccak256", #[a, b] => do
          let (.literal off, .literal size) := (a, b)
            | failAt j "only scratch-space keccak256 over 0x00..0x3f is supported"
          let env ← get
          let validScratch :=
            (off == 0 && size == 32 && env.yulScratch0) ||
            (off == 32 && size == 32 && env.yulScratch32) ||
            (off == 0 && size == 64 && env.yulScratch0 && env.yulScratch32)
          unless validScratch do
            failAt j "keccak256 requires scratch-space words 0x00..0x3f to be written in the same Yul block"
          pure { pre, expr := .keccak256 (.literal off) (.literal size) }
      | "addmod", #[a, b, m] => do
          let v ← lowerYulAddmod a b m
          pure { pre := pre ++ v.pre, expr := v.expr }
      | "mulmod", #[a, b, m] => do
          let v ← lowerYulMulmod a b m
          pure { pre := pre ++ v.pre, expr := v.expr }
      | "clz", #[a] =>
          let inputBinding ← fresh
          let remBinding ← fresh
          let countBinding ← fresh
          let mut searchStmts : List Stmt := []
          for shift in [128, 64, 32, 16, 8, 4, 2, 1] do
            let shifted := Expr.shr (.literal shift) (.localVar remBinding)
            searchStmts := searchStmts ++ [.ite (.eq shifted (.literal 0))
              [.assignVar countBinding (.add (.localVar countBinding) (.literal shift))]
              [.assignVar remBinding shifted]]
          let stmts : Array Stmt := #[
            .letVar inputBinding a,
            .letVar remBinding (.localVar inputBinding),
            .letVar countBinding (.literal 0),
            .ite (.eq (.localVar inputBinding) (.literal 0))
              [.assignVar countBinding (.literal 256)]
              searchStmts
          ]
          pure { pre := pre ++ stmts, expr := .localVar countBinding }
      | _, _ => failAt j s!"unsupported Yul builtin {fname}"
  | kind => failAt j s!"unsupported Yul node {kind}"

private def checkYulReturnTarget (j asg varNode : Json) (vname retName : String) : M Unit := do
  let targetSrc ← mStr (← mField varNode "src")
  let refs ← mArr (← mField j "externalReferences")
  let mut targetId? : Option Nat := none
  for ref in refs do
    if (← mStr (← mField ref "src")) == targetSrc then
      unless !(← mBool (← mField ref "isOffset")) && !(← mBool (← mField ref "isSlot")) &&
           (field? ref "suffix").isNone && (← mNat (← mField ref "valueSize")) == 1 do
        failAt asg s!"Yul assigns {vname}, not the return declaration {retName}"
      targetId? := some (← mNat (← mField ref "declaration"))
  let some targetId := targetId?
    | failAt asg s!"Yul assigns {vname}, not the return declaration {retName}"
  unless (← get).helperReturnId == some targetId do
    failAt asg s!"Yul assigns {vname}, not the return declaration {retName}"

/-- Bytes of a hex string literal, or of a constant initialised with one. -/
private def hexLiteralBytes? (node : Json) : M (Option (List Nat)) := do
  let literal? ← match ← mKind node with
    | "Literal" => pure (some node)
    | "Identifier" | "MemberAccess" =>
        let id ← refInt node
        if id < 0 then pure none else
        match (← get).stateVars.find? id.toNat with
        | some decl =>
            if (field? decl "constant").bind (·.getBool?.toOption) == some true then
              pure (field? decl "value")
            else pure none
        | none => pure none
    | _ => pure none
  let some literal := literal? | return none
  unless optStr literal "nodeType" == some "Literal" && optStr literal "kind" == some "hexString" do
    return none
  let some hex := optStr literal "hexValue" | return none
  let digits := hex.toList.filterMap Compiler.Hex.hexCharToNat?
  unless digits.length == hex.length && hex.length % 2 == 0 do return none
  return some ((List.range (hex.length / 2)).map fun i => digits[2 * i]! * 16 + digits[2 * i + 1]!)

/-- `abi.encodePacked(p, ...)` / `bytes.concat(p, ...)` whose leading literal `p`
is a checked CREATE2 initcode template (inspected bytes, not names). -/
private def startsWithInitcodeTemplate (init : Json) : M Bool := do
  unless optStr init "nodeType" == some "FunctionCall" &&
      optStr init "kind" == some "functionCall" do
    return false
  let some callee := field? init "expression" | return false
  unless optStr callee "nodeType" == some "MemberAccess" do return false
  let member := optStr callee "memberName"
  unless member == some "encodePacked" || member == some "concat" do return false
  let some (.arr args) := field? init "arguments" | return false
  let some first := args[0]? | return false
  let some bytes ← hexLiteralBytes? first | return false
  let code := bytes.map fun b => (⟨b % 256, Nat.mod_lt _ (by decide)⟩ : Fin 256)
  return (DenoteCreate2.templateCost code).isSome

/-- The numeric value of an untyped Yul number literal. -/
private def yulNumber? (node : Json) : M (Option Nat) := do
  if (← mKind node) != "YulLiteral" then return none
  unless optStr node "kind" == some "number" && optStr node "type" == some "" do return none
  let raw ← mStr (← mField node "value")
  return Compiler.Hex.parseHexNat? raw <|> raw.toNat?

/-- `add(buffer, 0x20)` (either operand order) over an unshadowed `bytes memory` local. -/
private def yulBytesDataOffset? (node : Json) : M (Option (Nat × EncodedBytes)) := do
  unless (← mKind node) == "YulFunctionCall" do return none
  unless (← mStr (← mField (← mField node "functionName") "name")) == "add" do return none
  let args ← mArr (← mField node "arguments")
  unless args.size == 2 do return none
  if (← yulNumber? args[1]!) == some 32 then return ← yulBytesLocal? args[0]!
  if (← yulNumber? args[0]!) == some 32 then return ← yulBytesLocal? args[1]!
  return none

/-- `(add(b, 0x20), mload(b))` (either `add` operand order): the data and length of the
unshadowed `bytes memory` local `b`, as the operands of a forwarding `revert`. -/
private def yulForwardedBytes? (args : Array Json) : M (Option EncodedBytes) := do
  let #[offset, size] := args | return none
  let some (declId, buffer) ← yulBytesDataOffset? offset | return none
  unless (← mKind size) == "YulFunctionCall" do return none
  unless (← mStr (← mField (← mField size "functionName") "name")) == "mload" do return none
  let #[only] ← mArr (← mField size "arguments") | return none
  let some (lengthId, _) ← yulBytesLocal? only | return none
  return if lengthId == declId then some buffer else none

/-- `mload(buffer)`: the length word of the `bytes memory` local `declId`. -/
private def yulBytesLength? (node : Json) (declId : Nat) : M Bool := do
  unless (← mKind node) == "YulFunctionCall" do return false
  unless (← mStr (← mField (← mField node "functionName") "name")) == "mload" do return false
  let args ← mArr (← mField node "arguments")
  unless args.size == 1 do return false
  return ((← yulBytesLocal? args[0]!).map (·.1)) == some declId

/-- `create2(0, add(buffer, 0x20), mload(buffer), salt)` over a `bytes memory` local
whose initializer starts with a checked initcode template. The closed transport
reads the initcode from physical memory at the buffer's data pointer; any other
value, offset, size or buffer shape is rejected at its own node. -/
private def lowerYulCreate2? (node : Json) (lowerYulFn : Json → M Val) : M (Option Val) := do
  unless (← mKind node) == "YulFunctionCall" do return none
  unless (← mStr (← mField (← mField node "functionName") "name")) == "create2" do return none
  let args ← mArr (← mField node "arguments")
  unless args.size == 4 do failAt node "create2 expects value, offset, size and salt"
  unless (← yulNumber? args[0]!) == some 0 do
    failAt args[0]! "create2 with a nonzero or computed value is unsupported"
  let some (declId, buffer) ← yulBytesDataOffset? args[1]!
    | failAt args[1]! "create2 initcode offset must be add(buffer, 0x20) of a bytes memory local"
  unless ← yulBytesLength? args[2]! declId do
    failAt args[2]! "create2 initcode size must be mload of the same bytes memory local"
  unless (← get).initcodeTemplates.contains declId do
    failAt args[1]! "create2 initcode must start with a checked deployment-prefix literal"
  let some rootPtr := (← get).initcodeTemplatePtrs.find? declId
    | failAt args[1]! "create2 initcode must start with a checked deployment-prefix literal"
  let envNow ← get
  let c2Site : Create2TemplateSite :=
    { rootPtrVar := rootPtr, node := args[1]!, file := envNow.currentFile, stack := envNow.stack }
  modify fun e => { e with create2Sites := e.create2Sites.push c2Site }
  -- Yul evaluates builtin arguments right to left; only the salt can be non-atomic.
  let salt ← atom (← lowerYulFn args[3]!)
  let size ← atom { pre := #[], expr := buffer.size }
  let pointer ← atom { pre := buffer.pre, expr := buffer.pointer }
  let result ← fresh
  let create := Stmt.ecm (Compiler.ECM.SolidityCreate2.module result)
    [.literal 0, pointer.expr, size.expr, salt.expr]
  -- The result is an address or zero; the mask states that bound to narrow targets.
  return some { pre := salt.pre ++ size.pre ++ pointer.pre |>.push create,
                expr := .bitAnd (.localVar result) (.literal (2 ^ 160 - 1)) }

/-- A Yul assignment or declaration value; `create2` is admitted only here. -/
private def lowerYulValue (node : Json) : M Val := do
  if let some value ← lowerYulCreate2? node lowerYul then return value
  lowerYul node

private def lowerAssembly (j : Json) (retName : String) : M Val := do
  let assignedInAsm := bodyAssignedIds j
  if !assignedInAsm.isEmpty then
    modify fun e => { e with zeroInitLocals := e.zeroInitLocals.filter (!assignedInAsm.contains ·) }
  let ast ← mField j "AST"
  unless (← mKind ast) == "YulBlock" do failAt j "assembly is not a Yul block"
  let stmts ← mArr (← mField ast "statements")
  unless stmts.size == 1 do failAt j "only a single Yul assignment is supported"
  let asg := stmts[0]!
  unless (← mKind asg) == "YulAssignment" do failAt asg "only a Yul assignment is supported"
  let vars ← mArr (← mField asg "variableNames")
  unless vars.size == 1 do failAt asg "Yul assignment must have one target"
  let vname ← mStr (← mField vars[0]! "name")
  unless retName != "" && vname == retName do
    failAt asg s!"Yul assigns {vname}, not the return name {retName}"
  checkYulReturnTarget j asg vars[0]! vname retName
  lowerYulValue (← mField asg "value")

/-- solc evaluates an assignment's right-hand side before the target's mapping keys and
indexes (`=` and `op=`, legacy and via-IR). Bind the lowered value to a fresh local so it can be
emitted before the target's key prelude, which then cannot change what is stored (a key helper's
storage write, or `i++` in the key when the right-hand side is the bare local `i`). -/
private def captureAssignedValue (value : Val) : M Val := do
  let captured ← fresh
  pure { pre := value.pre.push (.letVar captured value.expr), expr := .localVar captured }

private def cleanHelperResultExpr (ty : String) (v : Val) : Expr :=
  if ty == "bool" then
    match v.expr with
    | .literal n => .literal (if n == 0 then 0 else 1)
    | _ => Expr.logicalNot (.logicalNot v.expr)
  else
    match fixedBytesWidth? ty with
    | some byteW =>
        if byteW < 32 then
          let mask := (2 ^ (8 * byteW) - 1) * 2 ^ (256 - 8 * byteW)
          match v.expr with
          | .literal n => .literal (n &&& mask)
          | _ => Expr.bitAnd v.expr (.literal mask)
        else
          v.expr
    | none =>
        match signedBitsOf ty with
        | some width =>
            if width < 256 then
              match v.expr with
              | .literal n =>
                  let low := n % 2 ^ width
                  .literal (if low ≥ 2 ^ (width - 1) then low + (2 ^ 256 - 2 ^ width) else low)
              | _ => Expr.signextend (.literal (width / 8 - 1)) v.expr
            else v.expr
        | none =>
            match bitsOf ty with
            | some width =>
                if width < 256 then
                  match v.expr with
                  | .literal n => .literal (n % 2 ^ width)
                  | _ => Expr.bitAnd v.expr (.literal (2^width-1))
                else v.expr
            | none => v.expr

private def cleanScalarWord (ty : String) (word : Expr) : Expr :=
  if ty == "bool" then Expr.logicalNot (.logicalNot word)
  else
    match fixedBytesWidth? ty with
    | some byteW =>
        if byteW < 32 then
          Expr.bitAnd word (.literal ((2 ^ (8 * byteW) - 1) * 2 ^ (256 - 8 * byteW)))
        else
          word
    | none =>
        match signedBitsOf ty with
        | some width => if width < 256 then Expr.signextend (.literal (width / 8 - 1)) word else word
        | none =>
            match bitsOf ty with
            | some width => if width < 256 then Expr.bitAnd word (.literal (2^width-1)) else word
            | none => word


private def yulNatLit? (node : Json) : M (Option Nat) := do
  if (← mKind node) != "YulLiteral" then return none
  unless optStr node "kind" == some "number" && optStr node "type" == some "" do return none
  let raw ← mStr (← mField node "value")
  let some value := Compiler.Hex.parseHexNat? raw <|> raw.toNat? | return none
  unless value < 2^256 do return none
  return some value

private def yulStringPrefixLit? (node : Json) : M (Option (Nat × Nat)) := do
  if (← mKind node) != "YulLiteral" then return none
  unless optStr node "kind" == some "string" && optStr node "type" == some "" do return none
  if let some hex := optStr node "hexValue" then
    unless hex.length % 2 == 0 do return none
    let byteLen := hex.length / 2
    unless 0 < byteLen && byteLen < 32 do return none
    let chars := hex.toList.toArray
    let mut word : Nat := 0
    for i in [:chars.size] do
      let some d := Compiler.Hex.hexCharToNat? chars[i]! | return none
      word := word * 16 + d
    return some (byteLen, word * 16 ^ (64 - hex.length))
  if let some strVal := optStr node "value" then
    let bytes := strVal.toUTF8.data
    let byteLen := bytes.size
    unless 0 < byteLen && byteLen < 32 do return none
    let mut word : Nat := 0
    for b in bytes do
      word := word * 256 + b.toNat
    return some (byteLen, word * 2 ^ ((32 - byteLen) * 8))
  return none

private def lowerYulDirectAssignmentTarget (j stmt varNode : Json) (refs : Array Json) (retName : String) (rhsVal : Val) (atRootAbiExit := false) : M Stmt := do
  let vname ← mStr (← mField varNode "name")
  if retName != "" && vname == retName && (← get).helperResult.isSome then
    checkYulReturnTarget j stmt varNode vname retName
    let some (binding, ty) := (← get).helperResult
      | failAt stmt s!"Yul assigns {vname}, not the return declaration {retName}"
    if ty.startsWith "enum " then
      failAt j "Yul assignment to an enum result is unsupported"
    return .assignVar binding rhsVal.expr
  else
    let targetSrc ← mStr (← mField varNode "src")
    let mut targetId? : Option Nat := none
    for ref in refs do
      if (← mStr (← mField ref "src")) == targetSrc then
        unless !(← mBool (← mField ref "isOffset")) && !(← mBool (← mField ref "isSlot")) &&
             (field? ref "suffix").isNone && (← mNat (← mField ref "valueSize")) == 1 do
          failAt stmt s!"Yul assignment to non-scalar reference {vname} is unsupported"
        targetId? := some (← mNat (← mField ref "declaration"))
    let some targetId := targetId?
      | if retName != "" then failAt stmt s!"Yul assigns {vname}, not the return name {retName}"
        else failAt stmt s!"unresolved Yul assignment target {vname}"
    let env ← get
    if env.enumBounds.contains targetId then
      failAt stmt s!"Yul assignment to enum variable {vname} is unsupported"
    let some binding := env.writableLocals.find? targetId
      | if retName != "" then failAt stmt s!"Yul assigns {vname}, not the return name {retName}"
        else failAt stmt s!"Yul assignment target {vname} is not a writable scalar local"
    let unshadowed := match env.yulNames.find? vname with
      | some (.localVar b) => b == binding
      | _ => false
    unless unshadowed do
      if retName != "" then failAt stmt s!"Yul assigns {vname}, not the return declaration {retName}"
      else failAt stmt s!"Yul assignment target {vname} is shadowed"
    let some scalarType := env.scalarTy.find? targetId
      | failAt stmt s!"unknown scalar type for Yul assignment target {vname}"
    -- A scratch load is not necessarily a success bit. Only canonicalize it
    -- early when this named bool is write-only in the final assembly block
    -- and its next consumer is the root ABI encoder (no modifier epilogue).
    if atRootAbiExit && scalarType == .bool && yulOnlyAssignsDecl j targetId then
      if let .mload _ := rhsVal.expr then
        if env.rootReturns.any (fun e => match e with
            | .logicalNot (.logicalNot (.localVar b)) => b == binding
            | _ => false) then
          return .assignVar binding (cleanHelperResultExpr "bool" rhsVal)
    if isProvablyBoundedYulExpr scalarType rhsVal.expr then
      return .assignVar binding rhsVal.expr
    if let .bytesN byteW := scalarType then
      if 1 ≤ byteW && byteW < 32 then
        return .assignVar binding rhsVal.expr
    -- Integer and `bool` stack bindings retain the full word until a typed consumer, as in
    -- solc (legacy and via-IR): a Yul read sees the raw word, `==`, `!`, storage, ABI and event
    -- encoding clean it, copies and internal arguments pass it on (#2912).
    match scalarType with
    | .uint8 | .uintN _ | .intN _ | .bool => return .assignVar binding rhsVal.expr
    | _ => pure ()
    -- Under via-IR, an `address` local takes the cleaned word: every Solidity-level
    -- use (including conversions) applies `cleanup_t_address` to the dirty stack word.
    -- Legacy codegen carries dirty bits through conversions, so it stays rejected.
    -- A later raw Yul read is rejected once the whole root is lowered
    -- (`checkYulCleanedNarrowReads`).
    if env.viaIR then
      if let some cleaned := cleanYulNarrowWord? scalarType rhsVal.expr then
        modify fun e => { e with yulCleanedNarrowBindings := e.yulCleanedNarrowBindings.push binding }
        return .assignVar binding cleaned
    unless isFullWordYulScalar scalarType do
      failAt stmt s!"Yul assignment to narrow local {vname} is unsupported"
    return .assignVar binding rhsVal.expr

private def lowerYulPrefixKeccakBlock? (j : Json) (stmts refs : Array Json) (retName : String) : M (Option (Array Stmt)) := do
  let mstoreArgs? (stmt : Json) : M (Option (Json × Json)) := do
    if (← mKind stmt) != "YulExpressionStatement" then return none
    let expr ← mField stmt "expression"
    if (← mKind expr) != "YulFunctionCall" then return none
    let fn ← mStr (← mField (← mField expr "functionName") "name")
    unless fn == "mstore" do return none
    let args ← mArr (← mField expr "arguments")
    unless args.size == 2 do return none
    return some (args[0]!, args[1]!)
  let keccakAssign? (stmt : Json) : M (Option (Json × Json × Json)) := do
    if (← mKind stmt) != "YulAssignment" then return none
    let vars ← mArr (← mField stmt "variableNames")
    unless vars.size == 1 do return none
    let val ← mField stmt "value"
    if (← mKind val) != "YulFunctionCall" then return none
    let fn ← mStr (← mField (← mField val "functionName") "name")
    unless fn == "keccak256" do return none
    let args ← mArr (← mField val "arguments")
    unless args.size == 2 do return none
    return some (vars[0]!, args[0]!, args[1]!)
  if stmts.size == 3 then
    let some (off0Node, strNode) ← mstoreArgs? stmts[0]! | return none
    let some 0 ← yulNatLit? off0Node | return none
    let some (prefixLen, prefixWord) ← yulStringPrefixLit? strNode | return none
    let some (off1Node, msgNode) ← mstoreArgs? stmts[1]! | return none
    let some off1 ← yulNatLit? off1Node | return none
    unless off1 == prefixLen do return none
    let some (varNode, kOffNode, kSizeNode) ← keccakAssign? stmts[2]! | return none
    let some 0 ← yulNatLit? kOffNode | return none
    let some kSize ← yulNatLit? kSizeNode | return none
    unless kSize == prefixLen + 32 do return none
    let msgVal ← lowerYul msgNode
    let keccakExpr := Expr.keccak256 (.literal 0) (.literal (prefixLen + 32))
    let assignStmt ← lowerYulDirectAssignmentTarget j stmts[2]! varNode refs retName { pre := #[], expr := keccakExpr }
    let shrBits := prefixLen * 8
    let shlBits := (32 - prefixLen) * 8
    return some (msgVal.pre ++ #[
      .mstore (.literal 0) (.bitOr (.literal prefixWord) (.shr (.literal shrBits) msgVal.expr)),
      .mstore (.literal 32) (.shl (.literal shlBits) msgVal.expr),
      assignStmt
    ])
  if stmts.size == 5 then
    let declStmt := stmts[0]!
    if (← mKind declStmt) != "YulVariableDeclaration" then return none
    let vars ← mArr (← mField declStmt "variables")
    unless vars.size == 1 do return none
    let varDecl := vars[0]!
    unless optStr varDecl "type" == some "" do return none
    let ptrName ← mStr (← mField varDecl "name")
    unless ptrName.all (fun c => c.isAlphanum || c == '_') && ptrName != "" do return none
    let some initNode := (field? declStmt "value").filter (!·.isNull) | return none
    if (← mKind initNode) != "YulFunctionCall" then return none
    let initFn ← mStr (← mField (← mField initNode "functionName") "name")
    unless initFn == "mload" do return none
    let initArgs ← mArr (← mField initNode "arguments")
    unless initArgs.size == 1 do return none
    let some 64 ← yulNatLit? initArgs[0]! | return none
    let isPtrIdent (node : Json) : M Bool := do
      if (← mKind node) != "YulIdentifier" then return false
      return (← mStr (← mField node "name")) == ptrName
    let isPtrAddConst (node : Json) (expectedOff : Nat) : M Bool := do
      if (← mKind node) != "YulFunctionCall" then return false
      let fn ← mStr (← mField (← mField node "functionName") "name")
      unless fn == "add" do return false
      let nargs ← mArr (← mField node "arguments")
      unless nargs.size == 2 do return false
      if ← isPtrIdent nargs[0]! then
        return (← yulNatLit? nargs[1]!) == some expectedOff
      else if ← isPtrIdent nargs[1]! then
        return (← yulNatLit? nargs[0]!) == some expectedOff
      else
        return false
    let some (ptrNode1, strNode) ← mstoreArgs? stmts[1]! | return none
    unless ← isPtrIdent ptrNode1 do return none
    let some (prefixLen, prefixWord) ← yulStringPrefixLit? strNode | return none
    let some (ptrNode2, domNode) ← mstoreArgs? stmts[2]! | return none
    unless ← isPtrAddConst ptrNode2 prefixLen do return none
    let some (ptrNode3, structNode) ← mstoreArgs? stmts[3]! | return none
    unless ← isPtrAddConst ptrNode3 (prefixLen + 32) do return none
    let some (varNode, kPtrNode, kSizeNode) ← keccakAssign? stmts[4]! | return none
    unless ← isPtrIdent kPtrNode do return none
    let some kSize ← yulNatLit? kSizeNode | return none
    unless kSize == prefixLen + 64 do return none
    let vname ← mStr (← mField varNode "name")
    if vname == ptrName then return none
    let domVal ← lowerYul domNode
    let structVal ← lowerYul structNode
    let ptrBinding ← freshFor ptrName
    modify fun e => { e with encodingMemory := true }
    let keccakExpr := Expr.keccak256 (.localVar ptrBinding) (.literal (prefixLen + 64))
    let assignStmt ← lowerYulDirectAssignmentTarget j stmts[4]! varNode refs retName { pre := #[], expr := keccakExpr }
    let shrBits := prefixLen * 8
    let shlBits := (32 - prefixLen) * 8
    return some (domVal.pre ++ structVal.pre ++ #[
      .letVar ptrBinding (.mload (.literal 64)),
      .mstore (.localVar ptrBinding) (.bitOr (.literal prefixWord) (.shr (.literal shrBits) domVal.expr)),
      .mstore (.add (.localVar ptrBinding) (.literal 32)) (.bitOr (.shl (.literal shlBits) domVal.expr) (.shr (.literal shrBits) structVal.expr)),
      .mstore (.add (.localVar ptrBinding) (.literal 64)) (.shl (.literal shlBits) structVal.expr),
      assignStmt
    ])
  if stmts.size == 7 then
    let declStmt := stmts[0]!
    if (← mKind declStmt) != "YulVariableDeclaration" then return none
    let vars ← mArr (← mField declStmt "variables")
    unless vars.size == 1 do return none
    let varDecl := vars[0]!
    unless optStr varDecl "type" == some "" do return none
    let ptrName ← mStr (← mField varDecl "name")
    unless ptrName.all (fun c => c.isAlphanum || c == '_') && ptrName != "" do return none
    let some initNode := (field? declStmt "value").filter (!·.isNull) | return none
    if (← mKind initNode) != "YulFunctionCall" then return none
    let initFn ← mStr (← mField (← mField initNode "functionName") "name")
    unless initFn == "mload" do return none
    let initArgs ← mArr (← mField initNode "arguments")
    unless initArgs.size == 1 do return none
    let some 64 ← yulNatLit? initArgs[0]! | return none
    let isIdentNamed (node : Json) (expected : String) : M Bool := do
      if (← mKind node) != "YulIdentifier" then return false
      return (← mStr (← mField node "name")) == expected
    let isPtrAddConst (node : Json) (expectedOff : Nat) : M Bool := do
      if (← mKind node) != "YulFunctionCall" then return false
      let fn ← mStr (← mField (← mField node "functionName") "name")
      unless fn == "add" do return false
      let nargs ← mArr (← mField node "arguments")
      unless nargs.size == 2 do return false
      if ← isIdentNamed nargs[0]! ptrName then
        return (← yulNatLit? nargs[1]!) == some expectedOff
      else if ← isIdentNamed nargs[1]! ptrName then
        return (← yulNatLit? nargs[0]!) == some expectedOff
      else
        return false
    let some (ptrNode1, bytecodeHashNode) ← mstoreArgs? stmts[1]! | return none
    unless ← isPtrAddConst ptrNode1 64 do return none
    let some (ptrNode2, saltNode) ← mstoreArgs? stmts[2]! | return none
    unless ← isPtrAddConst ptrNode2 32 do return none
    let some (ptrNode3, deployerNode) ← mstoreArgs? stmts[3]! | return none
    unless ← isIdentNamed ptrNode3 ptrName do return none
    let startDecl := stmts[4]!
    if (← mKind startDecl) != "YulVariableDeclaration" then return none
    let startVars ← mArr (← mField startDecl "variables")
    unless startVars.size == 1 do return none
    let startVar := startVars[0]!
    unless optStr startVar "type" == some "" do return none
    let startName ← mStr (← mField startVar "name")
    unless startName.all (fun c => c.isAlphanum || c == '_') && startName != "" && startName != ptrName do return none
    let some startInit := (field? startDecl "value").filter (!·.isNull) | return none
    unless ← isPtrAddConst startInit 11 do return none
    let m8Stmt := stmts[5]!
    if (← mKind m8Stmt) != "YulExpressionStatement" then return none
    let m8Expr ← mField m8Stmt "expression"
    if (← mKind m8Expr) != "YulFunctionCall" then return none
    let m8Fn ← mStr (← mField (← mField m8Expr "functionName") "name")
    unless m8Fn == "mstore8" do return none
    let m8Args ← mArr (← mField m8Expr "arguments")
    unless m8Args.size == 2 do return none
    unless ← isIdentNamed m8Args[0]! startName do return none
    let some prefixByte ← yulNatLit? m8Args[1]! | return none
    unless prefixByte < 256 do return none
    let some (varNode, kStartNode, kSizeNode) ← keccakAssign? stmts[6]! | return none
    unless ← isIdentNamed kStartNode startName do return none
    let some 85 ← yulNatLit? kSizeNode | return none
    let vname ← mStr (← mField varNode "name")
    if vname == ptrName || vname == startName then return none
    let bytecodeHashVal ← lowerYul bytecodeHashNode
    let saltVal ← lowerYul saltNode
    let deployerVal ← lowerYul deployerNode
    let ptrBinding ← freshFor ptrName
    modify fun e => { e with encodingMemory := true }
    let keccakExpr := Expr.keccak256 (.localVar ptrBinding) (.literal 85)
    let assignStmt ← lowerYulDirectAssignmentTarget j stmts[6]! varNode refs retName { pre := #[], expr := keccakExpr }
    let prefixWord := (prefixByte % 256) * (2 ^ 248)
    let deployerMasked := Expr.bitAnd deployerVal.expr (.literal (2 ^ 160 - 1))
    let word0 := Expr.bitOr (.literal prefixWord) (.bitOr (.shl (.literal 88) deployerMasked) (.shr (.literal 168) saltVal.expr))
    let word1 := Expr.bitOr (.shl (.literal 88) saltVal.expr) (.shr (.literal 168) bytecodeHashVal.expr)
    let word2 := Expr.shl (.literal 88) bytecodeHashVal.expr
    return some (bytecodeHashVal.pre ++ saltVal.pre ++ deployerVal.pre ++ #[
      .letVar ptrBinding (.mload (.literal 64)),
      .mstore (.localVar ptrBinding) word0,
      .mstore (.add (.localVar ptrBinding) (.literal 32)) word1,
      .mstore (.add (.localVar ptrBinding) (.literal 64)) word2,
      assignStmt
    ])
  if stmts.size == 8 then
    let declStmt := stmts[0]!
    if (← mKind declStmt) != "YulVariableDeclaration" then return none
    let vars ← mArr (← mField declStmt "variables")
    unless vars.size == 1 do return none
    let varDecl := vars[0]!
    unless optStr varDecl "type" == some "" do return none
    let ptrName ← mStr (← mField varDecl "name")
    unless ptrName.all (fun c => c.isAlphanum || c == '_') && ptrName != "" do return none
    let some initNode := (field? declStmt "value").filter (!·.isNull) | return none
    if (← mKind initNode) != "YulFunctionCall" then return none
    let initFn ← mStr (← mField (← mField initNode "functionName") "name")
    unless initFn == "mload" do return none
    let initArgs ← mArr (← mField initNode "arguments")
    unless initArgs.size == 1 do return none
    let some 64 ← yulNatLit? initArgs[0]! | return none
    let isPtrIdent (node : Json) : M Bool := do
      if (← mKind node) != "YulIdentifier" then return false
      return (← mStr (← mField node "name")) == ptrName
    let isPtrAddConst (node : Json) (expectedOff : Nat) : M Bool := do
      if (← mKind node) != "YulFunctionCall" then return false
      let fn ← mStr (← mField (← mField node "functionName") "name")
      unless fn == "add" do return false
      let nargs ← mArr (← mField node "arguments")
      unless nargs.size == 2 do return false
      if ← isPtrIdent nargs[0]! then
        return (← yulNatLit? nargs[1]!) == some expectedOff
      else if ← isPtrIdent nargs[1]! then
        return (← yulNatLit? nargs[0]!) == some expectedOff
      else
        return false
    let some (ptrNode1, deployerNode) ← mstoreArgs? stmts[1]! | return none
    unless ← isPtrAddConst ptrNode1 0x38 do return none
    let some (ptrNode2, midConstNode) ← mstoreArgs? stmts[2]! | return none
    unless ← isPtrAddConst ptrNode2 0x24 do return none
    let some midConst ← yulNatLit? midConstNode | return none
    unless midConst < 2 ^ 128 do return none
    let some (ptrNode3, implNode) ← mstoreArgs? stmts[3]! | return none
    unless ← isPtrAddConst ptrNode3 0x14 do return none
    let some (ptrNode4, headConstNode) ← mstoreArgs? stmts[4]! | return none
    unless ← isPtrIdent ptrNode4 do return none
    let some headConst ← yulNatLit? headConstNode | return none
    unless headConst < 2 ^ 160 do return none
    let some (ptrNode5, saltNode) ← mstoreArgs? stmts[5]! | return none
    unless ← isPtrAddConst ptrNode5 0x58 do return none
    let some (ptrNode6, innerKeccakNode) ← mstoreArgs? stmts[6]! | return none
    unless ← isPtrAddConst ptrNode6 0x78 do return none
    if (← mKind innerKeccakNode) != "YulFunctionCall" then return none
    let innerFn ← mStr (← mField (← mField innerKeccakNode "functionName") "name")
    unless innerFn == "keccak256" do return none
    let innerArgs ← mArr (← mField innerKeccakNode "arguments")
    unless innerArgs.size == 2 do return none
    unless ← isPtrAddConst innerArgs[0]! 0x0c do return none
    let some 0x37 ← yulNatLit? innerArgs[1]! | return none
    let some (varNode, outerPtrNode, outerSizeNode) ← keccakAssign? stmts[7]! | return none
    unless ← isPtrAddConst outerPtrNode 0x43 do return none
    let some 0x55 ← yulNatLit? outerSizeNode | return none
    let vname ← mStr (← mField varNode "name")
    if vname == ptrName then return none
    let deployerVal ← lowerYul deployerNode
    let implVal ← lowerYul implNode
    let saltVal ← lowerYul saltNode
    let ptrBinding ← freshFor ptrName
    let initHashBinding ← fresh
    modify fun e => { e with encodingMemory := true }
    let keccakExpr := Expr.keccak256 (.add (.localVar ptrBinding) (.literal 64)) (.literal 85)
    let assignStmt ← lowerYulDirectAssignmentTarget j stmts[7]! varNode refs retName { pre := #[], expr := keccakExpr }
    let implMasked := Expr.bitAnd implVal.expr (.literal (2 ^ 160 - 1))
    let initWord0 := Expr.bitOr (.literal (headConst * (2 ^ 96))) (.shr (.literal 64) implMasked)
    let initWord1 := Expr.bitOr (.shl (.literal 192) implMasked) (.literal ((midConst / 256) * (2 ^ 72)))
    let prefixWord := (midConst % 256) * (2 ^ 248)
    let deployerMasked := Expr.bitAnd deployerVal.expr (.literal (2 ^ 160 - 1))
    let c2Word0 := Expr.bitOr (.literal prefixWord) (.bitOr (.shl (.literal 88) deployerMasked) (.shr (.literal 168) saltVal.expr))
    let c2Word1 := Expr.bitOr (.shl (.literal 88) saltVal.expr) (.shr (.literal 168) (.localVar initHashBinding))
    let c2Word2 := Expr.shl (.literal 88) (.localVar initHashBinding)
    return some (deployerVal.pre ++ implVal.pre ++ saltVal.pre ++ #[
      .letVar ptrBinding (.mload (.literal 64)),
      .mstore (.localVar ptrBinding) initWord0,
      .mstore (.add (.localVar ptrBinding) (.literal 32)) initWord1,
      .letVar initHashBinding (.keccak256 (.localVar ptrBinding) (.literal 55)),
      .mstore (.add (.localVar ptrBinding) (.literal 64)) c2Word0,
      .mstore (.add (.localVar ptrBinding) (.literal 96)) c2Word1,
      .mstore (.add (.localVar ptrBinding) (.literal 128)) c2Word2,
      assignStmt
    ])
  return none

/-- Occurrences of the Yul identifier `name` in `j`. -/
private partial def yulIdentifierUses (name : String) : Json → Nat
  | j@(.obj kvs) =>
      (if optStr j "nodeType" == some "YulIdentifier" && optStr j "name" == some name then 1 else 0) +
        kvs.foldl (fun acc _ v => acc + yulIdentifierUses name v) 0
  | .arr items => items.foldl (fun acc v => acc + yulIdentifierUses name v) 0
  | _ => 0

/-- `copy` is `returndatacopy(name, 0, returndatasize())` and `rev` is
`revert(name, returndatasize())`, as expression statements. -/
private def yulBubblePairFor (name : String) (copy rev : Json) : Bool :=
  let call (s : Json) (fname : String) : Option (Array Json) :=
    if optStr s "nodeType" != some "YulExpressionStatement" then none else
    match field? s "expression" with
    | some e =>
        if optStr e "nodeType" == some "YulFunctionCall" &&
            (field? e "functionName").bind (optStr · "name") == some fname then
          match field? e "arguments" with
          | some (.arr args) => some args
          | _ => none
        else none
    | none => none
  let isName (e : Json) := optStr e "nodeType" == some "YulIdentifier" && optStr e "name" == some name
  let isZero (e : Json) := optStr e "nodeType" == some "YulLiteral" &&
    ((optStr e "value").bind fun raw => Compiler.Hex.parseHexNat? raw <|> raw.toNat?) == some 0
  let isSize (e : Json) := optStr e "nodeType" == some "YulFunctionCall" &&
    (field? e "functionName").bind (optStr · "name") == some "returndatasize" &&
    (match field? e "arguments" with | some (.arr #[]) => true | _ => false)
  match call copy "returndatacopy", call rev "revert" with
  | some #[d, z, s], some #[p, t] => isName d && isZero z && isSize s && isName p && isSize t
  | _, _ => false

/-- Uses of `name` that only restore the free-memory pointer (`mstore(0x40, name)`) or place a
bubbled revert (an adjacent `returndatacopy(name, 0, returndatasize())` +
`revert(name, returndatasize())` pair, lowered as `revertReturndata`), whose payload is the
return data wherever it is copied. -/
private partial def yulFreePointerUses (name : String) : Json → Nat
  | j@(.obj kvs) =>
      let isName (e : Json) := optStr e "nodeType" == some "YulIdentifier" && optStr e "name" == some name
      let isLit (e : Json) (n : Nat) := optStr e "nodeType" == some "YulLiteral" &&
        ((optStr e "value").bind fun raw => Compiler.Hex.parseHexNat? raw <|> raw.toNat?) == some n
      let here :=
        if optStr j "nodeType" == some "YulFunctionCall" then
          match (field? j "functionName").bind (optStr · "name"), field? j "arguments" with
          | some "mstore", some (.arr #[a, b]) => if isLit a 0x40 && isName b then 1 else 0
          | _, _ => 0
        else 0
      here + kvs.foldl (fun acc _ v => acc + yulFreePointerUses name v) 0
  | .arr items =>
      -- `returndatacopy(name, 0, returndatasize())` then `revert(name, returndatasize())`:
      -- the two statements of a bubbled revert, lowered together as `revertReturndata`.
      let pairAt (i : Nat) : Bool := i + 1 < items.size && yulBubblePairFor name items[i]! items[i+1]!
      (List.range items.size).foldl (fun acc i =>
        if pairAt i then acc + 2
        else if i > 0 && pairAt (i - 1) then acc
        else acc + yulFreePointerUses name items[i]!) 0
  | _ => 0

/-- `let name := mload(0x40)` in the block `j` whose every other use of `name` restores the
free-memory pointer or places a bubbled revert. The model's free pointer may differ from
solc's (its allocations are not solc's), so no other use is sound. -/
private def yulFreePointerSave? (j stmt : Json) (name : String) : M Bool := do
  let some value := (field? stmt "value").filter (!·.isNull) | return false
  unless optStr value "nodeType" == some "YulFunctionCall" &&
      (field? value "functionName").bind (optStr · "name") == some "mload" do return false
  let .arr #[addr] := (field? value "arguments").getD .null | return false
  unless optStr addr "nodeType" == some "YulLiteral" &&
      ((optStr addr "value").bind fun raw => Compiler.Hex.parseHexNat? raw <|> raw.toNat?) == some 0x40 do return false
  let ast := (field? j "AST").getD .null
  -- The declaration names `name` once; every use must be an admitted one.
  unless yulIdentifierUses name ast == yulFreePointerUses name ast do
    failAt value "Yul reads of the free-memory pointer may only restore it or place a bubbled revert"
  return true

/-- `returndatacopy(p, 0, returndatasize())` followed by `revert(p, returndatasize())` with
the same `p`: forwarding the complete return data as the revert payload. -/
private def isYulReturndataBubble (copy rev : Json) : M Bool := do
  let callOf (s : Json) : M (Option (String × Array Json)) := do
    if (← mKind s) != "YulExpressionStatement" then return none
    let e ← mField s "expression"
    if (← mKind e) != "YulFunctionCall" then return none
    return some (← mStr (← mField (← mField e "functionName") "name"), ← mArr (← mField e "arguments"))
  let isSize (e : Json) : M Bool := do
    if (← mKind e) != "YulFunctionCall" then return false
    return (← mStr (← mField (← mField e "functionName") "name")) == "returndatasize" &&
      (← mArr (← mField e "arguments")).isEmpty
  let identName (e : Json) : M (Option String) := do
    if (← mKind e) != "YulIdentifier" then return none
    return some (← mStr (← mField e "name"))
  let some ("returndatacopy", cargs) ← callOf copy | return false
  let some ("revert", rargs) ← callOf rev | return false
  unless cargs.size == 3 && rargs.size == 2 do return false
  let zeroSource := (← mKind cargs[1]!) == "YulLiteral" && optStr cargs[1]! "value" == some "0x00" ||
    (← mKind cargs[1]!) == "YulLiteral" && optStr cargs[1]! "value" == some "0"
  let some dest ← identName cargs[0]! | return false
  let some payload ← identName rargs[0]! | return false
  return dest == payload && zeroSource && (← isSize cargs[2]!) && (← isSize rargs[1]!)

/-- Whether any `YulAssignment` inside `j` assigns to `name`. -/
private partial def yulBlockAssigns (name : String) : Json → Bool
  | j@(.obj kvs) =>
      let assignsHere :=
        if optStr j "nodeType" == some "YulAssignment" then
          match field? j "variableNames" with
          | some (.arr vs) => vs.any fun v => optStr v "name" == some name
          | _ => false
        else false
      kvs.foldl (fun acc _ v => acc || yulBlockAssigns name v) assignsHere
  | .arr items => items.any (yulBlockAssigns name)
  | _ => false

/-- Flatten nested binary Yul `add(...)` calls in left-to-right operand order. -/
private partial def flattenYulAdd (node : Json) : M (Array Json) := do
  if (← mKind node) == "YulFunctionCall" then
    let fname ← mStr (← mField (← mField node "functionName") "name")
    let args ← mArr (← mField node "arguments")
    if fname == "add" && args.size == 2 then
      return (← flattenYulAdd args[0]!) ++ (← flattenYulAdd args[1]!)
  return #[node]

/-- Resolve an unshadowed `YulIdentifier` referencing a modelled `bytes` / `string` memory
buffer via `InlineAssembly.externalReferences`. -/
private def resolveYulBufferRef? (refs : Array Json) (node : Json) :
    M (Option (Nat × EncodedBytes)) := do
  if optStr node "nodeType" != some "YulIdentifier" then return none
  let identName ← mStr (← mField node "name")
  let env ← get
  if env.yulDeclaredNames.contains identName then return none
  let nodeSrc ← mStr (← mField node "src")
  let mut declId? : Option Nat := none
  for ref in refs do
    if (← mStr (← mField ref "src")) == nodeSrc then
      unless !(← mBool (← mField ref "isOffset")) && !(← mBool (← mField ref "isSlot")) &&
          (field? ref "suffix").isNone && (← mNat (← mField ref "valueSize")) == 1 do
        return none
      declId? := some (← mNat (← mField ref "declaration"))
  let some declId := declId? | return none
  if env.shortStringBuffers.contains declId then return none
  let some buf := env.byteBuffers.find? declId <|> env.stringBuffers.find? declId
    | return none
  if buf.shortStringAlloc then return none
  unless buf.pre.isEmpty do return none
  return some (declId, buf)

/-- Parse a Yul byte-buffer payload address (`add(buf, 0x20 + ...)` or an un-reassigned Yul
cursor `let` derived from one), returning `(declId, buf, litPayloadOff, cursorOffVars,
extraOffsetVals)`. Restores `Env` whenever returning `none`. -/
private def parseYulBufferAddr? (refs : Array Json) (node : Json) :
    M (Option (Nat × EncodedBytes × Nat × List String × Array Val)) := do
  let savedEnv ← get
  let terms ← flattenYulAdd node
  let mut base? : Option (Nat × EncodedBytes × Bool × Nat × List String) := none
  let mut litSum : Nat := 0
  let mut otherNodes : Array Json := #[]
  for t in terms do
    if let some n ← yulNumber? t then
      unless n < 2 ^ 64 && litSum + n < 2 ^ 64 do
        set savedEnv
        return none
      litSum := litSum + n
    else if optStr t "nodeType" == some "YulIdentifier" then
      let tName ← mStr (← mField t "name")
      if let some cur := (← get).yulBufCursors.find? tName then
        if base?.isSome then
          set savedEnv
          return none
        base? := some (cur.declId, cur.buffer, true, cur.litOffset, cur.offsetVars)
      else if let some (declId, buf) ← resolveYulBufferRef? refs t then
        if base?.isSome then
          set savedEnv
          return none
        base? := some (declId, buf, false, 0, [])
      else
        otherNodes := otherNodes.push t
    else
      otherNodes := otherNodes.push t
  let some (declId, buf, fromCursor, baseLitOff, baseOffVars) := base?
    | do set savedEnv; return none
  let litOff ←
    if fromCursor then
      if baseLitOff + litSum < 2 ^ 64 then pure (baseLitOff + litSum)
      else do set savedEnv; return none
    else
      if litSum ≥ 32 && litSum - 32 < 2 ^ 64 then pure (litSum - 32)
      else do set savedEnv; return none
  let mut extraVals : Array Val := #[]
  for other in otherNodes do
    extraVals := extraVals.push (← lowerYul other)
  return some (declId, buf, litOff, baseOffVars, extraVals)

/-- Whether `node` mentions a Yul buffer cursor or an unshadowed byte/string buffer identifier. -/
private partial def mentionsYulBufferIdent (refs : Array Json) : Json → M Bool
  | j@(.obj kvs) => do
      if optStr j "nodeType" == some "YulIdentifier" then
        let name ← mStr (← mField j "name")
        if (← get).yulBufCursors.contains name || (← get).yulCursorOnlyNames.contains name then
          return true
        if (← resolveYulBufferRef? refs j).isSome then
          return true
      kvs.foldlM (fun acc _ v => if acc then pure true else mentionsYulBufferIdent refs v) false
  | .arr items => do
      for v in items do
        if ← mentionsYulBufferIdent refs v then return true
      return false
  | _ => return false

private partial def lowerYulStmtSlice (j : Json) (stmts refs : Array Json) (retName : String) (atRootAbiExit := false) : M (Array Stmt) := do
  let mut yulLocals : RBMap String String compare := RBMap.empty
  let mut out : Array Stmt := #[]
  -- The zero slot must hold zero again when the block ends if the block wrote it, and the
  -- free-memory pointer must hold the value the block saved.
  let mut zeroSlotDirty := false
  let mut freePointerDirty := false
  let mut freePointerSaves : Array String := #[]
  let mut skipNext := false
  for i in [:stmts.size] do
    let stmt := stmts[i]!
    if skipNext then
      skipNext := false
      continue
    if i + 1 < stmts.size then
      if ← isYulReturndataBubble stmt stmts[i+1]! then
        -- The copy writes the return data at `p`; a `p` far beyond the frame's memory is an
        -- out-of-gas halt on the EVM, while the model reverts with the data. A saved
        -- free-memory pointer is a small heap address on every route.
        let dest := ((field? stmt "expression").bind (field? · "arguments")).bind fun
          | .arr args => args[0]?.bind (optStr · "name")
          | _ => none
        let env ← get
        let savedDest := match dest.bind env.yulNames.find? with
          | some (.localVar binding) => env.yulFreePointerBindings.contains binding
          | _ => false
        if savedDest then
          noteReturndataRead stmt
          out := out.push .revertReturndata
          skipNext := true
          continue
    match ← mKind stmt with
    | "YulVariableDeclaration" =>
        let vars ← mArr (← mField stmt "variables")
        unless vars.size == 1 do failAt stmt "Yul variable declaration must have one variable"
        let varNode := vars[0]!
        unless optStr varNode "type" == some "" do
          failAt varNode "typed Yul variables are unsupported"
        let vname ← mStr (← mField varNode "name")
        unless vname.all (fun c => c.isAlphanum || c == '_') && vname != "" do
          failAt varNode s!"unsupported Yul variable name {vname}"
        if yulLocals.contains vname || (← get).yulDeclaredNames.contains vname then
          failAt varNode s!"duplicate Yul variable declaration {vname}"
        let savesFreePointer ← yulFreePointerSave? j stmt vname
        let valOpt := (field? stmt "value").filter (!·.isNull)
        let ast := (field? j "AST").getD .null
        let cursor? ←
          if !savesFreePointer && !yulBlockAssigns vname ast then
            match valOpt with
            | some valNode => parseYulBufferAddr? refs valNode
            | none => pure none
          else
            pure none
        if let some (declId, buf, litOff, baseOffVars, extraVals) := cursor? then
          checkYulOperandOrder stmt extraVals
          let mut pre : Array Stmt := #[]
          for ev in extraVals do
            pre := pre ++ ev.pre
          let mut extraVars : List String := []
          for ev in extraVals do
            let b ← fresh
            pre := pre.push (.letVar b ev.expr)
            extraVars := extraVars ++ [b]
          let cur : YulBufferCursor :=
            { declId, buffer := buf, litOffset := litOff, offsetVars := baseOffVars ++ extraVars }
          modify fun e =>
            { e with yulNames := e.yulNames.erase vname,
                     yulMemoryArrays := e.yulMemoryArrays.erase vname,
                     yulMemoryStructs := e.yulMemoryStructs.erase vname,
                     yulBufCursors := e.yulBufCursors.insert vname cur,
                     yulDeclaredNames := e.yulDeclaredNames.push vname,
                     yulCursorOnlyNames := e.yulCursorOnlyNames.push vname }
          out := out ++ pre
          continue
        let v ← if savesFreePointer then pure { pre := #[], expr := .mload (.literal 0x40) }
          else match valOpt with
          | some valNode => lowerYulValue valNode
          | none => pure { pre := #[], expr := .literal 0 }
        let binding ← freshFor vname
        if savesFreePointer then
          freePointerSaves := freePointerSaves.push binding
          modify fun e => { e with yulFreePointerBindings := e.yulFreePointerBindings.push binding }
        let expr := Expr.localVar binding
        modify fun e =>
          { e with yulNames := e.yulNames.insert vname expr,
                   yulBufCursors := e.yulBufCursors.erase vname,
                   yulDeclaredNames := e.yulDeclaredNames.push vname,
                   yulCursorOnlyNames := e.yulCursorOnlyNames.filter (· != vname) }
        yulLocals := yulLocals.insert vname binding
        out := out ++ v.pre |>.push (.letVar binding v.expr)
    | "YulAssignment" =>
        let vars ← mArr (← mField stmt "variableNames")
        unless vars.size == 1 do failAt stmt "Yul assignment must have one target"
        let varNode := vars[0]!
        let vname ← mStr (← mField varNode "name")
        if (← get).yulCursorOnlyNames.contains vname then
          failAt stmt s!"Yul byte-buffer cursor {vname} cannot be reassigned"
        if let some yulBinding := yulLocals.find? vname then
          let v ← lowerYulValue (← mField stmt "value")
          out := out ++ v.pre |>.push (.assignVar yulBinding v.expr)
        else
          let v ← lowerYulValue (← mField stmt "value")
          let assignStmt ← lowerYulDirectAssignmentTarget j stmt varNode refs retName v atRootAbiExit
          out := out ++ v.pre |>.push assignStmt
    | "YulExpressionStatement" =>
        let expr ← mField stmt "expression"
        unless (← mKind expr) == "YulFunctionCall" do
          failAt stmt "unsupported Yul expression statement"
        let fname ← mStr (← mField (← mField expr "functionName") "name")
        let args ← mArr (← mField expr "arguments")
        if fname == "tstore" then
          unless args.size == 2 do failAt expr "tstore requires two arguments"
          let slotVal ← lowerYul args[0]!
          let valVal ← lowerYul args[1]!
          checkYulOperandOrder expr #[slotVal, valVal]
          out := out ++ slotVal.pre ++ valVal.pre |>.push (.tstore slotVal.expr valVal.expr)
        else if fname == "sstore" then
          unless args.size == 2 do failAt expr "sstore requires two arguments"
          let slotVal ← lowerYul args[0]!
          let valVal ← lowerYul args[1]!
          checkYulOperandOrder expr #[slotVal, valVal]
          modify fun e => { e with usedRawStorage := true }
          out := out ++ slotVal.pre ++ valVal.pre |>.push (.setStorageArrayElement rawStorageFieldName slotVal.expr valVal.expr)
        else if fname == "mstore" then
          unless args.size == 2 do failAt expr "mstore requires two arguments"
          let offVal ← lowerYul args[0]!
          let valVal ← lowerYul args[1]!
          checkYulOperandOrder expr #[offVal, valVal]
          let .literal off := offVal.expr
            | failAt expr "Yul mstore requires a fixed address below 0x80"
          unless offVal.pre.isEmpty && off + 32 ≤ yulReservedMemoryEnd do
            failAt expr "Yul mstore requires a fixed address below 0x80"
          modify fun e =>
            { e with yulWrittenBytes := Nat.lor e.yulWrittenBytes (Nat.shiftLeft (2^32 - 1) off) }
          -- A scratch word counts as written only when an mstore covers all of it.
          if off == 0 then
            modify fun e => { e with yulScratch0 := true }
          if off == 32 then
            modify fun e => { e with yulScratch32 := true }
          if off < 0x60 && off + 32 > 0x40 then
            freePointerDirty := !(off == 0x40 && valVal.pre.isEmpty &&
              (match valVal.expr with
               | .localVar b => freePointerSaves.contains b
               | _ => false))
          if off + 32 > yulZeroSlot then
            zeroSlotDirty := !(off == yulZeroSlot && valVal.pre.isEmpty &&
              (match valVal.expr with | .literal 0 => true | _ => false))
          out := out ++ valVal.pre |>.push (.mstore (.literal off) valVal.expr)
        else if fname == "mstore8" then
          unless args.size == 2 do failAt expr "mstore8 expects 2 arguments"
          let addrVal ← atom (← lowerYul args[0]!)
          let valVal ← atom (← lowerYul args[1]!)
          checkYulOperandOrder expr #[addrVal, valVal]
          let wordAddr := AbiEncoding.byteWordOffset addrVal.expr
          let shift := Expr.mul (.literal 8) (.sub (.literal 31) (AbiEncoding.byteLane addrVal.expr))
          let byteMask := Expr.shl shift (.literal 0xff)
          let cleared := Expr.bitAnd (.mload wordAddr) (.bitNot byteMask)
          let newByte := Expr.shl shift (.bitAnd valVal.expr (.literal 0xff))
          out := out ++ addrVal.pre ++ valVal.pre |>.push (.mstore wordAddr (.bitOr cleared newByte))
        else if fname == "revert" then
          unless args.size == 2 do failAt expr "revert requires two arguments"
          if (← yulNumber? args[1]!) == some 0 then
            let offVal ← lowerYul args[0]!
            out := out ++ offVal.pre |>.push .revertEmpty
          else if let some buffer ← yulForwardedBytes? args then
            -- `revert(add(b, 0x20), mload(b))` reverts with exactly the bytes of the
            -- `bytes memory` local `b`, which the model holds at its own pointer.
            out := out ++ buffer.pre |>.push (.revertMemory buffer.pointer buffer.size)
          else
            -- `revert(add(buf, 0x20), mload(buf))` forwarding a bound `bytes memory` / `string memory`
            -- local (e.g., returndata from `address(this).delegatecall(...)`).
            let yulCallArgs? (node : Json) (name : String) : Option (Array Json) :=
              if optStr node "nodeType" == some "YulFunctionCall" &&
                  (field? node "functionName").bind (optStr · "name") == some name then
                match field? node "arguments" with
                | some (.arr xs) => some xs
                | _ => none
              else none
            let bufRevert? : Option EncodedBytes ← do
              let some #[offL, offR] := yulCallArgs? args[0]! "add" | pure none
              let some #[lenArg] := yulCallArgs? args[1]! "mload" | pure none
              let offNode? ←
                if (← yulNumber? offR) == some 32 then pure (some offL)
                else if (← yulNumber? offL) == some 32 then pure (some offR)
                else pure none
              let some offNode := offNode? | pure none
              if optStr offNode "nodeType" == some "YulIdentifier" &&
                  optStr lenArg "nodeType" == some "YulIdentifier" &&
                  optStr offNode "name" == optStr lenArg "name" then
                yulByteBufferByName? offNode
              else pure none
            if let some buf := bufRevert? then
              out := out ++ buf.pre |>.push (.revertMemory buf.pointer buf.size)
            else
              -- A nonzero size reverts with memory bytes. The model's memory agrees with the EVM's
              -- only on scratch bytes (below 0x40) this Yul block wrote on every path
              -- (`yulWrittenBytes`): elsewhere solc's code generator left values the model does not
              -- reproduce, and a restored free-memory pointer at 0x40 holds solc's pointer, which
              -- the model's differs from. So the range must be literal, below 0x40 and written
              -- (e.g. `mstore(0, sel) revert(0x1c, 4)`).
              let written := (← get).yulWrittenBytes
              let range? := match (← yulNumber? args[0]!), (← yulNumber? args[1]!) with
                | some off, some size =>
                    if off + size ≤ 0x40 &&
                        (List.range size).all fun k => written.testBit (off + k) then
                      some (off, size)
                    else none
                | _, _ => none
              let some (off, size) := range?
                | failAt expr ("Yul revert with revert data is supported only for a literal " ++
                    "range below 0x40 that this Yul block wrote on every path")
              out := out.push (.revertMemory (.literal off) (.literal size))
        else if fname == "mcopy" then
          unless args.size == 3 do failAt expr "mcopy requires three arguments"
          if (← yulNumber? args[2]!) == some 0 then
            -- EIP-5656: a zero size copies nothing and expands no memory, whatever the offsets;
            -- only the operands' own effects remain.
            let dstVals ← match ← parseYulBufferAddr? refs args[0]! with
              | some (_, _, _, _, extraVals) => pure extraVals
              | none => pure #[← lowerYul args[0]!]
            let srcVals ← match ← parseYulBufferAddr? refs args[1]! with
              | some (_, _, _, _, extraVals) => pure extraVals
              | none => pure #[← lowerYul args[1]!]
            checkYulOperandOrder expr (dstVals ++ srcVals)
            for v in dstVals ++ srcVals do
              out := out ++ v.pre
          else
            -- Scratch-word literal range below 0x40, or a bounded copy between modelled
            -- `bytes memory` / `string memory` buffer payloads (`YulBufferMcopy`).
            let written := (← get).yulWrittenBytes
            let range? := match (← yulNumber? args[0]!), (← yulNumber? args[1]!),
                (← yulNumber? args[2]!) with
              | some dst, some src, some size =>
                  if dst + size ≤ 0x40 && src + size ≤ 0x40 &&
                      (List.range size).all fun k => written.testBit (src + k) then
                    some (dst, src, size)
                  else none
              | _, _, _ => none
            if let some (dst, src, size) := range? then
              -- Snapshot both scratch words, then rewrite the destination words from the snapshot.
              let mut snapshots : List (Nat × String) := []
              for w in yulScratchWords do
                let binding ← fresh
                snapshots := snapshots ++ [(w, binding)]
                out := out.push (.letVar binding (.mload (.literal w)))
              let word (w : Nat) : Expr := match snapshots.lookup w with
                | some binding => .localVar binding
                | none => .literal 0
              for w in yulScratchWords do
                if let some value := yulScratchWordAfterMcopy word dst src size w then
                  out := out.push (.mstore (.literal w) value)
              modify fun e =>
                let bytes := Nat.lor e.yulWrittenBytes (Nat.shiftLeft (2 ^ size - 1) dst)
                { e with yulWrittenBytes := bytes,
                         yulScratch0 := e.yulScratch0 || (List.range 32).all bytes.testBit,
                         yulScratch32 := e.yulScratch32 ||
                           (List.range 32).all fun k => bytes.testBit (32 + k) }
            else
              let dstParsed? ← parseYulBufferAddr? refs args[0]!
              let srcParsed? ← parseYulBufferAddr? refs args[1]!
              if let (some (dstDeclId, dstBuf, dstLitOff, dstBaseVars, dstExtraVals),
                      some (_, srcBuf, srcLitOff, srcBaseVars, srcExtraVals)) :=
                  (dstParsed?, srcParsed?) then
                let lenVal ← lowerYul args[2]!
                checkYulOperandOrder expr (dstExtraVals ++ srcExtraVals ++ #[lenVal])
                -- Run all hoisted call/effect preludes before binding any operand `.expr` so
                -- right-hand call effects (`returndatasize()`, storage, balance) precede pure
                -- left-hand offset expressions, matching Yul's right-to-left operand evaluation.
                for dv in dstExtraVals do
                  out := out ++ dv.pre
                for sv in srcExtraVals do
                  out := out ++ sv.pre
                out := out ++ lenVal.pre
                let mut extraDstVars : List String := []
                for dv in dstExtraVals do
                  let b ← fresh
                  out := out.push (.letVar b dv.expr)
                  extraDstVars := extraDstVars ++ [b]
                let mut extraSrcVars : List String := []
                for sv in srcExtraVals do
                  let b ← fresh
                  out := out.push (.letVar b sv.expr)
                  extraSrcVars := extraSrcVars ++ [b]
                let dstPtrVar ← fresh
                let srcPtrVar ← fresh
                let lenVar ← fresh
                let dstSizeVar ← fresh
                let srcSizeVar ← fresh
                out := out ++ #[
                  .letVar dstPtrVar dstBuf.pointer,
                  .letVar srcPtrVar srcBuf.pointer,
                  .letVar lenVar lenVal.expr,
                  .letVar dstSizeVar dstBuf.size,
                  .letVar srcSizeVar srcBuf.size
                ]
                let dstOffVars := dstBaseVars ++ extraDstVars
                let srcOffVars := srcBaseVars ++ extraSrcVars
                let temps : BufferMcopyTemps :=
                  { dstStart := ← fresh
                    srcStart := ← fresh
                    fwdIdx := ← fresh
                    fwdByte := ← fresh
                    fwdWord := ← fresh
                    bwdStep := ← fresh
                    bwdIdx := ← fresh
                    bwdByte := ← fresh
                    bwdWord := ← fresh }
                out := out.push (emitBufferMcopyLoop
                  (.localVar dstPtrVar) (buildMcopyOffsetExpr dstLitOff dstOffVars)
                  (.localVar srcPtrVar) (buildMcopyOffsetExpr srcLitOff srcOffVars)
                  lenVar temps)
                let envNow ← get
                let site : McopySite :=
                  { lenVar
                    dstPtrVar
                    dstOffVars
                    dstLitOff
                    dstSizeVar
                    srcPtrVar
                    srcOffVars
                    srcLitOff
                    srcSizeVar
                    node := expr
                    file := envNow.currentFile
                    stack := envNow.stack }
                modify fun e =>
                  { e with encodingMemory := true,
                           initcodeTemplates := e.initcodeTemplates.filter (· != dstDeclId),
                           mcopySites := e.mcopySites.push site }
              else if (← mentionsYulBufferIdent refs args[0]!) ||
                  (← mentionsYulBufferIdent refs args[1]!) then
                failAt expr ("Yul mcopy with a byte buffer requires both destination and " ++
                  "source to be byte-buffer payload addresses (at least 0x20 past the buffer " ++
                  "pointer)")
              else
                failAt expr ("Yul mcopy is supported only for a zero size, or a literal range " ++
                  "inside the scratch words below 0x40 whose source bytes this Yul block " ++
                  "wrote on every path")
        else
          failAt stmt s!"unsupported Yul expression statement {fname} (unsupported statement InlineAssembly)"
    | "YulIf" =>
        -- Yul runs the body exactly when the condition word is nonzero. The body may not run,
        -- so its scratch writes do not count as written after the `if`.
        let condVal ← lowerYul (← mField stmt "condition")
        let bodyNode ← mField stmt "body"
        let bodyStmts ← mArr (← mField bodyNode "statements")
        let before ← get
        let bodyOut ← lowerYulStmtSlice j bodyStmts refs retName atRootAbiExit
        modify fun e =>
          { e with yulScratch0 := before.yulScratch0,
                   yulScratch32 := before.yulScratch32,
                   yulWrittenBytes := before.yulWrittenBytes,
                   yulBufCursors := before.yulBufCursors,
                   yulDeclaredNames := before.yulDeclaredNames,
                   yulCursorOnlyNames := before.yulCursorOnlyNames }
        out := out ++ condVal.pre |>.push (.ite (.logicalNot (.eq condVal.expr (.literal 0))) bodyOut.toList [])
    | kind => failAt stmt s!"unsupported Yul statement {kind}"
  if zeroSlotDirty then
    failAt j "inline assembly must restore the zero slot at 0x60 to zero before it ends"
  if freePointerDirty then
    failAt j "inline assembly must restore the free-memory pointer at 0x40 before it ends"
  pure out

private partial def lowerAssemblyStmts (j : Json) (retName : String) (atRootAbiExit := false) : M (Array Stmt) := do
  let assignedInAsm := bodyAssignedIds j
  if !assignedInAsm.isEmpty then
    modify fun e => { e with zeroInitLocals := e.zeroInitLocals.filter (!assignedInAsm.contains ·) }
  let ast ← mField j "AST"
  unless (← mKind ast) == "YulBlock" do failAt j "assembly is not a Yul block"
  let stmts ← mArr (← mField ast "statements")
  let refs ← mArr (← mField j "externalReferences")
  let savedYulNames := (← get).yulNames
  let savedScratch0 := (← get).yulScratch0
  let savedScratch32 := (← get).yulScratch32
  let savedWritten := (← get).yulWrittenBytes
  let savedCursors := (← get).yulBufCursors
  let savedDeclared := (← get).yulDeclaredNames
  let savedCursorOnly := (← get).yulCursorOnlyNames
  modify fun e =>
    { e with yulScratch0 := false, yulScratch32 := false, yulWrittenBytes := 0,
             yulBufCursors := RBMap.empty, yulDeclaredNames := #[], yulCursorOnlyNames := #[] }
  if let some shrinkRes := Lowering.checkYulArrayLengthShrink? j (← get) then
    modify fun e =>
      { e with yulNames := savedYulNames, yulScratch0 := savedScratch0,
               yulScratch32 := savedScratch32, yulWrittenBytes := savedWritten,
               yulBufCursors := savedCursors, yulDeclaredNames := savedDeclared,
               yulCursorOnlyNames := savedCursorOnly }
    match shrinkRes with
    | .error (errNode, errMsg) => failAt errNode errMsg
    | .ok (arr, lenExpr, readBinding?) =>
        if let some b := readBinding? then
          let lenNode := ((((field? stmts[0]! "expression").bind (field? · "arguments")).bind
            (·.getArr?.toOption)).bind (·[1]?)).getD j
          modify fun e => { e with yulBindingReadSites := e.yulBindingReadSites.push (b, lenNode) }
        let newLenBinding ← fresh
        return #[
          .letVar newLenBinding lenExpr,
          .mstore (.localVar arr.memoryPointer) (.localVar newLenBinding),
          .assignVar arr.lengthBinding (.localVar newLenBinding)
        ]
  if let some prefixStmts ← lowerYulPrefixKeccakBlock? j stmts refs retName then
    modify fun e =>
      { e with yulNames := savedYulNames, yulScratch0 := savedScratch0,
               yulScratch32 := savedScratch32, yulWrittenBytes := savedWritten,
               yulBufCursors := savedCursors, yulDeclaredNames := savedDeclared,
               yulCursorOnlyNames := savedCursorOnly }
    return prefixStmts
  let out ← lowerYulStmtSlice j stmts refs retName atRootAbiExit
  modify fun e =>
    { e with yulNames := savedYulNames, yulScratch0 := savedScratch0,
             yulScratch32 := savedScratch32, yulWrittenBytes := savedWritten,
             yulBufCursors := savedCursors, yulDeclaredNames := savedDeclared,
             yulCursorOnlyNames := savedCursorOnly }
  pure out

private partial def lowerTailScratchReturnAssembly? (j : Json) : M (Option (Array Stmt)) := do
  let ast ← mField j "AST"
  if (← mKind ast) != "YulBlock" then return none
  let stmts ← mArr (← mField ast "statements")
  if stmts.size < 2 then return none
  let last := stmts.back!
  if (← mKind last) != "YulExpressionStatement" then return none
  let expr ← mField last "expression"
  if (← mKind expr) != "YulFunctionCall" then return none
  let fnNode ← mField expr "functionName"
  if (← mKind fnNode) != "YulIdentifier" || optStr fnNode "name" != some "return" then return none
  let args ← mArr (← mField expr "arguments")
  unless args.size == 2 do return none
  unless (← yulNatLit? args[0]!) == some 0 && (← yulNatLit? args[1]!) == some 32 do return none
  let assignedInAsm := bodyAssignedIds j
  if !assignedInAsm.isEmpty then
    modify fun e => { e with zeroInitLocals := e.zeroInitLocals.filter (!assignedInAsm.contains ·) }
  let refs ← mArr (← mField j "externalReferences")
  let savedYulNames := (← get).yulNames
  let savedScratch0 := (← get).yulScratch0
  let savedScratch32 := (← get).yulScratch32
  let savedWritten := (← get).yulWrittenBytes
  let savedCursors := (← get).yulBufCursors
  let savedDeclared := (← get).yulDeclaredNames
  let savedCursorOnly := (← get).yulCursorOnlyNames
  modify fun e =>
    { e with yulScratch0 := false, yulScratch32 := false, yulWrittenBytes := 0,
             yulBufCursors := RBMap.empty, yulDeclaredNames := #[], yulCursorOnlyNames := #[] }
  let prefixStmts ← lowerYulStmtSlice j stmts.pop refs ""
  let wroteScratch0 := (← get).yulScratch0
  modify fun e =>
    { e with yulNames := savedYulNames, yulScratch0 := savedScratch0,
             yulScratch32 := savedScratch32, yulWrittenBytes := savedWritten,
             yulBufCursors := savedCursors, yulDeclaredNames := savedDeclared,
             yulCursorOnlyNames := savedCursorOnly }
  unless wroteScratch0 do
    failAt last "Yul return(0, 32) requires a preceding scratch write at offset 0"
  return some (prefixStmts.push (.returnValues [.mload (.literal 0)]))

private def isMsgDataNode (j : Json) : M Bool := do
  if (← mKind j) != "MemberAccess" then return false
  unless optStr j "memberName" == some "data" do return false
  let base ← mField j "expression"
  if (← mKind base) != "Identifier" || optStr base "name" != some "msg" then return false
  unless (← refInt base) == -15 do
    failAt base "msg does not resolve to the transaction builtin"
  return true

private def argumentAt (call : Json) (i : Nat) : M Json := do
  -- `i` counts the receiver plus explicit arguments. The receiver is not in
  -- `arguments` when the call is `using for`.
  let kind ← mKind call
  if kind == "BinaryOperation" then
    if i == 0 then return ← mField call "leftExpression"
    else if i == 1 then return ← mField call "rightExpression"
    else failAt call s!"unexpected binary operator argument index {i}"
  if kind == "UnaryOperation" then
    if i == 0 then return ← mField call "subExpression"
    else failAt call s!"unexpected unary operator argument index {i}"
  let callee ← mField call "expression"
  let args ← mArr (← mField call "arguments")
  let hasReceiver ← match ← mKind callee with
    | "MemberAccess" =>
        let base ← mField callee "expression"
        let baseTy ← mType base
        pure !(baseTy.startsWith "type(library " || baseTy.startsWith "type(contract ")
    | _ => pure false
  if hasReceiver then
    if i == 0 then mField callee "expression" else pure args[i - 1]!
  else
    pure args[i]!

private def convert (paramTy argTy : String) (v : Val) (at_ : Json) : M Val := do
  let argTy := if argTy.endsWith " storage ref" then (argTy.dropEnd 12).toString else argTy
  if argTy == paramTy then return v
  let addressLike (ty : String) := ty == "address" || ty == "address payable" || ty.startsWith "contract "
  if !(← get).viaIR && addressLike argTy && addressLike paramTy then return v
  let v := { v with expr := cleanHelperResultExpr argTy v }
  -- A string literal reaches here already lowered to its left-aligned word by
  -- `fixedBytesStringLiteral?` (`lowerExpr` rejects string literals).
  if argTy.startsWith "literal_string " && (fixedBytesWidth? paramTy).isSome then
    if v.pre.isEmpty then
      if let .literal _ := v.expr then return v
    failAt at_ s!"unsupported implicit conversion from {argTy} to {paramTy}"
  -- `bytesN` values are left-aligned words with zero low bytes, so widening
  -- `bytesN` to `bytesM` (N ≤ M) keeps the word, as the explicit cast does.
  if let some pw := fixedBytesWidth? paramTy then
    if let some aw := fixedBytesWidth? argTy then
      if aw ≤ pw then return v
      else failAt at_ s!"implicit narrowing from {argTy} to {paramTy}"
  if let some pb := signedBitsOf paramTy then
    if argTy.startsWith "int_const" then
      return v
    if let some sb := signedBitsOf argTy then
      if sb ≤ pb then return v
      else failAt at_ s!"implicit narrowing from {argTy} to {paramTy}"
    if argTy.startsWith "uint" then
      if let some sb := bitsOf argTy then
        if sb < pb then return v
    failAt at_ s!"unsupported implicit conversion from {argTy} to {paramTy}"
  if (paramTy == "address" || paramTy == "address payable" || paramTy.startsWith "contract ") &&
      (argTy == "address" || argTy == "address payable" || argTy.startsWith "contract ") then
    return v
  if paramTy.startsWith "uint" && argTy.startsWith "uint" then
    match bitsOf paramTy, bitsOf argTy with
    | some pb, some sb =>
        if sb ≤ pb then return v
        else failAt at_ s!"implicit narrowing from {argTy} to {paramTy}"
    | _, _ => failAt at_ s!"unsupported implicit conversion from {argTy} to {paramTy}"
  if let some bw := fixedBytesWidth? paramTy then
    if bw < 32 && argTy.startsWith "int_const" && !argTy.startsWith "int_const -" then
      let .literal n := v.expr
        | failAt at_ s!"unsupported implicit conversion from {argTy} to {paramTy}"
      let raw := optStr at_ "value" |>.getD ""
      let hexDigits := ((raw.drop 2).toString.splitOn "_").foldl (· ++ ·) ""
      unless v.pre.isEmpty && n < 2 ^ (8 * bw) &&
          (n == 0 || (raw.startsWith "0x" && hexDigits.length == 2 * bw)) do
        failAt at_ s!"unsupported implicit conversion from {argTy} to {paramTy}"
      return { pre := #[], expr := .literal (n * 16 ^ (2 * (32 - bw))) }
  if argTy.startsWith "int_const" && !argTy.startsWith "int_const -" && !paramTy.startsWith "enum " && (bitsOf paramTy).isSome then
    return v
  failAt at_ s!"unsupported implicit conversion from {argTy} to {paramTy}"

private partial def stmtContainsPlaceholder (s : Json) : M Bool := do
  match ← mKind s with
  | "PlaceholderStatement" => pure true
  | "Block" | "UncheckedBlock" =>
      let stmts ← mArr (← mField s "statements")
      stmts.anyM stmtContainsPlaceholder
  | "IfStatement" =>
      let yes ← stmtContainsPlaceholder (← mField s "trueBody")
      let no ← match field? s "falseBody" with
        | some j => if j.isNull then pure false else stmtContainsPlaceholder j
        | none => pure false
      pure (yes || no)
  | "ForStatement" =>
      stmtContainsPlaceholder (← mField s "body")
  | _ => pure false

/-- Syntactic definite revert: every path through `s` unconditionally reverts,
    including calls to builtin `revert(...)` and resolved internal/private helpers
    whose bodies unconditionally revert. -/
private partial def stmtAlwaysReverts (visited : List Nat) (s : Json) : M Bool := do
  match ← mKind s with
  | "RevertStatement" => pure true
  | "InlineAssembly" =>
      let ast := field? s "AST" |>.getD Json.null
      if optStr ast "nodeType" != some "YulBlock" then return false
      let stmts := match field? ast "statements" with
        | some (.arr xs) => xs
        | _ => #[]
      let some last := stmts.back? | return false
      if optStr last "nodeType" != some "YulExpressionStatement" then return false
      let expr := field? last "expression" |>.getD Json.null
      if optStr expr "nodeType" != some "YulFunctionCall" then return false
      let fn := field? expr "functionName" |>.getD Json.null
      pure (optStr fn "nodeType" == some "YulIdentifier" && optStr fn "name" == some "revert")
  | "Block" | "UncheckedBlock" =>
      let stmts ← mArr (← mField s "statements")
      stmts.anyM (stmtAlwaysReverts visited)
  | "IfStatement" =>
      let yes ← stmtAlwaysReverts visited (← mField s "trueBody")
      let no ← match field? s "falseBody" with
        | some j => if j.isNull then pure false else stmtAlwaysReverts visited j
        | none => pure false
      pure (yes && no)
  | "ExpressionStatement" =>
      let expr := field? s "expression" |>.getD Json.null
      unless optStr expr "nodeType" == some "FunctionCall" && optStr expr "kind" == some "functionCall" do
        return false
      let callee := field? expr "expression" |>.getD Json.null
      -- A DELEGATECALL runs the linked library's code, which this body does not describe.
      if isLibraryDelegateCall callee then return false
      let calleeKind := optStr callee "nodeType"
      if calleeKind == some "Identifier" && optStr callee "name" == some "revert" then
        return (field? callee "referencedDeclaration").bind (fun v => v.getInt?.toOption) == some (-19)
      let some refId := (field? callee "referencedDeclaration").bind (fun v => v.getInt?.toOption)
        | return false
      unless refId ≥ 0 do return false
      let env ← get
      let targetId? : Option Nat ← do
        if calleeKind == some "Identifier" then
          match env.funContractId.find? refId.toNat with
          | some cid =>
              if env.linearizedBases.contains cid then
                pure (resolveInContracts env env.linearizedBases.toList refId.toNat)
              else
                pure (some refId.toNat)
          | none => pure (some refId.toNat)
        else if calleeKind == some "MemberAccess" then
          let base := field? callee "expression" |>.getD Json.null
          let baseTy ← mType base
          if baseTy.startsWith "type(library " then
            pure (some refId.toNat)
          else if baseTy.startsWith "type(contract super " then
            pure (effectCallTarget? env visited callee refId.toNat)
          else if baseTy.startsWith "type(contract " then
            pure (some refId.toNat)
          else
            match env.funContractId.find? refId.toNat with
            | some cid =>
                if env.contractKinds.find? cid == some "library" then pure (some refId.toNat)
                else pure none
            | none => pure none
        else
          pure none
      let some targetId := targetId? | return false
      if visited.contains targetId then return false
      let some fn := env.funs.find? targetId | return false
      let vis := optStr fn "visibility" |>.getD ""
      unless vis == "internal" || vis == "private" || vis == "public" do return false
      let some body := (field? fn "body").filter (!·.isNull) | return false
      stmtAlwaysReverts (targetId :: visited) body
  | _ => pure false

/-- Syntactic definite return: every path through `s` ends in a helper result.
    Assembly results count because `lowerHelperFrom` treats them as results. -/
private partial def helperReturns (s : Json) : M Bool := do
  match ← mKind s with
  | "Return" | "RevertStatement" => pure true
  | "InlineAssembly" => pure (← get).helperResult.isNone
  | "Block" | "UncheckedBlock" => ((← mArr (← mField s "statements")).back?.map helperReturns).getD (pure false)
  | "IfStatement" =>
      let yes ← helperReturns (← mField s "trueBody")
      let no ← match field? s "falseBody" with
        | some j => if j.isNull then pure false else helperReturns j
        | none => pure false
      pure (yes && no)
  | _ => stmtAlwaysReverts [] s

private def helperListReturns (stmts : Array Json) : M Bool := do
  match stmts.back? with
  | some s => helperReturns s
  | none => pure false

/-- Synthetic statement closing an `unchecked` helper block whose statements were
    flattened into the helper continuation, so that a returning `if` inside the
    block carries the end of the block into each copied continuation. `scope`
    indexes the block's entry in `helperBlockScopes`. -/
private def uncheckedEnd (scope : Nat) : Json :=
  Json.mkObj [("nodeType", Json.str "VerityUncheckedEnd"), ("scope", toJson scope)]

/-- Synthetic statement closing a helper scope whose statements are lowered in front of the
    continuation after it: an `if` branch that falls through while the other branch returns,
    or a plain block flattened by a string or array helper. It restores the name-keyed scope
    recorded in `helperBlockScopes` at index `scope` (the scope before the `if` or block) and
    carries the source range of that `if` or block, so diagnostics stay located. -/
private def scopeEnd (scope : Nat) (node : Json) : Json :=
  Json.mkObj [("nodeType", Json.str "VerityScopeEnd"), ("scope", toJson scope),
    ("src", (field? node "src").getD Json.null)]

/-- Records the current name-keyed scope in `helperBlockScopes` and returns the
    `scopeEnd` marker that restores it. -/
private def pushScopeEnd (node : Json) : M Json := do
  let e ← get
  let scope := (e.yulNames, e.yulMemoryArrays, e.yulMemoryStructs)
  set { e with helperBlockScopes := e.helperBlockScopes.push scope }
  pure (scopeEnd e.helperBlockScopes.size node)

/-- Restores the name-keyed scope a `scopeEnd` marker names; fails closed when the
    scope was not recorded. -/
private def restoreScopeEnd (marker : Json) : M Unit := do
  let some (yulNames, yulMemoryArrays, yulMemoryStructs) :=
      (← get).helperBlockScopes[(← mNat (← mField marker "scope"))]?
    | failAt marker "helper scope end without a recorded scope"
  modify fun e => { e with yulNames, yulMemoryArrays, yulMemoryStructs }

private def readAbiDecodeWord (fromCalldata : Bool) (addr : Expr) : Expr :=
  if fromCalldata then
    .calldataload addr
  else
    let rem := Expr.bitAnd addr (.literal 31)
    let aligned := Expr.bitAnd addr (.bitNot (.literal 31))
    let shiftBits := Expr.mul rem (.literal 8)
    .bitOr
      (.shl shiftBits (.mload aligned))
      (.shr (.sub (.literal 256) shiftBits) (.mload (.add aligned (.literal 32))))

private def abiDecodeScalarGuard? (ty : String) (enumBound? : Option Nat) (word : Expr) : Option Stmt :=
  if ty == "uint256" || ty == "uint" || ty == "int256" || ty == "int" || ty == "bytes32" then
    none
  else if ty == "bool" then
    some (AbiLowering.guard (.lt word (.literal 2)))
  else if ty == "address" || ty == "address payable" || ty.startsWith "contract " then
    some (AbiLowering.guard (.lt word (.literal (2 ^ 160))))
  else if ty == "bytes4" then
    some (AbiLowering.guard (.eq (.bitAnd word (.literal (2 ^ 224 - 1))) (.literal 0)))
  else if ty == "bytes1" then
    some (AbiLowering.guard (.eq (.bitAnd word (.literal (2 ^ 248 - 1))) (.literal 0)))
  else if ty.startsWith "enum " then
    enumBound?.map fun bound => AbiLowering.guard (.lt word (.literal bound))
  else if ty.startsWith "uint" then
    match bitsOf ty with
    | some bits =>
        if bits < 256 then some (AbiLowering.guard (.lt word (.literal (2 ^ bits)))) else none
    | none => none
  else
    none

/-- A call of the builtin `require` (solc declaration id `-18`). -/
private def isBuiltinRequireCall (node : Json) : Bool :=
  match field? node "expression" with
  | some callee =>
      optStr callee "nodeType" == some "Identifier" && optStr callee "name" == some "require" &&
        (field? callee "referencedDeclaration").bind (·.getInt?.toOption) == some (-18)
  | none => false

/-- AST ids of the function calls a statement value admits as typed-interface
staticcalls: the value itself, both operands of a short-circuit `&&`/`||` (its
lowering evaluates the right operand only in the branch Solidity selects), and
the condition of a builtin `require`, which solc evaluates before the error
arguments. Any other enclosing expression admits no call. -/
private partial def admittedInterfaceCallIds (node : Json) : List Nat :=
  match optStr node "nodeType" with
  | some "FunctionCall" =>
      if isBuiltinRequireCall node then
        match field? node "arguments" with
        | some (.arr args) => (args[0]?.map admittedInterfaceCallIds).getD []
        | _ => []
      else ((field? node "id").bind (·.getNat?.toOption)).toList
  | some "BinaryOperation" =>
      if optStr node "operator" == some "&&" || optStr node "operator" == some "||" then
        ((field? node "leftExpression").map admittedInterfaceCallIds).getD [] ++
          ((field? node "rightExpression").map admittedInterfaceCallIds).getD []
      else []
  | _ => []

/-- Run one statement lowering with the calls admitted by `node` as its only
admissible typed-interface staticcalls. Restoring the previous admission keeps
inlined helper statements from widening the enclosing statement's admission. -/
private def withAdmittedInterfaceCall (node? : Option Json) (k : M α) : M α := do
  let saved := (← get).admittedInterfaceCalls
  let admitted := (node?.map admittedInterfaceCallIds).getD []
  modify fun e => { e with admittedInterfaceCalls := admitted }
  try
    let result ← k
    modify fun e => { e with admittedInterfaceCalls := saved }
    return result
  catch error =>
    modify fun e => { e with admittedInterfaceCalls := saved }
    throw error

/-- Strip redundant parentheses (single-component, non-inline tuples). -/
private partial def unparenJson (j : Json) : Json :=
  if optStr j "nodeType" == some "TupleExpression" &&
      (field? j "isInlineArray").bind (·.getBool?.toOption) == some false then
    match field? j "components" with
    | some (.arr #[only]) => if only.isNull then j else unparenJson only
    | _ => j
  else j

/-- A function call whose callee is a member of an interface-typed receiver and
resolves to a declaration of an interface. Library and qualified base calls are
not interface members; other contract-typed receivers keep the generic
external-call rejection. -/
private def isInterfaceExternalCall (j : Json) : M Bool := do
  unless optStr j "nodeType" == some "FunctionCall" && optStr j "kind" == some "functionCall" do
    return false
  let some callee := field? j "expression" | return false
  unless optStr callee "nodeType" == some "MemberAccess" do return false
  let some baseRaw := field? callee "expression" | return false
  let base := unparenJson baseRaw
  if optStr base "nodeType" == some "Identifier" && optStr base "name" == some "this" then
    return false
  unless (← mType base).startsWith "contract " do return false
  let id ← refInt callee
  unless id ≥ 0 do return false
  let env ← get
  match env.funContractId.find? id.toNat with
  | some cid =>
      if env.contractKinds.find? cid == some "interface" then
        return true
      else if env.contractKinds.find? cid == some "contract" then
        if let some vdecl := env.stateVars.find? id.toNat then
          return optStr vdecl "visibility" == some "public" &&
            (optStr vdecl "functionSelector").isSome
        else if let some fdecl := env.funs.find? id.toNat then
          let rets ← mArr (← mField (← mField fdecl "returnParameters") "parameters")
          let isVirt := (field? fdecl "virtual").bind (·.getBool?.toOption) == some true
          let isNonpayable := optStr fdecl "stateMutability" == some "nonpayable"
          return (isVirt || isNonpayable) && rets.size ≤ 1
        else
          return false
      else
        return false
  | none => return false

/-- An internal function or internal function pointer (`t_function_internal_*`); events,
errors, builtins and external functions have other type identifiers. -/
private def internalFunctionTyped (j : Json) : Bool :=
  ((field? j "typeDescriptions").bind (optStr · "typeIdentifier")).any
    (·.startsWith "t_function_internal")

/-- Whether the callee of a call is a `DELEGATECALL` into a linked library that this import
inlines. Without `Profile.linkedLibrariesMatchSource` every such callee is rejected
(`externalLibraryCallDiagnostic`). With it, only a direct `L.f(...)` call of an implemented
`public` or `external` function of library `L` is admitted, when every parameter is a value
type, a `storage` reference or `bytes memory`, every result is a value type or `bytes memory`,
and nothing `f` reaches depends on the `DELEGATECALL` frame (`linkedLibraryFrameHazard?`);
everything else is rejected at its source location. An admitted call is recorded for the current
root's report and returns `true`; a callee of any other type returns `false`. -/
private def admitLinkedLibraryCall (callee : Json) : M Bool := do
  unless isLibraryDelegateCall callee do return false
  let env ← get
  unless env.linkedLibrariesMatchSource do failAt callee externalLibraryCallDiagnostic
  unless (← mKind callee) == "MemberAccess" do
    failAt callee "linked library calls must name the function as L.f"
  let base ← mField callee "expression"
  unless (← mType base).startsWith "type(library " do
    failAt callee "attached linked library calls (using L for T) are outside this slice"
  let id ← refInt callee
  unless id ≥ 0 do failAt callee "unresolved linked library function"
  let some fn := env.funs.find? id.toNat | failAt callee "unresolved linked library function"
  let some cid := env.funContractId.find? id.toNat
    | failAt callee "linked library function is not declared in a library"
  unless env.contractKinds.find? cid == some "library" do
    failAt callee "linked library function is not declared in a library"
  unless ["public", "external"].contains (optStr fn "visibility" |>.getD "") do
    failAt callee "linked library calls require a public or external function"
  let implemented := (field? fn "implemented").bind (·.getBool?.toOption) |>.getD true
  unless implemented && ((field? fn "body").any (!·.isNull)) do failNoBody fn callee
  for p in ← mArr (← mField (← mField fn "parameters") "parameters") do
    if linkedLibraryParamKind p == .other then
      failAt p ("linked library call parameters must be value types or storage references: " ++
        "memory, calldata and function-typed values are re-encoded by the DELEGATECALL")
  for r in ← mArr (← mField (← mField fn "returnParameters") "parameters") do
    unless linkedLibraryParamKind r == .value || linkedLibraryParamKind r == .bytesMemory do
      failAt r "linked library call results must be value types"
  if env.rootReturndataRead.isSome then
    failAt callee ("linked library calls in a function that reads Yul returndatasize are " ++
      "outside this slice: the DELEGATECALL sets the return data, the inlined model does not")
  let decl (n : Nat) : Option Json := env.funs.find? n <|> env.modifiers.find? n
  if let some (node, reason) := linkedLibraryFrameHazard? decl fn then
    failAt node reason
  let (file, site) := nodeSite env callee
  let (line, column) := match site with
    | some (line, column, _) => (line, column)
    | none => (0, 0)
  let use : LinkedLibraryCall :=
    { library := env.contractNames.find? cid |>.getD s!"library#{cid}",
      function := optStr fn "name" |>.getD "", declId := id.toNat, file, line, column }
  unless env.rootLinkedLibraryCalls.contains use do
    set { env with rootLinkedLibraryCalls := env.rootLinkedLibraryCalls.push use }
  pure true

/-- True when `call` is a `FunctionCall` whose callee is a `DELEGATECALL` to a linked library
(`isLibraryDelegateCall`). Such a call reaches `inlineFn`, `inlineVoidFn` or `inlineMultiFn`
only after `admitLinkedLibraryCall` has admitted it, and its value-type arguments and results
cross the `DELEGATECALL`'s ABI encoder and decoder. -/
private def isLinkedLibraryCallSite (call : Json) : Bool :=
  optStr call "nodeType" == some "FunctionCall" &&
    optStr call "kind" == some "functionCall" &&
    isLibraryDelegateCall ((field? call "expression").getD Json.null)

/-- A node of `j` that makes, or may make, a typed-interface call: the call itself, or a
reference to an internal function (called, or passed as a function value) whose body or
modifier invocations (arguments, and the body of every modifier of that name, which
covers overrides) reach one transitively. `seen` is the walk's frame stack, whose head is
the body being inspected, so `super` resolves from it; `clean` collects the functions and
modifiers already walked without reaching a call, so each is walked at most once. A
function-typed reference that does not resolve to a declaration (a pointer parameter or
local of a callee) is conservatively a reaching node. -/
private partial def interfaceCallIn? (clean : IO.Ref (Array Nat)) (j : Json)
    (seen : List Nat := []) : M (Option Json) := do
  if ← isInterfaceExternalCall j then return some j
  if optStr j "nodeType" == some "ModifierInvocation" then
    let env ← get
    let modId := ((field? j "modifierName").bind (field? · "referencedDeclaration")).bind
      (·.getNat?.toOption)
    let name := (modId.bind env.modifiers.find?).bind (optStr · "name")
    let mods := env.modifiers.fold (init := #[]) fun acc mid decl =>
      if some mid == modId || (name.isSome && optStr decl "name" == name) then
        acc.push (mid, decl) else acc
    for (mid, decl) in mods do
      unless seen.contains mid || (← clean.get).contains mid do
        if let some body := field? decl "body" then
          if (← interfaceCallIn? clean body (mid :: seen)).isSome then return some j
        clean.modify (·.push mid)
  let kind := optStr j "nodeType"
  -- Under `linkedLibrariesMatchSource` a linked library function's body runs in this frame
  -- (`admitLinkedLibraryCall`), so the walk follows it too.
  let linkedLibraryBody := (← get).linkedLibrariesMatchSource && isLibraryDelegateCall j
  if (kind == some "Identifier" || kind == some "MemberAccess") &&
      (internalFunctionTyped j || linkedLibraryBody) then
    if let some id := (field? j "referencedDeclaration").bind (·.getNat?.toOption) then
      let env ← get
      let targets := match env.fnPtrs.find? id with
        | some (.direct fid) => [fid]
        | some (.branch _ tFid fFid) => [tFid, fFid]
        | none => (effectCallTarget? env seen j id).toList
      let resolved := targets.filterMap fun target => (env.funs.find? target).map (target, ·)
      if resolved.isEmpty then return some j
      for (target, fn) in resolved do
        unless seen.contains target || (← clean.get).contains target do
          for part in [field? fn "body", field? fn "modifiers"] do
            if let some node := part then
              if (← interfaceCallIn? clean node (target :: seen)).isSome then return some j
          clean.modify (·.push target)
  match j with
  | .obj kvs => kvs.toList.findSomeM? fun (_, v) => interfaceCallIn? clean v seen
  | .arr xs => xs.toList.findSomeM? (interfaceCallIn? clean · seen)
  | _ => return none

/-- An assignment target whose evaluation cannot revert: an identifier, member and
mapping accesses over one whose keys are identifiers or literals, or a tuple of those.
Array elements are excluded, including memory arrays whose lowering already evaluates the
right-hand side first (conservative). -/
private partial def revertFreeAssignmentTarget (j : Json) : Bool :=
  match optStr j "nodeType" with
  | some "Identifier" => true
  | some "TupleExpression" =>
      match field? j "components" with
      | some (.arr cs) => cs.all fun c => c.isNull || revertFreeAssignmentTarget c
      | _ => false
  | some "MemberAccess" => ((field? j "expression").map revertFreeAssignmentTarget).getD false
  | some "IndexAccess" =>
      let base := (field? j "baseExpression").getD .null
      let key := (field? j "indexExpression").bind (optStr · "nodeType")
      ((field? base "typeDescriptions").bind (optStr · "typeString")).any
          (·.startsWith "mapping(") &&
        (key == some "Identifier" || key == some "Literal") && revertFreeAssignmentTarget base
  | _ => false

/-- Base of a mapping member inside a storage struct (1-key or 2-key), or a `mapping(...)
storage` parameter bound to a raw storage slot. -/
private partial def isStructMappingBase (env : Env) (j : Json) : Bool :=
  let j := unparenJson j
  match optStr j "nodeType" with
  | some "MemberAccess" =>
      ((field? j "expression").bind (field? · "typeDescriptions")
        |>.bind (optStr · "typeString")).any (·.startsWith "struct ")
  | some "IndexAccess" =>
      let outer := unparenJson ((field? j "baseExpression").getD .null)
      optStr outer "nodeType" == some "MemberAccess" &&
        ((field? outer "typeDescriptions").bind (optStr · "typeString")).any
          (·.startsWith "mapping(") &&
        isStructMappingBase env outer
  | some "Identifier" =>
      match (field? j "referencedDeclaration").bind (·.getNat?.toOption) with
      | some id => (env.paths.find? id).any fun
          | .rawSlot 0 _ => true
          | _ => false
      | none => false
  | _ => false

/-- Scalar element target `s.map[k]` of a storage-struct mapping whose lowering evaluates the
right-hand side into a temporary before the target's outer and inner key preludes. -/
private def isStructMappingElementTarget (env : Env) (j : Json) : Bool :=
  let j := unparenJson j
  if optStr j "nodeType" != some "IndexAccess" || assignmentIn j then false
  else
    let base := unparenJson ((field? j "baseExpression").getD .null)
    let baseTy := (field? base "typeDescriptions").bind (optStr · "typeString") |>.getD ""
    let valTy := (field? j "typeDescriptions").bind (optStr · "typeString") |>.getD ""
    baseTy.startsWith "mapping(" &&
      !valTy.startsWith "mapping(" && !valTy.startsWith "struct " &&
      !valTy.contains "[" && !valTy.startsWith "bytes " && !valTy.startsWith "string " &&
      isStructMappingBase env base

/-- solc evaluates an assignment's right-hand side before the target's index keys and
bounds checks on both pipelines, while the lowering evaluates the target first. A
typed-interface call can revert, so an assignment statement that makes one, directly or
through an internal callee, is admitted only when its target cannot revert
(`revertFreeAssignmentTarget`), or for a plain `=` to a scalar storage-struct mapping
element whose lowering evaluates the right-hand side first (still rejecting calls in the
target's own keys). -/
private def checkInterfaceCallAssignmentOrder (statement : Json) : M Unit := do
  let some expression := field? statement "expression" | return
  unless optStr expression "nodeType" == some "Assignment" do return
  let some target := field? expression "leftHandSide" | return
  if revertFreeAssignmentTarget target then return
  let inspected :=
    if optStr expression "operator" == some "=" && isStructMappingElementTarget (← get) target then
      target
    else expression
  if let some call ← interfaceCallIn? (← IO.mkRef #[]) inspected then
    failAt call ("typed interface staticcall in an assignment to an array element or " ++
      "computed key is unsupported: solc evaluates the right-hand side first")

/-- The declaration called by a typed external call `I(a).f(...)` when `f` has no
return values and is `nonpayable` or `payable`; such a call lowers only as a
whole expression statement. -/
private def interfaceVoidCallDecl? (j : Json) : M (Option Json) := do
  let some callee := field? j "expression" | return none
  let id ← refInt callee
  unless id ≥ 0 do return none
  let some decl := (← get).funs.find? id.toNat | return none
  let some returns := (field? decl "returnParameters").bind (field? · "parameters") | return none
  unless returns == Json.arr #[] do return none
  unless optStr decl "stateMutability" == some "nonpayable" ||
      optStr decl "stateMutability" == some "payable" do
    return none
  return some decl

/-- Located diagnostic for a low-level `.call` outside the admitted statement sequence. -/
private def lowLevelCallPlacement : String :=
  "low-level call must be a (bool success, bytes memory returndata) declaration followed by " ++
    "returndata forwarding and optional-bool validation"

/-- Return types whose single ABI word `abiDecodeScalarGuard?` validates completely (or that
need no validation), so a `try` success clause may bind them. -/
private def tryReturnTypeSupported (ty : String) : Bool :=
  ["uint256", "int256", "bytes32", "bytes4", "bytes1", "bool", "address",
    "address payable"].contains ty ||
    ty.startsWith "contract " || (ty.startsWith "uint" && (bitsOf ty).isSome)

/-- Located diagnostic for an external `try` whose catch clauses are not one admitted clause. -/
private def tryCatchClauseMessage : String :=
  "external try/catch supports exactly one catch clause: `catch { }` or " ++
    "`catch (bytes memory reason) { }`"

/-- A lowered `try` statement: the success bit as the branch condition, the two clause
bodies, and the statements each clause runs first. A setup may bind the clause's
parameters (the decoded return value, the `bytes memory` revert reason), so the caller
runs it in the clause's own scope, just before lowering the clause body. -/
private structure TryParts where
  condition : Val
  yes : Array Json
  no : Array Json
  yesSetup : M (Array Stmt) := pure #[]
  noSetup : M (Array Stmt) := pure #[]
/-- A string literal (`"…"`, `unicode"…"`, `hex"…"`) read as a `bytesN` value: its bytes
left-aligned in one word, as solc's implicit literal conversion produces. `none` when `ty`
is not `bytesN` or `j` is not such a literal. -/
private def fixedBytesStringLiteral? (ty : String) (j : Json) : M (Option Val) := do
  let some byteW := fixedBytesWidth? ty | return none
  let node := unparenJson j
  unless optStr node "nodeType" == some "Literal" do return none
  let kind := optStr node "kind" |>.getD ""
  unless kind == "string" || kind == "unicodeString" || kind == "hexString" do return none
  let hex ← mStr (← mField node "hexValue")
  unless hex.length % 2 == 0 && hex.length / 2 ≤ byteW do
    failAt j s!"{ty} string literal requires at most {byteW} bytes, found {hex.length / 2}"
  let word ← if hex.isEmpty then pure 0 else
    match Compiler.Hex.parseHexNat? ("0x" ++ hex) with
    | some n => pure n
    | none => failAt j s!"invalid {ty} literal hexValue"
  return some { pre := #[], expr := .literal (word * 16 ^ (64 - hex.length)) }

/-- The declared type of the single value a `Return` statement returns: the function on
the inlining stack whose return parameter list is the statement's
`functionReturnParameters`. -/
private def returnTargetType? (ret : Json) : M (Option String) := do
  let some listId := (field? ret "functionReturnParameters").bind (·.getNat?.toOption)
    | return none
  let env ← get
  for fnId in env.stack do
    let some fn := env.funs.find? fnId | continue
    let some rets := field? fn "returnParameters" | continue
    unless (field? rets "id").bind (·.getNat?.toOption) == some listId do continue
    let params ← mArr (← mField rets "parameters")
    if params.size == 1 then return some (← mType params[0]!)
    return none
  return none

/-- The literal a `bytes`/`string` constant initializer denotes: a string or hex literal,
possibly parenthesized or wrapped in `bytes(…)` / `string(…)` conversions (which keep the
bytes), or a named constant with such an initializer. `none` for anything else. -/
private partial def constantByteLiteral? (j : Json) (seen : List Nat := []) : M (Option Json) := do
  let node := unparenJson j
  match ← mKind node with
  | "Literal" => pure (some node)
  | "FunctionCall" =>
      unless optStr node "kind" == some "typeConversion" do return none
      unless (← mKind (← mField node "expression")) == "ElementaryTypeNameExpression" do
        return none
      let target ← mType node
      unless target == "bytes memory" || target == "string memory" do return none
      let args ← mArr (← mField node "arguments")
      unless args.size == 1 do return none
      constantByteLiteral? args[0]! seen
  | "Identifier" =>
      let id ← refInt node
      unless id ≥ 0 && !seen.contains id.toNat do return none
      let some decl := (← get).stateVars.find? id.toNat | return none
      unless (field? decl "constant").bind (·.getBool?.toOption) == some true do return none
      constantByteLiteral? (← mField decl "value") (id.toNat :: seen)
  | _ => pure none

/-- The `call` member of `target.call(...)` or `target.call{...}(...)` on an
address-typed receiver. -/
private def lowLevelCallMember? (call : Json) : M (Option Json) := do
  unless optStr call "nodeType" == some "FunctionCall" && optStr call "kind" == some "functionCall" do
    return none
  let some callee := field? call "expression" | return none
  let member := if optStr callee "nodeType" == some "FunctionCallOptions" then
      (field? callee "expression").getD Json.null else callee
  unless optStr member "nodeType" == some "MemberAccess" && optStr member "memberName" == some "call" &&
      (field? member "referencedDeclaration").isNone do
    return none
  let some base := field? member "expression" | return none
  let ty ← mType base
  return if ty == "address" || ty == "address payable" then some member else none

/-- The single `bytes` calldata argument of a value-free, option-free self-dispatch
`address(this).delegatecall(payload)`. Rejects external targets and `{gas: ...}` options. -/
private def selfDelegateCallArg? (call : Json) : M (Option Json) := do
  unless optStr call "nodeType" == some "FunctionCall" && optStr call "kind" == some "functionCall" do
    return none
  let some callee := field? call "expression" | return none
  unless optStr callee "nodeType" == some "MemberAccess" &&
      optStr callee "memberName" == some "delegatecall" &&
      (field? callee "referencedDeclaration").isNone do
    return none
  let some baseRaw := field? callee "expression" | return none
  let base := unparenJson baseRaw
  unless optStr base "nodeType" == some "FunctionCall" && optStr base "kind" == some "typeConversion" &&
      (← mType base) == "address" do
    return none
  let baseArgs ← mArr (← mField base "arguments")
  unless baseArgs.size == 1 do return none
  let thisNode := unparenJson baseArgs[0]!
  unless optStr thisNode "nodeType" == some "Identifier" && optStr thisNode "name" == some "this" &&
      (← refInt thisNode) == -28 do
    return none
  let args ← mArr (← mField call "arguments")
  unless args.size == 1 do return none
  return some args[0]!

/-- `<account>.code` on an `address`-typed account. Total on every node. -/
private def isAddressCodeAccess (node : Json) : M Bool := do
  unless optStr node "nodeType" == some "MemberAccess" && optStr node "memberName" == some "code" &&
      (field? node "referencedDeclaration").isNone do
    return false
  let some account := field? node "expression" | return false
  return ["address", "address payable"].contains (← mType account)

/-- Any Solidity (`referencedDeclaration`) or Yul (`declaration`) reference to `declId`. -/
private partial def jsonMentionsDecl (j : Json) (declId : Nat) : Bool :=
  match j with
  | .obj kvs => kvs.toList.any fun (key, value) =>
      ((key == "referencedDeclaration" || key == "declaration") &&
        value.getInt?.toOption == some (Int.ofNat declId)) || jsonMentionsDecl value declId
  | .arr items => items.any (jsonMentionsDecl · declId)
  | _ => false

/-- Arguments of the Yul builtin call `fname(...)`. -/
private def yulBuiltinArgs? (node : Json) (fname : String) : Option (Array Json) :=
  if optStr node "nodeType" == some "YulFunctionCall" &&
      (field? node "functionName").bind (optStr · "name") == some fname then
    match field? node "arguments" with
    | some (.arr args) => some args
    | _ => none
  else none

/-- `if (!success) { assembly { revert(add(returndata, 0x20), mload(returndata)) } }`:
the complete returndata of a failed call is the revert payload. -/
private def isReturndataForwarding (s : Json) (successId dataId : Nat) (dataName : String) :
    M Bool := do
  unless optStr s "nodeType" == some "IfStatement" do return false
  if (field? s "falseBody").any (!·.isNull) then return false
  let some condition := field? s "condition" | return false
  let condition := unparenJson condition
  unless optStr condition "nodeType" == some "UnaryOperation" && optStr condition "operator" == some "!" do
    return false
  let some operand := field? condition "subExpression" | return false
  let operand := unparenJson operand
  unless optStr operand "nodeType" == some "Identifier" &&
      (field? operand "referencedDeclaration").bind (·.getNat?.toOption) == some successId do
    return false
  let some body := field? s "trueBody" | return false
  let assembly := if optStr body "nodeType" == some "Block" then
      match field? body "statements" with
      | some (.arr #[only]) => only
      | _ => Json.null
    else body
  unless optStr assembly "nodeType" == some "InlineAssembly" do return false
  let some (.arr references) := field? assembly "externalReferences" | return false
  unless references.all (fun r => (field? r "declaration").bind (·.getNat?.toOption) == some dataId) do
    return false
  let some (.arr #[statement]) := (field? assembly "AST").bind (field? · "statements") | return false
  unless optStr statement "nodeType" == some "YulExpressionStatement" do return false
  let some #[offset, size] := (field? statement "expression").bind (yulBuiltinArgs? · "revert")
    | return false
  let some #[left, right] := yulBuiltinArgs? offset "add" | return false
  let isData := fun (node : Json) =>
    optStr node "nodeType" == some "YulIdentifier" && optStr node "name" == some dataName
  let offsetOk ←
    if isData left then pure ((← yulNumber? right) == some 32)
    else if isData right then pure ((← yulNumber? left) == some 32)
    else pure false
  let some #[length] := yulBuiltinArgs? size "mload" | return false
  return offsetOk && isData length

/-- `require(returndata.length == 0 || abi.decode(returndata, (bool)), reason)`:
the optional-bool validation of the returndata of a successful call. -/
private def isOptionalBoolValidation (s : Json) (dataId : Nat) : M Bool := do
  let isData := fun (node : Json) =>
    let node := unparenJson node
    optStr node "nodeType" == some "Identifier" &&
      (field? node "referencedDeclaration").bind (·.getNat?.toOption) == some dataId
  unless optStr s "nodeType" == some "ExpressionStatement" do return false
  let some call := field? s "expression" | return false
  unless optStr call "nodeType" == some "FunctionCall" && optStr call "kind" == some "functionCall" do
    return false
  let some callee := field? call "expression" | return false
  unless optStr callee "nodeType" == some "Identifier" && optStr callee "name" == some "require" do
    return false
  let some (.arr #[condition, _]) := field? call "arguments" | return false
  let condition := unparenJson condition
  unless optStr condition "nodeType" == some "BinaryOperation" &&
      optStr condition "operator" == some "||" do
    return false
  let some left := (field? condition "leftExpression").map unparenJson | return false
  let some right := (field? condition "rightExpression").map unparenJson | return false
  unless optStr left "nodeType" == some "BinaryOperation" && optStr left "operator" == some "==" do
    return false
  let some length := (field? left "leftExpression").map unparenJson | return false
  let some zero := (field? left "rightExpression").map unparenJson | return false
  unless optStr length "nodeType" == some "MemberAccess" && optStr length "memberName" == some "length" &&
      (field? length "expression").any isData do
    return false
  unless optStr zero "nodeType" == some "Literal" && optStr zero "kind" == some "number" &&
      optStr zero "value" == some "0" do
    return false
  unless optStr right "nodeType" == some "FunctionCall" && optStr right "kind" == some "functionCall" do
    return false
  let some decode := field? right "expression" | return false
  unless optStr decode "nodeType" == some "MemberAccess" && optStr decode "memberName" == some "decode" do
    return false
  let some abi := field? decode "expression" | return false
  unless optStr abi "nodeType" == some "Identifier" && optStr abi "name" == some "abi" &&
      (field? abi "referencedDeclaration").bind (·.getInt?.toOption) == some (-1) do
    return false
  let some (.arr #[data, types]) := field? right "arguments" | return false
  unless isData data do return false
  let typeNode := match field? types "components" with
    | some (.arr #[only]) => only
    | _ => types
  return optStr typeNode "nodeType" == some "ElementaryTypeNameExpression" &&
    (field? typeNode "typeName").bind (optStr · "name") == some "bool"

/-- `abi.encodeCall(f, (args...))` of an external function whose parameters are
all full-word static types: its selector, parameters and argument expressions. -/
private def lowLevelEncodeCallParts (init : Json) : M (Nat × Array Json × Array Json) := do
  let unsupported := "low-level call data must be abi.encodeCall of an external function " ++
    "with address, bool, bytes32 or uint256 parameters"
  let args ← mArr (← mField init "arguments")
  let some encoded := args[0]? | failAt init "low-level call takes one calldata argument"
  unless args.size == 1 do failAt init "low-level call takes one calldata argument"
  unless optStr encoded "nodeType" == some "FunctionCall" && optStr encoded "kind" == some "functionCall" do
    failAt encoded unsupported
  let some encoder := field? encoded "expression" | failAt encoded unsupported
  unless optStr encoder "nodeType" == some "MemberAccess" && optStr encoder "memberName" == some "encodeCall" &&
      (field? encoder "expression").bind (optStr · "name") == some "abi" do
    failAt encoded unsupported
  unless (← refInt (← mField encoder "expression")) == -1 do failAt encoded unsupported
  let encodedArgs ← mArr (← mField encoded "arguments")
  unless encodedArgs.size == 2 do failAt encoded unsupported
  let function := encodedArgs[0]!
  let id ← refInt function
  unless id ≥ 0 do failAt function unsupported
  let some declaration := (← get).funs.find? id.toNat
    | failAt function "unresolved low-level call function declaration"
  let some hex := optStr declaration "functionSelector"
    | failAt function "low-level call function has no functionSelector"
  unless hex.length == 8 do failAt function s!"invalid functionSelector hex length {hex.length}"
  let mut selector := 0
  for c in hex.toList do
    let some digit := Compiler.Hex.hexCharToNat? c
      | failAt function "invalid functionSelector hex digit"
    selector := selector * 16 + digit
  let params ← mArr (← mField (← mField declaration "parameters") "parameters")
  for param in params do
    let ty ← mType param
    unless ["address", "bool", "bytes32", "uint256"].contains ty do
      failAt param s!"unsupported low-level call parameter type {ty}"
  let tuple := encodedArgs[1]!
  let isTuple := optStr tuple "nodeType" == some "TupleExpression" &&
    (field? tuple "isInlineArray").bind (·.getBool?.toOption) == some false
  let components ← if isTuple then mArr (← mField tuple "components") else pure #[tuple]
  unless components.size == params.size && components.all (!·.isNull) do
    failAt tuple "low-level call arguments differ from the encoded function parameters"
  return (selector, params, components)

/-- Address of element `index` of a fixed-size memory array: `T[N] memory`
has no length word, so element `i` lives at `pointer + 32 * i`. -/
private def fixedMemElementAddr (arr : FixedMemArray) (index : Expr) : Expr :=
  match index with
  | .literal 0 => .localVar arr.pointer
  | .literal k => .add (.localVar arr.pointer) (.literal (32 * k))
  | _ => .add (.localVar arr.pointer) (.mul index (.literal 32))

/-- Solidity's `Panic(0x32)` bounds check for a fixed-size memory array index.
A constant in-range index needs no runtime guard (solc checks it statically). -/
private def fixedMemBoundsGuard (arr : FixedMemArray) (index : Expr) : Array Stmt :=
  match index with
  | .literal k => if k < arr.length then #[] else #[.panicCode (.literal 0x32)]
  | _ => #[.ite (.lt index (.literal arr.length)) [] [.panicCode (.literal 0x32)]]

/-- Reserve `length` words at the free memory pointer into `ptr` (solc's
`allocate_memory`, including its `Panic(0x41)` guard); the words are not
initialized. -/
private def fixedMemAllocate (ptr next : String) (length : Nat) : Array Stmt := #[
  .letVar ptr (.mload (.literal 64)),
  .letVar next (.add (.localVar ptr) (.literal (32 * length))),
  .ite (.le (.localVar next) (.literal (2 ^ 64 - 1))) [] [.panicCode (.literal 0x41)],
  .ite (.ge (.localVar next) (.localVar ptr)) [] [.panicCode (.literal 0x41)],
  .mstore (.literal 64) (.localVar next)]

/-- A fresh `T[N] memory` value from its declared type (`fixedMemArrayType?`). -/
private def freshFixedMemArray (hint : String)
    (ty : String × ParamType × SolidityAbi.ScalarKind × Nat) : M FixedMemArray := do
  let (elementType, modelElementType, abiKind, length) := ty
  let pointer ← if hint == "" then fresh else freshFor hint
  pure { pointer, length, elementType, modelElementType, abiKind }

/-- solc's `allocate_and_zero_memory_array` for `T[N] memory`: the default
value of a local, a named or unnamed helper result, and `delete x`. -/
private def allocateZeroedFixedMemArray (hint : String)
    (ty : String × ParamType × SolidityAbi.ScalarKind × Nat) :
    M (Array Stmt × FixedMemArray) := do
  let arr ← freshFixedMemArray hint ty
  let next ← fresh
  let index ← fresh
  modify fun e => { e with encodingMemory := true }
  let zero := Stmt.forEach index (.literal arr.length)
    [.mstore (fixedMemElementAddr arr (.localVar index)) (.literal 0)]
  pure ((fixedMemAllocate arr.pointer next arr.length).push zero, arr)

/-- Whether a `uintN` for loop counter (`N = counterBits`) can reach `2^N - 1` below the
bound: the bound is neither a literal below `2^N` nor of an unsigned type of at most N bits. -/
private def narrowCounterMayWrap (counterBits : Nat) (bound : Val) (boundNode : Json) :
    M Bool := do
  if counterBits ≥ 256 then return false
  if let .literal n := bound.expr then return n ≥ 2 ^ counterBits
  let boundTy ← mType boundNode
  match (if boundTy.startsWith "uint" then bitsOf boundTy else none) with
  | some bits => pure (bits > counterBits)
  | none => pure true
/-- Clears the trailing `(32 - len % 32)` bytes of the last copied word when
`len` is not word-aligned, matching `solc`'s `calldatacopy` cleanup without
writing past the reserved `wordCount` words. -/
private def zeroByteBufferTail (pointer len wordCount : Expr) : M (Array Stmt) := do
  let rem ← fresh
  let lastAddr ← fresh
  let clearBits ← fresh
  return #[
    .letVar rem (.bitAnd len (.literal 31)),
    .ite (.eq (.localVar rem) (.literal 0)) [] [
      .letVar lastAddr (.add pointer (.mul (.sub wordCount (.literal 1)) (.literal 32))),
      .letVar clearBits (.mul (.literal 8) (.sub (.literal 32) (.localVar rem))),
      .mstore (.localVar lastAddr)
        (.shl (.localVar clearBits) (.shr (.localVar clearBits) (.mload (.localVar lastAddr))))
    ]
  ]

/-- Copy a byte buffer payload into a freshly reserved, 32-byte-aligned memory buffer
(length word at `headerPtr`, payload at `headerPtr + 32`, trailing bytes of the last word
cleared), modelling the ABI copy across a linked library `DELEGATECALL` boundary.
When `forReturn` is `true`, records `dataPtr` in `linkedReturnByteDataBindings` so raw
caller inline-assembly word loads (`mload(add(ret, 0x20))`) fail closed. -/
private def copyLinkedBytesBuffer (srcPtr srcLen : Expr) (fromCalldata forReturn : Bool)
    (siteNode : Json) (hint : String := "bytes_copy") : M EncodedBytes := do
  let srcVar ← fresh
  let sizeBinding ← freshFor (hint ++ "_len")
  let headerPtr ← freshFor hint
  let finish ← fresh
  let dataPtr ← fresh
  let copyIdx ← fresh
  let wordCount := Expr.div (.add (.localVar sizeBinding) (.literal 31)) (.literal 32)
  let totalBytes := Expr.add (.literal 32) (.mul (.literal 32) wordCount)
  modify fun e =>
    { e with encodingMemory := true,
             linkedBytesCopySites := if fromCalldata then e.linkedBytesCopySites
               else e.linkedBytesCopySites.push (.localVar srcVar, siteNode, e.currentFile, e.stack, true),
             linkedReturnByteDataBindings := if forReturn then
               e.linkedReturnByteDataBindings.push dataPtr else e.linkedReturnByteDataBindings }
  let alloc := AbiEncoding.reserve headerPtr finish totalBytes
  let srcWord := Expr.add (.localVar srcVar) (.mul (.localVar copyIdx) (.literal 32))
  let loaded := if fromCalldata then Expr.calldataload srcWord else Expr.mload srcWord
  let copyStmt := Stmt.forEach copyIdx wordCount
    [.mstore (.add (.localVar dataPtr) (.mul (.localVar copyIdx) (.literal 32))) loaded]
  let tailClear ← zeroByteBufferTail (.localVar dataPtr) (.localVar sizeBinding) wordCount
  let headStmts : Array Stmt := #[
    .letVar srcVar srcPtr,
    .letVar sizeBinding srcLen,
    .ite (.le (.localVar sizeBinding) (.literal (2 ^ 64 - 1))) [] [.panicCode (.literal 0x41)]
  ]
  let midStmts : Array Stmt := #[
    .letVar dataPtr (.add (.localVar headerPtr) (.literal 32)),
    .mstore (.localVar headerPtr) (.localVar sizeBinding),
    copyStmt
  ]
  return { pre := headStmts ++ alloc.toArray ++ midStmts ++ tailClear,
           pointer := .localVar dataPtr, size := .localVar sizeBinding, ownedFresh := true }

/-- The byte buffer of a `bytes` descriptor: its memory payload, or a word
copy of its calldata payload into fresh memory. -/
private def calldataBytesBuffer (cb : CalldataBytesParam) : M EncodedBytes := do
  if cb.inMemory then
    return { pre := #[], pointer := .add (.localVar cb.memoryPointer) (.literal 32), size := .localVar cb.lengthBinding }
  let pointer ← fresh
  let finish ← fresh
  let copyIdx ← fresh
  let wordCount := Expr.div (.add (.localVar cb.lengthBinding) (.literal 31)) (.literal 32)
  modify fun e => { e with encodingMemory := true }
  let alloc := AbiEncoding.reserve pointer finish (.mul (.literal 32) wordCount)
  let copyStmt := Stmt.forEach copyIdx wordCount
    [.mstore (.add (.localVar pointer) (.mul (.localVar copyIdx) (.literal 32)))
      (.calldataload (.add (.localVar cb.dataBinding) (.mul (.localVar copyIdx) (.literal 32))))]
  let tailClear ← zeroByteBufferTail (.localVar pointer) (.localVar cb.lengthBinding) wordCount
  return { pre := (alloc ++ [copyStmt]).toArray ++ tailClear, pointer := .localVar pointer, size := .localVar cb.lengthBinding }

/-- Struct declaration id of the elements of the struct-array member
`memberIndex` of the ABI root `mem`: recorded for a root `S[]` parameter
(`rootArrayStructId`), else the base type of the parent struct's member. -/
private def abiElementStructId (mem : MemParam) (memberIndex : Nat) (node : Json) : M Int := do
  if mem.rootArrayWord == some memberIndex then
    let some sid := mem.rootArrayStructId | failAt node "unknown root array element struct"
    return sid
  let some parentDecl := (← get).structs.find? mem.structId
    | failAt node "unknown parent struct"
  let parentMembers ← mArr (← mField parentDecl "members")
  let some memberNode := parentMembers[memberIndex]?
    | failAt node "missing parent struct member"
  refInt (← mField (← mField memberNode "typeName") "baseType")

/-- For a node of type `S[] memory` (a one-level dynamic memory array of a
struct `S`, read from solc's `typeIdentifier`, never from the struct's name):
the declaration id of `S` and its member fields, if every member is a scalar
`AbiSchema.scalarField` admits. A struct with any other member is rejected at
`node`, since its element layout would not be one scalar word per member. -/
private def structMemArrayOf? (node : Json) : M (Option (Nat × List AbiSchema.ScalarField)) := do
  let some tid := (field? node "typeDescriptions").bind (optStr · "typeIdentifier") | return none
  let pfx := "t_array$_t_struct$_"
  let sfx := "_memory_ptr_$dyn_memory_ptr"
  unless tid.startsWith pfx && tid.endsWith sfx do return none
  let core := (tid.dropEnd sfx.length).toString
  -- The outer prefix already requires a struct base, not an array. The
  -- declaration name itself may contain `t_array`.
  let some digits := (core.splitOn "_$").getLast? | return none
  let some sid := digits.toNat? | return none
  let some decl := (← get).structs.find? sid | return none
  let members ← mArr (← mField decl "members")
  if members.isEmpty then failAt node "memory arrays of empty structs are outside this slice"
  let enums := (← get).enums
  match members.toList.mapM (AbiSchema.scalarField · (fun id => (enums.find? id).map (·.size))) with
  | .ok fields => return some (sid, fields)
  | .error _ =>
      failAt node "memory struct arrays require a struct whose members are unsigned scalars, address, bool or bytes32"

/-- solc's `allocate_and_zero_memory_struct`: `words` fresh words at the free
pointer (`Panic(0x41)` guards as `allocate_memory`), each stored zero. -/
private def zeroedStructAlloc (ptr finish : String) (words : Nat) : List Stmt :=
  AbiEncoding.reserve ptr finish (.literal (32 * words)) ++
    (List.range words).map fun i => Stmt.mstore (.add (.localVar ptr) (.literal (32 * i))) (.literal 0)

/-- The `elementType` tag of an `S[] memory` descriptor: not a Solidity type,
so scalar conversions and encodings of the element fail rather than treat a
struct pointer as a value. -/
private def structMemArrayTag (sid : Nat) : String := s!"memory struct #{sid}"

/-- The element kind of a dynamic memory array node: a scalar `T[]`
(`scalarArrayElement?`) or `S[]` of a flat scalar struct (`structMemArrayOf?`),
whose words are struct pointers (`uint256` model words, `elemStructId`). -/
private def memArrayElementOf? (node : Json) :
    M (Option (String × ParamType × SolidityAbi.ScalarKind × Option (Nat × List AbiSchema.ScalarField))) := do
  if let some (elem, pty, kind) := scalarArrayElement? (← mType node) then
    return some (elem, pty, kind, none)
  if let some (sid, fields) ← structMemArrayOf? node then
    return some (structMemArrayTag sid, .uint256, .uint ⟨31, by decide⟩, some (sid, fields))
  return none

/-- The synthetic ABI root (above every AST id) whose single `structArray`
member types the element views `.abiElement root 0 ptr true` of an `S[]
memory` descriptor: element member reads and writes use its fields, and
`abiElementStructId` its `rootArrayStructId`. Nothing lowers to the root itself. -/
private def structMemArrayElementRoot (sid : Nat) (fields : List AbiSchema.ScalarField) : M Nat := do
  let some decl := (← get).structs.find? sid | throwError "unknown struct declaration {sid}"
  let sName ← mStr (← mField decl "name")
  let rootId := 1000000000 + (← get).next
  let desc : MemParam :=
    { structId := sid, param := "", structName := sName, members := #[],
      schema := some [.structArray "" fields], rootArrayWord := some 0, rootArrayStructId := some sid }
  modify fun e => { e with next := e.next + 1, mems := e.mems.insert rootId desc }
  return rootId

/-- `m[k]` / `m[a][b]` / `arr[i]`: index accesses down to an identifier, every key a `leaf`. -/
private partial def indexedPath (leaf : Json → Bool) (n : Json) : Bool :=
  optStr n "nodeType" == some "IndexAccess" &&
    (field? n "indexExpression").any leaf &&
    (field? n "baseExpression").any (fun base =>
      optStr base "nodeType" == some "Identifier" || indexedPath leaf base)

/-- Flatten top-level `Block` / `UncheckedBlock` statements in a `while` loop body,
tagging each leaf statement with whether it executes inside an `unchecked` block. -/
private partial def flattenWhileBodyStmts (stmts : Array Json) (inUnchecked : Bool := false) :
    M (Array (Json × Bool)) := do
  let mut out : Array (Json × Bool) := #[]
  for st in stmts do
    match ← mKind st with
    | "UncheckedBlock" =>
        let inner ← mArr (← mField st "statements")
        out := out ++ (← flattenWhileBodyStmts inner true)
    | "Block" =>
        let inner ← mArr (← mField st "statements")
        out := out ++ (← flattenWhileBodyStmts inner inUnchecked)
    | _ =>
        out := out.push (st, inUnchecked)
  return out

private partial def stripParensOut (j : Json) : Json :=
  if optStr j "nodeType" == some "TupleExpression" &&
      (field? j "isInlineArray") != some (.bool true) then
    match (field? j "components").bind (·.getArr?.toOption) with
    | some #[inner] => if inner.isNull then j else stripParensOut inner
    | _ => j
  else j

private partial def unwrapBlockOut (j : Json) : Array Json :=
  match optStr j "nodeType" with
  | some "Block" | some "UncheckedBlock" =>
      (field? j "statements").bind (·.getArr?.toOption) |>.getD #[]
  | _ => #[j]

private partial def parseNatConstOut (env : Env) (j : Json) : Option Nat :=
  let j := stripParensOut j
  match optStr j "nodeType" with
  | some "Literal" =>
      if optStr j "kind" != some "number" then none
      else
        match optStr j "value" with
        | some raw =>
            let clean := (raw.splitOn "_").foldl (· ++ ·) ""
            match Compiler.Hex.parseHexNat? clean <|> clean.toNat? with
            | some n => if n < 2 ^ 256 then some n else none
            | none => none
        | none => none
  | some "FunctionCall" =>
      let ty := ((field? j "typeDescriptions").bind (optStr · "typeString")).getD ""
      if optStr j "kind" == some "typeConversion" && ty.startsWith "uint" then
        match (field? j "arguments").bind (·.getArr?.toOption) with
        | some #[arg] => parseNatConstOut env arg
        | _ => none
      else none
  | some "Identifier" =>
      match (field? j "referencedDeclaration").bind (·.getNat?.toOption) with
      | some id =>
          match env.numericConstants.find? id with
          | some decl =>
              let ty := ((field? decl "typeDescriptions").bind (optStr · "typeString")).getD ""
              if ty.startsWith "uint" && (bitsOf ty).isSome then
                (field? decl "value").bind (parseNatConstOut env)
              else none
          | none => none
      | none => none
  | _ => none

private partial def stripUintCastOut (j : Json) (minBits : Nat) : Json :=
  let j := stripParensOut j
  let ty := ((field? j "typeDescriptions").bind (optStr · "typeString")).getD ""
  if optStr j "nodeType" == some "FunctionCall" && optStr j "kind" == some "typeConversion" &&
      ty.startsWith "uint" then
    match bitsOf ty, (field? j "arguments").bind (·.getArr?.toOption) with
    | some w, some #[arg] => if w ≥ minBits then stripUintCastOut arg minBits else j
    | _, _ => j
  else j

private partial def substAstIdents (subst : Std.HashMap Nat Json) : Json → Json
  | j@(.obj kvs) =>
      if optStr j "nodeType" == some "Identifier" then
        match (field? j "referencedDeclaration").bind (·.getNat?.toOption) with
        | some id => match subst.get? id with | some repl => repl | none => j
        | none => j
      else
        Json.mkObj (kvs.toList.map fun (k, v) => (k, substAstIdents subst v))
  | .arr xs => .arr (xs.map (substAstIdents subst))
  | other => other

private partial def stmtWritesStructMember (st : Json) (structId : Nat) (member : String) : Bool :=
  match st with
  | .arr xs => xs.any (stmtWritesStructMember · structId member)
  | .obj o =>
      let kind := optStr st "nodeType"
      let op := optStr st "operator" |>.getD ""
      let lhs? :=
        if kind == some "Assignment" then field? st "leftHandSide"
        else if kind == some "UnaryOperation" && ["++", "--", "delete"].contains op then
          field? st "subExpression"
        else none
      let hit := match lhs? with
        | some lhs =>
            let isWhole := optStr lhs "nodeType" == some "Identifier" &&
              (field? lhs "referencedDeclaration").bind (·.getNat?.toOption) == some structId
            let isMember := optStr lhs "nodeType" == some "MemberAccess" &&
              optStr lhs "memberName" == some member &&
              ((field? lhs "expression").bind (fun b =>
                if optStr b "nodeType" == some "Identifier" then
                  (field? b "referencedDeclaration").bind (·.getNat?.toOption)
                else none) == some structId)
            isWhole || isMember
        | none => false
      hit || o.foldl (fun acc _ v => acc || stmtWritesStructMember v structId member) false
  | _ => false

private partial def resolveBoolHelperReturnExpr? (env : Env) (call : Json) : Option Json := do
  let call := stripParensOut call
  let ty := ((field? call "typeDescriptions").bind (optStr · "typeString")).getD ""
  guard (optStr call "nodeType" == some "FunctionCall" && optStr call "kind" == some "functionCall" && ty == "bool")
  guard (!statefulCallIn call env && !assignmentIn call)
  let callee ← field? call "expression"
  let (fnId, receiver?) ← match optStr callee "nodeType" with
    | some "Identifier" => do
        let id ← (field? callee "referencedDeclaration").bind (·.getNat?.toOption)
        let resolvedId := match env.funContractId.find? id with
          | some cid =>
              if env.linearizedBases.contains cid then
                (resolveInContracts env env.linearizedBases.toList id).getD id
              else id
          | none => id
        pure (resolvedId, none)
    | some "MemberAccess" => do
        let id ← (field? callee "referencedDeclaration").bind (·.getNat?.toOption)
        let base ← field? callee "expression"
        let baseTy := ((field? base "typeDescriptions").bind (optStr · "typeString")).getD ""
        if baseTy.startsWith "type(library " then pure (id, none)
        else if (env.funContractId.find? id).any (fun cid => env.contractKinds.find? cid == some "library") then
          pure (id, some base)
        else none
    | _ => none
  let fn ← env.funs.find? fnId
  let mods := (field? fn "modifiers").bind (·.getArr?.toOption) |>.getD #[]
  guard mods.isEmpty
  let body ← field? fn "body"
  guard (!body.isNull)
  let params ← (field? fn "parameters").bind (field? · "parameters") |>.bind (·.getArr?.toOption)
  let callArgs ← (field? call "arguments").bind (·.getArr?.toOption)
  let actuals := match receiver? with | some r => #[r] ++ callArgs | none => callArgs
  guard (actuals.size == params.size)
  let mut subst : Std.HashMap Nat Json := {}
  for (p, a) in params.zip actuals do
    let pid ← (field? p "id").bind (·.getNat?.toOption)
    subst := subst.insert pid a
  let stmts := unwrapBlockOut body
  let mut retExpr? : Option Json := none
  for st in stmts do
    match optStr st "nodeType" with
    | some "VariableDeclarationStatement" =>
        let decls := (field? st "declarations").bind (·.getArr?.toOption) |>.getD #[]
        let initVal := (field? st "initialValue").getD Json.null
        if decls.size == 1 && !decls[0]!.isNull && !initVal.isNull then
          let did ← (field? decls[0]! "id").bind (·.getNat?.toOption)
          subst := subst.insert did (substAstIdents subst initVal)
        else none
    | some "IfStatement" =>
        let tStmts := unwrapBlockOut ((field? st "trueBody").getD Json.null)
        let fBody := (field? st "falseBody").getD Json.null
        let isFalseRet := fBody.isNull && tStmts.size == 1 &&
          optStr tStmts[0]! "nodeType" == some "Return" &&
          ((field? tStmts[0]! "expression").bind (fun e =>
            if optStr e "nodeType" == some "Literal" && optStr e "value" == some "false" then some true else none)).isSome
        guard isFalseRet
    | some "Return" =>
        let e ← (field? st "expression").filter (!·.isNull)
        retExpr? := some (substAstIdents subst e)
    | _ => none
  retExpr?

private partial def extractImpliedWhileComparisons (env : Env) (e : Json) (fuel : Nat := 4) : Array Json :=
  let e := stripParensOut e
  match optStr e "nodeType" with
  | some "BinaryOperation" =>
      let op := optStr e "operator" |>.getD ""
      if op == "&&" then
        if fuel == 0 then #[]
        else
          extractImpliedWhileComparisons env ((field? e "leftExpression").getD Json.null) (fuel - 1) ++
          extractImpliedWhileComparisons env ((field? e "rightExpression").getD Json.null) (fuel - 1)
      else if ["!=", ">", "<", ">=", "<="].contains op then #[e]
      else #[]
  | some "FunctionCall" =>
      if fuel == 0 then #[]
      else match resolveBoolHelperReturnExpr? env e with
        | some inner => extractImpliedWhileComparisons env inner (fuel - 1)
        | none => #[]
  | _ => #[]

private partial def matchTargetLinearStep (env : Env) (st : Json) (isTarget : Json → Bool)
    (bits : Nat) (increasing : Bool) (inUnchecked : Bool := false) : Option (Nat × Bool) :=
  match optStr st "nodeType" with
  | some "UncheckedBlock" =>
      let stmts := (field? st "statements").bind (·.getArr?.toOption) |>.getD #[]
      if stmts.size == 1 then matchTargetLinearStep env stmts[0]! isTarget bits increasing true else none
  | some "Block" =>
      let stmts := (field? st "statements").bind (·.getArr?.toOption) |>.getD #[]
      if stmts.size == 1 then matchTargetLinearStep env stmts[0]! isTarget bits increasing inUnchecked else none
  | some "ExpressionStatement" =>
      let e := stripParensOut ((field? st "expression").getD Json.null)
      match optStr e "nodeType" with
      | some "UnaryOperation" =>
          let wantOp := if increasing then "++" else "--"
          if optStr e "operator" == some wantOp && isTarget ((field? e "subExpression").getD Json.null) then
            some (1, inUnchecked)
          else none
      | some "Assignment" =>
          if !isTarget ((field? e "leftHandSide").getD Json.null) then none
          else
            let op := optStr e "operator" |>.getD ""
            let rhs := (field? e "rightHandSide").getD Json.null
            let compoundOp := if increasing then "+=" else "-="
            if op == compoundOp then
              (parseNatConstOut env rhs).filter (· ≥ 1) |>.map (·, inUnchecked)
            else if op == "=" then
              let r := stripUintCastOut rhs bits
              let binOp := if increasing then "+" else "-"
              if optStr r "nodeType" == some "BinaryOperation" && optStr r "operator" == some binOp then
                let l := (field? r "leftExpression").getD Json.null
                let rr := (field? r "rightExpression").getD Json.null
                if isTarget l then (parseNatConstOut env rr).filter (· ≥ 1) |>.map (·, inUnchecked)
                else if increasing && isTarget rr then (parseNatConstOut env l).filter (· ≥ 1) |>.map (·, inUnchecked)
                else none
              else none
            else none
      | _ => none
  | _ => none

private partial def matchTargetLogStep (env : Env) (st : Json) (isTarget : Json → Bool) (bits : Nat) : Bool :=
  if optStr st "nodeType" != some "ExpressionStatement" then false
  else
    let e := stripParensOut ((field? st "expression").getD Json.null)
    if optStr e "nodeType" != some "Assignment" || !isTarget ((field? e "leftHandSide").getD Json.null) then false
    else
      let op := optStr e "operator" |>.getD ""
      let rhs := (field? e "rightHandSide").getD Json.null
      let isOne (n : Json) : Bool := parseNatConstOut env n == some 1
      let isPosShift (n : Json) : Bool := (parseNatConstOut env n).any (fun k => k ≥ 1 && k ≤ bits)
      let isDivGe2 (n : Json) : Bool := (parseNatConstOut env n).any (· ≥ 2)
      let isSubOne (n : Json) : Bool :=
        let r := stripUintCastOut n bits
        optStr r "nodeType" == some "BinaryOperation" && optStr r "operator" == some "-" &&
          isTarget ((field? r "leftExpression").getD Json.null) &&
          isOne ((field? r "rightExpression").getD Json.null)
      if op == ">>=" then isPosShift rhs
      else if op == "/=" then isDivGe2 rhs
      else if op == "&=" then isSubOne rhs
      else if op == "=" then
        let r := stripUintCastOut rhs bits
        if optStr r "nodeType" == some "BinaryOperation" then
          let bop := optStr r "operator" |>.getD ""
          let l := (field? r "leftExpression").getD Json.null
          let rr := (field? r "rightExpression").getD Json.null
          if bop == ">>" then isTarget l && isPosShift rr
          else if bop == "/" then isTarget l && isDivGe2 rr
          else if bop == "&" then (isTarget l && isSubOne rr) || (isTarget rr && isSubOne l)
          else false
        else false
      else false

private inductive WhileBoundPlan where
  | linear (varNode boundNode : Json) (varTy boundTy : String) (bits k : Nat) (increasing inclusive : Bool)
  | logBits (bits : Nat)
  | checkedDec (varBinding : String) (k : Nat)

private def isZeroNodeOut (env : Env) (j : Json) : Bool :=
  parseNatConstOut env j == some 0

/-- True when `base` is a single-argument `type(...)` call expression (used for `type(T).max`/`.min`). -/
private def isTypeCallExpr (base : Json) : Bool :=
  optStr base "nodeType" == some "FunctionCall" &&
    (match field? base "expression" with
     | some callee =>
         optStr callee "nodeType" == some "Identifier" && optStr callee "name" == some "type"
     | none => false) &&
    (match (field? base "arguments").bind (·.getArr?.toOption) with
     | some args => args.size == 1
     | none => false)

/-- Conservative syntactic loop-invariance check for scalar bound expressions.
Trusting unassigned identifiers in `env.values` and `.length` of memory arrays/buffers relies on
Solidity's semantics: scalar locals are passed by value and allocated memory arrays/buffers have
fixed length, so called helpers cannot mutate caller locals or memory-array lengths. -/
private partial def exprIsLoopInvariantOut (env : Env) (j body : Json) (writes : List Nat) : Bool :=
  let j := stripParensOut j
  match optStr j "nodeType" with
  | some "Literal" => true
  | some "Identifier" =>
      match (field? j "referencedDeclaration").bind (·.getNat?.toOption) with
      | some id => !writes.contains id && (env.values.contains id || env.numericConstants.contains id)
      | none => false
  | some "MemberAccess" =>
      let member := optStr j "memberName" |>.getD ""
      let base := stripParensOut ((field? j "expression").getD Json.null)
      if member == "length" then
        if optStr base "nodeType" == some "Identifier" then
          match (field? base "referencedDeclaration").bind (·.getNat?.toOption) with
          | some id => !writes.contains id &&
              (env.calldataBytes.contains id || env.scalarArrays.contains id ||
               env.fixedMemArrays.contains id || env.byteBuffers.contains id ||
               env.stringBuffers.contains id || (env.mems.find? id).any (·.rootArrayWord.isSome))
          | none => false
        else false
      else if member == "max" || member == "min" then
        isTypeCallExpr base
      else if optStr base "nodeType" == some "Identifier" &&
          ((field? base "referencedDeclaration").bind (·.getNat?.toOption)).any (fun bid =>
            env.flatStructs.contains bid && !stmtWritesStructMember body bid member) then
        true
      else
        ((field? j "referencedDeclaration").bind (·.getNat?.toOption)).any env.numericConstants.contains
  | some "BinaryOperation" =>
      let op := optStr j "operator" |>.getD ""
      ["+", "-", "*", "/", "%", "&", "|", "^", "<<", ">>"].contains op &&
        exprIsLoopInvariantOut env ((field? j "leftExpression").getD Json.null) body writes &&
        exprIsLoopInvariantOut env ((field? j "rightExpression").getD Json.null) body writes
  | some "UnaryOperation" =>
      let op := optStr j "operator" |>.getD ""
      ["~", "-"].contains op &&
        exprIsLoopInvariantOut env ((field? j "subExpression").getD Json.null) body writes
  | some "FunctionCall" =>
      optStr j "kind" == some "typeConversion" &&
        match (field? j "arguments").bind (·.getArr?.toOption) with
        | some #[arg] => exprIsLoopInvariantOut env arg body writes
        | _ => false
  | _ => false

private def findGeneralBoolWhilePlan? (env : Env) (cond body : Json)
    (flatStmts : Array (Json × Bool)) (bodyWrites : List Nat) (bodyUnchecked : Bool) :
    Option WhileBoundPlan := Id.run do
  let implied := extractImpliedWhileComparisons env cond
  let matchTarget? (node : Json) : Option ((Json → Bool) × (Json → Bool)) :=
    let node := stripParensOut node
    match optStr node "nodeType" with
    | some "Identifier" =>
        match (field? node "referencedDeclaration").bind (·.getNat?.toOption) with
        | some id =>
            if (env.writableLocals.find? id).isSome then
              some (fun x =>
                let x := stripParensOut x
                optStr x "nodeType" == some "Identifier" &&
                  (field? x "referencedDeclaration").bind (·.getNat?.toOption) == some id,
                fun st => (bodyAssignedIds st).contains id)
            else none
        | none => none
    | some "MemberAccess" =>
        let base := stripParensOut ((field? node "expression").getD Json.null)
        match optStr base "nodeType", (field? base "referencedDeclaration").bind (·.getNat?.toOption), optStr node "memberName" with
        | some "Identifier", some sId, some mName =>
            if env.flatStructs.contains sId && !env.byRefFlatStructs.contains sId then
              some (fun x =>
                let x := stripParensOut x
                optStr x "nodeType" == some "MemberAccess" && optStr x "memberName" == some mName &&
                  (field? x "expression").any (fun b =>
                    let b := stripParensOut b
                    optStr b "nodeType" == some "Identifier" &&
                      (field? b "referencedDeclaration").bind (·.getNat?.toOption) == some sId),
                fun st => stmtWritesStructMember st sId mName)
            else none
        | _, _, _ => none
    | _ => none
  for cmp in implied do
    if optStr cmp "nodeType" != some "BinaryOperation" then continue
    let cmpOp := optStr cmp "operator" |>.getD ""
    let cmpLhs := stripParensOut ((field? cmp "leftExpression").getD Json.null)
    let cmpRhs := stripParensOut ((field? cmp "rightExpression").getD Json.null)
    let candidates : List (Json × Json × Bool × Bool) := match cmpOp with
      | "<" => [(cmpLhs, cmpRhs, true, false), (cmpRhs, cmpLhs, false, false)]
      | "<=" => [(cmpLhs, cmpRhs, true, true), (cmpRhs, cmpLhs, false, true)]
      | ">" => [(cmpLhs, cmpRhs, false, false), (cmpRhs, cmpLhs, true, false)]
      | ">=" => [(cmpLhs, cmpRhs, false, true), (cmpRhs, cmpLhs, true, true)]
      | "!=" =>
          if isZeroNodeOut env cmpRhs then [(cmpLhs, cmpRhs, false, false)]
          else if isZeroNodeOut env cmpLhs then [(cmpRhs, cmpLhs, false, false)]
          else []
      | _ => []
    for (varNode, boundNode, increasing, inclusive) in candidates do
      let varTy := ((field? varNode "typeDescriptions").bind (optStr · "typeString")).getD ""
      let some bits := bitsOf varTy | continue
      if !(varTy.startsWith "uint" && bits > 0 && bits ≤ 256) then continue
      let boundTy := ((field? boundNode "typeDescriptions").bind (optStr · "typeString")).getD ""
      let boundUnsigned := (boundTy.startsWith "uint" && (bitsOf boundTy).isSome) ||
        (boundTy.startsWith "int_const" && !boundTy.startsWith "int_const -")
      if !boundUnsigned || !exprIsLoopInvariantOut env boundNode body bodyWrites then continue
      let some (isTarget, writesTarget) := matchTarget? varNode | continue
      let mut stepIdx? : Option (Nat × Nat × Bool) := none
      let mut stepCount : Nat := 0
      for idx in [:flatStmts.size] do
        let (st, stUnchk) := flatStmts[idx]!
        if let some (k, inUnchk) := matchTargetLinearStep env st isTarget bits increasing stUnchk then
          stepCount := stepCount + 1
          stepIdx? := some (idx, k, inUnchk)
      if stepCount == 1 then
        if let some (stepIdx, k, stepInUnchecked) := stepIdx? then
          let mut otherWrite := false
          for idx in [:flatStmts.size] do
            if idx != stepIdx && writesTarget flatStmts[idx]!.1 then otherWrite := true
          if !otherWrite then
            let stepUnchecked := env.unchecked || bodyUnchecked || stepInUnchecked
            let boundConst? := parseNatConstOut env boundNode
            let safeUnchk := !stepUnchecked ||
              if increasing && !inclusive then
                k == 1 && (((bitsOf boundTy).any (· ≤ bits) && boundTy.startsWith "uint") ||
                  boundConst?.any (· < 2 ^ bits))
              else if increasing && inclusive then
                boundConst?.any (fun b => b + k < 2 ^ bits)
              else if !increasing && !inclusive then
                k == 1
              else
                boundConst?.any (fun b => b ≥ k)
            if safeUnchk then
              return some (.linear varNode boundNode varTy boundTy bits k increasing inclusive)
    -- Logarithmic step (`v >>= k`, `v &= v - 1`, `v /= k`)
    let logVar? : Option Json :=
      if cmpOp == ">" then some cmpLhs
      else if cmpOp == "<" then some cmpRhs
      else if cmpOp == ">=" && (parseNatConstOut env cmpRhs).any (· ≥ 1) then some cmpLhs
      else if cmpOp == "<=" && (parseNatConstOut env cmpLhs).any (· ≥ 1) then some cmpRhs
      else if cmpOp == "!=" && isZeroNodeOut env cmpRhs then some cmpLhs
      else if cmpOp == "!=" && isZeroNodeOut env cmpLhs then some cmpRhs
      else none
    if let some logVar := logVar? then
      let varTy := ((field? logVar "typeDescriptions").bind (optStr · "typeString")).getD ""
      if let some bits := bitsOf varTy then
        if varTy.startsWith "uint" && bits > 0 && bits ≤ 256 then
          if let some (isTarget, writesTarget) := matchTarget? logVar then
            let mut stepIdx? : Option Nat := none
            let mut stepCount : Nat := 0
            for idx in [:flatStmts.size] do
              if matchTargetLogStep env flatStmts[idx]!.1 isTarget bits then
                stepCount := stepCount + 1
                stepIdx? := some idx
            if stepCount == 1 then
              if let some stepIdx := stepIdx? then
                let mut otherWrite := false
                for idx in [:flatStmts.size] do
                  if idx != stepIdx && writesTarget flatStmts[idx]!.1 then otherWrite := true
                if !otherWrite then
                  return some (.logBits bits)
  -- Checked-decrement fallback for arbitrary pure/view `bool` helper calls.
  if optStr cond "nodeType" == some "FunctionCall" && !env.unchecked && !bodyUnchecked then
    for (varId, varBinding) in env.writableLocals.toList do
      let isTarget (x : Json) : Bool :=
        let x := stripParensOut x
        optStr x "nodeType" == some "Identifier" &&
          (field? x "referencedDeclaration").bind (·.getNat?.toOption) == some varId
      let mut stepIdx? : Option (Nat × Nat × Bool) := none
      let mut stepCount : Nat := 0
      for idx in [:flatStmts.size] do
        let (st, stUnchk) := flatStmts[idx]!
        if let some (k, inUnchk) := matchTargetLinearStep env st isTarget 256 false stUnchk then
          stepCount := stepCount + 1
          stepIdx? := some (idx, k, inUnchk)
      if stepCount == 1 then
        if let some (stepIdx, k, stepInUnchecked) := stepIdx? then
          if !stepInUnchecked then
            let mut otherWrite := false
            for idx in [:flatStmts.size] do
              if idx != stepIdx && (bodyAssignedIds flatStmts[idx]!.1).contains varId then
                otherWrite := true
            if !otherWrite then
              let isUnsigned := match env.scalarTy.find? varId with
                | some .uint256 | some (.uintN _) => true
                | _ => false
              if isUnsigned then
                return some (.checkedDec varBinding k)
  return none

private def finishMemoryByteIndexRead (buf : EncodedBytes) (key : Val) (siteNode : Json) : M Val := do
  let ptrVar ← fresh
  let lenVar ← fresh
  modify fun e =>
    { e with linkedBytesCopySites :=
        e.linkedBytesCopySites.push (.localVar ptrVar, siteNode, e.currentFile, e.stack, false) }
  let pre := buf.pre ++ key.pre ++ #[
    .letVar ptrVar buf.pointer,
    .letVar lenVar buf.size,
    .ite (.lt key.expr (.localVar lenVar)) [] [.panicCode (.literal 0x32)]
  ]
  let wordOff := AbiEncoding.byteWordOffset key.expr
  let lane := AbiEncoding.byteLane key.expr
  let word := Expr.mload (.add (.localVar ptrVar) wordOff)
  return { pre, expr := .shl (.literal 248) (.byte lane word) }

private def isSupportedBytesTupleScalarReturnType (ty : String) : Bool :=
  ["uint256", "int256", "bytes32", "bytes4", "bytes1", "bool", "address"].contains ty ||
  ty.startsWith "enum " ||
  (ty.startsWith "uint" && (bitsOf ty).any (· < 256))

/-- Validate metadata of a typed external `(Scalar, bytes memory)` interface call
inside a forwarded tuple call tree. Returns `(isStatic, rawScalarTy, scalarTy,
enumBound?, params, args, selector, base)`. -/
private def parseInterfaceBytesTupleCallMeta (j : Json) :
    M (Bool × String × String × Option Nat × Array Json × Array Json × Nat × Json) := do
  if (← get).abiCoderV1 then
    failAt j "typed external (scalar, bytes memory) call under ABI coder v1 is outside this slice"
  let callee ← mField j "expression"
  let id ← refInt callee
  let env ← get
  let some decl := env.funs.find? id.toNat
    | failAt callee "unresolved interface function declaration"
  let rs ← mArr (← mField (← mField decl "returnParameters") "parameters")
  let rawReturnTypes ← rs.mapM mType
  unless rs.size == 2 && rawReturnTypes[1]! == "bytes" &&
      optStr rs[1]! "storageLocation" == some "memory" do
    failAt j "typed external call results are unsupported in a forwarded tuple call tree"
  let mutability := optStr decl "stateMutability"
  unless mutability == some "nonpayable" || mutability == some "view" || mutability == some "pure" do
    failAt callee "typed external (scalar, bytes memory) call must be nonpayable, view or pure"
  let isStatic := mutability == some "view" || mutability == some "pure"
  let rawScalarTy := rawReturnTypes[0]!
  let isScalarLoc := optStr rs[0]! "storageLocation" == some "default" && !rawScalarTy.contains '['
  let scalarTy := if isScalarLoc && rawScalarTy.startsWith "contract " then "address" else rawScalarTy
  let enumBound? ← validateEnumTypeIfNeeded rs[0]! rawScalarTy
  unless isScalarLoc && isSupportedBytesTupleScalarReturnType scalarTy &&
      (!scalarTy.startsWith "enum " || enumBound?.isSome) do
    failAt callee ("typed external (scalar, bytes memory) call scalar return must be " ++
      "uint256, uint8..uint248, int256, bytes32, bytes4, bytes1, bool, address or enum")
  let params ← mArr (← mField (← mField decl "parameters") "parameters")
  let args ← mArr (← mField j "arguments")
  unless args.size == params.size do
    failAt j "typed external call argument count differs from its declaration"
  let names ← mArr (← mField j "names")
  unless names.isEmpty do
    failAt j "named arguments in typed external (scalar, bytes memory) call are outside this slice"
  let some hex := optStr decl "functionSelector"
    | failAt callee "interface function has no functionSelector"
  unless hex.length == 8 do
    failAt callee s!"invalid functionSelector hex length {hex.length}"
  let mut selector := 0
  for c in hex.toList do
    let some digit := Compiler.Hex.hexCharToNat? c
      | failAt callee "invalid functionSelector hex digit"
    selector := selector * 16 + digit
  let base ← mField callee "expression"
  return (isStatic, rawScalarTy, scalarTy, enumBound?, params, args, selector, base)

/-- Emit calldata framing, closed `YulMemoryCall` (`CALL` or `STATICCALL`), revert
passthrough, and exact Solidity 0.8.x ABI decoding of `(Scalar, bytes memory)` from
`returndata` (including `< 64` short-returndata revert, `abiDecodeScalarGuard?`,
`2^64 - 1` offset/length bounds with `Panic(0x41)` on allocation overflow,
`offset + 32 + len <= returndatasize`, and trailing-padding cleanup). -/
private def emitInterfaceBytesTupleCallAndDecode (isStatic hasArgs : Bool)
    (selector : Nat) (targetExpr payloadPtr payloadSize : Expr)
    (rawScalarTy scalarTy : String) (enumBound? : Option Nat) :
    M (Array Stmt × Array (Expr × String)) := do
  let callBase ← fresh
  let callEnd ← fresh
  let dataPtr ← fresh
  let dataSize ← fresh
  modify fun e => { e with encodingMemory := true }
  let mut pre : Array Stmt := #[]
  if !hasArgs then
    pre := pre ++ (AbiEncoding.reserve callBase callEnd (.literal 32)).toArray ++ #[
      .mstore (.localVar callBase) (.literal selector),
      .letVar dataPtr (.add (.localVar callBase) (.literal 28)),
      .letVar dataSize (.literal 4)
    ]
  else
    let index ← fresh
    let words := Expr.div (.add payloadSize (.literal 31)) (.literal 32)
    pre := pre ++ (AbiEncoding.reserve callBase callEnd
      (.add (.literal 32) (.mul words (.literal 32)))).toArray ++ #[
      .mstore (.localVar callBase) (.literal selector),
      .forEach index words [
        .mstore (.add (.add (.localVar callBase) (.literal 32)) (.mul (.localVar index) (.literal 32)))
          (.mload (.add payloadPtr (.mul (.localVar index) (.literal 32))))],
      .letVar dataPtr (.add (.localVar callBase) (.literal 28)),
      .letVar dataSize (.add payloadSize (.literal 4))
    ]
  let success ← fresh
  let rdSize ← fresh
  let headPtr ← fresh
  let headEnd ← fresh
  let scalarWord ← fresh
  let relOff ← fresh
  let byteLen ← fresh
  let bytesPointer ← fresh
  let nextFree ← fresh
  let allocGuard (cond : Expr) : Stmt := .ite cond [] [.panicCode (.literal 0x41)]
  let alignedSize := Expr.bitAnd
    (.add (.add (.localVar byteLen) (.literal 32)) (.literal 31))
    (.bitNot (.literal 31))
  pre := pre ++ #[
    .ecm (Compiler.ECM.YulMemoryCall.module isStatic success)
      [targetExpr, .localVar dataPtr, .localVar dataSize, .literal 0, .literal 0],
    .ite (.eq (.localVar success) (.literal 0)) [.revertReturndata] [],
    .letVar rdSize .returndataSize,
    AbiLowering.guard (.logicalNot (.lt (.localVar rdSize) (.literal 64)))
  ] ++ (AbiEncoding.reserve headPtr headEnd (.literal 64)).toArray ++ #[
    .returndataCopy (.localVar headPtr) (.literal 0) (.literal 64),
    .letVar scalarWord (.mload (.localVar headPtr))
  ]
  if let some g := abiDecodeScalarGuard? scalarTy enumBound? (.localVar scalarWord) then
    pre := pre.push g
  pre := pre ++ #[
    .letVar relOff (.mload (.add (.localVar headPtr) (.literal 32))),
    AbiLowering.guard (.le (.localVar relOff) (.literal (2 ^ 64 - 1))),
    AbiLowering.guard (.le (.add (.localVar relOff) (.literal 32)) (.localVar rdSize)),
    .returndataCopy (.localVar headPtr) (.localVar relOff) (.literal 32),
    .letVar byteLen (.mload (.localVar headPtr)),
    allocGuard (.le (.localVar byteLen) (.literal (2 ^ 64 - 1))),
    .letVar bytesPointer (.mload (.literal 64)),
    .letVar nextFree (.add (.localVar bytesPointer) alignedSize),
    allocGuard (.le (.localVar nextFree) (.literal (2 ^ 64 - 1))),
    allocGuard (.ge (.localVar nextFree) (.localVar bytesPointer)),
    AbiLowering.guard (.le (.add (.add (.localVar relOff) (.literal 32)) (.localVar byteLen)) (.localVar rdSize)),
    .mstore (.localVar bytesPointer) (.localVar byteLen),
    .mstore (.literal 64) (.localVar nextFree),
    .returndataCopy (.add (.localVar bytesPointer) (.literal 32))
      (.add (.localVar relOff) (.literal 32)) (.localVar byteLen),
    .mstore (.add (.add (.localVar bytesPointer) (.literal 32)) (.localVar byteLen)) (.literal 0)
  ]
  return (pre, #[
    (.localVar scalarWord, rawScalarTy),
    (.add (.localVar bytesPointer) (.literal 32), "bytes"),
    (.localVar byteLen, "uint256")
  ])

set_option maxHeartbeats 2000000 in
mutual

private partial def lowerExpr (j : Json) : M Val := do
  match ← mKind j with
  | "Literal" =>
      let raw := optStr j "value" |>.getD ""
      if optStr j "kind" == some "bool" then
        unless (← mType j) == "bool" do failAt j "boolean literal has inconsistent type"
        let value ← match raw with
          | "true" => pure 1
          | "false" => pure 0
          | _ => failAt j "invalid boolean literal"
        return { pre := #[], expr := .literal value }
      unless optStr j "kind" == some "number" do failAt j "unsupported non-numeric literal"
      let multiplier ← match optStr j "subdenomination" with
        | none => pure 1
        | some denomination =>
            let some scale := literalUnitScale denomination
              | failAt j s!"unsupported literal denomination {denomination}"
            pure scale
      let some (numerator, denominator) := numericLiteralRatio raw
        | failAt j s!"unsupported literal {raw}"
      let scaled := numerator * multiplier
      unless scaled % denominator == 0 do
        failAt j "fractional numeric literal requires exact constant-expression lowering"
      let n := scaled / denominator
      unless n < 2 ^ 256 do failAt j "numeric literal exceeds an EVM word"
      pure { pre := #[], expr := .literal n }
  | "TupleExpression" =>
      if ← mBool (← mField j "isInlineArray") then failAt j "inline arrays are outside this slice"
      let cs ← mArr (← mField j "components")
      if cs.size == 1 then
        if cs[0]!.isNull then failAt j "empty tuple component"
        lowerExpr cs[0]!
      else
        failAt j "a multi-value expression is only valid as a return"
  | "UnaryOperation" =>
      let op := optStr j "operator"
      if op == some "++" || op == some "--" then
        lowerIncDecExpr j
      else do
        unless (field? j "prefix").bind (fun v => v.getBool?.toOption) == some true do
          failAt j "unsupported unary operation"
        let sub ← mField j "subExpression"
        if let some fnId := (field? j "function").bind (fun v => v.getNat?.toOption) then
          let env ← get
          let targetId := resolveInContracts env env.linearizedBases.toList fnId |>.getD fnId
          let v ← lowerExpr sub
          return ← inlineFn targetId #[.scalar v] j
        if op == some "!" then
          unless (← mType sub) == "bool" && (← mType j) == "bool" do
            failAt j "logical negation requires a bool operand"
          let v ← lowerExpr sub
          pure { pre := v.pre, expr := .logicalNot v.expr }
        else if op == some "-" then
          let jTy ← mType j
          let subTy ← mType sub
          let v ← lowerExpr sub
          if jTy.startsWith "int_const" then
            unless v.pre.isEmpty do failAt j "negative constant requires a pure literal operand"
            let .literal n := v.expr | failAt j "negative constant requires a pure literal operand"
            if n == 0 then
              pure { pre := #[], expr := .literal 0 }
            else if n ≤ 2 ^ 255 then
              pure { pre := #[], expr := .literal (2 ^ 256 - n) }
            else
              failAt j "negative constant out of int256 range"
          else if let some bits := signedBitsOf jTy then
            unless signedBitsOf subTy == some bits do
              failAt j s!"unary negation requires an {jTy} operand, found {subTy}"
            if (← get).unchecked && !(← get).viaIR then
              return { v with expr := .sub (.literal 0) v.expr }
            let a ← atom { v with expr := cleanHelperResultExpr subTy v }
            let negExpr :=
              if bits < 256 then Expr.signextend (.literal (bits / 8 - 1)) (.sub (.literal 0) a.expr)
              else .sub (.literal 0) a.expr
            let minVal := 2 ^ 256 - 2 ^ (bits - 1)
            if (← get).unchecked then
              pure { pre := a.pre, expr := negExpr }
            else
              let dest ← fresh
              let ok := Stmt.assignVar dest negExpr
              let ite := iteStmt (.eq a.expr (.literal minVal)) overflowPanic ok
              pure { pre := a.pre.push (.letVar dest (.literal 0)) |>.push ite, expr := .localVar dest }
          else
            failAt j s!"unary negation requires a signed integer operand, found {subTy}"
        else if op == some "~" then
          let jTy ← mType j
          let subTy ← mType sub
          unless jTy == subTy do
            failAt j s!"bitwise negation operand type {subTy} does not match {jTy}"
          let v ← lowerExpr sub
          let a ← atom v
          if (signedBitsOf jTy).isSome || jTy.startsWith "uint" || jTy == "bytes4" then
            let inverted := { a with expr := Expr.bitNot a.expr }
            return if (← get).viaIR then { inverted with expr := cleanHelperResultExpr jTy inverted }
              else inverted
          if (fixedBytesWidth? jTy).any (· < 32) then
            let inverted := { a with expr := Expr.bitNot a.expr }
            return if (← get).viaIR then { inverted with expr := cleanHelperResultExpr jTy inverted }
              else inverted
          if jTy == "bytes32" then
            pure { pre := a.pre, expr := .bitNot a.expr }
          else
            failAt j s!"unsupported bitwise negation type {jTy}"
        else
          failAt j "unsupported unary operation"
  | "BinaryOperation" => lowerBinary j
  | "Conditional" => lowerConditional j
  | "FunctionCall" => lowerCall j
  | "Assignment" => lowerAssignmentExpr j
  | "Identifier" | "MemberAccess" | "IndexAccess" =>
      if (← mKind j) == "IndexAccess" && (← mType j) == "bytes1" then
        let baseExpression ← mField j "baseExpression"
        let baseTy ← mType baseExpression
        if baseTy == "bytes" || baseTy == "bytes memory" || baseTy == "bytes calldata" ||
           baseTy == "bytes calldata slice" ||
           baseTy == "bytes storage pointer" || baseTy == "bytes storage ref" then
          let indexExpression ← mField j "indexExpression"
          let isWrappedOrNonIdent := (← mKind (← stripParens baseExpression)) != "Identifier"
          let innerBase ← unwrapBytesConversion (← stripParens baseExpression)
          let isKnownByteBase ← if isWrappedOrNonIdent then pure true else do
            if (← mKind innerBase) == "Identifier" then
              let id ← refInt innerBase
              if id ≥ 0 then
                let env ← get
                pure (env.stringBuffers.contains id.toNat || env.calldataBytes.contains id.toNat ||
                  ((env.byteBuffers.find? id.toNat).any (!·.shortStringAlloc) &&
                    !env.shortStringBuffers.contains id.toNat))
              else pure false
            else pure false
          if isKnownByteBase then
            if statefulCallIn baseExpression (← get) || statefulCallIn indexExpression (← get) ||
               assignmentIn baseExpression || assignmentIn indexExpression then
              failAt j "stateful or assignment byte buffer index is unsupported"
            let idxTy ← mType indexExpression
            unless (idxTy.startsWith "uint" && (bitsOf idxTy).isSome) ||
                (idxTy.startsWith "int_const" && !idxTy.startsWith "int_const -") do
              failAt indexExpression "byte buffer index must be unsigned"
            if (← mKind innerBase) == "Identifier" then
              let id ← refInt innerBase
              if id ≥ 0 then
                if let some cb := (← get).calldataBytes.find? id.toNat then
                  if !cb.inMemory then
                    let key ← atom (← lowerConverted "uint256" indexExpression)
                    let pre := key.pre.push (.ite (.lt key.expr (.localVar cb.lengthBinding)) [] [.panicCode (.literal 0x32)])
                    let wordOff := AbiEncoding.byteWordOffset key.expr
                    let lane := AbiEncoding.byteLane key.expr
                    let word := Expr.calldataload (.add (.localVar cb.dataBinding) wordOff)
                    return { pre, expr := .shl (.literal 248) (.byte lane word) }
            if let some (slicePre, offExpr, lenExpr, true, false) ← lowerCalldataSlice? innerBase then
              let key ← atom (← lowerConverted "uint256" indexExpression)
              let pre := slicePre ++ key.pre ++ #[
                .ite (.lt key.expr lenExpr) [] [.panicCode (.literal 0x32)]
              ]
              let wordOff := AbiEncoding.byteWordOffset key.expr
              let lane := AbiEncoding.byteLane key.expr
              let word := Expr.calldataload (.add offExpr wordOff)
              return { pre, expr := .shl (.literal 248) (.byte lane word) }
            if ← isParameterizedCalldataBytesCall innerBase then
              let (fnId, vals) ← resolveCallTargetAndArgs innerBase
              let (cpre, cb) ← inlineCalldataBytesFn fnId vals innerBase
              let key ← atom (← lowerConverted "uint256" indexExpression)
              let pre := cpre ++ key.pre ++ #[
                .ite (.lt key.expr (.localVar cb.lengthBinding)) [] [.panicCode (.literal 0x32)]
              ]
              let wordOff := AbiEncoding.byteWordOffset key.expr
              let lane := AbiEncoding.byteLane key.expr
              let word := Expr.calldataload (.add (.localVar cb.dataBinding) wordOff)
              return { pre, expr := .shl (.literal 248) (.byte lane word) }
            let key ← atom (← lowerConverted "uint256" indexExpression)
            let buf ← lowerEncodedBytes baseExpression
            return ← finishMemoryByteIndexRead buf key j
      match ← lowerRef j with
      | .expr v => pure v
      | .state name pre =>
          let info ← resolveField name j
          unless info.keyCount == 0 do failAt j "mapping used as a scalar value"
          if info.bytesStorage then failAt j "bytes or string storage variable used as a scalar value"
          if info.dynamicArrayElemType.isSome then failAt j "dynamic storage array used as a scalar value"
          markField name
          if info.booleanScalar then
            pure { pre, expr := .logicalNot (.logicalNot (.storage name)) }
          else
            pure { pre, expr := .storage name }
      | .path pre path => scalarMappingRead pre path j
      | .fixedElement pre path index =>
          let (name, count, read) ← match path with
            | .zero name => pure (name, 0, fun member => Expr.storage (topStructMemberFieldName (splitSPathField name).1 member))
            | .one name key => pure (name, 1, fun member => Expr.structMember name key member)
            | .two name key1 key2 => pure (name, 2, fun member => Expr.structMember2 name key1 key2 member)
            | .outer _ _ => failAt j "fixed array element requires both mapping keys"
            | .rawSlot _ _ | .bytesSlot _ _ => failAt j "fixed array element on raw storage slot struct is outside this slice"
          let info ← resolveField name j
          let some length := info.fixedArrayLength | failAt j "missing fixed array layout"
          unless info.keyCount == count do failAt j "fixed array mapping key count differs"
          let dest ← fresh
          let mut pre := pre.push (.ite (.lt index (.literal length))
            [] [.panicCode (.literal 0x32)]) |>.push (.letVar dest (.literal 0))
          for i in [:length] do
            pre := pre.push (.ite (.eq index (.literal i))
              [.assignVar dest (read s!"__solidity_element_{i}")] [])
          markField name
          pure { pre, expr := .localVar dest }
      | .structFixedElement pre (.rawSlot _ baseSlot) arrInfo index =>
          readRawFixedArrayElement pre (rawStructMemberSlot baseSlot arrInfo.wordOffset) arrInfo index
      | .structFixedElement pre path arrInfo index =>
          let (rawName, count, read) ← match path with
            | .zero name => pure (name, 0, fun member => Expr.storage (topStructMemberFieldName (splitSPathField name).1 member))
            | .one name key => pure (name, 1, fun member => Expr.structMember (splitSPathField name).1 key member)
            | .two name key1 key2 => pure (name, 2, fun member => Expr.structMember2 (splitSPathField name).1 key1 key2 member)
            | .outer _ _ => failAt j "fixed array element requires both mapping keys"
            | .rawSlot _ _ | .bytesSlot _ _ => failAt j "fixed array element on raw storage slot struct is outside this slice"
          let (name, _) := splitSPathField rawName
          let info ← resolveField name j
          unless info.keyCount == count do failAt j "fixed array mapping key count differs"
          let dest ← fresh
          let mut pre := pre.push (.ite (.lt index (.literal arrInfo.length))
            [] [.panicCode (.literal 0x32)]) |>.push (.letVar dest (.literal 0))
          for i in [:arrInfo.length] do
            pre := pre.push (.ite (.eq index (.literal i))
              [.assignVar dest (read s!"__solidity_struct_array_{arrInfo.member}_{i}")] [])
          markField name
          markStructFixedArray name arrInfo.member
          pure { pre, expr := .localVar dest }
      | .structFixedArray _ _ arrInfo =>
          failAt j s!"struct fixed array member {arrInfo.member} requires an element index"
      | .structMappingElement pre path mapInfo key =>
          storageEnumRead j (← readStructMappingElement pre path mapInfo key j)
      | .structMapping _ _ mapInfo =>
          failAt j s!"struct mapping member {mapInfo.member} requires a mapping key"
      | .structDynamicElement pre path dynInfo index =>
          if let .rawSlot _ baseSlot := path then
            let slotExpr := rawStructMemberSlot baseSlot dynInfo.wordOffset
            readStorageDynamicArrayElement pre "" slotExpr dynInfo.elemType index
          else
            let rawName ← match path with
              | .zero name | .one name _ | .two name _ _ => pure name
              | .outer _ _ | .rawSlot _ _ | .bytesSlot _ _ =>
                  failAt j "struct dynamic array element requires all outer mapping keys"
            let (name, _) := splitSPathField rawName
            let info ← resolveField name j
            markField name
            markStructDynamicArray name dynInfo.member
            let (slotStmts, slotExpr) ← computeSPathBaseSlot path info dynInfo.wordOffset j
            readStorageDynamicArrayElement (pre ++ slotStmts) "" slotExpr dynInfo.elemType index
      | .storageDynamicElement pre fieldName slotExpr elemTy index =>
          readStorageDynamicArrayElement pre fieldName slotExpr elemTy index
      | .structDynamicArray _ _ dynInfo =>
          failAt j s!"struct dynamic array member {dynInfo.member} requires an element index"
      | _ => failAt j "storage or memory path used as a value"
  | kind => failAt j s!"unsupported expression {kind}"

private partial def isThisAddressConv (j : Json) : M Bool := do
  unless (← mKind j) == "FunctionCall" && optStr j "kind" == some "typeConversion" do
    return false
  let ty ← mType j
  unless ty == "address" || ty == "address payable" do
    return false
  let args ← mArr (← mField j "arguments")
  unless args.size == 1 do
    return false
  let arg := args[0]!
  if (← mKind arg) == "Identifier" && optStr arg "name" == some "this" then
    unless (← refInt arg) == -28 do
      failAt arg "this does not resolve to the current contract builtin"
    return true
  isThisAddressConv arg

private partial def isByteBufferIdent (j : Json) : M (Option EncodedBytes) := do
  unless (← mKind j) == "Identifier" do return none
  let id ← refInt j
  unless id ≥ 0 do return none
  return (← get).byteBuffers.find? id.toNat

private partial def lowerRef (j : Json) : M Ref := do
  match ← mKind j with
  | "Identifier" =>
      let id ← refInt j
      -- The contract-typed `this` as a value: solc represents a contract-typed value by
      -- its address (ABI encoding, packed encoding, comparisons, event and internal
      -- call arguments all use the 160-bit word with clean upper bits), so it is the
      -- same word as `address(this)`. Member access on `this` rejects in `MemberAccess`.
      if id == -28 && optStr j "name" == some "this" then
        unless (← mType j).startsWith "contract " do
          failAt j "this does not resolve to the current contract builtin"
        return .expr { pre := #[], expr := .contractAddress }
      if id < 0 then failAt j "unresolved builtin identifier"
      let n := id.toNat
      let env ← get
      if let some expr := env.values.find? n then
        pure (.expr { pre := #[], expr })
      else if let some path := env.paths.find? n then
        if (← mType j).startsWith "mapping(" then
          if let .rawSlot valSid slotExpr := path then
            pure (.structMapping #[] (.rawSlot 0 slotExpr) {
              member := ""
              solcType := ← mType j
              wordOffset := 0
              keyType := .uint256
              valueWidth := 256
              booleanValue := false
              valueStructId := if valSid == 0 then none else some valSid
            })
          else if let .zero name := path then
            -- A `mapping(...) storage` parameter bound to a mapping state variable
            -- (`lowerCallArgs`): the parameter is that variable.
            pure (.state name #[])
          else
            pure (.path #[] path)
        else
          pure (.path #[] path)
      else if let some elements := env.snapshots.find? n then
        pure (.snapshot elements)
      else if env.fixedMemArrays.contains n then
        pure (.fixedMemArray n #[])
      else if env.nestedMemArrays.contains n then
        pure (.nestedMemArray n #[])
      else if let some mem := env.mems.find? n then
        match mem.rootArrayWord with
        | some word => pure (.abiArray n word #[])
        | none => pure (.mem n #[])
      else if let some elem := env.abiElements.find? n then
        pure (.abiElement elem.rootId elem.memberIndex elem.pointer elem.inMemory #[])
      else if env.flatStructs.contains n then
        pure (.flatStruct n)
      else if env.byteBuffers.contains n then
        failAt j "encoded byte locals are limited to hash and packed encoding operands"
      else if env.stringBuffers.contains n then
        failAt j "string locals and memory parameters are limited to hash, packed encoding, and bytes(s).length operands"
      else if env.calldataBytes.contains n then
        pure (.calldataBytes n #[])
      else if env.scalarArrays.contains n then
        pure (.scalarArray n #[])
      else if let some (fieldName, slotExpr, isString) := env.storageBytesVars.find? n then
        if fieldName != "" then
          pure (.state fieldName #[])
        else
          pure (.path #[] (.bytesSlot ("", slotExpr) isString))
      else if let some (fieldName, slotExpr, elemTy, elemSid?) := env.storageDynamicArrayVars.find? n then
        if let some elemSid := elemSid? then
          if fieldName != "" then
            pure (.state fieldName #[])
          else
            pure (.structDynamicArray #[] (.rawSlot 0 slotExpr) {
              member := ""
              solcType := elemTy ++ "[]"
              wordOffset := 0
              elemType := elemTy
              modelElemType := .uint256
              abiKind := .bytes32
              elemStructId := some elemSid
            })
        else
          let some (_, modelElemTy, abiKind) := dynamicStorageArrayElement? elemTy
            | failAt j s!"unsupported storage dynamic array element type {elemTy}"
          if fieldName != "" then
            pure (.state fieldName #[])
          else
            pure (.structDynamicArray #[] (.rawSlot 0 slotExpr) {
              member := ""
              solcType := elemTy ++ "[]"
              wordOffset := 0
              elemType := elemTy
              modelElemType := modelElemTy
              abiKind
            })
      else if let some decl := env.numericConstants.find? n then
        if env.constantStack.contains n then failAt j "cyclic constant initializer"
        let declared ← mType decl
        let initializer ← mField decl "value"
        if declared.startsWith "bytes" then
          if let some byteW := (declared.drop 5).toNat? then
            if 1 ≤ byteW && byteW ≤ 32 && (← mKind initializer) == "Literal" &&
                (optStr initializer "kind" == some "string" ||
                 optStr initializer "kind" == some "unicodeString" ||
                 optStr initializer "kind" == some "hexString") then
              let hex ← mStr (← mField initializer "hexValue")
              unless hex.length % 2 == 0 && hex.length / 2 ≤ byteW do
                failAt initializer s!"fixed-bytes literal constant exceeds {declared}"
              let word ← if hex.isEmpty then pure 0 else do
                let some v := Compiler.Hex.parseHexNat? ("0x" ++ hex)
                  | failAt initializer s!"invalid hexValue {hex}"
                pure v
              let aligned := word * 16 ^ (64 - hex.length)
              return .expr { pre := #[], expr := .literal aligned }
        unless (declared.startsWith "uint" && (bitsOf declared).isSome) ||
            declared == "bool" || (fixedBytesWidth? declared).isSome ||
            (signedBitsOf declared).isSome ||
            declared == "address" || declared == "address payable" do
          failAt j s!"unsupported numeric constant type {declared}"
        modify fun e => { e with constantStack := n :: e.constantStack }
        let rawValue ← lowerExpr initializer
        let value ← convert declared (← mType initializer) rawValue initializer
        modify fun e => { e with constantStack := env.constantStack }
        pure (.expr value)
      else if let some decl := env.stateVars.find? n then
        let name ← mStr (← mField decl "name")
        if optStr decl "mutability" == some "immutable" then
          failAt j s!"immutable state variable {name} is outside this slice"
        if env.duplicateLayoutLabels.contains name then
          failAt j s!"shadowed storage declaration {name} is outside this slice"
        if let some item := env.layoutItems.find? name then
          unless (← mNat (← mField item "astId")) == n do
            failAt j s!"shadowed storage declaration {name} is outside this slice"
        if (← mType j).startsWith "struct " && !(← mType j).contains "[" then
          let info ← resolveField name j
          unless info.keyCount == 0 && !info.scalarMapping && info.fixedArrayLength.isNone do
            failAt j s!"unsupported storage struct state variable {name}"
          pure (.path #[] (.zero name))
        else if !(← mType j).startsWith "mapping(" && (← mType j).contains "[" && !(← mType j).contains "[]" then
          let info ← resolveField name j
          unless info.keyCount == 0 && info.fixedArrayLength.isSome do
            failAt j s!"unsupported fixed storage array state variable {name}"
          pure (.path #[] (.zero name))
        else
          pure (.state name #[])
      else if env.funs.contains n || env.fnPtrs.contains n then
        failAt j "function pointers are outside this slice"
      else
        failAt j s!"unresolved identifier {id}"
  | "IndexAccess" =>
      let baseExpression ← mField j "baseExpression"
      if (← mKind baseExpression) == "TupleExpression" then
        if ← mBool (← mField baseExpression "isInlineArray") then
          let components ← mArr (← mField baseExpression "components")
          unless components.size > 0 do failAt baseExpression "empty inline constant array"
          let arrayType ← mType baseExpression
          let elementType := (arrayType.splitOn "[").head!
          unless elementType.startsWith "uint" do
            failAt baseExpression "inline constant arrays require unsigned scalar elements"
          let some bits := bitsOf elementType
            | failAt baseExpression "unsupported inline constant array element type"
          let mut constants : Array Nat := #[]
          for component in components do
            let value ← lowerExpr component
            unless value.pre.isEmpty do
              failAt component "inline array elements must be exact natural constants"
            let .literal n := value.expr
              | failAt component "inline array elements must be exact natural constants"
            unless n < 2 ^ bits do failAt component "inline array constant exceeds element width"
            constants := constants.push n
          let indexExpression ← mField j "indexExpression"
          let indexType ← mType indexExpression
          unless indexType.startsWith "uint" || indexType.startsWith "int_const" do
            failAt indexExpression "inline constant array index must be unsigned"
          let key ← atom (← lowerConverted "uint256" indexExpression)
          let dest ← fresh
          let mut pre := key.pre.push (.ite (.lt key.expr (.literal constants.size))
            [] [.panicCode (.literal 0x32)]) |>.push (.letVar dest (.literal 0))
          for index in [:constants.size] do
            pre := pre.push (.ite (.eq key.expr (.literal index))
              [.assignVar dest (.literal constants[index]!)] [])
          return .expr { pre, expr := .localVar dest }
      let base ← lowerRef baseExpression
      let indexExpression ← mField j "indexExpression"
      let baseTy ← mType baseExpression
      -- An outer mapping key can still be a reference to a writable local.
      -- Do not defer its read across an inner key that can change it.
      match base with
      | .structMapping .. =>
          if assignmentIn indexExpression then
            failAt indexExpression "effectful inner mapping key requires outer key capture"
      | .path _ (.outer ..) =>
          if assignmentIn indexExpression || statefulCallIn indexExpression (← get) then
            failAt indexExpression "effectful inner mapping key requires outer key capture"
      | _ => pure ()
      let rawKey ← lowerExpr indexExpression
      let convKey ← if baseTy.startsWith "mapping(bytes4 =>" then
        convert "bytes4" (← mType indexExpression) rawKey indexExpression
      else
        pure rawKey
      -- Mapping hashes consume a canonical key regardless of the value type.
      -- Clean a narrow source even when it implicitly widens to the key type.
      let convKey ← if baseTy.startsWith "mapping(" then do
        let src ← mType indexExpression
        -- Only skip a mask when the word itself proves it redundant. In
        -- particular, a local's most recent syntactic assignment need not be
        -- its reaching definition on a loop back-edge.
        let env ← get
        let canonical := match convKey.expr with
          | .literal _ => false -- A legacy narrowing cast may retain a wider literal.
          | .caller | .contractAddress | .txOrigin => bitsOf src == some 160
          | .param p => (paramType src).isSome && rootParamType? env p == paramType src
          | .localVar b =>
              (paramType src).isSome && env.rawBindings.toList.any fun (id, rb) =>
                rb == b && env.scalarTy.find? id == paramType src
          | _ => false
        if canonical then pure convKey else pure { convKey with expr := cleanHelperResultExpr src convKey }
      else pure { convKey with expr := cleanHelperResultExpr (← mType indexExpression) convKey }
      let key ← atom convKey
      match base with
      | .state name pre =>
          let info ← resolveField name j
          if info.keyCount == 0 && info.bytesStorage then failAt j "index access on bytes or string storage variable is outside this slice"
          if let some elemSid := info.dynamicArrayStructId then
            let ty ← mType indexExpression
            unless ty.startsWith "uint" || ty.startsWith "int_const" do
              failAt j "dynamic storage array index must be unsigned"
            let (elemPre, elemPath) ← storageDynamicStructElementPath (pre ++ key.pre) name (.literal info.slot) elemSid key.expr j
            return .path elemPre elemPath
          if let some (elemTy, _, _) := info.dynamicArrayElemType then
            let ty ← mType indexExpression
            unless ty.startsWith "uint" || ty.startsWith "int_const" do
              failAt j "dynamic storage array index must be unsigned"
            let captured ← fresh
            return .storageDynamicElement ((pre ++ key.pre).push (.letVar captured key.expr))
              name (.literal info.slot) elemTy (.localVar captured)
          markField name
          if info.keyCount == 2 then
            pure (.path (pre ++ key.pre) (.outer name key.expr))
          else
            pure (.path (pre ++ key.pre) (.one name key.expr))
      | .path pre (.outer field k1) =>
          let info ← resolveField field j
          if let some mapInfo := info.thirdKeyMapping then
            pure (.structMapping (pre ++ key.pre) (.two field k1 key.expr) mapInfo)
          else
            pure (.path (pre ++ key.pre) (.two field k1 key.expr))
      | .path pre path =>
          if let .bytesSlot _ _ := path then
            failAt j "index access on bytes or string storage variable is outside this slice"
          let rawName ← match path with
            | .zero name | .one name _ | .two name _ _ => pure name
            | .outer _ _ => failAt j "fixed array element requires both mapping keys"
            | .rawSlot _ _ | .bytesSlot _ _ => failAt j "index of a raw storage slot struct is outside this slice"
          let (name, _) := splitSPathField rawName
          let info ← resolveField name j
          if info.bytesStorage then
            failAt j "index access on bytes or string storage variable is outside this slice"
          unless info.fixedArrayLength.isSome do
            failAt j "index of a storage value requires a fixed array layout"
          let ty ← mType indexExpression
          unless ty.startsWith "uint" || ty.startsWith "int_const" do
            failAt j "fixed storage array index must be unsigned"
          let captured ← fresh
          pure (.fixedElement ((pre ++ key.pre).push (.letVar captured key.expr))
            path (.localVar captured))
      | .structFixedArray pre path arrInfo =>
          let rawName ← match path with
            | .zero name | .one name _ | .two name _ _ => pure name
            | .rawSlot _ _ => pure ""
            | .outer _ _ => failAt j "fixed array element requires both mapping keys"
            | .bytesSlot _ _ => failAt j "fixed array element on raw storage slot struct is outside this slice"
          if rawName != "" then
            let (name, _) := splitSPathField rawName
            let _ ← resolveField name j
          let ty ← mType indexExpression
          unless ty.startsWith "uint" || ty.startsWith "int_const" do
            failAt j "fixed storage array index must be unsigned"
          let captured ← fresh
          pure (.structFixedElement ((pre ++ key.pre).push (.letVar captured key.expr))
            path arrInfo (.localVar captured))
      | .structMapping pre path mapInfo =>
          let (outerCapture, path) ← if statefulCallIn indexExpression (← get) then
            match path with
            | .one rawName k1 => do
                let ok1 ← fresh
                pure (#[Stmt.letVar ok1 k1], SPath.one rawName (.localVar ok1))
            | .two rawName k1 k2 => do
                let ok1 ← fresh
                let ok2 ← fresh
                pure (#[Stmt.letVar ok1 k1, Stmt.letVar ok2 k2],
                  SPath.two rawName (.localVar ok1) (.localVar ok2))
            | .rawSlot sid baseSlot => do
                let obs ← fresh
                pure (#[Stmt.letVar obs baseSlot], SPath.rawSlot sid (.localVar obs))
            | _ => pure (#[], path)
          else pure (#[], path)
          let pre := pre ++ outerCapture
          match path with
          | .rawSlot _ _ => pure ()
          | .bytesSlot _ _ => failAt j "struct mapping element on StorageSlot.BytesSlot is outside this slice"
          | .zero rawName | .one rawName _ | .two rawName _ _ =>
              let (name, _) := splitSPathField rawName
              let _ ← resolveField name j
          | .outer _ _ => failAt j "struct mapping element requires both outer mapping keys"
          if let some innerKeyType := mapInfo.innerKeyType then
            -- The outer key selects the inner mapping, whose slot is
            -- keccak256(key . memberSlot); the inner key is then an ordinary member key.
            -- `memberSlot` is the raw struct base plus the member offset, or, for a struct
            -- reached through a state variable (and its mapping keys), solc's layout slot.
            let (baseStmts, memberSlot) ← match path with
              | .rawSlot _ baseSlot => pure (#[], rawStructMemberSlot baseSlot mapInfo.wordOffset)
              | .zero rawName | .one rawName _ | .two rawName _ _ => do
                  let (name, _) := splitSPathField rawName
                  let info ← resolveField name j
                  markField name
                  markStructMapping name mapInfo.member
                  computeSPathBaseSlot path info mapInfo.wordOffset j
              | .outer _ _ | .bytesSlot _ _ =>
                  failAt j "two-key struct mapping member requires a storage struct path"
            modify fun e => { e with encodingMemory := true, usedRawStorage := true }
            let innerBase ← fresh
            let slotStmts : Array Stmt := baseStmts ++ #[
              Stmt.mstore (.literal 0) key.expr,
              Stmt.mstore (.literal 32) memberSlot,
              Stmt.letVar innerBase (.keccak256 (.literal 0) (.literal 64))]
            return .structMapping (pre ++ key.pre ++ slotStmts) (.rawSlot 0 (.localVar innerBase))
              { mapInfo with member := s!"{mapInfo.member}[]", wordOffset := 0,
                             keyType := innerKeyType, innerKeyType := none }
          if let some valSid := mapInfo.valueStructId then
            let (slotStmts, slotExpr) ←
              if let .rawSlot _ baseSlot := path then do
                modify fun e => { e with encodingMemory := true, usedRawStorage := true }
                let mapBaseExpr := rawStructMemberSlot baseSlot mapInfo.wordOffset
                let leafSlot ← fresh
                pure (#[
                  Stmt.mstore (.literal 0) key.expr,
                  Stmt.mstore (.literal 32) mapBaseExpr,
                  Stmt.letVar leafSlot (.keccak256 (.literal 0) (.literal 64))
                ], Expr.localVar leafSlot)
              else do
                let rawName ← match path with
                  | .zero name | .one name _ | .two name _ _ => pure name
                  | .outer _ _ | .rawSlot _ _ | .bytesSlot _ _ =>
                      failAt j "struct mapping element requires both outer mapping keys"
                let (name, _) := splitSPathField rawName
                let info ← resolveField name j
                markField name
                markStructMapping name mapInfo.member
                computeStructMappingLeafSlot path info mapInfo key.expr j
            return .path (pre ++ key.pre ++ slotStmts) (.rawSlot valSid slotExpr)
          let captured ← fresh
          pure (.structMappingElement ((pre ++ key.pre).push (.letVar captured key.expr))
            path mapInfo (.localVar captured))
      | .structDynamicArray pre path dynInfo =>
          match path with
          | .rawSlot _ _ => pure ()
          | .bytesSlot _ _ => failAt j "struct dynamic array element on StorageSlot.BytesSlot is outside this slice"
          | .zero rawName | .one rawName _ | .two rawName _ _ =>
              let (name, _) := splitSPathField rawName
              let _ ← resolveField name j
          | .outer _ _ => failAt j "struct dynamic array element requires all outer mapping keys"
          let ty ← mType indexExpression
          unless ty.startsWith "uint" || ty.startsWith "int_const" do
            failAt j "dynamic storage array index must be unsigned"
          if let some elemSid := dynInfo.elemStructId then
            let (slotPre, arrSlot) ← if let .rawSlot _ baseSlot := path then
              pure (#[], rawStructMemberSlot baseSlot dynInfo.wordOffset)
            else do
              let rawName ← match path with
                | .zero name | .one name _ | .two name _ _ => pure name
                | .outer _ _ | .rawSlot _ _ | .bytesSlot _ _ =>
                    failAt j "struct dynamic array element requires all outer mapping keys"
              let (name, _) := splitSPathField rawName
              let info ← resolveField name j
              markField name
              markStructDynamicArray name dynInfo.member
              computeSPathBaseSlot path info dynInfo.wordOffset j
            let (elemPre, elemPath) ← storageDynamicStructElementPath (pre ++ key.pre ++ slotPre) "" arrSlot elemSid key.expr j
            return .path elemPre elemPath
          let captured ← fresh
          pure (.structDynamicElement ((pre ++ key.pre).push (.letVar captured key.expr))
            path dynInfo (.localVar captured))
      | .snapshot elements =>
          let ty ← mType indexExpression
          unless ty.startsWith "uint" || ty.startsWith "int_const" do
            failAt j "fixed memory array index must be unsigned"
          let dest ← fresh
          let mut pre := key.pre.push (.ite (.lt key.expr (.literal elements.size))
            [] [.panicCode (.literal 0x32)]) |>.push (.letVar dest (.literal 0))
          for i in [:elements.size] do
            let some element := elements[i]? | failAt j "missing fixed array snapshot element"
            pre := pre.push (.ite (.eq key.expr (.literal i))
              [.assignVar dest element] [])
          pure (.expr { pre, expr := .localVar dest })
      | .abiArray id memberIndex pre =>
          if !key.pre.isEmpty && (statefulCallIn indexExpression (← get) || assignmentIn indexExpression) then
            failAt j "stateful or assignment struct-array index is unsupported"
          let some mem := (← get).mems.find? id | failAt j "unknown ABI root"
          let some schema := mem.schema | failAt j "missing ABI schema"
          if let some (.scalarArray field) := schema[memberIndex]? then
            if mem.calldataLocation then
              let header ← fresh
              let length ← fresh
              let data ← fresh
              let checks := AbiLowering.staticArrayHead (.localVar (mem.abiStem ++ "_calldata"))
                memberIndex 1 header length data
              let pre := pre ++ checks.toArray ++ key.pre ++ #[.ite (.lt key.expr (.localVar length))
                [] [.panicCode (.literal 0x32)]]
              let value := Expr.calldataload (.add (.localVar data) (.mul key.expr (.literal 32)))
              let bound := SolidityAbi.scalarBound field.kind
              let pre := if bound < 2^256 then
                pre.push (AbiLowering.guard (.lt value (.literal bound))) else pre
              return .expr { pre, expr := value }
            else
              let array := mem.memoryMemberWord memberIndex
              let pre := (pre ++ key.pre).push (.ite (.lt key.expr (.mload array)) [] [.panicCode (.literal 0x32)])
              let value := Expr.mload (.add (.add array (.literal 32)) (.mul key.expr (.literal 32)))
              return .expr { pre, expr := value }
          if let some (.bytesArray _) := schema[memberIndex]? then
            -- `data[i]` of a root `bytes[]`: bounds check, then the element's
            -- `bytes` descriptor under a synthetic id (above every AST id), so
            -- the descriptor-based `bytes` lowerings (`.length`, hashing,
            -- packed encoding, `bytes calldata` helper arguments, slices,
            -- `bytes calldata` locals, and `abi.decode`) apply to it unchanged.
            let sid := 2 ^ 62 + (← get).next
            discard fresh
            let elemHeader ← fresh
            let elemLength ← fresh
            let elemData ← fresh
            if mem.calldataLocation then
              let header ← fresh
              let length ← fresh
              let data ← fresh
              let checks := AbiLowering.staticArrayHead (.localVar (mem.abiStem ++ "_calldata"))
                memberIndex 1 header length data
              let tail := AbiLowering.calldataBytesTailAt (.localVar data)
                (.add (.localVar data) (.mul key.expr (.literal 32))) elemHeader elemLength elemData
              let pre := pre ++ checks.toArray ++ key.pre ++ #[.ite (.lt key.expr (.localVar length))
                [] [.panicCode (.literal 0x32)]] ++ tail.toArray
              let desc : CalldataBytesParam :=
                { param := "", offsetBinding := "", headerBinding := elemHeader
                  lengthBinding := elemLength, dataBinding := elemData }
              modify fun e => { e with calldataBytes := e.calldataBytes.insert sid desc }
              return .calldataBytes sid pre
            else
              let array := mem.memoryMemberWord memberIndex
              let pre := (pre ++ key.pre).push (.ite (.lt key.expr (.mload array)) [] [.panicCode (.literal 0x32)])
              let pre := pre ++ #[
                .letVar elemHeader (.mload (.add (.add array (.literal 32)) (.mul key.expr (.literal 32)))),
                .letVar elemLength (.mload (.localVar elemHeader))]
              let desc : CalldataBytesParam :=
                { param := "", offsetBinding := "", headerBinding := "", lengthBinding := elemLength
                  dataBinding := "", inMemory := true, memoryPointer := elemHeader }
              modify fun e => { e with calldataBytes := e.calldataBytes.insert sid desc }
              return .calldataBytes sid pre
          let some (.structArray _ fields) := schema[memberIndex]?
            | failAt j "index requires a struct-array member"
          if mem.calldataLocation then
            let header ← fresh
            let length ← fresh
            let data ← fresh
            let checks := AbiLowering.staticArrayHead (.localVar (mem.abiStem ++ "_calldata"))
              memberIndex fields.length header length data
            let pre := pre ++ checks.toArray ++ key.pre ++ #[.ite (.lt key.expr (.localVar length))
              [] [.panicCode (.literal 0x32)]]
            pure (.abiElement id memberIndex
              (.add (.localVar data) (.mul key.expr (.literal (32*fields.length)))) false pre)
          else
            let array := mem.memoryMemberWord memberIndex
            let pre := (pre ++ key.pre).push (.ite (.lt key.expr (.mload array)) [] [.panicCode (.literal 0x32)])
            pure (.abiElement id memberIndex
              (.mload (.add (.add array (.literal 32)) (.mul key.expr (.literal 32)))) true pre)
      | .nestedMemArray id pre =>
          if (statefulCallIn indexExpression (← get) || !pre.isEmpty) && !key.pre.isEmpty then
            failAt j "stateful or assignment nested array index is unsupported"
          let ty ← mType indexExpression
          unless ty.startsWith "uint" || ty.startsWith "int_const" do
            failAt j "nested memory array index must be unsigned"
          let some arr := (← get).nestedMemArrays.find? id | failAt j "unknown nested memory array"
          -- `v[i]` is the inner array's pointer, read after the outer bounds
          -- check; the inner array is an ordinary `T[] memory` value bound
          -- under a synthetic id (above every AST id).
          let inner ← fresh
          let innerLen ← fresh
          let sid := 2 ^ 62 + (← get).next
          discard fresh
          let pre := pre ++ key.pre ++ #[
            .ite (.lt key.expr (.localVar arr.lengthBinding)) [] [.panicCode (.literal 0x32)],
            .letVar inner (.mload (.add (.add (.localVar arr.pointer) (.literal 32)) (.mul key.expr (.literal 32)))),
            .letVar innerLen (.mload (.localVar inner))]
          let desc : ScalarArrayParam :=
            { param := "", elementType := arr.elementType, modelElementType := arr.modelElementType,
              abiKind := arr.abiKind, inMemory := true, lengthBinding := innerLen, memoryPointer := inner }
          modify fun e => { e with scalarArrays := e.scalarArrays.insert sid desc }
          return .scalarArray sid pre
      | .fixedMemArray id pre =>
          if (statefulCallIn indexExpression (← get) || !pre.isEmpty) && !key.pre.isEmpty then
            failAt j "stateful or assignment array index is unsupported"
          let ty ← mType indexExpression
          unless ty.startsWith "uint" || ty.startsWith "int_const" do
            failAt j "fixed-size memory array index must be unsigned"
          let some arr := (← get).fixedMemArrays.find? id | failAt j "unknown fixed-size memory array"
          let pre := pre ++ key.pre ++ fixedMemBoundsGuard arr key.expr
          return .expr { pre, expr := .mload (fixedMemElementAddr arr key.expr) }
      | .scalarArray id pre =>
          if !key.pre.isEmpty && (statefulCallIn indexExpression (← get) || !pre.isEmpty) then
            failAt j "stateful or assignment array index is unsupported"
          let ty ← mType indexExpression
          unless ty.startsWith "uint" || ty.startsWith "int_const" do
            failAt j "scalar array index must be unsigned"
          let some arr := (← get).scalarArrays.find? id | failAt j "unknown scalar array parameter"
          if !arr.inMemory then
            let pre := pre ++ key.pre ++ #[.ite (.lt key.expr (.localVar arr.lengthBinding))
              [] [.panicCode (.literal 0x32)]]
            let value := Expr.calldataload (.add (.localVar arr.dataBinding) (.mul key.expr (.literal 32)))
            let bound := SolidityAbi.scalarBound arr.abiKind
            let pre := if arr.elementType == "bytes4" then
              pre.push (AbiLowering.guard (.eq (.bitAnd value (.literal (2 ^ 224 - 1))) (.literal 0)))
            else if bound < 2^256 then
              pre.push (AbiLowering.guard (.lt value (.literal bound)))
            else pre
            return .expr { pre, expr := value }
          else
            let pre := (pre ++ key.pre).push (.ite (.lt key.expr (.localVar arr.lengthBinding)) [] [.panicCode (.literal 0x32)])
            let value := Expr.mload (.add (.add (.localVar arr.memoryPointer) (.literal 32)) (.mul key.expr (.literal 32)))
            if let some sid := arr.elemStructId then
              -- `a[i]` of `S[] memory`: a view of the element struct at the
              -- pointer word (read after the bounds check, never copied).
              let elemPtr ← fresh
              let rootId ← structMemArrayElementRoot sid arr.elemFields
              return .abiElement rootId 0 (.localVar elemPtr) true (pre.push (.letVar elemPtr value))
            return .expr { pre, expr := value }
      | .expr baseVal =>
          let baseTy ← mType baseExpression
          if baseTy.startsWith "bytes" then
            if let some byteW := (baseTy.drop 5).toNat? then
              if 1 ≤ byteW && byteW ≤ 32 then
                if statefulCallIn baseExpression (← get) || statefulCallIn indexExpression (← get) ||
                   assignmentIn baseExpression || assignmentIn indexExpression then
                  failAt j "stateful or assignment fixed-bytes index is unsupported"
                let idxTy ← mType indexExpression
                unless (idxTy.startsWith "uint" && (bitsOf idxTy).isSome) ||
                    (idxTy.startsWith "int_const" && !idxTy.startsWith "int_const -") do
                  failAt indexExpression "fixed-bytes index must be unsigned"
                let bAtom ← atom baseVal
                let pre := bAtom.pre ++ key.pre ++ #[.ite (.lt key.expr (.literal byteW)) [] [.panicCode (.literal 0x32)]]
                return .expr { pre, expr := .shl (.literal 248) (.byte key.expr bAtom.expr) }
          failAt j "index of a non-mapping or unsupported ABI value"
      | _ => failAt j "index of a non-mapping or unsupported ABI value"
  | "MemberAccess" =>
      let env ← get
      let member ← mStr (← mField j "memberName")
      let base ← stripParens (← mField j "expression")
      if (← mKind base) == "Identifier" &&
          optStr base "name" == some "block" &&
          optStr ((field? base "typeDescriptions").getD Json.null) "typeIdentifier" == some "t_magic_block" then
        unless (← refInt base) == -4 do failAt base "block does not resolve to the Solidity builtin"
        let expression ← match member with
          | "timestamp" => pure Expr.blockTimestamp
          | "number" => pure Expr.blockNumber
          | "chainid" => pure Expr.chainid
          | "basefee" => pure Expr.baseFee
          | _ => failAt j s!"unsupported block context member {member}"
        pure (.expr { pre := #[], expr := expression })
      else if (← mKind base) == "Identifier" && optStr base "name" == some "msg" &&
          optStr ((field? base "typeDescriptions").getD Json.null) "typeIdentifier" == some "t_magic_message" then
        unless (← refInt base) == -15 do failAt base "msg does not resolve to the Solidity builtin"
        let expression ← match member with
          | "sender" => pure Expr.caller
          | "value" => pure Expr.msgValue
          -- `msg.sig` is the left-aligned `bytes4` of the first calldata word.
          | "sig" => pure (Expr.bitAnd (.calldataload (.literal 0)) (.literal ((2 ^ 32 - 1) * 2 ^ 224)))
          | _ => failAt j s!"unsupported message context member {member}"
        pure (.expr { pre := #[], expr := expression })
      else if (← mKind base) == "Identifier" && optStr base "name" == some "tx" &&
          optStr ((field? base "typeDescriptions").getD Json.null) "typeIdentifier" == some "t_magic_transaction" then
        unless (← refInt base) == -26 do failAt base "tx does not resolve to the Solidity builtin"
        let expression ← match member with
          | "origin" => pure Expr.txOrigin
          | "gasprice" => pure Expr.gasPrice
          | _ => failAt j s!"unsupported transaction context member {member}"
        pure (.expr { pre := #[], expr := expression })
      else if ((← mKind base) == "Identifier" || (← mKind base) == "MemberAccess") &&
          (← mType base).startsWith "type(enum " then
        let baseId ← refInt base
        unless baseId ≥ 0 do failAt base "unresolved enum type"
        let some members := (← get).enums.find? baseId.toNat
          | failAt base s!"unresolved enum {baseId}"
        let some idx := members.findIdx? (· == member)
          | failAt j s!"unknown enum member {member}"
        pure (.expr { pre := #[], expr := .literal idx })
      else if ((← mKind base) == "Identifier" || (← mKind base) == "MemberAccess") &&
          ((← mType base).startsWith "type(library " || (← mType base).startsWith "type(contract ") &&
          ((field? j "referencedDeclaration").bind (·.getInt?.toOption)).any (fun cid => cid ≥ 0 && (env.numericConstants.contains cid.toNat || env.stateVars.contains cid.toNat)) then
        let cid ← refInt j
        let n := cid.toNat
        let some decl := env.numericConstants.find? n <|> env.stateVars.find? n
          | failAt j "unresolved constant member"
        if env.constantStack.contains n then failAt j "cyclic constant initializer"
        let declared ← mType decl
        let initializer ← mField decl "value"
        modify fun e => { e with constantStack := n :: e.constantStack }
        let rawValue ← lowerExprAs declared initializer
        let cval ← convert declared (← mType initializer) rawValue initializer
        modify fun e => { e with constantStack := env.constantStack }
        pure (.expr cval)
      else if member == "length" && (← isAddressCodeAccess base) then
        pure (.expr (← lowerExtCodeSize base))
      else if member == "length" && (← isByteBufferIdent base).isSome then
        let some buf ← isByteBufferIdent base
          | failAt base "internal error: missing byte buffer"
        pure (.expr { pre := buf.pre, expr := buf.size })
      else if member == "length" && (← isMsgDataNode base) then
        pure (.expr { pre := #[], expr := .calldatasize })
      else if member == "length" && (← mKind (← stripParens base)) == "IndexRangeAccess" then
        let some (slicePre, _, lenExpr, _, _) ← lowerCalldataSlice? base
          | failAt base "unsupported slice base for .length"
        pure (.expr { pre := slicePre, expr := lenExpr })
      else if member == "length" && (← mKind base) == "FunctionCall" &&
          optStr base "kind" == some "functionCall" &&
          ((← mType base) == "bytes calldata" || (← mType base) == "bytes memory" || (← mType base) == "bytes") then
        let baseArgs ← mArr (← mField base "arguments")
        if ← isParameterizedCalldataBytesCall base then
          let (fnId, vals) ← resolveCallTargetAndArgs base
          let (pre, cb) ← inlineCalldataBytesFn fnId vals base
          pure (.expr { pre, expr := .localVar cb.lengthBinding })
        else if baseArgs.isEmpty && (← mType base) == "bytes calldata" then
          let pre ← lowerMsgDataExpr base
          pure (.expr { pre, expr := .calldatasize })
        else
          let buf ← lowerEncodedBytes base
          pure (.expr { pre := buf.pre, expr := buf.size })
      else if member == "length" && (← mKind base) == "FunctionCall" &&
          optStr base "kind" == some "typeConversion" &&
          ((← mType base) == "bytes" || (← mType base) == "bytes memory" || (← mType base) == "bytes calldata" ||
           (← mType base) == "bytes storage pointer") then
        let args ← mArr (← mField base "arguments")
        unless args.size == 1 do failAt base "bytes() conversion expects one argument"
        let arg := args[0]!
        let innerArg ← stripParens arg
        if (← mKind innerArg) == "Identifier" then
          let id ← refInt innerArg
          if id ≥ 0 then
            if let some cb := (← get).calldataBytes.find? id.toNat then
              return .expr { pre := #[], expr := .localVar cb.lengthBinding }
        if let some (slicePre, _, lenExpr, _, _) ← lowerCalldataSlice? innerArg then
          return .expr { pre := slicePre, expr := lenExpr }
        if ← isParameterizedCalldataBytesCall innerArg then
          let (fnId, vals) ← resolveCallTargetAndArgs innerArg
          let (pre, cb) ← inlineCalldataBytesFn fnId vals innerArg
          return .expr { pre, expr := .localVar cb.lengthBinding }
        if let some val ← lowerStorageBytesLength? arg then
          return .expr val
        if (← mType base) == "bytes storage pointer" then
          failAt base "bytes() storage conversion requires a resolved storage identifier"
        let buf ← lowerEncodedBytes arg
        pure (.expr { pre := buf.pre, expr := buf.size })
      else if member == "max" || member == "min" then
        lowerTypeBound j base member
      else if member == "interfaceId" then
        lowerInterfaceId j base
      else if member == "selector" && (field? j "referencedDeclaration").isNone then
        lowerSelectorMemberAccess j base
      else if member == "balance" &&
          ((← mType base) == "address" || (← mType base) == "address payable") then
        if ← isThisAddressConv base then
          pure (.expr { pre := #[], expr := .selfBalance })
        else
          failAt j "external account balance reads are outside this slice"
      else if member == "codehash" &&
          ((← mType base) == "address" || (← mType base) == "address payable") &&
          (field? j "referencedDeclaration").isNone then
        pure (.expr (← lowerExtCodeHash j))
      else if member == "code" &&
          ((← mType base) == "address" || (← mType base) == "address payable" ||
           (← mType base).startsWith "contract ") then
        failAt j "external contract code reads are outside this slice"
      else if ((← mKind base) == "FunctionCall" || (← mKind base) == "Conditional" || (← mKind base) == "TupleExpression") &&
          (← mType base).startsWith "struct " && !(← mType base).contains "[" &&
          (← mType base).endsWith " memory" &&
          -- A struct with `bytes` members lives in memory (`lowerRef` below).
          !(← hasBytesStructType base) then
        let (_, sName, initPre, memberVals) ← lowerFlatStructValue base none false
        let some (_, _, mExpr) := memberVals.find? (fun (mName, _, _) => mName == member)
          | failAt j s!"{member} is not a member of {sName}"
        pure (.expr { pre := initPre, expr := mExpr })
      else if (let b := unparenJson base
          optStr b "nodeType" == some "Identifier" && optStr b "name" == some "this" &&
          (field? b "referencedDeclaration").bind (·.getInt?.toOption) == some (-28)) then
        -- `this.f` as a value (an external function of this contract) and its
        -- `.address` / `.selector` members are not the contract's address word.
        failAt j s!"member {member} of this is outside this slice"
      else
        match ← lowerRef base with
        | .path pre path =>
            if let .rawSlot structId baseSlot := path then
              let rawInfo ← resolveRawStructInfo structId j
              if let some subInfo := rawInfo.subStructs.find? (·.member == member) then
                pure (.path pre (.rawSlot subInfo.structId (rawStructMemberSlot baseSlot subInfo.wordOffset)))
              else if let some mapInfo := rawInfo.mappings.find? (·.member == member) then
                pure (.structMapping pre path mapInfo)
              else if let some dynInfo := rawInfo.dynamicArrays.find? (·.member == member) then
                pure (.structDynamicArray pre path dynInfo)
              else if let some arrInfo := rawInfo.fixedArrays.find? (·.member == member) then
                pure (.structFixedArray pre path arrInfo)
              else if let some mInfo := rawInfo.scalars.find? (·.member == member) then
                pure (.expr (← storageEnumRead j (← readRawStructScalar pre baseSlot mInfo)))
              else if let some bInfo := rawInfo.bytesMembers.find? (·.member == member) then
                pure (.path pre (.bytesSlot ("", rawStructMemberSlot baseSlot bInfo.wordOffset) bInfo.isString))
              else if rawInfo.opaqueMemberNames.contains member then
                failAt j s!"{member} of {rawInfo.structName} has a storage type outside this slice"
              else
                failAt j s!"{member} is not a supported member of {rawInfo.structName}"
            else if let .bytesSlot (fieldName, slotExpr) isString := path then
              if ← isStorageStructBytesMember j then
                if fieldName != "" then
                  pure (.state fieldName pre)
                else
                  pure (.path pre (.bytesSlot ("", slotExpr) isString))
              else if member == "length" && !isString then
                pure (.expr (← lowerStorageBytesLength pre fieldName slotExpr))
              else
                failAt j s!"unsupported StorageSlot bytes/string slot member {member}"
            else
              let (rawFieldName, count) ← match path with
                | .zero field => pure (field, 0)
                | .one field _ => pure (field, 1)
                | .two field _ _ => pure (field, 2)
                | .outer _ _ => failAt j "member access on an incomplete mapping"
                | .rawSlot _ _ | .bytesSlot _ _ => failAt j "internal error: unexpected raw/bytes slot path"
              let (fieldName, subPrefix) := splitSPathField rawFieldName
              let qualMember := qualifySPathMember subPrefix member
              let info ← resolveField fieldName j
              if member == "length" && subPrefix == "" && info.fixedArrayLength.isSome then
                let some len := info.fixedArrayLength | failAt j "missing fixed array length"
                pure (.expr { pre, expr := .literal len })
              else if member == "length" && subPrefix == "" && info.bytesStorage && !info.stringStorage && info.keyCount == count then
                markField fieldName
                let (slotStmts, slotExpr) ← computeSPathBaseSlot path info 0 j
                pure (.expr (← lowerStorageBytesLength (pre ++ slotStmts) "" slotExpr))
              else if info.subStructs.any (·.1 == qualMember) then
                pure (.path pre (appendSPathSub path member))
              else if let some arrInfo := info.structFixedArrays.find? (·.member == qualMember) then
                pure (.structFixedArray pre path arrInfo)
              else if let some mapInfo := info.structMappings.find? (·.member == qualMember) then
                pure (.structMapping pre path mapInfo)
              else if let some dynInfo := info.structDynamicArrays.find? (·.member == qualMember) then
                pure (.structDynamicArray pre path dynInfo)
              else
                pure (.expr (← storageEnumRead j (← memberRead pre path member j)))
        | .structFixedArray pre _ arrInfo =>
            unless member == "length" do failAt j s!"unsupported fixed array member {member}"
            pure (.expr { pre, expr := .literal arrInfo.length })
        | .snapshot elements =>
            unless member == "length" do failAt j s!"unsupported fixed array member {member}"
            pure (.expr { pre := #[], expr := .literal elements.size })
        | .flatStruct id =>
            let some flat := (← get).flatStructs.find? id | failAt j "unknown flat struct local"
            if let some (_, _, binding) := flat.members.find? (fun (mName, _, _) => mName == member) then
              pure (.expr { pre := #[], expr := .localVar binding })
            else
              -- A static nested struct member: a view over its leaves'
              -- bindings (under a synthetic id), so reads and writes through
              -- `s.m.x` reach the same bindings as the whole struct.
              let pfx := s!"{member}."
              let sub := flat.members.filterMap fun (mName, mTy, binding) =>
                if mName.startsWith pfx then some ((mName.drop pfx.length).toString, mTy, binding) else none
              if sub.isEmpty then failAt j s!"{member} is not a member of {flat.structName}"
              let (subSid, subDecl) ← resolveStructDeclFromType j
              let subId := 1000000000 + (← get).next
              modify fun e =>
                { e with next := e.next + 1,
                         flatStructs := e.flatStructs.insert subId
                           { structId := subSid, structName := optStr subDecl "name" |>.getD "", members := sub },
                         byRefFlatStructs :=
                           if e.byRefFlatStructs.contains id then subId :: e.byRefFlatStructs.erase subId
                           else e.byRefFlatStructs.filter (· != subId) }
              pure (.flatStruct subId)
        | .mem id pre =>
            let some mem := (← get).mems.find? id | failAt j "unknown ABI root"
            if let some schema := mem.schema then
              if let some i := mem.members.findIdx? (fun p => p.1 == member) then
                if let some (.structArray _ _) := schema[i]? then
                  return .abiArray id i pre
                if let some (.scalarArray _) := schema[i]? then
                  return .abiArray id i pre
                if let some (.bytesField _ _) := schema[i]? then
                  return .abiBytesField id i pre
                if let some (.nestedStruct _ subSid subSname subMembers subSchema) := schema[i]? then
                  let subId := 1000000000 + (← get).next
                  modify fun e => { e with next := e.next + 1 }
                  if mem.calldataLocation then
                    let subStem ← freshAbiStem subSchema false
                    let checks := AbiLowering.nestedStructCalldataHead
                      (.localVar (mem.abiStem ++ "_calldata")) i subSchema.length (subStem ++ "_calldata")
                    let subMem : MemParam :=
                      { structId := subSid
                        param := s!"{mem.param}_{member}"
                        structName := subSname
                        members := subMembers.toArray
                        staticTypes := none
                        calldataLocation := true
                        headBinding := ""
                        schema := some subSchema
                        abiStem := subStem }
                    modify fun e => { e with mems := e.mems.insert subId subMem }
                    return .mem subId (pre ++ checks.toArray)
                  else
                    let subStem ← freshAbiStem subSchema true
                    let loadPtr := Stmt.letVar (subStem ++ "_memory")
                      (mem.memoryMemberWord i)
                    let subMem : MemParam :=
                      { structId := subSid
                        param := s!"{mem.param}_{member}"
                        structName := subSname
                        members := subMembers.toArray
                        staticTypes := none
                        calldataLocation := false
                        headBinding := ""
                        schema := some subSchema
                        abiStem := subStem }
                    modify fun e => { e with mems := e.mems.insert subId subMem }
                    return .mem subId (pre.push loadPtr)
            pure (.expr (← readAbiMember id pre member j))
        | .abiBytesField id memberIndex pre =>
            unless member == "length" do failAt j s!"unsupported bytes member {member}"
            let some mem := (← get).mems.find? id | failAt j "unknown ABI root"
            let some schema := mem.schema | failAt j "missing ABI schema"
            let some (.bytesField _ _) := schema[memberIndex]?
              | failAt j "length requires a schema-checked ABI bytes field"
            if mem.calldataLocation then
              let header ← fresh
              let length ← fresh
              let data ← fresh
              let checks := AbiLowering.calldataBytesFieldHead
                (.localVar (mem.abiStem ++ "_calldata")) memberIndex header length data
              return .expr { pre := pre ++ checks.toArray, expr := .localVar length }
            else
              let bytesPtr := mem.memoryMemberWord memberIndex
              return .expr { pre, expr := .mload bytesPtr }
        | .abiArray id memberIndex pre =>
            unless member == "length" do failAt j s!"unsupported array member {member}"
            let some mem := (← get).mems.find? id | failAt j "unknown ABI root"
            let some schema := mem.schema | failAt j "missing ABI schema"
            let elementWords ← match schema[memberIndex]? with
              | some (.scalarArray _) | some (.bytesArray _) => pure 1
              | some (.structArray _ fields) => pure fields.length
              | _ => failAt j "length requires a schema-checked ABI array"
            if mem.calldataLocation then
              let header ← fresh
              let length ← fresh
              let data ← fresh
              let checks := AbiLowering.staticArrayHead
                (.localVar (mem.abiStem ++ "_calldata")) memberIndex elementWords header length data
              return .expr { pre := pre ++ checks.toArray, expr := .localVar length }
            else
              let array := mem.memoryMemberWord memberIndex
              return .expr { pre, expr := .mload array }
        | .abiElement id memberIndex pointer inMemory pre =>
            let some mem := (← get).mems.find? id | failAt j "unknown ABI root"
            let some schema := mem.schema | failAt j "missing ABI schema"
            let some (.structArray _ fields) := schema[memberIndex]?
              | failAt j "expected a struct-array element"
            let some i := fields.findIdx? (fun f => f.name == member)
              | failAt j s!"unknown struct-array member {member}"
            let some field := fields[i]? | failAt j "missing struct-array field"
            let offset := Expr.add pointer (.literal (32*i))
            let value := if !inMemory then Expr.calldataload offset else Expr.mload offset
            let bound := SolidityAbi.scalarBound field.kind
            let pre := if !inMemory && bound < 2^256 then
              pre.push (AbiLowering.guard (.lt value (.literal bound))) else pre
            pure (.expr { pre, expr := value })
        | .calldataBytes id pre =>
            unless member == "length" do failAt j s!"unsupported bytes member {member}"
            let some cb := (← get).calldataBytes.find? id | failAt j "unknown calldata bytes parameter"
            pure (.expr { pre, expr := .localVar cb.lengthBinding })
        | .scalarArray id pre =>
            unless member == "length" do failAt j s!"unsupported array member {member}"
            let some arr := (← get).scalarArrays.find? id | failAt j "unknown scalar array parameter"
            pure (.expr { pre, expr := .localVar arr.lengthBinding })
        | .fixedMemArray id pre =>
            unless member == "length" do failAt j s!"unsupported array member {member}"
            let some arr := (← get).fixedMemArrays.find? id | failAt j "unknown fixed-size memory array"
            pure (.expr { pre, expr := .literal arr.length })
        | .nestedMemArray id pre =>
            unless member == "length" do failAt j s!"unsupported array member {member}"
            let some arr := (← get).nestedMemArrays.find? id | failAt j "unknown nested memory array"
            pure (.expr { pre, expr := .localVar arr.lengthBinding })
        | .structDynamicArray pre path dynInfo =>
            unless member == "length" do failAt j s!"unsupported array member {member}"
            if let .rawSlot _ baseSlot := path then
              let slotExpr := rawStructMemberSlot baseSlot dynInfo.wordOffset
              let val ← readStorageDynamicArrayLength pre "" slotExpr
              pure (.expr val)
            else
              let rawName ← match path with
                | .zero name | .one name _ | .two name _ _ => pure name
                | .outer _ _ => failAt j "struct dynamic array length requires all outer mapping keys"
                | .rawSlot _ _ | .bytesSlot _ _ =>
                    failAt j "struct dynamic array length requires all outer mapping keys"
              let (name, _) := splitSPathField rawName
              let info ← resolveField name j
              markField name
              markStructDynamicArray name dynInfo.member
              let (slotStmts, slotExpr) ← computeSPathBaseSlot path info dynInfo.wordOffset j
              let val ← readStorageDynamicArrayLength (pre ++ slotStmts) "" slotExpr
              pure (.expr val)
        | .state name pre =>
            let info ← resolveField name j
            if member == "length" && info.dynamicArrayElemType.isSome then
              let val ← readStorageDynamicArrayLength pre name (.literal info.slot)
              return .expr val
            unless member == "length" && info.bytesStorage && !info.stringStorage do
              failAt j s!"unsupported member {member}"
            let val ← lowerStorageBytesLength pre name (.literal info.slot)
            pure (.expr val)
        | _ => failAt j s!"unsupported member {member}"
  | "FunctionCall" =>
      let kind ← mStr (← mField j "kind")
      let ty ← mType j
      if kind == "functionCall" && ty.startsWith "struct " && !ty.contains "[" &&
          (ty.endsWith " storage pointer" || ty.endsWith " storage ref") then
        let callee ← mField j "expression"
        if (← mKind callee) == "MemberAccess" &&
            (field? callee "referencedDeclaration").isNone &&
            optStr callee "memberName" == some "push" then
          let base ← mField callee "expression"
          let baseRef ← lowerRef base
          let some (pre, fieldName, slotExpr, _, _, _, some elemSid) ← resolveStorageDynamicArrayTarget baseRef base
            | failAt callee "storage struct array push target is outside this slice"
          let args ← mArr (← mField j "arguments")
          if args.isEmpty then
            let (pushStmts, pushPath) ← pushStorageDynamicStructArray pre fieldName slotExpr elemSid none j
            return .path pushStmts pushPath
          else if args.size == 1 then
            let arg := args[0]!
            if !pre.isEmpty && (statefulCallIn arg (← get) || assignmentIn arg) then
              failAt arg "storage array push prelude with stateful argument is unsupported"
            let (argSid, _, argPre, memberVals) ← lowerFlatStructValue arg (some elemSid) true
            unless argSid == elemSid do
              failAt arg "storage struct array push argument type mismatch"
            let (pushStmts, pushPath) ← pushStorageDynamicStructArray (pre ++ argPre) fieldName slotExpr elemSid (some memberVals) j
            return .path pushStmts pushPath
          else
            failAt j "storage array push expects at most one argument"
        let (fnId, vals) ← resolveCallTargetAndArgs j
        let (pre, path) ← inlineStorageRefFn fnId vals j
        pure (.path pre path)
      else if (kind == "functionCall" || kind == "structConstructorCall") && (← hasBytesStructType j) then
        let (sid, _) ← resolveStructDeclFromType j
        let (valPre, ptr) ← lowerBytesStructPointer j sid
        let (boundPre, desc) ← bindBytesStructPointer sid valPre ptr j
        let rootId := 1000000000 + (← get).next
        modify fun e => { e with next := e.next + 1, mems := e.mems.insert rootId desc }
        pure (.mem rootId boundPre)
      else
        failAt j s!"unsupported reference FunctionCall ({kind} : {ty})"
  | kind => failAt j s!"unsupported reference {kind}"

private partial def lowerTypeBound (at_ base : Json) (member : String) : M Ref := do
  unless (← mKind base) == "FunctionCall" do
    failAt at_ s!"{member} is only supported on type(T)"
  let callee ← mField base "expression"
  unless (← mKind callee) == "Identifier" && optStr callee "name" == some "type" do
    failAt at_ s!"{member} is only supported on type(T)"
  let args ← mArr (← mField base "arguments")
  unless args.size == 1 do failAt at_ "type() expects one argument"
  let arg := args[0]!
  if (← mKind arg) == "Identifier" || (← mKind arg) == "MemberAccess" then
    let argTy ← mType arg
    if argTy.startsWith "type(enum " then
      let eid ← refInt arg
      unless eid ≥ 0 do failAt arg "unresolved enum type"
      let some members := (← get).enums.find? eid.toNat
        | failAt arg s!"unresolved enum {eid}"
      unless !members.isEmpty && members.size ≤ 256 do
        failAt arg s!"invalid enum member count {members.size}"
      let bound := if member == "max" then members.size - 1 else 0
      return .expr { pre := #[], expr := .literal bound }
  unless (← mKind arg) == "ElementaryTypeNameExpression" do
    failAt at_ "type() expects an elementary type"
  let tname ← mStr (← mField (← mField arg "typeName") "name")
  if let some bits := signedBitsOf tname then
    let bound := if member == "max" then 2 ^ (bits - 1) - 1 else 2 ^ 256 - 2 ^ (bits - 1)
    pure (.expr { pre := #[], expr := .literal bound })
  else if tname.startsWith "uint" then
    let some bits := bitsOf tname | failAt at_ s!"unsupported type().{member} {tname}"
    let bound := if member == "max" then 2 ^ bits - 1 else 0
    pure (.expr { pre := #[], expr := .literal bound })
  else
    failAt at_ s!"unsupported type().{member} {tname}"

private partial def lowerInterfaceId (at_ base : Json) : M Ref := do
  unless (← mKind base) == "FunctionCall" do
    failAt at_ "interfaceId is only supported on type(I)"
  let callee ← mField base "expression"
  unless (← mKind callee) == "Identifier" && optStr callee "name" == some "type" do
    failAt at_ "interfaceId is only supported on type(I)"
  let args ← mArr (← mField base "arguments")
  unless args.size == 1 do failAt at_ "type() expects one argument"
  let arg := args[0]!
  unless (← mKind arg) == "Identifier" || (← mKind arg) == "MemberAccess" do
    failAt arg "type(I).interfaceId expects an interface identifier"
  let cid ← refInt arg
  unless cid ≥ 0 do failAt arg "unresolved interface type"
  let env ← get
  unless env.contractKinds.find? cid.toNat == some "interface" do
    failAt arg "type(I).interfaceId requires an interface type"
  let some nodes := env.contractNodes.find? cid.toNat
    | failAt arg s!"unresolved interface definition {cid}"
  let mut acc : Nat := 0
  for node in nodes do
    if let some hex := optStr node "functionSelector" then
      unless hex.length == 8 do
        failAt node s!"invalid functionSelector hex length {hex.length}"
      let chars := hex.toList.toArray
      let mut word := 0
      for index in [:chars.size] do
        let some digit := Compiler.Hex.hexCharToNat? chars[index]!
          | failAt node "invalid functionSelector hex digit"
        word := word * 16 + digit
      acc := Nat.xor acc word
  return .expr { pre := #[], expr := .literal (acc * 16 ^ 56) }

private partial def lowerSelectorMemberAccess (at_ base : Json) : M Ref := do
  unless (← mType at_) == "bytes4" do
    failAt at_ "function .selector member access is outside this slice"
  let parseSelectorHex (node : Json) (hex : String) : M Ref := do
    unless hex.length == 8 do
      failAt node s!"invalid selector hex length {hex.length}"
    let chars := hex.toList.toArray
    let mut word := 0
    for index in [:chars.size] do
      let some digit := Compiler.Hex.hexCharToNat? chars[index]!
        | failAt node "invalid selector hex digit"
      word := word * 16 + digit
    return .expr { pre := #[], expr := .literal (word * 16 ^ 56) }
  if (← mKind base) == "MemberAccess" then
    let receiver ← mField base "expression"
    unless ← isPureSelectorReceiver receiver do
      failAt receiver "selector receiver must be a contract/interface type, this, or a local/parameter"
    let declId ← refInt base
    unless declId ≥ 0 do
      failAt at_ "function .selector member access is outside this slice"
    let env ← get
    if let some decl := (env.funs.find? declId.toNat <|> env.stateVars.find? declId.toNat) then
      let some hex := optStr decl "functionSelector"
        | failAt at_ "function .selector member access is outside this slice"
      return ← parseSelectorHex base hex
    if let some errDecl := env.errorDecls.find? declId.toNat then
      let some hex := optStr errDecl "errorSelector"
        | failAt at_ "function .selector member access is outside this slice"
      return ← parseSelectorHex base hex
    failAt at_ "function .selector member access is outside this slice"
  else if (← mKind base) == "Identifier" then
    let declId ← refInt base
    if declId ≥ 0 then
      if let some errDecl := (← get).errorDecls.find? declId.toNat then
        if let some hex := optStr errDecl "errorSelector" then
          return ← parseSelectorHex base hex
    failAt at_ "function .selector member access is outside this slice"
  else
    failAt at_ "function .selector member access is outside this slice"

/-- Lower `j` where solc expects a value of type `ty`: a string literal in a `bytesN`
context is its left-aligned word, anything else is `lowerExpr j`. -/
private partial def lowerExprAs (ty : String) (j : Json) : M Val := do
  if let some word ← fixedBytesStringLiteral? ty j then
    return word
  lowerExpr j

/-- `lowerExprAs ty j` followed by solc's implicit conversion of `j` to `ty`. -/
private partial def lowerConverted (ty : String) (j : Json) : M Val := do
  convert ty (← mType j) (← lowerExprAs ty j) j

private partial def lowerBinary (j : Json) : M Val := do
  let op ← mStr (← mField j "operator")
  let leftNode ← mField j "leftExpression"
  let rightNode ← mField j "rightExpression"
  if let some test ← lowerThisCodeLengthZeroTest? op leftNode rightNode then
    return test
  let env ← get
  let admittedComparison := ["==", "!=", "<", "<=", ">", ">="].contains op &&
    ((field? j "function").bind (·.getNat?.toOption)).isNone &&
    !assignmentIn leftNode && !assignmentIn rightNode &&
    !memoryWriteOrderHazard leftNode rightNode env
  let hasStatefulComparison := !env.forwardingBytesTuple && admittedComparison &&
    (statefulCallIn leftNode env || statefulCallIn rightNode env)
  let admittedCall := admittedComparison ||
    ((op == "==" || op == "!=") && !env.admittedInterfaceCalls.isEmpty &&
    ((((field? (unparenJson leftNode) "id").bind (·.getNat?.toOption)).any env.admittedInterfaceCalls.contains &&
      !statefulCallIn rightNode env && !assignmentIn rightNode) ||
     (((field? (unparenJson rightNode) "id").bind (·.getNat?.toOption)).any env.admittedInterfaceCalls.contains &&
      !statefulCallIn leftNode env && !assignmentIn leftNode))) ||
    -- `local + helper()`: legacy evaluates the right operand first, via-IR the left one. A
    -- left identifier bound to a local or parameter (or to a literal, an immutable or a
    -- transaction-context value such as `block.timestamp`, not `address(this).balance`), or
    -- naming a constant (contract or file level) or an `immutable` state variable, reads a
    -- value no call can change, so both orders agree with solc for any state-variable count.
    -- A mutable state variable is not admitted: `total + bump()` with `bump` writing `total`
    -- reads the written value on legacy and the old one on via-IR (solc 0.8.34: 24 vs 19).
    (op == "+" && (← mKind leftNode) == "Identifier" &&
      ((field? leftNode "referencedDeclaration").bind (·.getNat?.toOption)).any (fun id =>
        (env.values.find? id).any (fun
          | .localVar _ | .param _ | .literal _ | .immutable _ | .blockTimestamp | .blockNumber
          | .caller | .contractAddress | .chainid | .txOrigin | .baseFee | .gasPrice => true
          | _ => false) ||
        env.numericConstants.contains id ||
        (env.stateVars.find? id).any (fun decl => optStr decl "mutability" == some "immutable")))
  unless op == "&&" || op == "||" || (admittedCall && !env.forwardingBytesTuple) do
    if statefulCallIn leftNode env ||
        statefulCallIn rightNode env then
      failAt j "stateful helper operands require explicit evaluation-order support"
    -- solc evaluates binary operands right-to-left on the legacy pipeline and
    -- left-to-right under via-IR; a helper writing memory the other operand
    -- reads makes that observable.
    if memoryWriteOrderHazard leftNode rightNode env then
      failAt j "memory-writing helper operands require explicit evaluation-order support"
  let commonTy := (field? j "commonType").bind (optStr · "typeString") |>.getD ""
  let (initLeft, initRight) ←
    if hasStatefulComparison && !env.viaIR then do
      let r ← lowerExprAs commonTy rightNode
      let l ← lowerExprAs commonTy leftNode
      pure (l, r)
    else do
      let l ← lowerExprAs commonTy leftNode
      let r ← lowerExprAs commonTy rightNode
      pure (l, r)
  let mut left := initLeft
  let mut right := initRight
  unless op == "&&" || op == "||" do
    if (assignmentIn leftNode && (!right.pre.isEmpty || !isOrderIndependentSibling right.expr)) ||
        (assignmentIn rightNode && (!left.pre.isEmpty || !isOrderIndependentSibling left.expr)) then
      failAt j "assignment operand with non-atomic sibling requires explicit evaluation-order support"
    -- Reorder at each eager binary node, not just the ancestor of a slice.
    -- A literal has no effects to order; leave its empty prelude intact for
    -- checked exponentiation and other constant-sensitive lowerings.
    -- An overloaded operator is a positional function call on both pipelines.
    if !hasStatefulComparison && !env.viaIR &&
        ((field? j "function").bind (·.getNat?.toOption)).isNone &&
        !right.pre.isEmpty && !isConstLiteralVal left then
      let b ← atom right
      let a ← atom left
      left := { pre := b.pre ++ a.pre, expr := a.expr }
      right := { pre := #[], expr := b.expr }
  if let some fnId := (field? j "function").bind (fun v => v.getNat?.toOption) then
    let targetId := resolveInContracts env env.linearizedBases.toList fnId |>.getD fnId
    return ← inlineFn targetId #[.scalar left, .scalar right] j
  let common ← mStr (← mField (← mField j "commonType") "typeString")
  -- Solidity folds literal sums in unbounded integer arithmetic. Admit only
  -- exact natural literals whose sum remains representable as an EVM word.
  if common.startsWith "int_const" && op == "+" then
    if left.pre.isEmpty && right.pre.isEmpty then
      if let .literal a := left.expr then
        if let .literal b := right.expr then
          let sum := a + b
          if sum < 2 ^ 256 then return { pre := #[], expr := .literal sum }
    failAt j "unsupported integer constant sum"
  if common.startsWith "int_const" && !common.startsWith "int_const -" && op == "-" then
    let leftTy ← mType (← mField j "leftExpression")
    let rightTy ← mType (← mField j "rightExpression")
    if !leftTy.startsWith "int_const -" && !rightTy.startsWith "int_const -" &&
        left.pre.isEmpty && right.pre.isEmpty then
      if let .literal a := left.expr then
        if let .literal b := right.expr then
          if a ≥ b && a - b < 2 ^ 256 then
            return { pre := #[], expr := .literal (a - b) }
    failAt j s!"unsupported operand type {common}"
  -- Products of exact natural literals use Solidity's unbounded constant arithmetic.
  if common.startsWith "int_const" && op == "*" then
    if left.pre.isEmpty && right.pre.isEmpty then
      if let .literal a := left.expr then
        if let .literal b := right.expr then
          let product := a * b
          if product < 2 ^ 256 then return { pre := #[], expr := .literal product }
    failAt j "unsupported integer constant product"
  if common.startsWith "int_const" && op == "**" then
    if left.pre.isEmpty && right.pre.isEmpty then
      if let .literal a := left.expr then
        if let .literal b := right.expr then
          if a ≤ 1 || b < 256 then
            let power := a ^ b
            if power < 2 ^ 256 then return { pre := #[], expr := .literal power }
    failAt j s!"unsupported operand type {common}"
  if common.startsWith "int_const" && !common.startsWith "int_const -" && op == "<<" then
    let leftTy ← mType (← mField j "leftExpression")
    let rightTy ← mType (← mField j "rightExpression")
    if !leftTy.startsWith "int_const -" && !rightTy.startsWith "int_const -" &&
        left.pre.isEmpty && right.pre.isEmpty then
      if let .literal a := left.expr then
        if let .literal b := right.expr then
          if a == 0 || b < 256 then
            let shifted := a * 2 ^ b
            if shifted < 2 ^ 256 then return { pre := #[], expr := .literal shifted }
    failAt j s!"unsupported operand type {common}"
  if common.startsWith "int_const" && !common.startsWith "int_const -" && op == ">>" then
    let leftTy ← mType (← mField j "leftExpression")
    let rightTy ← mType (← mField j "rightExpression")
    if !leftTy.startsWith "int_const -" && !rightTy.startsWith "int_const -" &&
        left.pre.isEmpty && right.pre.isEmpty then
      if let .literal a := left.expr then
        if let .literal b := right.expr then
          let shifted := if b >= 256 then 0 else a / 2 ^ b
          if shifted < 2 ^ 256 then return { pre := #[], expr := .literal shifted }
    failAt j s!"unsupported operand type {common}"
  -- Legacy wrapping add/sub/mul leave the full EVM result on the stack. A
  -- same-width Yul read observes it; the next Solidity value consumer cleans it.
  let rawArithmetic := !env.viaIR && env.unchecked && ["+", "-", "*"].contains op
  let operand (node : Json) (v : Val) : M Val := do
    let ty ← mType node
    if ["&&", "||"].contains op then return v
    if ty != "bool" && (bitsOf ty).isNone && (signedBitsOf ty).isNone &&
        (fixedBytesWidth? ty).isNone then return v
    if (rawArithmetic || ["&", "|", "^"].contains op) && ty == common then return v
    return { v with expr := cleanHelperResultExpr ty v }
  left ← operand leftNode left
  right ← operand rightNode right
  if rawArithmetic && (common.startsWith "uint" || (signedBitsOf common).isSome) then
    let bin := if op == "+" then Expr.add else if op == "-" then Expr.sub else Expr.mul
    return ← cmp bin left right
  let signedBits? := signedBitsOf common
  let isSigned := signedBits?.isSome
  let isSigned256 := signedBits? == some 256
  if common == "bytes4" && op != "<<" && op != ">>" then
    let leftTy ← mType (← mField j "leftExpression")
    let rightTy ← mType (← mField j "rightExpression")
    if leftTy != "bytes4" || rightTy != "bytes4" then
      unless op == "==" || op == "!=" do
        failAt j "implicit constant conversion to bytes4 is outside this slice"
      left ← convert "bytes4" leftTy left leftNode
      right ← convert "bytes4" rightTy right rightNode
  else if let some bw := fixedBytesWidth? common then
    if bw < 32 && op != "<<" && op != ">>" then
      let leftTy ← mType (← mField j "leftExpression")
      let rightTy ← mType (← mField j "rightExpression")
      let fixedOrLiteral := fun (ty : String) =>
        (fixedBytesWidth? ty).isSome || ty.startsWith "literal_string " ||
        (ty.startsWith "int_const" && !ty.startsWith "int_const -")
      unless fixedOrLiteral leftTy && fixedOrLiteral rightTy do
        failAt j s!"implicit constant conversion to {common} is outside this slice"
      left ← convert common leftTy left leftNode
      right ← convert common rightTy right rightNode
  unless (bitsOf common).isSome || common == "bool" || (fixedBytesWidth? common).isSome || isSigned do
    failAt j s!"unsupported operand type {common}"
  if hasStatefulComparison then
    if env.viaIR then
      let a ← captureAssignedValue left
      let b ← captureAssignedValue right
      left := { pre := a.pre ++ b.pre, expr := a.expr }
      right := { pre := #[], expr := b.expr }
    else
      let b ← captureAssignedValue right
      let a ← captureAssignedValue left
      left := { pre := b.pre ++ a.pre, expr := a.expr }
      right := { pre := #[], expr := b.expr }
  match op with
  | "&&" | "||" =>
      unless common == "bool" do failAt j s!"unsupported logical operand type {common}"
      let a ← atom left
      let dest ← fresh
      -- Solidity evaluates the RHS only when the LHS does not determine the
      -- result. Keep its guards and helper prelude inside the selected branch.
      let rhs := right.pre.push (.assignVar dest right.expr)
      let branch := if op == "&&" then Stmt.ite a.expr rhs.toList []
        else Stmt.ite a.expr [] rhs.toList
      pure { pre := a.pre.push (.letVar dest a.expr) |>.push branch,
             expr := .localVar dest }
  | "+" =>
      if let some bits := signedBits? then
        if bits == 256 then
          if (← get).unchecked then
            let a ← atom left
            let b ← atom right
            pure { pre := a.pre ++ b.pre, expr := .add a.expr b.expr }
          else
            checkedSignedAdd left right
        else
          let a ← atom left
          let b ← atom right
          let raw := Expr.add a.expr b.expr
          let ext := Expr.signextend (.literal (bits / 8 - 1)) raw
          if (← get).unchecked then
            pure { pre := a.pre ++ b.pre, expr := ext }
          else
            let sumVar ← fresh
            let dest ← fresh
            let sum := Expr.localVar sumVar
            let ok := Stmt.assignVar dest sum
            let check := iteStmt (.eq sum (.signextend (.literal (bits / 8 - 1)) sum)) ok overflowPanic
            pure { pre := a.pre ++ b.pre |>.push (.letVar sumVar raw) |>.push (.letVar dest (.literal 0)) |>.push check,
                   expr := .localVar dest }
      else
        unless common.startsWith "uint" do failAt j s!"unsupported add type {common}"
        let some bits := bitsOf common | failAt j s!"unsupported add type {common}"
        if (← get).unchecked then
          let a ← atom left
          let b ← atom right
          let wrapped := if bits < 256 then Expr.bitAnd (.add a.expr b.expr) (.literal (2 ^ bits - 1)) else .add a.expr b.expr
          pure { pre := a.pre ++ b.pre, expr := wrapped }
        else
          checkedAdd bits left right
  | "-" =>
      if let some bits := signedBits? then
        if bits == 256 then
          if (← get).unchecked then
            let a ← atom left
            let b ← atom right
            pure { pre := a.pre ++ b.pre, expr := .sub a.expr b.expr }
          else
            checkedSignedSub left right
        else
          let a ← atom left
          let b ← atom right
          let raw := Expr.sub a.expr b.expr
          let ext := Expr.signextend (.literal (bits / 8 - 1)) raw
          if (← get).unchecked then
            pure { pre := a.pre ++ b.pre, expr := ext }
          else
            let diffVar ← fresh
            let dest ← fresh
            let diff := Expr.localVar diffVar
            let ok := Stmt.assignVar dest diff
            let check := iteStmt (.eq diff (.signextend (.literal (bits / 8 - 1)) diff)) ok overflowPanic
            pure { pre := a.pre ++ b.pre |>.push (.letVar diffVar raw) |>.push (.letVar dest (.literal 0)) |>.push check,
                   expr := .localVar dest }
      else
        unless common.startsWith "uint" do failAt j s!"unsupported sub type {common}"
        let some bits := bitsOf common | failAt j s!"unsupported sub type {common}"
        if (← get).unchecked then
          let a ← atom left
          let b ← atom right
          let wrapped := if bits < 256 then Expr.bitAnd (.sub a.expr b.expr) (.literal (2 ^ bits - 1)) else .sub a.expr b.expr
          pure { pre := a.pre ++ b.pre, expr := wrapped }
        else
          checkedSub left right
  | "*" =>
      if let some bits := signedBits? then
        if bits == 256 then
          if (← get).unchecked then
            let a ← atom left
            let b ← atom right
            pure { pre := a.pre ++ b.pre, expr := .mul a.expr b.expr }
          else
            checkedSignedMul left right
        else
          let a ← atom left
          let b ← atom right
          let raw := Expr.mul a.expr b.expr
          let ext := Expr.signextend (.literal (bits / 8 - 1)) raw
          if (← get).unchecked then
            pure { pre := a.pre ++ b.pre, expr := ext }
          else
            let product ← checkedSignedMul left right
            let ext := Expr.signextend (.literal (bits / 8 - 1)) product.expr
            let guard := Stmt.ite (.eq product.expr ext) [] [overflowPanic]
            pure { product with pre := product.pre.push guard }
      else
        unless common.startsWith "uint" do failAt j s!"unsupported mul type {common}"
        let some bits := bitsOf common | failAt j s!"unsupported mul type {common}"
        if (← get).unchecked then
          let a ← atom left
          let b ← atom right
          let wrapped := if bits < 256 then Expr.bitAnd (.mul a.expr b.expr) (.literal (2 ^ bits - 1)) else .mul a.expr b.expr
          pure { pre := a.pre ++ b.pre, expr := wrapped }
        else
          checkedMul bits left right
  | "**" =>
      let leftTy ← mType (← mField j "leftExpression")
      let rightTy ← mType (← mField j "rightExpression")
      unless common.startsWith "uint" &&
          (leftTy.startsWith "uint" || (leftTy.startsWith "int_const" && !leftTy.startsWith "int_const -")) &&
          (rightTy.startsWith "uint" || (rightTy.startsWith "int_const" && !rightTy.startsWith "int_const -")) do
        failAt j s!"unsupported exp type {common}"
      let some bits := bitsOf common | failAt j s!"unsupported exp type {common}"
      if (← get).unchecked then
        let a ← atom left
        let b ← atom right
        let raw := Expr.externalCall builtinExpName [a.expr, b.expr]
        let wrapped := if env.viaIR && bits < 256 then Expr.bitAnd raw (.literal (2 ^ bits - 1)) else raw
        pure { pre := a.pre ++ b.pre, expr := wrapped }
      else
        checkedExp bits left right j
  | "<<" =>
      let rightTy ← mType (← mField j "rightExpression")
      unless rightTy.startsWith "uint" || (rightTy.startsWith "int_const" && !rightTy.startsWith "int_const -") do
        failAt j s!"shift amount must be unsigned, found {rightTy}"
      let a ← atom left
      let b ← atom right
      if isSigned256 || common == "bytes32" ||
          (!env.viaIR && (isSigned || common.startsWith "uint")) then
        pure { pre := a.pre ++ b.pre, expr := .shl b.expr a.expr }
      else if let some bw := fixedBytesWidth? common then
        let shifted := if bw < 32 then
          cleanHelperResultExpr common { pre := #[], expr := .shl b.expr a.expr }
        else .shl b.expr a.expr
        pure { pre := a.pre ++ b.pre, expr := shifted }
      else if let some bits := signedBits? then
        let shifted := Expr.signextend (.literal (bits / 8 - 1)) (.shl b.expr a.expr)
        pure { pre := a.pre ++ b.pre, expr := shifted }
      else if common.startsWith "uint" then
        let some bits := bitsOf common | failAt j s!"unsupported shift type {common}"
        let shifted := if bits < 256 then Expr.bitAnd (.shl b.expr a.expr) (.literal (2 ^ bits - 1)) else .shl b.expr a.expr
        pure { pre := a.pre ++ b.pre, expr := shifted }
      else
        failAt j s!"unsupported shift type {common}"
  | ">>" =>
      let rightTy ← mType (← mField j "rightExpression")
      unless rightTy.startsWith "uint" || (rightTy.startsWith "int_const" && !rightTy.startsWith "int_const -") do
        failAt j s!"shift amount must be unsigned, found {rightTy}"
      let a ← atom left
      let b ← atom right
      if isSigned then
        pure { pre := a.pre ++ b.pre, expr := .sar b.expr a.expr }
      else if (common.startsWith "uint" && (bitsOf common).isSome) || common == "bytes32" then
        pure { pre := a.pre ++ b.pre, expr := .shr b.expr a.expr }
      else if let some bw := fixedBytesWidth? common then
        let shifted := if bw < 32 then
          cleanHelperResultExpr common { pre := #[], expr := .shr b.expr a.expr }
        else .shr b.expr a.expr
        pure { pre := a.pre ++ b.pre, expr := shifted }
      else
        failAt j s!"unsupported shift type {common}"
  | "&" | "|" | "^" =>
      unless (common.startsWith "uint" && (bitsOf common).isSome) || (fixedBytesWidth? common).isSome || isSigned do
        failAt j s!"unsupported bitwise operand type {common}"
      let a ← atom left
      let b ← atom right
      let bitOp := if op == "&" then Expr.bitAnd else if op == "|" then Expr.bitOr else Expr.bitXor
      pure { pre := a.pre ++ b.pre, expr := bitOp a.expr b.expr }
  | "/" =>
      if let some bits := signedBits? then
        let v ← signedDiv env.unchecked left right
        if bits < 256 && !env.unchecked then
          let ext := Expr.signextend (.literal (bits / 8 - 1)) v.expr
          let guard := Stmt.ite (.eq v.expr ext) [] [overflowPanic]
          return { v with pre := v.pre.push guard }
        -- Both pipelines clean the operands of SDIV but keep its quotient.
        -- In unchecked code min / -1 has its sign bit clear at EVM width.
        pure v
      else
        unless common.startsWith "uint" do failAt j s!"unsupported div type {common}"
        checkedDiv left right
  | "%" =>
      if signedBits?.isSome then
        signedModulo left right
      else
        unless common.startsWith "uint" do failAt j "modulo requires integer scalar operands"
        checkedModulo left right
  | "<" =>
      if isSigned then cmp .slt left right else cmp .lt left right
  | ">" =>
      if isSigned then cmp .sgt left right else cmp .gt left right
  | "<=" =>
      if isSigned then
        let v ← cmp .sgt left right
        pure { v with expr := .logicalNot v.expr }
      else
        cmp .le left right
  | ">=" =>
      if isSigned then
        let v ← cmp .slt left right
        pure { v with expr := .logicalNot v.expr }
      else
        cmp .ge left right
  | "==" => cmp .eq left right
  | "!=" =>
      let v ← cmp .eq left right
      pure { v with expr := .logicalNot v.expr }
  | _ => failAt j s!"unsupported operator {op}"

private partial def isConstLiteralVal (v : Val) : Bool :=
  v.pre.isEmpty && match v.expr with | .literal _ => true | _ => false

private partial def checkedExp (bits : Nat) (left right : Val) (at_ : Json) : M Val := do
  unless isConstLiteralVal left || isConstLiteralVal right do
    failAt at_ "checked exponentiation with dynamic base and exponent is outside this slice"
  if left.pre.isEmpty then
    if let .literal baseVal := left.expr then
      let b ← atom right
      if baseVal == 0 then
        return { pre := b.pre, expr := .eq b.expr (.literal 0) }
      else if baseVal == 1 then
        return { pre := b.pre, expr := .literal 1 }
      else
        let dest ← fresh
        let maxExp := maxSafeExponent baseVal bits
        let ok := Stmt.assignVar dest (.externalCall builtinExpName [.literal baseVal, b.expr])
        let ite := iteStmt (.lt (.literal maxExp) b.expr) overflowPanic ok
        return { pre := b.pre.push (.letVar dest (.literal 0)) |>.push ite, expr := .localVar dest }
  if right.pre.isEmpty then
    if let .literal expVal := right.expr then
      let a ← atom left
      if expVal == 0 then
        return { pre := a.pre, expr := .literal 1 }
      else if expVal == 1 then
        return a
      else
        let dest ← fresh
        let maxBase := maxSafeBase expVal bits
        let ok := Stmt.assignVar dest (.externalCall builtinExpName [a.expr, .literal expVal])
        let ite := iteStmt (.lt (.literal maxBase) a.expr) overflowPanic ok
        return { pre := a.pre.push (.letVar dest (.literal 0)) |>.push ite, expr := .localVar dest }
  let a ← atom left
  let b ← atom right
  pure { pre := a.pre ++ b.pre, expr := .externalCall builtinExpName [a.expr, b.expr] }

private partial def checkedSub (left right : Val) : M Val := do
  let a ← atom left
  let b ← atom right
  let dest ← fresh
  let ok := Stmt.assignVar dest (.sub a.expr b.expr)
  let ite := iteStmt (.lt a.expr b.expr) overflowPanic ok
  pure { pre := a.pre ++ b.pre |>.push (.letVar dest (.literal 0)) |>.push ite, expr := .localVar dest }

private partial def checkedDiv (left right : Val) : M Val := do
  let a ← atom left
  let b ← atom right
  let dest ← fresh
  let ok := Stmt.assignVar dest (.div a.expr b.expr)
  let ite := iteStmt (.eq b.expr (.literal 0)) divPanic ok
  pure { pre := a.pre ++ b.pre |>.push (.letVar dest (.literal 0)) |>.push ite, expr := .localVar dest }

private partial def checkedModulo (left right : Val) : M Val := do
  let a ← atom left
  let b ← atom right
  let dest ← fresh
  let moduloResult := Stmt.assignVar dest (.mod a.expr b.expr)
  let moduloGuard := iteStmt (.eq b.expr (.literal 0)) divPanic moduloResult
  pure { pre := a.pre ++ b.pre |>.push (.letVar dest (.literal 0)) |>.push moduloGuard,
         expr := .localVar dest }

private partial def checkedAdd (bits : Nat) (left right : Val) : M Val := do
  let a ← atom left
  let b ← atom right
  let dest ← fresh
  let sum := Expr.add a.expr b.expr
  let ok := Stmt.assignVar dest sum
  let cond :=
    if bits == 256 then Expr.lt sum a.expr
    else Expr.lt (.literal (2 ^ bits - 1)) sum
  pure { pre := a.pre ++ b.pre |>.push (.letVar dest (.literal 0)) |>.push (iteStmt cond overflowPanic ok),
         expr := .localVar dest }

private partial def checkedMul (bits : Nat) (left right : Val) : M Val := do
  let a ← atom left
  let b ← atom right
  let dest ← fresh
  let prod := Expr.mul a.expr b.expr
  let ok := Stmt.assignVar dest prod
  -- Check the EVM-width product before the Solidity-width bound. For e.g.
  -- uint248, an overflowing 256-bit product can wrap below the uint248 bound.
  let bounded := if bits == 256 then ok
    else iteStmt (.lt (.literal (2 ^ bits - 1)) prod) overflowPanic ok
  let inner := iteStmt (.eq (.div prod a.expr) b.expr) bounded overflowPanic
  let ite := iteStmt (.eq a.expr (.literal 0)) bounded inner
  pure { pre := a.pre ++ b.pre |>.push (.letVar dest (.literal 0)) |>.push ite, expr := .localVar dest }

private partial def checkedSignedAdd (left right : Val) : M Val := do
  let a ← atom left
  let b ← atom right
  let sumVar ← fresh
  let dest ← fresh
  let sum := Expr.localVar sumVar
  let ok := Stmt.assignVar dest sum
  let nonNegB := iteStmt (.slt sum a.expr) overflowPanic ok
  let negB := iteStmt (.sgt sum a.expr) overflowPanic ok
  let check := Stmt.ite (.slt b.expr (.literal 0)) [negB] [nonNegB]
  pure { pre := a.pre ++ b.pre |>.push (.letVar sumVar (.add a.expr b.expr)) |>.push (.letVar dest (.literal 0)) |>.push check,
         expr := .localVar dest }

private partial def checkedSignedSub (left right : Val) : M Val := do
  let a ← atom left
  let b ← atom right
  let diffVar ← fresh
  let dest ← fresh
  let diff := Expr.localVar diffVar
  let ok := Stmt.assignVar dest diff
  let negB := iteStmt (.slt diff a.expr) overflowPanic ok
  let nonNegB := iteStmt (.sgt diff a.expr) overflowPanic ok
  let check := Stmt.ite (.slt b.expr (.literal 0)) [negB] [nonNegB]
  pure { pre := a.pre ++ b.pre |>.push (.letVar diffVar (.sub a.expr b.expr)) |>.push (.letVar dest (.literal 0)) |>.push check,
         expr := .localVar dest }

private partial def checkedSignedMul (left right : Val) : M Val := do
  let a ← atom left
  let b ← atom right
  let prodVar ← fresh
  let dest ← fresh
  let prod := Expr.localVar prodVar
  let ok := Stmt.assignVar dest prod
  let minTimesNegOne := iteStmt (.eq b.expr (.literal (2 ^ 255))) overflowPanic ok
  let divCheck := iteStmt (.eq (.sdiv prod a.expr) b.expr)
    (iteStmt (.eq a.expr (.literal (2 ^ 256 - 1))) minTimesNegOne ok)
    overflowPanic
  let check := iteStmt (.eq a.expr (.literal 0)) ok divCheck
  pure { pre := a.pre ++ b.pre |>.push (.letVar prodVar (.mul a.expr b.expr)) |>.push (.letVar dest (.literal 0)) |>.push check,
         expr := .localVar dest }

private partial def signedDiv (isUnchecked : Bool) (left right : Val) : M Val := do
  let a ← atom left
  let b ← atom right
  let dest ← fresh
  let ok := Stmt.assignVar dest (.sdiv a.expr b.expr)
  let nonZero :=
    if isUnchecked then
      ok
    else
      iteStmt (.eq a.expr (.literal (2 ^ 255)))
        (iteStmt (.eq b.expr (.literal (2 ^ 256 - 1))) overflowPanic ok)
        ok
  let check := iteStmt (.eq b.expr (.literal 0)) divPanic nonZero
  pure { pre := a.pre ++ b.pre |>.push (.letVar dest (.literal 0)) |>.push check,
         expr := .localVar dest }

/-- Solidity signed `%`: EVM `smod` (truncated remainder, carrying the sign of
the dividend, so `(-7) % 4 == -3`) after the zero-divisor guard (`Panic(0x12)`).
Unlike `/` it cannot overflow (`type(intN).min % -1 == 0`), and Solidity 0.8
keeps the zero-divisor guard inside `unchecked`. For narrow `intN` the
sign-extended operands give an in-range, already sign-extended result. -/
private partial def signedModulo (left right : Val) : M Val := do
  let a ← atom left
  let b ← atom right
  let dest ← fresh
  let ok := Stmt.assignVar dest (.smod a.expr b.expr)
  let check := iteStmt (.eq b.expr (.literal 0)) divPanic ok
  pure { pre := a.pre ++ b.pre |>.push (.letVar dest (.literal 0)) |>.push check,
         expr := .localVar dest }

private partial def cmp (op : Expr → Expr → Expr) (left right : Val) : M Val := do
  -- A comparison of pure words (including cleanup masks) is itself pure.
  -- In particular a while guard must reevaluate these expressions each iteration.
  if left.pre.isEmpty && right.pre.isEmpty then
    return { pre := #[], expr := op left.expr right.expr }
  let a ← atom left
  let b ← atom right
  pure { pre := a.pre ++ b.pre, expr := op a.expr b.expr }

private partial def lowerConditional (j : Json) : M Val := do
  let cond ← atom (← lowerExpr (← mField j "condition"))
  let ty ← mType j
  let lowerArm (node : Json) : M Val := do
    let raw ← lowerExpr node
    if ty.startsWith "uint" || (signedBitsOf ty).isSome || (fixedBytesWidth? ty).isSome ||
        ty == "address" || ty == "address payable" || ty.startsWith "contract " then
      convert ty (← mType node) raw node
    else pure raw
  let yes ← lowerArm (← mField j "trueExpression")
  let no ← lowerArm (← mField j "falseExpression")
  let dest ← fresh
  let thenB := yes.pre.push (.assignVar dest yes.expr)
  let elseB := no.pre.push (.assignVar dest no.expr)
  let ite := Stmt.ite cond.expr thenB.toList elseB.toList
  pure { pre := cond.pre.push (.letVar dest (.literal 0)) |>.push ite, expr := .localVar dest }

private partial def lowerCast (j : Json) : M Val := do
  let targetExpr ← mField j "expression"
  let args ← mArr (← mField j "arguments")
  unless args.size == 1 do failAt j "cast expects one argument"
  let callTy ← mType j
  if callTy.startsWith "contract " then
    let v ← lowerExpr args[0]!
    let src ← mType args[0]!
    unless src == "address" || src == "address payable" || src.startsWith "contract " do
      failAt j s!"unsupported contract cast source {src}"
    return if !(← get).viaIR || src == callTy then v
      else { v with expr := cleanHelperResultExpr src v }
  if callTy.startsWith "enum " then
    let members ← resolveEnumMembers targetExpr callTy
    let v ← lowerExpr args[0]!
    let src ← mType args[0]!
    if src == callTy then
      return v
    unless (src.startsWith "uint" && (bitsOf src).isSome) ||
        src == "int256" || src == "int" || src.startsWith "int_const" do
      failAt j s!"unsupported enum cast source {src} for {callTy}"
    let a ← atom { v with expr := cleanHelperResultExpr src v }
    let dest ← fresh
    let check := Stmt.ite (.lt a.expr (.literal members.size))
      [.assignVar dest a.expr] [.panicCode (.literal 0x21)]
    return { pre := a.pre.push (.letVar dest (.literal 0)) |>.push check,
             expr := .localVar dest }
  unless (← mKind targetExpr) == "ElementaryTypeNameExpression" do
    failAt j "unsupported cast"
  let tname ← mStr (← mField (← mField targetExpr "typeName") "name")
  let src ← mType args[0]!
  if let some byteW := fixedBytesWidth? tname then
    if src == "bytes" || src == "bytes memory" || src == "bytes calldata" ||
       src == "bytes calldata slice" || src == "bytes storage ref" || src == "bytes storage pointer" then
      return ← lowerBytesToFixedBytes args[0]! byteW j
    if let some word ← fixedBytesStringLiteral? tname args[0]! then
      return word
  let raw ← lowerExpr args[0]!
  let integerWidth (ty : String) :=
    if ty.startsWith "uint" || ty == "address" || ty == "address payable" ||
        ty.startsWith "contract " then bitsOf ty else signedBitsOf ty
  if !(← get).viaIR then
    if let some srcBits := integerWidth src then
      if let some dstBits := integerWidth tname then
        if dstBits ≤ srcBits then return raw
  -- `typeName.name` is `address` even for payable(...); use the resolved type
  -- to distinguish an identity cast from a change in payability.
  let v := if callTy == src then raw else { raw with expr := cleanHelperResultExpr src raw }
  if src.startsWith "int" && !src.startsWith "int_const" && (signedBitsOf src).isNone then
    failAt j s!"unsupported cast source {src}"
  if let some pb := signedBitsOf tname then
    unless (signedBitsOf src).isSome || src.startsWith "int_const" ||
        (src.startsWith "uint" && (bitsOf src).isSome) do
      failAt j s!"unsupported cast source {src} for {tname}"
    let alreadySignExtended := pb == 256 || src.startsWith "int_const" ||
      match signedBitsOf src with
      | some sb => sb ≤ pb
      | none => false
    if alreadySignExtended then
      return v
    let a ← atom v
    let dest ← fresh
    let ext := Stmt.letVar dest (.signextend (.literal (pb / 8 - 1)) a.expr)
    return { pre := a.pre.push ext, expr := .localVar dest }
  -- `bytesN` widths without a dedicated case below. `bytesN(bytesM)` keeps the left-aligned
  -- word when `N >= M` and clears the low `32 - N` bytes when narrowing; `bytesN(uint{8N})`
  -- shifts the value into the high bytes and `uint{8N}(bytesN)` shifts it back.
  let dedicatedBytes := ["bytes1", "bytes4", "bytes12", "bytes20", "bytes32"]
  let genericBytes (ty : String) := (fixedBytesWidth? ty).isSome && !dedicatedBytes.contains ty
  -- Pairs of dedicated widths that no dedicated case below converts (`bytes20(bytes4)`).
  let dedicatedPair := (fixedBytesWidth? tname).isSome && (fixedBytesWidth? src).isSome &&
    tname != src && tname != "bytes32" && src != "bytes32" &&
    !((tname == "bytes1" && src == "bytes4") || (tname == "bytes4" && src == "bytes1"))
  if genericBytes tname || genericBytes src || dedicatedPair then
    if let some tw := fixedBytesWidth? tname then
      if let some sw := fixedBytesWidth? src then
        if sw ≤ tw then return v
        -- Legacy codegen narrows without cleaning the stack word, as the dedicated cases do.
        unless (← get).viaIR do return raw
        let a ← atom v
        let dest ← fresh
        let mask := (2 ^ (8 * tw) - 1) * 2 ^ (8 * (32 - tw))
        return { pre := a.pre.push (.letVar dest (.bitAnd a.expr (.literal mask))),
                 expr := .localVar dest }
      if src == s!"uint{8 * tw}" then
        let a ← atom v
        let dest ← fresh
        let shifted := Stmt.letVar dest
          (.shl (.literal (8 * (32 - tw))) (.bitAnd a.expr (.literal (2 ^ (8 * tw) - 1))))
        return { pre := a.pre.push shifted, expr := .localVar dest }
      if tw < 32 && src.startsWith "int_const" && !src.startsWith "int_const -" then
        let .literal n := v.expr
          | failAt j s!"unsupported cast source {src} for {tname}"
        let innerArg ← stripParens args[0]!
        let raw := optStr innerArg "value" |>.getD ""
        let hexDigits := ((raw.drop 2).toString.splitOn "_").foldl (· ++ ·) ""
        unless v.pre.isEmpty && n < 2 ^ (8 * tw) &&
            (n == 0 || (raw.startsWith "0x" && hexDigits.length == 2 * tw)) do
          failAt j s!"unsupported cast source {src} for {tname}"
        return { pre := #[], expr := .literal (n * 2 ^ (8 * (32 - tw))) }
      failAt j s!"unsupported cast source {src} for {tname}"
    if let some sw := fixedBytesWidth? src then
      if tname == s!"uint{8 * sw}" then
        let a ← atom v
        let dest ← fresh
        return { pre := a.pre.push (.letVar dest (.shr (.literal (8 * (32 - sw))) a.expr)),
                 expr := .localVar dest }
      failAt j s!"unsupported cast target {tname} from {src}"
  if tname == "bytes1" then
    if src == "bytes1" then
      return v
    else if src == "uint8" then
      let a ← atom v
      let dest ← fresh
      let shifted := Stmt.letVar dest (.shl (.literal 248) (.bitAnd a.expr (.literal 0xff)))
      return { pre := a.pre.push shifted, expr := .localVar dest }
    else if src == "bytes32" || src == "bytes4" then
      unless (← get).viaIR do return raw
      let a ← atom v
      let dest ← fresh
      let bound := Stmt.letVar dest (.bitAnd a.expr (.literal (0xff * 2 ^ 248)))
      return { pre := a.pre.push bound, expr := .localVar dest }
    else if src.startsWith "int_const" && !src.startsWith "int_const -" then
      let .literal n := v.expr
        | failAt j s!"unsupported cast source {src} for bytes1"
      let innerArg ← stripParens args[0]!
      let raw := optStr innerArg "value" |>.getD ""
      let hexDigits := ((raw.drop 2).toString.splitOn "_").foldl (· ++ ·) ""
      unless v.pre.isEmpty && n < 256 &&
          (n == 0 || (raw.startsWith "0x" && hexDigits.length == 2)) do
        failAt j s!"unsupported cast source {src} for bytes1"
      return { pre := #[], expr := .literal (n * 2 ^ 248) }
    else
      failAt j s!"unsupported cast source {src} for bytes1"
  if src == "bytes1" then
    if tname == "bytes32" || tname == "bytes4" then
      return v
    else if tname == "uint8" then
      let a ← atom v
      let dest ← fresh
      let shifted := Stmt.letVar dest (.shr (.literal 248) a.expr)
      return { pre := a.pre.push shifted, expr := .localVar dest }
    else
      failAt j s!"unsupported cast target {tname} from bytes1"
  if tname == "bytes4" then
    if src == "bytes4" then
      return v
    else if src == "bytes32" then
      unless (← get).viaIR do return raw
      let a ← atom v
      let dest ← fresh
      let bound := Stmt.letVar dest (.bitAnd a.expr (.literal ((2 ^ 32 - 1) * 16 ^ 56)))
      return { pre := a.pre.push bound, expr := .localVar dest }
    else if src == "uint32" then
      let a ← atom v
      let dest ← fresh
      let shifted := Stmt.letVar dest (.shl (.literal 224) (.bitAnd a.expr (.literal (2 ^ 32 - 1))))
      return { pre := a.pre.push shifted, expr := .localVar dest }
    else if src.startsWith "int_const" && !src.startsWith "int_const -" then
      let .literal n := v.expr
        | failAt j s!"unsupported cast source {src} for bytes4"
      let innerArg ← stripParens args[0]!
      let raw := optStr innerArg "value" |>.getD ""
      let hexDigits := ((raw.drop 2).toString.splitOn "_").foldl (· ++ ·) ""
      unless v.pre.isEmpty && n < 2 ^ 32 &&
          (n == 0 || (raw.startsWith "0x" && hexDigits.length == 8)) do
        failAt j s!"unsupported cast source {src} for bytes4"
      return { pre := #[], expr := .literal (n * 16 ^ 56) }
    else
      failAt j s!"unsupported cast source {src} for bytes4"
  if src == "bytes4" then
    if tname == "bytes32" then
      return v
    else if tname == "uint32" then
      let a ← atom v
      let dest ← fresh
      let shifted := Stmt.letVar dest (.shr (.literal 224) a.expr)
      return { pre := a.pre.push shifted, expr := .localVar dest }
    else
      failAt j s!"unsupported cast target {tname} from bytes4"
  if tname == "bytes12" then
    if src == "bytes12" then
      return v
    else if src == "bytes32" then
      unless (← get).viaIR do return raw
      let a ← atom v
      let dest ← fresh
      let bound := Stmt.letVar dest (.bitAnd a.expr (.literal ((2 ^ 96 - 1) * 2 ^ 160)))
      return { pre := a.pre.push bound, expr := .localVar dest }
    else if src == "uint96" then
      let a ← atom v
      let dest ← fresh
      let shifted := Stmt.letVar dest (.shl (.literal 160) (.bitAnd a.expr (.literal (2 ^ 96 - 1))))
      return { pre := a.pre.push shifted, expr := .localVar dest }
    else if src.startsWith "int_const" && !src.startsWith "int_const -" then
      let .literal n := v.expr
        | failAt j s!"unsupported cast source {src} for bytes12"
      let innerArg ← stripParens args[0]!
      let raw := optStr innerArg "value" |>.getD ""
      let hexDigits := ((raw.drop 2).toString.splitOn "_").foldl (· ++ ·) ""
      unless v.pre.isEmpty && n < 2 ^ 96 &&
          (n == 0 || (raw.startsWith "0x" && hexDigits.length == 24)) do
        failAt j s!"unsupported cast source {src} for bytes12"
      return { pre := #[], expr := .literal (n * 2 ^ 160) }
    else
      failAt j s!"unsupported cast source {src} for bytes12"
  if src == "bytes12" then
    if tname == "bytes32" then
      return v
    else if tname == "uint96" then
      let a ← atom v
      let dest ← fresh
      let shifted := Stmt.letVar dest (.shr (.literal 160) a.expr)
      return { pre := a.pre.push shifted, expr := .localVar dest }
    else
      failAt j s!"unsupported cast target {tname} from bytes12"
  if tname == "bytes20" then
    if src == "bytes20" then
      return v
    else if src == "bytes32" then
      unless (← get).viaIR do return raw
      let a ← atom v
      let dest ← fresh
      let bound := Stmt.letVar dest (.bitAnd a.expr (.literal ((2 ^ 160 - 1) * 2 ^ 96)))
      return { pre := a.pre.push bound, expr := .localVar dest }
    else if src == "uint160" || src == "address" || src == "address payable" then
      let a ← atom v
      let dest ← fresh
      let shifted := Stmt.letVar dest (.shl (.literal 96) (.bitAnd a.expr (.literal (2 ^ 160 - 1))))
      return { pre := a.pre.push shifted, expr := .localVar dest }
    else if src.startsWith "int_const" && !src.startsWith "int_const -" then
      let .literal n := v.expr
        | failAt j s!"unsupported cast source {src} for bytes20"
      let innerArg ← stripParens args[0]!
      let raw := optStr innerArg "value" |>.getD ""
      let hexDigits := ((raw.drop 2).toString.splitOn "_").foldl (· ++ ·) ""
      unless v.pre.isEmpty && n < 2 ^ 160 &&
          (n == 0 || (raw.startsWith "0x" && hexDigits.length == 40)) do
        failAt j s!"unsupported cast source {src} for bytes20"
      return { pre := #[], expr := .literal (n * 2 ^ 96) }
    else
      failAt j s!"unsupported cast source {src} for bytes20"
  if src == "bytes20" then
    if tname == "bytes32" then
      return v
    else if tname == "uint160" || tname == "address" || tname == "address payable" then
      let a ← atom v
      let dest ← fresh
      let shifted := Stmt.letVar dest (.shr (.literal 96) a.expr)
      return { pre := a.pre.push shifted, expr := .localVar dest }
    else
      failAt j s!"unsupported cast target {tname} from bytes20"
  let some bits := bitsOf tname | failAt j s!"unsupported cast target {tname}"
  -- Legacy solc accepts out-of-range integer constants at explicit casts.
  if (← get).legacyWrapping && src.startsWith "int_const" && bits < 256 then
    if let .literal n := v.expr then
      return { v with expr := .literal (n % 2 ^ bits) }
    return { v with expr := .bitAnd v.expr (.literal (2 ^ bits - 1)) }
  let narrow : Bool :=
    match bitsOf src with
    | some sb => decide (sb > bits)
    | none => decide (bits < 256) && !src.startsWith "int_const" && !src.startsWith "enum "
  if narrow then
    let a ← atom v
    let dest ← fresh
    let bound := Stmt.letVar dest (.bitAnd a.expr (.literal (2 ^ bits - 1)))
    pure { pre := a.pre.push bound, expr := .localVar dest }
  else
    pure v

private partial def checkEncodingStructRef (j : Json) : M Unit := do
  match ← mKind j with
  | "Identifier" => pure ()
  | "MemberAccess" => checkEncodingStructRef (← mField j "expression")
  | "IndexAccess" =>
      checkEncodingStructRef (← mField j "baseExpression")
      let idx ← mField j "indexExpression"
      unless (← mKind idx) == "Identifier" || (← mKind idx) == "Literal" do
        failAt idx "effectful ABI encoding argument is unsupported"
  | _ => failAt j "effectful ABI encoding argument is unsupported"

/-- A value-type element reached through mapping keys / array indexes from a storage or
local identifier (`m[k]`, `m[a][b]`, `arr[i]`), each key an effect-free encoding scalar. -/
private partial def checkEncodingIndexedTarget (j : Json) : M Unit := do
  unless (← mKind j) == "IndexAccess" do
    failAt j "effectful ABI encoding argument is unsupported"
  let base ← mField j "baseExpression"
  let some index := (field? j "indexExpression").filter (!·.isNull)
    | failAt j "effectful ABI encoding argument is unsupported"
  unless (← mKind base) == "Identifier" do
    checkEncodingIndexedTarget base
  checkEncodingScalar index

/-- Some `abi.encode(...)` call inside `j` has a state-changing argument. Such an encoding
is admitted (`lowerAbiEncodeArgs` with `orderedEffects`) and runs its effects in place, so
an encoding that hashes it beside deferred sibling reads must not admit it. -/
private partial def statefulAbiEncodeIn (j : Json) (env : Env) : Bool :=
  abiEncodeArgIn (statefulCallIn · env) j

/-- Some `abi.encode(...)` call inside `j` has an argument satisfying `p`. -/
private partial def abiEncodeArgIn (p : Json → Bool) (j : Json) : Bool :=
  match j with
  | .arr xs => xs.any (abiEncodeArgIn p)
  | .obj o =>
      let own := optStr j "nodeType" == some "FunctionCall" &&
        optStr j "kind" == some "functionCall" &&
        (match field? j "expression" with
          | some callee =>
              optStr callee "nodeType" == some "MemberAccess" &&
              optStr callee "memberName" == some "encode" &&
              ((field? callee "expression").bind (field? · "referencedDeclaration")).bind
                (·.getInt?.toOption) == some (-1)
          | none => false) &&
        ((field? j "arguments").any p)
      own || o.foldl (fun found _ child => found || abiEncodeArgIn p child) false
  | _ => false

/-- Some `abi.encode(...)` call inside `j` has an assignment, `++` or `--` argument. Such an
encoding is ordered too (`lowerAbiEncodeArgs`), so it runs the write in place. -/
private partial def assignmentAbiEncodeIn (j : Json) : Bool :=
  abiEncodeArgIn assignmentIn j

/-- A `bytes.concat` / `string.concat` call with more than one argument, one of which may
revert, in `j` or in an internal function it calls. `lowerPacked` now lowers the concat
arguments left to right, as both solc pipelines evaluate them; such a call as a reverting
`abi.encode` argument stays a located rejection (fail-closed: no differential coverage). -/
private partial def revertingConcatIn (env : Env) (seen : List Nat) (j : Json) : Bool :=
  match j with
  | .arr xs => xs.any (revertingConcatIn env seen)
  | .obj o =>
      let own :=
        if optStr j "nodeType" == some "FunctionCall" && optStr j "kind" == some "functionCall" then
          let callee := field? j "expression" |>.getD Json.null
          let args := ((field? j "arguments").bind (·.getArr?.toOption)).getD #[]
          if optStr callee "nodeType" == some "MemberAccess" &&
              optStr callee "memberName" == some "concat" &&
              (field? callee "referencedDeclaration").isNone then
            args.size > 1 && args.any (jsonHasCustomRevert env [])
          else
            match (field? callee "referencedDeclaration").bind (fun v => v.getInt?.toOption) with
            | some id =>
                if id >= 0 then
                  match effectCallTarget? env seen callee id.toNat with
                  | some targetId =>
                      !seen.contains targetId &&
                        ((env.funs.find? targetId).bind (field? · "body")).any
                          (revertingConcatIn env (targetId :: seen))
                  | none => false
                else false
            | none => false
        else false
      own || o.foldl (fun found _ child => found || revertingConcatIn env seen child) false
  | _ => false

/-- Restrict the entire argument tree, not merely its outer cast. This keeps
custom reverts or effects hidden beneath a cast out of the admitted fragment. -/
private partial def checkEncodingScalar (j : Json) (ordered : Bool := false) : M Unit := do
  match ← mKind j with
  | "Identifier" | "Literal" => pure ()
  | "TupleExpression" =>
      -- `(e)`: the same expression, evaluated where it stands.
      let components := ((field? j "components").bind (·.getArr?.toOption)).getD #[]
      unless (field? j "isInlineArray").bind (·.getBool?.toOption) != some true &&
          components.size == 1 &&
          !components[0]!.isNull do
        failAt j "effectful ABI encoding argument is unsupported"
      checkEncodingScalar components[0]! ordered
  | "IndexAccess" =>
      -- A value read through mapping keys / array indexes. Outside an ordered `abi.encode`
      -- it would be read while encoding rather than at its position.
      unless ordered do failAt j "effectful ABI encoding argument is unsupported"
      checkEncodingIndexedTarget j
  | "Assignment" =>
      -- `x = v` (scalar local or storage identifier) in an ordered `abi.encode`: both solc
      -- pipelines run it at its own argument position (`lowerAssignmentExpr`).
      unless ordered && optStr j "operator" == some "=" do
        failAt j "effectful ABI encoding argument is unsupported"
      unless (← mKind (← mField j "leftHandSide")) == "Identifier" do
        failAt j "effectful ABI encoding argument is unsupported"
      checkEncodingScalar (← mField j "rightHandSide") ordered
  | "MemberAccess" =>
      if (field? j "referencedDeclaration").isNone &&
          (optStr j "memberName" == some "interfaceId" ||
           optStr j "memberName" == some "selector") then pure ()
      else checkEncodingScalar (← mField j "expression") ordered
  | "UnaryOperation" =>
      if ordered && (optStr j "operator" == some "++" || optStr j "operator" == some "--") &&
          (field? j "function").isNone then
        -- `x++` / `--m[k]` in an ordered `abi.encode` (`lowerIncDecExpr`), at its position.
        let target ← mField j "subExpression"
        unless (← mKind target) == "Identifier" do
          checkEncodingIndexedTarget target
      else if let some natId := (field? j "function").bind (fun v => v.getNat?.toOption) then
        unless (field? j "prefix").bind (fun v => v.getBool?.toOption) == some true do
          failAt j "effectful ABI encoding argument is unsupported"
        let env ← get
        let targetId := resolveInContracts env env.linearizedBases.toList natId |>.getD natId
        if fnHasCustomRevert env targetId then
          failAt j "effectful ABI encoding argument is unsupported"
        checkEncodingScalar (← mField j "subExpression") ordered
      else
        unless optStr j "operator" == some "-" && (← mType j).startsWith "int_const -" do
          failAt j "effectful ABI encoding argument is unsupported"
        checkEncodingScalar (← mField j "subExpression") ordered
  | "BinaryOperation" =>
      if let some natId := (field? j "function").bind (fun v => v.getNat?.toOption) then
        let env ← get
        let targetId := resolveInContracts env env.linearizedBases.toList natId |>.getD natId
        if fnHasCustomRevert env targetId then
          failAt j "effectful ABI encoding argument is unsupported"
        checkEncodingScalar (← mField j "leftExpression") ordered
        checkEncodingScalar (← mField j "rightExpression") ordered
      else
        -- In an ordered argument list (an `abi.encode` or an external call) the checked
        -- expression is evaluated once at its own position and its panic guard rides in
        -- the same prelude, so a checked `a + b` sibling is admitted.
        unless ordered || (← mType j) == "int256" || (← get).stateVars.size > 1 do
          failAt j "effectful ABI encoding argument is unsupported"
        checkEncodingScalar (← mField j "leftExpression") ordered
        checkEncodingScalar (← mField j "rightExpression") ordered
  | "Conditional" =>
      unless ordered || (← get).stateVars.size > 1 do
        failAt j "effectful ABI encoding argument is unsupported"
      checkEncodingScalar (← mField j "condition") ordered
      checkEncodingScalar (← mField j "trueExpression") ordered
      checkEncodingScalar (← mField j "falseExpression") ordered
  | "FunctionCall" =>
      let args ← mArr (← mField j "arguments")
      if optStr j "kind" == some "typeConversion" then
        if (← mType j).startsWith "enum " then
          unless args.size == 1 do
            failAt j "fallible enum conversion in ABI encoding argument is unsupported"
          unless (← mType args[0]!) == (← mType j) do
            failAt j "fallible enum conversion in ABI encoding argument is unsupported"
        for arg in args do checkEncodingScalar arg ordered
      else if optStr j "kind" == some "functionCall" then
        unless (← mArr (← mField j "names")).isEmpty do
          failAt j "effectful ABI encoding argument is unsupported"
        let callee ← mField j "expression"
        if (← mKind callee) == "Identifier" || (← mKind callee) == "MemberAccess" then
          let refId := (field? callee "referencedDeclaration").bind (fun v => v.getInt?.toOption)
          let member := optStr callee "memberName"
          -- `T.wrap(x)` / `T.unwrap(x)` on a user-defined value type `T` is the identity on the
          -- underlying word (lowered by `lowerExpr`); only its argument can carry an effect.
          let udvtBase? : Option Int ←
            if refId.isNone && (← mKind callee) == "MemberAccess" &&
                (member == some "wrap" || member == some "unwrap") then
              pure ((field? (← mField callee "expression") "referencedDeclaration").bind
                (fun v => v.getInt?.toOption))
            else pure none
          if let some baseId := udvtBase? then
            unless baseId >= 0 && ((← get).userValueTypeById.find? baseId.toNat).isSome &&
                args.size == 1 do
              failAt j "effectful ABI encoding argument is unsupported"
            checkEncodingScalar args[0]! ordered
          else if refId == some (-8) && (← mKind callee) == "Identifier" && args.size == 1 then
            -- The hashed buffer is lowered by its own encoding rules; outside an ordered
            -- `abi.encode` a state change inside it would run beside deferred sibling reads.
            if !ordered && (statefulAbiEncodeIn j (← get) || assignmentAbiEncodeIn j) then
              failAt j "effectful ABI encoding argument is unsupported"
          else if let some id := refId then
            unless id >= 0 do
              failAt j "effectful ABI encoding argument is unsupported"
            let env ← get
            let natId := id.toNat
            let some targetId := effectCallTarget? env [] callee natId
              | failAt j "effectful ABI encoding argument is unsupported"
            -- In an ordered `abi.encode` (`lowerAbiEncodeArgs`) every argument is bound in
            -- source order, as both solc pipelines evaluate them, so a state-changing or
            -- reverting internal helper with a body runs exactly once and in place.
            let internalHelper := ordered && !env.fnPtrs.contains natId &&
              ((field? callee "typeDescriptions").bind (optStr · "typeIdentifier")).any
                (·.startsWith "t_function_internal_") &&
              ((env.funs.find? targetId).bind (field? · "body")).any (!·.isNull)
            if fnHasCustomRevert env targetId && !internalHelper then
              failAt j "effectful ABI encoding argument is unsupported"
            if (← mKind callee) == "MemberAccess" then
              let base ← mField callee "expression"
              let baseTy ← mType base
              unless baseTy.startsWith "type(library " do
                if baseTy.startsWith "struct " then
                  checkEncodingStructRef base
                else
                  checkEncodingScalar base ordered
            for arg in args do
              if (← mType arg).startsWith "struct " then
                checkEncodingStructRef arg
              else
                checkEncodingScalar arg ordered
          else
            failAt j "effectful ABI encoding argument is unsupported"
        else
          failAt j "effectful ABI encoding argument is unsupported"
      else
        failAt j "effectful ABI encoding argument is unsupported"
  | _ => failAt j "effectful ABI encoding argument is unsupported"

private partial def checkEncodingStructArg (j : Json) : M Unit := do
  if (← mKind j) == "FunctionCall" && optStr j "kind" == some "structConstructorCall" then
    for arg in (← mArr (← mField j "arguments")) do
      checkEncodingScalar arg
  else
    checkEncodingStructRef j

/-- Encode one root tuple from its complete declaration schema. Array
payloads contain inline scalar words, even when source memory holds pointers
to the array's struct elements. Calldata is validated as it is consumed. -/
private partial def lowerEncodedRoot (arg : Json) : M EncodedBytes := do
  let .mem id effects ← lowerRef arg
    | failAt arg "ABI encoding requires a root struct reference"
  lowerEncodedMem id effects arg

/-- Encode the head words and dynamic tails of the struct reference `id` into
`tuple` (where `32 * schema.length` head bytes have already been reserved). -/
private partial def lowerEncodedMemBody (id : Nat) (tuple : Expr) (arg : Json) :
    M (Array Stmt) := do
  let some mem := (← get).mems.find? id | failAt arg "unknown encoding root"
  let some schema := mem.schema | failAt arg "missing full ABI encoding schema"
  let mut pre : Array Stmt := #[]
  for (member, memberIndex) in schema.zipIdx do
    let destination := Expr.add tuple (.literal (32 * memberIndex))
    match member with
    | .scalar field =>
        let value ← atom (← readAbiMember id #[] field.name arg)
        pre := pre ++ value.pre
        pre := pre.push (.mstore destination value.expr)
    | .bytesField _ _ =>
        let length ← fresh
        let data ← fresh
        if mem.calldataLocation then
          let header ← fresh
          pre := pre ++ (AbiLowering.calldataBytesFieldHead
            (.localVar (mem.abiStem ++ "_calldata")) memberIndex header length data).toArray
        else
          let bytesPtr ← fresh
          pre := pre ++ #[
            .letVar bytesPtr (mem.memoryMemberWord memberIndex),
            .letVar length (.mload (.localVar bytesPtr)),
            .letVar data (.add (.localVar bytesPtr) (.literal 32))]
        let tailPtr ← fresh
        let tailLenEnd ← fresh
        pre := pre ++ (AbiEncoding.reserve tailPtr tailLenEnd (.literal 32)).toArray
        pre := pre ++ #[
          .mstore destination (.sub (.localVar tailPtr) tuple),
          .mstore (.localVar tailPtr) (.localVar length)]
        let payloadPtr ← fresh
        let payloadEnd ← fresh
        let clearIdx ← fresh
        pre := pre ++ (AbiEncoding.packedBuffer payloadPtr payloadEnd clearIdx (.localVar length)).toArray
        let copyIdx ← fresh
        let byteName ← fresh
        let addrName ← fresh
        if mem.calldataLocation then
          let idx := Expr.localVar copyIdx
          let shift := Expr.mul (.literal 8) (.sub (.literal 31) (AbiEncoding.byteLane idx))
          let sourceWord := Expr.calldataload (.add (.localVar data) (AbiEncoding.byteWordOffset idx))
          let addr := Expr.localVar addrName
          pre := pre.push (.forEach copyIdx (.localVar length) [
            .letVar byteName (.bitAnd (.shr shift sourceWord) (.literal 255)),
            .letVar addrName (.add (.localVar payloadPtr) (AbiEncoding.byteWordOffset idx)),
            .mstore addr (.add (.mload addr) (.shl shift (.localVar byteName)))])
        else
          pre := pre.push (AbiEncoding.copyBytes (.localVar data) (.localVar payloadPtr)
            (.literal 0) (.localVar length) copyIdx byteName addrName)
    | .nestedStruct mname subSid subSname subMembers subSchema =>
        let subId := 1000000000 + (← get).next
        modify fun e => { e with next := e.next + 1 }
        if mem.calldataLocation then
          let subStem ← freshAbiStem subSchema false
          let checks := AbiLowering.nestedStructCalldataHead
            (.localVar (mem.abiStem ++ "_calldata")) memberIndex subSchema.length (subStem ++ "_calldata")
          let subMem : MemParam :=
            { structId := subSid
              param := s!"{mem.param}_{mname}"
              structName := subSname
              members := subMembers.toArray
              staticTypes := none
              calldataLocation := true
              headBinding := ""
              schema := some subSchema
              abiStem := subStem }
          modify fun e => { e with mems := e.mems.insert subId subMem }
          pre := pre ++ checks.toArray
        else
          let subStem ← freshAbiStem subSchema true
          let loadPtr := Stmt.letVar (subStem ++ "_memory")
            (mem.memoryMemberWord memberIndex)
          let subMem : MemParam :=
            { structId := subSid
              param := s!"{mem.param}_{mname}"
              structName := subSname
              members := subMembers.toArray
              staticTypes := none
              calldataLocation := false
              headBinding := ""
              schema := some subSchema
              abiStem := subStem }
          modify fun e => { e with mems := e.mems.insert subId subMem }
          pre := pre.push loadPtr
        let subTuple ← fresh
        let subTupleEnd ← fresh
        pre := pre ++ (AbiEncoding.reserve subTuple subTupleEnd
          (.literal (32 * subSchema.length))).toArray
        pre := pre.push (.mstore destination (.sub (.localVar subTuple) tuple))
        pre := pre ++ (← lowerEncodedMemBody subId (.localVar subTuple) arg)
    | .bytesArray _ => failAt arg "bytes[] members are outside struct ABI encoding"
    | .scalarArray _ | .structArray _ _ =>
        let kinds : List SolidityAbi.ScalarKind := match member with
          | .scalarArray field => [field.kind]
          | .structArray _ fields => fields.map (fun (field : AbiSchema.ScalarField) => field.kind)
          | .scalar _ | .bytesField _ _ | .nestedStruct _ _ _ _ _ | .bytesArray _ => []
        let scalarArray := match member with
          | .scalarArray _ => true
          | _ => false
        let header ← fresh
        let length ← fresh
        let data ← fresh
        if mem.calldataLocation then
          pre := pre ++ (AbiLowering.staticArrayHead
            (.localVar (mem.abiStem ++ "_calldata")) memberIndex kinds.length
            header length data).toArray
        else
          pre := pre ++ #[
            .letVar header (mem.memoryMemberWord memberIndex),
            .letVar length (.mload (.localVar header)),
            .letVar data (.add (.localVar header) (.literal 32))]
        let tail ← fresh
        let tailEnd ← fresh
        let payloadSize := Expr.mul (.localVar length) (.literal (32 * kinds.length))
        pre := pre ++ (AbiEncoding.reserve tail tailEnd
          (.add (.literal 32) payloadSize)).toArray
        pre := pre ++ #[.mstore destination (.sub (.localVar tail) tuple),
          .mstore (.localVar tail) (.localVar length)]
        let index ← fresh
        let source ← fresh
        let sourceAddress := if mem.calldataLocation || scalarArray then
          Expr.add (.localVar data) (.mul (.localVar index) (.literal (32 * kinds.length)))
          else Expr.mload (.add (.localVar data) (.mul (.localVar index) (.literal 32)))
        let mut body : List Stmt := [.letVar source sourceAddress]
        for (kind, fieldIndex) in kinds.zipIdx do
          let address := Expr.add (.localVar source) (.literal (32 * fieldIndex))
          let value := if mem.calldataLocation then Expr.calldataload address else Expr.mload address
          let bound := SolidityAbi.scalarBound kind
          if mem.calldataLocation && bound < 2^256 then
            body := body ++ [AbiLowering.guard (.lt value (.literal bound))]
          let offset := Expr.add (.literal (32 * fieldIndex))
            (.mul (.localVar index) (.literal (32 * kinds.length)))
          body := body ++ [.mstore (.add (.add (.localVar tail) (.literal 32)) offset) value]
        pre := pre.push (.forEach index (.localVar length) body)
  return pre

/-- Encode the root tuple of the struct reference `id` after its `effects`. -/
private partial def lowerEncodedMem (id : Nat) (effects : Array Stmt) (arg : Json) :
    M EncodedBytes := do
  let some mem := (← get).mems.find? id | failAt arg "unknown encoding root"
  let pointer ← fresh
  let finish ← fresh
  modify fun env => { env with encodingMemory := true }
  if let some types := mem.staticTypes then
    let mut pre := effects
    let mut values := []
    for (name, _) in mem.members do
      let value ← atom (← readAbiMember id #[] name arg)
      pre := pre ++ value.pre
      values := values ++ [value.expr]
    unless values.length == types.length do failAt arg "static encoding schema mismatch"
    pre := pre ++ (AbiEncoding.staticWords pointer finish values).toArray
    return { pre, pointer := .localVar pointer, size := .literal (32 * values.length) }
  let some schema := mem.schema | failAt arg "missing full ABI encoding schema"
  let base := Expr.localVar pointer
  let tuple := Expr.add base (.literal 32)
  let mut pre := effects ++ (AbiEncoding.reserve pointer finish
    (.literal (32 * (schema.length + 1)))).toArray
  pre := pre.push (.mstore base (.literal 32))
  pre := pre ++ (← lowerEncodedMemBody id tuple arg)
  let size ← fresh
  pre := pre.push (.letVar size (.sub (.mload (.literal 64)) base))
  return { pre, pointer := base, size := .localVar size }

/-- Literal bytes are stored as right-zero-padded words; their logical size
excludes that padding. `hexValue` is solc's byte spelling, including UTF-8. -/
private partial def lowerLiteralBytes (j : Json) : M EncodedBytes := do
  let some hex := optStr j "hexValue" | failAt j "missing literal byte spelling"
  unless hex.length % 2 == 0 do failAt j "invalid literal byte spelling"
  let chars := hex.toList.toArray
  let mut words : List Expr := []
  let mut word := 0
  for index in [:chars.size] do
    let some digit := Compiler.Hex.hexCharToNat? chars[index]!
      | failAt j "invalid literal hex digit"
    word := word * 16 + digit
    if index % 64 == 63 then
      words := words ++ [.literal word]
      word := 0
  if chars.size % 64 != 0 then
    words := words ++ [.literal (word * 16^(64 - chars.size % 64))]
  let pointer ← fresh
  let finish ← fresh
  modify fun env => { env with encodingMemory := true }
  return { pre := (AbiEncoding.staticWords pointer finish words).toArray,
           pointer := .localVar pointer, size := .literal (hex.length / 2) }

private partial def lowerPackedArgument (j : Json) : M EncodedBytes := do
  let ty ← mType j
  if (← mKind j) == "MemberAccess" && optStr j "memberName" == some "selector" &&
      (field? j "referencedDeclaration").isNone && ty == "bytes4" then
    return ← lowerSelectorBytes j
  if let some _ := paramType ty then
    -- Hash builtins consume only admitted byte buffers; other function calls
    -- remain rejected even if hidden beneath a scalar cast.
    let mut hashCall := false
    if (← mKind j) == "FunctionCall" then
      let callee ← mField j "expression"
      if (← mKind callee) == "Identifier" then
        hashCall := (← refInt callee) == -8
    if hashCall && statefulAbiEncodeIn j (← get) then
      failAt j "effectful ABI encoding argument is unsupported"
    unless hashCall do checkEncodingScalar j
    let value ← atom (← lowerExpr j)
    -- Packed scalars take their own width; a narrow signed value contributes the low bytes of its
    -- sign-extended word, which the left shift below keeps.
    let bits := (bitsOf ty).getD ((signedBitsOf ty).getD 256)
    let size := if ty == "bool" || ty == "bytes1" then 1 else if ty == "bytes4" then 4 else bits / 8
    let pointer ← fresh
    let finish ← fresh
    modify fun env => { env with encodingMemory := true }
    let cleaned := cleanHelperResultExpr ty value
    let padded := if ty == "bytes4" || ty == "bytes1" then cleaned else Expr.mul cleaned (.literal (2^(8*(32-size))))
    let pre := value.pre ++ (AbiEncoding.staticWords pointer finish [padded]).toArray
    return { pre, pointer := .localVar pointer, size := .literal size }
  lowerEncodedBytes j

/-- A storage `bytes` / `string` argument `args[idx]` of a multi-argument encoding
(`abi.encode`, `abi.encodePacked`, `bytes.concat`, `string.concat`). Both solc 0.8.34 pipelines
evaluate such a reference (its keys, index checks, storage-pointer local) at its position but
read the bytes (length, Panic 0x22 on a corrupt encoding, data) only while encoding, after
every argument has run. Returns the reference prelude and the field and slot of the read the
caller defers; the slot is a literal or a local the prelude binds (keys hashed at the position). A storage-typed argument whose slot does
not resolve here (a storage conditional) is read at its position, so it is a located rejection
before a later sibling that can revert, call or write. `none`: not deferred. -/
private partial def deferredStorageBytesArgument? (args : Array Json) (idx : Nat) :
    M (Option (Array Stmt × String × Expr)) := do
  let arg := args[idx]!
  let ty ← mType arg
  unless (ty.startsWith "bytes " || ty.startsWith "string ") &&
      (ty.splitOn " storage").length > 1 do
    return none
  match ← resolveStorageBytesTarget? arg with
  | some (refPre, name, slotExpr, _) => return some (refPre, name, slotExpr)
  | none =>
      for later in args.extract (idx + 1) args.size do
        unless ← orderInert later do
          failAt arg "storage bytes/string encoding argument before a sibling that can revert or write is unsupported"
      return none

private partial def lowerPacked (args : Array Json) (sourceOrder : Bool := false) : M EncodedBytes := do
  let env ← get
  if env.forwardingBytesTuple && args.size > 1 then
    for i in [:args.size] do
      let arg := args[i]!
      if statefulCallIn arg env || assignmentIn arg then
        failAt arg "effectful packed arguments in a forwarded tuple require explicit evaluation-order support"
      for k in [i + 1:args.size] do
        if memoryWriteOrderHazard arg args[k]! env then
          failAt arg "memory-writing packed arguments in a forwarded tuple require explicit evaluation-order support"
  -- An ordered `abi.encode` runs its helpers in place, beside storage `bytes` siblings whose
  -- reads are deferred below. A scalar write (`x++`, `m[k] = v`) cannot reach a `bytes`
  -- sibling, and `abi.encodePacked` (`sourceOrder`) writes each scalar sibling at its own
  -- position, as both solc pipelines evaluate them; the concat builtins keep rejecting it
  -- (fail-closed: no differential coverage).
  if args.size > 1 then
    for arg in args do
      if statefulAbiEncodeIn arg env || (!sourceOrder && assignmentAbiEncodeIn arg) then
        failAt arg "effectful ABI encoding argument is unsupported"
  let mut buffers : Array EncodedBytes :=
    Array.replicate args.size { pre := #[], pointer := .literal 0, size := .literal 0 }
  let mut pre := #[]
  let mut deferred : Array (Nat × String × Expr × Json) := #[]
  -- Both solc 0.8.34 pipelines evaluate the arguments of `abi.encodePacked`, `bytes.concat` and
  -- `string.concat` left to right (the first panic, revert or state write comes first), and read
  -- a storage `bytes` / `string` argument only while encoding, after every argument has run.
  for idx in List.range args.size do
    let arg := args[idx]!
    if args.size > 1 then
      if let some (refPre, name, slot) ← deferredStorageBytesArgument? args idx then
        pre := pre ++ refPre
        deferred := deferred.push (idx, name, slot, arg)
        continue
    let buffer ← lowerPackedArgument arg
    pre := pre ++ buffer.pre
    buffers := buffers.set! idx buffer
  for (idx, name, slot, arg) in deferred do
    let buffer ← lowerStorageBytesRead #[] name slot arg
    pre := pre ++ buffer.pre
    buffers := buffers.set! idx buffer
  let sizeName ← fresh
  let size := Expr.localVar sizeName
  let length := buffers.foldl (fun total buffer => Expr.add total buffer.size) (.literal 0)
  pre := pre.push (.letVar sizeName length)
  let pointer ← fresh
  let finish ← fresh
  let clearIndex ← fresh
  pre := pre ++ (AbiEncoding.packedBuffer pointer finish clearIndex size).toArray
  let start ← fresh
  pre := pre.push (.letVar start (.literal 0))
  for buffer in buffers do
    let index ← fresh
    let byteName ← fresh
    let address ← fresh
    pre := pre.push (AbiEncoding.copyBytes buffer.pointer (.localVar pointer)
      (.localVar start) buffer.size index byteName address)
    pre := pre.push (.assignVar start (.add (.localVar start) buffer.size))
  modify fun env => { env with encodingMemory := true }
  return { pre, pointer := .localVar pointer, size }

/-- Check that a `.selector` receiver is a contract/interface type, `this`, or a
pure local/parameter/cast expression that cannot read storage or trigger effects. -/
private partial def isPureSelectorReceiver (j : Json) : M Bool := do
  let ty ← mType j
  if ty.startsWith "type(contract " || ty.startsWith "type(library " then
    return (← mKind j) == "Identifier" || (← mKind j) == "MemberAccess"
  match ← mKind j with
  | "Identifier" =>
      let id ← refInt j
      if id == -28 && optStr j "name" == some "this" then return true
      if id ≥ 0 then return (← get).values.contains id.toNat
      return false
  | "Literal" => return true
  | "FunctionCall" =>
      unless optStr j "kind" == some "typeConversion" && ty.startsWith "contract " do
        return false
      let args ← mArr (← mField j "arguments")
      unless args.size == 1 do return false
      isPureSelectorReceiver args[0]!
  | _ => return false

/-- Resolve `<receiver>.<fn>` to its declaration and a 4-byte memory buffer
containing the left-aligned 32-bit function selector. -/
private partial def lowerMemberFunctionSelector (fnExpr : Json) : M (Json × EncodedBytes) := do
  unless (← mKind fnExpr) == "MemberAccess" do
    failAt fnExpr "selector target must be a contract or interface member"
  let receiver ← mField fnExpr "expression"
  unless ← isPureSelectorReceiver receiver do
    failAt receiver "selector receiver must be a contract/interface type, this, or a local/parameter"
  let declId ← refInt fnExpr
  unless declId ≥ 0 do
    failAt fnExpr "unresolved selector target declaration"
  let env ← get
  let some decl := (env.funs.find? declId.toNat <|> env.stateVars.find? declId.toNat <|> env.errorDecls.find? declId.toNat)
    | failAt fnExpr s!"unresolved selector declaration {declId}"
  let some hex := (optStr decl "functionSelector" <|> optStr decl "errorSelector")
    | failAt fnExpr "selector target has no functionSelector"
  unless hex.length == 8 do
    failAt fnExpr s!"invalid functionSelector hex length {hex.length}"
  let chars := hex.toList.toArray
  let mut word := 0
  for index in [:chars.size] do
    let some digit := Compiler.Hex.hexCharToNat? chars[index]!
      | failAt fnExpr "invalid functionSelector hex digit"
    word := word * 16 + digit
  let padded := word * 16 ^ 56
  let pointer ← fresh
  let finish ← fresh
  modify fun e => { e with encodingMemory := true }
  return (decl,
          { pre := (AbiEncoding.staticWords pointer finish [.literal padded]).toArray,
            pointer := .localVar pointer, size := .literal 4 })

/-- Lower `<receiver>.<fn>.selector`, `<Err>.selector`, or any `bytes4` expression
(local, parameter, constant, decoded `bytes4`, literal) to a 4-byte memory buffer
containing the left-aligned 32-bit selector. -/
private partial def lowerSelectorBytes (j : Json) : M EncodedBytes := do
  let ty ← mType j
  if (← mKind j) == "MemberAccess" && optStr j "memberName" == some "selector" &&
      (field? j "referencedDeclaration").isNone && ty == "bytes4" then
    let fnExpr ← mField j "expression"
    if (← mKind fnExpr) == "Identifier" then
      let declId ← refInt fnExpr
      if declId ≥ 0 then
        if let some errDecl := (← get).errorDecls.find? declId.toNat then
          if let some hex := optStr errDecl "errorSelector" then
            unless hex.length == 8 do
              failAt fnExpr s!"invalid errorSelector hex length {hex.length}"
            let chars := hex.toList.toArray
            let mut word := 0
            for index in [:chars.size] do
              let some digit := Compiler.Hex.hexCharToNat? chars[index]!
                | failAt fnExpr "invalid errorSelector hex digit"
              word := word * 16 + digit
            let padded := word * 16 ^ 56
            let pointer ← fresh
            let finish ← fresh
            modify fun e => { e with encodingMemory := true }
            return { pre := (AbiEncoding.staticWords pointer finish [.literal padded]).toArray,
                     pointer := .localVar pointer, size := .literal 4 }
    return (← lowerMemberFunctionSelector fnExpr).2
  if ty == "bytes4" || (ty.startsWith "int_const" && !ty.startsWith "int_const -") ||
      ty.startsWith "literal_string " then
    unless ty.startsWith "literal_string " do
      checkEncodingScalar j
    let value ← atom (← lowerConverted "bytes4" j)
    let pointer ← fresh
    let finish ← fresh
    modify fun e => { e with encodingMemory := true }
    let mask := cleanHelperResultExpr "bytes4" value
    let word := if (← get).viaIR then value.expr else mask
    return { pre := value.pre ++ (AbiEncoding.staticWords pointer finish [word]).toArray,
             pointer := .localVar pointer, size := .literal 4 }
  failAt j "selector argument must be a bytes4 or function .selector expression"

private partial def encodeSelectorAndWords (selBuffer : EncodedBytes) (pre : Array Stmt) (words : List Expr) : M EncodedBytes := do
  if words.isEmpty then
    return { selBuffer with pre }
  let wordsPointer ← fresh
  let wordsFinish ← fresh
  modify fun env => { env with encodingMemory := true }
  let mut pre := pre ++ (AbiEncoding.staticWords wordsPointer wordsFinish words).toArray
  let wordsBuffer : EncodedBytes :=
    { pre := #[], pointer := .localVar wordsPointer, size := .literal (32 * words.length) }
  let buffers := [{ selBuffer with pre := #[] }, wordsBuffer]
  let sizeName ← fresh
  let size := Expr.localVar sizeName
  pre := pre.push (.letVar sizeName (.literal (4 + 32 * words.length)))
  let pointer ← fresh
  let finish ← fresh
  let clearIndex ← fresh
  pre := pre ++ (AbiEncoding.packedBuffer pointer finish clearIndex size).toArray
  let start ← fresh
  pre := pre.push (.letVar start (.literal 0))
  for buffer in buffers do
    let index ← fresh
    let byteName ← fresh
    let address ← fresh
    pre := pre.push (AbiEncoding.copyBytes buffer.pointer (.localVar pointer)
      (.localVar start) buffer.size index byteName address)
    pre := pre.push (.assignVar start (.add (.localVar start) buffer.size))
  return { pre, pointer := .localVar pointer, size }

/-- `selector ++ payload` in a fresh word-padded buffer: the `abi.encodeCall` layout of a
four-byte selector followed by an `abi.encode` payload. -/
private partial def prefixSelector (selBuffer payload : EncodedBytes) : M EncodedBytes := do
  let mut pre := selBuffer.pre ++ payload.pre
  let payloadPointer ← fresh
  let payloadSize ← fresh
  pre := pre ++ #[.letVar payloadPointer payload.pointer, .letVar payloadSize payload.size]
  let sizeName ← fresh
  let size := Expr.localVar sizeName
  pre := pre.push (.letVar sizeName (.add (.literal 4) (.localVar payloadSize)))
  let pointer ← fresh
  let finish ← fresh
  let clearIndex ← fresh
  modify fun env => { env with encodingMemory := true }
  pre := pre ++ (AbiEncoding.packedBuffer pointer finish clearIndex size).toArray
  let start ← fresh
  pre := pre.push (.letVar start (.literal 0))
  for (bufPointer, bufSize) in [(selBuffer.pointer, selBuffer.size),
      (Expr.localVar payloadPointer, Expr.localVar payloadSize)] do
    let index ← fresh
    let byteName ← fresh
    let address ← fresh
    pre := pre.push (AbiEncoding.copyBytes bufPointer (.localVar pointer)
      (.localVar start) bufSize index byteName address)
    pre := pre.push (.assignVar start (.add (.localVar start) bufSize))
  return { pre, pointer := .localVar pointer, size }

private partial def lowerStorageBytesLength (pre : Array Stmt) (fieldName : String) (slotExpr : Expr) : M Val := do
  let rawRead ← if fieldName != "" then do
    markField fieldName
    pure (Expr.storage fieldName)
  else do
    modify fun e => { e with usedRawStorage := true }
    pure (Expr.storageArrayElement rawStorageFieldName slotExpr)
  let raw ← fresh
  let outOfPlace ← fresh
  let len ← fresh
  let shortCheck := Expr.lt (.localVar len) (.literal 32)
  let stmts : Array Stmt := #[
    .letVar raw rawRead,
    .letVar outOfPlace (.bitAnd (.localVar raw) (.literal 1)),
    .letVar len (.div (.localVar raw) (.literal 2)),
    .ite (.eq (.localVar outOfPlace) (.literal 0))
      [.assignVar len (.bitAnd (.localVar len) (.literal 0x7f))]
      [],
    .ite (.eq (.localVar outOfPlace) shortCheck)
      [.panicCode (.literal 0x22)]
      []
  ]
  return { pre := pre ++ stmts, expr := .localVar len }

private partial def resolveStorageBytesTarget? (j : Json) : M (Option (Array Stmt × String × Expr × Bool)) := do
  if ← isStorageStructBytesMember j then
    let base ← mField j "expression"
    let member ← mStr (← mField j "memberName")
    let baseTy ← mType base
    if baseTy.startsWith "struct " &&
        (baseTy.endsWith " storage pointer" || baseTy.endsWith " storage ref") then
      match ← lowerRef base with
      | .path pre (.bytesSlot (fieldName, slotExpr) isString) =>
          return some (pre, fieldName, slotExpr, isString)
      | .path pre (.rawSlot structId baseSlot) =>
          let rawInfo ← resolveRawStructInfo structId j
          if let some bInfo := rawInfo.bytesMembers.find? (·.member == member) then
            return some (pre, "", rawStructMemberSlot baseSlot bInfo.wordOffset, bInfo.isString)
      | _ => pure ()
  if (← mKind j) == "Identifier" then
    let id ← refInt j
    unless id ≥ 0 do return none
    let env ← get
    if env.values.contains id.toNat || env.paths.contains id.toNat || env.snapshots.contains id.toNat ||
       env.mems.contains id.toNat || env.abiElements.contains id.toNat ||
       env.byteBuffers.contains id.toNat || env.stringBuffers.contains id.toNat ||
       env.calldataBytes.contains id.toNat || env.scalarArrays.contains id.toNat ||
       env.numericConstants.contains id.toNat then
      return none
    if let some (fieldName, slotExpr, isString) := env.storageBytesVars.find? id.toNat then
      return some (#[], fieldName, slotExpr, isString)
    let some decl := env.stateVars.find? id.toNat | return none
    if (field? decl "constant").bind (fun value => value.getBool?.toOption) == some true then
      return none
    if optStr decl "mutability" == some "immutable" then
      return none
    let name ← mStr (← mField decl "name")
    if env.duplicateLayoutLabels.contains name then
      failAt j s!"shadowed storage declaration {name} is outside this slice"
    if let some item := env.layoutItems.find? name then
      unless (← mNat (← mField item "astId")) == id.toNat do
        failAt j s!"shadowed storage declaration {name} is outside this slice"
    let info ← resolveField name j
    unless info.bytesStorage && info.keyCount == 0 do return none
    return some (#[], name, .literal info.slot, info.stringStorage)
  if (← mKind j) == "IndexAccess" then
    let ty ← mType j
    if ty == "string storage ref" || ty == "bytes storage ref" ||
       ty == "string storage pointer" || ty == "bytes storage pointer" then
      match ← lowerRef j with
      | .path pre (.bytesSlot (fieldName, slotExpr) isString) =>
          return some (pre, fieldName, slotExpr, isString)
      | .path pre path =>
          let (rawField, count) ← match path with
            | .one field _ => pure (field, 1)
            | .two field _ _ => pure (field, 2)
            | _ => pure ("", 0)
          if count > 0 then
            let (name, subPrefix) := splitSPathField rawField
            if subPrefix == "" then
              let info ← resolveField name j
              if info.bytesStorage && info.keyCount == count then
                markField name
                let (slotStmts, slotExpr) ← computeSPathBaseSlot path info 0 j
                return some (pre ++ slotStmts, "", slotExpr, info.stringStorage)
      | _ => pure ()
  if (← mKind j) == "FunctionCall" && optStr j "kind" == some "typeConversion" then
    let ty ← mType j
    if ty == "bytes storage pointer" || ty == "string storage pointer" then
      let args ← mArr (← mField j "arguments")
      if args.size == 1 then
        return ← resolveStorageBytesTarget? args[0]!
  return none

private partial def lowerStorageBytesLength? (j : Json) : M (Option Val) := do
  let some (pre, fieldName, slotExpr, _) ← resolveStorageBytesTarget? j | return none
  some <$> lowerStorageBytesLength pre fieldName slotExpr

private partial def unwrapBytesConversion (j : Json) : M Json := do
  let j ← stripParens j
  if (← mKind j) == "FunctionCall" && optStr j "kind" == some "typeConversion" then
    let ty ← mType j
    if ty == "bytes" || ty == "bytes memory" || ty == "bytes calldata" || ty == "bytes storage pointer" then
      let args ← mArr (← mField j "arguments")
      if args.size == 1 then
        return ← unwrapBytesConversion args[0]!
  return j

/-- Recognize the actual call node. Callers normalize grouping before recognition so
resolution and parameter binding always inspect the same node. -/
private partial def isParameterizedCalldataBytesCall (j : Json) : M Bool := do
  unless (← mKind j) == "FunctionCall" && optStr j "kind" == some "functionCall" &&
      (← mType j) == "bytes calldata" do
    return false
  let callee ← mField j "expression"
  let isHelperCall :=
    ((← mKind callee) == "Identifier" || (← mKind callee) == "MemberAccess") &&
    ((field? callee "referencedDeclaration").bind (fun v => v.getInt?.toOption)).any (· ≥ 0)
  unless isHelperCall do return false
  let callArgs ← mArr (← mField j "arguments")
  if !callArgs.isEmpty then return true
  if (← mKind callee) == "MemberAccess" then
    let baseTy ← mType (← mField callee "expression")
    return !(baseTy.startsWith "type(library " || baseTy.startsWith "type(contract " ||
             baseTy.startsWith "contract " || baseTy.startsWith "interface ")
  return false

private partial def lowerCalldataSlice? (j : Json) : M (Option (Array Stmt × Expr × Expr × Bool × Bool)) := do
  let j ← stripParens j
  unless (← mKind j) == "IndexRangeAccess" do return none
  let base ← unwrapBytesConversion (← stripParens (← mField j "baseExpression"))
  let baseInfo? ← if ← isMsgDataNode base then
    pure (some (#[], Expr.literal 0, Expr.calldatasize, true, true))
  else if (← mKind base) == "IndexRangeAccess" then
    lowerCalldataSlice? base
  else if ← isParameterizedCalldataBytesCall base then
    let (fnId, vals) ← resolveCallTargetAndArgs base
    let (pre, cb) ← inlineCalldataBytesFn fnId vals base
    pure (some (pre, Expr.localVar cb.dataBinding, Expr.localVar cb.lengthBinding, true, false))
  else if (← mKind base) == "FunctionCall" && optStr base "kind" == some "functionCall" then
    let names ← mArr (← mField base "names")
    let args ← mArr (← mField base "arguments")
    if names.isEmpty && args.isEmpty && (← mType base) == "bytes calldata" then
      let (fnId, vals) ← resolveCallTargetAndArgs base
      let pre ← inlineMsgDataFn fnId vals base
      pure (some (pre, Expr.literal 0, Expr.calldatasize, true, true))
    else
      pure none
  else if (← mKind base) == "IndexAccess" then
    -- `items[i]` of a `bytes[]`: the element's descriptor (its lazy calldata
    -- tail checks or its memory header) is the slice base, so
    -- `bytes4(items[i][:4])` and `abi.decode(items[i][4:], (...))` stay on
    -- calldata and a memory element slices its copied buffer.
    let element? ← try
      (do
        match ← lowerRef base with
        | .calldataBytes sid pre =>
          match (← get).calldataBytes.find? sid with
          | some cb => pure (some (pre, cb))
          | none => pure none
        | _ => pure none)
    catch _ => pure none
    match element? with
    | some (pre, cb) =>
        if !cb.inMemory then
          pure (some (pre, Expr.localVar cb.dataBinding, Expr.localVar cb.lengthBinding, true, false))
        else
          pure (some (pre, Expr.add (.localVar cb.memoryPointer) (.literal 32),
            Expr.localVar cb.lengthBinding, false, false))
    | none => pure none
  else if (← mKind base) == "Identifier" then
    let id ← refInt base
    if id ≥ 0 then
      if let some cb := (← get).calldataBytes.find? id.toNat then
        if !cb.inMemory then
          pure (some (#[], Expr.localVar cb.dataBinding, Expr.localVar cb.lengthBinding, true, false))
        else if (← mType base) == "bytes calldata" then
          pure (some (#[], Expr.add (.localVar cb.memoryPointer) (.literal 32), Expr.localVar cb.lengthBinding, false, false))
        else
          pure none
      else if let some buf := (← get).byteBuffers.find? id.toNat then
        if (← mType base) == "bytes calldata" then
          pure (some (buf.pre, buf.pointer, buf.size, false, false))
        else
          pure none
      else
        pure none
    else
      pure none
  else
    pure none
  let some (basePre, baseOff, baseLen, fromCalldata, isMsgData) := baseInfo? | return none
  let startVal ← match field? j "startExpression" with
    | none => pure ({ pre := #[], expr := .literal 0 } : Val)
    | some sNode =>
        if sNode.isNull then
          pure ({ pre := #[], expr := .literal 0 } : Val)
        else
          let sTy ← mType sNode
          unless (sTy.startsWith "uint" && (bitsOf sTy).isSome) ||
              (sTy.startsWith "int_const" && !sTy.startsWith "int_const -") do
            failAt sNode s!"calldata slice start index must be unsigned, found {sTy}"
          if statefulCallIn sNode (← get) || assignmentIn sNode then
            failAt sNode "stateful or assignment calldata slice start index is unsupported"
          atom (← lowerConverted "uint256" sNode)
  let endVal ← match field? j "endExpression" with
    | none => pure ({ pre := #[], expr := baseLen } : Val)
    | some eNode =>
        if eNode.isNull then
          pure ({ pre := #[], expr := baseLen } : Val)
        else
          let eTy ← mType eNode
          unless (eTy.startsWith "uint" && (bitsOf eTy).isSome) ||
              (eTy.startsWith "int_const" && !eTy.startsWith "int_const -") do
            failAt eNode s!"calldata slice end index must be unsigned, found {eTy}"
          if statefulCallIn eNode (← get) || assignmentIn eNode then
            failAt eNode "stateful or assignment calldata slice end index is unsupported"
          atom (← lowerConverted "uint256" eNode)
  let startAtLeastFour := startVal.pre.isEmpty && match startVal.expr with
    | .literal n => n ≥ 4
    | _ => false
  let sliceIsMsgData := isMsgData && !startAtLeastFour
  let startVar ← fresh
  let endVar ← fresh
  let offVar ← fresh
  let lenVar ← fresh
  let offExpr := match baseOff with
    | .literal 0 => Expr.localVar startVar
    | _ => Expr.add baseOff (.localVar startVar)
  let slicePre : Array Stmt := basePre ++ startVal.pre ++ endVal.pre ++ #[
    .letVar startVar startVal.expr,
    .letVar endVar endVal.expr,
    AbiLowering.guard (.le (.localVar startVar) (.localVar endVar)),
    AbiLowering.guard (.le (.localVar endVar) baseLen),
    .letVar offVar offExpr,
    .letVar lenVar (.sub (.localVar endVar) (.localVar startVar))
  ]
  return some (slicePre, .localVar offVar, .localVar lenVar, fromCalldata, sliceIsMsgData)

private partial def lowerBytesToFixedBytes (arg : Json) (byteWidth : Nat) (at_ : Json) : M Val := do
  let fullMask : Nat :=
    if byteWidth >= 32 then 2 ^ 256 - 1
    else (2 ^ (8 * byteWidth) - 1) * (2 ^ (256 - 8 * byteWidth))
  let inner ← unwrapBytesConversion arg
  if let some (slicePre, offsetExpr, lenExpr, fromCalldata, isMsgData) ← lowerCalldataSlice? inner then
    let rawWord ← fresh
    let word ← fresh
    let maskShift := Expr.shl (.mul (.literal 8) (.sub (.literal byteWidth) lenExpr)) (.literal fullMask)
    let loadRaw : Array Stmt :=
      if isMsgData then
        #[ .letVar rawWord (.literal 0),
           .ite (.lt offsetExpr (.literal 4))
             [ .assignVar rawWord
                 (.bitOr
                   (.shl (.mul (.literal 8) offsetExpr) (.calldataload (.literal 0)))
                   (.shr (.mul (.literal 8) (.sub (.literal 4) offsetExpr)) (.calldataload (.literal 4)))) ]
             [ .assignVar rawWord (.calldataload offsetExpr) ] ]
      else
        #[ .letVar rawWord (readAbiDecodeWord fromCalldata offsetExpr) ]
    let stmts : Array Stmt := slicePre ++ loadRaw ++ #[
      .letVar word (.bitAnd (.localVar rawWord) (.literal fullMask)),
      .ite (.lt lenExpr (.literal byteWidth))
        [.assignVar word (.bitAnd (.localVar word) maskShift)]
        []
    ]
    return { pre := stmts, expr := .localVar word }
  if (← mKind inner) == "Identifier" then
    let id ← refInt inner
    if id ≥ 0 then
      if let some cb := (← get).calldataBytes.find? id.toNat then
        if !cb.inMemory then
          let word ← fresh
          let lenExpr := Expr.localVar cb.lengthBinding
          let rawWord := Expr.bitAnd (.calldataload (.localVar cb.dataBinding)) (.literal fullMask)
          let maskShift := Expr.shl (.mul (.literal 8) (.sub (.literal byteWidth) lenExpr)) (.literal fullMask)
          let stmts : Array Stmt := #[
            .letVar word rawWord,
            .ite (.lt lenExpr (.literal byteWidth))
              [.assignVar word (.bitAnd (.localVar word) maskShift)]
              []
          ]
          return { pre := stmts, expr := .localVar word }
  if ← isParameterizedCalldataBytesCall inner then
    let (fnId, vals) ← resolveCallTargetAndArgs inner
    let (cpre, cb) ← inlineCalldataBytesFn fnId vals inner
    let word ← fresh
    let lenExpr := Expr.localVar cb.lengthBinding
    let rawWord := Expr.bitAnd (.calldataload (.localVar cb.dataBinding)) (.literal fullMask)
    let maskShift := Expr.shl (.mul (.literal 8) (.sub (.literal byteWidth) lenExpr)) (.literal fullMask)
    let stmts : Array Stmt := cpre ++ #[
      .letVar word rawWord,
      .ite (.lt lenExpr (.literal byteWidth))
        [.assignVar word (.bitAnd (.localVar word) maskShift)]
        []
    ]
    return { pre := stmts, expr := .localVar word }
  if let some (pre, storageName, slotExpr, _) ← resolveStorageBytesTarget? inner then
    let (rawRead, arrField) ← if storageName != "" then do
      let info ← resolveField storageName at_
      unless info.bytesStorage do
        failAt at_ "storage byte conversion requires a string or bytes storage variable"
      markField storageName
      pure (Expr.storage storageName, storageName)
    else do
      modify fun e => { e with usedRawStorage := true }
      pure (Expr.storageArrayElement rawStorageFieldName slotExpr, rawStorageFieldName)
    modify fun e => { e with encodingMemory := true }
    let raw ← fresh
    let outOfPlace ← fresh
    let len ← fresh
    let dataSlot ← fresh
    let word ← fresh
    let shortCheck := Expr.lt (.localVar len) (.literal 32)
    let maskShift := Expr.shl (.mul (.literal 8) (.sub (.literal byteWidth) (.localVar len))) (.literal fullMask)
    let stmts : Array Stmt := pre ++ #[
      .letVar raw rawRead,
      .letVar outOfPlace (.bitAnd (.localVar raw) (.literal 1)),
      .letVar len (.div (.localVar raw) (.literal 2)),
      .ite (.eq (.localVar outOfPlace) (.literal 0))
        [.assignVar len (.bitAnd (.localVar len) (.literal 0x7f))]
        [],
      .ite (.eq (.localVar outOfPlace) shortCheck)
        [.panicCode (.literal 0x22)]
        [],
      .letVar word (.bitAnd (.localVar raw) (.literal fullMask)),
      .ite (.gt (.localVar len) (.literal 31))
        [ .mstore (.literal 0) slotExpr,
          .letVar dataSlot (.keccak256 (.literal 0) (.literal 32)),
          .assignVar word (.bitAnd (.storageArrayElement arrField (.localVar dataSlot)) (.literal fullMask)) ]
        [],
      .ite (.lt (.localVar len) (.literal byteWidth))
        [.assignVar word (.bitAnd (.localVar word) maskShift)]
        []
    ]
    return { pre := stmts, expr := .localVar word }
  let buf ← lowerEncodedBytes arg
  let ptr ← fresh
  let len ← fresh
  let word ← fresh
  let maskShift := Expr.shl (.mul (.literal 8) (.sub (.literal byteWidth) (.localVar len))) (.literal fullMask)
  let stmts : Array Stmt := buf.pre ++ #[
    .letVar ptr buf.pointer,
    .letVar len buf.size,
    .letVar word (.bitAnd (.mload (.localVar ptr)) (.literal fullMask)),
    .ite (.lt (.localVar len) (.literal byteWidth))
      [.assignVar word (.bitAnd (.localVar word) maskShift)]
      []
  ]
  return { pre := stmts, expr := .localVar word }

private partial def lowerStorageBytesRead (pre : Array Stmt) (name : String) (slotExpr : Expr) (at_ : Json) : M EncodedBytes := do
  let (rawRead, arrField) ← if name != "" then do
    let info ← resolveField name at_
    unless info.bytesStorage do
      failAt at_ "storage byte buffer read requires a string or bytes storage variable"
    markField name
    pure (Expr.storage name, name)
  else do
    modify fun e => { e with usedRawStorage := true }
    pure (Expr.storageArrayElement rawStorageFieldName slotExpr, rawStorageFieldName)
  modify fun e => { e with encodingMemory := true }
  let raw ← fresh
  let outOfPlace ← fresh
  let len ← fresh
  let pointer ← fresh
  let finish ← fresh
  let dataSlot ← fresh
  let wordCount ← fresh
  let copyIdx ← fresh
  let shortCheck := Expr.lt (.localVar len) (.literal 32)
  let reserveStmts := AbiEncoding.reserve pointer finish
    (.bitAnd (.add (.localVar len) (.literal 31)) (.bitNot (.literal 31)))
  let shortWord := Expr.bitAnd (.localVar raw) (.bitNot (.literal 0xff))
  let longBranch : List Stmt := [
    .mstore (.literal 0) slotExpr,
    .letVar dataSlot (.keccak256 (.literal 0) (.literal 32)),
    .letVar wordCount (.div (.add (.localVar len) (.literal 31)) (.literal 32)),
    .forEach copyIdx (.localVar wordCount) [
      .mstore (.add (.localVar pointer) (.mul (.localVar copyIdx) (.literal 32)))
        (.storageArrayElement arrField (.add (.localVar dataSlot) (.localVar copyIdx)))
    ]
  ]
  let stmts : Array Stmt := pre ++ #[
    .letVar raw rawRead,
    .letVar outOfPlace (.bitAnd (.localVar raw) (.literal 1)),
    .letVar len (.div (.localVar raw) (.literal 2)),
    .ite (.eq (.localVar outOfPlace) (.literal 0))
      [.assignVar len (.bitAnd (.localVar len) (.literal 0x7f))]
      [],
    .ite (.eq (.localVar outOfPlace) shortCheck)
      [.panicCode (.literal 0x22)]
      []
  ] ++ reserveStmts.toArray ++ #[
    .ite (.eq (.localVar outOfPlace) (.literal 0))
      [ .ite (.gt (.localVar len) (.literal 0))
          [.mstore (.localVar pointer) shortWord]
          [] ]
      longBranch
  ]
  return { pre := stmts, pointer := .localVar pointer, size := .localVar len }

private partial def lowerStorageBytesDelete (pre : Array Stmt) (name : String) (slotExpr : Expr) : M (Array Stmt) := do
  let (rawRead, rawWrite, arrField) ← if name != "" then do
    let _ ← resolveField name Json.null
    markField name
    pure (Expr.storage name, Stmt.setStorage name, name)
  else do
    modify fun e => { e with usedRawStorage := true }
    pure (Expr.storageArrayElement rawStorageFieldName slotExpr, Stmt.setStorageArrayElement rawStorageFieldName slotExpr, rawStorageFieldName)
  modify fun e => { e with encodingMemory := true }
  let oldRaw ← fresh
  let oldOutOfPlace ← fresh
  let oldLen ← fresh
  let dataSlot ← fresh
  let oldSlotCount ← fresh
  let clearIdx ← fresh
  let shortCheck := Expr.lt (.localVar oldLen) (.literal 32)
  let clearLong : List Stmt := [
    .mstore (.literal 0) slotExpr,
    .letVar dataSlot (.keccak256 (.literal 0) (.literal 32)),
    .letVar oldSlotCount (.div (.add (.localVar oldLen) (.literal 31)) (.literal 32)),
    .forEach clearIdx (.localVar oldSlotCount) [
      .setStorageArrayElement arrField (.add (.localVar dataSlot) (.localVar clearIdx)) (.literal 0)
    ],
    rawWrite (.literal 0)
  ]
  let stmts : Array Stmt := #[
    .letVar oldRaw rawRead,
    .letVar oldOutOfPlace (.bitAnd (.localVar oldRaw) (.literal 1)),
    .letVar oldLen (.div (.localVar oldRaw) (.literal 2)),
    .ite (.eq (.localVar oldOutOfPlace) (.literal 0))
      [.assignVar oldLen (.bitAnd (.localVar oldLen) (.literal 0x7f))]
      [],
    .ite (.eq (.localVar oldOutOfPlace) shortCheck)
      [.panicCode (.literal 0x22)]
      [],
    .ite (.gt (.localVar oldLen) (.literal 0))
      [ .ite (.gt (.localVar oldLen) (.literal 31))
          clearLong
          [rawWrite (.literal 0)] ]
      []
  ]
  return pre ++ stmts

private partial def lowerStorageBytesWrite (name : String) (pre : Array Stmt)
    (target right : Json) (slotExpr : Expr := .literal 0) (isString? : Option Bool := none) : M (Array Stmt) := do
  let (slotExpr, isString) ← match isString? with
    | some isStr => pure (slotExpr, isStr)
    | none =>
        let info ← resolveField name target
        pure (.literal info.slot, info.stringStorage)
  let targetTy ← mType target
  let rightTy ← mType right
  if isString then
    unless rightTy == "string" || rightTy == "string memory" || rightTy == "string calldata" ||
           rightTy == "string storage ref" || rightTy == "string storage pointer" ||
           rightTy.startsWith "literal_string " do
      failAt right s!"cannot assign {rightTy} to {targetTy}"
  else
    unless rightTy == "bytes" || rightTy == "bytes memory" || rightTy == "bytes calldata" ||
           rightTy == "bytes storage ref" || rightTy == "bytes storage pointer" ||
           rightTy.startsWith "literal_string " do
      failAt right s!"cannot assign {rightTy} to {targetTy}"
  let (rawRead, rawWrite, arrField) ← if name != "" then do
    let _ ← resolveField name target
    markField name
    pure (Expr.storage name, Stmt.setStorage name, name)
  else do
    modify fun e => { e with usedRawStorage := true }
    pure (Expr.storageArrayElement rawStorageFieldName slotExpr, Stmt.setStorageArrayElement rawStorageFieldName slotExpr, rawStorageFieldName)
  if name != "" then
    if let some (rPre, srcName, _, _) ← resolveStorageBytesTarget? right then
      if rPre.isEmpty && srcName == name then
        return pre
  let buf ← lowerEncodedBytes right
  modify fun e => { e with encodingMemory := true }
  let ptr ← fresh
  let newLen ← fresh
  let oldRaw ← fresh
  let oldOutOfPlace ← fresh
  let oldLen ← fresh
  let cleanupDataSlot ← fresh
  let oldSlotCount ← fresh
  let newSlotCount ← fresh
  let clearCount ← fresh
  let clearIdx ← fresh
  let writeDataSlot ← fresh
  let fullWords ← fresh
  let copyIdx ← fresh
  let remBytes ← fresh
  let lastWord ← fresh
  let shortWord ← fresh
  let shortCheck := Expr.lt (.localVar oldLen) (.literal 32)
  let maskDynamic (data bytes : Expr) : Expr :=
    .bitAnd data (.bitNot (.shr (.mul (.literal 8) bytes) (.bitNot (.literal 0))))
  let cleanupStmts : List Stmt := [
    .ite (.gt (.localVar oldLen) (.literal 31))
      [ .ite (.gt (.localVar oldLen) (.localVar newLen))
          [ .mstore (.literal 0) slotExpr,
            .letVar cleanupDataSlot (.keccak256 (.literal 0) (.literal 32)),
            .letVar oldSlotCount (.div (.add (.localVar oldLen) (.literal 31)) (.literal 32)),
            .letVar newSlotCount (.div (.add (.localVar newLen) (.literal 31)) (.literal 32)),
            .ite (.lt (.localVar newLen) (.literal 32))
              [.assignVar newSlotCount (.literal 0)]
              [],
            .letVar clearCount (.sub (.localVar oldSlotCount) (.localVar newSlotCount)),
            .forEach clearIdx (.localVar clearCount) [
              .setStorageArrayElement arrField
                (.add (.add (.localVar cleanupDataSlot) (.localVar newSlotCount)) (.localVar clearIdx))
                (.literal 0)
            ] ]
          [] ]
      []
  ]
  let rawWriteLong : Stmt := if name == "" then
    rawWrite (.add (.mul (.localVar newLen) (.literal 2)) (.literal 1))
  else
    .setStorage name (.add (.mul (.localVar newLen) (.literal 2)) (.literal 1))
  let writeLongStmts : List Stmt := [
    .mstore (.literal 0) slotExpr,
    .letVar writeDataSlot (.keccak256 (.literal 0) (.literal 32)),
    .letVar fullWords (.div (.localVar newLen) (.literal 32)),
    .forEach copyIdx (.localVar fullWords) [
      .setStorageArrayElement arrField
        (.add (.localVar writeDataSlot) (.localVar copyIdx))
        (.mload (.add (.localVar ptr) (.mul (.localVar copyIdx) (.literal 32))))
    ],
    .letVar remBytes (.bitAnd (.localVar newLen) (.literal 0x1f)),
    .ite (.gt (.localVar remBytes) (.literal 0))
      [ .letVar lastWord (.mload (.add (.localVar ptr) (.mul (.localVar fullWords) (.literal 32)))),
        .setStorageArrayElement arrField
          (.add (.localVar writeDataSlot) (.localVar fullWords))
          (maskDynamic (.localVar lastWord) (.localVar remBytes)) ]
      [],
    rawWriteLong
  ]
  let writeShortStmts : List Stmt := [
    .letVar shortWord (.literal 0),
    .ite (.gt (.localVar newLen) (.literal 0))
      [ .assignVar shortWord
          (maskDynamic (.mload (.localVar ptr)) (.localVar newLen)) ]
      [],
    rawWrite (.bitOr (.localVar shortWord) (.mul (.localVar newLen) (.literal 2)))
  ]
  let capture : Array Stmt := #[.letVar ptr buf.pointer, .letVar newLen buf.size]
  let stmts : Array Stmt := #[
    .ite (.gt (.localVar newLen) (.literal 0xffffffffffffffff))
      [.panicCode (.literal 0x41)]
      [],
    .letVar oldRaw rawRead,
    .letVar oldOutOfPlace (.bitAnd (.localVar oldRaw) (.literal 1)),
    .letVar oldLen (.div (.localVar oldRaw) (.literal 2)),
    .ite (.eq (.localVar oldOutOfPlace) (.literal 0))
      [.assignVar oldLen (.bitAnd (.localVar oldLen) (.literal 0x7f))]
      [],
    .ite (.eq (.localVar oldOutOfPlace) shortCheck)
      [.panicCode (.literal 0x22)]
      []
  ] ++ cleanupStmts.toArray ++ #[
    .ite (.gt (.localVar newLen) (.literal 31))
      writeLongStmts
      writeShortStmts
  ]
  -- solc builds a value right-hand side (literal, memory or calldata bytes, a call, an encoding)
  -- before the target's keys; a storage source is a reference it copies after them.
  if ((← mType right).splitOn " storage").length > 1 then
    return pre ++ buf.pre ++ capture ++ stmts
  return buf.pre ++ capture ++ pre ++ stmts

private partial def isAbiDecodeCall (j : Json) : M Bool := do
  let j ← stripParens j
  unless (← mKind j) == "FunctionCall" && optStr j "kind" == some "functionCall" do
    return false
  let callee ← mField j "expression"
  unless (← mKind callee) == "MemberAccess" && optStr callee "memberName" == some "decode" do
    return false
  let base ← mField callee "expression"
  if (← mKind base) == "Identifier" && optStr base "name" == some "abi" then
    return (← refInt base) == -1
  return false

private partial def isStaticAbiStructDecl (sDecl : Json) (fuel : Nat := 16) : M Bool := do
  if fuel == 0 then return false
  let sMembers ← mArr (← mField sDecl "members")
  if sMembers.isEmpty then return false
  for mNode in sMembers do
    let mTy ← mType mNode
    if mTy.startsWith "struct " && !mTy.contains "[" then
      let (_, subDecl) ← resolveStructDeclFromType mNode
      unless ← isStaticAbiStructDecl subDecl (fuel - 1) do return false
    else
      unless (paramType mTy).isSome do return false
  return true

private partial def flattenStaticAbiStructMembers (sDecl : Json) (prefix_ : String := "")
    (fuel : Nat := 16) : M (Array (String × String × Option Nat)) := do
  if fuel == 0 then
    failAt sDecl "nested struct depth exceeded in abi.decode"
  let sMembers ← mArr (← mField sDecl "members")
  if sMembers.isEmpty then
    failAt sDecl "empty struct in abi.decode is unsupported"
  let mut out : Array (String × String × Option Nat) := #[]
  for mNode in sMembers do
    let mName ← mStr (← mField mNode "name")
    let mTy ← mType mNode
    let qualName := if prefix_ == "" then mName else s!"{prefix_}.{mName}"
    if mTy.startsWith "struct " && !mTy.contains "[" then
      let (_, subDecl) ← resolveStructDeclFromType mNode
      unless ← isStaticAbiStructDecl subDecl (fuel - 1) do
        failAt mNode s!"unsupported abi.decode struct member type {mTy}"
      let subLeaves ← flattenStaticAbiStructMembers subDecl qualName (fuel - 1)
      out := out ++ subLeaves
    else
      unless (paramType mTy).isSome do
        failAt mNode s!"unsupported abi.decode struct member type {mTy}"
      let enumBound? ← validateEnumTypeIfNeeded mNode mTy
      out := out.push (qualName, mTy, enumBound?)
  return out

private partial def parseAbiDecodeItem (comp : Json) : M AbiDecodeTypeItem := do
  let comp ← stripParens comp
  if comp.isNull then
    failAt comp "empty abi.decode type component"
  let rawTy ← mType comp
  unless rawTy.startsWith "type(" && rawTy.endsWith ")" do
    failAt comp s!"abi.decode requires a type argument, found {rawTy}"
  let innerRaw := ((rawTy.drop 5).dropEnd 1).toString
  let cleanTy :=
    if innerRaw.endsWith " storage pointer" then (innerRaw.dropEnd 16).toString
    else if innerRaw.endsWith " storage ref" then (innerRaw.dropEnd 12).toString
    else if innerRaw.endsWith " memory" then (innerRaw.dropEnd 7).toString
    else if innerRaw.endsWith " calldata" then (innerRaw.dropEnd 9).toString
    else innerRaw
  if cleanTy == "bytes" then
    return .dynamicBytes false
  if cleanTy == "string" then
    return .dynamicBytes true
  if cleanTy.endsWith "[]" then
    let some (elemStr, elemPty, abiKind) := scalarArrayElement? cleanTy
      | failAt comp s!"unsupported abi.decode array type {cleanTy}"
    return .scalarArray elemStr elemPty abiKind
  if cleanTy.startsWith "struct " && !cleanTy.contains "[" then
    let refId := (field? comp "referencedDeclaration").bind (fun v => v.getInt?.toOption) |>.getD (-1)
    let (sid, sDecl) ← do
      if refId ≥ 0 then
        if let some decl := (← get).structs.find? refId.toNat then
          pure (refId.toNat, decl)
        else
          let targetName := ((cleanTy.drop 7).toString.splitOn ".").getLastD ""
          match (← get).structs.toList.filter (fun (_, d) => optStr d "name" == some targetName) with
          | [x] => pure x
          | _ => failAt comp s!"unable to resolve struct declaration for {cleanTy}"
      else
        let targetName := ((cleanTy.drop 7).toString.splitOn ".").getLastD ""
        match (← get).structs.toList.filter (fun (_, d) => optStr d "name" == some targetName) with
        | [x] => pure x
        | _ => failAt comp s!"unable to resolve struct declaration for {cleanTy}"
    let sName ← mStr (← mField sDecl "name")
    let sMembers ← mArr (← mField sDecl "members")
    if sMembers.isEmpty then
      failAt comp "empty struct in abi.decode is unsupported"
    -- Structs with dynamic scalar or flat-struct array members decode from
    -- memory by their complete schema; every other member keeps its diagnostic.
    let memberTypes ← sMembers.mapM mType
    unless memberTypes.all fun mTy => !mTy.startsWith "enum " && (paramType mTy).isSome do
      let structs := (← get).structs
      let enums := (← get).enums
      if let .ok schema := AbiSchema.root (fun id => structs.find? id) sDecl
          (resolveEnum := fun id => (enums.find? id).map (·.size)) then
        if schema.all AbiMemoryDecode.supportedMember && schema.any AbiSchema.isDynamicMember then
          let members ← sMembers.mapM fun mNode => do
            return (← mStr (← mField mNode "name"), ← mType mNode)
          return .dynamicStruct sid sName members schema
    -- Static structs (including nested static structs and `enum` / interface-typed
    -- members) occupy one ABI head word per leaf in declaration order, with each
    -- scalar word validated by `abiDecodeScalarGuard?`.
    let members ← flattenStaticAbiStructMembers sDecl
    return .flatStruct sid sName members
  let refId := (field? comp "referencedDeclaration").bind (fun v => v.getInt?.toOption) |>.getD (-1)
  let scalarTy ← if refId ≥ 0 then
    if let some uTy := (← get).userValueTypeById.find? refId.toNat then
      pure uTy
    else
      pure cleanTy
  else
    pure cleanTy
  let enumBound? ← validateEnumTypeIfNeeded comp scalarTy
  let some pty := paramType scalarTy
    | failAt comp s!"unsupported abi.decode type {cleanTy}"
  return .scalar scalarTy pty enumBound?

/-- `abi.decode(data, (S))` whose single target is a struct with dynamic members. -/
private partial def abiDecodesDynamicStruct (j : Json) : M Bool := do
  unless ← isAbiDecodeCall j do return false
  let j ← stripParens j
  let args ← mArr (← mField j "arguments")
  let some typeArg := args[1]? | return false
  let typeArg ← stripParens typeArg
  let comps ← if (← mKind typeArg) == "TupleExpression" then mArr (← mField typeArg "components")
    else pure #[typeArg]
  let #[comp] := comps | return false
  match ← parseAbiDecodeItem comp with
  | .dynamicStruct .. => return true
  | _ => return false

private partial def lowerAbiDecodeDataSource (rawNode callee : Json) : M (Array Stmt × Bool × Expr × Expr) := do
  let inner ← unwrapBytesConversion (← stripParens rawNode)
  if let some (slicePre, offsetExpr, lenExpr, fromCalldata, isMsgData) ← lowerCalldataSlice? inner then
    if isMsgData then
      failAt inner "msg.data slice in abi.decode must start at or after offset 4"
    return (slicePre, fromCalldata, offsetExpr, lenExpr)
  if ← isParameterizedCalldataBytesCall inner then
    let (fnId, vals) ← resolveCallTargetAndArgs inner
    let (cpre, cb) ← inlineCalldataBytesFn fnId vals inner
    let ptrVar ← fresh
    let lenVar ← fresh
    return (cpre ++ #[
      .letVar ptrVar (.localVar cb.dataBinding),
      .letVar lenVar (.localVar cb.lengthBinding)
    ], true, .localVar ptrVar, .localVar lenVar)
  if (← mKind inner) == "Identifier" then
    let id ← refInt inner
    if id ≥ 0 then
      if let some cb := (← get).calldataBytes.find? id.toNat then
        let ptrVar ← fresh
        let lenVar ← fresh
        if cb.inMemory then
          return (#[
            .letVar ptrVar (.add (.localVar cb.memoryPointer) (.literal 32)),
            .letVar lenVar (.localVar cb.lengthBinding)
          ], false, .localVar ptrVar, .localVar lenVar)
        else
          return (#[
            .letVar ptrVar (.localVar cb.dataBinding),
            .letVar lenVar (.localVar cb.lengthBinding)
          ], true, .localVar ptrVar, .localVar lenVar)
      if let some buf := (← get).byteBuffers.find? id.toNat then
        let ptrVar ← fresh
        let lenVar ← fresh
        return (buf.pre ++ #[
          .letVar ptrVar buf.pointer,
          .letVar lenVar buf.size
        ], false, .localVar ptrVar, .localVar lenVar)
      if let some (pre, storageName, slotExpr, _) ← resolveStorageBytesTarget? inner then
        let buf ← lowerStorageBytesRead pre storageName slotExpr inner
        let ptrVar ← fresh
        let lenVar ← fresh
        return (buf.pre ++ #[
          .letVar ptrVar buf.pointer,
          .letVar lenVar buf.size
        ], false, .localVar ptrVar, .localVar lenVar)
  if (← mKind inner) == "IndexAccess" then
    if let some (pre, storageName, slotExpr, _) ← resolveStorageBytesTarget? inner then
      let buf ← lowerStorageBytesRead pre storageName slotExpr inner
      let ptrVar ← fresh
      let lenVar ← fresh
      return (buf.pre ++ #[
        .letVar ptrVar buf.pointer,
        .letVar lenVar buf.size
      ], false, .localVar ptrVar, .localVar lenVar)
    if (← mType inner) == "bytes calldata" || (← mType inner) == "bytes memory" then
      let element? ← try
        (do
          match ← lowerRef inner with
          | .calldataBytes sid pre =>
            match (← get).calldataBytes.find? sid with
            | some cb => pure (some (pre, cb))
            | none => pure none
          | _ => pure none)
      catch _ => pure none
      if let some (pre, cb) := element? then
        let ptrVar ← fresh
        let lenVar ← fresh
        if cb.inMemory then
          return (pre ++ #[
            .letVar ptrVar (.add (.localVar cb.memoryPointer) (.literal 32)),
            .letVar lenVar (.localVar cb.lengthBinding)
          ], false, .localVar ptrVar, .localVar lenVar)
        else
          return (pre ++ #[
            .letVar ptrVar (.localVar cb.dataBinding),
            .letVar lenVar (.localVar cb.lengthBinding)
          ], true, .localVar ptrVar, .localVar lenVar)
  if (← mKind inner) == "MemberAccess" then
    if ← isAddressCodeAccess inner then
      let buf ← lowerExtCodeCopy inner
      return (buf.pre, false, buf.pointer, buf.size)
    if let some (pre, storageName, slotExpr, _) ← resolveStorageBytesTarget? inner then
      let buf ← lowerStorageBytesRead pre storageName slotExpr inner
      let ptrVar ← fresh
      let lenVar ← fresh
      return (buf.pre ++ #[
        .letVar ptrVar buf.pointer,
        .letVar lenVar buf.size
      ], false, .localVar ptrVar, .localVar lenVar)
    let innerTy ← mType inner
    if innerTy == "bytes" || innerTy == "bytes memory" || innerTy == "bytes calldata" then
      if (← mType (← mField inner "expression")).startsWith "struct " then
        if let .abiBytesField rootId memberIndex refPre ← lowerRef inner then
          let some mem := (← get).mems.find? rootId | failAt inner "unknown ABI root"
          let some schema := mem.schema | failAt inner "missing ABI schema"
          let some (.bytesField _ _) := schema[memberIndex]?
            | failAt inner "expected a schema-checked ABI bytes field"
          if mem.calldataLocation then
            let header ← fresh
            let length ← fresh
            let data ← fresh
            let checks := AbiLowering.calldataBytesFieldHead
              (.localVar (mem.abiStem ++ "_calldata")) memberIndex header length data
            return (refPre ++ checks.toArray, true, .localVar data, .localVar length)
          else
            let bytesPtr ← fresh
            let length ← fresh
            let dataPtr ← fresh
            let loadStmts : Array Stmt := #[
              .letVar bytesPtr (mem.memoryMemberWord memberIndex),
              .letVar length (.mload (.localVar bytesPtr)),
              .letVar dataPtr (.add (.localVar bytesPtr) (.literal 32))
            ]
            return (refPre ++ loadStmts, false, .localVar dataPtr, .localVar length)
  failAt callee "abi.decode is outside this slice"

private partial def lowerAbiDecodeItems (j : Json) : M (Array Stmt × Array AbiDecodedValue) := do
  let j ← stripParens j
  unless ← isAbiDecodeCall j do
    failAt j "expected abi.decode call"
  let callee ← mField j "expression"
  let args ← mArr (← mField j "arguments")
  unless args.size == 2 do
    failAt j "abi.decode requires a byte buffer and a type tuple"
  let typeArg ← stripParens args[1]!
  let typeComps ← if (← mKind typeArg) == "TupleExpression" then do
    if ← mBool (← mField typeArg "isInlineArray") then
      failAt typeArg "inline arrays are outside this slice"
    mArr (← mField typeArg "components")
  else
    pure #[typeArg]
  if typeComps.isEmpty then
    failAt typeArg "abi.decode requires at least one target type"
  let mut items : Array AbiDecodeTypeItem := #[]
  for comp in typeComps do
    items := items.push (← parseAbiDecodeItem comp)
  let decodesDynamicStruct := items.any fun
    | .dynamicStruct .. => true
    | _ => false
  if decodesDynamicStruct && items.size != 1 then
    failAt typeArg "abi.decode of a dynamic struct requires it as the only target type"
  let (srcPre, fromCalldata, basePtr, lenExpr) ← lowerAbiDecodeDataSource args[0]! callee
  if decodesDynamicStruct && fromCalldata then
    failAt args[0]! "abi.decode of a dynamic struct requires a bytes memory source"
  let mut totalHeadSize : Nat := 0
  for item in items do
    match item with
    | .scalar _ _ _ | .scalarArray _ _ _ | .dynamicBytes _ | .dynamicStruct .. =>
        totalHeadSize := totalHeadSize + 32
    | .flatStruct _ _ members =>
        totalHeadSize := totalHeadSize + 32 * members.size
  let mut pre := srcPre.push (AbiLowering.guard (.logicalNot (.lt lenExpr (.literal totalHeadSize))))
  let mut headCursor : Nat := 0
  let mut decoded : Array AbiDecodedValue := #[]
  let allocGuard (cond : Expr) : Stmt := .ite cond [] [.panicCode (.literal 0x41)]
  for item in items do
    match item with
    | .scalar ty pty enumBound? =>
        let wordVar ← fresh
        let wordAddr := if headCursor == 0 then basePtr else Expr.add basePtr (.literal headCursor)
        pre := pre.push (.letVar wordVar (readAbiDecodeWord fromCalldata wordAddr))
        if let some g := abiDecodeScalarGuard? ty enumBound? (.localVar wordVar) then
          pre := pre.push g
        decoded := decoded.push (.scalar ty pty (.localVar wordVar))
        headCursor := headCursor + 32
    | .flatStruct sid sName members =>
        let structPtr ← fresh
        let structFinish ← fresh
        modify fun e => { e with encodingMemory := true }
        pre := pre ++ (AbiEncoding.reserve structPtr structFinish (.literal (32 * members.size))).toArray
        let mut memberVals : Array (String × String × Expr) := #[]
        for mIdx in [:members.size] do
          let (mName, mTy, enumBound?) := members[mIdx]!
          let wordVar ← fresh
          let off := headCursor + 32 * mIdx
          let wordAddr := if off == 0 then basePtr else Expr.add basePtr (.literal off)
          pre := pre.push (.letVar wordVar (readAbiDecodeWord fromCalldata wordAddr))
          if let some g := abiDecodeScalarGuard? mTy enumBound? (.localVar wordVar) then
            pre := pre.push g
          pre := pre.push (.mstore (.add (.localVar structPtr) (.literal (32 * mIdx))) (.localVar wordVar))
          memberVals := memberVals.push (mName, mTy, .localVar wordVar)
        decoded := decoded.push (.flatStruct sid sName memberVals)
        headCursor := headCursor + 32 * members.size
    | .dynamicStruct sid sName members schema =>
        let stem ← freshMemoryDecodeStem schema
        modify fun e => { e with encodingMemory := true }
        let plan := AbiMemoryDecode.materialize basePtr (.add basePtr lenExpr) stem schema
        pre := pre ++ plan.body.toArray
        decoded := decoded.push (.dynamicStruct
          { structId := sid, param := stem, structName := sName, members,
            schema := some schema, abiStem := stem })
        headCursor := headCursor + 32
    | .scalarArray elemStr elemPty abiKind =>
        let relOff ← fresh
        let arrHeader ← fresh
        let arrLen ← fresh
        let arrPtr ← fresh
        let nextFree ← fresh
        let arrData ← fresh
        let copyIdx ← fresh
        let elemVal ← fresh
        let headAddr := if headCursor == 0 then basePtr else Expr.add basePtr (.literal headCursor)
        modify fun e => { e with encodingMemory := true }
        pre := pre ++ #[
          .letVar relOff (readAbiDecodeWord fromCalldata headAddr),
          AbiLowering.guard (.le (.localVar relOff) (.literal (2 ^ 64 - 1))),
          AbiLowering.guard (.le (.add (.localVar relOff) (.literal 32)) lenExpr),
          .letVar arrHeader (.add basePtr (.localVar relOff)),
          .letVar arrLen (readAbiDecodeWord fromCalldata (.localVar arrHeader)),
          allocGuard (.le (.localVar arrLen) (.literal (2 ^ 64 - 1))),
          .letVar arrPtr (.mload (.literal 64)),
          .letVar nextFree (.add (.localVar arrPtr) (.mul (.literal 32) (.add (.localVar arrLen) (.literal 1)))),
          allocGuard (.le (.localVar nextFree) (.literal (2 ^ 64 - 1))),
          allocGuard (.ge (.localVar nextFree) (.localVar arrPtr)),
          .letVar arrData (.add (.localVar arrHeader) (.literal 32)),
          AbiLowering.guard (.le (.add (.add (.localVar relOff) (.literal 32)) (.mul (.literal 32) (.localVar arrLen))) lenExpr),
          .mstore (.localVar arrPtr) (.localVar arrLen),
          .mstore (.literal 64) (.localVar nextFree)
        ]
        let elemAddr := Expr.add (.localVar arrData) (.mul (.localVar copyIdx) (.literal 32))
        let bound := SolidityAbi.scalarBound abiKind
        let elemChecks : List Stmt :=
          if elemStr == "bytes4" then
            [AbiLowering.guard (.eq (.bitAnd (.localVar elemVal) (.literal (2 ^ 224 - 1))) (.literal 0))]
          else if bound == 2 ^ 256 then []
          else [AbiLowering.guard (.lt (.localVar elemVal) (.literal bound))]
        let loopBody : List Stmt :=
          [ .letVar elemVal (readAbiDecodeWord fromCalldata elemAddr) ] ++
          elemChecks ++
          [ .mstore (.add (.add (.localVar arrPtr) (.literal 32)) (.mul (.localVar copyIdx) (.literal 32))) (.localVar elemVal) ]
        pre := pre.push (.forEach copyIdx (.localVar arrLen) loopBody)
        let desc : ScalarArrayParam := {
          param := arrPtr
          elementType := elemStr
          modelElementType := elemPty
          abiKind := abiKind
          inMemory := true
          lengthBinding := arrLen
          memoryPointer := arrPtr
        }
        decoded := decoded.push (.scalarArray elemStr elemPty abiKind desc)
        headCursor := headCursor + 32
    | .dynamicBytes isString =>
        let relOff ← fresh
        let byteHeader ← fresh
        let byteLen ← fresh
        let bytesPointer ← fresh
        let nextFree ← fresh
        let byteData ← fresh
        let copyIdx ← fresh
        let headAddr := if headCursor == 0 then basePtr else Expr.add basePtr (.literal headCursor)
        let alignedSize := Expr.bitAnd
          (.add (.add (.localVar byteLen) (.literal 32)) (.literal 31))
          (.bitNot (.literal 31))
        let wordCount := Expr.div (.add (.localVar byteLen) (.literal 31)) (.literal 32)
        modify fun e => { e with encodingMemory := true }
        pre := pre ++ #[
          .letVar relOff (readAbiDecodeWord fromCalldata headAddr),
          AbiLowering.guard (.le (.localVar relOff) (.literal (2 ^ 64 - 1))),
          AbiLowering.guard (.le (.add (.localVar relOff) (.literal 32)) lenExpr),
          .letVar byteHeader (.add basePtr (.localVar relOff)),
          .letVar byteLen (readAbiDecodeWord fromCalldata (.localVar byteHeader)),
          allocGuard (.le (.localVar byteLen) (.literal (2 ^ 64 - 1))),
          .letVar bytesPointer (.mload (.literal 64)),
          .letVar nextFree (.add (.localVar bytesPointer) alignedSize),
          allocGuard (.le (.localVar nextFree) (.literal (2 ^ 64 - 1))),
          allocGuard (.ge (.localVar nextFree) (.localVar bytesPointer)),
          .letVar byteData (.add (.localVar byteHeader) (.literal 32)),
          AbiLowering.guard (.le (.add (.add (.localVar relOff) (.literal 32)) (.localVar byteLen)) lenExpr),
          .mstore (.localVar bytesPointer) (.localVar byteLen),
          .mstore (.literal 64) (.localVar nextFree),
          .forEach copyIdx wordCount
            [.mstore (.add (.add (.localVar bytesPointer) (.literal 32)) (.mul (.localVar copyIdx) (.literal 32)))
              (readAbiDecodeWord fromCalldata (.add (.localVar byteData) (.mul (.localVar copyIdx) (.literal 32))))],
          .mstore (.add (.add (.localVar bytesPointer) (.literal 32)) (.localVar byteLen)) (.literal 0)
        ]
        let buf : EncodedBytes := {
          pre := #[]
          pointer := .add (.localVar bytesPointer) (.literal 32)
          size := .localVar byteLen
        }
        decoded := decoded.push (.dynamicBytes isString buf)
        headCursor := headCursor + 32
  return (pre, decoded)

private partial def lowerEncodedStaticStructWords (arg : Json) : M (Array Stmt × List Expr) := do
  let ty ← mType arg
  let (sid, sDecl) ← resolveStructDeclFromType arg
  let sMembers ← mArr (← mField sDecl "members")
  if sMembers.isEmpty then
    failAt arg s!"unsupported ABI encoding argument type {ty}"
  for mNode in sMembers do
    let mTy ← mType mNode
    unless (paramType mTy).isSome do
      failAt arg s!"unsupported ABI encoding argument type {ty}"
    discard (validateEnumTypeIfNeeded mNode mTy)
  checkEncodingStructArg arg
  let (_, _, sPre, memberVals) ← lowerFlatStructValue arg (some sid) true
  let mut pre : Array Stmt := sPre
  let mut words : List Expr := []
  for (_, _, expr) in memberVals do
    let v ← atom { pre := #[], expr }
    pre := pre ++ v.pre
    words := words ++ [v.expr]
  return (pre, words)

private partial def lowerMsgDataBuffer : M EncodedBytes := do
  let pointer ← fresh
  let finish ← fresh
  let copyIdx ← fresh
  let wordCount := Expr.div (.add .calldatasize (.literal 31)) (.literal 32)
  modify fun e => { e with encodingMemory := true }
  let alloc := AbiEncoding.reserve pointer finish (.mul (.literal 32) wordCount)
  let firstWord := Expr.bitOr (.calldataload (.literal 0)) (.shr (.literal 32) (.calldataload (.literal 4)))
  let copyStmt := Stmt.forEach copyIdx wordCount
    [.ite (.eq (.localVar copyIdx) (.literal 0))
      [.mstore (.localVar pointer) firstWord]
      [.mstore (.add (.localVar pointer) (.mul (.localVar copyIdx) (.literal 32)))
        (.calldataload (.mul (.localVar copyIdx) (.literal 32)))]]
  return { pre := (alloc ++ [copyStmt]).toArray, pointer := .localVar pointer, size := .calldatasize }

/-- `data[i]` of a root `bytes[]` parameter: its effects and element descriptor. -/
private partial def rootBytesElement? (j : Json) : M (Option (Array Stmt × CalldataBytesParam)) := do
  unless (← mKind j) == "IndexAccess" do return none
  let base ← stripParens (← mField j "baseExpression")
  unless (← mKind base) == "Identifier" do return none
  let id ← refInt base
  unless id ≥ 0 do return none
  let some mem := (← get).mems.find? id.toNat | return none
  let some word := mem.rootArrayWord | return none
  let some (.bytesArray _) := mem.schema.bind (·[word]?) | return none
  let .calldataBytes sid pre ← lowerRef j | return none
  let some cb := (← get).calldataBytes.find? sid | return none
  return some (pre, cb)

/-- Encode complete admitted byte schemas, without name-based library rules. -/
private partial def lowerEncodedBytes (j : Json) : M EncodedBytes := do
  let j ← stripParens j
  if let some (elemPre, cb) ← rootBytesElement? j then
    let buffer ← calldataBytesBuffer cb
    return { buffer with pre := elemPre ++ buffer.pre }
  if let some (slicePre, offsetExpr, lenExpr, fromCalldata, isMsgData) ← lowerCalldataSlice? j then
    let pointer ← fresh
    let finish ← fresh
    let copyIdx ← fresh
    let wordAddr ← fresh
    let wordVal ← fresh
    let wordCount := Expr.div (.add lenExpr (.literal 31)) (.literal 32)
    modify fun e => { e with encodingMemory := true }
    let alloc := AbiEncoding.reserve pointer finish (.mul (.literal 32) wordCount)
    let copyBody : List Stmt :=
      if isMsgData then
        [ .letVar wordAddr (.add offsetExpr (.mul (.localVar copyIdx) (.literal 32))),
          .letVar wordVal (.literal 0),
          .ite (.lt (.localVar wordAddr) (.literal 4))
            [ .assignVar wordVal
                (.bitOr
                  (.shl (.mul (.literal 8) (.localVar wordAddr)) (.calldataload (.literal 0)))
                  (.shr (.mul (.literal 8) (.sub (.literal 4) (.localVar wordAddr))) (.calldataload (.literal 4)))) ]
            [ .assignVar wordVal (.calldataload (.localVar wordAddr)) ],
          .mstore (.add (.localVar pointer) (.mul (.localVar copyIdx) (.literal 32))) (.localVar wordVal) ]
      else
        [ .mstore (.add (.localVar pointer) (.mul (.localVar copyIdx) (.literal 32)))
            (readAbiDecodeWord fromCalldata (.add offsetExpr (.mul (.localVar copyIdx) (.literal 32)))) ]
    let copyStmt := Stmt.forEach copyIdx wordCount copyBody
    let tailClear ← zeroByteBufferTail (.localVar pointer) lenExpr wordCount
    return { pre := slicePre ++ (alloc ++ [copyStmt]).toArray ++ tailClear, pointer := .localVar pointer, size := lenExpr }
  -- The whole of `msg.data`, as a helper returning it already reads it.
  if ← isMsgDataNode j then
    return ← lowerMsgDataBuffer
  if (← mKind j) == "Conditional" then
    let condNode ← mField j "condition"
    unless (← mType condNode) == "bool" do failAt condNode "conditional condition must be bool"
    let condVal ← atom (← lowerExpr condNode)
    let yesBuf ← lowerEncodedBytes (← mField j "trueExpression")
    let noBuf ← lowerEncodedBytes (← mField j "falseExpression")
    let ptr ← fresh
    let size ← fresh
    let yesStmts := yesBuf.pre ++ #[.assignVar ptr yesBuf.pointer, .assignVar size yesBuf.size]
    let noStmts := noBuf.pre ++ #[.assignVar ptr noBuf.pointer, .assignVar size noBuf.size]
    let stmts := condVal.pre ++ #[
      .letVar ptr (.literal 0),
      .letVar size (.literal 0),
      .ite condVal.expr yesStmts.toList noStmts.toList
    ]
    return { pre := stmts, pointer := .localVar ptr, size := .localVar size,
             shortStringAlloc := yesBuf.shortStringAlloc || noBuf.shortStringAlloc,
             ownedFresh := yesBuf.ownedFresh && noBuf.ownedFresh }
  if (← mKind j) == "Literal" then
    unless optStr j "kind" == some "hexString" || optStr j "kind" == some "string" ||
        optStr j "kind" == some "unicodeString" do
      failAt j "unsupported literal byte buffer"
    return ← lowerLiteralBytes j
  if (← mKind j) == "MemberAccess" && optStr j "memberName" == some "selector" &&
      (field? j "referencedDeclaration").isNone then
    return ← lowerSelectorBytes j
  if ← isStorageStructBytesMember j then
    if let some (pre, name, slotExpr, _) ← resolveStorageBytesTarget? j then
      return ← lowerStorageBytesRead pre name slotExpr j
  if (← mKind j) == "IndexAccess" then
    if let some (pre, name, slotExpr, _) ← resolveStorageBytesTarget? j then
      return ← lowerStorageBytesRead pre name slotExpr j
  if (← mKind j) == "MemberAccess" &&
      ((← mType j) == "bytes" || (← mType j) == "bytes memory" || (← mType j) == "bytes calldata" ||
       (← mType j) == "string" || (← mType j) == "string memory" || (← mType j) == "string calldata") then
    -- A `string` struct member has the `bytes` member encoding (`bytes(s.label)`).
    if (← mType (← mField j "expression")).startsWith "struct " then
      if let .abiBytesField id memberIndex pre ← lowerRef j then
        let some mem := (← get).mems.find? id | failAt j "unknown ABI root"
        let some schema := mem.schema | failAt j "missing ABI schema"
        let some (.bytesField _ _) := schema[memberIndex]?
          | failAt j "expected a schema-checked ABI bytes field"
        if mem.calldataLocation then
          let header ← fresh
          let length ← fresh
          let data ← fresh
          let checks := AbiLowering.calldataBytesFieldHead
            (.localVar (mem.abiStem ++ "_calldata")) memberIndex header length data
          let pointer ← fresh
          let finish ← fresh
          let copyIdx ← fresh
          let wordCount := Expr.div (.add (.localVar length) (.literal 31)) (.literal 32)
          modify fun e => { e with encodingMemory := true }
          let alloc := AbiEncoding.reserve pointer finish (.mul (.literal 32) wordCount)
          let copyStmt := Stmt.forEach copyIdx wordCount
            [.mstore (.add (.localVar pointer) (.mul (.localVar copyIdx) (.literal 32)))
              (.calldataload (.add (.localVar data) (.mul (.localVar copyIdx) (.literal 32))))]
          return { pre := pre ++ checks.toArray ++ (alloc ++ [copyStmt]).toArray,
                   pointer := .localVar pointer, size := .localVar length }
        else
          let bytesPtr ← fresh
          let length ← fresh
          let loadStmts : Array Stmt := #[
            .letVar bytesPtr (mem.memoryMemberWord memberIndex),
            .letVar length (.mload (.localVar bytesPtr))
          ]
          return { pre := pre ++ loadStmts,
                   pointer := .add (.localVar bytesPtr) (.literal 32),
                   size := .localVar length }
  if (← mKind j) == "Identifier" then
    let id ← refInt j
    if id ≥ 0 then
      if let some buffer := (← get).byteBuffers.find? id.toNat then
        return { buffer with
          shortStringAlloc := buffer.shortStringAlloc ||
            (← get).shortStringBuffers.contains id.toNat,
          ownedFresh := false,
          ownedMutable := false }
      if let some buffer := (← get).stringBuffers.find? id.toNat then
        return { buffer with
          shortStringAlloc := buffer.shortStringAlloc ||
            (← get).shortStringBuffers.contains id.toNat,
          ownedFresh := false,
          ownedMutable := false }
      if let some cb := (← get).calldataBytes.find? id.toNat then
        return ← calldataBytesBuffer cb
      if let some (name, slotExpr, _) := (← get).storageBytesVars.find? id.toNat then
        return ← lowerStorageBytesRead #[] name slotExpr j
    let some decl := (← get).stateVars.find? id.toNat
      | failAt j "only literal constants are supported as named byte buffers"
    if (field? decl "constant").bind (fun value => value.getBool?.toOption) == some true then
      let value ← mField decl "value"
      let some literal ← constantByteLiteral? value
        | failAt value "byte constant must have a literal initializer"
      return ← lowerEncodedBytes literal
    if optStr decl "mutability" == some "immutable" then
      let name ← mStr (← mField decl "name")
      failAt j s!"immutable state variable {name} is outside this slice"
    let name ← mStr (← mField decl "name")
    let env ← get
    if env.duplicateLayoutLabels.contains name then
      failAt j s!"shadowed storage declaration {name} is outside this slice"
    if let some item := env.layoutItems.find? name then
      unless (← mNat (← mField item "astId")) == id.toNat do
        failAt j s!"shadowed storage declaration {name} is outside this slice"
    let info ← resolveField name j
    if info.bytesStorage then
      if info.keyCount == 0 then
        return ← lowerStorageBytesRead #[] name (.literal info.slot) j
    failAt j "mutable byte buffers are unsupported"
  if (← mKind j) == "MemberAccess" && optStr j "memberName" == some "code" &&
      (field? j "referencedDeclaration").isNone then
    failAt j "external contract code reads are outside this slice"
  unless (← mKind j) == "FunctionCall" do
    failAt j "hash input must be a supported ABI encoding"
  if optStr j "kind" == some "typeConversion" then
    let ty ← mType j
    if ty == "bytes" || ty == "bytes memory" || ty == "bytes calldata" || ty == "bytes storage pointer" ||
       ty == "string" || ty == "string memory" || ty == "string calldata" || ty == "string storage pointer" then
      let args ← mArr (← mField j "arguments")
      unless args.size == 1 do failAt j s!"{ty} conversion expects one argument"
      return ← lowerEncodedBytes args[0]!
  let callee ← mField j "expression"
  if optStr j "kind" == some "functionCall" && (← mKind callee) == "NewExpression" then
    let ty ← mType j
    if ty == "bytes" || ty == "bytes memory" || ty == "string" || ty == "string memory" then
      let args ← mArr (← mField j "arguments")
      if args.size == 1 && (← parseNatConstExpr? args[0]!) == some 0 then
        let pointer ← fresh
        let finish ← fresh
        modify fun env => { env with encodingMemory := true }
        return { pre := (AbiEncoding.staticWords pointer finish []).toArray,
                 pointer := .localVar pointer, size := .literal 0 }
  if optStr j "kind" == some "functionCall" && (← mKind callee) == "MemberAccess" then
    let base ← mField callee "expression"
    if (← mKind base) == "ElementaryTypeNameExpression" &&
        optStr callee "memberName" == some "concat" &&
        (field? callee "referencedDeclaration").isNone then
      let tname := optStr (field? base "typeName" |>.getD Json.null) "name" |>.getD ""
      let args ← mArr (← mField j "arguments")
      if tname == "bytes" then
        for arg in args do
          let argTy ← mType arg
          unless argTy == "bytes" || argTy == "bytes memory" || argTy == "bytes calldata" ||
              argTy == "bytes storage ref" || argTy == "bytes storage pointer" ||
              argTy == "bytes32" || argTy == "bytes4" || argTy == "bytes1" || argTy.startsWith "literal_string " do
            failAt arg s!"unsupported bytes.concat argument type {argTy}"
        return ← lowerPacked args
      if tname == "string" then
        for arg in args do
          let argTy ← mType arg
          unless argTy == "string" || argTy == "string memory" || argTy == "string calldata" ||
              argTy == "string storage ref" || argTy == "string storage pointer" ||
              argTy.startsWith "literal_string " do
            failAt arg s!"unsupported string.concat argument type {argTy}"
        return ← lowerPacked args
  if optStr j "kind" == some "functionCall" then
    let isHelperCall :=
      ((← mKind callee) == "Identifier" || (← mKind callee) == "MemberAccess") &&
      ((field? callee "referencedDeclaration").bind (fun v => v.getInt?.toOption)).any (· ≥ 0)
    if isHelperCall then
      let ty ← mType j
      if ty == "bytes calldata" then
        if ← isParameterizedCalldataBytesCall j then
          let (fnId, vals) ← resolveCallTargetAndArgs j
          let (cpre, cb) ← inlineCalldataBytesFn fnId vals j
          let buf ← calldataBytesBuffer cb
          return { buf with pre := cpre ++ buf.pre }
        let names ← mArr (← mField j "names")
        unless names.isEmpty do failAt j "named call arguments are outside this slice"
        let callArgs ← mArr (← mField j "arguments")
        unless callArgs.isEmpty do failAt j "msg.data helper call must take zero arguments"
        let (fnId, vals) ← resolveCallTargetAndArgs j
        let msgPre ← inlineMsgDataFn fnId vals j
        let msgBuf ← lowerMsgDataBuffer
        return { msgBuf with pre := msgPre ++ msgBuf.pre }
      if ty == "string memory" || ty == "string" || ty == "bytes memory" || ty == "bytes" then
        -- An external call returning `bytes` / `string` (`c.name()`) needs dynamic return
        -- decoding: `resolveCallTargetAndArgs` rejects it at the callee.
        let (fnId, vals) ← resolveCallTargetAndArgs j
        return ← inlineStringFn fnId vals j
  unless (← mKind callee) == "MemberAccess" do
    failAt callee "hash input must be a supported ABI encoding"
  let base ← mField callee "expression"
  let isAbiBuiltin ← if (← mKind base) == "Identifier" && optStr base "name" == some "abi" then
    pure ((← refInt base) == -1)
  else
    pure false
  unless isAbiBuiltin do
    failAt callee "encoding does not resolve to the abi builtin"
  let args ← mArr (← mField j "arguments")
  if optStr callee "memberName" == some "decode" then
    let (decodePre, decoded) ← lowerAbiDecodeItems j
    unless decoded.size == 1 do
      failAt j "abi.decode byte buffer expression requires a single bytes or string target type"
    let .dynamicBytes _ buf := decoded[0]!
      | failAt j "abi.decode byte buffer expression requires a bytes or string target type"
    return { pre := decodePre ++ buf.pre, pointer := buf.pointer, size := buf.size }
  if optStr callee "memberName" == some "encodePacked" then
    return ← lowerPacked args (sourceOrder := true)
  if optStr callee "memberName" == some "encodeWithSelector" then
    unless args.size ≥ 1 do
      failAt j "abi.encodeWithSelector requires a selector argument"
    let selBuffer ← lowerSelectorBytes args[0]!
    let restArgs := args.extract 1 args.size
    let hasDynamic ← restArgs.anyM fun arg => do
      let ty ← mType arg
      pure (ty == "bytes" || ty == "bytes memory" || ty == "bytes calldata" ||
            ty == "bytes storage ref" || ty == "bytes storage pointer" ||
            ty == "string" || ty == "string memory" || ty == "string calldata" ||
            ty == "string storage ref" || ty == "string storage pointer" ||
            ty.startsWith "literal_string " || (scalarArrayElement? ty).isSome)
    if hasDynamic then
      if (← get).forwardingBytesTuple then
        failAt j "abi.encodeWithSelector with dynamic arguments in a forwarded tuple requires dynamic ABI encoding"
      let payload ← lowerAbiEncodeArgs restArgs
      return ← prefixSelector selBuffer payload
    let mut pre := selBuffer.pre
    let mut words := []
    for arg in restArgs do
      let ty ← mType arg
      if ty.startsWith "struct " && !ty.contains "[" then
        let (sPre, sWords) ← lowerEncodedStaticStructWords arg
        pre := pre ++ sPre
        words := words ++ sWords
      else
        unless (paramType ty).isSome do
          failAt arg s!"unsupported ABI encoding argument type {ty}"
        checkEncodingScalar arg
        let value ← atom (← lowerExpr arg)
        pre := pre ++ value.pre
        words := words ++ [cleanHelperResultExpr ty value]
    return ← encodeSelectorAndWords selBuffer pre words
  if optStr callee "memberName" == some "encodeWithSignature" then
    unless args.size ≥ 1 do
      failAt j "abi.encodeWithSignature requires a signature argument"
    let sigNode := args[0]!
    let sigTy ← mType sigNode
    unless sigTy == "string" || sigTy == "string memory" || sigTy == "string calldata" ||
        sigTy == "string storage ref" || sigTy == "string storage pointer" ||
        sigTy.startsWith "literal_string " do
      failAt sigNode s!"unsupported abi.encodeWithSignature signature type {sigTy}"
    let sigBuf ← lowerEncodedBytes sigNode
    let selPtr ← fresh
    let selFinish ← fresh
    modify fun e => { e with encodingMemory := true }
    let selWord := Expr.bitAnd (.keccak256 sigBuf.pointer sigBuf.size) (.literal (0xffffffff * 16 ^ 56))
    let selBuffer : EncodedBytes :=
      { pre := sigBuf.pre ++ (AbiEncoding.staticWords selPtr selFinish [selWord]).toArray,
        pointer := .localVar selPtr,
        size := .literal 4 }
    let restArgs := args.extract 1 args.size
    let hasDynamic ← restArgs.anyM fun arg => do
      let ty ← mType arg
      pure (ty == "bytes" || ty == "bytes memory" || ty == "bytes calldata" ||
            ty == "bytes storage ref" || ty == "bytes storage pointer" ||
            ty == "string" || ty == "string memory" || ty == "string calldata" ||
            ty == "string storage ref" || ty == "string storage pointer" ||
            ty.startsWith "literal_string " || (scalarArrayElement? ty).isSome)
    if hasDynamic then
      if (← get).forwardingBytesTuple then
        failAt j "abi.encodeWithSignature with dynamic arguments in a forwarded tuple requires dynamic ABI encoding"
      let payload ← lowerAbiEncodeArgs restArgs
      return ← prefixSelector selBuffer payload
    let mut pre := selBuffer.pre
    let mut words := []
    for arg in restArgs do
      let ty ← mType arg
      if ty.startsWith "struct " && !ty.contains "[" then
        let (sPre, sWords) ← lowerEncodedStaticStructWords arg
        pre := pre ++ sPre
        words := words ++ sWords
      else
        unless (paramType ty).isSome do
          failAt arg s!"unsupported ABI encoding argument type {ty}"
        checkEncodingScalar arg
        let value ← atom (← lowerExpr arg)
        pre := pre ++ value.pre
        words := words ++ [cleanHelperResultExpr ty value]
    return ← encodeSelectorAndWords selBuffer pre words
  if optStr callee "memberName" == some "encodeCall" then
    unless args.size == 2 do
      failAt j "abi.encodeCall requires a function pointer and an argument tuple"
    let (decl, selBuffer) ← lowerMemberFunctionSelector args[0]!
    unless (← mKind decl) == "FunctionDefinition" do
      failAt args[0]! "abi.encodeCall target must be a function declaration"
    let params ← mArr (← mField (← mField decl "parameters") "parameters")
    let callArgs ← if (← mKind args[1]!) == "TupleExpression" then do
      if ← mBool (← mField args[1]! "isInlineArray") then
        failAt args[1]! "inline arrays are outside this slice"
      mArr (← mField args[1]! "components")
    else
      pure #[args[1]!]
    unless callArgs.size == params.size do
      failAt args[1]! s!"abi.encodeCall argument count {callArgs.size} does not match declaration {params.size}"
    if ← params.anyM (fun p => return (← mType p) == "bytes") then
      -- solc encodes the selector, then the arguments as `abi.encode` with the parameter
      -- types: static heads, an offset for each `bytes`, then its length and padded data.
      if (← get).forwardingBytesTuple then
        failAt j "abi.encodeCall with a bytes parameter in a forwarded tuple requires dynamic ABI encoding"
      for idx in [:params.size] do
        if callArgs[idx]!.isNull then failAt args[1]! "empty abi.encodeCall tuple component"
        let pty ← mType params[idx]!
        unless pty == "bytes" || (paramType pty).isSome do
          failAt callArgs[idx]! s!"abi.encodeCall parameter type {pty} beside a bytes parameter is outside this slice"
      let payload ← lowerAbiEncodeArgs callArgs (some params)
      return ← prefixSelector selBuffer payload
    let mut pre := selBuffer.pre
    let mut words := []
    for idx in [:params.size] do
      let p := params[idx]!
      let arg := callArgs[idx]!
      if arg.isNull then failAt args[1]! "empty abi.encodeCall tuple component"
      let pty ← mType p
      let argTy ← mType arg
      if pty.startsWith "struct " && !pty.contains "[" then
        let (pSid, pDecl) ← resolveStructDeclFromType p
        let pMembers ← mArr (← mField pDecl "members")
        if pMembers.isEmpty then
          failAt p s!"unsupported ABI encoding argument type {pty}"
        for mNode in pMembers do
          let mTy ← mType mNode
          unless (paramType mTy).isSome do
            failAt p s!"unsupported ABI encoding argument type {pty}"
          discard (validateEnumTypeIfNeeded mNode mTy)
        unless argTy.startsWith "struct " && !argTy.contains "[" do
          failAt arg s!"abi.encodeCall argument type {argTy} does not match parameter {pty}"
        let (argSid, _) ← resolveStructDeclFromType arg
        unless pSid == argSid do
          failAt arg s!"abi.encodeCall argument type {argTy} does not match parameter {pty}"
        let (sPre, sWords) ← lowerEncodedStaticStructWords arg
        pre := pre ++ sPre
        words := words ++ sWords
      else
        unless (paramType pty).isSome do
          failAt p s!"unsupported ABI encoding argument type {pty}"
        checkEncodingScalar arg
        let rawVal ← lowerExpr arg
        let converted ← convert pty argTy rawVal arg
        if let some b := bitsOf pty then
          if b < 256 && (argTy.startsWith "int_const" && !argTy.startsWith "int_const -") then
            if let .literal n := converted.expr then
              unless n < 2 ^ b do
                failAt arg s!"literal {n} exceeds width of {pty}"
        let value ← atom converted
        pre := pre ++ value.pre
        words := words ++ [cleanHelperResultExpr pty value]
    return ← encodeSelectorAndWords selBuffer pre words
  unless optStr callee "memberName" == some "encode" do
    failAt callee "unsupported ABI encoding builtin"
  lowerAbiEncodeArgs args (orderedEffects := true)

/-- A dynamic storage array of ABI scalars (a state variable, a storage pointer
local or a struct member) copied into a fresh memory array, as solc copies a
storage array it ABI-encodes (`copyStorageDynamicArrayToMemory`, the copy of
`T[] memory m = arr;`). The copy is registered as a memory array under a fresh
id. `none` if `arg` is not a storage array. -/
private partial def copyStorageScalarArray? (arg : Json) : M (Option (Array Stmt × Nat)) := do
  let ty ← mType arg
  unless ty.endsWith " storage ref" || ty.endsWith " storage pointer" do return none
  let some (pre, fieldName, slotExpr, elemTy, modelElemTy, abiKind, none) ←
      resolveStorageDynamicArrayTarget (← lowerRef arg) arg
    | failAt arg "unsupported storage array copy source"
  let (copyPre, desc) ← copyStorageDynamicArrayToMemory pre fieldName slotExpr elemTy modelElemTy abiKind ""
  let arrId := 1000000000 + (← get).next
  modify fun e => { e with next := e.next + 1, scalarArrays := e.scalarArrays.insert arrId desc }
  return some (copyPre, arrId)

/-- `abi.encode(args...)` into a fresh aligned memory buffer.

With `orderedEffects` (the `abi.encode` builtin) and an all-static argument list, internal
helpers that change state, `x++` / `--m[k]` and `x = v` may appear among the arguments, and
siblings may read mapping and array elements. Both solc 0.8.34 pipelines
evaluate the arguments left to right before encoding, so each word is then bound to a
temporary at its own position and every effect runs once, in source order. A struct
argument is read by solc only while encoding, after every later argument has run, so it
stays rejected beside such a helper, as do the dynamic and other encoding forms. -/
private partial def lowerAbiEncodeArgs (args : Array Json)
    (params? : Option (Array Json) := none) (orderedEffects : Bool := false)
    (memoryCopy : Bool := false) (externalArgs : Bool := false) : M EncodedBytes := do
  if args.size == 1 && params?.isNone then
    if (← mType args[0]!).startsWith "struct " && !(← mType args[0]!).contains "[" then
      let isMemRoot ← if (← mKind args[0]!) != "FunctionCall" && (← mKind args[0]!) != "Conditional" && (← mKind args[0]!) != "TupleExpression" then
        match ← lowerRef args[0]! with
        | .mem _ _ => pure true
        | _ => pure false
      else
        pure false
      if isMemRoot then
        return ← lowerEncodedRoot args[0]!
  let isDynamicBytesOrString (ty : String) : Bool :=
    ty == "bytes" || ty == "bytes memory" || ty == "bytes calldata" ||
    ty == "bytes storage ref" || ty == "bytes storage pointer" ||
    ty == "string" || ty == "string memory" || ty == "string calldata" ||
    ty == "string storage ref" || ty == "string storage pointer" ||
    ty.startsWith "literal_string "
  -- A string literal against a declared `bytesN` parameter or return component is that
  -- static `bytesN` value (its bytes left-aligned in one head word), not a dynamic `string`.
  let literalAsFixedBytes (argIdx : Nat) : M Bool := do
    let some ps := params? | return false
    return (← mType args[argIdx]!).startsWith "literal_string " &&
      (fixedBytesWidth? (← mType ps[argIdx]!)).isSome
  let isDynamicArg (argIdx : Nat) : M Bool := do
    return isDynamicBytesOrString (← mType args[argIdx]!) && !(← literalAsFixedBytes argIdx)
  let dynamicStructMem? (arg : Json) : M (Option (Nat × Array Stmt × List AbiSchema.Member)) := do
    let ty ← mType arg
    unless ty.startsWith "struct " && !ty.contains "[" do return none
    unless (← mKind arg) != "FunctionCall" && (← mKind arg) != "Conditional" &&
        (← mKind arg) != "TupleExpression" do
      return none
    match ← lowerRef arg with
    | .mem id effects =>
        match (← get).mems.find? id with
        | some mem => return mem.schema.map fun schema => (id, effects, schema)
        | none => return none
    | _ => return none
  let hasDynamic ← (List.range args.size).anyM fun argIdx => do
    let arg := args[argIdx]!
    let ty ← mType arg
    return (← isDynamicArg argIdx) || (scalarArrayElement? ty).isSome ||
      (← dynamicStructMem? arg).isSome
  if hasDynamic then
    let dynEnv ← get
    let hasDynMutation := externalArgs && args.any (fun a => statefulCallIn a dynEnv || assignmentIn a)
    let mut pre : Array Stmt := #[]
    let mut headWords : Array (Option Expr) := #[]
    let mut dynTails : Array (Nat × Sum (Nat × List AbiSchema.Member × Json) (Sum (Expr × Expr) Nat)) := #[]
    -- Storage `bytes` / `string` reads deferred to encoding time (`deferredStorageBytesArgument?`):
    -- the `dynTails` index, the head index, the field, the slot and the argument.
    let mut deferred : Array (Nat × Nat × String × Expr × Json) := #[]
    for argIdx in [:args.size] do
      let arg := args[argIdx]!
      let ty ← mType arg
      let targetTy ← match params? with
        | some ps => mType ps[argIdx]!
        | none => pure ty
      if ← isDynamicArg argIdx then
        if args.size > 1 && (assignmentIn arg || statefulCallIn arg (← get)) then
          failAt arg "effectful ABI encoding argument is unsupported"
        -- A pure or view helper that may revert (`string` / `bytes` result) runs here, at its
        -- own position: both solc pipelines evaluate the arguments left to right, and a revert
        -- of a scalar or memory sibling sits in its `pre`, also at its position. Calldata and
        -- storage siblings are rejected beside it: solc reads a storage `string` / `bytes`
        -- (panic 0x22 on a corrupt encoding) and may validate a calldata array only while
        -- encoding, after the helper has run, whereas they are lowered at their position.
        if args.size > 1 && jsonHasCustomRevert (← get) [] arg then
          if revertingConcatIn (← get) [] arg then
            failAt arg "reverting concat ABI encoding argument beside other arguments is unsupported"
          for otherIdx in [:args.size] do
            if otherIdx != argIdx && (← mType args[otherIdx]!).contains "calldata" then
              failAt args[otherIdx]! "calldata ABI encoding argument beside a reverting helper is unsupported"
            if otherIdx != argIdx && (← mType args[otherIdx]!).contains " storage" then
              failAt args[otherIdx]! "storage ABI encoding argument beside a reverting helper is unsupported"
        if args.size > 1 && (ty.splitOn " storage").length > 1 then
          -- solc validates a calldata array or struct argument while encoding it, in argument
          -- order, whereas the lowering validates it at its position (a static struct) or in
          -- the tails (an array, a struct with a dynamic member), and reads a storage bytes /
          -- string argument after every argument (deferred) or at its position (a storage
          -- conditional): either order can differ from solc's, so such a sibling, on either
          -- side, is rejected.
          for otherIdx in [:args.size] do
            let otherTy ← mType args[otherIdx]!
            if otherIdx != argIdx && otherTy.contains "calldata" &&
                ((scalarArrayElement? otherTy).isSome || otherTy.startsWith "struct ") then
              failAt args[otherIdx]! "calldata array or struct ABI encoding argument beside a storage bytes/string argument is unsupported"
        if args.size > 1 then
          if let some (refPre, name, slot) ← deferredStorageBytesArgument? args argIdx then
            pre := pre ++ refPre
            let headIdx := headWords.size
            headWords := headWords.push none
            deferred := deferred.push (dynTails.size, headIdx, name, slot, arg)
            dynTails := dynTails.push (headIdx, .inr (.inl (.literal 0, .literal 0)))
            continue
        let buf ← lowerEncodedBytes arg
        let ptrVal ← if isAtom buf.pointer then pure { pre := #[], expr := buf.pointer } else atom { pre := #[], expr := buf.pointer }
        let sizeVal ← if isAtom buf.size then pure { pre := #[], expr := buf.size } else atom { pre := #[], expr := buf.size }
        pre := pre ++ buf.pre ++ ptrVal.pre ++ sizeVal.pre
        let headIdx := headWords.size
        headWords := headWords.push none
        dynTails := dynTails.push (headIdx, .inr (.inl (ptrVal.expr, sizeVal.expr)))
      else if (scalarArrayElement? ty).isSome then
        if let some (copyPre, arrId) ← copyStorageScalarArray? arg then
          -- solc evaluates every argument before it copies the storage array
          -- while encoding; the copy here runs at the argument's position.
          let env ← get
          -- An effect in the array's own path (a mapping key) runs before
          -- earlier heads that are read as deferred expressions.
          if args.size > 1 && (assignmentIn arg || statefulCallIn arg env || jsonHasCustomRevert env [] arg) then
            failAt arg "effectful ABI encoding argument is unsupported"
          if let some later := (args.extract (argIdx + 1) args.size).find? fun a =>
              assignmentIn a || statefulCallIn a env then
            failAt later "state-writing ABI encoding argument after a storage array is unsupported"
          pre := pre ++ copyPre
          let headIdx := headWords.size
          headWords := headWords.push none
          dynTails := dynTails.push (headIdx, .inr (.inr arrId))
          continue
        if (← mKind (← stripParens arg)) != "Identifier" then
          -- `new T[](n)`, an array helper result or a nested-array row: the
          -- memory array value, encoded like a binding of it.
          if args.size > 1 && (assignmentIn arg || statefulCallIn arg (← get) || jsonHasCustomRevert (← get) [] arg) then
            failAt arg "effectful ABI encoding argument is unsupported"
          let some (elemStr, _, _) := scalarArrayElement? ty
            | failAt arg s!"unsupported ABI encoding argument type {ty}"
          let (valPre, desc) ← lowerDynArrayValue arg elemStr
          let arrId := 1000000000 + (← get).next
          modify fun e => { e with next := e.next + 1, scalarArrays := e.scalarArrays.insert arrId desc }
          pre := pre ++ valPre
          let headIdx := headWords.size
          headWords := headWords.push none
          dynTails := dynTails.push (headIdx, .inr (.inr arrId))
          continue
        unless (← mKind arg) == "Identifier" do
          failAt arg s!"unsupported ABI encoding argument type {ty}"
        let .scalarArray arrId arrPre ← lowerRef arg
          | failAt arg s!"unsupported ABI encoding argument type {ty}"
        -- A root result's copy of a calldata array: legacy ABI coder v1 copies the words raw.
        if memoryCopy && !(← get).viaIR && (← get).abiCoderV1 then
          if let some arr := (← get).scalarArrays.find? arrId then
            if !arr.inMemory && AbiLowering.legacyCleanNarrows arr.abiKind
                (if arr.elementType == "bytes4" then 2 ^ 224 - 1 else 0) then
              failAt arg "narrow calldata array copied to memory under ABI coder v1 is outside this slice"
        pre := pre ++ arrPre
        let headIdx := headWords.size
        headWords := headWords.push none
        dynTails := dynTails.push (headIdx, .inr (.inr arrId))
      else if let some (id, effects, schema) ← dynamicStructMem? arg then
        checkEncodingStructRef arg
        pre := pre ++ effects
        let headIdx := headWords.size
        headWords := headWords.push none
        dynTails := dynTails.push (headIdx, .inl (id, schema, arg))
      else if ty.startsWith "struct " && !ty.contains "[" then
        let (sPre, sWords) ← lowerEncodedStaticStructWords arg
        pre := pre ++ sPre
        for w in sWords do
          headWords := headWords.push (some w)
      else
        unless (paramType targetTy).isSome do
          failAt arg s!"unsupported ABI encoding argument type {targetTy}"
        if externalArgs then
          let env ← get
          if statefulCallIn arg env || assignmentIn arg then
            for otherIdx in [:args.size] do
              if otherIdx != argIdx then
                let otherTy ← mType args[otherIdx]!
                if otherTy.contains " storage" || (otherTy.startsWith "struct " && !otherTy.contains "[") then
                  failAt args[otherIdx]! "storage or struct ABI encoding argument beside a state-changing argument is unsupported"
          if jsonHasCustomRevert env [] arg then
            for otherIdx in [:args.size] do
              if otherIdx != argIdx then
                let otherTy ← mType args[otherIdx]!
                if otherTy.contains " storage" then
                  failAt args[otherIdx]! "storage ABI encoding argument beside a reverting helper is unsupported"
                if otherTy.contains "calldata" &&
                    ((scalarArrayElement? otherTy).isSome || otherTy.startsWith "struct ") then
                  failAt args[otherIdx]! "calldata array or struct ABI encoding argument beside a reverting helper is unsupported"
        checkEncodingScalar arg externalArgs
        let raw ← convert targetTy ty (← lowerExprAs targetTy arg) arg
        let value ← if raw.pre.isEmpty then pure raw else atom raw
        pre := pre ++ value.pre
        let word := cleanHelperResultExpr targetTy value
        if hasDynMutation && !(word matches .literal _) then
          let snapshot ← fresh
          pre := pre.push (.letVar snapshot word)
          headWords := headWords.push (some (.localVar snapshot))
        else
          headWords := headWords.push (some word)
    for (tailIdx, headIdx, name, slot, arg) in deferred do
      -- The read binds its pointer and length to fresh locals.
      let buf ← lowerStorageBytesRead #[] name slot arg
      pre := pre ++ buf.pre
      dynTails := dynTails.set! tailIdx (headIdx, .inr (.inl (buf.pointer, buf.size)))
    let pointer ← fresh
    let headFinish ← fresh
    let base := Expr.localVar pointer
    modify fun env => { env with encodingMemory := true }
    pre := pre ++ (AbiEncoding.reserve pointer headFinish (.literal (32 * headWords.size))).toArray
    for idx in [:headWords.size] do
      if let some w := headWords[idx]! then
        pre := pre.push (.mstore (.add base (.literal (32 * idx))) w)
    for (headIdx, tailItem) in dynTails do
      match tailItem with
      | .inl (id, schema, argNode) =>
          let tailTuple ← fresh
          let tailTupleEnd ← fresh
          pre := pre ++ (AbiEncoding.reserve tailTuple tailTupleEnd (.literal (32 * schema.length))).toArray
          pre := pre.push (.mstore (.add base (.literal (32 * headIdx))) (.sub (.localVar tailTuple) base))
          pre := pre ++ (← lowerEncodedMemBody id (.localVar tailTuple) argNode)
      | .inr (.inl (bufPtr, bufSize)) =>
          let tailPtr ← fresh
          let tailLenEnd ← fresh
          pre := pre ++ (AbiEncoding.reserve tailPtr tailLenEnd (.literal 32)).toArray
          pre := pre ++ #[
            .mstore (.add base (.literal (32 * headIdx))) (.sub (.localVar tailPtr) base),
            .mstore (.localVar tailPtr) bufSize
          ]
          let payloadPtr ← fresh
          let payloadEnd ← fresh
          let clearIdx ← fresh
          pre := pre ++ (AbiEncoding.packedBuffer payloadPtr payloadEnd clearIdx bufSize).toArray
          let copyIdx ← fresh
          let byteName ← fresh
          let addrName ← fresh
          pre := pre.push (AbiEncoding.copyBytes bufPtr (.localVar payloadPtr) (.literal 0) bufSize copyIdx byteName addrName)
      | .inr (.inr arrId) =>
          let some arr := (← get).scalarArrays.find? arrId
            | failAt args[0]! "unknown scalar array parameter"
          let arrTail ← fresh
          let arrTailEnd ← fresh
          let arrLen := Expr.localVar arr.lengthBinding
          pre := pre ++ (AbiEncoding.reserve arrTail arrTailEnd
            (.add (.literal 32) (.mul arrLen (.literal 32)))).toArray
          pre := pre ++ #[
            .mstore (.add base (.literal (32 * headIdx))) (.sub (.localVar arrTail) base),
            .mstore (.localVar arrTail) arrLen
          ]
          let elemIdx ← fresh
          let elemVal ← fresh
          let srcVal := if !arr.inMemory then
              Expr.calldataload (.add (.localVar arr.dataBinding) (.mul (.localVar elemIdx) (.literal 32)))
            else
              Expr.mload (.add (.add (.localVar arr.memoryPointer) (.literal 32)) (.mul (.localVar elemIdx) (.literal 32)))
          let rightPadMask := if arr.elementType == "bytes4" then 2 ^ 224 - 1 else 0
          -- A root return converts a calldata array to its `T[] memory` result first:
          -- legacy codegen cleans each element of that copy, via-IR validates it.
          let legacyCopy := memoryCopy && !arr.inMemory && !(← get).viaIR
          let mut loopBody : List Stmt := [.letVar elemVal
            (if legacyCopy then AbiLowering.legacyCleanScalar arr.abiKind rightPadMask srcVal else srcVal)]
          let bound := SolidityAbi.scalarBound arr.abiKind
          if !arr.inMemory && !legacyCopy then
            if arr.elementType == "bytes4" then
              loopBody := loopBody ++ [AbiLowering.guard (.eq (.bitAnd (.localVar elemVal) (.literal (2 ^ 224 - 1))) (.literal 0))]
            else if bound < 2^256 then
              loopBody := loopBody ++ [AbiLowering.guard (.lt (.localVar elemVal) (.literal bound))]
          loopBody := loopBody ++ [
            .mstore (.add (.add (.localVar arrTail) (.literal 32)) (.mul (.localVar elemIdx) (.literal 32)))
              (.localVar elemVal)
          ]
          pre := pre.push (.forEach elemIdx arrLen loopBody)
    let totalSize ← fresh
    pre := pre.push (.letVar totalSize (.sub (.mload (.literal 64)) base))
    return { pre, pointer := base, size := .localVar totalSize }
  let env ← get
  -- External-call arguments are evaluated left to right before the callee is entered, and
  -- an all-static `abi.encode` likewise evaluates its arguments in source order. When an
  -- argument can write state or revert (a checked helper, checked arithmetic, `x++` or
  -- `x = v`), each word is bound to a temporary at its own position below.
  let hoistable := fun (arg : Json) =>
    statefulCallIn arg env || assignmentIn arg ||
      (externalArgs && jsonHasCustomRevert env [] arg)
  let ordered := (orderedEffects || externalArgs) && args.any hoistable
  let mut pre := #[]
  let mut words := []
  for argIdx in [:args.size] do
    let arg := args[argIdx]!
    let ty ← mType arg
    let targetTy ← match params? with
      | some ps => mType ps[argIdx]!
      | none => pure ty
    if ty.startsWith "struct " && !ty.contains "[" then
      if ordered then
        failAt arg "struct ABI encoding argument beside a state-changing argument is unsupported"
      let (sPre, sWords) ← lowerEncodedStaticStructWords arg
      pre := pre ++ sPre
      words := words ++ sWords
    else
      unless (paramType targetTy).isSome do
        failAt arg s!"unsupported ABI encoding argument type {targetTy}"
      -- Avoid assigning an evaluation order to multiple effectful arguments.
      -- Scalar paths and casts have no source-level writes or custom reverts,
      -- unless the arguments are `ordered` (see above).
      -- An external-call argument list is ordered even when no sibling is
      -- effectful, so a checked `a + b` is evaluated at its own position.
      checkEncodingScalar arg (ordered || externalArgs)
      let raw ← convert targetTy ty (← lowerExpr arg) arg
      let value ← if raw.pre.isEmpty then pure raw else atom raw
      pre := pre ++ value.pre
      let word := cleanHelperResultExpr targetTy value
      if ordered && !(word matches .literal _) then
        -- Read now: a later argument's helper may write what this word reads.
        let snapshot ← fresh
        pre := pre.push (.letVar snapshot word)
        words := words ++ [.localVar snapshot]
      else
        words := words ++ [word]
  let pointer ← fresh
  let finish ← fresh
  modify fun env => { env with encodingMemory := true }
  pre := pre ++ (AbiEncoding.staticWords pointer finish words).toArray
  return { pre, pointer := .localVar pointer, size := .literal (32 * words.length) }

private partial def resolveStorageDynamicArrayTarget (ref : Ref) (at_ : Json) :
    M (Option (Array Stmt × String × Expr × String × ParamType × SolidityAbi.ScalarKind × Option Nat)) := do
  match ref with
  | .state name pre =>
      let info ← resolveField name at_
      if let some (elemTy, modelElemTy, abiKind) := info.dynamicArrayElemType then
        return some (pre, name, .literal info.slot, elemTy, modelElemTy, abiKind, info.dynamicArrayStructId)
      return none
  | .structDynamicArray pre path dynInfo =>
      if let .rawSlot _ baseSlot := path then
        let slotExpr := rawStructMemberSlot baseSlot dynInfo.wordOffset
        return some (pre, "", slotExpr, dynInfo.elemType, dynInfo.modelElemType, dynInfo.abiKind, dynInfo.elemStructId)
      else
        let rawName ← match path with
          | .zero name | .one name _ | .two name _ _ => pure name
          | .outer _ _ | .rawSlot _ _ | .bytesSlot _ _ =>
              failAt at_ "struct dynamic array requires all outer mapping keys"
        let (name, _) := splitSPathField rawName
        let info ← resolveField name at_
        markField name
        markStructDynamicArray name dynInfo.member
        let (slotStmts, slotExpr) ← computeSPathBaseSlot path info dynInfo.wordOffset at_
        return some (pre ++ slotStmts, "", slotExpr, dynInfo.elemType, dynInfo.modelElemType, dynInfo.abiKind, dynInfo.elemStructId)
  | _ => return none

private partial def lowerCallArgs (j : Json) (receiver? : Option Json)
    (directHelper : Bool := false) : M (Array CallArg) := do
  let args ← mArr (← mField j "arguments")
  let nodes := match receiver? with
    | some recv => #[recv] ++ args
    | none => args
  -- Both 0.8.34 pipelines evaluate positional scalar arguments left to right. A
  -- using-for receiver, however, runs last on legacy and first on via-IR. Admit
  -- a pointer-producing receiver only beside effect-free scalar bindings/literals.
  let env ← get
  let scalarLeaf := fun (n : Json) =>
    optStr n "nodeType" == some "Literal" ||
      (optStr n "nodeType" == some "Identifier" &&
        ((field? n "typeDescriptions").bind (optStr · "typeString")).any
          (fun ty => (paramType ty).isSome))
  if let some recv := receiver? then
    let recv := unparenJson recv
    let ty ← mType recv
    if !env.viaIR && (ty == "bytes calldata" || ty == "bytes calldata slice") &&
        optStr recv "nodeType" != some "Identifier" &&
        !args.all (fun arg => optStr (unparenJson arg) "nodeType" == some "Literal") then
      failAt j "computed calldata receiver with nontrivial arguments requires legacy receiver-last evaluation"
  -- An effect-free scalar sibling (any reads, view helpers, checked arithmetic) is bound to a
  -- temporary at its own position below, so it sees exactly the writes on its left.
  let pureScalar := fun (n : Json) =>
    scalarLeaf n || (!assignmentIn n && !statefulCallIn n env &&
      ((field? n "typeDescriptions").bind (optStr · "typeString")).any
        (fun ty => (paramType ty).isSome))
  -- A `bytes` / `string` calldata identifier cannot be written by a sibling and is bound
  -- without validation, so its position is irrelevant. (Calldata structs and arrays are not
  -- admitted: their binding may validate before a sibling's panic.)
  let calldataLeaf := fun (n : Json) =>
    optStr n "nodeType" == some "Identifier" &&
      ((field? n "typeDescriptions").bind (optStr · "typeString")).any
        (fun ty => ty == "bytes calldata" || ty == "string calldata")
  let scalarUpdate := fun (n : Json) =>
    let e := unparenJson n
    (optStr e "nodeType" == some "UnaryOperation" &&
      (optStr e "operator" == some "++" || optStr e "operator" == some "--") &&
      (field? e "subExpression").any (fun t =>
        optStr t "nodeType" == some "Identifier" || indexedPath scalarLeaf t)) ||
    (optStr e "nodeType" == some "Assignment" && optStr e "operator" == some "=" &&
      ((field? e "leftHandSide").bind (optStr · "nodeType")) == some "Identifier" &&
      (field? e "rightHandSide").any pureScalar)
  -- Both 0.8.34 pipelines evaluate every argument (and its write) at its own position,
  -- left to right; each scalar argument is then bound to a temporary there (below).
  let sequence := directHelper && field? j "reorderedScalarArguments" != some (.bool true) &&
    nodes.size > 1 && receiver?.isNone &&
    nodes.any assignmentIn && nodes.all (fun n =>
      pureScalar n || calldataLeaf (unparenJson n) || scalarUpdate n)
  let singleEffect := field? j "reorderedScalarArguments" == some (.bool true) &&
    (nodes.filter (fun n => optStr n "nodeType" != some "Literal")).size == 1 &&
    receiver?.isNone
  let mut vals : Array CallArg := #[]
  for arg in nodes do
    let argTy ← mType arg
    let pointerCall := directHelper && nodes.size > 1 && (← mKind arg) == "FunctionCall" &&
      argTy.startsWith "struct " && (argTy.endsWith " storage pointer" || argTy.endsWith " storage ref") &&
      nodes.all (fun n => n == arg || (scalarLeaf n && (optStr n "nodeType" == some "Literal" ||
        ((field? n "referencedDeclaration").bind (·.getNat?.toOption)).any env.values.contains)))
    if !singleEffect && statefulCallIn arg (← get) then
      if pointerCall then
        let callee ← mField arg "expression"
        let id ← refInt callee
        let fnId := (resolveInContracts env env.linearizedBases.toList id.toNat).getD id.toNat
        let some fn := env.funs.find? fnId | failAt arg "unresolved storage pointer helper"
        let some fnBody := (field? fn "body").filter (!·.isNull)
          | failAt arg "storage pointer helper has no implementation"
        let body ← mArr (← mField fnBody "statements")
        let simplePath := fun (e : Json) => optStr e "nodeType" == some "Identifier" ||
          (optStr e "nodeType" == some "IndexAccess" &&
           ((field? e "baseExpression").bind (optStr · "nodeType")) == some "Identifier" &&
           (field? e "indexExpression").any scalarLeaf)
        unless (← mKind callee) == "Identifier" && body.size == 1 &&
            optStr body[0]! "nodeType" == some "Return" &&
            (field? body[0]! "expression").any simplePath &&
            (← mArr (← mField arg "arguments")).all scalarLeaf do
          failAt arg "expected a helper returning only a storage path"
      else
        -- A lone stateful node (the only argument, or a using-for receiver without
        -- arguments) has no sibling to order against: both pipelines run it, then bind its
        -- value and enter the callee, which is the lowering's order for any state-variable
        -- count (a branching function pointer's condition is already bound to a local).
        unless nodes.size == 1 do
          failAt arg "stateful helper call arguments require explicit evaluation-order support"
    if nodes.size > 1 && assignmentIn arg && !sequence then
      failAt arg "assignment expression in multi-argument call requires explicit evaluation-order support"
    if argTy.startsWith "struct " && !argTy.contains "[" then
      if (← mKind arg) == "FunctionCall" && argTy.endsWith " memory" &&
          (optStr arg "kind" == some "structConstructorCall" || optStr arg "kind" == some "functionCall") &&
          (← hasBytesStructType arg) then
        let .mem id mpre ← lowerRef arg | failAt arg "unsupported bytes-member struct argument"
        let some descriptor := (← get).mems.find? id | failAt arg "unknown reference argument"
        vals := vals.push (.memory descriptor mpre)
      else if (← mKind arg) == "FunctionCall" &&
          (optStr arg "kind" == some "structConstructorCall" ||
           (optStr arg "kind" == some "functionCall" && argTy.endsWith " memory")) then
        let (sid, sName, initPre, memberVals) ← lowerFlatStructValue arg none false
        vals := vals.push (.flatStruct sid sName memberVals initPre false)
      else
        match ← lowerRef arg with
        | .mem id pre =>
            let some descriptor := (← get).mems.find? id
              | failAt arg "unknown reference argument"
            vals := vals.push (.memory descriptor pre)
        | .abiElement rootId memberIndex pointer inMemory pre =>
            vals := vals.push (.abiElement { rootId, memberIndex, pointer, inMemory } pre)
        | .flatStruct _ =>
            let (sid, sName, initPre, memberVals) ← lowerFlatStructValue arg none true
            vals := vals.push (.flatStruct sid sName memberVals initPre (argTy.endsWith " memory"))
        | .path pre path =>
            let (sid, _) ← resolveStructDeclFromType arg
            let capture (key : Expr) : M (Array Stmt × Expr) := do
              let env ← get
              let writable := match key with
                | .localVar name => env.writableLocals.toList.any (fun (_, b) => b == name)
                | _ => false
              if !writable then
                return (#[], key)
              let binding ← fresh
              pure (#[.letVar binding key], .localVar binding)
            match path with
            | .rawSlot rawSid slot =>
                unless rawSid == sid do
                  failAt arg "raw storage slot struct argument declaration differs"
                let (spre, frozenSlot) ← capture slot
                vals := vals.push (.storagePath sid (.rawSlot rawSid frozenSlot) (pre ++ spre))
            | .bytesSlot (fieldName, slotExpr) isString =>
                let (spre, frozenSlot) ← capture slotExpr
                vals := vals.push (.storagePath sid (.bytesSlot (fieldName, frozenSlot) isString) (pre ++ spre))
            | .zero rawField =>
                let (field, _) := splitSPathField rawField
                let info ← resolveField field arg
                unless !info.scalarMapping && info.fixedArrayLength.isNone && info.keyCount == 0 do
                  failAt arg "storage struct argument requires a struct storage path"
                vals := vals.push (.storagePath sid (.zero rawField) pre)
            | .one rawField key =>
                let (field, _) := splitSPathField rawField
                let info ← resolveField field arg
                unless !info.scalarMapping && info.fixedArrayLength.isNone && info.keyCount == 1 do
                  failAt arg "storage struct argument requires a struct storage path"
                let (kpre, k) ← capture key
                vals := vals.push (.storagePath sid (.one rawField k) (pre ++ kpre))
            | .two rawField key1 key2 =>
                let (field, _) := splitSPathField rawField
                let info ← resolveField field arg
                unless !info.scalarMapping && info.fixedArrayLength.isNone && info.keyCount == 2 do
                  failAt arg "storage struct argument requires a struct storage path"
                let (kpre1, k1) ← capture key1
                let (kpre2, k2) ← capture key2
                vals := vals.push (.storagePath sid (.two rawField k1 k2) (pre ++ kpre1 ++ kpre2))
            | .outer _ _ =>
                failAt arg "storage struct argument requires all mapping keys"
        | _ => failAt arg "only root memory/calldata struct arguments are supported"
    else if argTy.startsWith "mapping(" then
      match ← lowerRef arg with
      | .structMapping pre path mapInfo =>
          -- The helper's raw storage pointer carries no scalar packing metadata.
          -- Reconstructing it as a full-word mapping would clobber the high bytes.
          if mapInfo.valueWidth < 256 || mapInfo.innerKeyType.isSome then
            failAt arg "packed or nested mapping storage arguments are outside this slice"
          let (slotPre, mapSlotExpr) ← if let .rawSlot _ baseSlot := path then
            pure (#[], rawStructMemberSlot baseSlot mapInfo.wordOffset)
          else do
            let rawName ← match path with
              | .zero name | .one name _ | .two name _ _ => pure name
              | _ => failAt arg "storage mapping argument requires all outer mapping keys"
            let (name, _) := splitSPathField rawName
            let info ← resolveField name arg
            markField name
            markStructMapping name mapInfo.member
            computeSPathBaseSlot path info mapInfo.wordOffset arg
          let binding ← fresh
          let valSid := mapInfo.valueStructId.getD 0
          vals := vals.push (.storagePath valSid (.rawSlot valSid (.localVar binding))
            ((pre ++ slotPre).push (.letVar binding mapSlotExpr)))
      | .state name pre =>
          -- A one-key mapping state variable of structs: the parameter aliases the variable
          -- itself (`SPath.zero name` on a mapping-typed parameter; see `lowerRef`), so
          -- `m[k]` in the helper is the same `.one name k` path as a direct `name[k]`.
          -- Scalar-valued, nested and array-valued mappings keep the rejection below.
          let info ← resolveField name arg
          let valueTy := (argTy.splitOn " => ").drop 1 |> " => ".intercalate
          unless info.keyCount == 1 && !info.scalarMapping && info.fixedArrayLength.isNone &&
              info.dynamicArrayElemType.isNone && info.dynamicArrayStructId.isNone &&
              valueTy.startsWith "struct " && !valueTy.contains "[" && !valueTy.contains "mapping(" do
            failAt arg "only struct mapping storage arguments are supported"
          vals := vals.push (.storagePath 0 (.zero name) pre)
      | _ => failAt arg "only struct mapping storage arguments are supported"
    else if let some (sid, _) ← structMemArrayOf? arg then
      -- `S[] memory`: the array pointer is passed (no copy), as solc does.
      let (arrPre, desc) ← lowerDynArrayValue arg (structMemArrayTag sid)
      vals := vals.push (.scalarArray desc arrPre)
    else if argTy.startsWith "struct " && argTy.contains "[]" then
      let ref ← lowerRef arg
      if let some (pre, fieldName, slotExpr, elemTy, _, _, some elemSid) ← resolveStorageDynamicArrayTarget ref arg then
        let (spre, frozenSlot) ← do
          let env ← get
          let writable := match slotExpr with
            | .localVar name => env.writableLocals.toList.any (fun (_, b) => b == name)
            | _ => false
          if !writable then pure (#[], slotExpr)
          else do
            let binding ← fresh
            pure (#[.letVar binding slotExpr], .localVar binding)
        vals := vals.push (.storageDynamicArray fieldName frozenSlot elemTy (some elemSid) (pre ++ spre))
      else
        failAt arg "only storage struct dynamic array arguments are supported"
    else if (fixedMemArrayType? argTy).isSome then
      let (arrPre, arr) ← lowerFixedMemArrayValue arg
      vals := vals.push (.fixedMemArray arr arrPre)
    else if (nestedMemArrayType? argTy).isSome && argTy.endsWith " memory" then
      let (arrPre, arr) ← lowerNestedMemArrayValue arg
      vals := vals.push (.nestedMemArray arr arrPre)
    else if let some (elemStr, _, _) := scalarArrayElement? argTy then
      if ← isAbiDecodeCall arg then
        let (decodePre, decoded) ← lowerAbiDecodeItems arg
        unless decoded.size == 1 do
          failAt arg "array abi.decode argument requires a single array target type"
        let .scalarArray decElemStr _ _ desc := decoded[0]!
          | failAt arg "array abi.decode argument requires a dynamic scalar array target type"
        unless decElemStr == elemStr do
          failAt arg "dynamic memory array argument type differs from declaration"
        vals := vals.push (.scalarArray desc decodePre)
      else
        let isArrayHelperCall ← if (← mKind arg) == "FunctionCall" && optStr arg "kind" == some "functionCall" then
          pure ((← mKind (← mField arg "expression")) != "NewExpression")
        else
          pure false
        if isArrayHelperCall then
          let (fnId, innerVals) ← resolveCallTargetAndArgs arg
          let (arrPre, desc) ← inlineArrayFn fnId innerVals elemStr arg
          vals := vals.push (.scalarArray desc arrPre)
        else
          let ref ← lowerRef arg
          if let .scalarArray id pre := ref then
            let some descriptor := (← get).scalarArrays.find? id
              | failAt arg "unknown scalar array argument"
            vals := vals.push (.scalarArray descriptor pre)
          else if let some (pre, fieldName, slotExpr, elemTy, _, _, none) ← resolveStorageDynamicArrayTarget ref arg then
            let (spre, frozenSlot) ← do
              let env ← get
              let writable := match slotExpr with
                | .localVar name => env.writableLocals.toList.any (fun (_, b) => b == name)
                | _ => false
              if !writable then pure (#[], slotExpr)
              else do
                let binding ← fresh
                pure (#[.letVar binding slotExpr], .localVar binding)
            vals := vals.push (.storageDynamicArray fieldName frozenSlot elemTy none (pre ++ spre))
          else
            failAt arg "only scalar array parameter arguments are supported"
    else if argTy == "string" || argTy == "string memory" || argTy == "string calldata" ||
            argTy == "string storage ref" || argTy == "string storage pointer" ||
            argTy.startsWith "literal_string " then
      if (← mKind arg) == "Identifier" then
        let id ← refInt arg
        if id ≥ 0 then
          if let some cb := (← get).calldataBytes.find? id.toNat then
            if !cb.inMemory then
              vals := vals.push (.calldataBytes cb #[])
              continue
      if let some (spre, storageName, slotExpr, _) ← resolveStorageBytesTarget? arg then
        vals := vals.push (.storageBytes (storageName, slotExpr, spre) true)
        continue
      let buf ← lowerEncodedBytes arg
      vals := vals.push (.stringBuffer buf)
    else if argTy == "bytes calldata slice" then
      -- `data[a:b]` passed to a helper: solc's range checks (plain empty
      -- reverts, not panics), then the `(offset, length)` pair as a calldata
      -- argument; a `bytes memory` parameter copies it at binding time.
      let some (slicePre, offExpr, lenExpr, fromCalldata, isMsgData) ← lowerCalldataSlice? arg
        | failAt arg "unsupported calldata slice argument"
      -- The ordinary bytes descriptor cannot represent reads spanning the selector.
      if isMsgData then failAt arg "msg.data slices as helper arguments are unsupported"
      match fromCalldata, offExpr, lenExpr with
      | true, .localVar offBinding, .localVar lenBinding =>
          let desc : CalldataBytesParam :=
            { param := "", offsetBinding := "", headerBinding := "",
              lengthBinding := lenBinding, dataBinding := offBinding }
          vals := vals.push (.calldataBytes desc slicePre)
      | false, _, _ =>
          -- A slice of a memory-backed `bytes calldata` value (a conditional
          -- argument): solc's slice is still calldata, so the memory
          -- parameter gets a fresh copy rather than the source's memory.
          let (copyPre, header) ← copyToLengthPrefixed false offExpr lenExpr
          vals := vals.push (.byteBuffer
            { pre := slicePre ++ copyPre, pointer := .add header (.literal 32), size := lenExpr })
      | _, _, _ => failAt arg "unsupported calldata slice argument"
    else if argTy == "bytes" || argTy == "bytes memory" || argTy == "bytes calldata" ||
            argTy == "bytes storage ref" || argTy == "bytes storage pointer" then
      let arg ← stripParens arg
      if ← isParameterizedCalldataBytesCall arg then
        let (fnId, innerVals) ← resolveCallTargetAndArgs arg
        let (cpre, cb) ← inlineCalldataBytesFn fnId innerVals arg
        vals := vals.push (.calldataBytes cb cpre)
        continue
      if (← mKind arg) == "Identifier" then
        let id ← refInt arg
        if id ≥ 0 then
          if let some cb := (← get).calldataBytes.find? id.toNat then
            if !cb.inMemory then
              vals := vals.push (.calldataBytes cb #[])
              continue
      if let some (spre, storageName, slotExpr, _) ← resolveStorageBytesTarget? arg then
        vals := vals.push (.storageBytes (storageName, slotExpr, spre) false)
        continue
      let buf ← lowerEncodedBytes arg
      vals := vals.push (.byteBuffer buf)
    else if argTy.startsWith "function (" then
      let (fpre, ptr) ← lowerFnPtrInit arg
      vals := vals.push (.fnPtr ptr fpre)
    else
      let val ← lowerExpr arg
      if sequence then
        -- Even a bare local must capture its current value before a later write.
        let binding ← fresh
        vals := vals.push (.scalar { pre := val.pre.push (.letVar binding val.expr),
                                     expr := .localVar binding })
      else
        vals := vals.push (.scalar val)
  pure vals

private partial def atomizeCallArgs (vals : Array CallArg) : M (Array Stmt × Array CallArg) := do
  let mut pre : Array Stmt := #[]
  let mut out : Array CallArg := #[]
  for val in vals do
    match val with
    | .scalar v =>
        let a ← atom v
        pre := pre ++ a.pre
        out := out.push (.scalar { pre := #[], expr := a.expr })
    | .memory desc mpre =>
        pre := pre ++ mpre
        out := out.push (.memory desc #[])
    | .abiElement bound epre =>
        let ptrAtom ← atom { pre := epre, expr := bound.pointer }
        pre := pre ++ ptrAtom.pre
        out := out.push (.abiElement { bound with pointer := ptrAtom.expr } #[])
    | .scalarArray desc apre =>
        pre := pre ++ apre
        out := out.push (.scalarArray desc #[])
    | .fixedMemArray arr apre =>
        pre := pre ++ apre
        out := out.push (.fixedMemArray arr #[])
    | .nestedMemArray arr apre =>
        pre := pre ++ apre
        out := out.push (.nestedMemArray arr #[])
    | .byteBuffer buf =>
        let ptrBinding ← fresh
        let sizeBinding ← fresh
        pre := pre ++ buf.pre ++ #[.letVar ptrBinding buf.pointer, .letVar sizeBinding buf.size]
        out := out.push (.byteBuffer { pre := #[], pointer := .localVar ptrBinding, size := .localVar sizeBinding,
                                       shortStringAlloc := buf.shortStringAlloc, ownedFresh := buf.ownedFresh })
    | .stringBuffer buf =>
        let ptrBinding ← fresh
        let sizeBinding ← fresh
        pre := pre ++ buf.pre ++ #[.letVar ptrBinding buf.pointer, .letVar sizeBinding buf.size]
        out := out.push (.stringBuffer { pre := #[], pointer := .localVar ptrBinding, size := .localVar sizeBinding,
                                         shortStringAlloc := buf.shortStringAlloc, ownedFresh := buf.ownedFresh })
    | .calldataBytes desc cpre =>
        pre := pre ++ cpre
        out := out.push (.calldataBytes desc #[])
    | .storagePath sid path spre =>
        pre := pre ++ spre
        out := out.push (.storagePath sid path #[])
    | .flatStruct sid sName members fpre byRef =>
        pre := pre ++ fpre
        out := out.push (.flatStruct sid sName members #[] byRef)
    | .storageBytes (fieldName, slotExpr, spre) isString =>
        let slotAtom ← atom { pre := spre, expr := slotExpr }
        pre := pre ++ slotAtom.pre
        out := out.push (.storageBytes (fieldName, slotAtom.expr, #[]) isString)
    | .storageDynamicArray fieldName slotExpr elemTy elemSid? spre =>
        let slotAtom ← atom { pre := spre, expr := slotExpr }
        pre := pre ++ slotAtom.pre
        out := out.push (.storageDynamicArray fieldName slotAtom.expr elemTy elemSid? #[])
    | .fnPtr ptr fpre =>
        pre := pre ++ fpre
        out := out.push (.fnPtr ptr #[])
  pure (pre, out)

private partial def resolveFnPtrTarget (j : Json) : M Nat := do
  match ← mKind j with
  | "Identifier" =>
      let id ← refInt j
      if id < 0 then failAt j "builtin function pointers are outside this slice"
      let env ← get
      if let some (.direct fnId) := env.fnPtrs.find? id.toNat then
        return fnId
      if env.fnPtrs.contains id.toNat then
        failAt j "nested conditional function pointers are outside this slice"
      unless env.funs.contains id.toNat do
        failAt j "function pointer initializer does not resolve to an internal function"
      let resolvedId ← match env.funContractId.find? id.toNat with
        | some cid =>
            if env.linearizedBases.contains cid then
              match resolveInContracts env env.linearizedBases.toList id.toNat with
              | some rid => pure rid
              | none => failAt j s!"unresolved inherited function {id.toNat}"
            else
              pure id.toNat
        | none => pure id.toNat
      let some fn := env.funs.find? resolvedId | failAt j s!"unresolved function {resolvedId}"
      let vis := optStr fn "visibility" |>.getD ""
      unless vis == "internal" || vis == "private" || vis == "public" do
        failAt j "function pointer target must be an internal, private, or public function"
      pure resolvedId
  | "MemberAccess" =>
      let base ← mField j "expression"
      let id ← refInt j
      if id < 0 then failAt j "builtin function pointers are outside this slice"
      let baseTy ← mType base
      if baseTy.startsWith "type(library " then
        let some fn := (← get).funs.find? id.toNat | failAt j s!"unresolved function {id.toNat}"
        let vis := optStr fn "visibility" |>.getD ""
        unless vis == "internal" || vis == "private" do
          failAt j "external library function pointers are outside this slice"
        pure id.toNat
      else if baseTy.startsWith "type(contract super " then
        let isSuper ← if (← mKind base) == "Identifier" && optStr base "name" == some "super" then
          pure ((← refInt base) == -25)
        else
          pure false
        unless isSuper do failAt base "invalid super callee"
        let env ← get
        let some callerFnId := env.stack.head? | failAt j "super reference outside function context"
        let some callerCid := env.funContractId.find? callerFnId | failAt j "super reference outside contract function"
        let some idx := env.linearizedBases.findIdx? (· == callerCid) | failAt j "enclosing contract is outside target inheritance chain"
        let superBases := (env.linearizedBases.extract (idx + 1) env.linearizedBases.size).toList
        let some resolvedId := resolveInContracts env superBases id.toNat | failAt j s!"unresolved super function {id.toNat}"
        pure resolvedId
      else if baseTy.startsWith "type(contract " then
        unless (← mKind base) == "Identifier" do failAt base "qualified base function reference requires a contract identifier"
        let baseCid ← refInt base
        let env ← get
        unless baseCid ≥ 0 && env.linearizedBases.contains baseCid.toNat do
          failAt base "qualified function reference contract is not a base of the target contract"
        unless env.funContractId.find? id.toNat == some baseCid.toNat do
          failAt j "qualified function reference is not declared in the named base contract"
        pure id.toNat
      else
        failAt j "external or bound function pointers are outside this slice"
  | _ => failAt j "unsupported function pointer initializer"

private partial def lowerFnPtrInit (j : Json) : M (Array Stmt × FnPtr) := do
  if (← mKind j) == "Conditional" then
    let condNode ← mField j "condition"
    unless (← mType condNode) == "bool" do failAt condNode "conditional condition must be bool"
    let condVal ← lowerExpr condNode
    let condBinding ← fresh
    let trueFnId ← resolveFnPtrTarget (← mField j "trueExpression")
    let falseFnId ← resolveFnPtrTarget (← mField j "falseExpression")
    let pre := condVal.pre.push (.letVar condBinding condVal.expr)
    pure (pre, .branch (.localVar condBinding) trueFnId falseFnId)
  else if (← mKind j) == "Identifier" then
    let id ← refInt j
    if id ≥ 0 then
      if let some ptr := (← get).fnPtrs.find? id.toNat then
        return (#[], ptr)
    let fnId ← resolveFnPtrTarget j
    pure (#[], .direct fnId)
  else
    let fnId ← resolveFnPtrTarget j
    pure (#[], .direct fnId)

private partial def resolveCallTargetAndArgs (j : Json) : M (Nat × Array CallArg) := do
  let names ← mArr (← mField j "names")
  unless names.isEmpty do failAt j "named call arguments are outside this slice"
  let callee ← mField j "expression"
  discard <| admitLinkedLibraryCall callee
  let (fnId, receiver?) ← match ← mKind callee with
    | "FunctionCallOptions" =>
        failAt callee "external contract calls are outside this slice"
    | "MemberAccess" =>
        let base ← mField callee "expression"
        let baseTy ← mType base
        if (← mKind base) == "Identifier" && optStr base "name" == some "abi" then
          if (← refInt base) == -1 then
            let member := optStr callee "memberName" |>.getD ""
            if member == "decode" then
              failAt callee "abi.decode is outside this slice"
            else
              failAt callee s!"abi.{member} is only supported as a byte buffer"
        if (← mKind base) == "ElementaryTypeNameExpression" &&
            optStr callee "memberName" == some "concat" &&
            (field? callee "referencedDeclaration").isNone then
          let tname := optStr (field? base "typeName" |>.getD Json.null) "name" |>.getD ""
          if tname == "bytes" || tname == "string" then
            failAt callee s!"{tname}.concat is only supported as a byte buffer"
        if (field? callee "referencedDeclaration").isNone then
          let member := optStr callee "memberName" |>.getD ""
          if (baseTy == "address" || baseTy == "address payable") && member == "call" then
            failAt callee lowLevelCallPlacement
          if (baseTy == "address" || baseTy == "address payable" || baseTy.startsWith "contract ") &&
              ["call", "staticcall", "delegatecall", "transfer", "send"].contains member then
            failAt callee "external contract calls are outside this slice"
          if ["push", "pop"].contains member then
            failAt callee s!"storage array {member} is outside this slice"
        let id ← refInt callee
        if id < 0 then failAt callee "builtin call is outside this slice"
        if baseTy.startsWith "type(library " then
          pure (id.toNat, none)
        else if baseTy.startsWith "type(contract super " then
          let isSuper ← if (← mKind base) == "Identifier" && optStr base "name" == some "super" then
            pure ((← refInt base) == -25)
          else
            pure false
          unless isSuper do
            failAt base "invalid super callee"
          let env ← get
          let some callerFnId := env.stack.head?
            | failAt callee "super call outside function context"
          let some callerCid := env.funContractId.find? callerFnId
            | failAt callee "super call outside contract function"
          let some idx := env.linearizedBases.findIdx? (· == callerCid)
            | failAt callee "enclosing contract is outside target inheritance chain"
          let superBases := (env.linearizedBases.extract (idx + 1) env.linearizedBases.size).toList
          let some resolvedId := resolveInContracts env superBases id.toNat
            | failAt callee s!"unresolved super function {id.toNat}"
          pure (resolvedId, none)
        else if baseTy.startsWith "type(contract " then
          unless (← mKind base) == "Identifier" do
            failAt base "qualified base call requires a contract identifier"
          let baseCid ← refInt base
          let env ← get
          unless baseCid ≥ 0 && env.linearizedBases.contains baseCid.toNat do
            failAt base "qualified call contract is not a base of the target contract"
          unless env.funContractId.find? id.toNat == some baseCid.toNat do
            failAt callee "qualified call function is not declared in the named base contract"
          pure (id.toNat, none)
        else
          pure (id.toNat, some base)
    | "Identifier" =>
        let id ← refInt callee
        if id < 0 then failAt callee "builtin call is outside this slice"
        let env ← get
        let resolvedId ← match env.funContractId.find? id.toNat with
          | some cid =>
              if env.linearizedBases.contains cid then
                match resolveInContracts env env.linearizedBases.toList id.toNat with
                | some rid => pure rid
                | none => failAt callee s!"unresolved inherited function {id.toNat}"
              else
                pure id.toNat
          | none => pure id.toNat
        pure (resolvedId, none)
    | _ => failAt callee "unsupported callee"
  if receiver?.isSome then
    let env ← get
    let isLibrary := match env.funContractId.find? fnId with
      | some cid => env.contractKinds.find? cid == some "library"
      | none => false
    unless isLibrary do
      failAt callee "external contract calls are outside this slice"
  let vals ← lowerCallArgs j receiver? true
  pure (fnId, vals)

/-- `I(a).f(args...)` as a whole expression statement, for a `nonpayable` or
`payable` external function without return values, called without value.
solc 0.8.34 evaluates the receiver, then the arguments in source order; writes the
selector and the ABI-encoded arguments at the free pointer; reverts with no data when
`extcodesize(a)` is zero (legacy order, modelled here; via-IR checks the code size
before encoding, so a storage reference argument is rejected under via-IR, see
below); emits `call(gas(), a, 0, p, len, p, 0)`;
forwards a failed call's complete return data as the revert payload; and ignores
the return data of a successful call. Here the calldata is assembled in a fresh
allocation (solc writes it above the free pointer without advancing it, so only
unallocated memory differs) and sent through the closed memory-call transport.
`decl` is the called function's declaration. The statements end with the call;
the returned name is bound to its success bit (`1` or `0`).

`lowerInterfaceCallStatus` is the same sequence for a function with return values
(`codeCheck := false`: solc omits the code-existence check when return data is
expected) or a `view` / `pure` one (`isStatic`: `staticcall`). It also returns the
calldata allocation, at least one word long, which a caller may reuse to read the first
return word once the call is over. -/
private partial def lowerInterfaceCallStatus (j decl : Json) (codeCheck isStatic : Bool) :
    M (Array Stmt × String × String) := do
  let callee ← mField j "expression"
  let params ← mArr (← mField (← mField decl "parameters") "parameters")
  let args ← mArr (← mField j "arguments")
  unless args.size == params.size do
    failAt j "typed interface call argument count differs from its declaration"
  let some hex := optStr decl "functionSelector"
    | failAt callee "interface function has no functionSelector"
  unless hex.length == 8 do
    failAt callee s!"invalid functionSelector hex length {hex.length}"
  let mut selector := 0
  for c in hex.toList do
    let some digit := Compiler.Hex.hexCharToNat? c
      | failAt callee "invalid functionSelector hex digit"
    selector := selector * 16 + digit
  let base ← mField callee "expression"
  let receiver ← if (← mKind base) == "FunctionCall" && optStr base "kind" == some "typeConversion" then do
      let convArgs ← mArr (← mField base "arguments")
      let #[inner] := convArgs
        | failAt base "typed interface call receiver must convert exactly one address"
      let innerTy ← mType inner
      unless innerTy == "address" || innerTy == "address payable" || innerTy.startsWith "contract " do
        failAt base "typed interface call receiver must be an interface conversion of an address"
      pure inner
    else
      pure base
  -- Both pipelines evaluate the receiver and the arguments first, in source order, and
  -- `lowerAbiEncodeArgs` now hoists each effectful argument at its own position. Legacy
  -- then ABI-encodes
  -- the arguments and checks `extcodesize(a)` just before the CALL, as modelled below;
  -- via-IR checks `extcodesize(a)` before encoding. Encoding a storage reference reads it
  -- then and can revert with data (Panic 0x22 on a corrupt byte-array length), where a
  -- codeless callee gives an empty revert, so on via-IR a storage reference argument is
  -- rejected (#2830). Encoding any other admitted argument either cannot revert or only
  -- reverts with no data (calldata validation), which a codeless callee also gives.
  if (← get).viaIR then
    for arg in args do
      let argTy ← mType arg
      if argTy.endsWith " storage ref" || argTy.endsWith " storage pointer" then
        failAt arg ("storage reference argument of a typed external call without return " ++
          "values: via-IR checks the callee's code size before encoding it")
  let rawTarget ← atom (← lowerExpr receiver)
  let target ← if args.any assignmentIn && !(rawTarget.expr matches .literal _) then
      let snapshot ← fresh
      pure { pre := rawTarget.pre.push (.letVar snapshot rawTarget.expr), expr := .localVar snapshot }
    else
      pure rawTarget
  let mut pre := target.pre
  let mut payloadPtr := Expr.literal 0
  let mut payloadSize := Expr.literal 0
  unless args.isEmpty do
    let payload ← lowerAbiEncodeArgs args (some params) (externalArgs := true)
    let ptr ← atom { pre := payload.pre, expr := payload.pointer }
    let payloadBytes ← atom { pre := #[], expr := payload.size }
    pre := pre ++ ptr.pre ++ payloadBytes.pre
    payloadPtr := ptr.expr
    payloadSize := payloadBytes.expr
  -- The selector is the low four bytes of the first word of a word-aligned
  -- allocation; the payload's words follow it, so the calldata starts at offset 28.
  let callBase ← fresh
  let callEnd ← fresh
  let index ← fresh
  let dataPtr ← fresh
  let dataSize ← fresh
  let words := Expr.div (.add payloadSize (.literal 31)) (.literal 32)
  modify fun e => { e with encodingMemory := true }
  pre := pre ++ (AbiEncoding.reserve callBase callEnd
    (.add (.literal 32) (.mul words (.literal 32)))).toArray
  pre := pre ++ #[
    .mstore (.localVar callBase) (.literal selector),
    .forEach index words [
      .mstore (.add (.add (.localVar callBase) (.literal 32)) (.mul (.localVar index) (.literal 32)))
        (.mload (.add payloadPtr (.mul (.localVar index) (.literal 32))))],
    .letVar dataPtr (.add (.localVar callBase) (.literal 28)),
    .letVar dataSize (.add payloadSize (.literal 4))]
  let codeSize ← fresh
  let success ← fresh
  if codeCheck then
    pre := pre ++ #[
      .ecm (Compiler.ECM.SolidityExtCodeSize.module codeSize) [target.expr],
      .ite (.eq (.localVar codeSize) (.literal 0)) [.revertEmpty] []]
  return (pre.push (.ecm (Compiler.ECM.YulMemoryCall.module isStatic success)
      [target.expr, .localVar dataPtr, .localVar dataSize, .literal 0, .literal 0]),
    success, callBase)

private partial def lowerInterfaceVoidCallStatus (j decl : Json) : M (Array Stmt × String) := do
  let (pre, success, _) ← lowerInterfaceCallStatus j decl true false
  return (pre, success)

/-- `I(a).f(args...)` as a whole expression statement (see `lowerInterfaceVoidCallStatus`):
a failed call forwards its complete return data as the revert payload. -/
private partial def lowerInterfaceVoidCall (j decl : Json) : M (Array Stmt) := do
  let (pre, success) ← lowerInterfaceVoidCallStatus j decl
  return pre.push (.ite (.eq (.localVar success) (.literal 0)) [.revertReturndata] [])

/-- Extract the address-valued receiver expression of a typed interface call.
Admits an explicit `I(addr)` conversion of an `address` or `contract` (rejecting
`address payable` so `I(payable(a))` keeps its diagnostic) as well as any
interface-typed expression (`feed`, `getTarget(id)`, `IFactory(f).target(id)`,
`targets[id]`, `state.target`, `(cond ? a : b)`). Callers lower the receiver
first and hoist it into a temporary via `atom`. -/
private partial def extractInterfaceReceiver (base : Json) : M Json := do
  let inner ← stripParens base
  if (← mKind inner) == "FunctionCall" && optStr inner "kind" == some "typeConversion" then
    let convArgs ← mArr (← mField inner "arguments")
    let rawConvTypes ← convArgs.mapM mType
    let convTypes := rawConvTypes.map fun ty =>
      if ty.startsWith "contract " then "address" else ty
    unless convTypes == #["address"] do
      failAt base "typed interface call receiver must be an explicit interface conversion of an address"
    return convArgs[0]!
  if (← mType inner).startsWith "contract " then
    return inner
  failAt base "typed interface call receiver must be an explicit interface conversion of an address"

private partial def isSupportedStaticCallReturnType (ty : String) : Bool :=
  ["uint256", "int256", "bytes32", "bytes4", "bool", "address"].contains ty ||
  (ty.startsWith "uint" && (bitsOf ty).any (· < 256))

private partial def isInterfaceMultiReturnCall (j : Json) : M Bool := do
  let callee ← mField j "expression"
  let id ← refInt callee
  let some decl := (← get).funs.find? id.toNat | return false
  let rs ← mArr (← mField (← mField decl "returnParameters") "parameters")
  pure (rs.size ≥ 2)

/-- `I(a).f(args...)` for a `view` interface function returning a tuple of two or
more scalar words (`uint256`, `uint8..uint248`, `int256`, `bytes32`, `bytes4`,
`bool`, `address` / `contract`). Encodes the selector and arguments at the free
pointer, executes `staticcall(gas(), target, inPtr, inSize, outPtr, 32 * N)` via
the closed `YulMemoryCall` static transport, forwards revert data on failure,
reverts with no data on `returndatasize < 32 * N`, and decodes every return word
with `abiDecodeScalarGuard?`. -/
private partial def lowerInterfaceMultiStaticCall (j : Json) :
    M (Array Stmt × Array (Expr × String)) := do
  if (← get).forwardingBytesTuple then
    let (isStatic, rawScalarTy, scalarTy, enumBound?, params, args, selector, base) ←
      parseInterfaceBytesTupleCallMeta j
    let receiver ← extractInterfaceReceiver base
    for arg in args do
      if statefulCallIn arg (← get) || assignmentIn arg then
        failAt arg "effectful arguments in typed external (scalar, bytes memory) call are outside this slice"
    let callId ← mNat (← mField j "id")
    modify fun e => { e with admittedInterfaceCalls := e.admittedInterfaceCalls.erase callId }
    let rawTarget ← lowerExpr receiver
    let target ← atom { rawTarget with expr := cleanHelperResultExpr "address" rawTarget }
    let mut pre := target.pre
    let mut payloadPtr := Expr.literal 0
    let mut payloadSize := Expr.literal 0
    unless args.isEmpty do
      let payload ← lowerAbiEncodeArgs args (some params) (externalArgs := true)
      let ptr ← atom { pre := payload.pre, expr := payload.pointer }
      let payloadBytes ← atom { pre := #[], expr := payload.size }
      pre := pre ++ ptr.pre ++ payloadBytes.pre
      payloadPtr := ptr.expr
      payloadSize := payloadBytes.expr
    let (callStmts, retExprs) ← emitInterfaceBytesTupleCallAndDecode isStatic (!args.isEmpty)
      selector target.expr payloadPtr payloadSize rawScalarTy scalarTy enumBound?
    return (pre ++ callStmts, retExprs)
  let callee ← mField j "expression"
  let id ← refInt callee
  let env ← get
  let some decl := env.funs.find? id.toNat
    | failAt callee "unresolved interface function declaration"
  let mutability := optStr decl "stateMutability"
  unless mutability == some "view" do
    failAt callee "typed interface calls to non-view functions are outside this slice"
  let params ← mArr (← mField (← mField decl "parameters") "parameters")
  let rs ← mArr (← mField (← mField decl "returnParameters") "parameters")
  let rawReturnTypes ← rs.mapM mType
  let returnTypes := rawReturnTypes.map fun ty =>
    if ty.startsWith "contract " then "address" else ty
  unless returnTypes.size ≥ 2 do
    failAt callee "typed interface multi-return staticcall requires at least two return values"
  for rTy in returnTypes do
    unless isSupportedStaticCallReturnType rTy do
      failAt callee "typed interface staticcall tuple return elements must be uint256, uint8..uint248, int256, bytes32, bytes4, bool or address"
  let args ← mArr (← mField j "arguments")
  unless args.size == params.size do
    failAt j "typed interface staticcall argument count differs from its declaration"
  let some hex := optStr decl "functionSelector"
    | failAt callee "interface function has no functionSelector"
  unless hex.length == 8 do
    failAt callee s!"invalid functionSelector hex length {hex.length}"
  let mut selector := 0
  for c in hex.toList do
    let some digit := Compiler.Hex.hexCharToNat? c
      | failAt callee "invalid functionSelector hex digit"
    selector := selector * 16 + digit
  let base ← mField callee "expression"
  let receiver ← extractInterfaceReceiver base
  for arg in args do
    if statefulCallIn arg (← get) || assignmentIn arg then
      failAt arg "typed interface staticcall arguments are outside this slice"
  let callId ← mNat (← mField j "id")
  modify fun e => { e with admittedInterfaceCalls := e.admittedInterfaceCalls.erase callId }
  let rawTarget ← lowerExpr receiver
  let target ← atom { rawTarget with expr := cleanHelperResultExpr "address" rawTarget }
  let mut pre := target.pre
  let mut payloadPtr := Expr.literal 0
  let mut payloadSize := Expr.literal 0
  unless args.isEmpty do
    let payload ← lowerAbiEncodeArgs args (some params)
    let ptr ← atom { pre := payload.pre, expr := payload.pointer }
    let payloadBytes ← atom { pre := #[], expr := payload.size }
    pre := pre ++ ptr.pre ++ payloadBytes.pre
    payloadPtr := ptr.expr
    payloadSize := payloadBytes.expr
  let callBase ← fresh
  let callEnd ← fresh
  let dataPtr ← fresh
  let dataSize ← fresh
  modify fun e => { e with encodingMemory := true }
  if args.isEmpty then
    pre := pre ++ (AbiEncoding.reserve callBase callEnd (.literal 32)).toArray
    pre := pre ++ #[
      .mstore (.localVar callBase) (.literal selector),
      .letVar dataPtr (.add (.localVar callBase) (.literal 28)),
      .letVar dataSize (.literal 4)
    ]
  else
    let index ← fresh
    let words := Expr.div (.add payloadSize (.literal 31)) (.literal 32)
    pre := pre ++ (AbiEncoding.reserve callBase callEnd
      (.add (.literal 32) (.mul words (.literal 32)))).toArray
    pre := pre ++ #[
      .mstore (.localVar callBase) (.literal selector),
      .forEach index words [
        .mstore (.add (.add (.localVar callBase) (.literal 32)) (.mul (.localVar index) (.literal 32)))
          (.mload (.add payloadPtr (.mul (.localVar index) (.literal 32))))],
      .letVar dataPtr (.add (.localVar callBase) (.literal 28)),
      .letVar dataSize (.add payloadSize (.literal 4))
    ]
  let outBytes := 32 * returnTypes.size
  let outPtr ← fresh
  let outEnd ← fresh
  let success ← fresh
  pre := pre ++ (AbiEncoding.reserve outPtr outEnd (.literal outBytes)).toArray
  pre := pre ++ #[
    .ecm (Compiler.ECM.YulMemoryCall.module true success)
      [target.expr, .localVar dataPtr, .localVar dataSize,
       .localVar outPtr, .literal outBytes],
    .ite (.eq (.localVar success) (.literal 0)) [.revertReturndata] [],
    .ite (.lt .returndataSize (.literal outBytes)) [.revertEmpty] []
  ]
  let mut retExprs : Array (Expr × String) := #[]
  for i in [:returnTypes.size] do
    let rTy := returnTypes[i]!
    let rawRTy := rawReturnTypes[i]!
    let wordVar ← fresh
    let wordAddr := if i == 0 then Expr.localVar outPtr
      else Expr.add (.localVar outPtr) (.literal (32 * i))
    pre := pre.push (.letVar wordVar (.mload wordAddr))
    if let some g := abiDecodeScalarGuard? rTy none (.localVar wordVar) then
      pre := pre.push g
    retExprs := retExprs.push (.localVar wordVar, rawRTy)
  return (pre, retExprs)

/-- `I(a).f(args...)` for a `view` interface function returning a single
`uint256`, `int256`, `bytes32`, `bytes4`, `bool`, `address` or `uint8`..`uint248` over scalar,
struct or dynamic `bytes`/`string` arguments. solc 0.8.34 ABI-encodes the selector and
arguments at the free pointer, emits `staticcall(gas(), a, p, len, p, 32)`, forwards a failed
call's complete return data as the revert payload, reverts with no data on fewer
than 32 return bytes, decodes the first word (reverting with no data on a `bool`,
`address` or `uintN` word out of range or a `bytes4` word with dirty low bytes)
and ignores extra bytes. With return data expected, the code-existence check is
omitted, so an account without code takes the short-return revert. The closed
`SolidityStaticCall` transports have this exact meaning in Denote and in
compiled Yul. Placement, parameter, receiver, return and argument routing do not depend on
whether the contract has one or more state variables (#2830,
`InterfaceStaticCallStateCountChecks`). -/
private partial def lowerInterfaceStaticCall (j : Json) : M Val := do
  if (← get).forwardingBytesTuple then
    failAt j "typed external call results are unsupported in a forwarded tuple call tree"
  let callee ← mField j "expression"
  let id ← refInt callee
  let env ← get
  let some decl := (env.funs.find? id.toNat <|> env.stateVars.find? id.toNat)
    | failAt callee "unresolved interface function declaration"
  let isStateVarGetter := optStr decl "nodeType" == some "VariableDeclaration"
  let mutability := if isStateVarGetter then some "view" else optStr decl "stateMutability"
  if (← interfaceVoidCallDecl? j).isSome then
    failAt j "a typed external call without return values must be a whole expression statement"
  let (params, rawReturnTypes) ← if isStateVarGetter then do
    let (paramSpecs, leafNode) ← publicVarGetterParamTypes (← mField decl "typeName")
    pure (paramSpecs.map Prod.snd, #[← mType leafNode])
  else do
    let ps ← mArr (← mField (← mField decl "parameters") "parameters")
    let rs ← mArr (← mField (← mField decl "returnParameters") "parameters")
    pure (ps, ← rs.mapM mType)
  let rawParamTypes ← params.mapM mType
  let paramTypes := rawParamTypes.map fun ty =>
    if ty.startsWith "contract " then "address" else ty
  let args ← mArr (← mField j "arguments")
  let returnTypes := rawReturnTypes.map fun ty =>
    if ty.startsWith "contract " then "address" else ty
  let isNonpayableCallback := !env.stateVars.isEmpty && mutability == some "nonpayable" &&
    !params.isEmpty && (returnTypes == #["uint256"] || returnTypes == #["bytes32"] ||
      returnTypes == #["bool"] || returnTypes == #["address"])
  unless isNonpayableCallback || isStateVarGetter do
    unless optStr decl "stateMutability" == some "view" do
      failAt callee "typed interface calls to non-view functions are outside this slice"
  let hasDynamicOrStructParam := !env.stateVars.isEmpty && paramTypes.any fun pty =>
    pty == "bytes" || pty == "string" || (pty.startsWith "struct " && !pty.contains "[") ||
    (scalarArrayElement? pty).isSome
  let hasExtendedScalarParam :=
    !paramTypes.all (["address", "uint256", "bytes32", "bool"].contains ·) &&
    paramTypes.all fun pty => (paramType pty).isSome
  -- Each parameter is one ABI head word; solc cleans `address` to 160 bits and
  -- `bool` to `0`/`1` before encoding. An `enum` argument is its ordinal word:
  -- solc's encoder asserts it is below the member count, and every enum value the
  -- importer admits already is (root parameters are guarded at entry, `Enum(x)`
  -- casts panic with 0x21 out of range, fallible casts in an argument fail closed in
  -- `checkEncodingScalar`, and enum storage fields and Yul writes are rejected).
  unless isNonpayableCallback || isStateVarGetter || hasDynamicOrStructParam || hasExtendedScalarParam do
    unless paramTypes.all (["address", "uint256", "bytes32", "bool"].contains ·) do
      failAt j "typed interface staticcall parameters must be address, uint256, bytes32 or bool"
  unless args.size == params.size do
    failAt j "typed interface staticcall argument count differs from its declaration"
  -- One narrow unsigned word `uint8` .. `uint248` (#2914): solc reverts with no data unless
  -- the word is below `2^N`, so on success the raw word is already the value.
  let isNarrowUnsignedReturn := returnTypes.size == 1 &&
    (returnTypes[0]!).startsWith "uint" && (bitsOf (returnTypes[0]!)).any (· < 256)
  let isSupportedExtraReturn := returnTypes == #["address"] || isNarrowUnsignedReturn
  let returnType := returnTypes.getD 0 "uint256"
  unless isSupportedExtraReturn do
    unless returnTypes.size == 1 && ["uint256", "int256", "bytes32", "bytes4", "bool"].contains returnType do
      failAt callee "typed interface staticcall must return exactly one uint256, uint8..uint248, int256, bytes32, bytes4, bool or address"
  -- All three transports deliver the first complete return word. solc's ABI decoder
  -- validates `bytes4`, `address` and `uint8`..`uint248` words (dirty padding reverts with
  -- no data) even when the value is discarded; on success the raw word is already the value.
  let decoded (pre : Array Stmt) (result : String) : Val :=
    let word := Expr.localVar result
    let guard := if returnType == "bytes4" || isSupportedExtraReturn then
      abiDecodeScalarGuard? returnType none word else none
    { pre := pre ++ guard.toList.toArray, expr := word }
  let some hex := optStr decl "functionSelector"
    | failAt callee "interface function has no functionSelector"
  unless hex.length == 8 do
    failAt callee s!"invalid functionSelector hex length {hex.length}"
  let mut selector := 0
  for c in hex.toList do
    let some digit := Compiler.Hex.hexCharToNat? c
      | failAt callee "invalid functionSelector hex digit"
    selector := selector * 16 + digit
  let base ← mField callee "expression"
  let receiver ← extractInterfaceReceiver base
  -- Any expression position: each enclosing lowering sequences the call's prelude in
  -- solc's evaluation order (binary operands per pipeline, conditional arms and
  -- short-circuit operands only on their branch, assignments right-hand side first).
  let callId ← mNat (← mField j "id")
  modify fun e => { e with admittedInterfaceCalls := e.admittedInterfaceCalls.erase callId }
  -- A converted argument, or a computed one whose lowering needs a prelude, is converted
  -- and cleaned below; any other argument takes the word path. The trial lowering runs on
  -- a copy of the state without the unsupported-construct sink, then the state is restored.
  let hasExtendedArg ← (args.zip paramTypes).anyM fun (arg, ty) => do
    let argTy ← mType arg
    if argTy != ty && !(ty == "uint256" && argTy.startsWith "int_const " && !argTy.startsWith "int_const -") then
      return true
    let k ← mKind arg
    unless k == "BinaryOperation" || k == "FunctionCall" || k == "Conditional" ||
        k == "UnaryOperation" || k == "Assignment" || k == "TupleExpression" do return false
    let saved ← get
    set { saved with unsupportedSink := none }
    let needsPrelude ← try pure !(← lowerExpr arg).pre.isEmpty catch e =>
      if e.isInterrupt || e.isRuntime then throw e else pure true
    set saved
    return needsPrelude
  if isNonpayableCallback || hasDynamicOrStructParam || hasExtendedScalarParam || hasExtendedArg then
    let rawTarget ← lowerExpr receiver
    let boundTarget ← atom { rawTarget with expr := cleanHelperResultExpr "address" rawTarget }
    let target ← if args.any assignmentIn && !(boundTarget.expr matches .literal _) then
        let snapshot ← fresh
        pure { pre := boundTarget.pre.push (.letVar snapshot boundTarget.expr), expr := .localVar snapshot }
      else
        pure boundTarget
    let result ← fresh
    let isDynBytesOrString (ty : String) : Bool :=
      ty == "bytes" || ty == "bytes memory" || ty == "bytes calldata" ||
      ty == "bytes storage ref" || ty == "bytes storage pointer" ||
      ty == "string" || ty == "string memory" || ty == "string calldata" ||
      ty == "string storage ref" || ty == "string storage pointer" ||
      ty.startsWith "literal_string "
    let mut hasDynamicArg := false
    for (param, arg) in params.zip args do
      let pty ← mType param
      let argTy ← mType arg
      if pty == "bytes" || pty == "string" then
        unless isDynBytesOrString argTy do
          failAt j "typed interface staticcall arguments are outside this slice"
        hasDynamicArg := true
      else if let some (pElem, _, _) := scalarArrayElement? pty then
        let some (argElem, _, _) := scalarArrayElement? argTy
          | failAt j "typed interface staticcall arguments are outside this slice"
        unless pElem == argElem && (← mKind arg) == "Identifier" do
          failAt j "typed interface staticcall arguments are outside this slice"
        hasDynamicArg := true
      else if pty.startsWith "struct " && !pty.contains "[" then
        unless argTy.startsWith "struct " && !argTy.contains "[" do
          failAt j "typed interface staticcall arguments are outside this slice"
        let (pSid, pDecl) ← resolveStructDeclFromType param
        let (argSid, _) ← resolveStructDeclFromType arg
        unless pSid == argSid do
          failAt j "typed interface staticcall arguments are outside this slice"
        let pMembers ← mArr (← mField pDecl "members")
        if pMembers.isEmpty then
          failAt j "typed interface staticcall arguments are outside this slice"
        let isStaticStruct ← pMembers.allM fun mNode => do
          let mTy ← mType mNode
          pure (paramType mTy).isSome
        if !isStaticStruct then
          let structs := (← get).structs
          let enums := (← get).enums
          match AbiSchema.root (fun id => structs.find? id) pDecl
              (resolveEnum := fun id => (enums.find? id).map (·.size)) with
          | .ok schema =>
              unless schema.any AbiSchema.isDynamicMember do
                failAt j "typed interface staticcall arguments are outside this slice"
              -- `string` members are admitted for decoded parameters only; their
              -- re-encoding into a typed call has no differential coverage yet.
              if AbiSchema.membersHaveString schema then
                failAt arg "typed interface staticcall struct arguments with string members are outside this slice"
              hasDynamicArg := true
          | .error _ =>
              failAt j "typed interface staticcall arguments are outside this slice"
      else
        unless (paramType pty).isSome do
          failAt j "typed interface staticcall arguments are outside this slice"
    if isNonpayableCallback || hasDynamicArg then
      let payload ← lowerAbiEncodeArgs args (some params) (externalArgs := true)
      let payloadPtr ← atom { pre := payload.pre, expr := payload.pointer }
      let payloadSize ← atom { pre := #[], expr := payload.size }
      modify fun env => { env with encodingMemory := true }
      let mod := if isNonpayableCallback then
        if returnType == "bool" then
          Compiler.ECM.SolidityLowLevelCall.bytesBoolModule result selector
        else
          Compiler.ECM.SolidityLowLevelCall.bytesUint256Module result selector
      else if returnType == "bool" then
        Compiler.ECM.SolidityStaticCall.bytesBoolModule result selector
      else
        Compiler.ECM.SolidityStaticCall.bytesUint256Module result selector
      let callPre := (target.pre ++ payloadPtr.pre ++ payloadSize.pre).push
        (.ecm mod [target.expr, payloadPtr.expr, payloadSize.expr])
      return decoded callPre result
    let mut pre := target.pre
    let mut words : Array Expr := #[]
    let hoistEnv ← get
    let hasMutation := args.any fun arg => statefulCallIn arg hoistEnv || assignmentIn arg
    let hoist := hasMutation || args.any fun arg => jsonHasCustomRevert hoistEnv [] arg
    for (param, arg) in params.zip args do
      let pty ← mType param
      let argTy ← mType arg
      if pty.startsWith "struct " && !pty.contains "[" then
        if hasMutation then
          failAt arg "struct ABI encoding argument beside a state-changing argument is unsupported"
        let (sPre, sWords) ← lowerEncodedStaticStructWords arg
        pre := pre ++ sPre
        words := words ++ sWords.toArray
      else
        -- A staticcall argument list is ordered, so a checked `a + b` evaluates at its
        -- own position; `hoist` only decides whether the word must be frozen first.
        checkEncodingScalar arg true
        let converted ← convert pty argTy (← lowerExpr arg) arg
        let bound ← atom { converted with expr := cleanHelperResultExpr pty converted }
        -- Bind the word at its own position: a later argument may write what this one
        -- reads (`x`, then `x++`), or revert before the encoding runs.
        let word ← if hoist && !(bound.expr matches .literal _) then
            let snapshot ← fresh
            pure { pre := bound.pre.push (.letVar snapshot bound.expr), expr := .localVar snapshot }
          else
            pure bound
        pre := pre ++ word.pre
        words := words.push word.expr
    modify fun env => { env with encodingMemory := true }
    let mod := if returnType == "bool" then
      Compiler.ECM.SolidityStaticCall.boolModule result selector words.size
    else
      Compiler.ECM.SolidityStaticCall.uint256Module result selector words.size
    let callPre := pre.push (.ecm mod (target.expr :: words.toList))
    return decoded callPre result
  -- Implied by `hasExtendedArg` being false; kept as a defensive check.
  for (arg, ty) in args.zip paramTypes do
    let argTy ← mType arg
    unless argTy == ty ||
        (ty == "uint256" && argTy.startsWith "int_const " && !argTy.startsWith "int_const -") do
      failAt arg s!"typed interface staticcall argument type {argTy} differs from parameter type {ty}"
  let rawTarget ← lowerExpr receiver
  let target ← atom { rawTarget with expr := cleanHelperResultExpr "address" rawTarget }
  let mut words : Array Expr := #[]
  let mut pre := target.pre
  for (arg, ty) in args.zip paramTypes do
    let value ← lowerExpr arg
    unless value.pre.isEmpty do
      failAt arg "typed interface staticcall arguments must lower without side effects"
    let cleaned := cleanHelperResultExpr ty value
    let word ← atom { pre := #[], expr := cleaned }
    pre := pre ++ word.pre
    words := words.push word.expr
  let result ← fresh
  -- The transport writes its scratch at the free pointer and bumps it before the
  -- call, so the root must start from solc's `mload(64) = 0x80` like every other
  -- free-pointer user; a zero pointer would let the bump overlap argument words.
  modify fun e => { e with encodingMemory := true }
  pre := pre.push (.ecm (Compiler.ECM.SolidityStaticCall.uint256Module result selector words.size)
    (target.expr :: words.toList))
  if returnType == "bool" then
    pre := pre.push (.ite (.gt (.localVar result) (.literal 1)) [.revertEmpty] [])
  pure (decoded pre result)

/-- `address(this).code.length`, possibly parenthesized. -/
private partial def isThisCodeLength (j : Json) : M Bool := do
  let j := unparenJson j
  unless optStr j "nodeType" == some "MemberAccess" && optStr j "memberName" == some "length" do
    return false
  let some code := field? j "expression" | return false
  unless ← isAddressCodeAccess code do return false
  isThisAddressConv (unparenJson (← mField code "expression"))

/-- `address(this).code.length` compared with zero (`== 0`, `!= 0`, `> 0` and the
mirrored `0 == x`, `0 != x`, `0 < x`), as OpenZeppelin's `initializer` guard reads it:
`EXTCODESIZE(ADDRESS)` through the closed code-length transport, which Denote answers
from the executing account's code in the account world. The executing account's code
differs between the source and compiled routes, but both have code exactly when the
account is deployed: it has none while its constructor runs, also when that
constructor delegatecalls the root. Only the zero test is exposed, so the routes
agree; any other use of the length still rejects in `lowerExtCodeSize`. `none` when
`op` with these operands is not such a test. -/
private partial def lowerThisCodeLengthZeroTest? (op : String) (left right : Json) :
    M (Option Val) := do
  let isZero := fun (n : Json) => do return (← mType (unparenJson n)) == "int_const 0"
  let empty? : Option Bool ←
    if (← isThisCodeLength left) && (← isZero right) then
      pure (if op == "==" then some true else if op == "!=" || op == ">" then some false else none)
    else if (← isThisCodeLength right) && (← isZero left) then
      pure (if op == "==" then some true else if op == "!=" || op == "<" then some false else none)
    else pure none
  let some empty := empty? | return none
  let size ← fresh
  let read := Stmt.ecm (Compiler.ECM.SolidityExtCodeSize.module size) [.contractAddress]
  let test := Expr.eq (.localVar size) (.literal 0)
  return some { pre := #[read], expr := if empty then test else .logicalNot test }

/-- `<address>.code.length` of an address-typed account other than the executing
contract: `EXTCODESIZE` through the closed code-length transport, which Denote
answers from the account world (`DenoteExternalCode.extCodeSize`). The executing
contract's own code length differs between the source and compiled routes, so
`address(this).code.length` is rejected outside a comparison with zero
(`lowerThisCodeLengthZeroTest?`). -/
private partial def lowerExtCodeSize (code : Json) : M Val := do
  let account ← mField code "expression"
  if ← isThisAddressConv account then
    failAt code "code length of the executing contract is unsupported outside a zero test"
  let target ← lowerCodeReadTarget (← lowerExpr account) code
    "code length of an account that may be the executing contract is unsupported"
  let result ← fresh
  let read := Stmt.ecm (Compiler.ECM.SolidityExtCodeSize.module result) [target.expr]
  pure { pre := target.pre.push read, expr := .localVar result }

/-- `<address>.codehash` of an address-typed account other than the executing
contract, as a `bytes32` word: `EXTCODEHASH` through the closed code-hash
transport, which Denote answers from the account world with EIP-1052 semantics
(`DenoteExternalCode.extCodeHash`). The executing contract's own code differs
between the source and compiled routes and is not modeled, so
`address(this).codehash` is rejected. -/
private partial def lowerExtCodeHash (member : Json) : M Val := do
  let account ← mField member "expression"
  if ← isThisAddressConv account then
    failAt member "code hash of the executing contract is unsupported"
  let target ← lowerCodeReadTarget (← lowerExpr account) member
    "code hash of an account that may be the executing contract is unsupported"
  let result ← fresh
  modify fun e => { e with codeHashSites := e.codeHashSites.push (result, member) }
  let read := Stmt.ecm (Compiler.ECM.SolidityExtCodeHash.module result) [target.expr]
  pure { pre := target.pre.push read, expr := .localVar result }

/-- `<address>.code` of an address-typed account other than the executing
contract, as a fresh `bytes memory` buffer: `EXTCODESIZE` and `EXTCODECOPY` through
the closed code-copy transport, which Denote answers from the account world
(`DenoteExternalCode.accountCode`). The buffer's data pointer and length are
bound atoms. The executing contract's own code differs between the source and
compiled routes and is not modeled, so `address(this).code` is rejected. -/
private partial def lowerExtCodeCopy (code : Json) : M EncodedBytes := do
  let account ← mField code "expression"
  if (← isThisAddressConv account) then
    failAt code "code of the executing contract is unsupported"
  let target ← lowerCodeReadTarget (← lowerExpr account) code
    "code of an account that may be the executing contract is unsupported"
  let array ← fresh
  let data ← fresh
  let length ← fresh
  modify fun e => { e with encodingMemory := true }
  let copy := Stmt.ecm (Compiler.ECM.SolidityExtCodeCopy.module array) [target.expr]
  return { pre := target.pre ++ #[copy,
             .letVar data (.add (.localVar array) (.literal 32)),
             .letVar length (.mload (.localVar array))],
           pointer := .localVar data, size := .localVar length }

/-- Bind the complete return data of the last call as the `bytes memory` local `d`, as
solc's `extract_returndata`: empty return data is the zero-length array at `0x60` (data
at `0x80`); otherwise a fresh array of `returndatasize()` bytes is allocated at the free
pointer (`Panic(0x41)` past 64 bits), its length word stored and the bytes copied after
it. The local is registered as a byte buffer (`d.length`, `add(d, 0x20)` / `mload(d)` in
assembly, ABI encoding and forwarding); reassigning it is rejected. -/
private partial def bindReturndataLocal (d : Json) : M (Array Stmt) := do
  unless (← mType d) == "bytes" && optStr d "storageLocation" == some "memory" do
    failAt d "call return data must be bound to a bytes memory local"
  let id ← mNat (← mField d "id")
  let name ← mStr (← mField d "name")
  if (← get).bodyAssigned.contains id then
    failAt d "reassigned call return data locals are outside this slice"
  let size ← fresh
  let pointer ← freshFor name
  let array ← fresh
  let finish ← fresh
  let allocate := AbiEncoding.reserve array finish
    (.add (.literal 32) (.mul (.div (.add (.localVar size) (.literal 31)) (.literal 32))
      (.literal 32)))
  modify fun e =>
    { e with byteBuffers := e.byteBuffers.insert id
               { pre := #[], pointer := .localVar pointer, size := .localVar size },
             nonLiteralByteLocals := if e.nonLiteralByteLocals.contains id then
               e.nonLiteralByteLocals else e.nonLiteralByteLocals.push id,
             encodingMemory := true,
             yulNames := e.yulNames.erase name,
             yulMemoryArrays := e.yulMemoryArrays.erase name,
             yulMemoryStructs := e.yulMemoryStructs.insert name id }
  return #[
    .letVar size .returndataSize,
    .letVar pointer (.literal 0x80),
    .ite (.eq (.localVar size) (.literal 0)) [] (allocate ++ [
      .mstore (.localVar array) (.localVar size),
      .assignVar pointer (.add (.localVar array) (.literal 32)),
      .returndataCopy (.localVar pointer) (.literal 0) (.localVar size)])]

/-- Bind the scalar local `d` of type `ty` to `value`, as a writable Solidity local. -/
private partial def bindScalarLocal (d : Json) (value : Expr) : M (Array Stmt) := do
  let ty ← mType d
  let some scalarType := localParamType ty | failAt d s!"unsupported local type {ty}"
  let id ← mNat (← mField d "id")
  let name ← mStr (← mField d "name")
  let binding ← freshFor name
  let expr := Expr.localVar binding
  modify fun e =>
    { e with values := e.values.insert id expr,
             scalarTy := e.scalarTy.insert id scalarType,
             yulNames := e.yulNames.insert name expr,
             yulMemoryArrays := e.yulMemoryArrays.erase name,
             yulMemoryStructs := e.yulMemoryStructs.erase name,
             writableLocals := e.writableLocals.insert id binding,
             zeroInitLocals := e.zeroInitLocals.filter (· != id) }
  return #[.letVar binding value]

/-- `(bool success, bytes memory returndata) = target.call{value: v}(data);`, either
component possibly omitted. solc 0.8.34 evaluates the receiver, the value and then the
`bytes` argument; sends `data` as the complete calldata with
`call(gas(), target, v, p, len, 0, 0)` through the closed value-transferring memory call
(an underfunded call fails without running the target; a failed call refunds the value);
binds the success bit; and, when the second component is named, materializes the complete
return data (`bindReturndataLocal`). Nothing reverts by itself: the caller decides what a
failure means (`if (!success) revert ...`, `require(success)`, returndata forwarding).
Only the `value` option is admitted; `gas` (whose stipend semantics are not modeled) and
effectful operands reject. -/
private partial def lowerValueCallDeclaration (s init member : Json) : M (Array Stmt) := do
  let callee ← mField init "expression"
  let names ← mArr (← mField callee "names")
  let options ← mArr (← mField callee "options")
  unless names == #[Json.str "value"] && options.size == 1 do
    failAt callee "low-level call options other than a single `value` are outside this slice"
  let valueNode := options[0]!
  let args ← mArr (← mField init "arguments")
  let #[dataNode] := args | failAt init "low-level call takes exactly one bytes argument"
  let declarations ← mArr (← mField s "declarations")
  unless declarations.size == 2 do
    failAt s "low-level call must be destructured as (bool success, bytes memory returndata)"
  let success := declarations[0]!
  let data := declarations[1]!
  unless success.isNull || (← mType success) == "bool" do
    failAt success "low-level call success must be bound to a bool local"
  let base ← mField member "expression"
  for operand in #[base, valueNode, dataNode] do
    if statefulCallIn operand (← get) || assignmentIn operand then
      failAt operand "low-level call operands require explicit evaluation-order support"
  let rawTarget ← lowerExpr base
  let target ← atom { rawTarget with expr := cleanHelperResultExpr "address" rawTarget }
  let value ← atom (← lowerConverted "uint256" valueNode)
  let payload ← lowerEncodedBytes dataNode
  let payloadPtr ← atom { pre := payload.pre, expr := payload.pointer }
  let payloadSize ← atom { pre := #[], expr := payload.size }
  let result ← fresh
  modify fun e => { e with encodingMemory := true }
  let mut out := target.pre ++ value.pre ++ payloadPtr.pre ++ payloadSize.pre |>.push
    (.ecm (Compiler.ECM.YulMemoryValueCall.module result)
      [target.expr, value.expr, payloadPtr.expr, payloadSize.expr, .literal 0, .literal 0])
  unless data.isNull do
    out := out ++ (← bindReturndataLocal data)
  unless success.isNull do
    out := out ++ (← bindScalarLocal success (.localVar result))
  return out

/-- The Solady/OpenZeppelin `SafeTransferLib` sequence over a value-free low-level call:

    (bool success, bytes memory returndata) = target.call(abi.encodeCall(f, (args...)));
    if (!success) { assembly { revert(add(returndata, 0x20), mload(returndata)) } }
    require(returndata.length == 0 || abi.decode(returndata, (bool)), reason);

`s` is the declaration and `following` the rest of its statement list. The first
two lower to the closed optional-bool transport, which forwards a failed call's
returndata, reverts empty on malformed returndata and binds the decoded `bool`
(`1` for empty returndata); the `require` becomes the same `reason` check of that
result. Neither local may be read anywhere else. `none` when `s` is not a
low-level call declaration. -/
private partial def lowerLowLevelCallSequence? (s : Json) (following : List Json) :
    M (Option (Array Stmt × Nat)) := do
  let some init := (field? s "initialValue").filter (!·.isNull) | return none
  let some member ← lowLevelCallMember? init | return none
  let callee ← mField init "expression"
  if (← mKind callee) == "FunctionCallOptions" then
    return some (← lowerValueCallDeclaration s init member, 0)
  let declarations ← mArr (← mField s "declarations")
  unless declarations.size == 2 && declarations.all (!·.isNull) do
    failAt s "low-level call must bind both success and returndata, and validate the returndata"
  let success := declarations[0]!
  let data := declarations[1]!
  unless (← mType success) == "bool" && (← mType data) == "bytes" &&
      optStr data "storageLocation" == some "memory" do
    failAt s "low-level call must bind (bool success, bytes memory returndata)"
  let successId ← mNat (← mField success "id")
  let dataId ← mNat (← mField data "id")
  let dataName ← mStr (← mField data "name")
  let (selector, params, components) ← lowLevelEncodeCallParts init
  let forward :: validation :: rest := following
    | failAt s "low-level call must be followed by returndata forwarding and optional-bool validation"
  unless ← isReturndataForwarding forward successId dataId dataName do
    failAt forward ("a failed low-level call must forward its returndata: " ++
      "if (!success) { assembly { revert(add(returndata, 0x20), mload(returndata)) } }")
  unless ← isOptionalBoolValidation validation dataId do
    failAt validation ("low-level call returndata must be validated by " ++
      "require(returndata.length == 0 || abi.decode(returndata, (bool)), ...)")
  for later in rest do
    if jsonMentionsDecl later successId || jsonMentionsDecl later dataId then
      failAt later "low-level call results are read only by the returndata forwarding and validation"
  let base ← mField member "expression"
  for operand in #[base] ++ components do
    if statefulCallIn operand (← get) || assignmentIn operand then
      failAt operand "low-level call operands require explicit evaluation-order support"
  -- solc evaluates the receiver, then the encoded arguments in source order.
  let rawTarget ← lowerExpr base
  let target ← atom { rawTarget with expr := cleanHelperResultExpr "address" rawTarget }
  let mut pre := target.pre
  let mut words : Array Expr := #[]
  for (param, component) in params.zip components do
    let pty ← mType param
    let conv ← lowerConverted pty component
    let word ← atom { conv with expr := cleanHelperResultExpr pty conv }
    pre := pre ++ word.pre
    words := words.push word.expr
  let result ← fresh
  let call := Stmt.ecm (Compiler.ECM.SolidityLowLevelCall.optionalBoolModule result selector words.size)
    (target.expr :: words.toList)
  let check ← lowerRequireWith validation fun _ => pure { pre := #[], expr := .localVar result }
  return some (pre.push call ++ check, 2)

/-- The global `ecrecover(hash, v, r, s)` builtin in solc's via-IR shape: the four
arguments are evaluated left to right, ABI-encoded at the free memory pointer
(which is not advanced), the output word at `0` is cleared, and
`staticcall(gas(), 1, ptr, 128, 0, 32)` runs through the closed
`YulMemoryCall` transport. A failed call forwards its return data; otherwise
the result is the output word masked to an address, so an invalid signature
(the precompile returns no data) yields `address(0)`. The legacy pipeline makes
the same call and forwarding but receives the word in a 32-byte allocation at the
free pointer instead of at `0`: only memory layout differs, which the imported
fragment does not observe (the model's allocations are not solc's, and Yul reads
below `0x80` must read words their own block wrote). -/
private partial def lowerEcrecover (j callee : Json) : M Val := do
  unless optStr callee "name" == some "ecrecover" &&
      (← mType callee) == "function (bytes32,uint8,bytes32,bytes32) pure returns (address)" do
    failAt callee "ecrecover must resolve to the global builtin"
  let args ← mArr (← mField j "arguments")
  unless args.size == 4 do failAt j "ecrecover requires four arguments"
  let mut pre : Array Stmt := #[]
  let mut words : Array Expr := #[]
  for (arg, paramTy) in args.toList.zip ["bytes32", "uint8", "bytes32", "bytes32"] do
    let converted ← convert paramTy (← mType arg) (← lowerExpr arg) arg
    -- Copy each argument into a fresh local before the next one runs (solc's left-to-right
    -- order): a plain local is copied too, since a later argument may assign it.
    -- solc's ABI encoder cleans `v` to 8 bits; a Yul-assigned `uint8` local may hold a
    -- dirty word until a typed consumer like this one.
    let value := if paramTy == "uint8" then .bitAnd converted.expr (.literal 255)
      else converted.expr
    let word ← fresh
    pre := pre ++ converted.pre.push (.letVar word value)
    words := words.push (.localVar word)
  let ptr ← fresh
  let success ← fresh
  let result ← fresh
  pre := pre.push (.letVar ptr (.mload (.literal 64)))
  for (word, index) in words.toList.zip (List.range 4) do
    pre := pre.push (.mstore (.add (.localVar ptr) (.literal (32 * index))) word)
  pre := pre ++ #[
    .mstore (.literal 0) (.literal 0),
    .ecm (Compiler.ECM.YulMemoryCall.module true success)
      [.literal 1, .localVar ptr, .literal 128, .literal 0, .literal 32],
    .ite (.eq (.localVar success) (.literal 0)) [.revertReturndata] [],
    .letVar result (.bitAnd (.mload (.literal 0)) (.literal (2 ^ 160 - 1)))]
  return { pre, expr := .localVar result }

/-- The `staticcall` member of `target.staticcall(...)` on an address-typed receiver, or
`none`. Call options (`target.staticcall{gas: g}(...)`) reject at the options node. -/
private partial def lowLevelStaticcallMember? (call : Json) : M (Option Json) := do
  unless optStr call "nodeType" == some "FunctionCall" &&
      optStr call "kind" == some "functionCall" do
    return none
  let some calleeRaw := field? call "expression" | return none
  let callee := unparenJson calleeRaw
  if optStr callee "nodeType" == some "FunctionCallOptions" then
    let some innerRaw := field? callee "expression" | return none
    let inner := unparenJson innerRaw
    if optStr inner "nodeType" == some "MemberAccess" &&
        optStr inner "memberName" == some "staticcall" &&
        (field? inner "referencedDeclaration").isNone then
      failAt callee "low-level staticcall options are outside this slice"
    return none
  unless optStr callee "nodeType" == some "MemberAccess" &&
      optStr callee "memberName" == some "staticcall" &&
      (field? callee "referencedDeclaration").isNone do
    return none
  let some base := field? callee "expression" | return none
  let ty ← mType base
  return if ty == "address" || ty == "address payable" then some callee else none

/-- Solidity's low-level `target.staticcall(payload)` with a `bytes memory` payload, as
solc 0.8.34 lowers it (legacy and via-IR): the receiver, then the payload, are evaluated;
`staticcall(gas(), target, add(payload, 0x20), mload(payload), 0, 0)` runs through the
closed `YulMemoryCall` staticcall transport (no value; the EVM runs the callee in a static
context, so it changes no state); success and failure are both values (`ok = 0` on a
revert, an exceptional halt or any failure, with nothing forwarded); there is no
`extcodesize` check, so an account without code succeeds with empty return data. The
return data is then materialised as solc's `extract_returndata`: empty return data is the
zero-length array at `0x60`; otherwise a fresh allocation at the free pointer of
`32 + roundUp(returndatasize())` bytes (`Panic(0x41)` past 64 bits) holding the length and
the complete return (or revert) data. Returns the statements, the success binding, and
the return data's data pointer and length bindings. -/
private partial def lowerLowLevelStaticcall (call member : Json) :
    M (Array Stmt × String × String × String) := do
  unless (← mArr (← mField call "names")).isEmpty do
    failAt call "named call arguments are outside this slice"
  let args ← mArr (← mField call "arguments")
  unless args.size == 1 do failAt call "low-level staticcall takes one bytes memory argument"
  let payloadNode := args[0]!
  let payloadTy ← mType payloadNode
  unless payloadTy == "bytes memory" || payloadTy == "bytes" do
    failAt payloadNode s!"low-level staticcall payload must be bytes memory, found {payloadTy}"
  let target ← convert "address" (← mType (← mField member "expression"))
    (← lowerExpr (← mField member "expression")) member
  let targetVar ← fresh
  let payload ← lowerEncodedBytes payloadNode
  let inPtr ← fresh
  let inSize ← fresh
  let success ← fresh
  let size ← fresh
  let header ← fresh
  let finish ← fresh
  let data ← fresh
  modify fun e =>
    { e with encodingMemory := true,
             unpaddedByteDataBindings := e.unpaddedByteDataBindings.push data }
  let roundedWords := Expr.div (.add (.localVar size) (.literal 31)) (.literal 32)
  let alloc :=
    [Stmt.ite (.le (.localVar size) (.literal (2 ^ 64 - 1))) [] [.panicCode (.literal 0x41)]] ++
      AbiEncoding.reserve header finish (.add (.literal 32) (.mul roundedWords (.literal 32)))
  let pre : Array Stmt := target.pre.push (.letVar targetVar target.expr) ++ payload.pre ++ #[
    .letVar inPtr payload.pointer,
    .letVar inSize payload.size,
    .ecm (Compiler.ECM.YulMemoryCall.module true success)
      [.localVar targetVar, .localVar inPtr, .localVar inSize, .literal 0, .literal 0],
    .letVar size .returndataSize,
    .letVar data (.literal 128),
    .ite (.eq (.localVar size) (.literal 0)) [] (alloc ++ [
      .mstore (.localVar header) (.localVar size),
      .assignVar data (.add (.localVar header) (.literal 32)),
      .returndataCopy (.localVar data) (.literal 0) (.localVar size)])]
  return (pre, success, data, size)

private partial def lowerCall (j : Json) : M Val := do
  let names ← mArr (← mField j "names")
  unless names.isEmpty do failAt j "named call arguments are outside this slice"
  let kind ← mStr (← mField j "kind")
  if kind == "typeConversion" then
    let args ← mArr (← mField j "arguments")
    if (← mType j) == "address" && args.size == 1 then
      if (← mKind args[0]!) == "Identifier" && optStr args[0]! "name" == some "this" then
        unless (← refInt args[0]!) == -28 do
          failAt args[0]! "this does not resolve to the current contract builtin"
        return { pre := #[], expr := .contractAddress }
    lowerCast j
  else if kind == "functionCall" then
    let callee ← mField j "expression"
    if (← mKind callee) == "Identifier" then
      let calleeId ← refInt callee
      if calleeId == -8 then
        let args ← mArr (← mField j "arguments")
        unless args.size == 1 do failAt j "keccak256 requires one byte buffer"
        let bytes ← lowerEncodedBytes args[0]!
        return { pre := bytes.pre, expr := .keccak256 bytes.pointer bytes.size }
      if calleeId == -2 || calleeId == -16 then
        let isMul := calleeId == -16
        let bname := if isMul then "mulmod" else "addmod"
        unless optStr callee "name" == some bname &&
            (← mType callee) == "function (uint256,uint256,uint256) pure returns (uint256)" do
          failAt callee s!"{bname} must resolve to the global uint256 builtin"
        let args ← mArr (← mField j "arguments")
        unless args.size == 3 do failAt j s!"{bname} requires three uint256 arguments"
        let mut pre : Array Stmt := #[]
        let mut argExprs : Array Expr := #[]
        for modArg in args do
          if statefulCallIn modArg (← get) then
            failAt modArg s!"stateful {bname} arguments require explicit evaluation-order support"
          if assignmentIn modArg then
            failAt modArg s!"assignment expression in {bname} requires explicit evaluation-order support"
          let converted ← convert "uint256" (← mType modArg) (← lowerExpr modArg) modArg
          let bound ← atom converted
          pre := pre ++ bound.pre
          argExprs := argExprs.push bound.expr
        let #[a, b, m] := argExprs
          | failAt j s!"{bname} requires three uint256 arguments"
        let modCheck : Stmt := .ite (.eq m (.literal 0)) [.panic .divisionByZero] []
        let modVal ← if isMul then lowerYulMulmod a b m else lowerYulAddmod a b m
        return { pre := pre.push modCheck ++ modVal.pre, expr := modVal.expr }
      if calleeId == -6 then
        return ← lowerEcrecover j callee
      if calleeId ≥ 0 then
        if let some ptr := (← get).fnPtrs.find? calleeId.toNat then
          let vals ← lowerCallArgs j none
          match ptr with
          | .direct fnId => return ← inlineFn fnId vals j
          | .branch cond trueFnId falseFnId =>
              let (argPre, atomicVals) ← atomizeCallArgs vals
              let yesVal ← inlineFn trueFnId atomicVals j
              let noVal ← inlineFn falseFnId atomicVals j
              let dest ← fresh
              let thenB := yesVal.pre.push (.assignVar dest yesVal.expr)
              let elseB := noVal.pre.push (.assignVar dest noVal.expr)
              return { pre := argPre.push (.letVar dest (.literal 0)) |>.push (.ite cond thenB.toList elseB.toList),
                       expr := .localVar dest }
    if (← mKind callee) == "MemberAccess" && (field? callee "referencedDeclaration").isNone then
      let mname := optStr callee "memberName" |>.getD ""
      if mname == "push" || mname == "pop" then
        let base ← mField callee "expression"
        let baseRef ← lowerRef base
        if let some (pre, fieldName, slotExpr, elemTy, _, _, elemSid?) ← resolveStorageDynamicArrayTarget baseRef base then
          if elemSid?.isSome then
            failAt j s!"storage struct array {mname} cannot be used as a scalar value"
          let args ← mArr (← mField j "arguments")
          if mname == "push" then
            if args.isEmpty then
              return ← pushStorageDynamicArray pre fieldName slotExpr elemTy none (readPushed := true)
            else if args.size == 1 then
              let arg := args[0]!
              if !pre.isEmpty && (statefulCallIn arg (← get) || assignmentIn arg) then
                failAt arg "storage array push prelude with stateful argument is unsupported"
              let val ← atom (← lowerConverted elemTy arg)
              return ← pushStorageDynamicArray (pre ++ val.pre) fieldName slotExpr elemTy (some val.expr)
            else
              failAt j "storage array push expects at most one argument"
          else
            failAt j "storage array pop does not return a value"
        failAt callee s!"storage array {mname} is outside this slice"
      if mname == "wrap" || mname == "unwrap" then
        let base ← mField callee "expression"
        let baseRef := (field? base "referencedDeclaration").bind (fun v => v.getInt?.toOption) |>.getD (-1)
        if baseRef ≥ 0 then
          if let some uTy := (← get).userValueTypeById.find? baseRef.toNat then
            unless (paramType uTy).isSome && !uTy.startsWith "enum " do
              failAt callee s!"unsupported user-defined value type underlying type {uTy}"
            let args ← mArr (← mField j "arguments")
            unless args.size == 1 do
              failAt j s!"{mname} requires one argument"
            let arg := args[0]!
            let conv ← convert uTy (← mType arg) (← lowerExpr arg) arg
            return if (← get).viaIR then { conv with expr := cleanHelperResultExpr uTy conv } else conv
    if ← isInterfaceExternalCall j then
      return ← lowerInterfaceStaticCall j
    if ← isAbiDecodeCall j then
      let (decodePre, decoded) ← lowerAbiDecodeItems j
      unless decoded.size == 1 do
        failAt j "scalar abi.decode expression requires a single scalar target type"
      let .scalar _ _ expr := decoded[0]!
        | failAt j "scalar abi.decode expression requires a scalar target type"
      return { pre := decodePre, expr }
    -- `new C(...)` runs CREATE: a fresh account at an address derived from this
    -- contract's nonce, C's constructor with its own effects, reverts bubbled up.
    -- No lowering models that, so contract creation rejects in every contract.
    if (← mKind callee) == "NewExpression" && (← mType j).startsWith "contract " then
      if (← get).forwardingBytesTuple then
        failAt j "contract creation in a forwarded tuple requires CREATE semantics"
      failAt j "contract creation `new C(...)` requires CREATE semantics and is outside this slice"
    let (fnId, vals) ← resolveCallTargetAndArgs j
    inlineFn fnId vals j
  else
    failAt j s!"unsupported call kind {kind}"

private partial def bindHelperParams (params : Array Json) (args : Array CallArg) (body : Json) (at_ : Json)
    (savedYul : RBMap String Expr compare) : M (Array Stmt × RBMap String Expr compare) := do
  let linkedCall := (← get).linkedLibrariesMatchSource && isLinkedLibraryCallSite at_
  -- A string literal bound to a `bytesN` parameter is its left-aligned word;
  -- convert it before `atomizeCallArgs` so the unused memory buffer is dropped.
  let args ← if linkedCall then do
    let mut normalized : Array CallArg := #[]
    for (arg, i) in args.zipIdx do
      let norm ← if i < params.size then
        match arg with
        | .stringBuffer _ => do
            let pty ← mType params[i]!
            let argNode ← argumentAt at_ i
            match ← fixedBytesStringLiteral? pty argNode with
            | some word => pure (CallArg.scalar word)
            | none => pure arg
        | _ => pure arg
      else pure arg
      normalized := normalized.push norm
    pure normalized
  else pure args
  let (atomPre, args) ← if linkedCall then atomizeCallArgs args else pure (#[], args)
  let mut pre : Array Stmt := atomPre
  -- A caller's `<name>.slot` names its own storage parameter or local, which is out of
  -- scope in the callee; state variable slots are rebound per assembly block.
  let mut yul := savedYul.fold (fun acc name _ => if name.endsWith ".slot" then acc.erase name else acc)
    savedYul
  for i in [:params.size] do
    let p := params[i]!
    let pname ← mStr (← mField p "name")
    let pid ← mNat (← mField p "id")
    let pty ← mType p
    discard (validateEnumTypeIfNeeded p pty)
    let argNode ← argumentAt at_ i
    let argTy ← mType argNode
    let some arg := args[i]? | failAt at_ s!"missing argument {i}"
    -- A string literal bound to a `bytesN` parameter is its left-aligned word;
    -- the memory buffer lowered for it at the call site is dropped.
    let arg ← match arg with
      | .stringBuffer _ => do
          match ← fixedBytesStringLiteral? pty argNode with
          | some word => pure (CallArg.scalar word)
          | none => pure arg
      | _ => pure arg
    if pname != "" then
      modify fun e =>
        { e with yulMemoryArrays := e.yulMemoryArrays.erase pname,
                 yulMemoryStructs := e.yulMemoryStructs.erase pname }
    match arg with
    | .scalar value =>
        let converted ← convert pty argTy value at_
        let converted ← if linkedCall then do
          let a ← atom converted
          pure { pre := a.pre, expr := cleanHelperResultExpr pty { pre := #[], expr := a.expr } }
        else pure converted
        if (bodyCompoundAssignedIds body).contains pid || (bodyDirectAssignedIds body).contains pid then
          let some scalar := paramType pty
            | failAt p s!"unsupported writable helper parameter type {pty}"
          let binding ← freshFor (if pname == "" then "param" else pname)
          let expr := Expr.localVar binding
          pre := pre ++ converted.pre |>.push (.letVar binding converted.expr)
          modify fun e =>
            { e with values := e.values.insert pid expr,
                     writableLocals := e.writableLocals.insert pid binding,
                     scalarTy := e.scalarTy.insert pid scalar }
          if pname != "" then
            yul := yul.insert pname expr
        else
          let bound ← atom converted
          pre := pre ++ bound.pre
          modify fun e => { e with values := e.values.insert pid bound.expr }
          if pname != "" then
            yul := yul.insert pname bound.expr
    | .memory descriptor effects =>
        unless pty.startsWith "struct " && !pty.contains "[" do
          failAt p "reference argument requires a struct parameter"
        let sid ← refInt (← mField p "typeName")
        unless sid >= 0 && sid.toNat == descriptor.structId do
          failAt p "reference argument struct declaration differs"
        let location := optStr p "storageLocation" |>.getD "default"
        let expected := if descriptor.calldataLocation then "calldata" else "memory"
        if descriptor.calldataLocation && location == "memory" && (descriptor.schema.isSome || !(← get).stateVars.isEmpty) then
          let (convStmts, memDesc) ← convertStructCalldataToMemory descriptor p
          pre := pre ++ effects ++ convStmts
          modify fun e =>
            { e with mems := e.mems.insert pid memDesc,
                     yulMemoryStructs := if pname == "" then e.yulMemoryStructs else e.yulMemoryStructs.insert pname pid }
        else if location == expected then
          pre := pre ++ effects
          modify fun e =>
