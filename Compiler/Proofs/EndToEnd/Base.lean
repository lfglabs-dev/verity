    Compiler.Proofs.YulGeneration.Backends.freshNativeSwitchId reservedNames n0
  let initial :=
    Compiler.Proofs.YulGeneration.Backends.Native.nativeSwitchPostInitFreeMemoryStoreMarkedPrefixStateForId
