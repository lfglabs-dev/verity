          reservedNames start body = .ok (bodyNative₂, end₂)) :
    bodyNative₁ = bodyNative₂ ∧ end₁ = end₂ := by
  rw [h₁] at h₂
  simp only [Except.ok.injEq, Prod.mk.injEq] at h₂
