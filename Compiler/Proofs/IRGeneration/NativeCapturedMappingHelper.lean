namespace Compiler.Proofs.IRGeneration.CapturedMappingHelper
open EvmYul

/-- Each actual primitive produces the complete next boundary, including gas and account world. -/
theorem helper_stage_primitive (index : Fin 16) (initial : EVM.State)
    (enough : 85 ≤ initial.gasAvailable.toNat) :
    let machine := helperStage initial ⟨index.val, by omega⟩
    let instruction := optimizedInstructions[index].2
    EVM.step 1 (EVM.C' (EVM.Proof.zMid machine instruction.1) instruction.1)
      (some instruction) (EVM.Proof.zMid machine instruction.1) =
        .ok (helperStage initial ⟨index.val + 1, by omega⟩) := by
  obtain ⟨index, small⟩ := index
  have positions : index = 0 ∨ index = 1 ∨ index = 2 ∨ index = 3 ∨ index = 4 ∨ index = 5 ∨
      index = 6 ∨ index = 7 ∨ index = 8 ∨ index = 9 ∨ index = 10 ∨ index = 11 ∨
      index = 12 ∨ index = 13 ∨ index = 14 ∨ index = 15 := by omega
  rcases positions with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact helper_transition_zero initial enough
  · exact helper_transition_calldataload_1 initial enough
  · exact helper_transition_push0_2 initial enough
  · exact helper_transition_mstore_3 initial enough
  · exact helper_transition_push0_4 initial enough
  · exact helper_transition_calldataload_5 initial enough
  · exact helper_transition_push1_6 initial enough
  · exact helper_transition_mstore_7 initial enough
  · exact helper_transition_push1_8 initial enough
  · exact helper_transition_push0_9 initial enough
  · exact helper_transition_keccak_10 initial enough
  · exact helper_transition_push0_11 initial enough
  · exact helper_transition_mstore_12 initial enough
  · exact helper_transition_push1_13 initial enough
  · exact helper_transition_push0_14 initial enough
  · exact helper_transition_return_15 initial enough

/-- The real checked step succeeds at each boundary and produces the next one. -/
theorem helper_stage_checked (index : Fin 16) (initial : EVM.State)
    (enough : 85 ≤ initial.gasAvailable.toNat) :
    let machine := helperStage initial ⟨index.val, by omega⟩
    let instruction := optimizedInstructions[index].2
    CreationCaller.checkedStep machine instruction.1 instruction.2 =
      .ok (helperStage initial ⟨index.val + 1, by omega⟩) := by
  have bounds := helper_stage_stack_bounds index initial
  have guards := helper_guards _ _ _ _ (helper_stage_admitted index)
    bounds.1 bounds.2 (helper_stage_enough index initial enough)
  exact checked_of_guards _ _ _ _ guards (helper_stage_primitive index initial enough)

/-- The boundary PC table is the decoder's actual instruction PC table. -/
theorem helper_stage_pc_table : ∀ index : Fin 16,
    helperPC[(⟨index.val, by omega⟩ : Fin 17)] = optimizedInstructions[index].1 := by decide

/-- At each computed boundary, real byte decoding selects the same captured instruction. -/
theorem helper_stage_decode (index : Fin 16) (initial : EVM.State)
    (code : initial.executionEnv.code = optimized) :
    EVM.Proof.decodeAt (helperStage initial ⟨index.val, by omega⟩) = optimizedInstructions[index].2 := by
  have stageCode : (helperStage initial ⟨index.val, by omega⟩).executionEnv.code = optimized := code
  apply optimized_decode_at _ index stageCode
  exact congrArg UInt256.ofNat (helper_stage_pc_table index)

/-- All checked prefixes succeed from the computed boundary, with no successful-run oracle. -/
theorem helper_checked_prefix (count index : Nat) (initial : EVM.State)
    (bound : index + count ≤ 16) (code : initial.executionEnv.code = optimized)
    (enough : 85 ≤ initial.gasAvailable.toNat) :
    checkedSteps count (helperStage initial ⟨index, by omega⟩) =
      .ok (helperStage initial ⟨index + count, by omega⟩) := by
  induction count generalizing index with
  | zero => rfl
  | succ count ih =>
    have decoded := helper_stage_decode ⟨index, by omega⟩ initial code
    have step := helper_stage_checked ⟨index, by omega⟩ initial enough
    change (CreationCaller.checkedStep _ (EVM.Proof.decodeAt _).1 (EVM.Proof.decodeAt _).2 >>=
      checkedSteps count) = _
    rw [decoded, step]
    change checkedSteps count (helperStage initial ⟨index + 1, by omega⟩) = _
    simpa only [Nat.add_assoc, Nat.add_comm 1 count] using ih (index + 1) (by omega)

/-- Entry gas85, PC0, empty stack and zero active words suffice for the entire actual checked run.
Physical memory and calldata are arbitrary; no hash agreement is needed for native success. -/
theorem helper_checked_success (initial : EVM.State)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 0)
    (stack : initial.stack = []) (words : initial.activeWords = UInt256.ofNat 0)
    (enough : 85 ≤ initial.gasAvailable.toNat) :
    checkedSteps 16 initial = .ok (helperStage initial ⟨16, by decide⟩) := by
  have allSteps := helper_checked_prefix 16 0 initial (by decide) code enough
  rw [helper_stage_zero initial pc stack words] at allSteps
  exact allSteps

/-- Native execution of the actual captured helper terminates from sufficient entry resources. -/
theorem helper_native_success (fuel : Nat) (initial : EVM.State)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 0)
    (stack : initial.stack = []) (words : initial.activeWords = UInt256.ofNat 0)
    (enough : 85 ≤ initial.gasAvailable.toNat) :
    EVM.X (fuel + 17) (EVM.D_J initial.executionEnv.code (UInt256.ofNat 0)) initial =
      .ok (.success (helperStage initial ⟨16, by decide⟩)
        (helperStage initial ⟨16, by decide⟩).H_return) := by
  exact optimized_native_halt fuel initial _ code pc (helper_checked_success initial code pc stack words enough)

/-- Complete helper native/model result from sufficient resources, without a success oracle.
Only pointwise native/pure Keccak agreement at the actual calldata preimage remains explicit. -/
theorem helper_native_model_result (fuel : Nat) (initial : EVM.State)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 0)
    (stack : initial.stack = []) (words : initial.activeWords = UInt256.ofNat 0)
    (enough : 85 ≤ initial.gasAvailable.toNat)
    (hash : ffi.KEC (Compiler.Proofs.abiEncodeMappingSlot
      (initial.toState.calldataload (UInt256.ofNat 0)).toNat
      (initial.toState.calldataload (UInt256.ofNat 32)).toNat) =
        KeccakEngine.keccak256 (Compiler.Proofs.abiEncodeMappingSlot
          (initial.toState.calldataload (UInt256.ofNat 0)).toNat
          (initial.toState.calldataload (UInt256.ofNat 32)).toNat)) :
    let final := helperStage initial ⟨16, by decide⟩
    EVM.X (fuel + 17) (EVM.D_J initial.executionEnv.code (UInt256.ofNat 0)) initial =
      .ok (.success final (UInt256.ofNat (Compiler.Proofs.solidityMappingSlot
        (initial.toState.calldataload (UInt256.ofNat 0)).toNat
        (initial.toState.calldataload (UInt256.ofNat 32)).toNat)).toByteArray) ∧
      final.toState = initial.toState ∧ final.stack = initial.stack := by
  exact optimized_native_result fuel initial _ code pc (helper_checked_success initial code pc stack words enough) hash

/-- The successful helper spends exactly85 gas, not merely at most85. -/
theorem helper_final_gas (initial : EVM.State) :
    (helperStage initial ⟨16, by decide⟩).gasAvailable.toNat = initial.gasAvailable.toNat - 85 := by
  change (UInt256.ofNat (initial.gasAvailable.toNat - 85)).toNat = _
  exact Nat.mod_eq_of_lt (lt_of_le_of_lt (Nat.sub_le _ _) initial.gasAvailable.val.isLt)

end Compiler.Proofs.IRGeneration.CapturedMappingHelper
