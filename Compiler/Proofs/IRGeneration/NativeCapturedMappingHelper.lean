namespace Compiler.Proofs.IRGeneration.CapturedMappingHelper
open EvmYul

/-- Decoding expectations from the pinned solc opcode listing, excluding PUSH data. -/
def optimizedInstructions : Array (Nat × EVM.Proof.Instruction) := #[
  (0, (.Push .PUSH1, some (UInt256.ofNat 32, 1))),
  (2, (.CALLDATALOAD, none)), (3, (.Push .PUSH0, none)), (4, (.MSTORE, none)),
  (5, (.Push .PUSH0, none)), (6, (.CALLDATALOAD, none)),
  (7, (.Push .PUSH1, some (UInt256.ofNat 32, 1))), (9, (.MSTORE, none)),
  (10, (.Push .PUSH1, some (UInt256.ofNat 64, 1))),
  (12, (.Push .PUSH0, none)), (13, (.KECCAK256, none)),
  (14, (.Push .PUSH0, none)), (15, (.MSTORE, none)),
  (16, (.Push .PUSH1, some (UInt256.ofNat 32, 1))),
  (18, (.Push .PUSH0, none)), (19, (.RETURN, none))]

/-- Every actual optimized instruction, including each immediate, decodes as captured. -/
theorem optimized_decode : ∀ index : Fin 16,
    EVM.decode optimized (UInt256.ofNat optimizedInstructions[index].1) =
      some optimizedInstructions[index].2 := by decide

/-- The optimizer emitted exactly twenty bytes; the whole iterator uses this code. -/
theorem optimized_bounded : optimized.size < UInt256.size := by decide

/-- The actual opcode at any listed machine PC follows from code identity. -/
theorem optimized_decode_at (machine : EVM.State) (index : Fin 16)
    (code : machine.executionEnv.code = optimized)
    (pc : machine.pc = UInt256.ofNat optimizedInstructions[index].1) :
    EVM.Proof.decodeAt machine = optimizedInstructions[index].2 := by
  unfold EVM.Proof.decodeAt
  rw [code, pc, optimized_decode index]
  rfl

end Compiler.Proofs.IRGeneration.CapturedMappingHelper

namespace Compiler.Proofs.IRGeneration.CapturedMappingHelper
open EvmYul
open NativeMappingStorageExecution NativeMappingKeccak

/-- Bounded actual checked instructions, decoded from each computed native PC.
This records successful instruction steps; it does not replace native halting semantics. -/
def checkedSteps : Nat → EVM.State → Except EVM.ExecutionException EVM.State
  | 0, machine => .ok machine
  | count + 1, machine => do
    let decoded := EVM.Proof.decodeAt machine
    let next ← CreationCaller.checkedStep machine decoded.1 decoded.2
    checkedSteps count next

private theorem bind_success {α β ε : Type} (step : Except ε α) (next : α → Except ε β) (result : β)
    (success : (step >>= next) = .ok result) :
    ∃ middle, step = .ok middle ∧ next middle = .ok result := by
  cases step with
  | error reason => cases success
  | ok middle => exact ⟨middle, rfl, success⟩

/-- Decompose a successful actual bounded run; intermediate states are derived. -/
theorem checkedSteps_success (count : Nat) (machine final : EVM.State)
    (success : checkedSteps (count + 1) machine = .ok final) :
    ∃ next, CreationCaller.checkedStep machine (EVM.Proof.decodeAt machine).1
      (EVM.Proof.decodeAt machine).2 = .ok next ∧ checkedSteps count next = .ok final := by
  exact bind_success _ _ _ success

/-- Real checked PUSH1 determines its stack, account world, PC and physical memory. -/
theorem checked_push1_shape (machine after : EVM.State) (word : UInt256)
    (success : CreationCaller.checkedStep machine (.Push .PUSH1) (some (word, 1)) = .ok after) :
    after.stack = word :: machine.stack ∧ after.toState = machine.toState ∧
      after.pc = machine.pc + UInt256.ofNat 2 ∧ after.memory = machine.memory := by
  let expanded := { machine with
    gasAvailable := machine.gasAvailable - UInt256.ofNat (EVM.memoryExpansionCost machine (.Push .PUSH1)) }
  have stepped := NativeCreationStorageOpcodes.checkedStep_delegates machine after (.Push .PUSH1) (some (word, 1)) success
  have actual := NativeMidnightConstructor.step_PUSH1 0 (EVM.C' expanded (.Push .PUSH1)) expanded word
  have same := Except.ok.inj (stepped.symm.trans actual)
  cases same
  exact ⟨rfl, rfl, rfl, rfl⟩

/-- Real checked PUSH0 materializes zero without changing calldata or memory. -/
theorem checked_push0_shape (machine after : EVM.State)
    (success : CreationCaller.checkedStep machine (.Push .PUSH0) none = .ok after) :
    after.stack = UInt256.ofNat 0 :: machine.stack ∧ after.toState = machine.toState ∧
      after.pc = machine.pc + UInt256.ofNat 1 ∧ after.memory = machine.memory := by
  let expanded := { machine with
    gasAvailable := machine.gasAvailable - UInt256.ofNat (EVM.memoryExpansionCost machine (.Push .PUSH0)) }
  have stepped := NativeCreationStorageOpcodes.checkedStep_delegates machine after (.Push .PUSH0) none success
  have actual := NativeMidnightConstructor.step_PUSH0 0 (EVM.C' expanded (.Push .PUSH0)) expanded
  have same := Except.ok.inj (stepped.symm.trans actual)
  cases same
  exact ⟨rfl, rfl, rfl, rfl⟩

/-- Actual calldata opcode reads the machine's calldata, not a supplied parameter. -/
theorem step_calldataload (machine : EVM.State) (offset : UInt256) (tail : Stack UInt256) (cost : Nat) :
    EVM.step 1 cost (some (.CALLDATALOAD, none)) { machine with stack := offset :: tail } =
      .ok ((EVM.Proof.stepPre cost { machine with stack := offset :: tail }).replaceStackAndIncrPC
        (machine.toState.calldataload offset :: tail)) := by rfl

/-- Successful checked calldata load derives its actual parameter word and complete local frame. -/
theorem checked_calldataload_shape (machine after : EVM.State) (offset : UInt256) (tail : Stack UInt256)
    (stack : machine.stack = offset :: tail)
    (success : CreationCaller.checkedStep machine .CALLDATALOAD none = .ok after) :
    after.stack = machine.toState.calldataload offset :: tail ∧ after.toState = machine.toState ∧
      after.pc = machine.pc + UInt256.ofNat 1 ∧ after.memory = machine.memory := by
  let expanded := { machine with
    gasAvailable := machine.gasAvailable - UInt256.ofNat (EVM.memoryExpansionCost machine .CALLDATALOAD) }
  let cost := EVM.C' expanded .CALLDATALOAD
  have stepped := NativeCreationStorageOpcodes.checkedStep_delegates machine after .CALLDATALOAD none success
  change EVM.step 1 cost (some (.CALLDATALOAD, none)) expanded = .ok after at stepped
  have expandedStack : expanded.stack = offset :: tail := stack
  have restored : { expanded with stack := offset :: tail } = expanded := by rw [← expandedStack]
  have actual := step_calldataload expanded offset tail cost
  rw [restored] at actual
  rw [actual] at stepped
  cases Except.ok.inj stepped
  exact ⟨rfl, rfl, rfl, rfl⟩

/-- The actual first three captured instructions derive key and zero address from calldata. -/
theorem optimized_key_operands (initial ready : EVM.State)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 0)
    (success : checkedSteps 3 initial = .ok ready) :
    ready.stack = UInt256.ofNat 0 :: initial.toState.calldataload (UInt256.ofNat 32) :: initial.stack ∧
      ready.toState = initial.toState ∧ ready.pc = UInt256.ofNat 4 ∧ ready.memory = initial.memory := by
  obtain ⟨one, first, rest⟩ := checkedSteps_success 2 initial ready success
  have decoded := optimized_decode_at initial ⟨0, by decide⟩ code pc
  change EVM.Proof.decodeAt initial = (.Push .PUSH1, some (UInt256.ofNat 32, 1)) at decoded
  rw [decoded] at first
  obtain ⟨oneStack, oneWorld, onePc, oneMemory⟩ := checked_push1_shape initial one _ first
  have codeOne : one.executionEnv.code = optimized := by
    rw [oneWorld]; exact code
  have pcOne : one.pc = UInt256.ofNat 2 := by rw [onePc, pc]; rfl
  obtain ⟨two, second, rest⟩ := checkedSteps_success 1 one ready rest
  have decoded := optimized_decode_at one ⟨1, by decide⟩ codeOne pcOne
  change EVM.Proof.decodeAt one = (.CALLDATALOAD, none) at decoded
  rw [decoded] at second
  obtain ⟨twoStack, twoWorld, twoPc, twoMemory⟩ := checked_calldataload_shape one two _ _ oneStack second
  have codeTwo : two.executionEnv.code = optimized := by
    rw [twoWorld, oneWorld]; exact code
  have pcTwo : two.pc = UInt256.ofNat 3 := by rw [twoPc, pcOne]; rfl
  obtain ⟨three, third, rest⟩ := checkedSteps_success 0 two ready rest
  have decoded := optimized_decode_at two ⟨2, by decide⟩ codeTwo pcTwo
  change EVM.Proof.decodeAt two = (.Push .PUSH0, none) at decoded
  rw [decoded] at third
  have same : three = ready := Except.ok.inj rest
  subst three
  obtain ⟨readyStack, readyWorld, readyPc, readyMemory⟩ := checked_push0_shape two ready third
  refine ⟨?_, readyWorld.trans (twoWorld.trans oneWorld), ?_, readyMemory.trans (twoMemory.trans oneMemory)⟩
  · rw [readyStack, twoStack, oneWorld]
  · rw [readyPc, pcTwo]; rfl

/-- Splitting a bounded native run does not assume any intermediate state. -/
theorem checkedSteps_add (left right : Nat) (machine : EVM.State) :
    checkedSteps (left + right) machine = (checkedSteps left machine >>= checkedSteps right) := by
  induction left generalizing machine with
  | zero => simp only [Nat.zero_add]; rfl
  | succ left ih =>
    simp only [Nat.succ_add, checkedSteps]
    cases step : CreationCaller.checkedStep machine (EVM.Proof.decodeAt machine).1 (EVM.Proof.decodeAt machine).2 with
    | error reason => rfl
    | ok next => exact ih next

/-- The first actual MSTORE gets its key from calldata and materializes the word. -/
theorem optimized_key_store (initial after : EVM.State)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 0)
    (success : checkedSteps 4 initial = .ok after) :
    after.stack = initial.stack ∧ after.toState = initial.toState ∧ after.pc = UInt256.ofNat 5 ∧
      after.memory = (initial.toMachineState.mstore (UInt256.ofNat 0)
        (initial.toState.calldataload (UInt256.ofNat 32))).memory := by
  rw [show 4 = 3 + 1 from rfl, checkedSteps_add] at success
  obtain ⟨ready, prefixRun, storeRun⟩ := bind_success _ _ _ success
  obtain ⟨stack, frame, position, memory⟩ := optimized_key_operands initial ready code pc prefixRun
  have currentCode : ready.executionEnv.code = optimized := by rw [frame]; exact code
  obtain ⟨final, store, rest⟩ := checkedSteps_success 0 ready after storeRun
  have decoded := optimized_decode_at ready ⟨3, by decide⟩ currentCode position
  change EVM.Proof.decodeAt ready = (.MSTORE, none) at decoded
  rw [decoded] at store
  have same : final = after := Except.ok.inj rest
  subst final
  obtain ⟨finalStack, finalWorld, finalPc⟩ := checked_mstore_shape ready after _ _ _ stack store
  have written := checked_mstore_memory ready after _ _ _ stack store
  refine ⟨finalStack, finalWorld.trans frame, ?_, ?_⟩
  · rw [finalPc, position]; rfl
  · change after.memory = ByteArray.write _ 0 initial.memory 0 32
    change after.memory = ByteArray.write _ 0 ready.memory 0 32 at written
    simpa only [memory] using written

/-- The actual second prefix derives base from calldata and its memory destination from PUSH1. -/
theorem optimized_base_operands (initial ready : EVM.State)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 5)
    (success : checkedSteps 3 initial = .ok ready) :
    ready.stack = UInt256.ofNat 32 :: initial.toState.calldataload (UInt256.ofNat 0) :: initial.stack ∧
      ready.toState = initial.toState ∧ ready.pc = UInt256.ofNat 9 ∧ ready.memory = initial.memory := by
  obtain ⟨one, first, rest⟩ := checkedSteps_success 2 initial ready success
  have decoded := optimized_decode_at initial ⟨4, by decide⟩ code pc
  change EVM.Proof.decodeAt initial = (.Push .PUSH0, none) at decoded
  rw [decoded] at first
  obtain ⟨oneStack, oneWorld, onePc, oneMemory⟩ := checked_push0_shape initial one first
  have codeOne : one.executionEnv.code = optimized := by
    rw [oneWorld]; exact code
  have pcOne : one.pc = UInt256.ofNat 6 := by rw [onePc, pc]; rfl
  obtain ⟨two, second, rest⟩ := checkedSteps_success 1 one ready rest
  have decoded := optimized_decode_at one ⟨5, by decide⟩ codeOne pcOne
  change EVM.Proof.decodeAt one = (.CALLDATALOAD, none) at decoded
  rw [decoded] at second
  obtain ⟨twoStack, twoWorld, twoPc, twoMemory⟩ := checked_calldataload_shape one two _ _ oneStack second
  have codeTwo : two.executionEnv.code = optimized := by
    rw [twoWorld, oneWorld]; exact code
  have pcTwo : two.pc = UInt256.ofNat 7 := by rw [twoPc, pcOne]; rfl
  obtain ⟨three, third, rest⟩ := checkedSteps_success 0 two ready rest
  have decoded := optimized_decode_at two ⟨6, by decide⟩ codeTwo pcTwo
  change EVM.Proof.decodeAt two = (.Push .PUSH1, some (UInt256.ofNat 32, 1)) at decoded
  rw [decoded] at third
  have same : three = ready := Except.ok.inj rest
  subst three
  obtain ⟨readyStack, readyWorld, readyPc, readyMemory⟩ := checked_push1_shape two ready _ third
  refine ⟨?_, readyWorld.trans (twoWorld.trans oneWorld), ?_, readyMemory.trans (twoMemory.trans oneMemory)⟩
  · rw [readyStack, twoStack, oneWorld]
  · rw [readyPc, pcTwo]; rfl

/-- The second actual MSTORE gets base from calldata and materializes its word. -/
theorem optimized_base_store (initial after : EVM.State)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 5)
    (success : checkedSteps 4 initial = .ok after) :
    after.stack = initial.stack ∧ after.toState = initial.toState ∧ after.pc = UInt256.ofNat 10 ∧
      after.memory = (initial.toMachineState.mstore (UInt256.ofNat 32)
        (initial.toState.calldataload (UInt256.ofNat 0))).memory := by
  rw [show 4 = 3 + 1 from rfl, checkedSteps_add] at success
  obtain ⟨ready, prefixRun, storeRun⟩ := bind_success _ _ _ success
  obtain ⟨stack, frame, position, memory⟩ := optimized_base_operands initial ready code pc prefixRun
  have currentCode : ready.executionEnv.code = optimized := by rw [frame]; exact code
  obtain ⟨final, store, rest⟩ := checkedSteps_success 0 ready after storeRun
  have decoded := optimized_decode_at ready ⟨7, by decide⟩ currentCode position
  change EVM.Proof.decodeAt ready = (.MSTORE, none) at decoded
  rw [decoded] at store
  have same : final = after := Except.ok.inj rest
  subst final
  obtain ⟨finalStack, finalWorld, finalPc⟩ := checked_mstore_shape ready after _ _ _ stack store
  have written := checked_mstore_memory ready after _ _ _ stack store
  refine ⟨finalStack, finalWorld.trans frame, ?_, ?_⟩
  · rw [finalPc, position]; rfl
  · change after.memory = ByteArray.write _ 0 initial.memory 32 32
    change after.memory = ByteArray.write _ 0 ready.memory 32 32 at written
    simpa only [memory] using written

/-- The actual captured first eight instructions derive the entire mapping preimage. -/
theorem optimized_preimage (initial after : EVM.State)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 0)
    (success : checkedSteps 8 initial = .ok after) :
    after.stack = initial.stack ∧ after.toState = initial.toState ∧ after.pc = UInt256.ofNat 10 ∧
      after.memory.readWithPadding 0 64 =
        (initial.toState.calldataload (UInt256.ofNat 32)).toByteArray ++
        (initial.toState.calldataload (UInt256.ofNat 0)).toByteArray := by
  rw [show 8 = 4 + 4 from rfl, checkedSteps_add] at success
  obtain ⟨middle, first, second⟩ := bind_success _ _ _ success
  obtain ⟨middleStack, middleWorld, middlePc, middleMemory⟩ := optimized_key_store initial middle code pc first
  have middleCode : middle.executionEnv.code = optimized := by rw [middleWorld]; exact code
  obtain ⟨finalStack, finalWorld, finalPc, finalMemory⟩ := optimized_base_store middle after middleCode middlePc second
  refine ⟨finalStack.trans middleStack, finalWorld.trans middleWorld, finalPc, ?_⟩
  change after.memory = ByteArray.write _ 0 middle.memory 32 32 at finalMemory
  rw [middleWorld] at finalMemory
  rw [finalMemory, middleMemory]
  exact mapping_preimage initial.toMachineState _ _

/-- The real PUSH1/PUSH0/KECCAK sequence consumes the materialized memory. -/
theorem optimized_hash (initial after : EVM.State)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 10)
    (success : checkedSteps 3 initial = .ok after) :
    after.stack = UInt256.ofNat (fromByteArrayBigEndian (ffi.KEC (initial.memory.readWithPadding 0 64))) :: initial.stack ∧
      after.toState = initial.toState ∧ after.pc = UInt256.ofNat 14 ∧ after.memory = initial.memory := by
  obtain ⟨one, first, rest⟩ := checkedSteps_success 2 initial after success
  have decoded := optimized_decode_at initial ⟨8, by decide⟩ code pc
  change EVM.Proof.decodeAt initial = (.Push .PUSH1, some (UInt256.ofNat 64, 1)) at decoded
  rw [decoded] at first
  obtain ⟨oneStack, oneWorld, onePc, oneMemory⟩ := checked_push1_shape initial one _ first
  have codeOne : one.executionEnv.code = optimized := by rw [oneWorld]; exact code
  have pcOne : one.pc = UInt256.ofNat 12 := by rw [onePc, pc]; rfl
  obtain ⟨two, second, rest⟩ := checkedSteps_success 1 one after rest
  have decoded := optimized_decode_at one ⟨9, by decide⟩ codeOne pcOne
  change EVM.Proof.decodeAt one = (.Push .PUSH0, none) at decoded
  rw [decoded] at second
  obtain ⟨twoStack, twoWorld, twoPc, twoMemory⟩ := checked_push0_shape one two second
  have codeTwo : two.executionEnv.code = optimized := by rw [twoWorld, oneWorld]; exact code
  have pcTwo : two.pc = UInt256.ofNat 13 := by rw [twoPc, pcOne]; rfl
  obtain ⟨three, third, rest⟩ := checkedSteps_success 0 two after rest
  have decoded := optimized_decode_at two ⟨10, by decide⟩ codeTwo pcTwo
  change EVM.Proof.decodeAt two = (.KECCAK256, none) at decoded
  rw [decoded] at third
  have same : three = after := Except.ok.inj rest
  subst three
  have stack : two.stack = UInt256.ofNat 0 :: UInt256.ofNat 64 :: initial.stack := by rw [twoStack, oneStack]
  obtain ⟨finalStack, finalWorld, finalMemory, finalPc⟩ := checked_keccak two after _ _ _ stack third
  refine ⟨?_, finalWorld.trans (twoWorld.trans oneWorld), ?_, finalMemory.trans (twoMemory.trans oneMemory)⟩
  · change after.stack = UInt256.ofNat (fromByteArrayBigEndian (ffi.KEC (two.memory.readWithPadding 0 64))) :: _ at finalStack
    simpa only [twoMemory, oneMemory] using finalStack
  · rw [finalPc, pcTwo]; rfl

/-- Eleven actual captured instructions compute the hash of the actual calldata words. -/
theorem optimized_calldata_hash (initial after : EVM.State)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 0)
    (success : checkedSteps 11 initial = .ok after) :
    after.stack = UInt256.ofNat (fromByteArrayBigEndian (ffi.KEC
      ((initial.toState.calldataload (UInt256.ofNat 32)).toByteArray ++
       (initial.toState.calldataload (UInt256.ofNat 0)).toByteArray))) :: initial.stack ∧
      after.toState = initial.toState ∧ after.pc = UInt256.ofNat 14 := by
  rw [show 11 = 8 + 3 from rfl, checkedSteps_add] at success
  obtain ⟨prepared, stores, hashStep⟩ := bind_success _ _ _ success
  obtain ⟨preparedStack, preparedWorld, preparedPc, preimage⟩ := optimized_preimage initial prepared code pc stores
  have preparedCode : prepared.executionEnv.code = optimized := by rw [preparedWorld]; exact code
  obtain ⟨finalStack, finalWorld, finalPc, _⟩ := optimized_hash prepared after preparedCode preparedPc hashStep
  exact ⟨by simpa only [preimage, preparedStack] using finalStack, finalWorld.trans preparedWorld, finalPc⟩

/-- Native ABI encoding sees the original bounded word after a natural-number roundtrip. -/
theorem native_word_roundtrip (word : UInt256) : UInt256.ofNat word.toNat = word := by
  apply congrArg UInt256.mk
  apply Fin.ext
  exact Nat.mod_eq_of_lt word.val.isLt

/-- The actual calldata words produce exactly the source model's mapping preimage. -/
theorem calldata_preimage (machine : EVM.State) :
    Compiler.Proofs.abiEncodeMappingSlot (machine.toState.calldataload (UInt256.ofNat 0)).toNat
      (machine.toState.calldataload (UInt256.ofNat 32)).toNat =
        (machine.toState.calldataload (UInt256.ofNat 32)).toByteArray ++
        (machine.toState.calldataload (UInt256.ofNat 0)).toByteArray := by
  unfold Compiler.Proofs.abiEncodeMappingSlot
  rw [native_word_roundtrip, native_word_roundtrip]

/-- The captured native prefix computes the source slot under one explicit pointwise hash agreement. -/
theorem optimized_model_slot (initial after : EVM.State)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 0)
    (success : checkedSteps 11 initial = .ok after)
    (hash : ffi.KEC (Compiler.Proofs.abiEncodeMappingSlot
      (initial.toState.calldataload (UInt256.ofNat 0)).toNat
      (initial.toState.calldataload (UInt256.ofNat 32)).toNat) =
        KeccakEngine.keccak256 (Compiler.Proofs.abiEncodeMappingSlot
          (initial.toState.calldataload (UInt256.ofNat 0)).toNat
          (initial.toState.calldataload (UInt256.ofNat 32)).toNat)) :
    after.stack = UInt256.ofNat (Compiler.Proofs.solidityMappingSlot
      (initial.toState.calldataload (UInt256.ofNat 0)).toNat
      (initial.toState.calldataload (UInt256.ofNat 32)).toNat) :: initial.stack ∧
      after.toState = initial.toState ∧ after.pc = UInt256.ofNat 14 := by
  have actual := optimized_calldata_hash initial after code pc success
  rw [← calldata_preimage initial, hash] at actual
  exact actual

/-- The captured output store consumes the actual computed hash word. -/
theorem optimized_output_store (initial after : EVM.State) (word : UInt256) (tail : Stack UInt256)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 14)
    (stack : initial.stack = word :: tail) (success : checkedSteps 2 initial = .ok after) :
    after.stack = tail ∧ after.toState = initial.toState ∧ after.pc = UInt256.ofNat 16 ∧
      after.memory = (initial.toMachineState.mstore (UInt256.ofNat 0) word).memory := by
  obtain ⟨one, first, rest⟩ := checkedSteps_success 1 initial after success
  have decoded := optimized_decode_at initial ⟨11, by decide⟩ code pc
  change EVM.Proof.decodeAt initial = (.Push .PUSH0, none) at decoded
  rw [decoded] at first
  obtain ⟨oneStack, oneWorld, onePc, oneMemory⟩ := checked_push0_shape initial one first
  have oneCode : one.executionEnv.code = optimized := by rw [oneWorld]; exact code
  have position : one.pc = UInt256.ofNat 15 := by rw [onePc, pc]; rfl
  obtain ⟨final, store, rest⟩ := checkedSteps_success 0 one after rest
  have decoded := optimized_decode_at one ⟨12, by decide⟩ oneCode position
  change EVM.Proof.decodeAt one = (.MSTORE, none) at decoded
  rw [decoded] at store
  have same : final = after := Except.ok.inj rest
  subst final
  have operands : one.stack = UInt256.ofNat 0 :: word :: tail := by rw [oneStack, stack]
  obtain ⟨finalStack, finalWorld, finalPc⟩ := checked_mstore_shape one after _ _ _ operands store
  have memory := checked_mstore_memory one after _ _ _ operands store
  refine ⟨finalStack, finalWorld.trans oneWorld, ?_, ?_⟩
  · rw [finalPc, position]; rfl
  · change after.memory = ByteArray.write _ 0 initial.memory 0 32
    change after.memory = ByteArray.write _ 0 one.memory 0 32 at memory
    simpa only [oneMemory] using memory

/-- Actual checked RETURN publishes the actual padded memory read. -/
theorem checked_return_shape (machine after : EVM.State) (offset size : UInt256) (tail : Stack UInt256)
    (stack : machine.stack = offset :: size :: tail)
    (success : CreationCaller.checkedStep machine .RETURN none = .ok after) :
    after.H_return = machine.memory.readWithPadding offset.toNat size.toNat ∧
      after.toState = machine.toState ∧ after.stack = tail := by
  let expanded := { machine with
    gasAvailable := machine.gasAvailable - UInt256.ofNat (EVM.memoryExpansionCost machine .RETURN) }
  have stepped := NativeCreationStorageOpcodes.checkedStep_delegates machine after .RETURN none success
  have expandedStack : expanded.stack = offset :: size :: tail := stack
  have actual := EVM.Proof.step_RETURN 0 (EVM.C' expanded .RETURN) expanded tail offset size
    (by rw [expandedStack]; rfl)
  have same := Except.ok.inj (stepped.symm.trans actual)
  cases same
  exact ⟨rfl, rfl, rfl⟩

/-- The actual final two PUSHes derive RETURN's offset and size. -/
theorem optimized_return_operands (initial after : EVM.State)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 16)
    (success : checkedSteps 2 initial = .ok after) :
    after.stack = UInt256.ofNat 0 :: UInt256.ofNat 32 :: initial.stack ∧
      after.toState = initial.toState ∧ after.pc = UInt256.ofNat 19 ∧ after.memory = initial.memory := by
  obtain ⟨one, first, rest⟩ := checkedSteps_success 1 initial after success
  have decoded := optimized_decode_at initial ⟨13, by decide⟩ code pc
  change EVM.Proof.decodeAt initial = (.Push .PUSH1, some (UInt256.ofNat 32, 1)) at decoded
  rw [decoded] at first
  obtain ⟨oneStack, oneWorld, onePc, oneMemory⟩ := checked_push1_shape initial one _ first
  have oneCode : one.executionEnv.code = optimized := by rw [oneWorld]; exact code
  have onePosition : one.pc = UInt256.ofNat 18 := by rw [onePc, pc]; rfl
  obtain ⟨final, second, rest⟩ := checkedSteps_success 0 one after rest
  have decoded := optimized_decode_at one ⟨14, by decide⟩ oneCode onePosition
  change EVM.Proof.decodeAt one = (.Push .PUSH0, none) at decoded
  rw [decoded] at second
  have same : final = after := Except.ok.inj rest
  subst final
  obtain ⟨finalStack, finalWorld, finalPc, finalMemory⟩ := checked_push0_shape one after second
  exact ⟨by rw [finalStack, oneStack], finalWorld.trans oneWorld,
    by rw [finalPc, onePosition]; rfl, finalMemory.trans oneMemory⟩

/-- The final three actual captured instructions return the physical memory bytes. -/
theorem optimized_return (initial after : EVM.State)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 16)
    (success : checkedSteps 3 initial = .ok after) :
    after.H_return = initial.memory.readWithPadding 0 32 ∧ after.toState = initial.toState ∧
      after.stack = initial.stack := by
  rw [show 3 = 2 + 1 from rfl, checkedSteps_add] at success
  obtain ⟨ready, prefixRun, returnRun⟩ := bind_success _ _ _ success
  obtain ⟨stack, frame, position, memory⟩ := optimized_return_operands initial ready code pc prefixRun
  have readyCode : ready.executionEnv.code = optimized := by rw [frame]; exact code
  obtain ⟨final, returning, rest⟩ := checkedSteps_success 0 ready after returnRun
  have decoded := optimized_decode_at ready ⟨15, by decide⟩ readyCode position
  change EVM.Proof.decodeAt ready = (.RETURN, none) at decoded
  rw [decoded] at returning
  have same : final = after := Except.ok.inj rest
  subst final
  obtain ⟨bytes, world, finalStack⟩ := checked_return_shape ready after _ _ _ stack returning
  change after.H_return = ready.memory.readWithPadding 0 32 at bytes
  exact ⟨by rw [bytes, memory], world.trans frame, finalStack⟩

/-- The actual five-instruction output suffix returns the computed word's exact bytes. -/
theorem optimized_output (initial after : EVM.State) (word : UInt256) (tail : Stack UInt256)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 14)
    (stack : initial.stack = word :: tail) (success : checkedSteps 5 initial = .ok after) :
    after.H_return = word.toByteArray ∧ after.toState = initial.toState ∧ after.stack = tail := by
  rw [show 5 = 2 + 3 from rfl, checkedSteps_add] at success
  obtain ⟨written, storeRun, returnRun⟩ := bind_success _ _ _ success
  obtain ⟨writtenStack, frame, position, memory⟩ := optimized_output_store initial written word tail code pc stack storeRun
  have writtenCode : written.executionEnv.code = optimized := by rw [frame]; exact code
  obtain ⟨bytes, world, finalStack⟩ := optimized_return written after writtenCode position returnRun
  have readback := MachineState.readWithPadding_memory_mstore_of_le initial.toMachineState (UInt256.ofNat 0) word
    (by exact Nat.zero_le _)
  change (initial.toMachineState.mstore (UInt256.ofNat 0) word).memory.readWithPadding 0 32 = _ at readback
  exact ⟨by rw [bytes, memory]; exact readback, world.trans frame, finalStack.trans writtenStack⟩

/-- Every successful checked execution of the captured helper returns the exact model slot word.
The only hash boundary is an explicit equality at the calldata-derived preimage. -/
theorem optimized_checked_result (initial final : EVM.State)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 0)
    (success : checkedSteps 16 initial = .ok final)
    (hash : ffi.KEC (Compiler.Proofs.abiEncodeMappingSlot
      (initial.toState.calldataload (UInt256.ofNat 0)).toNat
      (initial.toState.calldataload (UInt256.ofNat 32)).toNat) =
        KeccakEngine.keccak256 (Compiler.Proofs.abiEncodeMappingSlot
          (initial.toState.calldataload (UInt256.ofNat 0)).toNat
          (initial.toState.calldataload (UInt256.ofNat 32)).toNat)) :
    final.H_return = (UInt256.ofNat (Compiler.Proofs.solidityMappingSlot
      (initial.toState.calldataload (UInt256.ofNat 0)).toNat
      (initial.toState.calldataload (UInt256.ofNat 32)).toNat)).toByteArray ∧
      final.toState = initial.toState ∧ final.stack = initial.stack := by
  rw [show 16 = 11 + 5 from rfl, checkedSteps_add] at success
  obtain ⟨hashed, prefixRun, suffixRun⟩ := bind_success _ _ _ success
  obtain ⟨stack, frame, position⟩ := optimized_model_slot initial hashed code pc prefixRun hash
  have hashedCode : hashed.executionEnv.code = optimized := by rw [frame]; exact code
  obtain ⟨bytes, finalWorld, finalStack⟩ := optimized_output hashed final _ _ hashedCode position stack suffixRun
  exact ⟨bytes, finalWorld.trans frame, finalStack⟩

end Compiler.Proofs.IRGeneration.CapturedMappingHelper

namespace Compiler.Proofs.IRGeneration.CapturedMappingHelper
open EvmYul
open NativeMappingStorageExecution NativeMappingKeccak

/-- RETURN's actual checked guards entail native Z success, with the same charged gas. -/
theorem checked_return_z (machine after : EVM.State)
    (success : CreationCaller.checkedStep machine .RETURN none = .ok after) :
    EVM.Proof.Z (EVM.D_J machine.executionEnv.code (UInt256.ofNat 0)) .RETURN machine =
      .ok (EVM.Proof.zMid machine .RETURN, EVM.C' (EVM.Proof.zMid machine .RETURN) .RETURN) := by
  have guards := NativePairedCallerChecks.checked_guards machine after .RETURN none success
  have enough : ¬ machine.stack.length < 2 := by
    simpa only [EVM.δ, Option.getD] using guards.stack
  have limit : ¬ machine.stack.length - 2 > 1024 := by
    simpa only [EVM.δ, EVM.α, Option.getD, Nat.add_zero] using guards.limit
  have instruction := guards.instruction
  dsimp only [EVM.Proof.zMid] at instruction
  simp [EVM.Proof.Z, EVM.Proof.W, EVM.δ, EVM.α, Operation.isCreate,
    enough, limit, guards.memory, instruction]
  rfl

/-- The actual RETURN primitive is independent of every positive interpreter fuel. -/
theorem return_step_fuel (fuel cost : Nat) (machine : EVM.State) :
    EVM.step (fuel + 1) cost (some (.RETURN, none)) machine =
      EVM.step 1 cost (some (.RETURN, none)) machine := by rfl

/-- Actual native RETURN halts with the exact checked poststate and its return bytes. -/
theorem checked_return_x (fuel : Nat) (machine after : EVM.State)
    (decoded : EVM.Proof.decodeAt machine = (.RETURN, none))
    (success : CreationCaller.checkedStep machine .RETURN none = .ok after) :
    EVM.X (fuel + 2) (EVM.D_J machine.executionEnv.code (UInt256.ofNat 0)) machine =
      .ok (.success after after.H_return) := by
  apply EVM.Proof.X_succ_of_halt decoded (checked_return_z machine after success)
  · change EVM.step (fuel + 1) (EVM.C' (EVM.Proof.zMid machine .RETURN) .RETURN)
      (some (.RETURN, none)) (EVM.Proof.zMid machine .RETURN) = .ok after
    rw [return_step_fuel]
    exact NativeCreationStorageOpcodes.checkedStep_delegates machine after .RETURN none success
  · rfl
  · decide

/-- The captured final instruction, not a supplied RETURN opcode, determines native halt. -/
theorem optimized_return_x (fuel : Nat) (machine after : EVM.State)
    (code : machine.executionEnv.code = optimized) (pc : machine.pc = UInt256.ofNat 19)
    (success : checkedSteps 1 machine = .ok after) :
    EVM.X (fuel + 2) (EVM.D_J machine.executionEnv.code (UInt256.ofNat 0)) machine =
      .ok (.success after after.H_return) := by
  obtain ⟨next, step, done⟩ := checkedSteps_success 0 machine after success
  have same : next = after := Except.ok.inj done
  subst next
  have decoded := optimized_decode_at machine ⟨15, by decide⟩ code pc
  change EVM.Proof.decodeAt machine = (.RETURN, none) at decoded
  rw [decoded] at step
  exact checked_return_x fuel machine after decoded step

private theorem stack_pair (stack : Stack UInt256) (enough : ¬ stack.length < 2) :
    ∃ first second tail, stack = first :: second :: tail := by
  cases stack with
  | nil => simp at enough
  | cons first rest =>
    cases rest with
    | nil => simp at enough
    | cons second tail => exact ⟨first, second, tail, rfl⟩

/-- Actual checked MSTORE determines its PC and world without supplying any operands. -/
theorem checked_mstore_frame (machine after : EVM.State)
    (success : CreationCaller.checkedStep machine .MSTORE none = .ok after) :
    after.toState = machine.toState ∧ after.pc = machine.pc + UInt256.ofNat 1 := by
  have enough := (NativePairedCallerChecks.checked_guards machine after .MSTORE none success).stack
  simp only [EVM.δ, Option.getD] at enough
  obtain ⟨offset, value, tail, stack⟩ := stack_pair machine.stack enough
  have result := checked_mstore_shape machine after offset value tail stack success
  exact result.2

/-- Actual checked KECCAK determines its PC and world without an operand oracle. -/
theorem checked_keccak_frame (machine after : EVM.State)
    (success : CreationCaller.checkedStep machine .KECCAK256 none = .ok after) :
    after.toState = machine.toState ∧ after.pc = machine.pc + UInt256.ofNat 1 := by
  have enough := (NativePairedCallerChecks.checked_guards machine after .KECCAK256 none success).stack
  simp only [EVM.δ, Option.getD] at enough
  obtain ⟨offset, size, tail, stack⟩ := stack_pair machine.stack enough
  have result := checked_keccak machine after offset size tail stack success
  exact ⟨result.2.1, result.2.2.2⟩

/-- Actual checked calldata load determines its PC and world without an offset oracle. -/
theorem checked_calldataload_frame (machine after : EVM.State)
    (success : CreationCaller.checkedStep machine .CALLDATALOAD none = .ok after) :
    after.toState = machine.toState ∧ after.pc = machine.pc + UInt256.ofNat 1 := by
  have enough := (NativePairedCallerChecks.checked_guards machine after .CALLDATALOAD none success).stack
  simp only [EVM.δ, Option.getD] at enough
  cases stack : machine.stack with
  | nil => simp only [stack, List.length_nil] at enough; omega
  | cons offset tail =>
    have result := checked_calldataload_shape machine after offset tail stack success
    exact ⟨result.2.1, result.2.2.1⟩

private theorem advance_frame (machine after : EVM.State) (start finish delta : UInt256)
    (pc : machine.pc = start)
    (frame : after.toState = machine.toState ∧ after.pc = machine.pc + delta)
    (advance : start + delta = finish) :
    after.toState = machine.toState ∧ after.pc = finish := by
  exact ⟨frame.1, by rw [frame.2, pc, advance]⟩

/-- Every real nonterminal captured instruction advances to the next listed PC.
The opcode, optional immediate and intermediate frame all follow from actual decode/success. -/
theorem optimized_instruction_frame (index : Fin 15) (machine after : EVM.State)
    (code : machine.executionEnv.code = optimized)
    (pc : machine.pc = UInt256.ofNat optimizedInstructions[(⟨index.val, by omega⟩ : Fin 16)].1)
    (success : CreationCaller.checkedStep machine (EVM.Proof.decodeAt machine).1
      (EVM.Proof.decodeAt machine).2 = .ok after) :
    after.toState = machine.toState ∧
      after.pc = UInt256.ofNat optimizedInstructions[(⟨index.val + 1, by omega⟩ : Fin 16)].1 := by
  have positions : index.val = 0 ∨ index.val = 1 ∨ index.val = 2 ∨ index.val = 3 ∨
      index.val = 4 ∨ index.val = 5 ∨ index.val = 6 ∨ index.val = 7 ∨ index.val = 8 ∨
      index.val = 9 ∨ index.val = 10 ∨ index.val = 11 ∨ index.val = 12 ∨ index.val = 13 ∨ index.val = 14 := by omega
  rcases positions with position | position | position | position | position | position | position |
    position | position | position | position | position | position | position | position
  all_goals have decoded := optimized_decode_at machine ⟨index.val, by omega⟩ code pc
  all_goals simp [position, optimizedInstructions] at decoded pc ⊢
  all_goals rw [decoded] at success
  · have result := checked_push1_shape machine after _ success
    exact advance_frame machine after _ _ _ pc ⟨result.2.1, result.2.2.1⟩ (by rfl)
  · have result := checked_calldataload_frame machine after success
    exact advance_frame machine after _ _ _ pc result (by rfl)
  · have result := checked_push0_shape machine after success
    exact advance_frame machine after _ _ _ pc ⟨result.2.1, result.2.2.1⟩ (by rfl)
  · have result := checked_mstore_frame machine after success
    exact advance_frame machine after _ _ _ pc result (by rfl)
  · have result := checked_push0_shape machine after success
    exact advance_frame machine after _ _ _ pc ⟨result.2.1, result.2.2.1⟩ (by rfl)
  · have result := checked_calldataload_frame machine after success
    exact advance_frame machine after _ _ _ pc result (by rfl)
  · have result := checked_push1_shape machine after _ success
    exact advance_frame machine after _ _ _ pc ⟨result.2.1, result.2.2.1⟩ (by rfl)
  · have result := checked_mstore_frame machine after success
    exact advance_frame machine after _ _ _ pc result (by rfl)
  · have result := checked_push1_shape machine after _ success
    exact advance_frame machine after _ _ _ pc ⟨result.2.1, result.2.2.1⟩ (by rfl)
  · have result := checked_push0_shape machine after success
    exact advance_frame machine after _ _ _ pc ⟨result.2.1, result.2.2.1⟩ (by rfl)
  · have result := checked_keccak_frame machine after success
    exact advance_frame machine after _ _ _ pc result (by rfl)
  · have result := checked_push0_shape machine after success
    exact advance_frame machine after _ _ _ pc ⟨result.2.1, result.2.2.1⟩ (by rfl)
  · have result := checked_mstore_frame machine after success
    exact advance_frame machine after _ _ _ pc result (by rfl)
  · have result := checked_push1_shape machine after _ success
    exact advance_frame machine after _ _ _ pc ⟨result.2.1, result.2.2.1⟩ (by rfl)
  · have result := checked_push0_shape machine after success
    exact advance_frame machine after _ _ _ pc ⟨result.2.1, result.2.2.1⟩ (by rfl)

/-- Every real nonterminal captured instruction has the native continuation relation. -/
theorem optimized_instruction_x (index : Fin 15) (fuel : Nat) (machine after : EVM.State)
    (code : machine.executionEnv.code = optimized)
    (pc : machine.pc = UInt256.ofNat optimizedInstructions[(⟨index.val, by omega⟩ : Fin 16)].1)
    (success : CreationCaller.checkedStep machine (EVM.Proof.decodeAt machine).1
      (EVM.Proof.decodeAt machine).2 = .ok after) :
    EVM.X (fuel + 2) (EVM.D_J machine.executionEnv.code (UInt256.ofNat 0)) machine =
      EVM.X (fuel + 1) (EVM.D_J machine.executionEnv.code (UInt256.ofNat 0)) after := by
  have decoded := optimized_decode_at machine ⟨index.val, by omega⟩ code pc
  rw [decoded] at success
  by_cases hashing : index.val = 10
  · simp only [hashing] at decoded success
    apply EVM.Proof.X_succ_of_continue decoded (checked_keccak_z machine after success)
    · change EVM.step (fuel + 1) (EVM.C' (EVM.Proof.zMid machine .KECCAK256) .KECCAK256)
        (some (.KECCAK256, none)) (EVM.Proof.zMid machine .KECCAK256) = .ok after
      rw [step_keccak_fuel]
      exact NativeCreationStorageOpcodes.checkedStep_delegates machine after .KECCAK256 none success
    · rfl
  · have admitted : (CreationCaller.supported optimizedInstructions[(⟨index.val, by omega⟩ : Fin 16)].2.1 ||
        optimizedInstructions[(⟨index.val, by omega⟩ : Fin 16)].2.1 = .SSTORE ||
        optimizedInstructions[(⟨index.val, by omega⟩ : Fin 16)].2.1 = .TSTORE) = true := by
      have positions : index.val = 0 ∨ index.val = 1 ∨ index.val = 2 ∨ index.val = 3 ∨
          index.val = 4 ∨ index.val = 5 ∨ index.val = 6 ∨ index.val = 7 ∨ index.val = 8 ∨
          index.val = 9 ∨ index.val = 11 ∨ index.val = 12 ∨ index.val = 13 ∨ index.val = 14 := by omega
      rcases positions with h | h | h | h | h | h | h | h | h | h | h | h | h | h
      all_goals simp only [h]; rfl
    have bounded : machine.executionEnv.code.size < UInt256.size := by rw [code]; exact optimized_bounded
    exact NativePairedCallerChecks.checked_native_x fuel machine after _ _ bounded admitted decoded success

/-- Compose the actual nonhalting prefix, deriving each next PC and the unchanged code. -/
theorem optimized_prefix_x (count index : Nat) (initial after : EVM.State)
    (bound : index + count ≤ 15) (code : initial.executionEnv.code = optimized)
    (pc : initial.pc = UInt256.ofNat optimizedInstructions[(⟨index, by omega⟩ : Fin 16)].1)
    (success : checkedSteps count initial = .ok after) :
    after.toState = initial.toState ∧
      after.pc = UInt256.ofNat optimizedInstructions[(⟨index + count, by omega⟩ : Fin 16)].1 ∧
      ∀ fuel, EVM.X (fuel + count + 1) (EVM.D_J initial.executionEnv.code (UInt256.ofNat 0)) initial =
        EVM.X (fuel + 1) (EVM.D_J initial.executionEnv.code (UInt256.ofNat 0)) after := by
  induction count generalizing index initial with
  | zero =>
    have same : initial = after := Except.ok.inj success
    subst after
    exact ⟨rfl, pc, fun _ => rfl⟩
  | succ count ih =>
    obtain ⟨next, step, rest⟩ := checkedSteps_success count initial after success
    have frame := optimized_instruction_frame ⟨index, by omega⟩ initial next code pc step
    have nextCode : next.executionEnv.code = optimized := by rw [frame.1]; exact code
    have tail := ih (index + 1) next (by omega) nextCode frame.2 rest
    refine ⟨tail.1.trans frame.1, ?_, ?_⟩
    · simpa only [Nat.add_assoc, Nat.add_comm 1 count] using tail.2.1
    · intro fuel
      have first := optimized_instruction_x ⟨index, by omega⟩ (fuel + count) initial next code pc step
      have remaining := tail.2.2 fuel
      have sameCode : next.executionEnv.code = initial.executionEnv.code := by rw [frame.1]
      rw [sameCode] at remaining
      calc
        _ = EVM.X (fuel + count + 1) (EVM.D_J initial.executionEnv.code (UInt256.ofNat 0)) next := by
          simpa only [Nat.add_assoc] using first
        _ = _ := remaining

/-- All sixteen actual checked instructions correspond to native execution and real RETURN halt. -/
theorem optimized_native_halt (fuel : Nat) (initial after : EVM.State)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 0)
    (success : checkedSteps 16 initial = .ok after) :
    EVM.X (fuel + 17) (EVM.D_J initial.executionEnv.code (UInt256.ofNat 0)) initial =
      .ok (.success after after.H_return) := by
  rw [show 16 = 15 + 1 from rfl, checkedSteps_add] at success
  obtain ⟨ready, prefixRun, returnRun⟩ := bind_success _ _ _ success
  have segment :=  optimized_prefix_x 15 0 initial ready (by decide) code pc prefixRun
  have readyCode : ready.executionEnv.code = optimized := by rw [segment.1]; exact code
  have halt := optimized_return_x fuel ready after readyCode segment.2.1 returnRun
  have sameCode : ready.executionEnv.code = initial.executionEnv.code := by rw [segment.1]
  rw [sameCode] at halt
  have run := segment.2.2 (fuel + 1)
  calc
    _ = EVM.X (fuel + 2) (EVM.D_J initial.executionEnv.code (UInt256.ofNat 0)) ready := by
      simpa only [Nat.add_assoc] using run
    _ = _ := halt

/-- Native execution returns the exact pure model slot and preserves the complete account world.
Checked success and pointwise native/pure Keccak equality remain explicit prerequisites. -/
theorem optimized_native_result (fuel : Nat) (initial final : EVM.State)
    (code : initial.executionEnv.code = optimized) (pc : initial.pc = UInt256.ofNat 0)
    (success : checkedSteps 16 initial = .ok final)
    (hash : ffi.KEC (Compiler.Proofs.abiEncodeMappingSlot
      (initial.toState.calldataload (UInt256.ofNat 0)).toNat
      (initial.toState.calldataload (UInt256.ofNat 32)).toNat) =
        KeccakEngine.keccak256 (Compiler.Proofs.abiEncodeMappingSlot
          (initial.toState.calldataload (UInt256.ofNat 0)).toNat
          (initial.toState.calldataload (UInt256.ofNat 32)).toNat)) :
    EVM.X (fuel + 17) (EVM.D_J initial.executionEnv.code (UInt256.ofNat 0)) initial =
      .ok (.success final (UInt256.ofNat (Compiler.Proofs.solidityMappingSlot
        (initial.toState.calldataload (UInt256.ofNat 0)).toNat
        (initial.toState.calldataload (UInt256.ofNat 32)).toNat)).toByteArray) ∧
      final.toState = initial.toState ∧ final.stack = initial.stack := by
  have result := optimized_checked_result initial final code pc success hash
  have halt := optimized_native_halt fuel initial final code pc success
  rw [result.1] at halt
  exact ⟨halt, result.2⟩

end Compiler.Proofs.IRGeneration.CapturedMappingHelper

namespace Compiler.Proofs.IRGeneration.CapturedMappingHelper
open EvmYul
open NativePairedCallerChecks

/-- The converse of guard extraction: every real guard and the real primitive suffice. -/
theorem checked_of_guards (machine after : EVM.State) (op : Operation .EVM)
    (arg : Option (UInt256 × Nat)) (guards : CheckedGuards machine op)
    (stepped : EVM.step 1 (EVM.C' (EVM.Proof.zMid machine op) op)
      (some (op, arg)) (EVM.Proof.zMid machine op) = .ok after) :
    CreationCaller.checkedStep machine op arg = .ok after := by
  have instruction := guards.instruction
  have stipend := guards.stipend
  dsimp only [EVM.Proof.zMid] at instruction stipend stepped
  unfold CreationCaller.checkedStep
  dsimp only [Bind.bind, Pure.pure, throw, throwThe, MonadExceptOf.throw, Except.bind, Except.pure]
  rw [if_neg guards.valid, if_neg guards.stack, if_neg guards.limit,
    if_neg guards.jump, if_neg guards.jumpi, if_neg guards.copy,
    if_neg guards.memory, if_neg instruction, if_neg guards.staticMode,
    if_neg stipend]
  exact stepped

/-- Combined actual gas suffices for both nonwrapping native gas guards. -/
theorem gas_guards (machine : EVM.State) (op : Operation .EVM)
    (enough : EVM.memoryExpansionCost machine op +
      EVM.C' (EVM.Proof.zMid machine op) op ≤ machine.gasAvailable.toNat) :
    ¬ machine.gasAvailable.toNat < EVM.memoryExpansionCost machine op ∧
      ¬ (EVM.Proof.zMid machine op).gasAvailable.toNat <
        EVM.C' (EVM.Proof.zMid machine op) op := by
  have memoryEnough : EVM.memoryExpansionCost machine op ≤ machine.gasAvailable.toNat := by omega
  have debit := NativeMidnightConstructor.gas_sub_toNat machine.gasAvailable _ memoryEnough
  change (machine.gasAvailable - UInt256.ofNat (EVM.memoryExpansionCost machine op)).toNat = _ at debit
  exact ⟨by omega, by change ¬ (machine.gasAvailable - UInt256.ofNat _).toNat < _; rw [debit]; omega⟩

/-- Primitive totality for the six real helper opcodes, with actual stack arity.
Gas prechecks remain separate; this theorem does not bypass them. -/
theorem helper_primitive_exists (machine : EVM.State) (cost : Nat) (word : UInt256)
    (op : Operation .EVM) (arg : Option (UInt256 × Nat))
    (admitted : (op, arg) ∈ [(.Push .PUSH1, some (word, 1)), (.Push .PUSH0, none),
      (.CALLDATALOAD, none), (.MSTORE, none), (.KECCAK256, none), (.RETURN, none)])
    (arity : (EVM.δ op).getD 0 ≤ machine.stack.length) :
    ∃ after, EVM.step 1 cost (some (op, arg)) machine = .ok after := by
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at admitted
  rcases admitted with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact ⟨_, NativeMidnightConstructor.step_PUSH1 0 cost machine word⟩
  · exact ⟨_, NativeMidnightConstructor.step_PUSH0 0 cost machine⟩
  · cases stack : machine.stack with
    | nil => simp [EVM.δ, stack] at arity
    | cons offset tail =>
      have restored : { machine with stack := offset :: tail } = machine := by rw [← stack]
      have actual := step_calldataload machine offset tail cost
      rw [restored] at actual
      exact ⟨_, actual⟩
  all_goals
    have enough : ¬ machine.stack.length < 2 := by simpa only [EVM.δ, Option.getD] using Nat.not_lt.mpr arity
    obtain ⟨first, second, tail, stack⟩ := stack_pair machine.stack enough
    have popped : machine.stack.pop2 = some (tail, first, second) := by rw [stack]; rfl
  · exact ⟨_, EVM.Proof.step_MSTORE 0 cost machine tail first second popped⟩
  · have restored : { machine with stack := first :: second :: tail } = machine := by rw [← stack]
    have actual := NativeMappingKeccak.step_keccak machine first second tail cost
    rw [restored] at actual
    exact ⟨_, actual⟩
  · exact ⟨_, EVM.Proof.step_RETURN 0 cost machine tail first second popped⟩

/-- These helper opcodes have no jump, copy, static-write or stipend rejection.
Only actual stack and combined gas bounds are needed. -/
theorem helper_guards (machine : EVM.State) (word : UInt256)
    (op : Operation .EVM) (arg : Option (UInt256 × Nat))
    (admitted : (op, arg) ∈ [(.Push .PUSH1, some (word, 1)), (.Push .PUSH0, none),
      (.CALLDATALOAD, none), (.MSTORE, none), (.KECCAK256, none), (.RETURN, none)])
    (arity : (EVM.δ op).getD 0 ≤ machine.stack.length)
    (limit : machine.stack.length ≤ 1022)
    (enough : EVM.memoryExpansionCost machine op +
      EVM.C' (EVM.Proof.zMid machine op) op ≤ machine.gasAvailable.toNat) :
    CheckedGuards machine op := by
  have gas := gas_guards machine op enough
  have bounds : ¬ machine.stack.length < (EVM.δ op).getD 0 := by omega
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at admitted
  rcases admitted with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  all_goals refine ⟨by simp [EVM.δ], bounds, ?_, ?_, ?_, ?_, gas.1, gas.2, ?_, ?_⟩
  all_goals first | (simp [EVM.δ, EVM.α]; omega) | simp

/-- Sufficient real gas and stack bounds produce a successful actual checked step.
No successful-step or final-state hypothesis is supplied. -/
theorem helper_checked_exists (machine : EVM.State) (word : UInt256)
    (op : Operation .EVM) (arg : Option (UInt256 × Nat))
    (admitted : (op, arg) ∈ [(.Push .PUSH1, some (word, 1)), (.Push .PUSH0, none),
      (.CALLDATALOAD, none), (.MSTORE, none), (.KECCAK256, none), (.RETURN, none)])
    (arity : (EVM.δ op).getD 0 ≤ machine.stack.length)
    (limit : machine.stack.length ≤ 1022)
    (enough : EVM.memoryExpansionCost machine op +
      EVM.C' (EVM.Proof.zMid machine op) op ≤ machine.gasAvailable.toNat) :
    ∃ after, CreationCaller.checkedStep machine op arg = .ok after := by
  have guards := helper_guards machine word op arg admitted arity limit enough
  have midArity : (EVM.δ op).getD 0 ≤ (EVM.Proof.zMid machine op).stack.length := arity
  obtain ⟨after, step⟩ := helper_primitive_exists (EVM.Proof.zMid machine op)
    (EVM.C' (EVM.Proof.zMid machine op) op) word op arg admitted midArity
  exact ⟨after, checked_of_guards machine after op arg guards step⟩

end Compiler.Proofs.IRGeneration.CapturedMappingHelper

namespace Compiler.Proofs.IRGeneration.CapturedMappingHelper
open EvmYul

/-- Exact accumulated gas of the captured helper, including both memory expansions. -/
def helperSpent : Array Nat := #[0, 3, 6, 8, 14, 16, 19, 22, 28, 31, 33, 75, 77, 80, 83, 85, 85]
def helperPC : Array Nat := #[0, 2, 3, 4, 5, 6, 7, 9, 10, 12, 13, 14, 15, 16, 18, 19, 20]

def helperKey (initial : EVM.State) : UInt256 := initial.toState.calldataload (UInt256.ofNat 32)
def helperBase (initial : EVM.State) : UInt256 := initial.toState.calldataload (UInt256.ofNat 0)
def helperKeyMemory (initial : EVM.State) : MachineState :=
  initial.toMachineState.mstore (UInt256.ofNat 0) (helperKey initial)
def helperPairMemory (initial : EVM.State) : MachineState :=
  (helperKeyMemory initial).mstore (UInt256.ofNat 32) (helperBase initial)
def helperNativeHash (initial : EVM.State) : UInt256 :=
  ((helperPairMemory initial).keccak256 (UInt256.ofNat 0) (UInt256.ofNat 64)).1
def helperOutputMemory (initial : EVM.State) : MachineState :=
  (helperPairMemory initial).mstore (UInt256.ofNat 0) (helperNativeHash initial)

/-- Boundary stack derived from calldata and the native hash; no state supplied by a trace. -/
def helperStack (initial : EVM.State) : Nat → Stack UInt256
  | 1 => [UInt256.ofNat 32]
  | 2 => [helperKey initial]
  | 3 => [UInt256.ofNat 0, helperKey initial]
  | 5 => [UInt256.ofNat 0]
  | 6 => [helperBase initial]
  | 7 => [UInt256.ofNat 32, helperBase initial]
  | 9 => [UInt256.ofNat 64]
  | 10 => [UInt256.ofNat 0, UInt256.ofNat 64]
  | 11 => [helperNativeHash initial]
  | 12 => [UInt256.ofNat 0, helperNativeHash initial]
  | 14 => [UInt256.ofNat 32]
  | 15 => [UInt256.ofNat 0, UInt256.ofNat 32]
  | _ => []

/-- A symbolic boundary record, to be proved against real checked instructions. -/
def helperStage (initial : EVM.State) (stage : Fin 17) : EVM.State :=
  { initial with
    gasAvailable := UInt256.ofNat (initial.gasAvailable.toNat - helperSpent[stage])
    pc := UInt256.ofNat helperPC[stage]
    stack := helperStack initial stage.val
    activeWords := UInt256.ofNat (if stage.val < 4 then 0 else if stage.val < 8 then 1 else 2)
    memory := if stage.val < 4 then initial.memory else if stage.val < 8 then (helperKeyMemory initial).memory
      else if stage.val < 13 then (helperPairMemory initial).memory else (helperOutputMemory initial).memory
    H_return := if stage.val = 16 then (helperOutputMemory initial).memory.readWithPadding 0 32 else initial.H_return
    execLength := initial.execLength + stage.val }

/-- Subtraction in the gas table is exact native word subtraction, without wraparound. -/
theorem helper_debit (initial : UInt256) (spent cost : Nat) (enough : spent + cost ≤ initial.toNat) :
    UInt256.ofNat (initial.toNat - spent) - UInt256.ofNat cost =
      UInt256.ofNat (initial.toNat - (spent + cost)) := by
  have bound : initial.toNat - spent < UInt256.size := lt_of_le_of_lt (Nat.sub_le _ _) initial.val.isLt
  have value : (UInt256.ofNat (initial.toNat - spent)).toNat = initial.toNat - spent := Nat.mod_eq_of_lt bound
  have remaining : cost ≤ (UInt256.ofNat (initial.toNat - spent)).toNat := by rw [value]; omega
  have debit := NativeMidnightConstructor.gas_sub_toNat (UInt256.ofNat (initial.toNat - spent)) cost remaining
  rw [value] at debit
  have result := congrArg UInt256.ofNat debit
  rw [native_word_roundtrip] at result
  exact result.trans (congrArg UInt256.ofNat (by omega))

/-- The symbolic initial boundary is the actual state under the wrapper's entry conditions. -/
theorem helper_stage_zero (initial : EVM.State)
    (pc : initial.pc = UInt256.ofNat 0) (stack : initial.stack = [])
    (words : initial.activeWords = UInt256.ofNat 0) : helperStage initial ⟨0, by decide⟩ = initial := by
  change ({ initial with
    gasAvailable := UInt256.ofNat (initial.gasAvailable.toNat - 0)
    pc := UInt256.ofNat 0
    stack := []
    activeWords := UInt256.ofNat 0
    execLength := initial.execLength + 0 } : EVM.State) = initial
  simp only [Nat.sub_zero, native_word_roundtrip, Nat.add_zero]
  cases initial with
  | mk shared position operands count =>
    cases shared with
    | mk state machine => cases machine; simp_all

/-- The real opcode and memory-expansion costs match the accumulated table at every boundary. -/
theorem helper_stage_cost (index : Fin 16) (initial : EVM.State) :
    let machine := helperStage initial ⟨index.val, by omega⟩
    let op := optimizedInstructions[index].2.1
    EVM.memoryExpansionCost machine op + EVM.C' (EVM.Proof.zMid machine op) op =
      helperSpent[(⟨index.val + 1, by omega⟩ : Fin 17)] - helperSpent[(⟨index.val, by omega⟩ : Fin 17)] := by
  obtain ⟨index, small⟩ := index
  have positions : index = 0 ∨ index = 1 ∨ index = 2 ∨ index = 3 ∨ index = 4 ∨ index = 5 ∨
      index = 6 ∨ index = 7 ∨ index = 8 ∨ index = 9 ∨ index = 10 ∨ index = 11 ∨
      index = 12 ∨ index = 13 ∨ index = 14 ∨ index = 15 := by omega
  rcases positions with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  all_goals simp [helperStage, helperStack, optimizedInstructions, helperSpent,
    EVM.memoryExpansionCost, EVM.memoryExpansionCost.μᵢ', EVM.Cₘ, EVM.C', EVM.Proof.zMid, MachineState.M,
    EVM.InstructionGasGroups.Wcopy, EVM.InstructionGasGroups.Wextaccount,
    EVM.InstructionGasGroups.Wzero, EVM.InstructionGasGroups.Wbase,
    EVM.InstructionGasGroups.Wverylow, EVM.InstructionGasGroups.Wverylow.pushInstrsWithoutZero, GasConstants.Gmemory, GasConstants.Gzero,
    GasConstants.Gbase, GasConstants.Gverylow, GasConstants.Gkeccak256, GasConstants.Gkeccak256word]
  all_goals try rfl

/-- Every table entry and every forward increment is bounded by the exact total of 85 gas. -/
theorem helper_spent_bounds : (∀ index : Fin 17, helperSpent[index] ≤ 85) ∧
    (∀ index : Fin 16, helperSpent[(⟨index.val, by omega⟩ : Fin 17)] ≤
      helperSpent[(⟨index.val + 1, by omega⟩ : Fin 17)]) := by decide

/-- Exact table costs fit the actual remaining word gas whenever entry gas covers 85. -/
theorem helper_stage_enough (index : Fin 16) (initial : EVM.State)
    (enough : 85 ≤ initial.gasAvailable.toNat) :
    let machine := helperStage initial ⟨index.val, by omega⟩
    let op := optimizedInstructions[index].2.1
    EVM.memoryExpansionCost machine op + EVM.C' (EVM.Proof.zMid machine op) op ≤
      machine.gasAvailable.toNat := by
  dsimp only
  rw [helper_stage_cost]
  have bound := helper_spent_bounds.1 ⟨index.val + 1, by omega⟩
  have increasing := helper_spent_bounds.2 index
  change _ ≤ (UInt256.ofNat (initial.gasAvailable.toNat - helperSpent[(⟨index.val, by omega⟩ : Fin 17)])).toNat
  have small : initial.gasAvailable.toNat - helperSpent[(⟨index.val, by omega⟩ : Fin 17)] < UInt256.size :=
    lt_of_le_of_lt (Nat.sub_le _ _) initial.gasAvailable.val.isLt
  rw [show (UInt256.ofNat (initial.gasAvailable.toNat - helperSpent[(⟨index.val, by omega⟩ : Fin 17)])).toNat =
    initial.gasAvailable.toNat - helperSpent[(⟨index.val, by omega⟩ : Fin 17)] from Nat.mod_eq_of_lt small]
  omega

/-- The charged primitive input has exactly the next boundary's remaining gas. -/
theorem helper_stage_charged_gas (index : Fin 16) (initial : EVM.State)
    (enough : 85 ≤ initial.gasAvailable.toNat) :
    let machine := helperStage initial ⟨index.val, by omega⟩
    let op := optimizedInstructions[index].2.1
    (EVM.Proof.stepPre (EVM.C' (EVM.Proof.zMid machine op) op)
      (EVM.Proof.zMid machine op)).gasAvailable =
        (helperStage initial ⟨index.val + 1, by omega⟩).gasAvailable := by
  dsimp only
  let machine := helperStage initial ⟨index.val, by omega⟩
  let op := optimizedInstructions[index].2.1
  have gas := gas_guards machine op (helper_stage_enough index initial enough)
  have memoryEnough := Nat.le_of_not_lt gas.1
  have instructionEnough := Nat.le_of_not_lt gas.2
  have debit := NativeMidnightConstructor.gas_sub_toNat machine.gasAvailable _ memoryEnough
  have charged := NativeMidnightConstructor.gas_sub_toNat (EVM.Proof.zMid machine op).gasAvailable _ instructionEnough
  have normalization : machine.gasAvailable.toNat = initial.gasAvailable.toNat -
      helperSpent[(⟨index.val, by omega⟩ : Fin 17)] := by
    exact Nat.mod_eq_of_lt (lt_of_le_of_lt (Nat.sub_le _ _) initial.gasAvailable.val.isLt)
  have costs := helper_stage_cost index initial
  have increasing := helper_spent_bounds.2 index
  have nextBound := helper_spent_bounds.1 ⟨index.val + 1, by omega⟩
  change (EVM.Proof.zMid machine op).gasAvailable.toNat = _ at debit
  rw [debit, normalization] at charged
  have exactNat : ((EVM.Proof.zMid machine op).gasAvailable -
      UInt256.ofNat (EVM.C' (EVM.Proof.zMid machine op) op)).toNat =
        initial.gasAvailable.toNat - helperSpent[(⟨index.val + 1, by omega⟩ : Fin 17)] := by
    rw [charged]
    change EVM.memoryExpansionCost machine op + EVM.C' (EVM.Proof.zMid machine op) op = _ at costs
    omega
  exact (native_word_roundtrip _).symm.trans (congrArg UInt256.ofNat exactNat)

/-- Every captured instruction belongs to the six-opcode primitive totality theorem. -/
theorem helper_stage_admitted : ∀ index : Fin 16,
    let instruction := optimizedInstructions[index].2
    let word := (instruction.2.getD (UInt256.ofNat 0, 0)).1
    instruction ∈ [(.Push .PUSH1, some (word, 1)), (.Push .PUSH0, none),
      (.CALLDATALOAD, none), (.MSTORE, none), (.KECCAK256, none), (.RETURN, none)] := by
  intro ⟨index, small⟩
  have positions : index = 0 ∨ index = 1 ∨ index = 2 ∨ index = 3 ∨ index = 4 ∨ index = 5 ∨
      index = 6 ∨ index = 7 ∨ index = 8 ∨ index = 9 ∨ index = 10 ∨ index = 11 ∨
      index = 12 ∨ index = 13 ∨ index = 14 ∨ index = 15 := by omega
  rcases positions with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  all_goals simp [optimizedInstructions]


/-- The computed stack at every boundary has the actual arity and remains far below overflow. -/
theorem helper_stage_stack_bounds (index : Fin 16) (initial : EVM.State) :
    let machine := helperStage initial ⟨index.val, by omega⟩
    (EVM.δ optimizedInstructions[index].2.1).getD 0 ≤ machine.stack.length ∧
      machine.stack.length ≤ 1022 := by
  obtain ⟨index, small⟩ := index
  have positions : index = 0 ∨ index = 1 ∨ index = 2 ∨ index = 3 ∨ index = 4 ∨ index = 5 ∨
      index = 6 ∨ index = 7 ∨ index = 8 ∨ index = 9 ∨ index = 10 ∨ index = 11 ∨
      index = 12 ∨ index = 13 ∨ index = 14 ∨ index = 15 := by omega
  rcases positions with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  all_goals simp [helperStage, helperStack, optimizedInstructions, EVM.δ]

/-- Entry gas of at least 85 suffices for each actual instruction at its computed boundary.
Transitions between these computed boundaries are a separate obligation. -/
theorem helper_stage_checked_exists (index : Fin 16) (initial : EVM.State)
    (enough : 85 ≤ initial.gasAvailable.toNat) :
    let machine := helperStage initial ⟨index.val, by omega⟩
    let instruction := optimizedInstructions[index].2
    ∃ after, CreationCaller.checkedStep machine instruction.1 instruction.2 = .ok after := by
  exact helper_checked_exists _ _ _ _ (helper_stage_admitted index)
    (helper_stage_stack_bounds index initial).1 (helper_stage_stack_bounds index initial).2
    (helper_stage_enough index initial enough)

end Compiler.Proofs.IRGeneration.CapturedMappingHelper

namespace Compiler.Proofs.IRGeneration.CapturedMappingHelper
open EvmYul

private theorem helper_machine_ext (left right : MachineState)
    (gas : left.gasAvailable = right.gasAvailable) (words : left.activeWords = right.activeWords)
    (memory : left.memory = right.memory) (data : left.returnData = right.returnData)
    (output : left.H_return = right.H_return) : left = right := by
  cases left; cases right; simp_all

private theorem helper_shared_ext (left right : SharedState .EVM)
    (world : left.toState = right.toState) (machine : left.toMachineState = right.toMachineState) :
    left = right := by
  cases left; cases right; simp_all

private theorem helper_evm_ext (left right : EVM.State)
    (shared : left.toSharedState = right.toSharedState) (pc : left.pc = right.pc)
    (stack : left.stack = right.stack) (count : left.execLength = right.execLength) : left = right := by
  cases left; cases right; simp_all

/-- The first actual PUSH1 produces the computed next boundary, with exact charged gas. -/
theorem helper_transition_zero (initial : EVM.State) (enough : 85 ≤ initial.gasAvailable.toNat) :
    let machine := helperStage initial ⟨0, by decide⟩
    let op := optimizedInstructions[(⟨0, by decide⟩ : Fin 16)].2
    EVM.step 1 (EVM.C' (EVM.Proof.zMid machine op.1) op.1) (some op)
      (EVM.Proof.zMid machine op.1) = .ok (helperStage initial ⟨1, by decide⟩) := by
  dsimp only
  have gas := helper_stage_charged_gas ⟨0, by decide⟩ initial enough
  let mid := EVM.Proof.zMid (helperStage initial ⟨0, by decide⟩) (.Push .PUSH1)
  change EVM.step 1 (EVM.C' mid (.Push .PUSH1))
    (some (.Push .PUSH1, some (UInt256.ofNat 32, 1))) mid = _
  rw [NativeMidnightConstructor.step_PUSH1 0]
  congr 1
  apply helper_evm_ext
  · apply helper_shared_ext
    · rfl
    · apply helper_machine_ext
      · exact gas
      all_goals rfl
  all_goals rfl

end Compiler.Proofs.IRGeneration.CapturedMappingHelper

