{
  "schema_version": 1,
  "description": "Interpreter feature-support matrix for Verity's reference interpreters and the native EVMYulLean builtin bridge.",
  "interpreters": {
    "SourceInterpreter_basic": {
      "file": "Contracts/Interpreter.lean",
      "entry": "Compiler.Interpreter.interpret",
      "description": "Source-level executable interpreter used for differential testing of generated contract surfaces."
    },
    "SourceInterpreter_fuel": {
      "file": "Contracts/Interpreter.lean",
      "entry": "Compiler.Interpreter.interpret",
      "description": "Canonical source-level executable path for feature coverage rows that previously used the fuel-bounded SpecInterpreter column."
    },
    "IRInterpreter": {
      "file": "Compiler/Proofs/IRGeneration/IRInterpreter.lean",
      "entry": "evalStmts",
      "description": "Fuel-bounded IR interpreter for Layer-2 preservation proofs. Operates on Yul IR statements with abstract storage model."
    },
    "EVMYulLean_bridge": {
      "file": "Compiler/Proofs/YulGeneration/Backends/EvmYulLeanBridgeTest.lean",
      "entry": "evalBuiltinCallViaEvmYulLean",
      "description": "Builtin evaluation bridge delegating pure arithmetic/bitwise/comparison to EVMYulLean UInt256 operations."
    }
  },
  "default_execution_path": "SourceInterpreter_fuel",
  "default_path_rationale": "The source-interpreter path reflects the current generated executable contract surface. The retired SpecInterpreter_* artifact keys are accepted only by migration readers.",
